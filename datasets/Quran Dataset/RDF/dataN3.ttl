        quran:surahnumber              "15" ;
        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:2758  quran:ayah_text            "فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ بِٱلۡحَقِّ فَجَعَلۡنَٰهُمۡ غُثَآءٗۚ فَبُعۡدٗا لِّلۡقَوۡمِ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "فاخذتهم الصيحة بالحق فجعلنٰهم غثاء فبعدا للقوم الظٰلمين" ;
