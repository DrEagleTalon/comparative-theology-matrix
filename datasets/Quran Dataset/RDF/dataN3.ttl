        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:1997  quran:ayah_text            "وَإِنَّ لَكُمۡ فِي ٱلۡأَنۡعَٰمِ لَعِبۡرَةٗۖ نُّسۡقِيكُم مِّمَّا فِي بُطُونِهِۦ مِنۢ بَيۡنِ فَرۡثٖ وَدَمٖ لَّبَنًا خَالِصٗا سَآئِغٗا لِّلشَّٰرِبِينَ" ;
        quran:ayah_text_no_diacratic   "وان لكم في الانعٰم لعبرة نسقيكم مما في بطونه من بين فرث ودم لبنا خالصا سائغا للشٰربين" ;
        quran:ayahnumber               "66" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1997" ;
        quran:page                     "274" ;
