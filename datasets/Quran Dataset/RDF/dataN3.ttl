        quran:surahnumber              "51" ;
        quran:surrahname_no_diacratic  "سورة الذاريات" .

quran:2830  quran:ayah_text            "قَالُواْ لَبِثۡنَا يَوۡمًا أَوۡ بَعۡضَ يَوۡمٖ فَسۡـَٔلِ ٱلۡعَآدِّينَ" ;
        quran:ayah_text_no_diacratic   "قالوا لبثنا يوما او بعض يوم فسل العادين" ;
        quran:ayahnumber               "113" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2830" ;
        quran:page                     "349" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3734  quran:ayah_text            "إِنَّ ٱلشَّيۡطَٰنَ لَكُمۡ عَدُوّٞ فَٱتَّخِذُوهُ عَدُوًّاۚ إِنَّمَا يَدۡعُواْ حِزۡبَهُۥ لِيَكُونُواْ مِنۡ أَصۡحَٰبِ ٱلسَّعِيرِ" ;
        quran:ayah_text_no_diacratic   "ان الشيطٰن لكم عدو فاتخذوه عدوا انما يدعوا حزبه ليكونوا من اصحٰب السعير" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3734" ;
        quran:page                     "435" ;
        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:1496  quran:ayah_text            "وَأَنِ ٱسۡتَغۡفِرُواْ رَبَّكُمۡ ثُمَّ تُوبُوٓاْ إِلَيۡهِ يُمَتِّعۡكُم مَّتَٰعًا حَسَنًا إِلَىٰٓ أَجَلٖ مُّسَمّٗى وَيُؤۡتِ كُلَّ ذِي فَضۡلٖ فَضۡلَهُۥۖ وَإِن تَوَلَّوۡاْ فَإِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٖ كَبِيرٍ" ;
        quran:ayah_text_no_diacratic   "وان استغفروا ربكم ثم توبوا اليه يمتعكم متٰعا حسنا الىٰ اجل مسمى ويؤت كل ذي فضل فضله وان تولوا فاني اخاف عليكم عذاب يوم كبير" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "11" ;
        quran:hizb                     "22" ;
        quran:index                    "1496" ;
        quran:page                     "221" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2640  quran:ayah_text            "وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَيَتَّبِعُ كُلَّ شَيۡطَٰنٖ مَّرِيدٖ" ;
        quran:ayah_text_no_diacratic   "ومن الناس من يجٰدل في الله بغير علم ويتبع كل شيطٰن مريد" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2640" ;
        quran:page                     "332" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:4638  quran:ayah_text            "ٱلَّذِينَ كَفَرُواْ وَصَدُّواْ عَن سَبِيلِ ٱللَّهِ أَضَلَّ أَعۡمَٰلَهُمۡ" ;
        quran:ayah_text_no_diacratic   "الذين كفروا وصدوا عن سبيل الله اضل اعمٰلهم" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4638" ;
        quran:page                     "507" ;
        quran:surahname                "سُورَةُ مُحَمَّدٍ" ;
        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:3544  quran:ayah_text            "وَإِن جَٰهَدَاكَ عَلَىٰٓ أَن تُشۡرِكَ بِي مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٞ فَلَا تُطِعۡهُمَاۖ وَصَاحِبۡهُمَا فِي ٱلدُّنۡيَا مَعۡرُوفٗاۖ وَٱتَّبِعۡ سَبِيلَ مَنۡ أَنَابَ إِلَيَّۚ ثُمَّ إِلَيَّ مَرۡجِعُكُمۡ فَأُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "وان جٰهداك علىٰ ان تشرك بي ما ليس لك به علم فلا تطعهما وصاحبهما في الدنيا معروفا واتبع سبيل من اناب الي ثم الي مرجعكم فانبئكم بما كنتم تعملون" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3544" ;
        quran:page                     "412" ;
        quran:surahname                "سُورَةُ لُقۡمَانَ" ;
        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:2450  quran:ayah_text            "فَأَجۡمِعُواْ كَيۡدَكُمۡ ثُمَّ ٱئۡتُواْ صَفّٗاۚ وَقَدۡ أَفۡلَحَ ٱلۡيَوۡمَ مَنِ ٱسۡتَعۡلَىٰ" ;
        quran:ayah_text_no_diacratic   "فاجمعوا كيدكم ثم ائتوا صفا وقد افلح اليوم من استعلىٰ" ;
        quran:ayahnumber               "64" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2450" ;
        quran:page                     "315" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:4448  quran:ayah_text            "وَلَن يَنفَعَكُمُ ٱلۡيَوۡمَ إِذ ظَّلَمۡتُمۡ أَنَّكُمۡ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ" ;
        quran:ayah_text_no_diacratic   "ولن ينفعكم اليوم اذ ظلمتم انكم في العذاب مشتركون" ;
        quran:ayahnumber               "39" ;
