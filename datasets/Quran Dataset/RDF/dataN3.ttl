        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:332  quran:ayah_text             "ذُرِّيَّةَۢ بَعۡضُهَا مِنۢ بَعۡضٖۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "ذرية بعضها من بعض والله سميع عليم" ;
