quran:1263  quran:ayah_text            "وَإِن نَّكَثُوٓاْ أَيۡمَٰنَهُم مِّنۢ بَعۡدِ عَهۡدِهِمۡ وَطَعَنُواْ فِي دِينِكُمۡ فَقَٰتِلُوٓاْ أَئِمَّةَ ٱلۡكُفۡرِ إِنَّهُمۡ لَآ أَيۡمَٰنَ لَهُمۡ لَعَلَّهُمۡ يَنتَهُونَ" ;
        quran:ayah_text_no_diacratic   "وان نكثوا ايمٰنهم من بعد عهدهم وطعنوا في دينكم فقٰتلوا ائمة الكفر انهم لا ايمٰن لهم لعلهم ينتهون" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1263" ;
        quran:page                     "188" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:971  quran:ayah_text             "وَكَم مِّن قَرۡيَةٍ أَهۡلَكۡنَٰهَا فَجَآءَهَا بَأۡسُنَا بَيَٰتًا أَوۡ هُمۡ قَآئِلُونَ" ;
        quran:ayah_text_no_diacratic   "وكم من قرية اهلكنٰها فجاءها باسنا بيٰتا او هم قائلون" ;
