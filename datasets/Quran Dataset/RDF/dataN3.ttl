quran:574  quran:ayah_text             "۞فَلۡيُقَٰتِلۡ فِي سَبِيلِ ٱللَّهِ ٱلَّذِينَ يَشۡرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا بِٱلۡأٓخِرَةِۚ وَمَن يُقَٰتِلۡ فِي سَبِيلِ ٱللَّهِ فَيُقۡتَلۡ أَوۡ يَغۡلِبۡ فَسَوۡفَ نُؤۡتِيهِ أَجۡرًا عَظِيمٗا" ;
        quran:ayah_text_no_diacratic   "فليقٰتل في سبيل الله الذين يشرون الحيوٰة الدنيا بالاخرة ومن يقٰتل في سبيل الله فيقتل او يغلب فسوف نؤتيه اجرا عظيما" ;
        quran:ayahnumber               "74" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "574" ;
        quran:page                     "89" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4008  quran:ayah_text            "فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ" ;
        quran:ayah_text_no_diacratic   "فامنوا فمتعنٰهم الىٰ حين" ;
