quran:954  quran:ayah_text             "ثُمَّ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ تَمَامًا عَلَى ٱلَّذِيٓ أَحۡسَنَ وَتَفۡصِيلٗا لِّكُلِّ شَيۡءٖ وَهُدٗى وَرَحۡمَةٗ لَّعَلَّهُم بِلِقَآءِ رَبِّهِمۡ يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "ثم ءاتينا موسى الكتٰب تماما على الذي احسن وتفصيلا لكل شيء وهدى ورحمة لعلهم بلقاء ربهم يؤمنون" ;
        quran:ayahnumber               "154" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "954" ;
        quran:page                     "149" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1056  quran:ayah_text            "قَدِ ٱفۡتَرَيۡنَا عَلَى ٱللَّهِ كَذِبًا إِنۡ عُدۡنَا فِي مِلَّتِكُم بَعۡدَ إِذۡ نَجَّىٰنَا ٱللَّهُ مِنۡهَاۚ وَمَا يَكُونُ لَنَآ أَن نَّعُودَ فِيهَآ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّنَاۚ وَسِعَ رَبُّنَا كُلَّ شَيۡءٍ عِلۡمًاۚ عَلَى ٱللَّهِ تَوَكَّلۡنَاۚ رَبَّنَا ٱفۡتَحۡ بَيۡنَنَا وَبَيۡنَ قَوۡمِنَا بِٱلۡحَقِّ وَأَنتَ خَيۡرُ ٱلۡفَٰتِحِينَ" ;
        quran:ayah_text_no_diacratic   "قد افترينا على الله كذبا ان عدنا في ملتكم بعد اذ نجىٰنا الله منها وما يكون لنا ان نعود فيها الا ان يشاء الله ربنا وسع ربنا كل شيء علما على الله توكلنا ربنا افتح بيننا وبين قومنا بالحق وانت خير الفٰتحين" ;
        quran:ayahnumber               "89" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1056" ;
        quran:page                     "162" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:764  quran:ayah_text             "وَٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِـَٔايَٰتِنَآ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡجَحِيمِ" ;
        quran:ayah_text_no_diacratic   "والذين كفروا وكذبوا بايٰتنا اولٰئك اصحٰب الجحيم" ;
        quran:ayahnumber               "86" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "764" ;
