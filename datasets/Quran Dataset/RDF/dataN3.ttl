quran:2223  quran:ayah_text            "وَوُضِعَ ٱلۡكِتَٰبُ فَتَرَى ٱلۡمُجۡرِمِينَ مُشۡفِقِينَ مِمَّا فِيهِ وَيَقُولُونَ يَٰوَيۡلَتَنَا مَالِ هَٰذَا ٱلۡكِتَٰبِ لَا يُغَادِرُ صَغِيرَةٗ وَلَا كَبِيرَةً إِلَّآ أَحۡصَىٰهَاۚ وَوَجَدُواْ مَا عَمِلُواْ حَاضِرٗاۗ وَلَا يَظۡلِمُ رَبُّكَ أَحَدٗا" ;
        quran:ayah_text_no_diacratic   "ووضع الكتٰب فترى المجرمين مشفقين مما فيه ويقولون يٰويلتنا مال هٰذا الكتٰب لا يغادر صغيرة ولا كبيرة الا احصىٰها ووجدوا ما عملوا حاضرا ولا يظلم ربك احدا" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2223" ;
        quran:page                     "299" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3127  quran:ayah_text            "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "وما اسلكم عليه من اجر ان اجري الا علىٰ رب العٰلمين" ;
