quran:1561  quran:ayah_text            "كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَآۗ أَلَآ إِنَّ ثَمُودَاْ كَفَرُواْ رَبَّهُمۡۗ أَلَا بُعۡدٗا لِّثَمُودَ" ;
        quran:ayah_text_no_diacratic   "كان لم يغنوا فيها الا ان ثمودا كفروا ربهم الا بعدا لثمود" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1561" ;
        quran:page                     "229" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:3559  quran:ayah_text            "ذَٰلِكَ بِأَنَّ ٱللَّهَ هُوَ ٱلۡحَقُّ وَأَنَّ مَا يَدۡعُونَ مِن دُونِهِ ٱلۡبَٰطِلُ وَأَنَّ ٱللَّهَ هُوَ ٱلۡعَلِيُّ ٱلۡكَبِيرُ" ;
        quran:ayah_text_no_diacratic   "ذٰلك بان الله هو الحق وان ما يدعون من دونه البٰطل وان الله هو العلي الكبير" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3559" ;
        quran:page                     "414" ;
        quran:surahname                "سُورَةُ لُقۡمَانَ" ;
        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:4703  quran:ayah_text            "إِذۡ جَعَلَ ٱلَّذِينَ كَفَرُواْ فِي قُلُوبِهِمُ ٱلۡحَمِيَّةَ حَمِيَّةَ ٱلۡجَٰهِلِيَّةِ فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلۡمُؤۡمِنِينَ وَأَلۡزَمَهُمۡ كَلِمَةَ ٱلتَّقۡوَىٰ وَكَانُوٓاْ أَحَقَّ بِهَا وَأَهۡلَهَاۚ وَكَانَ ٱللَّهُ بِكُلِّ شَيۡءٍ عَلِيمٗا" ;
        quran:ayah_text_no_diacratic   "اذ جعل الذين كفروا في قلوبهم الحمية حمية الجٰهلية فانزل الله سكينته علىٰ رسوله وعلى المؤمنين والزمهم كلمة التقوىٰ وكانوا احق بها واهلها وكان الله بكل شيء عليما" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4703" ;
        quran:page                     "514" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:2465  quran:ayah_text            "وَأَضَلَّ فِرۡعَوۡنُ قَوۡمَهُۥ وَمَا هَدَىٰ" ;
        quran:ayah_text_no_diacratic   "واضل فرعون قومه وما هدىٰ" ;
        quran:ayahnumber               "79" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2465" ;
        quran:page                     "317" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:5607  quran:ayah_text            "وَأَنَّ ٱلۡمَسَٰجِدَ لِلَّهِ فَلَا تَدۡعُواْ مَعَ ٱللَّهِ أَحَدٗا" ;
        quran:ayah_text_no_diacratic   "وان المسٰجد لله فلا تدعوا مع الله احدا" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5607" ;
        quran:page                     "573" ;
        quran:surahname                "سُورَةُ الجِنِّ" ;
        quran:surahnumber              "72" ;
        quran:surrahname_no_diacratic  "سورة الجن" .

quran:3369  quran:ayah_text            "قَالَ ٱلَّذِينَ حَقَّ عَلَيۡهِمُ ٱلۡقَوۡلُ رَبَّنَا هَٰٓؤُلَآءِ ٱلَّذِينَ أَغۡوَيۡنَآ أَغۡوَيۡنَٰهُمۡ كَمَا غَوَيۡنَاۖ تَبَرَّأۡنَآ إِلَيۡكَۖ مَا كَانُوٓاْ إِيَّانَا يَعۡبُدُونَ" ;
        quran:ayah_text_no_diacratic   "قال الذين حق عليهم القول ربنا هٰؤلاء الذين اغوينا اغوينٰهم كما غوينا تبرانا اليك ما كانوا ايانا يعبدون" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3369" ;
        quran:page                     "393" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1371  quran:ayah_text            "مَا كَانَ لِأَهۡلِ ٱلۡمَدِينَةِ وَمَنۡ حَوۡلَهُم مِّنَ ٱلۡأَعۡرَابِ أَن يَتَخَلَّفُواْ عَن رَّسُولِ ٱللَّهِ وَلَا يَرۡغَبُواْ بِأَنفُسِهِمۡ عَن نَّفۡسِهِۦۚ ذَٰلِكَ بِأَنَّهُمۡ لَا يُصِيبُهُمۡ ظَمَأٞ وَلَا نَصَبٞ وَلَا مَخۡمَصَةٞ فِي سَبِيلِ ٱللَّهِ وَلَا يَطَـُٔونَ مَوۡطِئٗا يَغِيظُ ٱلۡكُفَّارَ وَلَا يَنَالُونَ مِنۡ عَدُوّٖ نَّيۡلًا إِلَّا كُتِبَ لَهُم بِهِۦ عَمَلٞ صَٰلِحٌۚ إِنَّ ٱللَّهَ لَا يُضِيعُ أَجۡرَ ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "ما كان لاهل المدينة ومن حولهم من الاعراب ان يتخلفوا عن رسول الله ولا يرغبوا بانفسهم عن نفسه ذٰلك بانهم لا يصيبهم ظما ولا نصب ولا مخمصة في سبيل الله ولا يطون موطئا يغيظ الكفار ولا ينالون من عدو نيلا الا كتب لهم به عمل صٰلح ان الله لا يضيع اجر المحسنين" ;
        quran:ayahnumber               "120" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1371" ;
        quran:page                     "206" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4513  quran:ayah_text            "أَنَّىٰ لَهُمُ ٱلذِّكۡرَىٰ وَقَدۡ جَآءَهُمۡ رَسُولٞ مُّبِينٞ" ;
        quran:ayah_text_no_diacratic   "انىٰ لهم الذكرىٰ وقد جاءهم رسول مبين" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4513" ;
        quran:page                     "496" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2275  quran:ayah_text            "ٱلَّذِينَ كَانَتۡ أَعۡيُنُهُمۡ فِي غِطَآءٍ عَن ذِكۡرِي وَكَانُواْ لَا يَسۡتَطِيعُونَ سَمۡعًا" ;
        quran:ayah_text_no_diacratic   "الذين كانت اعينهم في غطاء عن ذكري وكانوا لا يستطيعون سمعا" ;
        quran:ayahnumber               "101" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2275" ;
        quran:page                     "304" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:5417  quran:ayah_text            "مَّنَّاعٖ لِّلۡخَيۡرِ مُعۡتَدٍ أَثِيمٍ" ;
        quran:ayah_text_no_diacratic   "مناع للخير معتد اثيم" ;
        quran:ayahnumber               "12" ;
