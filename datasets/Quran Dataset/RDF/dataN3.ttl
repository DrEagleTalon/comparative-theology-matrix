quran:365  quran:ayah_text             "مَا كَانَ إِبۡرَٰهِيمُ يَهُودِيّٗا وَلَا نَصۡرَانِيّٗا وَلَٰكِن كَانَ حَنِيفٗا مُّسۡلِمٗا وَمَا كَانَ مِنَ ٱلۡمُشۡرِكِينَ" ;
        quran:ayah_text_no_diacratic   "ما كان ابرٰهيم يهوديا ولا نصرانيا ولٰكن كان حنيفا مسلما وما كان من المشركين" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "365" ;
        quran:page                     "58" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5894  quran:ayah_text            "إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ" ;
        quran:ayah_text_no_diacratic   "ان في ذٰلك لعبرة لمن يخشىٰ" ;
