quran:2229  quran:ayah_text            "وَمَا مَنَعَ ٱلنَّاسَ أَن يُؤۡمِنُوٓاْ إِذۡ جَآءَهُمُ ٱلۡهُدَىٰ وَيَسۡتَغۡفِرُواْ رَبَّهُمۡ إِلَّآ أَن تَأۡتِيَهُمۡ سُنَّةُ ٱلۡأَوَّلِينَ أَوۡ يَأۡتِيَهُمُ ٱلۡعَذَابُ قُبُلٗا" ;
        quran:ayah_text_no_diacratic   "وما منع الناس ان يؤمنوا اذ جاءهم الهدىٰ ويستغفروا ربهم الا ان تاتيهم سنة الاولين او ياتيهم العذاب قبلا" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "15" ;
        quran:hizb                     "30" ;
        quran:index                    "2229" ;
        quran:page                     "300" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1135  quran:ayah_text            "وَقَطَّعۡنَٰهُمۡ فِي ٱلۡأَرۡضِ أُمَمٗاۖ مِّنۡهُمُ ٱلصَّٰلِحُونَ وَمِنۡهُمۡ دُونَ ذَٰلِكَۖ وَبَلَوۡنَٰهُم بِٱلۡحَسَنَٰتِ وَٱلسَّيِّـَٔاتِ لَعَلَّهُمۡ يَرۡجِعُونَ" ;
        quran:ayah_text_no_diacratic   "وقطعنٰهم في الارض امما منهم الصٰلحون ومنهم دون ذٰلك وبلونٰهم بالحسنٰت والسيات لعلهم يرجعون" ;
        quran:ayahnumber               "168" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1135" ;
        quran:page                     "172" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:843  quran:ayah_text             "فَلَوۡلَآ إِذۡ جَآءَهُم بَأۡسُنَا تَضَرَّعُواْ وَلَٰكِن قَسَتۡ قُلُوبُهُمۡ وَزَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ مَا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "فلولا اذ جاءهم باسنا تضرعوا ولٰكن قست قلوبهم وزين لهم الشيطٰن ما كانوا يعملون" ;
        quran:ayahnumber               "43" ;
        quran:chapter                  "7" ;
