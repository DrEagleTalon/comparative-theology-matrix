        quran:surrahname_no_diacratic  "سورة الملك" .

quran:2803  quran:ayah_text            "قُلۡ مَن رَّبُّ ٱلسَّمَٰوَٰتِ ٱلسَّبۡعِ وَرَبُّ ٱلۡعَرۡشِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "قل من رب السمٰوٰت السبع ورب العرش العظيم" ;
