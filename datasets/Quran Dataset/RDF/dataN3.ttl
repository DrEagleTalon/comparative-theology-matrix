quran:1139  quran:ayah_text            "وَإِذۡ أَخَذَ رَبُّكَ مِنۢ بَنِيٓ ءَادَمَ مِن ظُهُورِهِمۡ ذُرِّيَّتَهُمۡ وَأَشۡهَدَهُمۡ عَلَىٰٓ أَنفُسِهِمۡ أَلَسۡتُ بِرَبِّكُمۡۖ قَالُواْ بَلَىٰ شَهِدۡنَآۚ أَن تَقُولُواْ يَوۡمَ ٱلۡقِيَٰمَةِ إِنَّا كُنَّا عَنۡ هَٰذَا غَٰفِلِينَ" ;
        quran:ayah_text_no_diacratic   "واذ اخذ ربك من بني ءادم من ظهورهم ذريتهم واشهدهم علىٰ انفسهم الست بربكم قالوا بلىٰ شهدنا ان تقولوا يوم القيٰمة انا كنا عن هٰذا غٰفلين" ;
        quran:ayahnumber               "172" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1139" ;
        quran:page                     "173" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:847  quran:ayah_text             "قُلۡ أَرَءَيۡتَكُمۡ إِنۡ أَتَىٰكُمۡ عَذَابُ ٱللَّهِ بَغۡتَةً أَوۡ جَهۡرَةً هَلۡ يُهۡلَكُ إِلَّا ٱلۡقَوۡمُ ٱلظَّٰلِمُونَ" ;
        quran:ayah_text_no_diacratic   "قل ارءيتكم ان اتىٰكم عذاب الله بغتة او جهرة هل يهلك الا القوم الظٰلمون" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "847" ;
        quran:page                     "133" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:657  quran:ayah_text             "وَقَوۡلِهِمۡ إِنَّا قَتَلۡنَا ٱلۡمَسِيحَ عِيسَى ٱبۡنَ مَرۡيَمَ رَسُولَ ٱللَّهِ وَمَا قَتَلُوهُ وَمَا صَلَبُوهُ وَلَٰكِن شُبِّهَ لَهُمۡۚ وَإِنَّ ٱلَّذِينَ ٱخۡتَلَفُواْ فِيهِ لَفِي شَكّٖ مِّنۡهُۚ مَا لَهُم بِهِۦ مِنۡ عِلۡمٍ إِلَّا ٱتِّبَاعَ ٱلظَّنِّۚ وَمَا قَتَلُوهُ يَقِينَۢا" ;
        quran:ayah_text_no_diacratic   "وقولهم انا قتلنا المسيح عيسى ابن مريم رسول الله وما قتلوه وما صلبوه ولٰكن شبه لهم وان الذين اختلفوا فيه لفي شك منه ما لهم به من علم الا اتباع الظن وما قتلوه يقينا" ;
        quran:ayahnumber               "157" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "657" ;
        quran:page                     "103" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:467  quran:ayah_text             "وَلَا تَحۡسَبَنَّ ٱلَّذِينَ قُتِلُواْ فِي سَبِيلِ ٱللَّهِ أَمۡوَٰتَۢاۚ بَلۡ أَحۡيَآءٌ عِندَ رَبِّهِمۡ يُرۡزَقُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تحسبن الذين قتلوا في سبيل الله اموٰتا بل احياء عند ربهم يرزقون" ;
