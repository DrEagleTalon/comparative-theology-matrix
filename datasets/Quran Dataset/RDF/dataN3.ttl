quran:3554  quran:ayah_text            "وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ لَيَقُولُنَّ ٱللَّهُۚ قُلِ ٱلۡحَمۡدُ لِلَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ولئن سالتهم من خلق السمٰوٰت والارض ليقولن الله قل الحمد لله بل اكثرهم لا يعلمون" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3554" ;
        quran:page                     "413" ;
        quran:surahname                "سُورَةُ لُقۡمَانَ" ;
        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:2460  quran:ayah_text            "إِنَّهُۥ مَن يَأۡتِ رَبَّهُۥ مُجۡرِمٗا فَإِنَّ لَهُۥ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ" ;
        quran:ayah_text_no_diacratic   "انه من يات ربه مجرما فان له جهنم لا يموت فيها ولا يحيىٰ" ;
