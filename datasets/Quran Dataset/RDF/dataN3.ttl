quran:3578  quran:ayah_text            "وَلَوۡ شِئۡنَا لَأٓتَيۡنَا كُلَّ نَفۡسٍ هُدَىٰهَا وَلَٰكِنۡ حَقَّ ٱلۡقَوۡلُ مِنِّي لَأَمۡلَأَنَّ جَهَنَّمَ مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ أَجۡمَعِينَ" ;
        quran:ayah_text_no_diacratic   "ولو شئنا لاتينا كل نفس هدىٰها ولٰكن حق القول مني لاملان جهنم من الجنة والناس اجمعين" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3578" ;
