        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:951  quran:ayah_text             "۞قُلۡ تَعَالَوۡاْ أَتۡلُ مَا حَرَّمَ رَبُّكُمۡ عَلَيۡكُمۡۖ أَلَّا تُشۡرِكُواْ بِهِۦ شَيۡـٔٗاۖ وَبِٱلۡوَٰلِدَيۡنِ إِحۡسَٰنٗاۖ وَلَا تَقۡتُلُوٓاْ أَوۡلَٰدَكُم مِّنۡ إِمۡلَٰقٖ نَّحۡنُ نَرۡزُقُكُمۡ وَإِيَّاهُمۡۖ وَلَا تَقۡرَبُواْ ٱلۡفَوَٰحِشَ مَا ظَهَرَ مِنۡهَا وَمَا بَطَنَۖ وَلَا تَقۡتُلُواْ ٱلنَّفۡسَ ٱلَّتِي حَرَّمَ ٱللَّهُ إِلَّا بِٱلۡحَقِّۚ ذَٰلِكُمۡ وَصَّىٰكُم بِهِۦ لَعَلَّكُمۡ تَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "قل تعالوا اتل ما حرم ربكم عليكم الا تشركوا به شيا وبالوٰلدين احسٰنا ولا تقتلوا اولٰدكم من املٰق نحن نرزقكم واياهم ولا تقربوا الفوٰحش ما ظهر منها وما بطن ولا تقتلوا النفس التي حرم الله الا بالحق ذٰلكم وصىٰكم به لعلكم تعقلون" ;
        quran:ayahnumber               "151" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "951" ;
        quran:page                     "148" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2147  quran:ayah_text            "وَلَئِن شِئۡنَا لَنَذۡهَبَنَّ بِٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ ثُمَّ لَا تَجِدُ لَكَ بِهِۦ عَلَيۡنَا وَكِيلًا" ;
        quran:ayah_text_no_diacratic   "ولئن شئنا لنذهبن بالذي اوحينا اليك ثم لا تجد لك به علينا وكيلا" ;
        quran:ayahnumber               "86" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2147" ;
        quran:page                     "290" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1053  quran:ayah_text            "وَلَا تَقۡعُدُواْ بِكُلِّ صِرَٰطٖ تُوعِدُونَ وَتَصُدُّونَ عَن سَبِيلِ ٱللَّهِ مَنۡ ءَامَنَ بِهِۦ وَتَبۡغُونَهَا عِوَجٗاۚ وَٱذۡكُرُوٓاْ إِذۡ كُنتُمۡ قَلِيلٗا فَكَثَّرَكُمۡۖ وَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُفۡسِدِينَ" ;
        quran:ayah_text_no_diacratic   "ولا تقعدوا بكل صرٰط توعدون وتصدون عن سبيل الله من ءامن به وتبغونها عوجا واذكروا اذ كنتم قليلا فكثركم وانظروا كيف كان عٰقبة المفسدين" ;
        quran:ayahnumber               "86" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1053" ;
        quran:page                     "161" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:761  quran:ayah_text             "وَإِذَا سَمِعُواْ مَآ أُنزِلَ إِلَى ٱلرَّسُولِ تَرَىٰٓ أَعۡيُنَهُمۡ تَفِيضُ مِنَ ٱلدَّمۡعِ مِمَّا عَرَفُواْ مِنَ ٱلۡحَقِّۖ يَقُولُونَ رَبَّنَآ ءَامَنَّا فَٱكۡتُبۡنَا مَعَ ٱلشَّٰهِدِينَ" ;
        quran:ayah_text_no_diacratic   "واذا سمعوا ما انزل الى الرسول ترىٰ اعينهم تفيض من الدمع مما عرفوا من الحق يقولون ربنا ءامنا فاكتبنا مع الشٰهدين" ;
        quran:ayahnumber               "83" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "761" ;
        quran:page                     "121" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:3101  quran:ayah_text            "فَأَنجَيۡنَٰهُ وَمَن مَّعَهُۥ فِي ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ" ;
        quran:ayah_text_no_diacratic   "فانجينٰه ومن معه في الفلك المشحون" ;
