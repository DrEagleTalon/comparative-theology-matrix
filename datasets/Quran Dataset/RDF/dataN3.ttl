        quran:index                    "4528" ;
        quran:page                     "497" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2530  quran:ayah_text            "وَمَآ أَرۡسَلۡنَا قَبۡلَكَ إِلَّا رِجَالٗا نُّوحِيٓ إِلَيۡهِمۡۖ فَسۡـَٔلُوٓاْ أَهۡلَ ٱلذِّكۡرِ إِن كُنتُمۡ لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وما ارسلنا قبلك الا رجالا نوحي اليهم فسلوا اهل الذكر ان كنتم لا تعلمون" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2530" ;
        quran:page                     "322" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
