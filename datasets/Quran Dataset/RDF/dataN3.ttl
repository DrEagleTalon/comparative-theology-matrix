        quran:surrahname_no_diacratic  "سورة الذاريات" .

quran:2586  quran:ayah_text            "قَالَ بَلۡ فَعَلَهُۥ كَبِيرُهُمۡ هَٰذَا فَسۡـَٔلُوهُمۡ إِن كَانُواْ يَنطِقُونَ" ;
        quran:ayah_text_no_diacratic   "قال بل فعله كبيرهم هٰذا فسلوهم ان كانوا ينطقون" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
