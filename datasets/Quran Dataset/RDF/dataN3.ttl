        quran:index                    "2276" ;
        quran:page                     "304" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:5418  quran:ayah_text            "عُتُلِّۭ بَعۡدَ ذَٰلِكَ زَنِيمٍ" ;
        quran:ayah_text_no_diacratic   "عتل بعد ذٰلك زنيم" ;
