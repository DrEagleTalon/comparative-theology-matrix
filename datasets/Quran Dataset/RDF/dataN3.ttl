        quran:index                    "4724" ;
        quran:page                     "517" ;
        quran:surahname                "سُورَةُ الحُجُرَاتِ" ;
        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:2486  quran:ayah_text            "مَّنۡ أَعۡرَضَ عَنۡهُ فَإِنَّهُۥ يَحۡمِلُ يَوۡمَ ٱلۡقِيَٰمَةِ وِزۡرًا" ;
        quran:ayah_text_no_diacratic   "من اعرض عنه فانه يحمل يوم القيٰمة وزرا" ;
