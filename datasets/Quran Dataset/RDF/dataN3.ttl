quran:285  quran:ayah_text             "ٱلَّذِينَ يَأۡكُلُونَ ٱلرِّبَوٰاْ لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ ٱلَّذِي يَتَخَبَّطُهُ ٱلشَّيۡطَٰنُ مِنَ ٱلۡمَسِّۚ ذَٰلِكَ بِأَنَّهُمۡ قَالُوٓاْ إِنَّمَا ٱلۡبَيۡعُ مِثۡلُ ٱلرِّبَوٰاْۗ وَأَحَلَّ ٱللَّهُ ٱلۡبَيۡعَ وَحَرَّمَ ٱلرِّبَوٰاْۚ فَمَن جَآءَهُۥ مَوۡعِظَةٞ مِّن رَّبِّهِۦ فَٱنتَهَىٰ فَلَهُۥ مَا سَلَفَ وَأَمۡرُهُۥٓ إِلَى ٱللَّهِۖ وَمَنۡ عَادَ فَأُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ" ;
        quran:ayah_text_no_diacratic   "الذين ياكلون الربوٰا لا يقومون الا كما يقوم الذي يتخبطه الشيطٰن من المس ذٰلك بانهم قالوا انما البيع مثل الربوٰا واحل الله البيع وحرم الربوٰا فمن جاءه موعظة من ربه فانتهىٰ فله ما سلف وامره الى الله ومن عاد فاولٰئك اصحٰب النار هم فيها خٰلدون" ;
        quran:ayahnumber               "275" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "285" ;
        quran:page                     "47" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1889  quran:ayah_text            "إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمۡ أَجۡمَعِينَ" ;
        quran:ayah_text_no_diacratic   "الا ءال لوط انا لمنجوهم اجمعين" ;
