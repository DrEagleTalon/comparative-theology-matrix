        quran:surrahname_no_diacratic  "سورة البروج" .

quran:1256  quran:ayah_text            "فَإِذَا ٱنسَلَخَ ٱلۡأَشۡهُرُ ٱلۡحُرُمُ فَٱقۡتُلُواْ ٱلۡمُشۡرِكِينَ حَيۡثُ وَجَدتُّمُوهُمۡ وَخُذُوهُمۡ وَٱحۡصُرُوهُمۡ وَٱقۡعُدُواْ لَهُمۡ كُلَّ مَرۡصَدٖۚ فَإِن تَابُواْ وَأَقَامُواْ ٱلصَّلَوٰةَ وَءَاتَوُاْ ٱلزَّكَوٰةَ فَخَلُّواْ سَبِيلَهُمۡۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "فاذا انسلخ الاشهر الحرم فاقتلوا المشركين حيث وجدتموهم وخذوهم واحصروهم واقعدوا لهم كل مرصد فان تابوا واقاموا الصلوٰة وءاتوا الزكوٰة فخلوا سبيلهم ان الله غفور رحيم" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1256" ;
        quran:page                     "187" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:964  quran:ayah_text             "قُلۡ أَغَيۡرَ ٱللَّهِ أَبۡغِي رَبّٗا وَهُوَ رَبُّ كُلِّ شَيۡءٖۚ وَلَا تَكۡسِبُ كُلُّ نَفۡسٍ إِلَّا عَلَيۡهَاۚ وَلَا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰۚ ثُمَّ إِلَىٰ رَبِّكُم مَّرۡجِعُكُمۡ فَيُنَبِّئُكُم بِمَا كُنتُمۡ فِيهِ تَخۡتَلِفُونَ" ;
        quran:ayah_text_no_diacratic   "قل اغير الله ابغي ربا وهو رب كل شيء ولا تكسب كل نفس الا عليها ولا تزر وازرة وزر اخرىٰ ثم الىٰ ربكم مرجعكم فينبئكم بما كنتم فيه تختلفون" ;
        quran:ayahnumber               "164" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "964" ;
        quran:page                     "150" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2400  quran:ayah_text            "إِنَّنِيٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعۡبُدۡنِي وَأَقِمِ ٱلصَّلَوٰةَ لِذِكۡرِيٓ" ;
        quran:ayah_text_no_diacratic   "انني انا الله لا الٰه الا انا فاعبدني واقم الصلوٰة لذكري" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2400" ;
        quran:page                     "313" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:3304  quran:ayah_text            "وَقُلِ ٱلۡحَمۡدُ لِلَّهِ سَيُرِيكُمۡ ءَايَٰتِهِۦ فَتَعۡرِفُونَهَاۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "وقل الحمد لله سيريكم ءايٰته فتعرفونها وما ربك بغٰفل عما تعملون" ;
        quran:ayahnumber               "93" ;
