        quran:surrahname_no_diacratic  "سورة الانفطار" .

quran:520  quran:ayah_text             "وَإِنۡ أَرَدتُّمُ ٱسۡتِبۡدَالَ زَوۡجٖ مَّكَانَ زَوۡجٖ وَءَاتَيۡتُمۡ إِحۡدَىٰهُنَّ قِنطَارٗا فَلَا تَأۡخُذُواْ مِنۡهُ شَيۡـًٔاۚ أَتَأۡخُذُونَهُۥ بُهۡتَٰنٗا وَإِثۡمٗا مُّبِينٗا" ;
        quran:ayah_text_no_diacratic   "وان اردتم استبدال زوج مكان زوج وءاتيتم احدىٰهن قنطارا فلا تاخذوا منه شيا اتاخذونه بهتٰنا واثما مبينا" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "4" ;
        quran:hizb                     "8" ;
        quran:index                    "520" ;
        quran:page                     "81" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:330  quran:ayah_text             "قُلۡ أَطِيعُواْ ٱللَّهَ وَٱلرَّسُولَۖ فَإِن تَوَلَّوۡاْ فَإِنَّ ٱللَّهَ لَا يُحِبُّ ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "قل اطيعوا الله والرسول فان تولوا فان الله لا يحب الكٰفرين" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "330" ;
        quran:page                     "54" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:140  quran:ayah_text             "وَمَن يَرۡغَبُ عَن مِّلَّةِ إِبۡرَٰهِـۧمَ إِلَّا مَن سَفِهَ نَفۡسَهُۥۚ وَلَقَدِ ٱصۡطَفَيۡنَٰهُ فِي ٱلدُّنۡيَاۖ وَإِنَّهُۥ فِي ٱلۡأٓخِرَةِ لَمِنَ ٱلصَّٰلِحِينَ" ;
        quran:ayah_text_no_diacratic   "ومن يرغب عن ملة ابرٰهم الا من سفه نفسه ولقد اصطفينٰه في الدنيا وانه في الاخرة لمن الصٰلحين" ;
        quran:ayahnumber               "130" ;
        quran:chapter                  "1" ;
        quran:hizb                     "2" ;
        quran:index                    "140" ;
        quran:page                     "20" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1934  quran:ayah_text            "خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۚ تَعَٰلَىٰ عَمَّا يُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "خلق السمٰوٰت والارض بالحق تعٰلىٰ عما يشركون" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1934" ;
        quran:page                     "267" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2838  quran:ayah_text            "سُورَةٌ أَنزَلۡنَٰهَا وَفَرَضۡنَٰهَا وَأَنزَلۡنَا فِيهَآ ءَايَٰتِۭ بَيِّنَٰتٖ لَّعَلَّكُمۡ تَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "سورة انزلنٰها وفرضنٰها وانزلنا فيها ءايٰت بينٰت لعلكم تذكرون" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2838" ;
        quran:page                     "350" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1744  quran:ayah_text            "وَيُسَبِّحُ ٱلرَّعۡدُ بِحَمۡدِهِۦ وَٱلۡمَلَٰٓئِكَةُ مِنۡ خِيفَتِهِۦ وَيُرۡسِلُ ٱلصَّوَٰعِقَ فَيُصِيبُ بِهَا مَن يَشَآءُ وَهُمۡ يُجَٰدِلُونَ فِي ٱللَّهِ وَهُوَ شَدِيدُ ٱلۡمِحَالِ" ;
        quran:ayah_text_no_diacratic   "ويسبح الرعد بحمده والملٰئكة من خيفته ويرسل الصوٰعق فيصيب بها من يشاء وهم يجٰدلون في الله وهو شديد المحال" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1744" ;
        quran:page                     "250" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:2648  quran:ayah_text            "وَمِنَ ٱلنَّاسِ مَن يَعۡبُدُ ٱللَّهَ عَلَىٰ حَرۡفٖۖ فَإِنۡ أَصَابَهُۥ خَيۡرٌ ٱطۡمَأَنَّ بِهِۦۖ وَإِنۡ أَصَابَتۡهُ فِتۡنَةٌ ٱنقَلَبَ عَلَىٰ وَجۡهِهِۦ خَسِرَ ٱلدُّنۡيَا وَٱلۡأٓخِرَةَۚ ذَٰلِكَ هُوَ ٱلۡخُسۡرَانُ ٱلۡمُبِينُ" ;
        quran:ayah_text_no_diacratic   "ومن الناس من يعبد الله علىٰ حرف فان اصابه خير اطمان به وان اصابته فتنة انقلب علىٰ وجهه خسر الدنيا والاخرة ذٰلك هو الخسران المبين" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2648" ;
        quran:page                     "333" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:6383  quran:ayah_text            "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ" ;
        quran:ayah_text_no_diacratic   "بسم الله الرحمٰن الرحيم" ;
        quran:ayahnumber               "0" ;
        quran:chapter                  "30" ;
        quran:hizb                     "60" ;
        quran:index                    "6383" ;
        quran:page                     "601" ;
        quran:surahname                "سُورَةُ الهُمَزَةِ" ;
        quran:surahnumber              "104" ;
        quran:surrahname_no_diacratic  "سورة الهمزة" .

quran:1554  quran:ayah_text            "۞وَإِلَىٰ ثَمُودَ أَخَاهُمۡ صَٰلِحٗاۚ قَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥۖ هُوَ أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ وَٱسۡتَعۡمَرَكُمۡ فِيهَا فَٱسۡتَغۡفِرُوهُ ثُمَّ تُوبُوٓاْ إِلَيۡهِۚ إِنَّ رَبِّي قَرِيبٞ مُّجِيبٞ" ;
        quran:ayah_text_no_diacratic   "والىٰ ثمود اخاهم صٰلحا قال يٰقوم اعبدوا الله ما لكم من الٰه غيره هو انشاكم من الارض واستعمركم فيها فاستغفروه ثم توبوا اليه ان ربي قريب مجيب" ;
        quran:ayahnumber               "61" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1554" ;
        quran:page                     "228" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2458  quran:ayah_text            "قَالُواْ لَن نُّؤۡثِرَكَ عَلَىٰ مَا جَآءَنَا مِنَ ٱلۡبَيِّنَٰتِ وَٱلَّذِي فَطَرَنَاۖ فَٱقۡضِ مَآ أَنتَ قَاضٍۖ إِنَّمَا تَقۡضِي هَٰذِهِ ٱلۡحَيَوٰةَ ٱلدُّنۡيَآ" ;
        quran:ayah_text_no_diacratic   "قالوا لن نؤثرك علىٰ ما جاءنا من البينٰت والذي فطرنا فاقض ما انت قاض انما تقضي هٰذه الحيوٰة الدنيا" ;
        quran:ayahnumber               "72" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2458" ;
        quran:page                     "316" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:6193  quran:ayah_text            "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي" ;
        quran:ayah_text_no_diacratic   "يقول يٰليتني قدمت لحياتي" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "30" ;
