quran:3630  quran:ayah_text            "وَقَرۡنَ فِي بُيُوتِكُنَّ وَلَا تَبَرَّجۡنَ تَبَرُّجَ ٱلۡجَٰهِلِيَّةِ ٱلۡأُولَىٰۖ وَأَقِمۡنَ ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعۡنَ ٱللَّهَ وَرَسُولَهُۥٓۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُذۡهِبَ عَنكُمُ ٱلرِّجۡسَ أَهۡلَ ٱلۡبَيۡتِ وَيُطَهِّرَكُمۡ تَطۡهِيرٗا" ;
        quran:ayah_text_no_diacratic   "وقرن في بيوتكن ولا تبرجن تبرج الجٰهلية الاولىٰ واقمن الصلوٰة وءاتين الزكوٰة واطعن الله ورسوله انما يريد الله ليذهب عنكم الرجس اهل البيت ويطهركم تطهيرا" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3630" ;
        quran:page                     "422" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1392  quran:ayah_text            "دَعۡوَىٰهُمۡ فِيهَا سُبۡحَٰنَكَ ٱللَّهُمَّ وَتَحِيَّتُهُمۡ فِيهَا سَلَٰمٞۚ وَءَاخِرُ دَعۡوَىٰهُمۡ أَنِ ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "دعوىٰهم فيها سبحٰنك اللهم وتحيتهم فيها سلٰم وءاخر دعوىٰهم ان الحمد لله رب العٰلمين" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "11" ;
