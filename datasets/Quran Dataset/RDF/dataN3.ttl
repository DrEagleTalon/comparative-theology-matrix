quran:2689  quran:ayah_text            "وَمَآ أَرۡسَلۡنَا مِن قَبۡلِكَ مِن رَّسُولٖ وَلَا نَبِيٍّ إِلَّآ إِذَا تَمَنَّىٰٓ أَلۡقَى ٱلشَّيۡطَٰنُ فِيٓ أُمۡنِيَّتِهِۦ فَيَنسَخُ ٱللَّهُ مَا يُلۡقِي ٱلشَّيۡطَٰنُ ثُمَّ يُحۡكِمُ ٱللَّهُ ءَايَٰتِهِۦۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "وما ارسلنا من قبلك من رسول ولا نبي الا اذا تمنىٰ القى الشيطٰن في امنيته فينسخ الله ما يلقي الشيطٰن ثم يحكم الله ءايٰته والله عليم حكيم" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2689" ;
        quran:page                     "338" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

