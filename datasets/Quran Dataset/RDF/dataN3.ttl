        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:6194  quran:ayah_text            "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ" ;
        quran:ayah_text_no_diacratic   "فيومئذ لا يعذب عذابه احد" ;
