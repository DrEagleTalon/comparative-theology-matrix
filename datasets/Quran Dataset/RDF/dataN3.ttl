quran:3008  quran:ayah_text            "قَالَ رَبُّكُمۡ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "قال ربكم ورب ءابائكم الاولين" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "3008" ;
