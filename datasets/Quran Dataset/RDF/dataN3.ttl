        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:2752  quran:ayah_text            "أَيَعِدُكُمۡ أَنَّكُمۡ إِذَا مِتُّمۡ وَكُنتُمۡ تُرَابٗا وَعِظَٰمًا أَنَّكُم مُّخۡرَجُونَ" ;
        quran:ayah_text_no_diacratic   "ايعدكم انكم اذا متم وكنتم ترابا وعظٰما انكم مخرجون" ;
        quran:ayahnumber               "35" ;
