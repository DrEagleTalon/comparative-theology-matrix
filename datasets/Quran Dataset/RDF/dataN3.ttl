quran:1769  quran:ayah_text            "وَلَقَدۡ أَرۡسَلۡنَا رُسُلٗا مِّن قَبۡلِكَ وَجَعَلۡنَا لَهُمۡ أَزۡوَٰجٗا وَذُرِّيَّةٗۚ وَمَا كَانَ لِرَسُولٍ أَن يَأۡتِيَ بِـَٔايَةٍ إِلَّا بِإِذۡنِ ٱللَّهِۗ لِكُلِّ أَجَلٖ كِتَابٞ" ;
        quran:ayah_text_no_diacratic   "ولقد ارسلنا رسلا من قبلك وجعلنا لهم ازوٰجا وذرية وما كان لرسول ان ياتي باية الا باذن الله لكل اجل كتاب" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1769" ;
        quran:page                     "254" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:2913  quran:ayah_text            "تَبَارَكَ ٱلَّذِيٓ إِن شَآءَ جَعَلَ لَكَ خَيۡرٗا مِّن ذَٰلِكَ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ وَيَجۡعَل لَّكَ قُصُورَۢا" ;
        quran:ayah_text_no_diacratic   "تبارك الذي ان شاء جعل لك خيرا من ذٰلك جنٰت تجري من تحتها الانهٰر ويجعل لك قصورا" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "18" ;
        quran:hizb                     "36" ;
        quran:index                    "2913" ;
        quran:page                     "360" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3817  quran:ayah_text            "وَخَلَقۡنَا لَهُم مِّن مِّثۡلِهِۦ مَا يَرۡكَبُونَ" ;
        quran:ayah_text_no_diacratic   "وخلقنا لهم من مثله ما يركبون" ;
        quran:ayahnumber               "42" ;
