quran:5612  quran:ayah_text            "إِلَّا بَلَٰغٗا مِّنَ ٱللَّهِ وَرِسَٰلَٰتِهِۦۚ وَمَن يَعۡصِ ٱللَّهَ وَرَسُولَهُۥ فَإِنَّ لَهُۥ نَارَ جَهَنَّمَ خَٰلِدِينَ فِيهَآ أَبَدًا" ;
        quran:ayah_text_no_diacratic   "الا بلٰغا من الله ورسٰلٰته ومن يعص الله ورسوله فان له نار جهنم خٰلدين فيها ابدا" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5612" ;
        quran:page                     "573" ;
        quran:surahname                "سُورَةُ الجِنِّ" ;
        quran:surahnumber              "72" ;
        quran:surrahname_no_diacratic  "سورة الجن" .

quran:3374  quran:ayah_text            "وَرَبُّكَ يَخۡلُقُ مَا يَشَآءُ وَيَخۡتَارُۗ مَا كَانَ لَهُمُ ٱلۡخِيَرَةُۚ سُبۡحَٰنَ ٱللَّهِ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "وربك يخلق ما يشاء ويختار ما كان لهم الخيرة سبحٰن الله وتعٰلىٰ عما يشركون" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3374" ;
        quran:page                     "393" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4278  quran:ayah_text            "هُوَ ٱلَّذِي خَلَقَكُم مِّن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ مِنۡ عَلَقَةٖ ثُمَّ يُخۡرِجُكُمۡ طِفۡلٗا ثُمَّ لِتَبۡلُغُوٓاْ أَشُدَّكُمۡ ثُمَّ لِتَكُونُواْ شُيُوخٗاۚ وَمِنكُم مَّن يُتَوَفَّىٰ مِن قَبۡلُۖ وَلِتَبۡلُغُوٓاْ أَجَلٗا مُّسَمّٗى وَلَعَلَّكُمۡ تَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "هو الذي خلقكم من تراب ثم من نطفة ثم من علقة ثم يخرجكم طفلا ثم لتبلغوا اشدكم ثم لتكونوا شيوخا ومنكم من يتوفىٰ من قبل ولتبلغوا اجلا مسمى ولعلكم تعقلون" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4278" ;
        quran:page                     "475" ;
        quran:surahname                "سُورَةُ غَافِرٍ" ;
        quran:surahnumber              "40" ;
        quran:surrahname_no_diacratic  "سورة غافر" .

quran:2280  quran:ayah_text            "ذَٰلِكَ جَزَآؤُهُمۡ جَهَنَّمُ بِمَا كَفَرُواْ وَٱتَّخَذُوٓاْ ءَايَٰتِي وَرُسُلِي هُزُوًا" ;
        quran:ayah_text_no_diacratic   "ذٰلك جزاؤهم جهنم بما كفروا واتخذوا ءايٰتي ورسلي هزوا" ;
