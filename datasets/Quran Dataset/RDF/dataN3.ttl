quran:3344  quran:ayah_text            "وَقَالَ فِرۡعَوۡنُ يَٰٓأَيُّهَا ٱلۡمَلَأُ مَا عَلِمۡتُ لَكُم مِّنۡ إِلَٰهٍ غَيۡرِي فَأَوۡقِدۡ لِي يَٰهَٰمَٰنُ عَلَى ٱلطِّينِ فَٱجۡعَل لِّي صَرۡحٗا لَّعَلِّيٓ أَطَّلِعُ إِلَىٰٓ إِلَٰهِ مُوسَىٰ وَإِنِّي لَأَظُنُّهُۥ مِنَ ٱلۡكَٰذِبِينَ" ;
        quran:ayah_text_no_diacratic   "وقال فرعون يٰايها الملا ما علمت لكم من الٰه غيري فاوقد لي يٰهٰمٰن على الطين فاجعل لي صرحا لعلي اطلع الىٰ الٰه موسىٰ واني لاظنه من الكٰذبين" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3344" ;
        quran:page                     "390" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4248  quran:ayah_text            "أَسۡبَٰبَ ٱلسَّمَٰوَٰتِ فَأَطَّلِعَ إِلَىٰٓ إِلَٰهِ مُوسَىٰ وَإِنِّي لَأَظُنُّهُۥ كَٰذِبٗاۚ وَكَذَٰلِكَ زُيِّنَ لِفِرۡعَوۡنَ سُوٓءُ عَمَلِهِۦ وَصُدَّ عَنِ ٱلسَّبِيلِۚ وَمَا كَيۡدُ فِرۡعَوۡنَ إِلَّا فِي تَبَابٖ" ;
        quran:ayah_text_no_diacratic   "اسبٰب السمٰوٰت فاطلع الىٰ الٰه موسىٰ واني لاظنه كٰذبا وكذٰلك زين لفرعون سوء عمله وصد عن السبيل وما كيد فرعون الا في تباب" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4248" ;
        quran:page                     "471" ;
        quran:surahname                "سُورَةُ غَافِرٍ" ;
        quran:surahnumber              "40" ;
        quran:surrahname_no_diacratic  "سورة غافر" .

quran:2250  quran:ayah_text            "قَالَ إِن سَأَلۡتُكَ عَن شَيۡءِۭ بَعۡدَهَا فَلَا تُصَٰحِبۡنِيۖ قَدۡ بَلَغۡتَ مِن لَّدُنِّي عُذۡرٗا" ;
        quran:ayah_text_no_diacratic   "قال ان سالتك عن شيء بعدها فلا تصٰحبني قد بلغت من لدني عذرا" ;
