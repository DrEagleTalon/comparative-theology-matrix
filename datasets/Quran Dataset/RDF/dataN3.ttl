quran:40  quran:ayah_text              "وَإِذۡ قَالَ رَبُّكَ لِلۡمَلَٰٓئِكَةِ إِنِّي جَاعِلٞ فِي ٱلۡأَرۡضِ خَلِيفَةٗۖ قَالُوٓاْ أَتَجۡعَلُ فِيهَا مَن يُفۡسِدُ فِيهَا وَيَسۡفِكُ ٱلدِّمَآءَ وَنَحۡنُ نُسَبِّحُ بِحَمۡدِكَ وَنُقَدِّسُ لَكَۖ قَالَ إِنِّيٓ أَعۡلَمُ مَا لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "واذ قال ربك للملٰئكة اني جاعل في الارض خليفة قالوا اتجعل فيها من يفسد فيها ويسفك الدماء ونحن نسبح بحمدك ونقدس لك قال اني اعلم ما لا تعلمون" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "1" ;
        quran:hizb                     "0" ;
        quran:index                    "40" ;
        quran:page                     "6" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:639  quran:ayah_text             "ٱلَّذِينَ يَتَّخِذُونَ ٱلۡكَٰفِرِينَ أَوۡلِيَآءَ مِن دُونِ ٱلۡمُؤۡمِنِينَۚ أَيَبۡتَغُونَ عِندَهُمُ ٱلۡعِزَّةَ فَإِنَّ ٱلۡعِزَّةَ لِلَّهِ جَمِيعٗا" ;
        quran:ayah_text_no_diacratic   "الذين يتخذون الكٰفرين اولياء من دون المؤمنين ايبتغون عندهم العزة فان العزة لله جميعا" ;
        quran:ayahnumber               "139" ;
        quran:chapter                  "5" ;
        quran:hizb                     "10" ;
        quran:index                    "639" ;
        quran:page                     "100" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:449  quran:ayah_text             "سَنُلۡقِي فِي قُلُوبِ ٱلَّذِينَ كَفَرُواْ ٱلرُّعۡبَ بِمَآ أَشۡرَكُواْ بِٱللَّهِ مَا لَمۡ يُنَزِّلۡ بِهِۦ سُلۡطَٰنٗاۖ وَمَأۡوَىٰهُمُ ٱلنَّارُۖ وَبِئۡسَ مَثۡوَى ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "سنلقي في قلوب الذين كفروا الرعب بما اشركوا بالله ما لم ينزل به سلطٰنا وماوىٰهم النار وبئس مثوى الظٰلمين" ;
        quran:ayahnumber               "151" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "449" ;
        quran:page                     "69" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

