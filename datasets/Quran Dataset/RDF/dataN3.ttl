        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:699  quran:ayah_text             "يَٰقَوۡمِ ٱدۡخُلُواْ ٱلۡأَرۡضَ ٱلۡمُقَدَّسَةَ ٱلَّتِي كَتَبَ ٱللَّهُ لَكُمۡ وَلَا تَرۡتَدُّواْ عَلَىٰٓ أَدۡبَارِكُمۡ فَتَنقَلِبُواْ خَٰسِرِينَ" ;
        quran:ayah_text_no_diacratic   "يٰقوم ادخلوا الارض المقدسة التي كتب الله لكم ولا ترتدوا علىٰ ادباركم فتنقلبوا خٰسرين" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "699" ;
        quran:page                     "111" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2135  quran:ayah_text            "وَلَوۡلَآ أَن ثَبَّتۡنَٰكَ لَقَدۡ كِدتَّ تَرۡكَنُ إِلَيۡهِمۡ شَيۡـٔٗا قَلِيلًا" ;
        quran:ayah_text_no_diacratic   "ولولا ان ثبتنٰك لقد كدت تركن اليهم شيا قليلا" ;
        quran:ayahnumber               "74" ;
        quran:chapter                  "15" ;
