        quran:surahnumber              "96" ;
        quran:surrahname_no_diacratic  "سورة العلق" .

quran:4068  quran:ayah_text            "قَالَ لَقَدۡ ظَلَمَكَ بِسُؤَالِ نَعۡجَتِكَ إِلَىٰ نِعَاجِهِۦۖ وَإِنَّ كَثِيرٗا مِّنَ ٱلۡخُلَطَآءِ لَيَبۡغِي بَعۡضُهُمۡ عَلَىٰ بَعۡضٍ إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَقَلِيلٞ مَّا هُمۡۗ وَظَنَّ دَاوُۥدُ أَنَّمَا فَتَنَّٰهُ فَٱسۡتَغۡفَرَ رَبَّهُۥ وَخَرَّۤ رَاكِعٗاۤ وَأَنَابَ۩" ;
        quran:ayah_text_no_diacratic   "قال لقد ظلمك بسؤال نعجتك الىٰ نعاجه وان كثيرا من الخلطاء ليبغي بعضهم علىٰ بعض الا الذين ءامنوا وعملوا الصٰلحٰت وقليل ما هم وظن داود انما فتنٰه فاستغفر ربه وخر راكعا واناب" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
        quran:index                    "4068" ;
        quran:page                     "454" ;
        quran:sajdah                   "1" ;
        quran:surahname                "سُورَةُ صٓ" ;
        quran:surahnumber              "38" ;
        quran:surrahname_no_diacratic  "سورة ص" .

quran:2070  quran:ayah_text            "إِنَّ هَٰذَا ٱلۡقُرۡءَانَ يَهۡدِي لِلَّتِي هِيَ أَقۡوَمُ وَيُبَشِّرُ ٱلۡمُؤۡمِنِينَ ٱلَّذِينَ يَعۡمَلُونَ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمۡ أَجۡرٗا كَبِيرٗا" ;
        quran:ayah_text_no_diacratic   "ان هٰذا القرءان يهدي للتي هي اقوم ويبشر المؤمنين الذين يعملون الصٰلحٰت ان لهم اجرا كبيرا" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2070" ;
        quran:page                     "283" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:5212  quran:ayah_text            "لَقَدۡ أَرۡسَلۡنَا رُسُلَنَا بِٱلۡبَيِّنَٰتِ وَأَنزَلۡنَا مَعَهُمُ ٱلۡكِتَٰبَ وَٱلۡمِيزَانَ لِيَقُومَ ٱلنَّاسُ بِٱلۡقِسۡطِۖ وَأَنزَلۡنَا ٱلۡحَدِيدَ فِيهِ بَأۡسٞ شَدِيدٞ وَمَنَٰفِعُ لِلنَّاسِ وَلِيَعۡلَمَ ٱللَّهُ مَن يَنصُرُهُۥ وَرُسُلَهُۥ بِٱلۡغَيۡبِۚ إِنَّ ٱللَّهَ قَوِيٌّ عَزِيزٞ" ;
        quran:ayah_text_no_diacratic   "لقد ارسلنا رسلنا بالبينٰت وانزلنا معهم الكتٰب والميزان ليقوم الناس بالقسط وانزلنا الحديد فيه باس شديد ومنٰفع للناس وليعلم الله من ينصره ورسله بالغيب ان الله قوي عزيز" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "27" ;
        quran:hizb                     "54" ;
        quran:index                    "5212" ;
        quran:page                     "541" ;
        quran:surahname                "سُورَةُ الحَدِيدِ" ;
        quran:surahnumber              "57" ;
        quran:surrahname_no_diacratic  "سورة الحديد" .

quran:6116  quran:ayah_text            "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا" ;
        quran:ayah_text_no_diacratic   "انهم يكيدون كيدا" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "30" ;
        quran:hizb                     "59" ;
        quran:index                    "6116" ;
        quran:page                     "591" ;
        quran:surahname                "سُورَةُ الطَّارِقِ" ;
        quran:surahnumber              "86" ;
