        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1386  quran:ayah_text            "إِلَيۡهِ مَرۡجِعُكُمۡ جَمِيعٗاۖ وَعۡدَ ٱللَّهِ حَقًّاۚ إِنَّهُۥ يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥ لِيَجۡزِيَ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ بِٱلۡقِسۡطِۚ وَٱلَّذِينَ كَفَرُواْ لَهُمۡ شَرَابٞ مِّنۡ حَمِيمٖ وَعَذَابٌ أَلِيمُۢ بِمَا كَانُواْ يَكۡفُرُونَ" ;
        quran:ayah_text_no_diacratic   "اليه مرجعكم جميعا وعد الله حقا انه يبدؤا الخلق ثم يعيده ليجزي الذين ءامنوا وعملوا الصٰلحٰت بالقسط والذين كفروا لهم شراب من حميم وعذاب اليم بما كانوا يكفرون" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1386" ;
        quran:page                     "208" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4528  quran:ayah_text            "كَذَٰلِكَۖ وَأَوۡرَثۡنَٰهَا قَوۡمًا ءَاخَرِينَ" ;
        quran:ayah_text_no_diacratic   "كذٰلك واورثنٰها قوما ءاخرين" ;
        quran:ayahnumber               "28" ;
