quran:1797  quran:ayah_text            "وَبَرَزُواْ لِلَّهِ جَمِيعٗا فَقَالَ ٱلضُّعَفَٰٓؤُاْ لِلَّذِينَ ٱسۡتَكۡبَرُوٓاْ إِنَّا كُنَّا لَكُمۡ تَبَعٗا فَهَلۡ أَنتُم مُّغۡنُونَ عَنَّا مِنۡ عَذَابِ ٱللَّهِ مِن شَيۡءٖۚ قَالُواْ لَوۡ هَدَىٰنَا ٱللَّهُ لَهَدَيۡنَٰكُمۡۖ سَوَآءٌ عَلَيۡنَآ أَجَزِعۡنَآ أَمۡ صَبَرۡنَا مَا لَنَا مِن مَّحِيصٖ" ;
        quran:ayah_text_no_diacratic   "وبرزوا لله جميعا فقال الضعفٰؤا للذين استكبروا انا كنا لكم تبعا فهل انتم مغنون عنا من عذاب الله من شيء قالوا لو هدىٰنا الله لهدينٰكم سواء علينا اجزعنا ام صبرنا ما لنا من محيص" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1797" ;
        quran:page                     "258" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

