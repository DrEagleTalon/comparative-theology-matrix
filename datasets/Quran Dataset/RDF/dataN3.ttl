quran:2731  quran:ayah_text            "ثُمَّ خَلَقۡنَا ٱلنُّطۡفَةَ عَلَقَةٗ فَخَلَقۡنَا ٱلۡعَلَقَةَ مُضۡغَةٗ فَخَلَقۡنَا ٱلۡمُضۡغَةَ عِظَٰمٗا فَكَسَوۡنَا ٱلۡعِظَٰمَ لَحۡمٗا ثُمَّ أَنشَأۡنَٰهُ خَلۡقًا ءَاخَرَۚ فَتَبَارَكَ ٱللَّهُ أَحۡسَنُ ٱلۡخَٰلِقِينَ" ;
        quran:ayah_text_no_diacratic   "ثم خلقنا النطفة علقة فخلقنا العلقة مضغة فخلقنا المضغة عظٰما فكسونا العظٰم لحما ثم انشانٰه خلقا ءاخر فتبارك الله احسن الخٰلقين" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2731" ;
        quran:page                     "342" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3635  quran:ayah_text            "مَّا كَانَ عَلَى ٱلنَّبِيِّ مِنۡ حَرَجٖ فِيمَا فَرَضَ ٱللَّهُ لَهُۥۖ سُنَّةَ ٱللَّهِ فِي ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلُۚ وَكَانَ أَمۡرُ ٱللَّهِ قَدَرٗا مَّقۡدُورًا" ;
        quran:ayah_text_no_diacratic   "ما كان على النبي من حرج فيما فرض الله له سنة الله في الذين خلوا من قبل وكان امر الله قدرا مقدورا" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3635" ;
        quran:page                     "423" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1397  quran:ayah_text            "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَاتُنَا بَيِّنَٰتٖ قَالَ ٱلَّذِينَ لَا يَرۡجُونَ لِقَآءَنَا ٱئۡتِ بِقُرۡءَانٍ غَيۡرِ هَٰذَآ أَوۡ بَدِّلۡهُۚ قُلۡ مَا يَكُونُ لِيٓ أَنۡ أُبَدِّلَهُۥ مِن تِلۡقَآيِٕ نَفۡسِيٓۖ إِنۡ أَتَّبِعُ إِلَّا مَا يُوحَىٰٓ إِلَيَّۖ إِنِّيٓ أَخَافُ إِنۡ عَصَيۡتُ رَبِّي عَذَابَ يَوۡمٍ عَظِيمٖ" ;
        quran:ayah_text_no_diacratic   "واذا تتلىٰ عليهم ءاياتنا بينٰت قال الذين لا يرجون لقاءنا ائت بقرءان غير هٰذا او بدله قل ما يكون لي ان ابدله من تلقاي نفسي ان اتبع الا ما يوحىٰ الي اني اخاف ان عصيت ربي عذاب يوم عظيم" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1397" ;
        quran:page                     "210" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4539  quran:ayah_text            "مَا خَلَقۡنَٰهُمَآ إِلَّا بِٱلۡحَقِّ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ما خلقنٰهما الا بالحق ولٰكن اكثرهم لا يعلمون" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4539" ;
        quran:page                     "497" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2541  quran:ayah_text            "بَلۡ نَقۡذِفُ بِٱلۡحَقِّ عَلَى ٱلۡبَٰطِلِ فَيَدۡمَغُهُۥ فَإِذَا هُوَ زَاهِقٞۚ وَلَكُمُ ٱلۡوَيۡلُ مِمَّا تَصِفُونَ" ;
        quran:ayah_text_no_diacratic   "بل نقذف بالحق على البٰطل فيدمغه فاذا هو زاهق ولكم الويل مما تصفون" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2541" ;
        quran:page                     "323" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3445  quran:ayah_text            "بَلۡ هُوَ ءَايَٰتُۢ بَيِّنَٰتٞ فِي صُدُورِ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَۚ وَمَا يَجۡحَدُ بِـَٔايَٰتِنَآ إِلَّا ٱلظَّٰلِمُونَ" ;
        quran:ayah_text_no_diacratic   "بل هو ءايٰت بينٰت في صدور الذين اوتوا العلم وما يجحد بايٰتنا الا الظٰلمون" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3445" ;
        quran:page                     "402" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:2351  quran:ayah_text            "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا فَٱعۡبُدۡهُ وَٱصۡطَبِرۡ لِعِبَٰدَتِهِۦۚ هَلۡ تَعۡلَمُ لَهُۥ سَمِيّٗا" ;
        quran:ayah_text_no_diacratic   "رب السمٰوٰت والارض وما بينهما فاعبده واصطبر لعبٰدته هل تعلم له سميا" ;
        quran:ayahnumber               "65" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2351" ;
