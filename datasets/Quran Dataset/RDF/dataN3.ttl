        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:4746  quran:ayah_text            "مَّا يَلۡفِظُ مِن قَوۡلٍ إِلَّا لَدَيۡهِ رَقِيبٌ عَتِيدٞ" ;
        quran:ayah_text_no_diacratic   "ما يلفظ من قول الا لديه رقيب عتيد" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "26" ;
