        quran:surrahname_no_diacratic  "سورة الجن" .

quran:120  quran:ayah_text             "وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَۚ وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنۡ خَيۡرٖ تَجِدُوهُ عِندَ ٱللَّهِۗ إِنَّ ٱللَّهَ بِمَا تَعۡمَلُونَ بَصِيرٞ" ;
        quran:ayah_text_no_diacratic   "واقيموا الصلوٰة وءاتوا الزكوٰة وما تقدموا لانفسكم من خير تجدوه عند الله ان الله بما تعملون بصير" ;
        quran:ayahnumber               "110" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "120" ;
        quran:page                     "17" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1914  quran:ayah_text            "فَمَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يَكۡسِبُونَ" ;
        quran:ayah_text_no_diacratic   "فما اغنىٰ عنهم ما كانوا يكسبون" ;
