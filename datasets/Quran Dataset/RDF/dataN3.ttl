quran:908  quran:ayah_text             "وَلَا تَسُبُّواْ ٱلَّذِينَ يَدۡعُونَ مِن دُونِ ٱللَّهِ فَيَسُبُّواْ ٱللَّهَ عَدۡوَۢا بِغَيۡرِ عِلۡمٖۗ كَذَٰلِكَ زَيَّنَّا لِكُلِّ أُمَّةٍ عَمَلَهُمۡ ثُمَّ إِلَىٰ رَبِّهِم مَّرۡجِعُهُمۡ فَيُنَبِّئُهُم بِمَا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تسبوا الذين يدعون من دون الله فيسبوا الله عدوا بغير علم كذٰلك زينا لكل امة عملهم ثم الىٰ ربهم مرجعهم فينبئهم بما كانوا يعملون" ;
        quran:ayahnumber               "108" ;
        quran:chapter                  "7" ;
        quran:hizb                     "14" ;
        quran:index                    "908" ;
