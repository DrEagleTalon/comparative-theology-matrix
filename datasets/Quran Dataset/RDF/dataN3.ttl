quran:3646  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا نَكَحۡتُمُ ٱلۡمُؤۡمِنَٰتِ ثُمَّ طَلَّقۡتُمُوهُنَّ مِن قَبۡلِ أَن تَمَسُّوهُنَّ فَمَا لَكُمۡ عَلَيۡهِنَّ مِنۡ عِدَّةٖ تَعۡتَدُّونَهَاۖ فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحٗا جَمِيلٗا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اذا نكحتم المؤمنٰت ثم طلقتموهن من قبل ان تمسوهن فما لكم عليهن من عدة تعتدونها فمتعوهن وسرحوهن سراحا جميلا" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3646" ;
        quran:page                     "424" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:2552  quran:ayah_text            "۞وَمَن يَقُلۡ مِنۡهُمۡ إِنِّيٓ إِلَٰهٞ مِّن دُونِهِۦ فَذَٰلِكَ نَجۡزِيهِ جَهَنَّمَۚ كَذَٰلِكَ نَجۡزِي ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "ومن يقل منهم اني الٰه من دونه فذٰلك نجزيه جهنم كذٰلك نجزي الظٰلمين" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2552" ;
        quran:page                     "324" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3456  quran:ayah_text            "وَكَأَيِّن مِّن دَآبَّةٖ لَّا تَحۡمِلُ رِزۡقَهَا ٱللَّهُ يَرۡزُقُهَا وَإِيَّاكُمۡۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ" ;
        quran:ayah_text_no_diacratic   "وكاين من دابة لا تحمل رزقها الله يرزقها واياكم وهو السميع العليم" ;
        quran:ayahnumber               "60" ;
