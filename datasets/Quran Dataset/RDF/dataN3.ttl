        quran:surrahname_no_diacratic  "سورة الصافات" .

quran:1960  quran:ayah_text            "فَٱدۡخُلُوٓاْ أَبۡوَٰبَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۖ فَلَبِئۡسَ مَثۡوَى ٱلۡمُتَكَبِّرِينَ" ;
        quran:ayah_text_no_diacratic   "فادخلوا ابوٰب جهنم خٰلدين فيها فلبئس مثوى المتكبرين" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1960" ;
        quran:page                     "270" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2864  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَدۡخُلُواْ بُيُوتًا غَيۡرَ بُيُوتِكُمۡ حَتَّىٰ تَسۡتَأۡنِسُواْ وَتُسَلِّمُواْ عَلَىٰٓ أَهۡلِهَاۚ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ لَعَلَّكُمۡ تَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا تدخلوا بيوتا غير بيوتكم حتىٰ تستانسوا وتسلموا علىٰ اهلها ذٰلكم خير لكم لعلكم تذكرون" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2864" ;
        quran:page                     "352" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:3768  quran:ayah_text            "قُلۡ أَرَءَيۡتُمۡ شُرَكَآءَكُمُ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِ أَرُونِي مَاذَا خَلَقُواْ مِنَ ٱلۡأَرۡضِ أَمۡ لَهُمۡ شِرۡكٞ فِي ٱلسَّمَٰوَٰتِ أَمۡ ءَاتَيۡنَٰهُمۡ كِتَٰبٗا فَهُمۡ عَلَىٰ بَيِّنَتٖ مِّنۡهُۚ بَلۡ إِن يَعِدُ ٱلظَّٰلِمُونَ بَعۡضُهُم بَعۡضًا إِلَّا غُرُورًا" ;
        quran:ayah_text_no_diacratic   "قل ارءيتم شركاءكم الذين تدعون من دون الله اروني ماذا خلقوا من الارض ام لهم شرك في السمٰوٰت ام ءاتينٰهم كتٰبا فهم علىٰ بينت منه بل ان يعد الظٰلمون بعضهم بعضا الا غرورا" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3768" ;
        quran:page                     "439" ;
        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:1770  quran:ayah_text            "يَمۡحُواْ ٱللَّهُ مَا يَشَآءُ وَيُثۡبِتُۖ وَعِندَهُۥٓ أُمُّ ٱلۡكِتَٰبِ" ;
        quran:ayah_text_no_diacratic   "يمحوا الله ما يشاء ويثبت وعنده ام الكتٰب" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "13" ;
