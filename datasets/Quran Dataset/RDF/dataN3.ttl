        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:4402  quran:ayah_text            "فَإِنۡ أَعۡرَضُواْ فَمَآ أَرۡسَلۡنَٰكَ عَلَيۡهِمۡ حَفِيظًاۖ إِنۡ عَلَيۡكَ إِلَّا ٱلۡبَلَٰغُۗ وَإِنَّآ إِذَآ أَذَقۡنَا ٱلۡإِنسَٰنَ مِنَّا رَحۡمَةٗ فَرِحَ بِهَاۖ وَإِن تُصِبۡهُمۡ سَيِّئَةُۢ بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ فَإِنَّ ٱلۡإِنسَٰنَ كَفُورٞ" ;
        quran:ayah_text_no_diacratic   "فان اعرضوا فما ارسلنٰك عليهم حفيظا ان عليك الا البلٰغ وانا اذا اذقنا الانسٰن منا رحمة فرح بها وان تصبهم سيئة بما قدمت ايديهم فان الانسٰن كفور" ;
        quran:ayahnumber               "48" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4402" ;
        quran:page                     "488" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:2164  quran:ayah_text            "فَأَرَادَ أَن يَسۡتَفِزَّهُم مِّنَ ٱلۡأَرۡضِ فَأَغۡرَقۡنَٰهُ وَمَن مَّعَهُۥ جَمِيعٗا" ;
        quran:ayah_text_no_diacratic   "فاراد ان يستفزهم من الارض فاغرقنٰه ومن معه جميعا" ;
        quran:ayahnumber               "103" ;
