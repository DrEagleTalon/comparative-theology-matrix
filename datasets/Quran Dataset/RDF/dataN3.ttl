        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:886  quran:ayah_text             "وَإِسۡمَٰعِيلَ وَٱلۡيَسَعَ وَيُونُسَ وَلُوطٗاۚ وَكُلّٗا فَضَّلۡنَا عَلَى ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "واسمٰعيل واليسع ويونس ولوطا وكلا فضلنا على العٰلمين" ;
