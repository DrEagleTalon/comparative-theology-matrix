quran:3227  quran:ayah_text            "وَوَرِثَ سُلَيۡمَٰنُ دَاوُۥدَۖ وَقَالَ يَٰٓأَيُّهَا ٱلنَّاسُ عُلِّمۡنَا مَنطِقَ ٱلطَّيۡرِ وَأُوتِينَا مِن كُلِّ شَيۡءٍۖ إِنَّ هَٰذَا لَهُوَ ٱلۡفَضۡلُ ٱلۡمُبِينُ" ;
        quran:ayah_text_no_diacratic   "وورث سليمٰن داود وقال يٰايها الناس علمنا منطق الطير واوتينا من كل شيء ان هٰذا لهو الفضل المبين" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3227" ;
        quran:page                     "378" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:697  quran:ayah_text             "يَٰٓأَهۡلَ ٱلۡكِتَٰبِ قَدۡ جَآءَكُمۡ رَسُولُنَا يُبَيِّنُ لَكُمۡ عَلَىٰ فَتۡرَةٖ مِّنَ ٱلرُّسُلِ أَن تَقُولُواْ مَا جَآءَنَا مِنۢ بَشِيرٖ وَلَا نَذِيرٖۖ فَقَدۡ جَآءَكُم بَشِيرٞ وَنَذِيرٞۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "يٰاهل الكتٰب قد جاءكم رسولنا يبين لكم علىٰ فترة من الرسل ان تقولوا ما جاءنا من بشير ولا نذير فقد جاءكم بشير ونذير والله علىٰ كل شيء قدير" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "697" ;
        quran:page                     "111" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2133  quran:ayah_text            "وَمَن كَانَ فِي هَٰذِهِۦٓ أَعۡمَىٰ فَهُوَ فِي ٱلۡأٓخِرَةِ أَعۡمَىٰ وَأَضَلُّ سَبِيلٗا" ;
        quran:ayah_text_no_diacratic   "ومن كان في هٰذه اعمىٰ فهو في الاخرة اعمىٰ واضل سبيلا" ;
        quran:ayahnumber               "72" ;
        quran:chapter                  "15" ;
