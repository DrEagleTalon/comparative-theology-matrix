quran:4140  quran:ayah_text            "خَلَقَكُم مِّن نَّفۡسٖ وَٰحِدَةٖ ثُمَّ جَعَلَ مِنۡهَا زَوۡجَهَا وَأَنزَلَ لَكُم مِّنَ ٱلۡأَنۡعَٰمِ ثَمَٰنِيَةَ أَزۡوَٰجٖۚ يَخۡلُقُكُمۡ فِي بُطُونِ أُمَّهَٰتِكُمۡ خَلۡقٗا مِّنۢ بَعۡدِ خَلۡقٖ فِي ظُلُمَٰتٖ ثَلَٰثٖۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ لَهُ ٱلۡمُلۡكُۖ لَآ إِلَٰهَ إِلَّا هُوَۖ فَأَنَّىٰ تُصۡرَفُونَ" ;
        quran:ayah_text_no_diacratic   "خلقكم من نفس وٰحدة ثم جعل منها زوجها وانزل لكم من الانعٰم ثمٰنية ازوٰج يخلقكم في بطون امهٰتكم خلقا من بعد خلق في ظلمٰت ثلٰث ذٰلكم الله ربكم له الملك لا الٰه الا هو فانىٰ تصرفون" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
        quran:index                    "4140" ;
        quran:page                     "459" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:1309  quran:ayah_text            "وَمِنۡهُم مَّن يَلۡمِزُكَ فِي ٱلصَّدَقَٰتِ فَإِنۡ أُعۡطُواْ مِنۡهَا رَضُواْ وَإِن لَّمۡ يُعۡطَوۡاْ مِنۡهَآ إِذَا هُمۡ يَسۡخَطُونَ" ;
        quran:ayah_text_no_diacratic   "ومنهم من يلمزك في الصدقٰت فان اعطوا منها رضوا وان لم يعطوا منها اذا هم يسخطون" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "10" ;
