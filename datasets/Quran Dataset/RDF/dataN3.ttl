quran:4683  quran:ayah_text            "وَيُعَذِّبَ ٱلۡمُنَٰفِقِينَ وَٱلۡمُنَٰفِقَٰتِ وَٱلۡمُشۡرِكِينَ وَٱلۡمُشۡرِكَٰتِ ٱلظَّآنِّينَ بِٱللَّهِ ظَنَّ ٱلسَّوۡءِۚ عَلَيۡهِمۡ دَآئِرَةُ ٱلسَّوۡءِۖ وَغَضِبَ ٱللَّهُ عَلَيۡهِمۡ وَلَعَنَهُمۡ وَأَعَدَّ لَهُمۡ جَهَنَّمَۖ وَسَآءَتۡ مَصِيرٗا" ;
        quran:ayah_text_no_diacratic   "ويعذب المنٰفقين والمنٰفقٰت والمشركين والمشركٰت الظانين بالله ظن السوء عليهم دائرة السوء وغضب الله عليهم ولعنهم واعد لهم جهنم وساءت مصيرا" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4683" ;
        quran:page                     "511" ;
