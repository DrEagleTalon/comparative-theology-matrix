        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:740  quran:ayah_text             "وَتَرَىٰ كَثِيرٗا مِّنۡهُمۡ يُسَٰرِعُونَ فِي ٱلۡإِثۡمِ وَٱلۡعُدۡوَٰنِ وَأَكۡلِهِمُ ٱلسُّحۡتَۚ لَبِئۡسَ مَا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "وترىٰ كثيرا منهم يسٰرعون في الاثم والعدوٰن واكلهم السحت لبئس ما كانوا يعملون" ;
        quran:ayahnumber               "62" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "740" ;
        quran:page                     "118" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:550  quran:ayah_text             "ٱنظُرۡ كَيۡفَ يَفۡتَرُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَۖ وَكَفَىٰ بِهِۦٓ إِثۡمٗا مُّبِينًا" ;
        quran:ayah_text_no_diacratic   "انظر كيف يفترون على الله الكذب وكفىٰ به اثما مبينا" ;
        quran:ayahnumber               "50" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "550" ;
        quran:page                     "86" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:360  quran:ayah_text             "إِنَّ هَٰذَا لَهُوَ ٱلۡقَصَصُ ٱلۡحَقُّۚ وَمَا مِنۡ إِلَٰهٍ إِلَّا ٱللَّهُۚ وَإِنَّ ٱللَّهَ لَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ" ;
        quran:ayah_text_no_diacratic   "ان هٰذا لهو القصص الحق وما من الٰه الا الله وان الله لهو العزيز الحكيم" ;
        quran:ayahnumber               "62" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "360" ;
        quran:page                     "58" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:170  quran:ayah_text             "إِلَّا ٱلَّذِينَ تَابُواْ وَأَصۡلَحُواْ وَبَيَّنُواْ فَأُوْلَٰٓئِكَ أَتُوبُ عَلَيۡهِمۡ وَأَنَا ٱلتَّوَّابُ ٱلرَّحِيمُ" ;
        quran:ayah_text_no_diacratic   "الا الذين تابوا واصلحوا وبينوا فاولٰئك اتوب عليهم وانا التواب الرحيم" ;
        quran:ayahnumber               "160" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "170" ;
        quran:page                     "24" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1964  quran:ayah_text            "هَلۡ يَنظُرُونَ إِلَّآ أَن تَأۡتِيَهُمُ ٱلۡمَلَٰٓئِكَةُ أَوۡ يَأۡتِيَ أَمۡرُ رَبِّكَۚ كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبۡلِهِمۡۚ وَمَا ظَلَمَهُمُ ٱللَّهُ وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "هل ينظرون الا ان تاتيهم الملٰئكة او ياتي امر ربك كذٰلك فعل الذين من قبلهم وما ظلمهم الله ولٰكن كانوا انفسهم يظلمون" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1964" ;
        quran:page                     "270" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2868  quran:ayah_text            "وَقُل لِّلۡمُؤۡمِنَٰتِ يَغۡضُضۡنَ مِنۡ أَبۡصَٰرِهِنَّ وَيَحۡفَظۡنَ فُرُوجَهُنَّ وَلَا يُبۡدِينَ زِينَتَهُنَّ إِلَّا مَا ظَهَرَ مِنۡهَاۖ وَلۡيَضۡرِبۡنَ بِخُمُرِهِنَّ عَلَىٰ جُيُوبِهِنَّۖ وَلَا يُبۡدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوۡ ءَابَآئِهِنَّ أَوۡ ءَابَآءِ بُعُولَتِهِنَّ أَوۡ أَبۡنَآئِهِنَّ أَوۡ أَبۡنَآءِ بُعُولَتِهِنَّ أَوۡ إِخۡوَٰنِهِنَّ أَوۡ بَنِيٓ إِخۡوَٰنِهِنَّ أَوۡ بَنِيٓ أَخَوَٰتِهِنَّ أَوۡ نِسَآئِهِنَّ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُنَّ أَوِ ٱلتَّٰبِعِينَ غَيۡرِ أُوْلِي ٱلۡإِرۡبَةِ مِنَ ٱلرِّجَالِ أَوِ ٱلطِّفۡلِ ٱلَّذِينَ لَمۡ يَظۡهَرُواْ عَلَىٰ عَوۡرَٰتِ ٱلنِّسَآءِۖ وَلَا يَضۡرِبۡنَ بِأَرۡجُلِهِنَّ لِيُعۡلَمَ مَا يُخۡفِينَ مِن زِينَتِهِنَّۚ وَتُوبُوٓاْ إِلَى ٱللَّهِ جَمِيعًا أَيُّهَ ٱلۡمُؤۡمِنُونَ لَعَلَّكُمۡ تُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "وقل للمؤمنٰت يغضضن من ابصٰرهن ويحفظن فروجهن ولا يبدين زينتهن الا ما ظهر منها وليضربن بخمرهن علىٰ جيوبهن ولا يبدين زينتهن الا لبعولتهن او ءابائهن او ءاباء بعولتهن او ابنائهن او ابناء بعولتهن او اخوٰنهن او بني اخوٰنهن او بني اخوٰتهن او نسائهن او ما ملكت ايمٰنهن او التٰبعين غير اولي الاربة من الرجال او الطفل الذين لم يظهروا علىٰ عورٰت النساء ولا يضربن بارجلهن ليعلم ما يخفين من زينتهن وتوبوا الى الله جميعا ايه المؤمنون لعلكم تفلحون" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2868" ;
        quran:page                     "353" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1774  quran:ayah_text            "وَيَقُولُ ٱلَّذِينَ كَفَرُواْ لَسۡتَ مُرۡسَلٗاۚ قُلۡ كَفَىٰ بِٱللَّهِ شَهِيدَۢا بَيۡنِي وَبَيۡنَكُمۡ وَمَنۡ عِندَهُۥ عِلۡمُ ٱلۡكِتَٰبِ" ;
        quran:ayah_text_no_diacratic   "ويقول الذين كفروا لست مرسلا قل كفىٰ بالله شهيدا بيني وبينكم ومن عنده علم الكتٰب" ;
        quran:ayahnumber               "43" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1774" ;
        quran:page                     "255" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:4916  quran:ayah_text            "وَمَا لَهُم بِهِۦ مِنۡ عِلۡمٍۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّۖ وَإِنَّ ٱلظَّنَّ لَا يُغۡنِي مِنَ ٱلۡحَقِّ شَيۡـٔٗا" ;
        quran:ayah_text_no_diacratic   "وما لهم به من علم ان يتبعون الا الظن وان الظن لا يغني من الحق شيا" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "27" ;
        quran:hizb                     "52" ;
        quran:index                    "4916" ;
        quran:page                     "527" ;
        quran:surahname                "سُورَةُ النَّجۡمِ" ;
        quran:surahnumber              "53" ;
        quran:surrahname_no_diacratic  "سورة النجم" .

quran:2678  quran:ayah_text            "ٱلَّذِينَ إِن مَّكَّنَّٰهُمۡ فِي ٱلۡأَرۡضِ أَقَامُواْ ٱلصَّلَوٰةَ وَءَاتَوُاْ ٱلزَّكَوٰةَ وَأَمَرُواْ بِٱلۡمَعۡرُوفِ وَنَهَوۡاْ عَنِ ٱلۡمُنكَرِۗ وَلِلَّهِ عَٰقِبَةُ ٱلۡأُمُورِ" ;
        quran:ayah_text_no_diacratic   "الذين ان مكنٰهم في الارض اقاموا الصلوٰة وءاتوا الزكوٰة وامروا بالمعروف ونهوا عن المنكر ولله عٰقبة الامور" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2678" ;
        quran:page                     "337" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:3822  quran:ayah_text            "وَإِذَا قِيلَ لَهُمۡ أَنفِقُواْ مِمَّا رَزَقَكُمُ ٱللَّهُ قَالَ ٱلَّذِينَ كَفَرُواْ لِلَّذِينَ ءَامَنُوٓاْ أَنُطۡعِمُ مَن لَّوۡ يَشَآءُ ٱللَّهُ أَطۡعَمَهُۥٓ إِنۡ أَنتُمۡ إِلَّا فِي ضَلَٰلٖ مُّبِينٖ" ;
        quran:ayah_text_no_diacratic   "واذا قيل لهم انفقوا مما رزقكم الله قال الذين كفروا للذين ءامنوا انطعم من لو يشاء الله اطعمه ان انتم الا في ضلٰل مبين" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "23" ;
        quran:hizb                     "44" ;
        quran:index                    "3822" ;
        quran:page                     "443" ;
        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:1584  quran:ayah_text            "قَالُواْ يَٰشُعَيۡبُ مَا نَفۡقَهُ كَثِيرٗا مِّمَّا تَقُولُ وَإِنَّا لَنَرَىٰكَ فِينَا ضَعِيفٗاۖ وَلَوۡلَا رَهۡطُكَ لَرَجَمۡنَٰكَۖ وَمَآ أَنتَ عَلَيۡنَا بِعَزِيزٖ" ;
        quran:ayah_text_no_diacratic   "قالوا يٰشعيب ما نفقه كثيرا مما تقول وانا لنرىٰك فينا ضعيفا ولولا رهطك لرجمنٰك وما انت علينا بعزيز" ;
        quran:ayahnumber               "91" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1584" ;
        quran:page                     "232" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4726  quran:ayah_text            "إِنَّ ٱللَّهَ يَعۡلَمُ غَيۡبَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ بَصِيرُۢ بِمَا تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ان الله يعلم غيب السمٰوٰت والارض والله بصير بما تعملون" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4726" ;
        quran:page                     "517" ;
        quran:surahname                "سُورَةُ الحُجُرَاتِ" ;
        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:2488  quran:ayah_text            "يَوۡمَ يُنفَخُ فِي ٱلصُّورِۚ وَنَحۡشُرُ ٱلۡمُجۡرِمِينَ يَوۡمَئِذٖ زُرۡقٗا" ;
        quran:ayah_text_no_diacratic   "يوم ينفخ في الصور ونحشر المجرمين يومئذ زرقا" ;
        quran:ayahnumber               "102" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2488" ;
        quran:page                     "319" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:3632  quran:ayah_text            "إِنَّ ٱلۡمُسۡلِمِينَ وَٱلۡمُسۡلِمَٰتِ وَٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ وَٱلۡقَٰنِتِينَ وَٱلۡقَٰنِتَٰتِ وَٱلصَّٰدِقِينَ وَٱلصَّٰدِقَٰتِ وَٱلصَّٰبِرِينَ وَٱلصَّٰبِرَٰتِ وَٱلۡخَٰشِعِينَ وَٱلۡخَٰشِعَٰتِ وَٱلۡمُتَصَدِّقِينَ وَٱلۡمُتَصَدِّقَٰتِ وَٱلصَّٰٓئِمِينَ وَٱلصَّٰٓئِمَٰتِ وَٱلۡحَٰفِظِينَ فُرُوجَهُمۡ وَٱلۡحَٰفِظَٰتِ وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرٗا وَٱلذَّٰكِرَٰتِ أَعَدَّ ٱللَّهُ لَهُم مَّغۡفِرَةٗ وَأَجۡرًا عَظِيمٗا" ;
        quran:ayah_text_no_diacratic   "ان المسلمين والمسلمٰت والمؤمنين والمؤمنٰت والقٰنتين والقٰنتٰت والصٰدقين والصٰدقٰت والصٰبرين والصٰبرٰت والخٰشعين والخٰشعٰت والمتصدقين والمتصدقٰت والصٰئمين والصٰئمٰت والحٰفظين فروجهم والحٰفظٰت والذٰكرين الله كثيرا والذٰكرٰت اعد الله لهم مغفرة واجرا عظيما" ;
        quran:ayahnumber               "35" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3632" ;
        quran:page                     "422" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1394  quran:ayah_text            "وَإِذَا مَسَّ ٱلۡإِنسَٰنَ ٱلضُّرُّ دَعَانَا لِجَنۢبِهِۦٓ أَوۡ قَاعِدًا أَوۡ قَآئِمٗا فَلَمَّا كَشَفۡنَا عَنۡهُ ضُرَّهُۥ مَرَّ كَأَن لَّمۡ يَدۡعُنَآ إِلَىٰ ضُرّٖ مَّسَّهُۥۚ كَذَٰلِكَ زُيِّنَ لِلۡمُسۡرِفِينَ مَا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "واذا مس الانسٰن الضر دعانا لجنبه او قاعدا او قائما فلما كشفنا عنه ضره مر كان لم يدعنا الىٰ ضر مسه كذٰلك زين للمسرفين ما كانوا يعملون" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1394" ;
        quran:page                     "209" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4536  quran:ayah_text            "فَأۡتُواْ بِـَٔابَآئِنَآ إِن كُنتُمۡ صَٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "فاتوا بابائنا ان كنتم صٰدقين" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4536" ;
        quran:page                     "497" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2298  quran:ayah_text            "يَٰيَحۡيَىٰ خُذِ ٱلۡكِتَٰبَ بِقُوَّةٖۖ وَءَاتَيۡنَٰهُ ٱلۡحُكۡمَ صَبِيّٗا" ;
        quran:ayah_text_no_diacratic   "يٰيحيىٰ خذ الكتٰب بقوة وءاتينٰه الحكم صبيا" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2298" ;
        quran:page                     "306" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:3442  quran:ayah_text            "۞وَلَا تُجَٰدِلُوٓاْ أَهۡلَ ٱلۡكِتَٰبِ إِلَّا بِٱلَّتِي هِيَ أَحۡسَنُ إِلَّا ٱلَّذِينَ ظَلَمُواْ مِنۡهُمۡۖ وَقُولُوٓاْ ءَامَنَّا بِٱلَّذِيٓ أُنزِلَ إِلَيۡنَا وَأُنزِلَ إِلَيۡكُمۡ وَإِلَٰهُنَا وَإِلَٰهُكُمۡ وَٰحِدٞ وَنَحۡنُ لَهُۥ مُسۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تجٰدلوا اهل الكتٰب الا بالتي هي احسن الا الذين ظلموا منهم وقولوا ءامنا بالذي انزل الينا وانزل اليكم والٰهنا والٰهكم وٰحد ونحن له مسلمون" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "21" ;
