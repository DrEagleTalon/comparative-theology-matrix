        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:4332  quran:ayah_text            "وَلَا تَسۡتَوِي ٱلۡحَسَنَةُ وَلَا ٱلسَّيِّئَةُۚ ٱدۡفَعۡ بِٱلَّتِي هِيَ أَحۡسَنُ فَإِذَا ٱلَّذِي بَيۡنَكَ وَبَيۡنَهُۥ عَدَٰوَةٞ كَأَنَّهُۥ وَلِيٌّ حَمِيمٞ" ;
        quran:ayah_text_no_diacratic   "ولا تستوي الحسنة ولا السيئة ادفع بالتي هي احسن فاذا الذي بينك وبينه عدٰوة كانه ولي حميم" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "24" ;
        quran:hizb                     "48" ;
        quran:index                    "4332" ;
        quran:page                     "480" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2094  quran:ayah_text            "وَلَا تَقۡتُلُواْ ٱلنَّفۡسَ ٱلَّتِي حَرَّمَ ٱللَّهُ إِلَّا بِٱلۡحَقِّۗ وَمَن قُتِلَ مَظۡلُومٗا فَقَدۡ جَعَلۡنَا لِوَلِيِّهِۦ سُلۡطَٰنٗا فَلَا يُسۡرِف فِّي ٱلۡقَتۡلِۖ إِنَّهُۥ كَانَ مَنصُورٗا" ;
        quran:ayah_text_no_diacratic   "ولا تقتلوا النفس التي حرم الله الا بالحق ومن قتل مظلوما فقد جعلنا لوليه سلطٰنا فلا يسرف في القتل انه كان منصورا" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2094" ;
        quran:page                     "285" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:5236  quran:ayah_text            "يَوۡمَ يَبۡعَثُهُمُ ٱللَّهُ جَمِيعٗا فَيَحۡلِفُونَ لَهُۥ كَمَا يَحۡلِفُونَ لَكُمۡ وَيَحۡسَبُونَ أَنَّهُمۡ عَلَىٰ شَيۡءٍۚ أَلَآ إِنَّهُمۡ هُمُ ٱلۡكَٰذِبُونَ" ;
        quran:ayah_text_no_diacratic   "يوم يبعثهم الله جميعا فيحلفون له كما يحلفون لكم ويحسبون انهم علىٰ شيء الا انهم هم الكٰذبون" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5236" ;
        quran:page                     "544" ;
        quran:surahname                "سُورَةُ المُجَادلَةِ" ;
        quran:surahnumber              "58" ;
        quran:surrahname_no_diacratic  "سورة المجادلة" .

quran:4142  quran:ayah_text            "۞وَإِذَا مَسَّ ٱلۡإِنسَٰنَ ضُرّٞ دَعَا رَبَّهُۥ مُنِيبًا إِلَيۡهِ ثُمَّ إِذَا خَوَّلَهُۥ نِعۡمَةٗ مِّنۡهُ نَسِيَ مَا كَانَ يَدۡعُوٓاْ إِلَيۡهِ مِن قَبۡلُ وَجَعَلَ لِلَّهِ أَندَادٗا لِّيُضِلَّ عَن سَبِيلِهِۦۚ قُلۡ تَمَتَّعۡ بِكُفۡرِكَ قَلِيلًا إِنَّكَ مِنۡ أَصۡحَٰبِ ٱلنَّارِ" ;
        quran:ayah_text_no_diacratic   "واذا مس الانسٰن ضر دعا ربه منيبا اليه ثم اذا خوله نعمة منه نسي ما كان يدعوا اليه من قبل وجعل لله اندادا ليضل عن سبيله قل تمتع بكفرك قليلا انك من اصحٰب النار" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "23" ;
        quran:hizb                     "46" ;
        quran:index                    "4142" ;
        quran:page                     "459" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:5046  quran:ayah_text            "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ" ;
        quran:ayah_text_no_diacratic   "فاذا انشقت السماء فكانت وردة كالدهان" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "27" ;
