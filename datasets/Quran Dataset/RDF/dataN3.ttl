quran:3319  quran:ayah_text            "فَرَدَدۡنَٰهُ إِلَىٰٓ أُمِّهِۦ كَيۡ تَقَرَّ عَيۡنُهَا وَلَا تَحۡزَنَ وَلِتَعۡلَمَ أَنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "فرددنٰه الىٰ امه كي تقر عينها ولا تحزن ولتعلم ان وعد الله حق ولٰكن اكثرهم لا يعلمون" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3319" ;
        quran:page                     "386" ;
