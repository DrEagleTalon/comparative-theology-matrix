        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:922  quran:ayah_text             "أَوَمَن كَانَ مَيۡتٗا فَأَحۡيَيۡنَٰهُ وَجَعَلۡنَا لَهُۥ نُورٗا يَمۡشِي بِهِۦ فِي ٱلنَّاسِ كَمَن مَّثَلُهُۥ فِي ٱلظُّلُمَٰتِ لَيۡسَ بِخَارِجٖ مِّنۡهَاۚ كَذَٰلِكَ زُيِّنَ لِلۡكَٰفِرِينَ مَا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "اومن كان ميتا فاحيينٰه وجعلنا له نورا يمشي به في الناس كمن مثله في الظلمٰت ليس بخارج منها كذٰلك زين للكٰفرين ما كانوا يعملون" ;
        quran:ayahnumber               "122" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "922" ;
        quran:page                     "143" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2118  quran:ayah_text            "أُوْلَٰٓئِكَ ٱلَّذِينَ يَدۡعُونَ يَبۡتَغُونَ إِلَىٰ رَبِّهِمُ ٱلۡوَسِيلَةَ أَيُّهُمۡ أَقۡرَبُ وَيَرۡجُونَ رَحۡمَتَهُۥ وَيَخَافُونَ عَذَابَهُۥٓۚ إِنَّ عَذَابَ رَبِّكَ كَانَ مَحۡذُورٗا" ;
        quran:ayah_text_no_diacratic   "اولٰئك الذين يدعون يبتغون الىٰ ربهم الوسيلة ايهم اقرب ويرجون رحمته ويخافون عذابه ان عذاب ربك كان محذورا" ;
        quran:ayahnumber               "57" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2118" ;
        quran:page                     "287" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1024  quran:ayah_text            "وَهُوَ ٱلَّذِي يُرۡسِلُ ٱلرِّيَٰحَ بُشۡرَۢا بَيۡنَ يَدَيۡ رَحۡمَتِهِۦۖ حَتَّىٰٓ إِذَآ أَقَلَّتۡ سَحَابٗا ثِقَالٗا سُقۡنَٰهُ لِبَلَدٖ مَّيِّتٖ فَأَنزَلۡنَا بِهِ ٱلۡمَآءَ فَأَخۡرَجۡنَا بِهِۦ مِن كُلِّ ٱلثَّمَرَٰتِۚ كَذَٰلِكَ نُخۡرِجُ ٱلۡمَوۡتَىٰ لَعَلَّكُمۡ تَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "وهو الذي يرسل الريٰح بشرا بين يدي رحمته حتىٰ اذا اقلت سحابا ثقالا سقنٰه لبلد ميت فانزلنا به الماء فاخرجنا به من كل الثمرٰت كذٰلك نخرج الموتىٰ لعلكم تذكرون" ;
        quran:ayahnumber               "57" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1024" ;
        quran:page                     "157" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:732  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ مَن يَرۡتَدَّ مِنكُمۡ عَن دِينِهِۦ فَسَوۡفَ يَأۡتِي ٱللَّهُ بِقَوۡمٖ يُحِبُّهُمۡ وَيُحِبُّونَهُۥٓ أَذِلَّةٍ عَلَى ٱلۡمُؤۡمِنِينَ أَعِزَّةٍ عَلَى ٱلۡكَٰفِرِينَ يُجَٰهِدُونَ فِي سَبِيلِ ٱللَّهِ وَلَا يَخَافُونَ لَوۡمَةَ لَآئِمٖۚ ذَٰلِكَ فَضۡلُ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا من يرتد منكم عن دينه فسوف ياتي الله بقوم يحبهم ويحبونه اذلة على المؤمنين اعزة على الكٰفرين يجٰهدون في سبيل الله ولا يخافون لومة لائم ذٰلك فضل الله يؤتيه من يشاء والله وٰسع عليم" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "732" ;
        quran:page                     "117" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:542  quran:ayah_text             "يَوۡمَئِذٖ يَوَدُّ ٱلَّذِينَ كَفَرُواْ وَعَصَوُاْ ٱلرَّسُولَ لَوۡ تُسَوَّىٰ بِهِمُ ٱلۡأَرۡضُ وَلَا يَكۡتُمُونَ ٱللَّهَ حَدِيثٗا" ;
        quran:ayah_text_no_diacratic   "يومئذ يود الذين كفروا وعصوا الرسول لو تسوىٰ بهم الارض ولا يكتمون الله حديثا" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "5" ;
