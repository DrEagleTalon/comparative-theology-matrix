        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:3203  quran:ayah_text            "هَلۡ أُنَبِّئُكُمۡ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَٰطِينُ" ;
        quran:ayah_text_no_diacratic   "هل انبئكم علىٰ من تنزل الشيٰطين" ;
