        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2866  quran:ayah_text            "لَّيۡسَ عَلَيۡكُمۡ جُنَاحٌ أَن تَدۡخُلُواْ بُيُوتًا غَيۡرَ مَسۡكُونَةٖ فِيهَا مَتَٰعٞ لَّكُمۡۚ وَٱللَّهُ يَعۡلَمُ مَا تُبۡدُونَ وَمَا تَكۡتُمُونَ" ;
        quran:ayah_text_no_diacratic   "ليس عليكم جناح ان تدخلوا بيوتا غير مسكونة فيها متٰع لكم والله يعلم ما تبدون وما تكتمون" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2866" ;
        quran:page                     "353" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1772  quran:ayah_text            "أَوَلَمۡ يَرَوۡاْ أَنَّا نَأۡتِي ٱلۡأَرۡضَ نَنقُصُهَا مِنۡ أَطۡرَافِهَاۚ وَٱللَّهُ يَحۡكُمُ لَا مُعَقِّبَ لِحُكۡمِهِۦۚ وَهُوَ سَرِيعُ ٱلۡحِسَابِ" ;
        quran:ayah_text_no_diacratic   "اولم يروا انا ناتي الارض ننقصها من اطرافها والله يحكم لا معقب لحكمه وهو سريع الحساب" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1772" ;
        quran:page                     "254" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:4914  quran:ayah_text            "۞وَكَم مِّن مَّلَكٖ فِي ٱلسَّمَٰوَٰتِ لَا تُغۡنِي شَفَٰعَتُهُمۡ شَيۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن يَأۡذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرۡضَىٰٓ" ;
        quran:ayah_text_no_diacratic   "وكم من ملك في السمٰوٰت لا تغني شفٰعتهم شيا الا من بعد ان ياذن الله لمن يشاء ويرضىٰ" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "27" ;
        quran:hizb                     "52" ;
        quran:index                    "4914" ;
        quran:page                     "526" ;
        quran:surahname                "سُورَةُ النَّجۡمِ" ;
        quran:surahnumber              "53" ;
        quran:surrahname_no_diacratic  "سورة النجم" .

quran:2676  quran:ayah_text            "أُذِنَ لِلَّذِينَ يُقَٰتَلُونَ بِأَنَّهُمۡ ظُلِمُواْۚ وَإِنَّ ٱللَّهَ عَلَىٰ نَصۡرِهِمۡ لَقَدِيرٌ" ;
        quran:ayah_text_no_diacratic   "اذن للذين يقٰتلون بانهم ظلموا وان الله علىٰ نصرهم لقدير" ;
        quran:ayahnumber               "39" ;
