        quran:surrahname_no_diacratic  "سورة هود" .

quran:5251  quran:ayah_text            "وَٱلَّذِينَ تَبَوَّءُو ٱلدَّارَ وَٱلۡإِيمَٰنَ مِن قَبۡلِهِمۡ يُحِبُّونَ مَنۡ هَاجَرَ إِلَيۡهِمۡ وَلَا يَجِدُونَ فِي صُدُورِهِمۡ حَاجَةٗ مِّمَّآ أُوتُواْ وَيُؤۡثِرُونَ عَلَىٰٓ أَنفُسِهِمۡ وَلَوۡ كَانَ بِهِمۡ خَصَاصَةٞۚ وَمَن يُوقَ شُحَّ نَفۡسِهِۦ فَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "والذين تبوءو الدار والايمٰن من قبلهم يحبون من هاجر اليهم ولا يجدون في صدورهم حاجة مما اوتوا ويؤثرون علىٰ انفسهم ولو كان بهم خصاصة ومن يوق شح نفسه فاولٰئك هم المفلحون" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5251" ;
        quran:page                     "546" ;
        quran:surahname                "سُورَةُ الحَشۡرِ" ;
        quran:surahnumber              "59" ;
        quran:surrahname_no_diacratic  "سورة الحشر" .

