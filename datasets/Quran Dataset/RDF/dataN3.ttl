        quran:surrahname_no_diacratic  "سورة النور" .

quran:3785  quran:ayah_text            "وَسَوَآءٌ عَلَيۡهِمۡ ءَأَنذَرۡتَهُمۡ أَمۡ لَمۡ تُنذِرۡهُمۡ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "وسواء عليهم ءانذرتهم ام لم تنذرهم لا يؤمنون" ;
        quran:ayahnumber               "10" ;
