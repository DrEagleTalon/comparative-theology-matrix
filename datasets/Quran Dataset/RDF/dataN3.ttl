        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1752  quran:ayah_text            "وَٱلَّذِينَ يَصِلُونَ مَآ أَمَرَ ٱللَّهُ بِهِۦٓ أَن يُوصَلَ وَيَخۡشَوۡنَ رَبَّهُمۡ وَيَخَافُونَ سُوٓءَ ٱلۡحِسَابِ" ;
        quran:ayah_text_no_diacratic   "والذين يصلون ما امر الله به ان يوصل ويخشون ربهم ويخافون سوء الحساب" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1752" ;
        quran:page                     "252" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:2656  quran:ayah_text            "۞هَٰذَانِ خَصۡمَانِ ٱخۡتَصَمُواْ فِي رَبِّهِمۡۖ فَٱلَّذِينَ كَفَرُواْ قُطِّعَتۡ لَهُمۡ ثِيَابٞ مِّن نَّارٖ يُصَبُّ مِن فَوۡقِ رُءُوسِهِمُ ٱلۡحَمِيمُ" ;
        quran:ayah_text_no_diacratic   "هٰذان خصمان اختصموا في ربهم فالذين كفروا قطعت لهم ثياب من نار يصب من فوق رءوسهم الحميم" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2656" ;
        quran:page                     "334" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

