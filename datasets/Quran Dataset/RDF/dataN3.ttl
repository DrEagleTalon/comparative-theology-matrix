        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3029  quran:ayah_text            "قَالُوٓاْ ءَامَنَّا بِرَبِّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "قالوا ءامنا برب العٰلمين" ;
