        quran:surrahname_no_diacratic  "سورة مريم" .

quran:6044  quran:ayah_text            "وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ" ;
        quran:ayah_text_no_diacratic   "واذا راوهم قالوا ان هٰؤلاء لضالون" ;
