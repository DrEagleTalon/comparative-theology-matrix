        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:727  quran:ayah_text             "وَأَنِ ٱحۡكُم بَيۡنَهُم بِمَآ أَنزَلَ ٱللَّهُ وَلَا تَتَّبِعۡ أَهۡوَآءَهُمۡ وَٱحۡذَرۡهُمۡ أَن يَفۡتِنُوكَ عَنۢ بَعۡضِ مَآ أَنزَلَ ٱللَّهُ إِلَيۡكَۖ فَإِن تَوَلَّوۡاْ فَٱعۡلَمۡ أَنَّمَا يُرِيدُ ٱللَّهُ أَن يُصِيبَهُم بِبَعۡضِ ذُنُوبِهِمۡۗ وَإِنَّ كَثِيرٗا مِّنَ ٱلنَّاسِ لَفَٰسِقُونَ" ;
        quran:ayah_text_no_diacratic   "وان احكم بينهم بما انزل الله ولا تتبع اهواءهم واحذرهم ان يفتنوك عن بعض ما انزل الله اليك فان تولوا فاعلم انما يريد الله ان يصيبهم ببعض ذنوبهم وان كثيرا من الناس لفٰسقون" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "727" ;
        quran:page                     "116" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:537  quran:ayah_text             "ٱلَّذِينَ يَبۡخَلُونَ وَيَأۡمُرُونَ ٱلنَّاسَ بِٱلۡبُخۡلِ وَيَكۡتُمُونَ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضۡلِهِۦۗ وَأَعۡتَدۡنَا لِلۡكَٰفِرِينَ عَذَابٗا مُّهِينٗا" ;
        quran:ayah_text_no_diacratic   "الذين يبخلون ويامرون الناس بالبخل ويكتمون ما ءاتىٰهم الله من فضله واعتدنا للكٰفرين عذابا مهينا" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "537" ;
        quran:page                     "84" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4972  quran:ayah_text            "تَنزِعُ ٱلنَّاسَ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٖ مُّنقَعِرٖ" ;
