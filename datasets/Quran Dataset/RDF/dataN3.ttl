quran:241  quran:ayah_text             "وَإِذَا طَلَّقۡتُمُ ٱلنِّسَآءَ فَبَلَغۡنَ أَجَلَهُنَّ فَأَمۡسِكُوهُنَّ بِمَعۡرُوفٍ أَوۡ سَرِّحُوهُنَّ بِمَعۡرُوفٖۚ وَلَا تُمۡسِكُوهُنَّ ضِرَارٗا لِّتَعۡتَدُواْۚ وَمَن يَفۡعَلۡ ذَٰلِكَ فَقَدۡ ظَلَمَ نَفۡسَهُۥۚ وَلَا تَتَّخِذُوٓاْ ءَايَٰتِ ٱللَّهِ هُزُوٗاۚ وَٱذۡكُرُواْ نِعۡمَتَ ٱللَّهِ عَلَيۡكُمۡ وَمَآ أَنزَلَ عَلَيۡكُم مِّنَ ٱلۡكِتَٰبِ وَٱلۡحِكۡمَةِ يَعِظُكُم بِهِۦۚ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ بِكُلِّ شَيۡءٍ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "واذا طلقتم النساء فبلغن اجلهن فامسكوهن بمعروف او سرحوهن بمعروف ولا تمسكوهن ضرارا لتعتدوا ومن يفعل ذٰلك فقد ظلم نفسه ولا تتخذوا ءايٰت الله هزوا واذكروا نعمت الله عليكم وما انزل عليكم من الكتٰب والحكمة يعظكم به واتقوا الله واعلموا ان الله بكل شيء عليم" ;
        quran:ayahnumber               "231" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "241" ;
        quran:page                     "37" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:5770  quran:ayah_text            "إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا" ;
        quran:ayah_text_no_diacratic   "ان هٰذه تذكرة فمن شاء اتخذ الىٰ ربه سبيلا" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "29" ;
        quran:hizb                     "58" ;
        quran:index                    "5770" ;
        quran:page                     "580" ;
        quran:surahname                "سُورَةُ الإِنسَانِ" ;
        quran:surahnumber              "76" ;
        quran:surrahname_no_diacratic  "سورة الانسان" .

quran:2939  quran:ayah_text            "فَقُلۡنَا ٱذۡهَبَآ إِلَى ٱلۡقَوۡمِ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا فَدَمَّرۡنَٰهُمۡ تَدۡمِيرٗا" ;
        quran:ayah_text_no_diacratic   "فقلنا اذهبا الى القوم الذين كذبوا بايٰتنا فدمرنٰهم تدميرا" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "2939" ;
        quran:page                     "363" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:1845  quran:ayah_text            "لَقَالُوٓاْ إِنَّمَا سُكِّرَتۡ أَبۡصَٰرُنَا بَلۡ نَحۡنُ قَوۡمٞ مَّسۡحُورُونَ" ;
        quran:ayah_text_no_diacratic   "لقالوا انما سكرت ابصٰرنا بل نحن قوم مسحورون" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
