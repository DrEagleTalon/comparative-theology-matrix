quran:578  quran:ayah_text             "أَيۡنَمَا تَكُونُواْ يُدۡرِككُّمُ ٱلۡمَوۡتُ وَلَوۡ كُنتُمۡ فِي بُرُوجٖ مُّشَيَّدَةٖۗ وَإِن تُصِبۡهُمۡ حَسَنَةٞ يَقُولُواْ هَٰذِهِۦ مِنۡ عِندِ ٱللَّهِۖ وَإِن تُصِبۡهُمۡ سَيِّئَةٞ يَقُولُواْ هَٰذِهِۦ مِنۡ عِندِكَۚ قُلۡ كُلّٞ مِّنۡ عِندِ ٱللَّهِۖ فَمَالِ هَٰٓؤُلَآءِ ٱلۡقَوۡمِ لَا يَكَادُونَ يَفۡقَهُونَ حَدِيثٗا" ;
        quran:ayah_text_no_diacratic   "اينما تكونوا يدرككم الموت ولو كنتم في بروج مشيدة وان تصبهم حسنة يقولوا هٰذه من عند الله وان تصبهم سيئة يقولوا هٰذه من عندك قل كل من عند الله فمال هٰؤلاء القوم لا يكادون يفقهون حديثا" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "578" ;
        quran:page                     "90" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2014  quran:ayah_text            "يَعۡرِفُونَ نِعۡمَتَ ٱللَّهِ ثُمَّ يُنكِرُونَهَا وَأَكۡثَرُهُمُ ٱلۡكَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "يعرفون نعمت الله ثم ينكرونها واكثرهم الكٰفرون" ;
        quran:ayahnumber               "83" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2014" ;
        quran:page                     "276" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:388  quran:ayah_text             "إِنَّ ٱلَّذِينَ كَفَرُواْ بَعۡدَ إِيمَٰنِهِمۡ ثُمَّ ٱزۡدَادُواْ كُفۡرٗا لَّن تُقۡبَلَ تَوۡبَتُهُمۡ وَأُوْلَٰٓئِكَ هُمُ ٱلضَّآلُّونَ" ;
        quran:ayah_text_no_diacratic   "ان الذين كفروا بعد ايمٰنهم ثم ازدادوا كفرا لن تقبل توبتهم واولٰئك هم الضالون" ;
        quran:ayahnumber               "90" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "388" ;
        quran:page                     "61" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:198  quran:ayah_text             "وَلَا تَأۡكُلُوٓاْ أَمۡوَٰلَكُم بَيۡنَكُم بِٱلۡبَٰطِلِ وَتُدۡلُواْ بِهَآ إِلَى ٱلۡحُكَّامِ لِتَأۡكُلُواْ فَرِيقٗا مِّنۡ أَمۡوَٰلِ ٱلنَّاسِ بِٱلۡإِثۡمِ وَأَنتُمۡ تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تاكلوا اموٰلكم بينكم بالبٰطل وتدلوا بها الى الحكام لتاكلوا فريقا من اموٰل الناس بالاثم وانتم تعلمون" ;
