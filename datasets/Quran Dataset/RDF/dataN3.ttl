quran:1767  quran:ayah_text            "وَٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَفۡرَحُونَ بِمَآ أُنزِلَ إِلَيۡكَۖ وَمِنَ ٱلۡأَحۡزَابِ مَن يُنكِرُ بَعۡضَهُۥۚ قُلۡ إِنَّمَآ أُمِرۡتُ أَنۡ أَعۡبُدَ ٱللَّهَ وَلَآ أُشۡرِكَ بِهِۦٓۚ إِلَيۡهِ أَدۡعُواْ وَإِلَيۡهِ مَـَٔابِ" ;
        quran:ayah_text_no_diacratic   "والذين ءاتينٰهم الكتٰب يفرحون بما انزل اليك ومن الاحزاب من ينكر بعضه قل انما امرت ان اعبد الله ولا اشرك به اليه ادعوا واليه ماب" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1767" ;
        quran:page                     "254" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:4909  quran:ayah_text            "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىٰ" ;
        quran:ayah_text_no_diacratic   "الكم الذكر وله الانثىٰ" ;
