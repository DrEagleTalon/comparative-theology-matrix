quran:2895  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لِيَسۡتَـٔۡذِنكُمُ ٱلَّذِينَ مَلَكَتۡ أَيۡمَٰنُكُمۡ وَٱلَّذِينَ لَمۡ يَبۡلُغُواْ ٱلۡحُلُمَ مِنكُمۡ ثَلَٰثَ مَرَّٰتٖۚ مِّن قَبۡلِ صَلَوٰةِ ٱلۡفَجۡرِ وَحِينَ تَضَعُونَ ثِيَابَكُم مِّنَ ٱلظَّهِيرَةِ وَمِنۢ بَعۡدِ صَلَوٰةِ ٱلۡعِشَآءِۚ ثَلَٰثُ عَوۡرَٰتٖ لَّكُمۡۚ لَيۡسَ عَلَيۡكُمۡ وَلَا عَلَيۡهِمۡ جُنَاحُۢ بَعۡدَهُنَّۚ طَوَّٰفُونَ عَلَيۡكُم بَعۡضُكُمۡ عَلَىٰ بَعۡضٖۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا ليستذنكم الذين ملكت ايمٰنكم والذين لم يبلغوا الحلم منكم ثلٰث مرٰت من قبل صلوٰة الفجر وحين تضعون ثيابكم من الظهيرة ومن بعد صلوٰة العشاء ثلٰث عورٰت لكم ليس عليكم ولا عليهم جناح بعدهن طوٰفون عليكم بعضكم علىٰ بعض كذٰلك يبين الله لكم الايٰت والله عليم حكيم" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2895" ;
        quran:page                     "357" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:508  quran:ayah_text             "وَإِذَا حَضَرَ ٱلۡقِسۡمَةَ أُوْلُواْ ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينُ فَٱرۡزُقُوهُم مِّنۡهُ وَقُولُواْ لَهُمۡ قَوۡلٗا مَّعۡرُوفٗا" ;
        quran:ayah_text_no_diacratic   "واذا حضر القسمة اولوا القربىٰ واليتٰمىٰ والمسٰكين فارزقوهم منه وقولوا لهم قولا معروفا" ;
