        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:997  quran:ayah_text             "فَرِيقًا هَدَىٰ وَفَرِيقًا حَقَّ عَلَيۡهِمُ ٱلضَّلَٰلَةُۚ إِنَّهُمُ ٱتَّخَذُواْ ٱلشَّيَٰطِينَ أَوۡلِيَآءَ مِن دُونِ ٱللَّهِ وَيَحۡسَبُونَ أَنَّهُم مُّهۡتَدُونَ" ;
        quran:ayah_text_no_diacratic   "فريقا هدىٰ وفريقا حق عليهم الضلٰلة انهم اتخذوا الشيٰطين اولياء من دون الله ويحسبون انهم مهتدون" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "997" ;
        quran:page                     "153" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:2433  quran:ayah_text            "فَأۡتِيَاهُ فَقُولَآ إِنَّا رَسُولَا رَبِّكَ فَأَرۡسِلۡ مَعَنَا بَنِيٓ إِسۡرَٰٓءِيلَ وَلَا تُعَذِّبۡهُمۡۖ قَدۡ جِئۡنَٰكَ بِـَٔايَةٖ مِّن رَّبِّكَۖ وَٱلسَّلَٰمُ عَلَىٰ مَنِ ٱتَّبَعَ ٱلۡهُدَىٰٓ" ;
        quran:ayah_text_no_diacratic   "فاتياه فقولا انا رسولا ربك فارسل معنا بني اسرٰءيل ولا تعذبهم قد جئنٰك باية من ربك والسلٰم علىٰ من اتبع الهدىٰ" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2433" ;
        quran:page                     "314" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:3337  quran:ayah_text            "وَأَنۡ أَلۡقِ عَصَاكَۚ فَلَمَّا رَءَاهَا تَهۡتَزُّ كَأَنَّهَا جَآنّٞ وَلَّىٰ مُدۡبِرٗا وَلَمۡ يُعَقِّبۡۚ يَٰمُوسَىٰٓ أَقۡبِلۡ وَلَا تَخَفۡۖ إِنَّكَ مِنَ ٱلۡأٓمِنِينَ" ;
        quran:ayah_text_no_diacratic   "وان الق عصاك فلما رءاها تهتز كانها جان ولىٰ مدبرا ولم يعقب يٰموسىٰ اقبل ولا تخف انك من الامنين" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3337" ;
        quran:page                     "389" ;
