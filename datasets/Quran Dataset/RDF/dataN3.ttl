        quran:index                    "2049" ;
        quran:page                     "280" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:663  quran:ayah_text             "۞إِنَّآ أَوۡحَيۡنَآ إِلَيۡكَ كَمَآ أَوۡحَيۡنَآ إِلَىٰ نُوحٖ وَٱلنَّبِيِّـۧنَ مِنۢ بَعۡدِهِۦۚ وَأَوۡحَيۡنَآ إِلَىٰٓ إِبۡرَٰهِيمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ وَيَعۡقُوبَ وَٱلۡأَسۡبَاطِ وَعِيسَىٰ وَأَيُّوبَ وَيُونُسَ وَهَٰرُونَ وَسُلَيۡمَٰنَۚ وَءَاتَيۡنَا دَاوُۥدَ زَبُورٗا" ;
        quran:ayah_text_no_diacratic   "انا اوحينا اليك كما اوحينا الىٰ نوح والنبين من بعده واوحينا الىٰ ابرٰهيم واسمٰعيل واسحٰق ويعقوب والاسباط وعيسىٰ وايوب ويونس وهٰرون وسليمٰن وءاتينا داود زبورا" ;
        quran:ayahnumber               "163" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "663" ;
        quran:page                     "104" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:3003  quran:ayah_text            "فَفَرَرۡتُ مِنكُمۡ لَمَّا خِفۡتُكُمۡ فَوَهَبَ لِي رَبِّي حُكۡمٗا وَجَعَلَنِي مِنَ ٱلۡمُرۡسَلِينَ" ;
        quran:ayah_text_no_diacratic   "ففررت منكم لما خفتكم فوهب لي ربي حكما وجعلني من المرسلين" ;
        quran:ayahnumber               "21" ;
