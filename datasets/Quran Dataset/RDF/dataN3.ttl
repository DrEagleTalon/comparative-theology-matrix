        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:3548  quran:ayah_text            "وَٱقۡصِدۡ فِي مَشۡيِكَ وَٱغۡضُضۡ مِن صَوۡتِكَۚ إِنَّ أَنكَرَ ٱلۡأَصۡوَٰتِ لَصَوۡتُ ٱلۡحَمِيرِ" ;
        quran:ayah_text_no_diacratic   "واقصد في مشيك واغضض من صوتك ان انكر الاصوٰت لصوت الحمير" ;
