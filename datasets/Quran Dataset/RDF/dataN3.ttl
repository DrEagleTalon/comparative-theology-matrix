        quran:surrahname_no_diacratic  "سورة الطور" .

quran:3784  quran:ayah_text            "وَجَعَلۡنَا مِنۢ بَيۡنِ أَيۡدِيهِمۡ سَدّٗا وَمِنۡ خَلۡفِهِمۡ سَدّٗا فَأَغۡشَيۡنَٰهُمۡ فَهُمۡ لَا يُبۡصِرُونَ" ;
        quran:ayah_text_no_diacratic   "وجعلنا من بين ايديهم سدا ومن خلفهم سدا فاغشينٰهم فهم لا يبصرون" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "22" ;
        quran:hizb                     "44" ;
        quran:index                    "3784" ;
