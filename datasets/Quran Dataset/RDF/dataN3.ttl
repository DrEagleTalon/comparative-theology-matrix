        quran:surrahname_no_diacratic  "سورة الزخرف" .

quran:2195  quran:ayah_text            "وَكَذَٰلِكَ أَعۡثَرۡنَا عَلَيۡهِمۡ لِيَعۡلَمُوٓاْ أَنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَأَنَّ ٱلسَّاعَةَ لَا رَيۡبَ فِيهَآ إِذۡ يَتَنَٰزَعُونَ بَيۡنَهُمۡ أَمۡرَهُمۡۖ فَقَالُواْ ٱبۡنُواْ عَلَيۡهِم بُنۡيَٰنٗاۖ رَّبُّهُمۡ أَعۡلَمُ بِهِمۡۚ قَالَ ٱلَّذِينَ غَلَبُواْ عَلَىٰٓ أَمۡرِهِمۡ لَنَتَّخِذَنَّ عَلَيۡهِم مَّسۡجِدٗا" ;
        quran:ayah_text_no_diacratic   "وكذٰلك اعثرنا عليهم ليعلموا ان وعد الله حق وان الساعة لا ريب فيها اذ يتنٰزعون بينهم امرهم فقالوا ابنوا عليهم بنيٰنا ربهم اعلم بهم قال الذين غلبوا علىٰ امرهم لنتخذن عليهم مسجدا" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2195" ;
        quran:page                     "296" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:5337  quran:ayah_text            "وَأَطِيعُواْ ٱللَّهَ وَأَطِيعُواْ ٱلرَّسُولَۚ فَإِن تَوَلَّيۡتُمۡ فَإِنَّمَا عَلَىٰ رَسُولِنَا ٱلۡبَلَٰغُ ٱلۡمُبِينُ" ;
        quran:ayah_text_no_diacratic   "واطيعوا الله واطيعوا الرسول فان توليتم فانما علىٰ رسولنا البلٰغ المبين" ;
