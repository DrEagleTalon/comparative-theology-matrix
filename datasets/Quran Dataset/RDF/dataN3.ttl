quran:1643  quran:ayah_text            "وَٱسۡتَبَقَا ٱلۡبَابَ وَقَدَّتۡ قَمِيصَهُۥ مِن دُبُرٖ وَأَلۡفَيَا سَيِّدَهَا لَدَا ٱلۡبَابِۚ قَالَتۡ مَا جَزَآءُ مَنۡ أَرَادَ بِأَهۡلِكَ سُوٓءًا إِلَّآ أَن يُسۡجَنَ أَوۡ عَذَابٌ أَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "واستبقا الباب وقدت قميصه من دبر والفيا سيدها لدا الباب قالت ما جزاء من اراد باهلك سوءا الا ان يسجن او عذاب اليم" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1643" ;
        quran:page                     "238" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2547  quran:ayah_text            "أَمِ ٱتَّخَذُواْ مِن دُونِهِۦٓ ءَالِهَةٗۖ قُلۡ هَاتُواْ بُرۡهَٰنَكُمۡۖ هَٰذَا ذِكۡرُ مَن مَّعِيَ وَذِكۡرُ مَن قَبۡلِيۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ ٱلۡحَقَّۖ فَهُم مُّعۡرِضُونَ" ;
        quran:ayah_text_no_diacratic   "ام اتخذوا من دونه ءالهة قل هاتوا برهٰنكم هٰذا ذكر من معي وذكر من قبلي بل اكثرهم لا يعلمون الحق فهم معرضون" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2547" ;
        quran:page                     "323" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:6282  quran:ayah_text            "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا" ;
