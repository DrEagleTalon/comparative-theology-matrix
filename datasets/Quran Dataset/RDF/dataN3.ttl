        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2632  quran:ayah_text            "فَإِن تَوَلَّوۡاْ فَقُلۡ ءَاذَنتُكُمۡ عَلَىٰ سَوَآءٖۖ وَإِنۡ أَدۡرِيٓ أَقَرِيبٌ أَم بَعِيدٞ مَّا تُوعَدُونَ" ;
        quran:ayah_text_no_diacratic   "فان تولوا فقل ءاذنتكم علىٰ سواء وان ادري اقريب ام بعيد ما توعدون" ;
