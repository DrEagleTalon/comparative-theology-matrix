quran:142  quran:ayah_text             "وَوَصَّىٰ بِهَآ إِبۡرَٰهِـۧمُ بَنِيهِ وَيَعۡقُوبُ يَٰبَنِيَّ إِنَّ ٱللَّهَ ٱصۡطَفَىٰ لَكُمُ ٱلدِّينَ فَلَا تَمُوتُنَّ إِلَّا وَأَنتُم مُّسۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "ووصىٰ بها ابرٰهم بنيه ويعقوب يٰبني ان الله اصطفىٰ لكم الدين فلا تموتن الا وانتم مسلمون" ;
        quran:ayahnumber               "132" ;
        quran:chapter                  "1" ;
        quran:hizb                     "2" ;
        quran:index                    "142" ;
        quran:page                     "20" ;
