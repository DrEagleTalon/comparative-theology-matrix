        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:6290  quran:ayah_text            "ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ" ;
        quran:ayah_text_no_diacratic   "ثم رددنٰه اسفل سٰفلين" ;
        quran:ayahnumber               "5" ;
