        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:434  quran:ayah_text             "أُوْلَٰٓئِكَ جَزَآؤُهُم مَّغۡفِرَةٞ مِّن رَّبِّهِمۡ وَجَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَنِعۡمَ أَجۡرُ ٱلۡعَٰمِلِينَ" ;
        quran:ayah_text_no_diacratic   "اولٰئك جزاؤهم مغفرة من ربهم وجنٰت تجري من تحتها الانهٰر خٰلدين فيها ونعم اجر العٰملين" ;
