quran:1992  quran:ayah_text            "وَلَوۡ يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ بِظُلۡمِهِم مَّا تَرَكَ عَلَيۡهَا مِن دَآبَّةٖ وَلَٰكِن يُؤَخِّرُهُمۡ إِلَىٰٓ أَجَلٖ مُّسَمّٗىۖ فَإِذَا جَآءَ أَجَلُهُمۡ لَا يَسۡتَـٔۡخِرُونَ سَاعَةٗ وَلَا يَسۡتَقۡدِمُونَ" ;
        quran:ayah_text_no_diacratic   "ولو يؤاخذ الله الناس بظلمهم ما ترك عليها من دابة ولٰكن يؤخرهم الىٰ اجل مسمى فاذا جاء اجلهم لا يستخرون ساعة ولا يستقدمون" ;
        quran:ayahnumber               "61" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1992" ;
        quran:page                     "273" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2896  quran:ayah_text            "وَإِذَا بَلَغَ ٱلۡأَطۡفَٰلُ مِنكُمُ ٱلۡحُلُمَ فَلۡيَسۡتَـٔۡذِنُواْ كَمَا ٱسۡتَـٔۡذَنَ ٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمۡ ءَايَٰتِهِۦۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "واذا بلغ الاطفٰل منكم الحلم فليستذنوا كما استذن الذين من قبلهم كذٰلك يبين الله لكم ءايٰته والله عليم حكيم" ;
        quran:ayahnumber               "59" ;
        quran:chapter                  "18" ;
