quran:943  quran:ayah_text             "ثَمَٰنِيَةَ أَزۡوَٰجٖۖ مِّنَ ٱلضَّأۡنِ ٱثۡنَيۡنِ وَمِنَ ٱلۡمَعۡزِ ٱثۡنَيۡنِۗ قُلۡ ءَآلذَّكَرَيۡنِ حَرَّمَ أَمِ ٱلۡأُنثَيَيۡنِ أَمَّا ٱشۡتَمَلَتۡ عَلَيۡهِ أَرۡحَامُ ٱلۡأُنثَيَيۡنِۖ نَبِّـُٔونِي بِعِلۡمٍ إِن كُنتُمۡ صَٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "ثمٰنية ازوٰج من الضان اثنين ومن المعز اثنين قل ءالذكرين حرم ام الانثيين اما اشتملت عليه ارحام الانثيين نبوني بعلم ان كنتم صٰدقين" ;
        quran:ayahnumber               "143" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "943" ;
        quran:page                     "147" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2139  quran:ayah_text            "أَقِمِ ٱلصَّلَوٰةَ لِدُلُوكِ ٱلشَّمۡسِ إِلَىٰ غَسَقِ ٱلَّيۡلِ وَقُرۡءَانَ ٱلۡفَجۡرِۖ إِنَّ قُرۡءَانَ ٱلۡفَجۡرِ كَانَ مَشۡهُودٗا" ;
        quran:ayah_text_no_diacratic   "اقم الصلوٰة لدلوك الشمس الىٰ غسق اليل وقرءان الفجر ان قرءان الفجر كان مشهودا" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2139" ;
        quran:page                     "290" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1045  quran:ayah_text            "فَأَخَذَتۡهُمُ ٱلرَّجۡفَةُ فَأَصۡبَحُواْ فِي دَارِهِمۡ جَٰثِمِينَ" ;
        quran:ayah_text_no_diacratic   "فاخذتهم الرجفة فاصبحوا في دارهم جٰثمين" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1045" ;
        quran:page                     "160" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:753  quran:ayah_text             "مَّا ٱلۡمَسِيحُ ٱبۡنُ مَرۡيَمَ إِلَّا رَسُولٞ قَدۡ خَلَتۡ مِن قَبۡلِهِ ٱلرُّسُلُ وَأُمُّهُۥ صِدِّيقَةٞۖ كَانَا يَأۡكُلَانِ ٱلطَّعَامَۗ ٱنظُرۡ كَيۡفَ نُبَيِّنُ لَهُمُ ٱلۡأٓيَٰتِ ثُمَّ ٱنظُرۡ أَنَّىٰ يُؤۡفَكُونَ" ;
        quran:ayah_text_no_diacratic   "ما المسيح ابن مريم الا رسول قد خلت من قبله الرسل وامه صديقة كانا ياكلان الطعام انظر كيف نبين لهم الايٰت ثم انظر انىٰ يؤفكون" ;
        quran:ayahnumber               "75" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "753" ;
        quran:page                     "120" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:563  quran:ayah_text             "أُوْلَٰٓئِكَ ٱلَّذِينَ يَعۡلَمُ ٱللَّهُ مَا فِي قُلُوبِهِمۡ فَأَعۡرِضۡ عَنۡهُمۡ وَعِظۡهُمۡ وَقُل لَّهُمۡ فِيٓ أَنفُسِهِمۡ قَوۡلَۢا بَلِيغٗا" ;
        quran:ayah_text_no_diacratic   "اولٰئك الذين يعلم الله ما في قلوبهم فاعرض عنهم وعظهم وقل لهم في انفسهم قولا بليغا" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "563" ;
        quran:page                     "88" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:373  quran:ayah_text             "۞وَمِنۡ أَهۡلِ ٱلۡكِتَٰبِ مَنۡ إِن تَأۡمَنۡهُ بِقِنطَارٖ يُؤَدِّهِۦٓ إِلَيۡكَ وَمِنۡهُم مَّنۡ إِن تَأۡمَنۡهُ بِدِينَارٖ لَّا يُؤَدِّهِۦٓ إِلَيۡكَ إِلَّا مَا دُمۡتَ عَلَيۡهِ قَآئِمٗاۗ ذَٰلِكَ بِأَنَّهُمۡ قَالُواْ لَيۡسَ عَلَيۡنَا فِي ٱلۡأُمِّيِّـۧنَ سَبِيلٞ وَيَقُولُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ وَهُمۡ يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ومن اهل الكتٰب من ان تامنه بقنطار يؤده اليك ومنهم من ان تامنه بدينار لا يؤده اليك الا ما دمت عليه قائما ذٰلك بانهم قالوا ليس علينا في الامين سبيل ويقولون على الله الكذب وهم يعلمون" ;
        quran:ayahnumber               "75" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "373" ;
        quran:page                     "59" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:183  quran:ayah_text             "إِنَّمَا حَرَّمَ عَلَيۡكُمُ ٱلۡمَيۡتَةَ وَٱلدَّمَ وَلَحۡمَ ٱلۡخِنزِيرِ وَمَآ أُهِلَّ بِهِۦ لِغَيۡرِ ٱللَّهِۖ فَمَنِ ٱضۡطُرَّ غَيۡرَ بَاغٖ وَلَا عَادٖ فَلَآ إِثۡمَ عَلَيۡهِۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ" ;
        quran:ayah_text_no_diacratic   "انما حرم عليكم الميتة والدم ولحم الخنزير وما اهل به لغير الله فمن اضطر غير باغ ولا عاد فلا اثم عليه ان الله غفور رحيم" ;
        quran:ayahnumber               "173" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "183" ;
        quran:page                     "26" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1977  quran:ayah_text            "أَوۡ يَأۡخُذَهُمۡ فِي تَقَلُّبِهِمۡ فَمَا هُم بِمُعۡجِزِينَ" ;
        quran:ayah_text_no_diacratic   "او ياخذهم في تقلبهم فما هم بمعجزين" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1977" ;
        quran:page                     "272" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:1787  quran:ayah_text            "قَالَتۡ لَهُمۡ رُسُلُهُمۡ إِن نَّحۡنُ إِلَّا بَشَرٞ مِّثۡلُكُمۡ وَلَٰكِنَّ ٱللَّهَ يَمُنُّ عَلَىٰ مَن يَشَآءُ مِنۡ عِبَادِهِۦۖ وَمَا كَانَ لَنَآ أَن نَّأۡتِيَكُم بِسُلۡطَٰنٍ إِلَّا بِإِذۡنِ ٱللَّهِۚ وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ ٱلۡمُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "قالت لهم رسلهم ان نحن الا بشر مثلكم ولٰكن الله يمن علىٰ من يشاء من عباده وما كان لنا ان ناتيكم بسلطٰن الا باذن الله وعلى الله فليتوكل المؤمنون" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1787" ;
        quran:page                     "257" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:2931  quran:ayah_text            "يَٰوَيۡلَتَىٰ لَيۡتَنِي لَمۡ أَتَّخِذۡ فُلَانًا خَلِيلٗا" ;
        quran:ayah_text_no_diacratic   "يٰويلتىٰ ليتني لم اتخذ فلانا خليلا" ;
