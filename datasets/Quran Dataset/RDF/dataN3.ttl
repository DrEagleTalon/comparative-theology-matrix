quran:5029  quran:ayah_text            "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ" ;
        quran:ayah_text_no_diacratic   "بينهما برزخ لا يبغيان" ;
        quran:ayahnumber               "20" ;
