        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1029  quran:ayah_text            "أُبَلِّغُكُمۡ رِسَٰلَٰتِ رَبِّي وَأَنصَحُ لَكُمۡ وَأَعۡلَمُ مِنَ ٱللَّهِ مَا لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ابلغكم رسٰلٰت ربي وانصح لكم واعلم من الله ما لا تعلمون" ;
