quran:207  quran:ayah_text             "ٱلۡحَجُّ أَشۡهُرٞ مَّعۡلُومَٰتٞۚ فَمَن فَرَضَ فِيهِنَّ ٱلۡحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِي ٱلۡحَجِّۗ وَمَا تَفۡعَلُواْ مِنۡ خَيۡرٖ يَعۡلَمۡهُ ٱللَّهُۗ وَتَزَوَّدُواْ فَإِنَّ خَيۡرَ ٱلزَّادِ ٱلتَّقۡوَىٰۖ وَٱتَّقُونِ يَٰٓأُوْلِي ٱلۡأَلۡبَٰبِ" ;
        quran:ayah_text_no_diacratic   "الحج اشهر معلومٰت فمن فرض فيهن الحج فلا رفث ولا فسوق ولا جدال في الحج وما تفعلوا من خير يعلمه الله وتزودوا فان خير الزاد التقوىٰ واتقون يٰاولي الالبٰب" ;
        quran:ayahnumber               "197" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "207" ;
        quran:page                     "31" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

