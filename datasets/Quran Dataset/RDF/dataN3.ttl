quran:1505  quran:ayah_text            "فَلَعَلَّكَ تَارِكُۢ بَعۡضَ مَا يُوحَىٰٓ إِلَيۡكَ وَضَآئِقُۢ بِهِۦ صَدۡرُكَ أَن يَقُولُواْ لَوۡلَآ أُنزِلَ عَلَيۡهِ كَنزٌ أَوۡ جَآءَ مَعَهُۥ مَلَكٌۚ إِنَّمَآ أَنتَ نَذِيرٞۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ وَكِيلٌ" ;
        quran:ayah_text_no_diacratic   "فلعلك تارك بعض ما يوحىٰ اليك وضائق به صدرك ان يقولوا لولا انزل عليه كنز او جاء معه ملك انما انت نذير والله علىٰ كل شيء وكيل" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "12" ;
        quran:hizb                     "22" ;
        quran:index                    "1505" ;
        quran:page                     "222" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:5240  quran:ayah_text            "لَّا تَجِدُ قَوۡمٗا يُؤۡمِنُونَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ يُوَآدُّونَ مَنۡ حَآدَّ ٱللَّهَ وَرَسُولَهُۥ وَلَوۡ كَانُوٓاْ ءَابَآءَهُمۡ أَوۡ أَبۡنَآءَهُمۡ أَوۡ إِخۡوَٰنَهُمۡ أَوۡ عَشِيرَتَهُمۡۚ أُوْلَٰٓئِكَ كَتَبَ فِي قُلُوبِهِمُ ٱلۡإِيمَٰنَ وَأَيَّدَهُم بِرُوحٖ مِّنۡهُۖ وَيُدۡخِلُهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ رَضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُۚ أُوْلَٰٓئِكَ حِزۡبُ ٱللَّهِۚ أَلَآ إِنَّ حِزۡبَ ٱللَّهِ هُمُ ٱلۡمُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "لا تجد قوما يؤمنون بالله واليوم الاخر يوادون من حاد الله ورسوله ولو كانوا ءاباءهم او ابناءهم او اخوٰنهم او عشيرتهم اولٰئك كتب في قلوبهم الايمٰن وايدهم بروح منه ويدخلهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها رضي الله عنهم ورضوا عنه اولٰئك حزب الله الا ان حزب الله هم المفلحون" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5240" ;
        quran:page                     "545" ;
        quran:surahname                "سُورَةُ المُجَادلَةِ" ;
        quran:surahnumber              "58" ;
        quran:surrahname_no_diacratic  "سورة المجادلة" .

