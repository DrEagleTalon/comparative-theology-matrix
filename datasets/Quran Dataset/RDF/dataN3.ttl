        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5371  quran:ayah_text            "وَمَرۡيَمَ ٱبۡنَتَ عِمۡرَٰنَ ٱلَّتِيٓ أَحۡصَنَتۡ فَرۡجَهَا فَنَفَخۡنَا فِيهِ مِن رُّوحِنَا وَصَدَّقَتۡ بِكَلِمَٰتِ رَبِّهَا وَكُتُبِهِۦ وَكَانَتۡ مِنَ ٱلۡقَٰنِتِينَ" ;
        quran:ayah_text_no_diacratic   "ومريم ابنت عمرٰن التي احصنت فرجها فنفخنا فيه من روحنا وصدقت بكلمٰت ربها وكتبه وكانت من القٰنتين" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "28" ;
        quran:hizb                     "56" ;
