        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:4456  quran:ayah_text            "فَلَمَّا جَآءَهُم بِـَٔايَٰتِنَآ إِذَا هُم مِّنۡهَا يَضۡحَكُونَ" ;
        quran:ayah_text_no_diacratic   "فلما جاءهم بايٰتنا اذا هم منها يضحكون" ;
