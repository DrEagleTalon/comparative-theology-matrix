        quran:surrahname_no_diacratic  "سورة الصف" .

quran:2459  quran:ayah_text            "إِنَّآ ءَامَنَّا بِرَبِّنَا لِيَغۡفِرَ لَنَا خَطَٰيَٰنَا وَمَآ أَكۡرَهۡتَنَا عَلَيۡهِ مِنَ ٱلسِّحۡرِۗ وَٱللَّهُ خَيۡرٞ وَأَبۡقَىٰٓ" ;
        quran:ayah_text_no_diacratic   "انا ءامنا بربنا ليغفر لنا خطٰيٰنا وما اكرهتنا عليه من السحر والله خير وابقىٰ" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "16" ;
