quran:4687  quran:ayah_text            "إِنَّ ٱلَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ ٱللَّهَ يَدُ ٱللَّهِ فَوۡقَ أَيۡدِيهِمۡۚ فَمَن نَّكَثَ فَإِنَّمَا يَنكُثُ عَلَىٰ نَفۡسِهِۦۖ وَمَنۡ أَوۡفَىٰ بِمَا عَٰهَدَ عَلَيۡهُ ٱللَّهَ فَسَيُؤۡتِيهِ أَجۡرًا عَظِيمٗا" ;
        quran:ayah_text_no_diacratic   "ان الذين يبايعونك انما يبايعون الله يد الله فوق ايديهم فمن نكث فانما ينكث علىٰ نفسه ومن اوفىٰ بما عٰهد عليه الله فسيؤتيه اجرا عظيما" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4687" ;
        quran:page                     "512" ;
