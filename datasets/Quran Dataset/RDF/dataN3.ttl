quran:476  quran:ayah_text             "وَلَا يَحۡسَبَنَّ ٱلَّذِينَ كَفَرُوٓاْ أَنَّمَا نُمۡلِي لَهُمۡ خَيۡرٞ لِّأَنفُسِهِمۡۚ إِنَّمَا نُمۡلِي لَهُمۡ لِيَزۡدَادُوٓاْ إِثۡمٗاۖ وَلَهُمۡ عَذَابٞ مُّهِينٞ" ;
        quran:ayah_text_no_diacratic   "ولا يحسبن الذين كفروا انما نملي لهم خير لانفسهم انما نملي لهم ليزدادوا اثما ولهم عذاب مهين" ;
        quran:ayahnumber               "178" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "476" ;
        quran:page                     "73" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:286  quran:ayah_text             "يَمۡحَقُ ٱللَّهُ ٱلرِّبَوٰاْ وَيُرۡبِي ٱلصَّدَقَٰتِۗ وَٱللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ" ;
        quran:ayah_text_no_diacratic   "يمحق الله الربوٰا ويربي الصدقٰت والله لا يحب كل كفار اثيم" ;
