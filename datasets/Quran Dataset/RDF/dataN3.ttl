        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:1999  quran:ayah_text            "وَأَوۡحَىٰ رَبُّكَ إِلَى ٱلنَّحۡلِ أَنِ ٱتَّخِذِي مِنَ ٱلۡجِبَالِ بُيُوتٗا وَمِنَ ٱلشَّجَرِ وَمِمَّا يَعۡرِشُونَ" ;
        quran:ayah_text_no_diacratic   "واوحىٰ ربك الى النحل ان اتخذي من الجبال بيوتا ومن الشجر ومما يعرشون" ;
