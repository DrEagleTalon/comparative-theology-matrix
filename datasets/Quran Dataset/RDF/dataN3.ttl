        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:5436  quran:ayah_text            "قَالُواْ يَٰوَيۡلَنَآ إِنَّا كُنَّا طَٰغِينَ" ;
