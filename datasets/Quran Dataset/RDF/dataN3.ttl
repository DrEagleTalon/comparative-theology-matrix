quran:594  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا ضَرَبۡتُمۡ فِي سَبِيلِ ٱللَّهِ فَتَبَيَّنُواْ وَلَا تَقُولُواْ لِمَنۡ أَلۡقَىٰٓ إِلَيۡكُمُ ٱلسَّلَٰمَ لَسۡتَ مُؤۡمِنٗا تَبۡتَغُونَ عَرَضَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا فَعِندَ ٱللَّهِ مَغَانِمُ كَثِيرَةٞۚ كَذَٰلِكَ كُنتُم مِّن قَبۡلُ فَمَنَّ ٱللَّهُ عَلَيۡكُمۡ فَتَبَيَّنُوٓاْۚ إِنَّ ٱللَّهَ كَانَ بِمَا تَعۡمَلُونَ خَبِيرٗا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اذا ضربتم في سبيل الله فتبينوا ولا تقولوا لمن القىٰ اليكم السلٰم لست مؤمنا تبتغون عرض الحيوٰة الدنيا فعند الله مغانم كثيرة كذٰلك كنتم من قبل فمن الله عليكم فتبينوا ان الله كان بما تعملون خبيرا" ;
        quran:ayahnumber               "94" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "594" ;
        quran:page                     "93" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2030  quran:ayah_text            "إِنَّهُۥ لَيۡسَ لَهُۥ سُلۡطَٰنٌ عَلَى ٱلَّذِينَ ءَامَنُواْ وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ" ;
        quran:ayah_text_no_diacratic   "انه ليس له سلطٰن على الذين ءامنوا وعلىٰ ربهم يتوكلون" ;
