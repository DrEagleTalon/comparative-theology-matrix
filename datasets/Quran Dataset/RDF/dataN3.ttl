quran:267  quran:ayah_text             "ٱللَّهُ وَلِيُّ ٱلَّذِينَ ءَامَنُواْ يُخۡرِجُهُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۖ وَٱلَّذِينَ كَفَرُوٓاْ أَوۡلِيَآؤُهُمُ ٱلطَّٰغُوتُ يُخۡرِجُونَهُم مِّنَ ٱلنُّورِ إِلَى ٱلظُّلُمَٰتِۗ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ" ;
        quran:ayah_text_no_diacratic   "الله ولي الذين ءامنوا يخرجهم من الظلمٰت الى النور والذين كفروا اولياؤهم الطٰغوت يخرجونهم من النور الى الظلمٰت اولٰئك اصحٰب النار هم فيها خٰلدون" ;
        quran:ayahnumber               "257" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "267" ;
        quran:page                     "43" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

