        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1395  quran:ayah_text            "وَلَقَدۡ أَهۡلَكۡنَا ٱلۡقُرُونَ مِن قَبۡلِكُمۡ لَمَّا ظَلَمُواْ وَجَآءَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ وَمَا كَانُواْ لِيُؤۡمِنُواْۚ كَذَٰلِكَ نَجۡزِي ٱلۡقَوۡمَ ٱلۡمُجۡرِمِينَ" ;
        quran:ayah_text_no_diacratic   "ولقد اهلكنا القرون من قبلكم لما ظلموا وجاءتهم رسلهم بالبينٰت وما كانوا ليؤمنوا كذٰلك نجزي القوم المجرمين" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "11" ;
