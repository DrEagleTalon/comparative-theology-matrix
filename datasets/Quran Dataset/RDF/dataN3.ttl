        quran:surrahname_no_diacratic  "سورة القمر" .

quran:335  quran:ayah_text             "فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ حَسَنٖ وَأَنۢبَتَهَا نَبَاتًا حَسَنٗا وَكَفَّلَهَا زَكَرِيَّاۖ كُلَّمَا دَخَلَ عَلَيۡهَا زَكَرِيَّا ٱلۡمِحۡرَابَ وَجَدَ عِندَهَا رِزۡقٗاۖ قَالَ يَٰمَرۡيَمُ أَنَّىٰ لَكِ هَٰذَاۖ قَالَتۡ هُوَ مِنۡ عِندِ ٱللَّهِۖ إِنَّ ٱللَّهَ يَرۡزُقُ مَن يَشَآءُ بِغَيۡرِ حِسَابٍ" ;
        quran:ayah_text_no_diacratic   "فتقبلها ربها بقبول حسن وانبتها نباتا حسنا وكفلها زكريا كلما دخل عليها زكريا المحراب وجد عندها رزقا قال يٰمريم انىٰ لك هٰذا قالت هو من عند الله ان الله يرزق من يشاء بغير حساب" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "335" ;
        quran:page                     "54" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5864  quran:ayah_text            "يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا" ;
        quran:ayah_text_no_diacratic   "يوم يقوم الروح والملٰئكة صفا لا يتكلمون الا من اذن له الرحمٰن وقال صوابا" ;
