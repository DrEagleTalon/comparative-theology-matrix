        quran:surahnumber              "34" ;
        quran:surrahname_no_diacratic  "سورة سبا" .

quran:4585  quran:ayah_text            "وَقَالُواْ مَا هِيَ إِلَّا حَيَاتُنَا ٱلدُّنۡيَا نَمُوتُ وَنَحۡيَا وَمَا يُهۡلِكُنَآ إِلَّا ٱلدَّهۡرُۚ وَمَا لَهُم بِذَٰلِكَ مِنۡ عِلۡمٍۖ إِنۡ هُمۡ إِلَّا يَظُنُّونَ" ;
        quran:ayah_text_no_diacratic   "وقالوا ما هي الا حياتنا الدنيا نموت ونحيا وما يهلكنا الا الدهر وما لهم بذٰلك من علم ان هم الا يظنون" ;
