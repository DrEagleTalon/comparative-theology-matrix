        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3656  quran:ayah_text            "يَٰٓأَيُّهَا ٱلنَّبِيُّ قُل لِّأَزۡوَٰجِكَ وَبَنَاتِكَ وَنِسَآءِ ٱلۡمُؤۡمِنِينَ يُدۡنِينَ عَلَيۡهِنَّ مِن جَلَٰبِيبِهِنَّۚ ذَٰلِكَ أَدۡنَىٰٓ أَن يُعۡرَفۡنَ فَلَا يُؤۡذَيۡنَۗ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمٗا" ;
        quran:ayah_text_no_diacratic   "يٰايها النبي قل لازوٰجك وبناتك ونساء المؤمنين يدنين عليهن من جلٰبيبهن ذٰلك ادنىٰ ان يعرفن فلا يؤذين وكان الله غفورا رحيما" ;
        quran:ayahnumber               "59" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3656" ;
        quran:page                     "426" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:4800  quran:ayah_text            "إِذۡ دَخَلُواْ عَلَيۡهِ فَقَالُواْ سَلَٰمٗاۖ قَالَ سَلَٰمٞ قَوۡمٞ مُّنكَرُونَ" ;
        quran:ayah_text_no_diacratic   "اذ دخلوا عليه فقالوا سلٰما قال سلٰم قوم منكرون" ;
        quran:ayahnumber               "25" ;
