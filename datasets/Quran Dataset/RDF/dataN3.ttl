        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:5577  quran:ayah_text            "ثُمَّ يُعِيدُكُمۡ فِيهَا وَيُخۡرِجُكُمۡ إِخۡرَاجٗا" ;
