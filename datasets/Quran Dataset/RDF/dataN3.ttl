        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5599  quran:ayah_text            "وَأَنَّا لَا نَدۡرِيٓ أَشَرٌّ أُرِيدَ بِمَن فِي ٱلۡأَرۡضِ أَمۡ أَرَادَ بِهِمۡ رَبُّهُمۡ رَشَدٗا" ;
        quran:ayah_text_no_diacratic   "وانا لا ندري اشر اريد بمن في الارض ام اراد بهم ربهم رشدا" ;
        quran:ayahnumber               "10" ;
