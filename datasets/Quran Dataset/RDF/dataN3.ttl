quran:1658  quran:ayah_text            "مَا تَعۡبُدُونَ مِن دُونِهِۦٓ إِلَّآ أَسۡمَآءٗ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِنِ ٱلۡحُكۡمُ إِلَّا لِلَّهِ أَمَرَ أَلَّا تَعۡبُدُوٓاْ إِلَّآ إِيَّاهُۚ ذَٰلِكَ ٱلدِّينُ ٱلۡقَيِّمُ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ما تعبدون من دونه الا اسماء سميتموها انتم وءاباؤكم ما انزل الله بها من سلطٰن ان الحكم الا لله امر الا تعبدوا الا اياه ذٰلك الدين القيم ولٰكن اكثر الناس لا يعلمون" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "12" ;
        quran:hizb                     "24" ;
        quran:index                    "1658" ;
        quran:page                     "240" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5393  quran:ayah_text            "أَمَّنۡ هَٰذَا ٱلَّذِي هُوَ جُندٞ لَّكُمۡ يَنصُرُكُم مِّن دُونِ ٱلرَّحۡمَٰنِۚ إِنِ ٱلۡكَٰفِرُونَ إِلَّا فِي غُرُورٍ" ;
        quran:ayah_text_no_diacratic   "امن هٰذا الذي هو جند لكم ينصركم من دون الرحمٰن ان الكٰفرون الا في غرور" ;
