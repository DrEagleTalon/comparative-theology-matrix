quran:4715  quran:ayah_text            "وَٱعۡلَمُوٓاْ أَنَّ فِيكُمۡ رَسُولَ ٱللَّهِۚ لَوۡ يُطِيعُكُمۡ فِي كَثِيرٖ مِّنَ ٱلۡأَمۡرِ لَعَنِتُّمۡ وَلَٰكِنَّ ٱللَّهَ حَبَّبَ إِلَيۡكُمُ ٱلۡإِيمَٰنَ وَزَيَّنَهُۥ فِي قُلُوبِكُمۡ وَكَرَّهَ إِلَيۡكُمُ ٱلۡكُفۡرَ وَٱلۡفُسُوقَ وَٱلۡعِصۡيَانَۚ أُوْلَٰٓئِكَ هُمُ ٱلرَّٰشِدُونَ" ;
        quran:ayah_text_no_diacratic   "واعلموا ان فيكم رسول الله لو يطيعكم في كثير من الامر لعنتم ولٰكن الله حبب اليكم الايمٰن وزينه في قلوبكم وكره اليكم الكفر والفسوق والعصيان اولٰئك هم الرٰشدون" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4715" ;
        quran:page                     "516" ;
