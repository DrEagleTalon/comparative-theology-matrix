        quran:surrahname_no_diacratic  "سورة الشرح" .

quran:1453  quran:ayah_text            "۞وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ نُوحٍ إِذۡ قَالَ لِقَوۡمِهِۦ يَٰقَوۡمِ إِن كَانَ كَبُرَ عَلَيۡكُم مَّقَامِي وَتَذۡكِيرِي بِـَٔايَٰتِ ٱللَّهِ فَعَلَى ٱللَّهِ تَوَكَّلۡتُ فَأَجۡمِعُوٓاْ أَمۡرَكُمۡ وَشُرَكَآءَكُمۡ ثُمَّ لَا يَكُنۡ أَمۡرُكُمۡ عَلَيۡكُمۡ غُمَّةٗ ثُمَّ ٱقۡضُوٓاْ إِلَيَّ وَلَا تُنظِرُونِ" ;
        quran:ayah_text_no_diacratic   "واتل عليهم نبا نوح اذ قال لقومه يٰقوم ان كان كبر عليكم مقامي وتذكيري بايٰت الله فعلى الله توكلت فاجمعوا امركم وشركاءكم ثم لا يكن امركم عليكم غمة ثم اقضوا الي ولا تنظرون" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1453" ;
        quran:page                     "217" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2357  quran:ayah_text            "وَإِن مِّنكُمۡ إِلَّا وَارِدُهَاۚ كَانَ عَلَىٰ رَبِّكَ حَتۡمٗا مَّقۡضِيّٗا" ;
        quran:ayah_text_no_diacratic   "وان منكم الا واردها كان علىٰ ربك حتما مقضيا" ;
