quran:1320  quran:ayah_text            "كَٱلَّذِينَ مِن قَبۡلِكُمۡ كَانُوٓاْ أَشَدَّ مِنكُمۡ قُوَّةٗ وَأَكۡثَرَ أَمۡوَٰلٗا وَأَوۡلَٰدٗا فَٱسۡتَمۡتَعُواْ بِخَلَٰقِهِمۡ فَٱسۡتَمۡتَعۡتُم بِخَلَٰقِكُمۡ كَمَا ٱسۡتَمۡتَعَ ٱلَّذِينَ مِن قَبۡلِكُم بِخَلَٰقِهِمۡ وَخُضۡتُمۡ كَٱلَّذِي خَاضُوٓاْۚ أُوْلَٰٓئِكَ حَبِطَتۡ أَعۡمَٰلُهُمۡ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۖ وَأُوْلَٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ" ;
        quran:ayah_text_no_diacratic   "كالذين من قبلكم كانوا اشد منكم قوة واكثر اموٰلا واولٰدا فاستمتعوا بخلٰقهم فاستمتعتم بخلٰقكم كما استمتع الذين من قبلكم بخلٰقهم وخضتم كالذي خاضوا اولٰئك حبطت اعمٰلهم في الدنيا والاخرة واولٰئك هم الخٰسرون" ;
        quran:ayahnumber               "69" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1320" ;
        quran:page                     "198" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:3318  quran:ayah_text            "۞وَحَرَّمۡنَا عَلَيۡهِ ٱلۡمَرَاضِعَ مِن قَبۡلُ فَقَالَتۡ هَلۡ أَدُلُّكُمۡ عَلَىٰٓ أَهۡلِ بَيۡتٖ يَكۡفُلُونَهُۥ لَكُمۡ وَهُمۡ لَهُۥ نَٰصِحُونَ" ;
        quran:ayah_text_no_diacratic   "وحرمنا عليه المراضع من قبل فقالت هل ادلكم علىٰ اهل بيت يكفلونه لكم وهم له نٰصحون" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3318" ;
        quran:page                     "386" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:788  quran:ayah_text             "إِذۡ قَالَ ٱللَّهُ يَٰعِيسَى ٱبۡنَ مَرۡيَمَ ٱذۡكُرۡ نِعۡمَتِي عَلَيۡكَ وَعَلَىٰ وَٰلِدَتِكَ إِذۡ أَيَّدتُّكَ بِرُوحِ ٱلۡقُدُسِ تُكَلِّمُ ٱلنَّاسَ فِي ٱلۡمَهۡدِ وَكَهۡلٗاۖ وَإِذۡ عَلَّمۡتُكَ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَٱلتَّوۡرَىٰةَ وَٱلۡإِنجِيلَۖ وَإِذۡ تَخۡلُقُ مِنَ ٱلطِّينِ كَهَيۡـَٔةِ ٱلطَّيۡرِ بِإِذۡنِي فَتَنفُخُ فِيهَا فَتَكُونُ طَيۡرَۢا بِإِذۡنِيۖ وَتُبۡرِئُ ٱلۡأَكۡمَهَ وَٱلۡأَبۡرَصَ بِإِذۡنِيۖ وَإِذۡ تُخۡرِجُ ٱلۡمَوۡتَىٰ بِإِذۡنِيۖ وَإِذۡ كَفَفۡتُ بَنِيٓ إِسۡرَٰٓءِيلَ عَنكَ إِذۡ جِئۡتَهُم بِٱلۡبَيِّنَٰتِ فَقَالَ ٱلَّذِينَ كَفَرُواْ مِنۡهُمۡ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٞ" ;
        quran:ayah_text_no_diacratic   "اذ قال الله يٰعيسى ابن مريم اذكر نعمتي عليك وعلىٰ وٰلدتك اذ ايدتك بروح القدس تكلم الناس في المهد وكهلا واذ علمتك الكتٰب والحكمة والتورىٰة والانجيل واذ تخلق من الطين كهية الطير باذني فتنفخ فيها فتكون طيرا باذني وتبرئ الاكمه والابرص باذني واذ تخرج الموتىٰ باذني واذ كففت بني اسرٰءيل عنك اذ جئتهم بالبينٰت فقال الذين كفروا منهم ان هٰذا الا سحر مبين" ;
        quran:ayahnumber               "110" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "788" ;
        quran:page                     "126" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2224  quran:ayah_text            "وَإِذۡ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ كَانَ مِنَ ٱلۡجِنِّ فَفَسَقَ عَنۡ أَمۡرِ رَبِّهِۦٓۗ أَفَتَتَّخِذُونَهُۥ وَذُرِّيَّتَهُۥٓ أَوۡلِيَآءَ مِن دُونِي وَهُمۡ لَكُمۡ عَدُوُّۢۚ بِئۡسَ لِلظَّٰلِمِينَ بَدَلٗا" ;
        quran:ayah_text_no_diacratic   "واذ قلنا للملٰئكة اسجدوا لادم فسجدوا الا ابليس كان من الجن ففسق عن امر ربه افتتخذونه وذريته اولياء من دوني وهم لكم عدو بئس للظٰلمين بدلا" ;
        quran:ayahnumber               "50" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2224" ;
        quran:page                     "299" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3128  quran:ayah_text            "أَتُتۡرَكُونَ فِي مَا هَٰهُنَآ ءَامِنِينَ" ;
        quran:ayah_text_no_diacratic   "اتتركون في ما هٰهنا ءامنين" ;
        quran:ayahnumber               "146" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3128" ;
        quran:page                     "373" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:1130  quran:ayah_text            "وَسۡـَٔلۡهُمۡ عَنِ ٱلۡقَرۡيَةِ ٱلَّتِي كَانَتۡ حَاضِرَةَ ٱلۡبَحۡرِ إِذۡ يَعۡدُونَ فِي ٱلسَّبۡتِ إِذۡ تَأۡتِيهِمۡ حِيتَانُهُمۡ يَوۡمَ سَبۡتِهِمۡ شُرَّعٗا وَيَوۡمَ لَا يَسۡبِتُونَ لَا تَأۡتِيهِمۡۚ كَذَٰلِكَ نَبۡلُوهُم بِمَا كَانُواْ يَفۡسُقُونَ" ;
        quran:ayah_text_no_diacratic   "وسلهم عن القرية التي كانت حاضرة البحر اذ يعدون في السبت اذ تاتيهم حيتانهم يوم سبتهم شرعا ويوم لا يسبتون لا تاتيهم كذٰلك نبلوهم بما كانوا يفسقون" ;
        quran:ayahnumber               "163" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1130" ;
        quran:page                     "171" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:598  quran:ayah_text             "إِلَّا ٱلۡمُسۡتَضۡعَفِينَ مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ وَٱلۡوِلۡدَٰنِ لَا يَسۡتَطِيعُونَ حِيلَةٗ وَلَا يَهۡتَدُونَ سَبِيلٗا" ;
        quran:ayah_text_no_diacratic   "الا المستضعفين من الرجال والنساء والولدٰن لا يستطيعون حيلة ولا يهتدون سبيلا" ;
        quran:ayahnumber               "98" ;
        quran:chapter                  "5" ;
