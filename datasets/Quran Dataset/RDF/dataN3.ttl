quran:1257  quran:ayah_text            "وَإِنۡ أَحَدٞ مِّنَ ٱلۡمُشۡرِكِينَ ٱسۡتَجَارَكَ فَأَجِرۡهُ حَتَّىٰ يَسۡمَعَ كَلَٰمَ ٱللَّهِ ثُمَّ أَبۡلِغۡهُ مَأۡمَنَهُۥۚ ذَٰلِكَ بِأَنَّهُمۡ قَوۡمٞ لَّا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وان احد من المشركين استجارك فاجره حتىٰ يسمع كلٰم الله ثم ابلغه مامنه ذٰلك بانهم قوم لا يعلمون" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1257" ;
        quran:page                     "187" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:965  quran:ayah_text             "وَهُوَ ٱلَّذِي جَعَلَكُمۡ خَلَٰٓئِفَ ٱلۡأَرۡضِ وَرَفَعَ بَعۡضَكُمۡ فَوۡقَ بَعۡضٖ دَرَجَٰتٖ لِّيَبۡلُوَكُمۡ فِي مَآ ءَاتَىٰكُمۡۗ إِنَّ رَبَّكَ سَرِيعُ ٱلۡعِقَابِ وَإِنَّهُۥ لَغَفُورٞ رَّحِيمُۢ" ;
        quran:ayah_text_no_diacratic   "وهو الذي جعلكم خلٰئف الارض ورفع بعضكم فوق بعض درجٰت ليبلوكم في ما ءاتىٰكم ان ربك سريع العقاب وانه لغفور رحيم" ;
        quran:ayahnumber               "165" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "965" ;
        quran:page                     "150" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2401  quran:ayah_text            "إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخۡفِيهَا لِتُجۡزَىٰ كُلُّ نَفۡسِۭ بِمَا تَسۡعَىٰ" ;
        quran:ayah_text_no_diacratic   "ان الساعة ءاتية اكاد اخفيها لتجزىٰ كل نفس بما تسعىٰ" ;
        quran:ayahnumber               "15" ;
