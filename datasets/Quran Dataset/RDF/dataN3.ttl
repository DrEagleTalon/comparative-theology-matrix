        quran:index                    "1310" ;
        quran:page                     "196" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:778  quran:ayah_text             "قُل لَّا يَسۡتَوِي ٱلۡخَبِيثُ وَٱلطَّيِّبُ وَلَوۡ أَعۡجَبَكَ كَثۡرَةُ ٱلۡخَبِيثِۚ فَٱتَّقُواْ ٱللَّهَ يَٰٓأُوْلِي ٱلۡأَلۡبَٰبِ لَعَلَّكُمۡ تُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "قل لا يستوي الخبيث والطيب ولو اعجبك كثرة الخبيث فاتقوا الله يٰاولي الالبٰب لعلكم تفلحون" ;
        quran:ayahnumber               "100" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
