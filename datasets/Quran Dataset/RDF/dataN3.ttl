        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:4466  quran:ayah_text            "۞وَلَمَّا ضُرِبَ ٱبۡنُ مَرۡيَمَ مَثَلًا إِذَا قَوۡمُكَ مِنۡهُ يَصِدُّونَ" ;
