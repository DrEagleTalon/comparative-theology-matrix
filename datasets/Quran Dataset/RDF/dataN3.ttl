quran:1271  quran:ayah_text            "ٱلَّذِينَ ءَامَنُواْ وَهَاجَرُواْ وَجَٰهَدُواْ فِي سَبِيلِ ٱللَّهِ بِأَمۡوَٰلِهِمۡ وَأَنفُسِهِمۡ أَعۡظَمُ دَرَجَةً عِندَ ٱللَّهِۚ وَأُوْلَٰٓئِكَ هُمُ ٱلۡفَآئِزُونَ" ;
        quran:ayah_text_no_diacratic   "الذين ءامنوا وهاجروا وجٰهدوا في سبيل الله باموٰلهم وانفسهم اعظم درجة عند الله واولٰئك هم الفائزون" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1271" ;
        quran:page                     "189" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4413  quran:ayah_text            "وَإِنَّهُۥ فِيٓ أُمِّ ٱلۡكِتَٰبِ لَدَيۡنَا لَعَلِيٌّ حَكِيمٌ" ;
        quran:ayah_text_no_diacratic   "وانه في ام الكتٰب لدينا لعلي حكيم" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "25" ;
