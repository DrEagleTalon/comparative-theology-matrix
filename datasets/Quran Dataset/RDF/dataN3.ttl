        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3444  quran:ayah_text            "وَمَا كُنتَ تَتۡلُواْ مِن قَبۡلِهِۦ مِن كِتَٰبٖ وَلَا تَخُطُّهُۥ بِيَمِينِكَۖ إِذٗا لَّٱرۡتَابَ ٱلۡمُبۡطِلُونَ" ;
        quran:ayah_text_no_diacratic   "وما كنت تتلوا من قبله من كتٰب ولا تخطه بيمينك اذا لارتاب المبطلون" ;
        quran:ayahnumber               "48" ;
