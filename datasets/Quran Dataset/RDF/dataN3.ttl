quran:1402  quran:ayah_text            "وَيَقُولُونَ لَوۡلَآ أُنزِلَ عَلَيۡهِ ءَايَةٞ مِّن رَّبِّهِۦۖ فَقُلۡ إِنَّمَا ٱلۡغَيۡبُ لِلَّهِ فَٱنتَظِرُوٓاْ إِنِّي مَعَكُم مِّنَ ٱلۡمُنتَظِرِينَ" ;
        quran:ayah_text_no_diacratic   "ويقولون لولا انزل عليه ءاية من ربه فقل انما الغيب لله فانتظروا اني معكم من المنتظرين" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1402" ;
        quran:page                     "210" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2306  quran:ayah_text            "قَالَتۡ أَنَّىٰ يَكُونُ لِي غُلَٰمٞ وَلَمۡ يَمۡسَسۡنِي بَشَرٞ وَلَمۡ أَكُ بَغِيّٗا" ;
        quran:ayah_text_no_diacratic   "قالت انىٰ يكون لي غلٰم ولم يمسسني بشر ولم اك بغيا" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "16" ;
