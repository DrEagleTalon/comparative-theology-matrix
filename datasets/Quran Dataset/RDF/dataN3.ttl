quran:90  quran:ayah_text              "وَقَالُواْ لَن تَمَسَّنَا ٱلنَّارُ إِلَّآ أَيَّامٗا مَّعۡدُودَةٗۚ قُلۡ أَتَّخَذۡتُمۡ عِندَ ٱللَّهِ عَهۡدٗا فَلَن يُخۡلِفَ ٱللَّهُ عَهۡدَهُۥٓۖ أَمۡ تَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وقالوا لن تمسنا النار الا اياما معدودة قل اتخذتم عند الله عهدا فلن يخلف الله عهده ام تقولون على الله ما لا تعلمون" ;
        quran:ayahnumber               "80" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "90" ;
        quran:page                     "12" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1221  quran:ayah_text            "وَأَطِيعُواْ ٱللَّهَ وَرَسُولَهُۥ وَلَا تَنَٰزَعُواْ فَتَفۡشَلُواْ وَتَذۡهَبَ رِيحُكُمۡۖ وَٱصۡبِرُوٓاْۚ إِنَّ ٱللَّهَ مَعَ ٱلصَّٰبِرِينَ" ;
        quran:ayah_text_no_diacratic   "واطيعوا الله ورسوله ولا تنٰزعوا فتفشلوا وتذهب ريحكم واصبروا ان الله مع الصٰبرين" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "10" ;
