quran:1718  quran:ayah_text            "وَرَفَعَ أَبَوَيۡهِ عَلَى ٱلۡعَرۡشِ وَخَرُّواْ لَهُۥ سُجَّدٗاۖ وَقَالَ يَٰٓأَبَتِ هَٰذَا تَأۡوِيلُ رُءۡيَٰيَ مِن قَبۡلُ قَدۡ جَعَلَهَا رَبِّي حَقّٗاۖ وَقَدۡ أَحۡسَنَ بِيٓ إِذۡ أَخۡرَجَنِي مِنَ ٱلسِّجۡنِ وَجَآءَ بِكُم مِّنَ ٱلۡبَدۡوِ مِنۢ بَعۡدِ أَن نَّزَغَ ٱلشَّيۡطَٰنُ بَيۡنِي وَبَيۡنَ إِخۡوَتِيٓۚ إِنَّ رَبِّي لَطِيفٞ لِّمَا يَشَآءُۚ إِنَّهُۥ هُوَ ٱلۡعَلِيمُ ٱلۡحَكِيمُ" ;
        quran:ayah_text_no_diacratic   "ورفع ابويه على العرش وخروا له سجدا وقال يٰابت هٰذا تاويل رءيٰي من قبل قد جعلها ربي حقا وقد احسن بي اذ اخرجني من السجن وجاء بكم من البدو من بعد ان نزغ الشيطٰن بيني وبين اخوتي ان ربي لطيف لما يشاء انه هو العليم الحكيم" ;
        quran:ayahnumber               "100" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1718" ;
        quran:page                     "247" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5453  quran:ayah_text            "فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلۡحُوتِ إِذۡ نَادَىٰ وَهُوَ مَكۡظُومٞ" ;
        quran:ayah_text_no_diacratic   "فاصبر لحكم ربك ولا تكن كصاحب الحوت اذ نادىٰ وهو مكظوم" ;
