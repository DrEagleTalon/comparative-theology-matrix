quran:1719  quran:ayah_text            "۞رَبِّ قَدۡ ءَاتَيۡتَنِي مِنَ ٱلۡمُلۡكِ وَعَلَّمۡتَنِي مِن تَأۡوِيلِ ٱلۡأَحَادِيثِۚ فَاطِرَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ أَنتَ وَلِيِّۦ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۖ تَوَفَّنِي مُسۡلِمٗا وَأَلۡحِقۡنِي بِٱلصَّٰلِحِينَ" ;
        quran:ayah_text_no_diacratic   "رب قد ءاتيتني من الملك وعلمتني من تاويل الاحاديث فاطر السمٰوٰت والارض انت ولي في الدنيا والاخرة توفني مسلما والحقني بالصٰلحين" ;
        quran:ayahnumber               "101" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1719" ;
        quran:page                     "247" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5454  quran:ayah_text            "لَّوۡلَآ أَن تَدَٰرَكَهُۥ نِعۡمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلۡعَرَآءِ وَهُوَ مَذۡمُومٞ" ;
        quran:ayah_text_no_diacratic   "لولا ان تدٰركه نعمة من ربه لنبذ بالعراء وهو مذموم" ;
