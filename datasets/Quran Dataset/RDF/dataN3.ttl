quran:3703  quran:ayah_text            "وَقَالَ ٱلَّذِينَ كَفَرُواْ لَن نُّؤۡمِنَ بِهَٰذَا ٱلۡقُرۡءَانِ وَلَا بِٱلَّذِي بَيۡنَ يَدَيۡهِۗ وَلَوۡ تَرَىٰٓ إِذِ ٱلظَّٰلِمُونَ مَوۡقُوفُونَ عِندَ رَبِّهِمۡ يَرۡجِعُ بَعۡضُهُمۡ إِلَىٰ بَعۡضٍ ٱلۡقَوۡلَ يَقُولُ ٱلَّذِينَ ٱسۡتُضۡعِفُواْ لِلَّذِينَ ٱسۡتَكۡبَرُواْ لَوۡلَآ أَنتُمۡ لَكُنَّا مُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "وقال الذين كفروا لن نؤمن بهٰذا القرءان ولا بالذي بين يديه ولو ترىٰ اذ الظٰلمون موقوفون عند ربهم يرجع بعضهم الىٰ بعض القول يقول الذين استضعفوا للذين استكبروا لولا انتم لكنا مؤمنين" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3703" ;
        quran:page                     "431" ;
        quran:surahname                "سُورَةُ سَبَإٍ" ;
        quran:surahnumber              "34" ;
        quran:surrahname_no_diacratic  "سورة سبا" .

quran:1465  quran:ayah_text            "فَمَآ ءَامَنَ لِمُوسَىٰٓ إِلَّا ذُرِّيَّةٞ مِّن قَوۡمِهِۦ عَلَىٰ خَوۡفٖ مِّن فِرۡعَوۡنَ وَمَلَإِيْهِمۡ أَن يَفۡتِنَهُمۡۚ وَإِنَّ فِرۡعَوۡنَ لَعَالٖ فِي ٱلۡأَرۡضِ وَإِنَّهُۥ لَمِنَ ٱلۡمُسۡرِفِينَ" ;
        quran:ayah_text_no_diacratic   "فما ءامن لموسىٰ الا ذرية من قومه علىٰ خوف من فرعون وملايهم ان يفتنهم وان فرعون لعال في الارض وانه لمن المسرفين" ;
        quran:ayahnumber               "83" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1465" ;
        quran:page                     "218" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4607  quran:ayah_text            "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُنَا بَيِّنَٰتٖ قَالَ ٱلَّذِينَ كَفَرُواْ لِلۡحَقِّ لَمَّا جَآءَهُمۡ هَٰذَا سِحۡرٞ مُّبِينٌ" ;
        quran:ayah_text_no_diacratic   "واذا تتلىٰ عليهم ءايٰتنا بينٰت قال الذين كفروا للحق لما جاءهم هٰذا سحر مبين" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4607" ;
        quran:page                     "503" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2369  quran:ayah_text            "أَلَمۡ تَرَ أَنَّآ أَرۡسَلۡنَا ٱلشَّيَٰطِينَ عَلَى ٱلۡكَٰفِرِينَ تَؤُزُّهُمۡ أَزّٗا" ;
        quran:ayah_text_no_diacratic   "الم تر انا ارسلنا الشيٰطين على الكٰفرين تؤزهم ازا" ;
        quran:ayahnumber               "83" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2369" ;
        quran:page                     "311" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:3513  quran:ayah_text            "وَمِنۡ ءَايَٰتِهِۦٓ أَن يُرۡسِلَ ٱلرِّيَاحَ مُبَشِّرَٰتٖ وَلِيُذِيقَكُم مِّن رَّحۡمَتِهِۦ وَلِتَجۡرِيَ ٱلۡفُلۡكُ بِأَمۡرِهِۦ وَلِتَبۡتَغُواْ مِن فَضۡلِهِۦ وَلَعَلَّكُمۡ تَشۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "ومن ءايٰته ان يرسل الرياح مبشرٰت وليذيقكم من رحمته ولتجري الفلك بامره ولتبتغوا من فضله ولعلكم تشكرون" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3513" ;
        quran:page                     "409" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1275  quran:ayah_text            "قُلۡ إِن كَانَ ءَابَآؤُكُمۡ وَأَبۡنَآؤُكُمۡ وَإِخۡوَٰنُكُمۡ وَأَزۡوَٰجُكُمۡ وَعَشِيرَتُكُمۡ وَأَمۡوَٰلٌ ٱقۡتَرَفۡتُمُوهَا وَتِجَٰرَةٞ تَخۡشَوۡنَ كَسَادَهَا وَمَسَٰكِنُ تَرۡضَوۡنَهَآ أَحَبَّ إِلَيۡكُم مِّنَ ٱللَّهِ وَرَسُولِهِۦ وَجِهَادٖ فِي سَبِيلِهِۦ فَتَرَبَّصُواْ حَتَّىٰ يَأۡتِيَ ٱللَّهُ بِأَمۡرِهِۦۗ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلۡفَٰسِقِينَ" ;
        quran:ayah_text_no_diacratic   "قل ان كان ءاباؤكم وابناؤكم واخوٰنكم وازوٰجكم وعشيرتكم واموٰل اقترفتموها وتجٰرة تخشون كسادها ومسٰكن ترضونها احب اليكم من الله ورسوله وجهاد في سبيله فتربصوا حتىٰ ياتي الله بامره والله لا يهدي القوم الفٰسقين" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1275" ;
        quran:page                     "190" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:983  quran:ayah_text             "قَالَ فَبِمَآ أَغۡوَيۡتَنِي لَأَقۡعُدَنَّ لَهُمۡ صِرَٰطَكَ ٱلۡمُسۡتَقِيمَ" ;
        quran:ayah_text_no_diacratic   "قال فبما اغويتني لاقعدن لهم صرٰطك المستقيم" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "983" ;
        quran:page                     "152" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:4417  quran:ayah_text            "فَأَهۡلَكۡنَآ أَشَدَّ مِنۡهُم بَطۡشٗا وَمَضَىٰ مَثَلُ ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "فاهلكنا اشد منهم بطشا ومضىٰ مثل الاولين" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4417" ;
        quran:page                     "489" ;
        quran:surahname                "سُورَةُ الزُّخۡرُفِ" ;
        quran:surahnumber              "43" ;
        quran:surrahname_no_diacratic  "سورة الزخرف" .

quran:2179  quran:ayah_text            "مَّا لَهُم بِهِۦ مِنۡ عِلۡمٖ وَلَا لِأٓبَآئِهِمۡۚ كَبُرَتۡ كَلِمَةٗ تَخۡرُجُ مِنۡ أَفۡوَٰهِهِمۡۚ إِن يَقُولُونَ إِلَّا كَذِبٗا" ;
        quran:ayah_text_no_diacratic   "ما لهم به من علم ولا لابائهم كبرت كلمة تخرج من افوٰههم ان يقولون الا كذبا" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "15" ;
