        quran:hizb                     "49" ;
        quran:index                    "4556" ;
        quran:page                     "498" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:5700  quran:ayah_text            "لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ" ;
        quran:ayah_text_no_diacratic   "لا اقسم بيوم القيٰمة" ;
