        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1470  quran:ayah_text            "وَقَالَ مُوسَىٰ رَبَّنَآ إِنَّكَ ءَاتَيۡتَ فِرۡعَوۡنَ وَمَلَأَهُۥ زِينَةٗ وَأَمۡوَٰلٗا فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا رَبَّنَا لِيُضِلُّواْ عَن سَبِيلِكَۖ رَبَّنَا ٱطۡمِسۡ عَلَىٰٓ أَمۡوَٰلِهِمۡ وَٱشۡدُدۡ عَلَىٰ قُلُوبِهِمۡ فَلَا يُؤۡمِنُواْ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ" ;
        quran:ayah_text_no_diacratic   "وقال موسىٰ ربنا انك ءاتيت فرعون وملاه زينة واموٰلا في الحيوٰة الدنيا ربنا ليضلوا عن سبيلك ربنا اطمس علىٰ اموٰلهم واشدد علىٰ قلوبهم فلا يؤمنوا حتىٰ يروا العذاب الاليم" ;
        quran:ayahnumber               "88" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1470" ;
        quran:page                     "218" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4612  quran:ayah_text            "وَمِن قَبۡلِهِۦ كِتَٰبُ مُوسَىٰٓ إِمَامٗا وَرَحۡمَةٗۚ وَهَٰذَا كِتَٰبٞ مُّصَدِّقٞ لِّسَانًا عَرَبِيّٗا لِّيُنذِرَ ٱلَّذِينَ ظَلَمُواْ وَبُشۡرَىٰ لِلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "ومن قبله كتٰب موسىٰ اماما ورحمة وهٰذا كتٰب مصدق لسانا عربيا لينذر الذين ظلموا وبشرىٰ للمحسنين" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4612" ;
        quran:page                     "503" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2374  quran:ayah_text            "وَقَالُواْ ٱتَّخَذَ ٱلرَّحۡمَٰنُ وَلَدٗا" ;
        quran:ayah_text_no_diacratic   "وقالوا اتخذ الرحمٰن ولدا" ;
