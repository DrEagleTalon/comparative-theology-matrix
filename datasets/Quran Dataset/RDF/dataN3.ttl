quran:391  quran:ayah_text             "۞كُلُّ ٱلطَّعَامِ كَانَ حِلّٗا لِّبَنِيٓ إِسۡرَٰٓءِيلَ إِلَّا مَا حَرَّمَ إِسۡرَٰٓءِيلُ عَلَىٰ نَفۡسِهِۦ مِن قَبۡلِ أَن تُنَزَّلَ ٱلتَّوۡرَىٰةُۚ قُلۡ فَأۡتُواْ بِٱلتَّوۡرَىٰةِ فَٱتۡلُوهَآ إِن كُنتُمۡ صَٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "كل الطعام كان حلا لبني اسرٰءيل الا ما حرم اسرٰءيل علىٰ نفسه من قبل ان تنزل التورىٰة قل فاتوا بالتورىٰة فاتلوها ان كنتم صٰدقين" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "391" ;
        quran:page                     "62" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:1995  quran:ayah_text            "وَمَآ أَنزَلۡنَا عَلَيۡكَ ٱلۡكِتَٰبَ إِلَّا لِتُبَيِّنَ لَهُمُ ٱلَّذِي ٱخۡتَلَفُواْ فِيهِ وَهُدٗى وَرَحۡمَةٗ لِّقَوۡمٖ يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "وما انزلنا عليك الكتٰب الا لتبين لهم الذي اختلفوا فيه وهدى ورحمة لقوم يؤمنون" ;
        quran:ayahnumber               "64" ;
