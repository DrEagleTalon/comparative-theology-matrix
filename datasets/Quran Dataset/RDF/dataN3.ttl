quran:1318  quran:ayah_text            "ٱلۡمُنَٰفِقُونَ وَٱلۡمُنَٰفِقَٰتُ بَعۡضُهُم مِّنۢ بَعۡضٖۚ يَأۡمُرُونَ بِٱلۡمُنكَرِ وَيَنۡهَوۡنَ عَنِ ٱلۡمَعۡرُوفِ وَيَقۡبِضُونَ أَيۡدِيَهُمۡۚ نَسُواْ ٱللَّهَ فَنَسِيَهُمۡۚ إِنَّ ٱلۡمُنَٰفِقِينَ هُمُ ٱلۡفَٰسِقُونَ" ;
        quran:ayah_text_no_diacratic   "المنٰفقون والمنٰفقٰت بعضهم من بعض يامرون بالمنكر وينهون عن المعروف ويقبضون ايديهم نسوا الله فنسيهم ان المنٰفقين هم الفٰسقون" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1318" ;
