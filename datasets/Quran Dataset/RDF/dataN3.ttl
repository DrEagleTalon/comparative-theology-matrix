quran:3229  quran:ayah_text            "حَتَّىٰٓ إِذَآ أَتَوۡاْ عَلَىٰ وَادِ ٱلنَّمۡلِ قَالَتۡ نَمۡلَةٞ يَٰٓأَيُّهَا ٱلنَّمۡلُ ٱدۡخُلُواْ مَسَٰكِنَكُمۡ لَا يَحۡطِمَنَّكُمۡ سُلَيۡمَٰنُ وَجُنُودُهُۥ وَهُمۡ لَا يَشۡعُرُونَ" ;
        quran:ayah_text_no_diacratic   "حتىٰ اذا اتوا علىٰ واد النمل قالت نملة يٰايها النمل ادخلوا مسٰكنكم لا يحطمنكم سليمٰن وجنوده وهم لا يشعرون" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3229" ;
        quran:page                     "378" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:1231  quran:ayah_text            "ٱلَّذِينَ عَٰهَدتَّ مِنۡهُمۡ ثُمَّ يَنقُضُونَ عَهۡدَهُمۡ فِي كُلِّ مَرَّةٖ وَهُمۡ لَا يَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "الذين عٰهدت منهم ثم ينقضون عهدهم في كل مرة وهم لا يتقون" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "10" ;
