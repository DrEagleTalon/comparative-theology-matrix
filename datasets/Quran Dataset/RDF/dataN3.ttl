        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:977  quran:ayah_text             "وَلَقَدۡ مَكَّنَّٰكُمۡ فِي ٱلۡأَرۡضِ وَجَعَلۡنَا لَكُمۡ فِيهَا مَعَٰيِشَۗ قَلِيلٗا مَّا تَشۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد مكنٰكم في الارض وجعلنا لكم فيها معٰيش قليلا ما تشكرون" ;
