quran:551  quran:ayah_text             "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ أُوتُواْ نَصِيبٗا مِّنَ ٱلۡكِتَٰبِ يُؤۡمِنُونَ بِٱلۡجِبۡتِ وَٱلطَّٰغُوتِ وَيَقُولُونَ لِلَّذِينَ كَفَرُواْ هَٰٓؤُلَآءِ أَهۡدَىٰ مِنَ ٱلَّذِينَ ءَامَنُواْ سَبِيلًا" ;
        quran:ayah_text_no_diacratic   "الم تر الى الذين اوتوا نصيبا من الكتٰب يؤمنون بالجبت والطٰغوت ويقولون للذين كفروا هٰؤلاء اهدىٰ من الذين ءامنوا سبيلا" ;
        quran:ayahnumber               "51" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "551" ;
        quran:page                     "86" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

