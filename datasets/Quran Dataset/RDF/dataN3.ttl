quran:2698  quran:ayah_text            "ذَٰلِكَ بِأَنَّ ٱللَّهَ يُولِجُ ٱلَّيۡلَ فِي ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِي ٱلَّيۡلِ وَأَنَّ ٱللَّهَ سَمِيعُۢ بَصِيرٞ" ;
        quran:ayah_text_no_diacratic   "ذٰلك بان الله يولج اليل في النهار ويولج النهار في اليل وان الله سميع بصير" ;
        quran:ayahnumber               "61" ;
        quran:chapter                  "17" ;
        quran:hizb                     "34" ;
        quran:index                    "2698" ;
        quran:page                     "339" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:3842  quran:ayah_text            "وَلَوۡ نَشَآءُ لَمَسَخۡنَٰهُمۡ عَلَىٰ مَكَانَتِهِمۡ فَمَا ٱسۡتَطَٰعُواْ مُضِيّٗا وَلَا يَرۡجِعُونَ" ;
        quran:ayah_text_no_diacratic   "ولو نشاء لمسخنٰهم علىٰ مكانتهم فما استطٰعوا مضيا ولا يرجعون" ;
