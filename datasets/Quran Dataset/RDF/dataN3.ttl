        quran:surahname                "سُورَةُ التَّكۡوِيرِ" ;
        quran:surahnumber              "81" ;
        quran:surrahname_no_diacratic  "سورة التكوير" .

quran:4880  quran:ayah_text            "أَمۡ لَهُمۡ إِلَٰهٌ غَيۡرُ ٱللَّهِۚ سُبۡحَٰنَ ٱللَّهِ عَمَّا يُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "ام لهم الٰه غير الله سبحٰن الله عما يشركون" ;
        quran:ayahnumber               "43" ;
        quran:chapter                  "27" ;
        quran:hizb                     "52" ;
        quran:index                    "4880" ;
        quran:page                     "525" ;
        quran:surahname                "سُورَةُ الطُّورِ" ;
        quran:surahnumber              "52" ;
        quran:surrahname_no_diacratic  "سورة الطور" .

quran:255  quran:ayah_text             "مَّن ذَا ٱلَّذِي يُقۡرِضُ ٱللَّهَ قَرۡضًا حَسَنٗا فَيُضَٰعِفَهُۥ لَهُۥٓ أَضۡعَافٗا كَثِيرَةٗۚ وَٱللَّهُ يَقۡبِضُ وَيَبۡصُۜطُ وَإِلَيۡهِ تُرۡجَعُونَ" ;
        quran:ayah_text_no_diacratic   "من ذا الذي يقرض الله قرضا حسنا فيضٰعفه له اضعافا كثيرة والله يقبض ويبصط واليه ترجعون" ;
        quran:ayahnumber               "245" ;
        quran:chapter                  "2" ;
        quran:hizb                     "4" ;
        quran:index                    "255" ;
        quran:page                     "39" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:5784  quran:ayah_text            "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ" ;
        quran:ayah_text_no_diacratic   "واذا الجبال نسفت" ;
        quran:ayahnumber               "10" ;
