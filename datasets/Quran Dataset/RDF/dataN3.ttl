        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:496  quran:ayah_text             "لَٰكِنِ ٱلَّذِينَ ٱتَّقَوۡاْ رَبَّهُمۡ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا نُزُلٗا مِّنۡ عِندِ ٱللَّهِۗ وَمَا عِندَ ٱللَّهِ خَيۡرٞ لِّلۡأَبۡرَارِ" ;
        quran:ayah_text_no_diacratic   "لٰكن الذين اتقوا ربهم لهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها نزلا من عند الله وما عند الله خير للابرار" ;
        quran:ayahnumber               "198" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "496" ;
        quran:page                     "76" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:18  quran:ayah_text              "وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلۡيَوۡمِ ٱلۡأٓخِرِ وَمَا هُم بِمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "ومن الناس من يقول ءامنا بالله وباليوم الاخر وما هم بمؤمنين" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "1" ;
        quran:hizb                     "0" ;
        quran:index                    "18" ;
        quran:page                     "3" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:3958  quran:ayah_text            "فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ" ;
        quran:ayah_text_no_diacratic   "فارادوا به كيدا فجعلنٰهم الاسفلين" ;
        quran:ayahnumber               "98" ;
        quran:chapter                  "23" ;
