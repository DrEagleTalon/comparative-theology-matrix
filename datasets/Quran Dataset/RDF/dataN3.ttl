        quran:surahnumber              "37" ;
        quran:surrahname_no_diacratic  "سورة الصافات" .

quran:1941  quran:ayah_text            "هُوَ ٱلَّذِيٓ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗۖ لَّكُم مِّنۡهُ شَرَابٞ وَمِنۡهُ شَجَرٞ فِيهِ تُسِيمُونَ" ;
        quran:ayah_text_no_diacratic   "هو الذي انزل من السماء ماء لكم منه شراب ومنه شجر فيه تسيمون" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1941" ;
        quran:page                     "268" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2845  quran:ayah_text            "وَيَدۡرَؤُاْ عَنۡهَا ٱلۡعَذَابَ أَن تَشۡهَدَ أَرۡبَعَ شَهَٰدَٰتِۭ بِٱللَّهِ إِنَّهُۥ لَمِنَ ٱلۡكَٰذِبِينَ" ;
        quran:ayah_text_no_diacratic   "ويدرؤا عنها العذاب ان تشهد اربع شهٰدٰت بالله انه لمن الكٰذبين" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2845" ;
        quran:page                     "350" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:3749  quran:ayah_text            "وَلَا ٱلظِّلُّ وَلَا ٱلۡحَرُورُ" ;
        quran:ayah_text_no_diacratic   "ولا الظل ولا الحرور" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
