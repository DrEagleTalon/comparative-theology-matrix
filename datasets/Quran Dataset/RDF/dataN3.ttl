quran:749  quran:ayah_text             "وَحَسِبُوٓاْ أَلَّا تَكُونَ فِتۡنَةٞ فَعَمُواْ وَصَمُّواْ ثُمَّ تَابَ ٱللَّهُ عَلَيۡهِمۡ ثُمَّ عَمُواْ وَصَمُّواْ كَثِيرٞ مِّنۡهُمۡۚ وَٱللَّهُ بَصِيرُۢ بِمَا يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "وحسبوا الا تكون فتنة فعموا وصموا ثم تاب الله عليهم ثم عموا وصموا كثير منهم والله بصير بما يعملون" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "749" ;
        quran:page                     "120" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:559  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَطِيعُواْ ٱللَّهَ وَأَطِيعُواْ ٱلرَّسُولَ وَأُوْلِي ٱلۡأَمۡرِ مِنكُمۡۖ فَإِن تَنَٰزَعۡتُمۡ فِي شَيۡءٖ فَرُدُّوهُ إِلَى ٱللَّهِ وَٱلرَّسُولِ إِن كُنتُمۡ تُؤۡمِنُونَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۚ ذَٰلِكَ خَيۡرٞ وَأَحۡسَنُ تَأۡوِيلًا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اطيعوا الله واطيعوا الرسول واولي الامر منكم فان تنٰزعتم في شيء فردوه الى الله والرسول ان كنتم تؤمنون بالله واليوم الاخر ذٰلك خير واحسن تاويلا" ;
        quran:ayahnumber               "59" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "559" ;
        quran:page                     "87" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4994  quran:ayah_text            "كَذَّبُواْ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذۡنَٰهُمۡ أَخۡذَ عَزِيزٖ مُّقۡتَدِرٍ" ;
        quran:ayah_text_no_diacratic   "كذبوا بايٰتنا كلها فاخذنٰهم اخذ عزيز مقتدر" ;
