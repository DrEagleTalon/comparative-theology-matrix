        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:3358  quran:ayah_text            "ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ مِن قَبۡلِهِۦ هُم بِهِۦ يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "الذين ءاتينٰهم الكتٰب من قبله هم به يؤمنون" ;
