        quran:surahnumber              "63" ;
        quran:surrahname_no_diacratic  "سورة المنافقون" .

quran:3320  quran:ayah_text            "وَلَمَّا بَلَغَ أَشُدَّهُۥ وَٱسۡتَوَىٰٓ ءَاتَيۡنَٰهُ حُكۡمٗا وَعِلۡمٗاۚ وَكَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "ولما بلغ اشده واستوىٰ ءاتينٰه حكما وعلما وكذٰلك نجزي المحسنين" ;
