        quran:index                    "3216" ;
        quran:page                     "377" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:686  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُونُواْ قَوَّٰمِينَ لِلَّهِ شُهَدَآءَ بِٱلۡقِسۡطِۖ وَلَا يَجۡرِمَنَّكُمۡ شَنَـَٔانُ قَوۡمٍ عَلَىٰٓ أَلَّا تَعۡدِلُواْۚ ٱعۡدِلُواْ هُوَ أَقۡرَبُ لِلتَّقۡوَىٰۖ وَٱتَّقُواْ ٱللَّهَۚ إِنَّ ٱللَّهَ خَبِيرُۢ بِمَا تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا كونوا قوٰمين لله شهداء بالقسط ولا يجرمنكم شنان قوم علىٰ الا تعدلوا اعدلوا هو اقرب للتقوىٰ واتقوا الله ان الله خبير بما تعملون" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "686" ;
        quran:page                     "108" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2122  quran:ayah_text            "وَإِذۡ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ قَالَ ءَأَسۡجُدُ لِمَنۡ خَلَقۡتَ طِينٗا" ;
        quran:ayah_text_no_diacratic   "واذ قلنا للملٰئكة اسجدوا لادم فسجدوا الا ابليس قال ءاسجد لمن خلقت طينا" ;
