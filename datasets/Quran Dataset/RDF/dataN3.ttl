        quran:index                    "2525" ;
        quran:page                     "322" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:6260  quran:ayah_text            "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ" ;
        quran:ayah_text_no_diacratic   "الا ابتغاء وجه ربه الاعلىٰ" ;
        quran:ayahnumber               "20" ;
