        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2084  quran:ayah_text            "۞وَقَضَىٰ رَبُّكَ أَلَّا تَعۡبُدُوٓاْ إِلَّآ إِيَّاهُ وَبِٱلۡوَٰلِدَيۡنِ إِحۡسَٰنًاۚ إِمَّا يَبۡلُغَنَّ عِندَكَ ٱلۡكِبَرَ أَحَدُهُمَآ أَوۡ كِلَاهُمَا فَلَا تَقُل لَّهُمَآ أُفّٖ وَلَا تَنۡهَرۡهُمَا وَقُل لَّهُمَا قَوۡلٗا كَرِيمٗا" ;
        quran:ayah_text_no_diacratic   "وقضىٰ ربك الا تعبدوا الا اياه وبالوٰلدين احسٰنا اما يبلغن عندك الكبر احدهما او كلاهما فلا تقل لهما اف ولا تنهرهما وقل لهما قولا كريما" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2084" ;
        quran:page                     "284" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:5226  quran:ayah_text            "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ نُهُواْ عَنِ ٱلنَّجۡوَىٰ ثُمَّ يَعُودُونَ لِمَا نُهُواْ عَنۡهُ وَيَتَنَٰجَوۡنَ بِٱلۡإِثۡمِ وَٱلۡعُدۡوَٰنِ وَمَعۡصِيَتِ ٱلرَّسُولِۖ وَإِذَا جَآءُوكَ حَيَّوۡكَ بِمَا لَمۡ يُحَيِّكَ بِهِ ٱللَّهُ وَيَقُولُونَ فِيٓ أَنفُسِهِمۡ لَوۡلَا يُعَذِّبُنَا ٱللَّهُ بِمَا نَقُولُۚ حَسۡبُهُمۡ جَهَنَّمُ يَصۡلَوۡنَهَاۖ فَبِئۡسَ ٱلۡمَصِيرُ" ;
        quran:ayah_text_no_diacratic   "الم تر الى الذين نهوا عن النجوىٰ ثم يعودون لما نهوا عنه ويتنٰجون بالاثم والعدوٰن ومعصيت الرسول واذا جاءوك حيوك بما لم يحيك به الله ويقولون في انفسهم لولا يعذبنا الله بما نقول حسبهم جهنم يصلونها فبئس المصير" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5226" ;
        quran:page                     "543" ;
        quran:surahname                "سُورَةُ المُجَادلَةِ" ;
        quran:surahnumber              "58" ;
        quran:surrahname_no_diacratic  "سورة المجادلة" .

quran:4132  quran:ayah_text            "وَلَتَعۡلَمُنَّ نَبَأَهُۥ بَعۡدَ حِينِۭ" ;
        quran:ayah_text_no_diacratic   "ولتعلمن نباه بعد حين" ;
