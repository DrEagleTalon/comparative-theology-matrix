quran:64  quran:ayah_text              "وَإِذۡ قَالَ مُوسَىٰ لِقَوۡمِهِۦ يَٰقَوۡمِ إِنَّكُمۡ ظَلَمۡتُمۡ أَنفُسَكُم بِٱتِّخَاذِكُمُ ٱلۡعِجۡلَ فَتُوبُوٓاْ إِلَىٰ بَارِئِكُمۡ فَٱقۡتُلُوٓاْ أَنفُسَكُمۡ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ عِندَ بَارِئِكُمۡ فَتَابَ عَلَيۡكُمۡۚ إِنَّهُۥ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ" ;
        quran:ayah_text_no_diacratic   "واذ قال موسىٰ لقومه يٰقوم انكم ظلمتم انفسكم باتخاذكم العجل فتوبوا الىٰ بارئكم فاقتلوا انفسكم ذٰلكم خير لكم عند بارئكم فتاب عليكم انه هو التواب الرحيم" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "1" ;
        quran:hizb                     "0" ;
        quran:index                    "64" ;
        quran:page                     "8" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:903  quran:ayah_text             "لَّا تُدۡرِكُهُ ٱلۡأَبۡصَٰرُ وَهُوَ يُدۡرِكُ ٱلۡأَبۡصَٰرَۖ وَهُوَ ٱللَّطِيفُ ٱلۡخَبِيرُ" ;
        quran:ayah_text_no_diacratic   "لا تدركه الابصٰر وهو يدرك الابصٰر وهو اللطيف الخبير" ;
        quran:ayahnumber               "103" ;
        quran:chapter                  "7" ;
        quran:hizb                     "14" ;
        quran:index                    "903" ;
        quran:page                     "141" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1005  quran:ayah_text            "قَالَ ٱدۡخُلُواْ فِيٓ أُمَمٖ قَدۡ خَلَتۡ مِن قَبۡلِكُم مِّنَ ٱلۡجِنِّ وَٱلۡإِنسِ فِي ٱلنَّارِۖ كُلَّمَا دَخَلَتۡ أُمَّةٞ لَّعَنَتۡ أُخۡتَهَاۖ حَتَّىٰٓ إِذَا ٱدَّارَكُواْ فِيهَا جَمِيعٗا قَالَتۡ أُخۡرَىٰهُمۡ لِأُولَىٰهُمۡ رَبَّنَا هَٰٓؤُلَآءِ أَضَلُّونَا فَـَٔاتِهِمۡ عَذَابٗا ضِعۡفٗا مِّنَ ٱلنَّارِۖ قَالَ لِكُلّٖ ضِعۡفٞ وَلَٰكِن لَّا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "قال ادخلوا في امم قد خلت من قبلكم من الجن والانس في النار كلما دخلت امة لعنت اختها حتىٰ اذا اداركوا فيها جميعا قالت اخرىٰهم لاولىٰهم ربنا هٰؤلاء اضلونا فاتهم عذابا ضعفا من النار قال لكل ضعف ولٰكن لا تعلمون" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1005" ;
        quran:page                     "155" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:713  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ وَٱبۡتَغُوٓاْ إِلَيۡهِ ٱلۡوَسِيلَةَ وَجَٰهِدُواْ فِي سَبِيلِهِۦ لَعَلَّكُمۡ تُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اتقوا الله وابتغوا اليه الوسيلة وجٰهدوا في سبيله لعلكم تفلحون" ;
        quran:ayahnumber               "35" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "713" ;
        quran:page                     "113" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:523  quran:ayah_text             "حُرِّمَتۡ عَلَيۡكُمۡ أُمَّهَٰتُكُمۡ وَبَنَاتُكُمۡ وَأَخَوَٰتُكُمۡ وَعَمَّٰتُكُمۡ وَخَٰلَٰتُكُمۡ وَبَنَاتُ ٱلۡأَخِ وَبَنَاتُ ٱلۡأُخۡتِ وَأُمَّهَٰتُكُمُ ٱلَّٰتِيٓ أَرۡضَعۡنَكُمۡ وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَٰعَةِ وَأُمَّهَٰتُ نِسَآئِكُمۡ وَرَبَٰٓئِبُكُمُ ٱلَّٰتِي فِي حُجُورِكُم مِّن نِّسَآئِكُمُ ٱلَّٰتِي دَخَلۡتُم بِهِنَّ فَإِن لَّمۡ تَكُونُواْ دَخَلۡتُم بِهِنَّ فَلَا جُنَاحَ عَلَيۡكُمۡ وَحَلَٰٓئِلُ أَبۡنَآئِكُمُ ٱلَّذِينَ مِنۡ أَصۡلَٰبِكُمۡ وَأَن تَجۡمَعُواْ بَيۡنَ ٱلۡأُخۡتَيۡنِ إِلَّا مَا قَدۡ سَلَفَۗ إِنَّ ٱللَّهَ كَانَ غَفُورٗا رَّحِيمٗا" ;
        quran:ayah_text_no_diacratic   "حرمت عليكم امهٰتكم وبناتكم واخوٰتكم وعمٰتكم وخٰلٰتكم وبنات الاخ وبنات الاخت وامهٰتكم الٰتي ارضعنكم واخوٰتكم من الرضٰعة وامهٰت نسائكم وربٰئبكم الٰتي في حجوركم من نسائكم الٰتي دخلتم بهن فان لم تكونوا دخلتم بهن فلا جناح عليكم وحلٰئل ابنائكم الذين من اصلٰبكم وان تجمعوا بين الاختين الا ما قد سلف ان الله كان غفورا رحيما" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "4" ;
        quran:hizb                     "8" ;
        quran:index                    "523" ;
        quran:page                     "81" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:333  quran:ayah_text             "إِذۡ قَالَتِ ٱمۡرَأَتُ عِمۡرَٰنَ رَبِّ إِنِّي نَذَرۡتُ لَكَ مَا فِي بَطۡنِي مُحَرَّرٗا فَتَقَبَّلۡ مِنِّيٓۖ إِنَّكَ أَنتَ ٱلسَّمِيعُ ٱلۡعَلِيمُ" ;
        quran:ayah_text_no_diacratic   "اذ قالت امرات عمرٰن رب اني نذرت لك ما في بطني محررا فتقبل مني انك انت السميع العليم" ;
        quran:ayahnumber               "35" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "333" ;
        quran:page                     "54" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5862  quran:ayah_text            "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا" ;
        quran:ayah_text_no_diacratic   "جزاء من ربك عطاء حسابا" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "30" ;
        quran:hizb                     "58" ;
        quran:index                    "5862" ;
        quran:page                     "583" ;
        quran:surahname                "سُورَةُ النَّبَإِ" ;
        quran:surahnumber              "78" ;
        quran:surrahname_no_diacratic  "سورة النبا" .

quran:143  quran:ayah_text             "أَمۡ كُنتُمۡ شُهَدَآءَ إِذۡ حَضَرَ يَعۡقُوبَ ٱلۡمَوۡتُ إِذۡ قَالَ لِبَنِيهِ مَا تَعۡبُدُونَ مِنۢ بَعۡدِيۖ قَالُواْ نَعۡبُدُ إِلَٰهَكَ وَإِلَٰهَ ءَابَآئِكَ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ إِلَٰهٗا وَٰحِدٗا وَنَحۡنُ لَهُۥ مُسۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "ام كنتم شهداء اذ حضر يعقوب الموت اذ قال لبنيه ما تعبدون من بعدي قالوا نعبد الٰهك والٰه ءابائك ابرٰهم واسمٰعيل واسحٰق الٰها وٰحدا ونحن له مسلمون" ;
        quran:ayahnumber               "133" ;
        quran:chapter                  "1" ;
        quran:hizb                     "2" ;
        quran:index                    "143" ;
        quran:page                     "20" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1937  quran:ayah_text            "وَلَكُمۡ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسۡرَحُونَ" ;
        quran:ayah_text_no_diacratic   "ولكم فيها جمال حين تريحون وحين تسرحون" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1937" ;
        quran:page                     "267" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:5672  quran:ayah_text            "وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةٗۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةٗ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنٗا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ" ;
        quran:ayah_text_no_diacratic   "وما جعلنا اصحٰب النار الا ملٰئكة وما جعلنا عدتهم الا فتنة للذين كفروا ليستيقن الذين اوتوا الكتٰب ويزداد الذين ءامنوا ايمٰنا ولا يرتاب الذين اوتوا الكتٰب والمؤمنون وليقول الذين في قلوبهم مرض والكٰفرون ماذا اراد الله بهٰذا مثلا كذٰلك يضل الله من يشاء ويهدي من يشاء وما يعلم جنود ربك الا هو وما هي الا ذكرىٰ للبشر" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5672" ;
        quran:page                     "576" ;
        quran:surahname                "سُورَةُ المُدَّثِّرِ" ;
        quran:surahnumber              "74" ;
        quran:surrahname_no_diacratic  "سورة المدثر" .

quran:1747  quran:ayah_text            "قُلۡ مَن رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ قُلِ ٱللَّهُۚ قُلۡ أَفَٱتَّخَذۡتُم مِّن دُونِهِۦٓ أَوۡلِيَآءَ لَا يَمۡلِكُونَ لِأَنفُسِهِمۡ نَفۡعٗا وَلَا ضَرّٗاۚ قُلۡ هَلۡ يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ أَمۡ هَلۡ تَسۡتَوِي ٱلظُّلُمَٰتُ وَٱلنُّورُۗ أَمۡ جَعَلُواْ لِلَّهِ شُرَكَآءَ خَلَقُواْ كَخَلۡقِهِۦ فَتَشَٰبَهَ ٱلۡخَلۡقُ عَلَيۡهِمۡۚ قُلِ ٱللَّهُ خَٰلِقُ كُلِّ شَيۡءٖ وَهُوَ ٱلۡوَٰحِدُ ٱلۡقَهَّٰرُ" ;
        quran:ayah_text_no_diacratic   "قل من رب السمٰوٰت والارض قل الله قل افاتخذتم من دونه اولياء لا يملكون لانفسهم نفعا ولا ضرا قل هل يستوي الاعمىٰ والبصير ام هل تستوي الظلمٰت والنور ام جعلوا لله شركاء خلقوا كخلقه فتشٰبه الخلق عليهم قل الله خٰلق كل شيء وهو الوٰحد القهٰر" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1747" ;
        quran:page                     "251" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:5482  quran:ayah_text            "قُطُوفُهَا دَانِيَةٞ" ;
        quran:ayah_text_no_diacratic   "قطوفها دانية" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "29" ;
        quran:hizb                     "56" ;
        quran:index                    "5482" ;
