quran:100  quran:ayah_text             "بِئۡسَمَا ٱشۡتَرَوۡاْ بِهِۦٓ أَنفُسَهُمۡ أَن يَكۡفُرُواْ بِمَآ أَنزَلَ ٱللَّهُ بَغۡيًا أَن يُنَزِّلَ ٱللَّهُ مِن فَضۡلِهِۦ عَلَىٰ مَن يَشَآءُ مِنۡ عِبَادِهِۦۖ فَبَآءُو بِغَضَبٍ عَلَىٰ غَضَبٖۚ وَلِلۡكَٰفِرِينَ عَذَابٞ مُّهِينٞ" ;
        quran:ayah_text_no_diacratic   "بئسما اشتروا به انفسهم ان يكفروا بما انزل الله بغيا ان ينزل الله من فضله علىٰ من يشاء من عباده فباءو بغضب علىٰ غضب وللكٰفرين عذاب مهين" ;
        quran:ayahnumber               "90" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "100" ;
