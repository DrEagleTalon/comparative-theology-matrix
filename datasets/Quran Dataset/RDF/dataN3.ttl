quran:2237  quran:ayah_text            "قَالَ أَرَءَيۡتَ إِذۡ أَوَيۡنَآ إِلَى ٱلصَّخۡرَةِ فَإِنِّي نَسِيتُ ٱلۡحُوتَ وَمَآ أَنسَىٰنِيهُ إِلَّا ٱلشَّيۡطَٰنُ أَنۡ أَذۡكُرَهُۥۚ وَٱتَّخَذَ سَبِيلَهُۥ فِي ٱلۡبَحۡرِ عَجَبٗا" ;
        quran:ayah_text_no_diacratic   "قال ارءيت اذ اوينا الى الصخرة فاني نسيت الحوت وما انسىٰنيه الا الشيطٰن ان اذكره واتخذ سبيله في البحر عجبا" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "15" ;
        quran:hizb                     "30" ;
        quran:index                    "2237" ;
        quran:page                     "301" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1143  quran:ayah_text            "وَلَوۡ شِئۡنَا لَرَفَعۡنَٰهُ بِهَا وَلَٰكِنَّهُۥٓ أَخۡلَدَ إِلَى ٱلۡأَرۡضِ وَٱتَّبَعَ هَوَىٰهُۚ فَمَثَلُهُۥ كَمَثَلِ ٱلۡكَلۡبِ إِن تَحۡمِلۡ عَلَيۡهِ يَلۡهَثۡ أَوۡ تَتۡرُكۡهُ يَلۡهَثۚ ذَّٰلِكَ مَثَلُ ٱلۡقَوۡمِ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَاۚ فَٱقۡصُصِ ٱلۡقَصَصَ لَعَلَّهُمۡ يَتَفَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "ولو شئنا لرفعنٰه بها ولٰكنه اخلد الى الارض واتبع هوىٰه فمثله كمثل الكلب ان تحمل عليه يلهث او تتركه يلهث ذٰلك مثل القوم الذين كذبوا بايٰتنا فاقصص القصص لعلهم يتفكرون" ;
        quran:ayahnumber               "176" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1143" ;
        quran:page                     "173" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:851  quran:ayah_text             "وَأَنذِرۡ بِهِ ٱلَّذِينَ يَخَافُونَ أَن يُحۡشَرُوٓاْ إِلَىٰ رَبِّهِمۡ لَيۡسَ لَهُم مِّن دُونِهِۦ وَلِيّٞ وَلَا شَفِيعٞ لَّعَلَّهُمۡ يَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "وانذر به الذين يخافون ان يحشروا الىٰ ربهم ليس لهم من دونه ولي ولا شفيع لعلهم يتقون" ;
        quran:ayahnumber               "51" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "851" ;
        quran:page                     "133" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2047  quran:ayah_text            "وَلَا تَقُولُواْ لِمَا تَصِفُ أَلۡسِنَتُكُمُ ٱلۡكَذِبَ هَٰذَا حَلَٰلٞ وَهَٰذَا حَرَامٞ لِّتَفۡتَرُواْ عَلَى ٱللَّهِ ٱلۡكَذِبَۚ إِنَّ ٱلَّذِينَ يَفۡتَرُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ لَا يُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تقولوا لما تصف السنتكم الكذب هٰذا حلٰل وهٰذا حرام لتفتروا على الله الكذب ان الذين يفترون على الله الكذب لا يفلحون" ;
        quran:ayahnumber               "116" ;
        quran:chapter                  "14" ;
        quran:hizb                     "28" ;
        quran:index                    "2047" ;
        quran:page                     "280" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:661  quran:ayah_text             "وَأَخۡذِهِمُ ٱلرِّبَوٰاْ وَقَدۡ نُهُواْ عَنۡهُ وَأَكۡلِهِمۡ أَمۡوَٰلَ ٱلنَّاسِ بِٱلۡبَٰطِلِۚ وَأَعۡتَدۡنَا لِلۡكَٰفِرِينَ مِنۡهُمۡ عَذَابًا أَلِيمٗا" ;
        quran:ayah_text_no_diacratic   "واخذهم الربوٰا وقد نهوا عنه واكلهم اموٰل الناس بالبٰطل واعتدنا للكٰفرين منهم عذابا اليما" ;
        quran:ayahnumber               "161" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "661" ;
