        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1123  quran:ayah_text            "۞وَٱكۡتُبۡ لَنَا فِي هَٰذِهِ ٱلدُّنۡيَا حَسَنَةٗ وَفِي ٱلۡأٓخِرَةِ إِنَّا هُدۡنَآ إِلَيۡكَۚ قَالَ عَذَابِيٓ أُصِيبُ بِهِۦ مَنۡ أَشَآءُۖ وَرَحۡمَتِي وَسِعَتۡ كُلَّ شَيۡءٖۚ فَسَأَكۡتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤۡتُونَ ٱلزَّكَوٰةَ وَٱلَّذِينَ هُم بِـَٔايَٰتِنَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "واكتب لنا في هٰذه الدنيا حسنة وفي الاخرة انا هدنا اليك قال عذابي اصيب به من اشاء ورحمتي وسعت كل شيء فساكتبها للذين يتقون ويؤتون الزكوٰة والذين هم بايٰتنا يؤمنون" ;
        quran:ayahnumber               "156" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1123" ;
        quran:page                     "170" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:831  quran:ayah_text             "قَدۡ خَسِرَ ٱلَّذِينَ كَذَّبُواْ بِلِقَآءِ ٱللَّهِۖ حَتَّىٰٓ إِذَا جَآءَتۡهُمُ ٱلسَّاعَةُ بَغۡتَةٗ قَالُواْ يَٰحَسۡرَتَنَا عَلَىٰ مَا فَرَّطۡنَا فِيهَا وَهُمۡ يَحۡمِلُونَ أَوۡزَارَهُمۡ عَلَىٰ ظُهُورِهِمۡۚ أَلَا سَآءَ مَا يَزِرُونَ" ;
        quran:ayah_text_no_diacratic   "قد خسر الذين كذبوا بلقاء الله حتىٰ اذا جاءتهم الساعة بغتة قالوا يٰحسرتنا علىٰ ما فرطنا فيها وهم يحملون اوزارهم علىٰ ظهورهم الا ساء ما يزرون" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "831" ;
        quran:page                     "131" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2027  quran:ayah_text            "مَا عِندَكُمۡ يَنفَدُ وَمَا عِندَ ٱللَّهِ بَاقٖۗ وَلَنَجۡزِيَنَّ ٱلَّذِينَ صَبَرُوٓاْ أَجۡرَهُم بِأَحۡسَنِ مَا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ما عندكم ينفد وما عند الله باق ولنجزين الذين صبروا اجرهم باحسن ما كانوا يعملون" ;
        quran:ayahnumber               "96" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2027" ;
        quran:page                     "278" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:641  quran:ayah_text             "ٱلَّذِينَ يَتَرَبَّصُونَ بِكُمۡ فَإِن كَانَ لَكُمۡ فَتۡحٞ مِّنَ ٱللَّهِ قَالُوٓاْ أَلَمۡ نَكُن مَّعَكُمۡ وَإِن كَانَ لِلۡكَٰفِرِينَ نَصِيبٞ قَالُوٓاْ أَلَمۡ نَسۡتَحۡوِذۡ عَلَيۡكُمۡ وَنَمۡنَعۡكُم مِّنَ ٱلۡمُؤۡمِنِينَۚ فَٱللَّهُ يَحۡكُمُ بَيۡنَكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِۚ وَلَن يَجۡعَلَ ٱللَّهُ لِلۡكَٰفِرِينَ عَلَى ٱلۡمُؤۡمِنِينَ سَبِيلًا" ;
        quran:ayah_text_no_diacratic   "الذين يتربصون بكم فان كان لكم فتح من الله قالوا الم نكن معكم وان كان للكٰفرين نصيب قالوا الم نستحوذ عليكم ونمنعكم من المؤمنين فالله يحكم بينكم يوم القيٰمة ولن يجعل الله للكٰفرين على المؤمنين سبيلا" ;
        quran:ayahnumber               "141" ;
        quran:chapter                  "5" ;
        quran:hizb                     "10" ;
        quran:index                    "641" ;
        quran:page                     "101" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:451  quran:ayah_text             "۞إِذۡ تُصۡعِدُونَ وَلَا تَلۡوُۥنَ عَلَىٰٓ أَحَدٖ وَٱلرَّسُولُ يَدۡعُوكُمۡ فِيٓ أُخۡرَىٰكُمۡ فَأَثَٰبَكُمۡ غَمَّۢا بِغَمّٖ لِّكَيۡلَا تَحۡزَنُواْ عَلَىٰ مَا فَاتَكُمۡ وَلَا مَآ أَصَٰبَكُمۡۗ وَٱللَّهُ خَبِيرُۢ بِمَا تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "اذ تصعدون ولا تلون علىٰ احد والرسول يدعوكم في اخرىٰكم فاثٰبكم غما بغم لكيلا تحزنوا علىٰ ما فاتكم ولا ما اصٰبكم والله خبير بما تعملون" ;
        quran:ayahnumber               "153" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "451" ;
        quran:page                     "69" ;
