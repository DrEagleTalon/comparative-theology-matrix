        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2159  quran:ayah_text            "ذَٰلِكَ جَزَآؤُهُم بِأَنَّهُمۡ كَفَرُواْ بِـَٔايَٰتِنَا وَقَالُوٓاْ أَءِذَا كُنَّا عِظَٰمٗا وَرُفَٰتًا أَءِنَّا لَمَبۡعُوثُونَ خَلۡقٗا جَدِيدًا" ;
        quran:ayah_text_no_diacratic   "ذٰلك جزاؤهم بانهم كفروا بايٰتنا وقالوا اءذا كنا عظٰما ورفٰتا اءنا لمبعوثون خلقا جديدا" ;
        quran:ayahnumber               "98" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2159" ;
        quran:page                     "292" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3303  quran:ayah_text            "وَأَنۡ أَتۡلُوَاْ ٱلۡقُرۡءَانَۖ فَمَنِ ٱهۡتَدَىٰ فَإِنَّمَا يَهۡتَدِي لِنَفۡسِهِۦۖ وَمَن ضَلَّ فَقُلۡ إِنَّمَآ أَنَا۠ مِنَ ٱلۡمُنذِرِينَ" ;
        quran:ayah_text_no_diacratic   "وان اتلوا القرءان فمن اهتدىٰ فانما يهتدي لنفسه ومن ضل فقل انما انا من المنذرين" ;
        quran:ayahnumber               "92" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3303" ;
        quran:page                     "385" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:1065  quran:ayah_text            "أَوَأَمِنَ أَهۡلُ ٱلۡقُرَىٰٓ أَن يَأۡتِيَهُم بَأۡسُنَا ضُحٗى وَهُمۡ يَلۡعَبُونَ" ;
        quran:ayah_text_no_diacratic   "اوامن اهل القرىٰ ان ياتيهم باسنا ضحى وهم يلعبون" ;
