quran:790  quran:ayah_text             "إِذۡ قَالَ ٱلۡحَوَارِيُّونَ يَٰعِيسَى ٱبۡنَ مَرۡيَمَ هَلۡ يَسۡتَطِيعُ رَبُّكَ أَن يُنَزِّلَ عَلَيۡنَا مَآئِدَةٗ مِّنَ ٱلسَّمَآءِۖ قَالَ ٱتَّقُواْ ٱللَّهَ إِن كُنتُم مُّؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "اذ قال الحواريون يٰعيسى ابن مريم هل يستطيع ربك ان ينزل علينا مائدة من السماء قال اتقوا الله ان كنتم مؤمنين" ;
        quran:ayahnumber               "112" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "790" ;
        quran:page                     "126" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:4224  quran:ayah_text            "هُوَ ٱلَّذِي يُرِيكُمۡ ءَايَٰتِهِۦ وَيُنَزِّلُ لَكُم مِّنَ ٱلسَّمَآءِ رِزۡقٗاۚ وَمَا يَتَذَكَّرُ إِلَّا مَن يُنِيبُ" ;
        quran:ayah_text_no_diacratic   "هو الذي يريكم ءايٰته وينزل لكم من السماء رزقا وما يتذكر الا من ينيب" ;
