        quran:surahname                "سُورَةُ الحِجۡرِ" ;
        quran:surahnumber              "15" ;
        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:3926  quran:ayah_text            "فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ" ;
        quran:ayah_text_no_diacratic   "فانهم لاكلون منها فمالون منها البطون" ;
