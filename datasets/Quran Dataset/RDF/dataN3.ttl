        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:3612  quran:ayah_text            "وَلَقَدۡ كَانُواْ عَٰهَدُواْ ٱللَّهَ مِن قَبۡلُ لَا يُوَلُّونَ ٱلۡأَدۡبَٰرَۚ وَكَانَ عَهۡدُ ٱللَّهِ مَسۡـُٔولٗا" ;
        quran:ayah_text_no_diacratic   "ولقد كانوا عٰهدوا الله من قبل لا يولون الادبٰر وكان عهد الله مسولا" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3612" ;
        quran:page                     "419" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1374  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ قَٰتِلُواْ ٱلَّذِينَ يَلُونَكُم مِّنَ ٱلۡكُفَّارِ وَلۡيَجِدُواْ فِيكُمۡ غِلۡظَةٗۚ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَعَ ٱلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا قٰتلوا الذين يلونكم من الكفار وليجدوا فيكم غلظة واعلموا ان الله مع المتقين" ;
        quran:ayahnumber               "123" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1374" ;
        quran:page                     "207" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4516  quran:ayah_text            "يَوۡمَ نَبۡطِشُ ٱلۡبَطۡشَةَ ٱلۡكُبۡرَىٰٓ إِنَّا مُنتَقِمُونَ" ;
        quran:ayah_text_no_diacratic   "يوم نبطش البطشة الكبرىٰ انا منتقمون" ;
