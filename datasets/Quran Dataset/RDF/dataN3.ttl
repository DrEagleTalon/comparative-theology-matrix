quran:4639  quran:ayah_text            "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَءَامَنُواْ بِمَا نُزِّلَ عَلَىٰ مُحَمَّدٖ وَهُوَ ٱلۡحَقُّ مِن رَّبِّهِمۡ كَفَّرَ عَنۡهُمۡ سَيِّـَٔاتِهِمۡ وَأَصۡلَحَ بَالَهُمۡ" ;
        quran:ayah_text_no_diacratic   "والذين ءامنوا وعملوا الصٰلحٰت وءامنوا بما نزل علىٰ محمد وهو الحق من ربهم كفر عنهم سياتهم واصلح بالهم" ;
        quran:ayahnumber               "2" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4639" ;
        quran:page                     "507" ;
        quran:surahname                "سُورَةُ مُحَمَّدٍ" ;
        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:2641  quran:ayah_text            "كُتِبَ عَلَيۡهِ أَنَّهُۥ مَن تَوَلَّاهُ فَأَنَّهُۥ يُضِلُّهُۥ وَيَهۡدِيهِ إِلَىٰ عَذَابِ ٱلسَّعِيرِ" ;
        quran:ayah_text_no_diacratic   "كتب عليه انه من تولاه فانه يضله ويهديه الىٰ عذاب السعير" ;
        quran:ayahnumber               "4" ;
