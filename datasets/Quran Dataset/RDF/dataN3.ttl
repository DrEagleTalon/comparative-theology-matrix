        quran:surrahname_no_diacratic  "سورة السجدة" .

quran:1580  quran:ayah_text            "قَالُواْ يَٰشُعَيۡبُ أَصَلَوٰتُكَ تَأۡمُرُكَ أَن نَّتۡرُكَ مَا يَعۡبُدُ ءَابَآؤُنَآ أَوۡ أَن نَّفۡعَلَ فِيٓ أَمۡوَٰلِنَا مَا نَشَٰٓؤُاْۖ إِنَّكَ لَأَنتَ ٱلۡحَلِيمُ ٱلرَّشِيدُ" ;
        quran:ayah_text_no_diacratic   "قالوا يٰشعيب اصلوٰتك تامرك ان نترك ما يعبد ءاباؤنا او ان نفعل في اموٰلنا ما نشٰؤا انك لانت الحليم الرشيد" ;
        quran:ayahnumber               "87" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1580" ;
        quran:page                     "231" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4722  quran:ayah_text            "۞قَالَتِ ٱلۡأَعۡرَابُ ءَامَنَّاۖ قُل لَّمۡ تُؤۡمِنُواْ وَلَٰكِن قُولُوٓاْ أَسۡلَمۡنَا وَلَمَّا يَدۡخُلِ ٱلۡإِيمَٰنُ فِي قُلُوبِكُمۡۖ وَإِن تُطِيعُواْ ٱللَّهَ وَرَسُولَهُۥ لَا يَلِتۡكُم مِّنۡ أَعۡمَٰلِكُمۡ شَيۡـًٔاۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ" ;
        quran:ayah_text_no_diacratic   "قالت الاعراب ءامنا قل لم تؤمنوا ولٰكن قولوا اسلمنا ولما يدخل الايمٰن في قلوبكم وان تطيعوا الله ورسوله لا يلتكم من اعمٰلكم شيا ان الله غفور رحيم" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4722" ;
        quran:page                     "517" ;
        quran:surahname                "سُورَةُ الحُجُرَاتِ" ;
        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:2484  quran:ayah_text            "إِنَّمَآ إِلَٰهُكُمُ ٱللَّهُ ٱلَّذِي لَآ إِلَٰهَ إِلَّا هُوَۚ وَسِعَ كُلَّ شَيۡءٍ عِلۡمٗا" ;
        quran:ayah_text_no_diacratic   "انما الٰهكم الله الذي لا الٰه الا هو وسع كل شيء علما" ;
