quran:2863  quran:ayah_text            "ٱلۡخَبِيثَٰتُ لِلۡخَبِيثِينَ وَٱلۡخَبِيثُونَ لِلۡخَبِيثَٰتِۖ وَٱلطَّيِّبَٰتُ لِلطَّيِّبِينَ وَٱلطَّيِّبُونَ لِلطَّيِّبَٰتِۚ أُوْلَٰٓئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَۖ لَهُم مَّغۡفِرَةٞ وَرِزۡقٞ كَرِيمٞ" ;
        quran:ayah_text_no_diacratic   "الخبيثٰت للخبيثين والخبيثون للخبيثٰت والطيبٰت للطيبين والطيبون للطيبٰت اولٰئك مبرءون مما يقولون لهم مغفرة ورزق كريم" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2863" ;
        quran:page                     "352" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:3767  quran:ayah_text            "هُوَ ٱلَّذِي جَعَلَكُمۡ خَلَٰٓئِفَ فِي ٱلۡأَرۡضِۚ فَمَن كَفَرَ فَعَلَيۡهِ كُفۡرُهُۥۖ وَلَا يَزِيدُ ٱلۡكَٰفِرِينَ كُفۡرُهُمۡ عِندَ رَبِّهِمۡ إِلَّا مَقۡتٗاۖ وَلَا يَزِيدُ ٱلۡكَٰفِرِينَ كُفۡرُهُمۡ إِلَّا خَسَارٗا" ;
        quran:ayah_text_no_diacratic   "هو الذي جعلكم خلٰئف في الارض فمن كفر فعليه كفره ولا يزيد الكٰفرين كفرهم عند ربهم الا مقتا ولا يزيد الكٰفرين كفرهم الا خسارا" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3767" ;
        quran:page                     "439" ;
        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:4911  quran:ayah_text            "إِنۡ هِيَ إِلَّآ أَسۡمَآءٞ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَآءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىٰٓ" ;
        quran:ayah_text_no_diacratic   "ان هي الا اسماء سميتموها انتم وءاباؤكم ما انزل الله بها من سلطٰن ان يتبعون الا الظن وما تهوى الانفس ولقد جاءهم من ربهم الهدىٰ" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "27" ;
        quran:hizb                     "52" ;
        quran:index                    "4911" ;
        quran:page                     "526" ;
        quran:surahname                "سُورَةُ النَّجۡمِ" ;
        quran:surahnumber              "53" ;
        quran:surrahname_no_diacratic  "سورة النجم" .

quran:2673  quran:ayah_text            "وَٱلۡبُدۡنَ جَعَلۡنَٰهَا لَكُم مِّن شَعَٰٓئِرِ ٱللَّهِ لَكُمۡ فِيهَا خَيۡرٞۖ فَٱذۡكُرُواْ ٱسۡمَ ٱللَّهِ عَلَيۡهَا صَوَآفَّۖ فَإِذَا وَجَبَتۡ جُنُوبُهَا فَكُلُواْ مِنۡهَا وَأَطۡعِمُواْ ٱلۡقَانِعَ وَٱلۡمُعۡتَرَّۚ كَذَٰلِكَ سَخَّرۡنَٰهَا لَكُمۡ لَعَلَّكُمۡ تَشۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "والبدن جعلنٰها لكم من شعٰئر الله لكم فيها خير فاذكروا اسم الله عليها صواف فاذا وجبت جنوبها فكلوا منها واطعموا القانع والمعتر كذٰلك سخرنٰها لكم لعلكم تشكرون" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2673" ;
        quran:page                     "336" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:5815  quran:ayah_text            "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ" ;
        quran:ayah_text_no_diacratic   "ان المتقين في ظلٰل وعيون" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "29" ;
        quran:hizb                     "58" ;
        quran:index                    "5815" ;
        quran:page                     "581" ;
        quran:surahname                "سُورَةُ المُرۡسَلَاتِ" ;
        quran:surahnumber              "77" ;
        quran:surrahname_no_diacratic  "سورة المرسلات" .

quran:3577  quran:ayah_text            "وَلَوۡ تَرَىٰٓ إِذِ ٱلۡمُجۡرِمُونَ نَاكِسُواْ رُءُوسِهِمۡ عِندَ رَبِّهِمۡ رَبَّنَآ أَبۡصَرۡنَا وَسَمِعۡنَا فَٱرۡجِعۡنَا نَعۡمَلۡ صَٰلِحًا إِنَّا مُوقِنُونَ" ;
        quran:ayah_text_no_diacratic   "ولو ترىٰ اذ المجرمون ناكسوا رءوسهم عند ربهم ربنا ابصرنا وسمعنا فارجعنا نعمل صٰلحا انا موقنون" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3577" ;
