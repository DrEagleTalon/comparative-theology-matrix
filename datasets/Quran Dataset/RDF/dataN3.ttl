quran:73  quran:ayah_text              "وَإِذۡ أَخَذۡنَا مِيثَٰقَكُمۡ وَرَفَعۡنَا فَوۡقَكُمُ ٱلطُّورَ خُذُواْ مَآ ءَاتَيۡنَٰكُم بِقُوَّةٖ وَٱذۡكُرُواْ مَا فِيهِ لَعَلَّكُمۡ تَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "واذ اخذنا ميثٰقكم ورفعنا فوقكم الطور خذوا ما ءاتينٰكم بقوة واذكروا ما فيه لعلكم تتقون" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "73" ;
        quran:page                     "10" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1204  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِن تَتَّقُواْ ٱللَّهَ يَجۡعَل لَّكُمۡ فُرۡقَانٗا وَيُكَفِّرۡ عَنكُمۡ سَيِّـَٔاتِكُمۡ وَيَغۡفِرۡ لَكُمۡۗ وَٱللَّهُ ذُو ٱلۡفَضۡلِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا ان تتقوا الله يجعل لكم فرقانا ويكفر عنكم سياتكم ويغفر لكم والله ذو الفضل العظيم" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1204" ;
        quran:page                     "180" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:912  quran:ayah_text             "وَكَذَٰلِكَ جَعَلۡنَا لِكُلِّ نَبِيٍّ عَدُوّٗا شَيَٰطِينَ ٱلۡإِنسِ وَٱلۡجِنِّ يُوحِي بَعۡضُهُمۡ إِلَىٰ بَعۡضٖ زُخۡرُفَ ٱلۡقَوۡلِ غُرُورٗاۚ وَلَوۡ شَآءَ رَبُّكَ مَا فَعَلُوهُۖ فَذَرۡهُمۡ وَمَا يَفۡتَرُونَ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك جعلنا لكل نبي عدوا شيٰطين الانس والجن يوحي بعضهم الىٰ بعض زخرف القول غرورا ولو شاء ربك ما فعلوه فذرهم وما يفترون" ;
        quran:ayahnumber               "112" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "912" ;
        quran:page                     "142" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2108  quran:ayah_text            "نَّحۡنُ أَعۡلَمُ بِمَا يَسۡتَمِعُونَ بِهِۦٓ إِذۡ يَسۡتَمِعُونَ إِلَيۡكَ وَإِذۡ هُمۡ نَجۡوَىٰٓ إِذۡ يَقُولُ ٱلظَّٰلِمُونَ إِن تَتَّبِعُونَ إِلَّا رَجُلٗا مَّسۡحُورًا" ;
        quran:ayah_text_no_diacratic   "نحن اعلم بما يستمعون به اذ يستمعون اليك واذ هم نجوىٰ اذ يقول الظٰلمون ان تتبعون الا رجلا مسحورا" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2108" ;
        quran:page                     "286" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1014  quran:ayah_text            "۞وَإِذَا صُرِفَتۡ أَبۡصَٰرُهُمۡ تِلۡقَآءَ أَصۡحَٰبِ ٱلنَّارِ قَالُواْ رَبَّنَا لَا تَجۡعَلۡنَا مَعَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "واذا صرفت ابصٰرهم تلقاء اصحٰب النار قالوا ربنا لا تجعلنا مع القوم الظٰلمين" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1014" ;
        quran:page                     "156" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:722  quran:ayah_text             "إِنَّآ أَنزَلۡنَا ٱلتَّوۡرَىٰةَ فِيهَا هُدٗى وَنُورٞۚ يَحۡكُمُ بِهَا ٱلنَّبِيُّونَ ٱلَّذِينَ أَسۡلَمُواْ لِلَّذِينَ هَادُواْ وَٱلرَّبَّٰنِيُّونَ وَٱلۡأَحۡبَارُ بِمَا ٱسۡتُحۡفِظُواْ مِن كِتَٰبِ ٱللَّهِ وَكَانُواْ عَلَيۡهِ شُهَدَآءَۚ فَلَا تَخۡشَوُاْ ٱلنَّاسَ وَٱخۡشَوۡنِ وَلَا تَشۡتَرُواْ بِـَٔايَٰتِي ثَمَنٗا قَلِيلٗاۚ وَمَن لَّمۡ يَحۡكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُوْلَٰٓئِكَ هُمُ ٱلۡكَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "انا انزلنا التورىٰة فيها هدى ونور يحكم بها النبيون الذين اسلموا للذين هادوا والربٰنيون والاحبار بما استحفظوا من كتٰب الله وكانوا عليه شهداء فلا تخشوا الناس واخشون ولا تشتروا بايٰتي ثمنا قليلا ومن لم يحكم بما انزل الله فاولٰئك هم الكٰفرون" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "722" ;
        quran:page                     "115" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:532  quran:ayah_text             "وَلَا تَتَمَنَّوۡاْ مَا فَضَّلَ ٱللَّهُ بِهِۦ بَعۡضَكُمۡ عَلَىٰ بَعۡضٖۚ لِّلرِّجَالِ نَصِيبٞ مِّمَّا ٱكۡتَسَبُواْۖ وَلِلنِّسَآءِ نَصِيبٞ مِّمَّا ٱكۡتَسَبۡنَۚ وَسۡـَٔلُواْ ٱللَّهَ مِن فَضۡلِهِۦٓۚ إِنَّ ٱللَّهَ كَانَ بِكُلِّ شَيۡءٍ عَلِيمٗا" ;
        quran:ayah_text_no_diacratic   "ولا تتمنوا ما فضل الله به بعضكم علىٰ بعض للرجال نصيب مما اكتسبوا وللنساء نصيب مما اكتسبن وسلوا الله من فضله ان الله كان بكل شيء عليما" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "532" ;
        quran:page                     "83" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:342  quran:ayah_text             "ذَٰلِكَ مِنۡ أَنۢبَآءِ ٱلۡغَيۡبِ نُوحِيهِ إِلَيۡكَۚ وَمَا كُنتَ لَدَيۡهِمۡ إِذۡ يُلۡقُونَ أَقۡلَٰمَهُمۡ أَيُّهُمۡ يَكۡفُلُ مَرۡيَمَ وَمَا كُنتَ لَدَيۡهِمۡ إِذۡ يَخۡتَصِمُونَ" ;
        quran:ayah_text_no_diacratic   "ذٰلك من انباء الغيب نوحيه اليك وما كنت لديهم اذ يلقون اقلٰمهم ايهم يكفل مريم وما كنت لديهم اذ يختصمون" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "342" ;
        quran:page                     "55" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5871  quran:ayah_text            "وَٱلسَّٰبِحَٰتِ سَبۡحٗا" ;
