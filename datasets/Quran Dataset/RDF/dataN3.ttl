        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:302  quran:ayah_text             "مِن قَبۡلُ هُدٗى لِّلنَّاسِ وَأَنزَلَ ٱلۡفُرۡقَانَۗ إِنَّ ٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِ ٱللَّهِ لَهُمۡ عَذَابٞ شَدِيدٞۗ وَٱللَّهُ عَزِيزٞ ذُو ٱنتِقَامٍ" ;
        quran:ayah_text_no_diacratic   "من قبل هدى للناس وانزل الفرقان ان الذين كفروا بايٰت الله لهم عذاب شديد والله عزيز ذو انتقام" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "302" ;
