quran:3709  quran:ayah_text            "وَمَآ أَمۡوَٰلُكُمۡ وَلَآ أَوۡلَٰدُكُم بِٱلَّتِي تُقَرِّبُكُمۡ عِندَنَا زُلۡفَىٰٓ إِلَّا مَنۡ ءَامَنَ وَعَمِلَ صَٰلِحٗا فَأُوْلَٰٓئِكَ لَهُمۡ جَزَآءُ ٱلضِّعۡفِ بِمَا عَمِلُواْ وَهُمۡ فِي ٱلۡغُرُفَٰتِ ءَامِنُونَ" ;
        quran:ayah_text_no_diacratic   "وما اموٰلكم ولا اولٰدكم بالتي تقربكم عندنا زلفىٰ الا من ءامن وعمل صٰلحا فاولٰئك لهم جزاء الضعف بما عملوا وهم في الغرفٰت ءامنون" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3709" ;
        quran:page                     "432" ;
        quran:surahname                "سُورَةُ سَبَإٍ" ;
        quran:surahnumber              "34" ;
        quran:surrahname_no_diacratic  "سورة سبا" .

quran:2615  quran:ayah_text            "إِنَّ هَٰذِهِۦٓ أُمَّتُكُمۡ أُمَّةٗ وَٰحِدَةٗ وَأَنَا۠ رَبُّكُمۡ فَٱعۡبُدُونِ" ;
        quran:ayah_text_no_diacratic   "ان هٰذه امتكم امة وٰحدة وانا ربكم فاعبدون" ;
