quran:152  quran:ayah_text             "۞سَيَقُولُ ٱلسُّفَهَآءُ مِنَ ٱلنَّاسِ مَا وَلَّىٰهُمۡ عَن قِبۡلَتِهِمُ ٱلَّتِي كَانُواْ عَلَيۡهَاۚ قُل لِّلَّهِ ٱلۡمَشۡرِقُ وَٱلۡمَغۡرِبُۚ يَهۡدِي مَن يَشَآءُ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ" ;
        quran:ayah_text_no_diacratic   "سيقول السفهاء من الناس ما ولىٰهم عن قبلتهم التي كانوا عليها قل لله المشرق والمغرب يهدي من يشاء الىٰ صرٰط مستقيم" ;
        quran:ayahnumber               "142" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "152" ;
        quran:page                     "22" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1946  quran:ayah_text            "وَأَلۡقَىٰ فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِكُمۡ وَأَنۡهَٰرٗا وَسُبُلٗا لَّعَلَّكُمۡ تَهۡتَدُونَ" ;
        quran:ayah_text_no_diacratic   "والقىٰ في الارض روٰسي ان تميد بكم وانهٰرا وسبلا لعلكم تهتدون" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1946" ;
        quran:page                     "269" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:5681  quran:ayah_text            "فِي جَنَّٰتٖ يَتَسَآءَلُونَ" ;
