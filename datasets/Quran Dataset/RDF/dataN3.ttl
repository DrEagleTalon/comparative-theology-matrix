quran:679  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَوۡفُواْ بِٱلۡعُقُودِۚ أُحِلَّتۡ لَكُم بَهِيمَةُ ٱلۡأَنۡعَٰمِ إِلَّا مَا يُتۡلَىٰ عَلَيۡكُمۡ غَيۡرَ مُحِلِّي ٱلصَّيۡدِ وَأَنتُمۡ حُرُمٌۗ إِنَّ ٱللَّهَ يَحۡكُمُ مَا يُرِيدُ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اوفوا بالعقود احلت لكم بهيمة الانعٰم الا ما يتلىٰ عليكم غير محلي الصيد وانتم حرم ان الله يحكم ما يريد" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "679" ;
        quran:page                     "106" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2115  quran:ayah_text            "رَّبُّكُمۡ أَعۡلَمُ بِكُمۡۖ إِن يَشَأۡ يَرۡحَمۡكُمۡ أَوۡ إِن يَشَأۡ يُعَذِّبۡكُمۡۚ وَمَآ أَرۡسَلۡنَٰكَ عَلَيۡهِمۡ وَكِيلٗا" ;
        quran:ayah_text_no_diacratic   "ربكم اعلم بكم ان يشا يرحمكم او ان يشا يعذبكم وما ارسلنٰك عليهم وكيلا" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2115" ;
        quran:page                     "287" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

