        quran:surrahname_no_diacratic  "سورة سبا" .

quran:1475  quran:ayah_text            "وَلَقَدۡ بَوَّأۡنَا بَنِيٓ إِسۡرَٰٓءِيلَ مُبَوَّأَ صِدۡقٖ وَرَزَقۡنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ فَمَا ٱخۡتَلَفُواْ حَتَّىٰ جَآءَهُمُ ٱلۡعِلۡمُۚ إِنَّ رَبَّكَ يَقۡضِي بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخۡتَلِفُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد بوانا بني اسرٰءيل مبوا صدق ورزقنٰهم من الطيبٰت فما اختلفوا حتىٰ جاءهم العلم ان ربك يقضي بينهم يوم القيٰمة فيما كانوا فيه يختلفون" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "11" ;
        quran:hizb                     "22" ;
        quran:index                    "1475" ;
        quran:page                     "219" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4617  quran:ayah_text            "وَٱلَّذِي قَالَ لِوَٰلِدَيۡهِ أُفّٖ لَّكُمَآ أَتَعِدَانِنِيٓ أَنۡ أُخۡرَجَ وَقَدۡ خَلَتِ ٱلۡقُرُونُ مِن قَبۡلِي وَهُمَا يَسۡتَغِيثَانِ ٱللَّهَ وَيۡلَكَ ءَامِنۡ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞ فَيَقُولُ مَا هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "والذي قال لوٰلديه اف لكما اتعدانني ان اخرج وقد خلت القرون من قبلي وهما يستغيثان الله ويلك ءامن ان وعد الله حق فيقول ما هٰذا الا اسٰطير الاولين" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4617" ;
        quran:page                     "504" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2379  quran:ayah_text            "إِن كُلُّ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ إِلَّآ ءَاتِي ٱلرَّحۡمَٰنِ عَبۡدٗا" ;
        quran:ayah_text_no_diacratic   "ان كل من في السمٰوٰت والارض الا ءاتي الرحمٰن عبدا" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2379" ;
        quran:page                     "311" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:3523  quran:ayah_text            "وَقَالَ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ وَٱلۡإِيمَٰنَ لَقَدۡ لَبِثۡتُمۡ فِي كِتَٰبِ ٱللَّهِ إِلَىٰ يَوۡمِ ٱلۡبَعۡثِۖ فَهَٰذَا يَوۡمُ ٱلۡبَعۡثِ وَلَٰكِنَّكُمۡ كُنتُمۡ لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وقال الذين اوتوا العلم والايمٰن لقد لبثتم في كتٰب الله الىٰ يوم البعث فهٰذا يوم البعث ولٰكنكم كنتم لا تعلمون" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3523" ;
        quran:page                     "410" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1285  quran:ayah_text            "۞يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِنَّ كَثِيرٗا مِّنَ ٱلۡأَحۡبَارِ وَٱلرُّهۡبَانِ لَيَأۡكُلُونَ أَمۡوَٰلَ ٱلنَّاسِ بِٱلۡبَٰطِلِ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِۗ وَٱلَّذِينَ يَكۡنِزُونَ ٱلذَّهَبَ وَٱلۡفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ ٱللَّهِ فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٖ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا ان كثيرا من الاحبار والرهبان لياكلون اموٰل الناس بالبٰطل ويصدون عن سبيل الله والذين يكنزون الذهب والفضة ولا ينفقونها في سبيل الله فبشرهم بعذاب اليم" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1285" ;
        quran:page                     "192" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:993  quran:ayah_text             "يَٰبَنِيٓ ءَادَمَ قَدۡ أَنزَلۡنَا عَلَيۡكُمۡ لِبَاسٗا يُوَٰرِي سَوۡءَٰتِكُمۡ وَرِيشٗاۖ وَلِبَاسُ ٱلتَّقۡوَىٰ ذَٰلِكَ خَيۡرٞۚ ذَٰلِكَ مِنۡ ءَايَٰتِ ٱللَّهِ لَعَلَّهُمۡ يَذَّكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "يٰبني ءادم قد انزلنا عليكم لباسا يوٰري سوءٰتكم وريشا ولباس التقوىٰ ذٰلك خير ذٰلك من ءايٰت الله لعلهم يذكرون" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
