quran:2006  quran:ayah_text            "۞ضَرَبَ ٱللَّهُ مَثَلًا عَبۡدٗا مَّمۡلُوكٗا لَّا يَقۡدِرُ عَلَىٰ شَيۡءٖ وَمَن رَّزَقۡنَٰهُ مِنَّا رِزۡقًا حَسَنٗا فَهُوَ يُنفِقُ مِنۡهُ سِرّٗا وَجَهۡرًاۖ هَلۡ يَسۡتَوُۥنَۚ ٱلۡحَمۡدُ لِلَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ضرب الله مثلا عبدا مملوكا لا يقدر علىٰ شيء ومن رزقنٰه منا رزقا حسنا فهو ينفق منه سرا وجهرا هل يستون الحمد لله بل اكثرهم لا يعلمون" ;
        quran:ayahnumber               "75" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2006" ;
        quran:page                     "275" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:620  quran:ayah_text             "يَعِدُهُمۡ وَيُمَنِّيهِمۡۖ وَمَا يَعِدُهُمُ ٱلشَّيۡطَٰنُ إِلَّا غُرُورًا" ;
        quran:ayah_text_no_diacratic   "يعدهم ويمنيهم وما يعدهم الشيطٰن الا غرورا" ;
        quran:ayahnumber               "120" ;
