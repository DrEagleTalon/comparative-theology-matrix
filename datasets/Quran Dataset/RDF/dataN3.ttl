quran:1413  quran:ayah_text            "قُلۡ مَن يَرۡزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِ أَمَّن يَمۡلِكُ ٱلسَّمۡعَ وَٱلۡأَبۡصَٰرَ وَمَن يُخۡرِجُ ٱلۡحَيَّ مِنَ ٱلۡمَيِّتِ وَيُخۡرِجُ ٱلۡمَيِّتَ مِنَ ٱلۡحَيِّ وَمَن يُدَبِّرُ ٱلۡأَمۡرَۚ فَسَيَقُولُونَ ٱللَّهُۚ فَقُلۡ أَفَلَا تَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "قل من يرزقكم من السماء والارض امن يملك السمع والابصٰر ومن يخرج الحي من الميت ويخرج الميت من الحي ومن يدبر الامر فسيقولون الله فقل افلا تتقون" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1413" ;
        quran:page                     "212" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2317  quran:ayah_text            "وَجَعَلَنِي مُبَارَكًا أَيۡنَ مَا كُنتُ وَأَوۡصَٰنِي بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ مَا دُمۡتُ حَيّٗا" ;
        quran:ayah_text_no_diacratic   "وجعلني مباركا اين ما كنت واوصٰني بالصلوٰة والزكوٰة ما دمت حيا" ;
