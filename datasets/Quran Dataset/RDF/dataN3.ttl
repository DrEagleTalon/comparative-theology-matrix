        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:3168  quran:ayah_text            "وَمَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلۡكَٰذِبِينَ" ;
        quran:ayah_text_no_diacratic   "وما انت الا بشر مثلنا وان نظنك لمن الكٰذبين" ;
