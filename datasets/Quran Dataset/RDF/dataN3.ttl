        quran:surrahname_no_diacratic  "سورة طه" .

quran:5604  quran:ayah_text            "وَأَمَّا ٱلۡقَٰسِطُونَ فَكَانُواْ لِجَهَنَّمَ حَطَبٗا" ;
        quran:ayah_text_no_diacratic   "واما القٰسطون فكانوا لجهنم حطبا" ;
