quran:2521  quran:ayah_text            "قُلۡ كُلّٞ مُّتَرَبِّصٞ فَتَرَبَّصُواْۖ فَسَتَعۡلَمُونَ مَنۡ أَصۡحَٰبُ ٱلصِّرَٰطِ ٱلسَّوِيِّ وَمَنِ ٱهۡتَدَىٰ" ;
        quran:ayah_text_no_diacratic   "قل كل متربص فتربصوا فستعلمون من اصحٰب الصرٰط السوي ومن اهتدىٰ" ;
        quran:ayahnumber               "135" ;
        quran:chapter                  "16" ;
