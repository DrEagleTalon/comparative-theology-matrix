quran:311  quran:ayah_text             "قَدۡ كَانَ لَكُمۡ ءَايَةٞ فِي فِئَتَيۡنِ ٱلۡتَقَتَاۖ فِئَةٞ تُقَٰتِلُ فِي سَبِيلِ ٱللَّهِ وَأُخۡرَىٰ كَافِرَةٞ يَرَوۡنَهُم مِّثۡلَيۡهِمۡ رَأۡيَ ٱلۡعَيۡنِۚ وَٱللَّهُ يُؤَيِّدُ بِنَصۡرِهِۦ مَن يَشَآءُۚ إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّأُوْلِي ٱلۡأَبۡصَٰرِ" ;
        quran:ayah_text_no_diacratic   "قد كان لكم ءاية في فئتين التقتا فئة تقٰتل في سبيل الله واخرىٰ كافرة يرونهم مثليهم راي العين والله يؤيد بنصره من يشاء ان في ذٰلك لعبرة لاولي الابصٰر" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "311" ;
        quran:page                     "51" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5840  quran:ayah_text            "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا" ;
