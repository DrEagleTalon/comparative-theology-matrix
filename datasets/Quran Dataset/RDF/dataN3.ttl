        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:824  quran:ayah_text             "ٱنظُرۡ كَيۡفَ كَذَبُواْ عَلَىٰٓ أَنفُسِهِمۡۚ وَضَلَّ عَنۡهُم مَّا كَانُواْ يَفۡتَرُونَ" ;
