        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1015  quran:ayah_text            "وَنَادَىٰٓ أَصۡحَٰبُ ٱلۡأَعۡرَافِ رِجَالٗا يَعۡرِفُونَهُم بِسِيمَىٰهُمۡ قَالُواْ مَآ أَغۡنَىٰ عَنكُمۡ جَمۡعُكُمۡ وَمَا كُنتُمۡ تَسۡتَكۡبِرُونَ" ;
        quran:ayah_text_no_diacratic   "ونادىٰ اصحٰب الاعراف رجالا يعرفونهم بسيمىٰهم قالوا ما اغنىٰ عنكم جمعكم وما كنتم تستكبرون" ;
        quran:ayahnumber               "48" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1015" ;
        quran:page                     "156" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:723  quran:ayah_text             "وَكَتَبۡنَا عَلَيۡهِمۡ فِيهَآ أَنَّ ٱلنَّفۡسَ بِٱلنَّفۡسِ وَٱلۡعَيۡنَ بِٱلۡعَيۡنِ وَٱلۡأَنفَ بِٱلۡأَنفِ وَٱلۡأُذُنَ بِٱلۡأُذُنِ وَٱلسِّنَّ بِٱلسِّنِّ وَٱلۡجُرُوحَ قِصَاصٞۚ فَمَن تَصَدَّقَ بِهِۦ فَهُوَ كَفَّارَةٞ لَّهُۥۚ وَمَن لَّمۡ يَحۡكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُوْلَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ" ;
        quran:ayah_text_no_diacratic   "وكتبنا عليهم فيها ان النفس بالنفس والعين بالعين والانف بالانف والاذن بالاذن والسن بالسن والجروح قصاص فمن تصدق به فهو كفارة له ومن لم يحكم بما انزل الله فاولٰئك هم الظٰلمون" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "723" ;
        quran:page                     "115" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:533  quran:ayah_text             "وَلِكُلّٖ جَعَلۡنَا مَوَٰلِيَ مِمَّا تَرَكَ ٱلۡوَٰلِدَانِ وَٱلۡأَقۡرَبُونَۚ وَٱلَّذِينَ عَقَدَتۡ أَيۡمَٰنُكُمۡ فَـَٔاتُوهُمۡ نَصِيبَهُمۡۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدًا" ;
        quran:ayah_text_no_diacratic   "ولكل جعلنا موٰلي مما ترك الوٰلدان والاقربون والذين عقدت ايمٰنكم فاتوهم نصيبهم ان الله كان علىٰ كل شيء شهيدا" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "533" ;
        quran:page                     "83" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:343  quran:ayah_text             "إِذۡ قَالَتِ ٱلۡمَلَٰٓئِكَةُ يَٰمَرۡيَمُ إِنَّ ٱللَّهَ يُبَشِّرُكِ بِكَلِمَةٖ مِّنۡهُ ٱسۡمُهُ ٱلۡمَسِيحُ عِيسَى ٱبۡنُ مَرۡيَمَ وَجِيهٗا فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَمِنَ ٱلۡمُقَرَّبِينَ" ;
        quran:ayah_text_no_diacratic   "اذ قالت الملٰئكة يٰمريم ان الله يبشرك بكلمة منه اسمه المسيح عيسى ابن مريم وجيها في الدنيا والاخرة ومن المقربين" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "343" ;
        quran:page                     "55" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5872  quran:ayah_text            "فَٱلسَّٰبِقَٰتِ سَبۡقٗا" ;
