        quran:surrahname_no_diacratic  "سورة الزخرف" .

quran:2430  quran:ayah_text            "فَقُولَا لَهُۥ قَوۡلٗا لَّيِّنٗا لَّعَلَّهُۥ يَتَذَكَّرُ أَوۡ يَخۡشَىٰ" ;
