        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:5339  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِنَّ مِنۡ أَزۡوَٰجِكُمۡ وَأَوۡلَٰدِكُمۡ عَدُوّٗا لَّكُمۡ فَٱحۡذَرُوهُمۡۚ وَإِن تَعۡفُواْ وَتَصۡفَحُواْ وَتَغۡفِرُواْ فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا ان من ازوٰجكم واولٰدكم عدوا لكم فاحذروهم وان تعفوا وتصفحوا وتغفروا فان الله غفور رحيم" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5339" ;
        quran:page                     "557" ;
        quran:surahname                "سُورَةُ التَّغَابُنِ" ;
        quran:surahnumber              "64" ;
        quran:surrahname_no_diacratic  "سورة التغابن" .

quran:3341  quran:ayah_text            "قَالَ سَنَشُدُّ عَضُدَكَ بِأَخِيكَ وَنَجۡعَلُ لَكُمَا سُلۡطَٰنٗا فَلَا يَصِلُونَ إِلَيۡكُمَا بِـَٔايَٰتِنَآۚ أَنتُمَا وَمَنِ ٱتَّبَعَكُمَا ٱلۡغَٰلِبُونَ" ;
        quran:ayah_text_no_diacratic   "قال سنشد عضدك باخيك ونجعل لكما سلطٰنا فلا يصلون اليكما بايٰتنا انتما ومن اتبعكما الغٰلبون" ;
