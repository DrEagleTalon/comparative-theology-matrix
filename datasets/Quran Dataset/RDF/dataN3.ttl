quran:3365  quran:ayah_text            "وَمَا كَانَ رَبُّكَ مُهۡلِكَ ٱلۡقُرَىٰ حَتَّىٰ يَبۡعَثَ فِيٓ أُمِّهَا رَسُولٗا يَتۡلُواْ عَلَيۡهِمۡ ءَايَٰتِنَاۚ وَمَا كُنَّا مُهۡلِكِي ٱلۡقُرَىٰٓ إِلَّا وَأَهۡلُهَا ظَٰلِمُونَ" ;
        quran:ayah_text_no_diacratic   "وما كان ربك مهلك القرىٰ حتىٰ يبعث في امها رسولا يتلوا عليهم ءايٰتنا وما كنا مهلكي القرىٰ الا واهلها ظٰلمون" ;
        quran:ayahnumber               "59" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3365" ;
        quran:page                     "392" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4269  quran:ayah_text            "وَمَا يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَلَا ٱلۡمُسِيٓءُۚ قَلِيلٗا مَّا تَتَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "وما يستوي الاعمىٰ والبصير والذين ءامنوا وعملوا الصٰلحٰت ولا المسيء قليلا ما تتذكرون" ;
