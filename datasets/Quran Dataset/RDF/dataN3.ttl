        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3434  quran:ayah_text            "وَعَادٗا وَثَمُودَاْ وَقَد تَّبَيَّنَ لَكُم مِّن مَّسَٰكِنِهِمۡۖ وَزَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ أَعۡمَٰلَهُمۡ فَصَدَّهُمۡ عَنِ ٱلسَّبِيلِ وَكَانُواْ مُسۡتَبۡصِرِينَ" ;
        quran:ayah_text_no_diacratic   "وعادا وثمودا وقد تبين لكم من مسٰكنهم وزين لهم الشيطٰن اعمٰلهم فصدهم عن السبيل وكانوا مستبصرين" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3434" ;
        quran:page                     "400" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1196  quran:ayah_text            "وَلَا تَكُونُواْ كَٱلَّذِينَ قَالُواْ سَمِعۡنَا وَهُمۡ لَا يَسۡمَعُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تكونوا كالذين قالوا سمعنا وهم لا يسمعون" ;
        quran:ayahnumber               "21" ;
