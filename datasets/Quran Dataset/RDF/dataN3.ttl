        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1380  quran:ayah_text            "فَإِن تَوَلَّوۡاْ فَقُلۡ حَسۡبِيَ ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ عَلَيۡهِ تَوَكَّلۡتُۖ وَهُوَ رَبُّ ٱلۡعَرۡشِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "فان تولوا فقل حسبي الله لا الٰه الا هو عليه توكلت وهو رب العرش العظيم" ;
