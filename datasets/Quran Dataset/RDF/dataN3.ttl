quran:2660  quran:ayah_text            "إِنَّ ٱللَّهَ يُدۡخِلُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ يُحَلَّوۡنَ فِيهَا مِنۡ أَسَاوِرَ مِن ذَهَبٖ وَلُؤۡلُؤٗاۖ وَلِبَاسُهُمۡ فِيهَا حَرِيرٞ" ;
        quran:ayah_text_no_diacratic   "ان الله يدخل الذين ءامنوا وعملوا الصٰلحٰت جنٰت تجري من تحتها الانهٰر يحلون فيها من اساور من ذهب ولؤلؤا ولباسهم فيها حرير" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2660" ;
        quran:page                     "334" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

