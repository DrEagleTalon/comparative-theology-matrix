        quran:index                    "4619" ;
        quran:page                     "504" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:3525  quran:ayah_text            "وَلَقَدۡ ضَرَبۡنَا لِلنَّاسِ فِي هَٰذَا ٱلۡقُرۡءَانِ مِن كُلِّ مَثَلٖۚ وَلَئِن جِئۡتَهُم بِـَٔايَةٖ لَّيَقُولَنَّ ٱلَّذِينَ كَفَرُوٓاْ إِنۡ أَنتُمۡ إِلَّا مُبۡطِلُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد ضربنا للناس في هٰذا القرءان من كل مثل ولئن جئتهم باية ليقولن الذين كفروا ان انتم الا مبطلون" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3525" ;
        quran:page                     "410" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1287  quran:ayah_text            "إِنَّ عِدَّةَ ٱلشُّهُورِ عِندَ ٱللَّهِ ٱثۡنَا عَشَرَ شَهۡرٗا فِي كِتَٰبِ ٱللَّهِ يَوۡمَ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ مِنۡهَآ أَرۡبَعَةٌ حُرُمٞۚ ذَٰلِكَ ٱلدِّينُ ٱلۡقَيِّمُۚ فَلَا تَظۡلِمُواْ فِيهِنَّ أَنفُسَكُمۡۚ وَقَٰتِلُواْ ٱلۡمُشۡرِكِينَ كَآفَّةٗ كَمَا يُقَٰتِلُونَكُمۡ كَآفَّةٗۚ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَعَ ٱلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "ان عدة الشهور عند الله اثنا عشر شهرا في كتٰب الله يوم خلق السمٰوٰت والارض منها اربعة حرم ذٰلك الدين القيم فلا تظلموا فيهن انفسكم وقٰتلوا المشركين كافة كما يقٰتلونكم كافة واعلموا ان الله مع المتقين" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1287" ;
        quran:page                     "192" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:995  quran:ayah_text             "وَإِذَا فَعَلُواْ فَٰحِشَةٗ قَالُواْ وَجَدۡنَا عَلَيۡهَآ ءَابَآءَنَا وَٱللَّهُ أَمَرَنَا بِهَاۗ قُلۡ إِنَّ ٱللَّهَ لَا يَأۡمُرُ بِٱلۡفَحۡشَآءِۖ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "واذا فعلوا فٰحشة قالوا وجدنا عليها ءاباءنا والله امرنا بها قل ان الله لا يامر بالفحشاء اتقولون على الله ما لا تعلمون" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "995" ;
        quran:page                     "153" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:4429  quran:ayah_text            "وَقَالُواْ لَوۡ شَآءَ ٱلرَّحۡمَٰنُ مَا عَبَدۡنَٰهُمۗ مَّا لَهُم بِذَٰلِكَ مِنۡ عِلۡمٍۖ إِنۡ هُمۡ إِلَّا يَخۡرُصُونَ" ;
        quran:ayah_text_no_diacratic   "وقالوا لو شاء الرحمٰن ما عبدنٰهم ما لهم بذٰلك من علم ان هم الا يخرصون" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4429" ;
        quran:page                     "490" ;
        quran:surahname                "سُورَةُ الزُّخۡرُفِ" ;
        quran:surahnumber              "43" ;
        quran:surrahname_no_diacratic  "سورة الزخرف" .

quran:2431  quran:ayah_text            "قَالَا رَبَّنَآ إِنَّنَا نَخَافُ أَن يَفۡرُطَ عَلَيۡنَآ أَوۡ أَن يَطۡغَىٰ" ;
        quran:ayah_text_no_diacratic   "قالا ربنا اننا نخاف ان يفرط علينا او ان يطغىٰ" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
