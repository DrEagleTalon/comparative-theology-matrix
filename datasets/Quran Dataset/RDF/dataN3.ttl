        quran:surrahname_no_diacratic  "سورة مريم" .

quran:5507  quran:ayah_text            "وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "وانه لتذكرة للمتقين" ;
