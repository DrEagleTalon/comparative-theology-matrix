quran:2691  quran:ayah_text            "وَلِيَعۡلَمَ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ أَنَّهُ ٱلۡحَقُّ مِن رَّبِّكَ فَيُؤۡمِنُواْ بِهِۦ فَتُخۡبِتَ لَهُۥ قُلُوبُهُمۡۗ وَإِنَّ ٱللَّهَ لَهَادِ ٱلَّذِينَ ءَامَنُوٓاْ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ" ;
        quran:ayah_text_no_diacratic   "وليعلم الذين اوتوا العلم انه الحق من ربك فيؤمنوا به فتخبت له قلوبهم وان الله لهاد الذين ءامنوا الىٰ صرٰط مستقيم" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2691" ;
        quran:page                     "338" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:4689  quran:ayah_text            "بَلۡ ظَنَنتُمۡ أَن لَّن يَنقَلِبَ ٱلرَّسُولُ وَٱلۡمُؤۡمِنُونَ إِلَىٰٓ أَهۡلِيهِمۡ أَبَدٗا وَزُيِّنَ ذَٰلِكَ فِي قُلُوبِكُمۡ وَظَنَنتُمۡ ظَنَّ ٱلسَّوۡءِ وَكُنتُمۡ قَوۡمَۢا بُورٗا" ;
        quran:ayah_text_no_diacratic   "بل ظننتم ان لن ينقلب الرسول والمؤمنون الىٰ اهليهم ابدا وزين ذٰلك في قلوبكم وظننتم ظن السوء وكنتم قوما بورا" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4689" ;
        quran:page                     "512" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:304  quran:ayah_text             "هُوَ ٱلَّذِي يُصَوِّرُكُمۡ فِي ٱلۡأَرۡحَامِ كَيۡفَ يَشَآءُۚ لَآ إِلَٰهَ إِلَّا هُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ" ;
        quran:ayah_text_no_diacratic   "هو الذي يصوركم في الارحام كيف يشاء لا الٰه الا هو العزيز الحكيم" ;
        quran:ayahnumber               "6" ;
