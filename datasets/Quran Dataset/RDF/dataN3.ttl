quran:1421  quran:ayah_text            "بَلۡ كَذَّبُواْ بِمَا لَمۡ يُحِيطُواْ بِعِلۡمِهِۦ وَلَمَّا يَأۡتِهِمۡ تَأۡوِيلُهُۥۚ كَذَٰلِكَ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡۖ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "بل كذبوا بما لم يحيطوا بعلمه ولما ياتهم تاويله كذٰلك كذب الذين من قبلهم فانظر كيف كان عٰقبة الظٰلمين" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1421" ;
        quran:page                     "213" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:889  quran:ayah_text             "أُوْلَٰٓئِكَ ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ وَٱلۡحُكۡمَ وَٱلنُّبُوَّةَۚ فَإِن يَكۡفُرۡ بِهَا هَٰٓؤُلَآءِ فَقَدۡ وَكَّلۡنَا بِهَا قَوۡمٗا لَّيۡسُواْ بِهَا بِكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "اولٰئك الذين ءاتينٰهم الكتٰب والحكم والنبوة فان يكفر بها هٰؤلاء فقد وكلنا بها قوما ليسوا بها بكٰفرين" ;
        quran:ayahnumber               "89" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "889" ;
        quran:page                     "138" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2325  quran:ayah_text            "وَأَنذِرۡهُمۡ يَوۡمَ ٱلۡحَسۡرَةِ إِذۡ قُضِيَ ٱلۡأَمۡرُ وَهُمۡ فِي غَفۡلَةٖ وَهُمۡ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "وانذرهم يوم الحسرة اذ قضي الامر وهم في غفلة وهم لا يؤمنون" ;
        quran:ayahnumber               "39" ;
