        quran:surrahname_no_diacratic  "سورة الجن" .

quran:3378  quran:ayah_text            "قُلۡ أَرَءَيۡتُمۡ إِن جَعَلَ ٱللَّهُ عَلَيۡكُمُ ٱلنَّهَارَ سَرۡمَدًا إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ مَنۡ إِلَٰهٌ غَيۡرُ ٱللَّهِ يَأۡتِيكُم بِلَيۡلٖ تَسۡكُنُونَ فِيهِۚ أَفَلَا تُبۡصِرُونَ" ;
        quran:ayah_text_no_diacratic   "قل ارءيتم ان جعل الله عليكم النهار سرمدا الىٰ يوم القيٰمة من الٰه غير الله ياتيكم بليل تسكنون فيه افلا تبصرون" ;
        quran:ayahnumber               "72" ;
        quran:chapter                  "20" ;
