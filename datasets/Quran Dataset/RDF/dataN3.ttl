        quran:surahname                "سُورَةُ الزُّخۡرُفِ" ;
        quran:surahnumber              "43" ;
        quran:surrahname_no_diacratic  "سورة الزخرف" .

quran:5346  quran:ayah_text            "يَٰٓأَيُّهَا ٱلنَّبِيُّ إِذَا طَلَّقۡتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحۡصُواْ ٱلۡعِدَّةَۖ وَٱتَّقُواْ ٱللَّهَ رَبَّكُمۡۖ لَا تُخۡرِجُوهُنَّ مِنۢ بُيُوتِهِنَّ وَلَا يَخۡرُجۡنَ إِلَّآ أَن يَأۡتِينَ بِفَٰحِشَةٖ مُّبَيِّنَةٖۚ وَتِلۡكَ حُدُودُ ٱللَّهِۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَقَدۡ ظَلَمَ نَفۡسَهُۥۚ لَا تَدۡرِي لَعَلَّ ٱللَّهَ يُحۡدِثُ بَعۡدَ ذَٰلِكَ أَمۡرٗا" ;
        quran:ayah_text_no_diacratic   "يٰايها النبي اذا طلقتم النساء فطلقوهن لعدتهن واحصوا العدة واتقوا الله ربكم لا تخرجوهن من بيوتهن ولا يخرجن الا ان ياتين بفٰحشة مبينة وتلك حدود الله ومن يتعد حدود الله فقد ظلم نفسه لا تدري لعل الله يحدث بعد ذٰلك امرا" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5346" ;
        quran:page                     "558" ;
        quran:surahname                "سُورَةُ الطَّلَاقِ" ;
        quran:surahnumber              "65" ;
        quran:surrahname_no_diacratic  "سورة الطلاق" .

quran:4252  quran:ayah_text            "۞وَيَٰقَوۡمِ مَا لِيٓ أَدۡعُوكُمۡ إِلَى ٱلنَّجَوٰةِ وَتَدۡعُونَنِيٓ إِلَى ٱلنَّارِ" ;
