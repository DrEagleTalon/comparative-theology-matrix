        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2034  quran:ayah_text            "وَلَقَدۡ نَعۡلَمُ أَنَّهُمۡ يَقُولُونَ إِنَّمَا يُعَلِّمُهُۥ بَشَرٞۗ لِّسَانُ ٱلَّذِي يُلۡحِدُونَ إِلَيۡهِ أَعۡجَمِيّٞ وَهَٰذَا لِسَانٌ عَرَبِيّٞ مُّبِينٌ" ;
        quran:ayah_text_no_diacratic   "ولقد نعلم انهم يقولون انما يعلمه بشر لسان الذي يلحدون اليه اعجمي وهٰذا لسان عربي مبين" ;
        quran:ayahnumber               "103" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2034" ;
        quran:page                     "279" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2966  quran:ayah_text            "وَعِبَادُ ٱلرَّحۡمَٰنِ ٱلَّذِينَ يَمۡشُونَ عَلَى ٱلۡأَرۡضِ هَوۡنٗا وَإِذَا خَاطَبَهُمُ ٱلۡجَٰهِلُونَ قَالُواْ سَلَٰمٗا" ;
        quran:ayah_text_no_diacratic   "وعباد الرحمٰن الذين يمشون على الارض هونا واذا خاطبهم الجٰهلون قالوا سلٰما" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "2966" ;
        quran:page                     "365" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
