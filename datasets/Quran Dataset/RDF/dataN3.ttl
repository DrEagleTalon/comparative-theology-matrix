quran:1242  quran:ayah_text            "مَا كَانَ لِنَبِيٍّ أَن يَكُونَ لَهُۥٓ أَسۡرَىٰ حَتَّىٰ يُثۡخِنَ فِي ٱلۡأَرۡضِۚ تُرِيدُونَ عَرَضَ ٱلدُّنۡيَا وَٱللَّهُ يُرِيدُ ٱلۡأٓخِرَةَۗ وَٱللَّهُ عَزِيزٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "ما كان لنبي ان يكون له اسرىٰ حتىٰ يثخن في الارض تريدون عرض الدنيا والله يريد الاخرة والله عزيز حكيم" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1242" ;
        quran:page                     "185" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:950  quran:ayah_text             "قُلۡ هَلُمَّ شُهَدَآءَكُمُ ٱلَّذِينَ يَشۡهَدُونَ أَنَّ ٱللَّهَ حَرَّمَ هَٰذَاۖ فَإِن شَهِدُواْ فَلَا تَشۡهَدۡ مَعَهُمۡۚ وَلَا تَتَّبِعۡ أَهۡوَآءَ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا وَٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ وَهُم بِرَبِّهِمۡ يَعۡدِلُونَ" ;
        quran:ayah_text_no_diacratic   "قل هلم شهداءكم الذين يشهدون ان الله حرم هٰذا فان شهدوا فلا تشهد معهم ولا تتبع اهواء الذين كذبوا بايٰتنا والذين لا يؤمنون بالاخرة وهم بربهم يعدلون" ;
        quran:ayahnumber               "150" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "950" ;
        quran:page                     "148" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2146  quran:ayah_text            "وَيَسۡـَٔلُونَكَ عَنِ ٱلرُّوحِۖ قُلِ ٱلرُّوحُ مِنۡ أَمۡرِ رَبِّي وَمَآ أُوتِيتُم مِّنَ ٱلۡعِلۡمِ إِلَّا قَلِيلٗا" ;
        quran:ayah_text_no_diacratic   "ويسلونك عن الروح قل الروح من امر ربي وما اوتيتم من العلم الا قليلا" ;
        quran:ayahnumber               "85" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2146" ;
        quran:page                     "290" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1052  quran:ayah_text            "وَإِلَىٰ مَدۡيَنَ أَخَاهُمۡ شُعَيۡبٗاۚ قَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥۖ قَدۡ جَآءَتۡكُم بَيِّنَةٞ مِّن رَّبِّكُمۡۖ فَأَوۡفُواْ ٱلۡكَيۡلَ وَٱلۡمِيزَانَ وَلَا تَبۡخَسُواْ ٱلنَّاسَ أَشۡيَآءَهُمۡ وَلَا تُفۡسِدُواْ فِي ٱلۡأَرۡضِ بَعۡدَ إِصۡلَٰحِهَاۚ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "والىٰ مدين اخاهم شعيبا قال يٰقوم اعبدوا الله ما لكم من الٰه غيره قد جاءتكم بينة من ربكم فاوفوا الكيل والميزان ولا تبخسوا الناس اشياءهم ولا تفسدوا في الارض بعد اصلٰحها ذٰلكم خير لكم ان كنتم مؤمنين" ;
        quran:ayahnumber               "85" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1052" ;
        quran:page                     "161" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:760  quran:ayah_text             "۞لَتَجِدَنَّ أَشَدَّ ٱلنَّاسِ عَدَٰوَةٗ لِّلَّذِينَ ءَامَنُواْ ٱلۡيَهُودَ وَٱلَّذِينَ أَشۡرَكُواْۖ وَلَتَجِدَنَّ أَقۡرَبَهُم مَّوَدَّةٗ لِّلَّذِينَ ءَامَنُواْ ٱلَّذِينَ قَالُوٓاْ إِنَّا نَصَٰرَىٰۚ ذَٰلِكَ بِأَنَّ مِنۡهُمۡ قِسِّيسِينَ وَرُهۡبَانٗا وَأَنَّهُمۡ لَا يَسۡتَكۡبِرُونَ" ;
        quran:ayah_text_no_diacratic   "لتجدن اشد الناس عدٰوة للذين ءامنوا اليهود والذين اشركوا ولتجدن اقربهم مودة للذين ءامنوا الذين قالوا انا نصٰرىٰ ذٰلك بان منهم قسيسين ورهبانا وانهم لا يستكبرون" ;
        quran:ayahnumber               "82" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "760" ;
        quran:page                     "121" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:3100  quran:ayah_text            "فَٱفۡتَحۡ بَيۡنِي وَبَيۡنَهُمۡ فَتۡحٗا وَنَجِّنِي وَمَن مَّعِيَ مِنَ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "فافتح بيني وبينهم فتحا ونجني ومن معي من المؤمنين" ;
        quran:ayahnumber               "118" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3100" ;
        quran:page                     "372" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:570  quran:ayah_text             "ذَٰلِكَ ٱلۡفَضۡلُ مِنَ ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ عَلِيمٗا" ;
        quran:ayah_text_no_diacratic   "ذٰلك الفضل من الله وكفىٰ بالله عليما" ;
        quran:ayahnumber               "70" ;
