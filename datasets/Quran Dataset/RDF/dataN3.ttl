        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:522  quran:ayah_text             "وَلَا تَنكِحُواْ مَا نَكَحَ ءَابَآؤُكُم مِّنَ ٱلنِّسَآءِ إِلَّا مَا قَدۡ سَلَفَۚ إِنَّهُۥ كَانَ فَٰحِشَةٗ وَمَقۡتٗا وَسَآءَ سَبِيلًا" ;
        quran:ayah_text_no_diacratic   "ولا تنكحوا ما نكح ءاباؤكم من النساء الا ما قد سلف انه كان فٰحشة ومقتا وساء سبيلا" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "4" ;
