quran:347  quran:ayah_text             "وَرَسُولًا إِلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ أَنِّي قَدۡ جِئۡتُكُم بِـَٔايَةٖ مِّن رَّبِّكُمۡ أَنِّيٓ أَخۡلُقُ لَكُم مِّنَ ٱلطِّينِ كَهَيۡـَٔةِ ٱلطَّيۡرِ فَأَنفُخُ فِيهِ فَيَكُونُ طَيۡرَۢا بِإِذۡنِ ٱللَّهِۖ وَأُبۡرِئُ ٱلۡأَكۡمَهَ وَٱلۡأَبۡرَصَ وَأُحۡيِ ٱلۡمَوۡتَىٰ بِإِذۡنِ ٱللَّهِۖ وَأُنَبِّئُكُم بِمَا تَأۡكُلُونَ وَمَا تَدَّخِرُونَ فِي بُيُوتِكُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "ورسولا الىٰ بني اسرٰءيل اني قد جئتكم باية من ربكم اني اخلق لكم من الطين كهية الطير فانفخ فيه فيكون طيرا باذن الله وابرئ الاكمه والابرص واحي الموتىٰ باذن الله وانبئكم بما تاكلون وما تدخرون في بيوتكم ان في ذٰلك لاية لكم ان كنتم مؤمنين" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "347" ;
        quran:page                     "56" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

