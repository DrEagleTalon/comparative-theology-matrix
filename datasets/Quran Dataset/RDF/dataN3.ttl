quran:4653  quran:ayah_text            "وَمِنۡهُم مَّن يَسۡتَمِعُ إِلَيۡكَ حَتَّىٰٓ إِذَا خَرَجُواْ مِنۡ عِندِكَ قَالُواْ لِلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ مَاذَا قَالَ ءَانِفًاۚ أُوْلَٰٓئِكَ ٱلَّذِينَ طَبَعَ ٱللَّهُ عَلَىٰ قُلُوبِهِمۡ وَٱتَّبَعُوٓاْ أَهۡوَآءَهُمۡ" ;
        quran:ayah_text_no_diacratic   "ومنهم من يستمع اليك حتىٰ اذا خرجوا من عندك قالوا للذين اوتوا العلم ماذا قال ءانفا اولٰئك الذين طبع الله علىٰ قلوبهم واتبعوا اهواءهم" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4653" ;
        quran:page                     "508" ;
        quran:surahname                "سُورَةُ مُحَمَّدٍ" ;
        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:5557  quran:ayah_text            "خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ" ;
        quran:ayah_text_no_diacratic   "خٰشعة ابصٰرهم ترهقهم ذلة ذٰلك اليوم الذي كانوا يوعدون" ;
