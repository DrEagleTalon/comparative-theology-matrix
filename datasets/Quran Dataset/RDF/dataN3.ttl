        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:3615  quran:ayah_text            "۞قَدۡ يَعۡلَمُ ٱللَّهُ ٱلۡمُعَوِّقِينَ مِنكُمۡ وَٱلۡقَآئِلِينَ لِإِخۡوَٰنِهِمۡ هَلُمَّ إِلَيۡنَاۖ وَلَا يَأۡتُونَ ٱلۡبَأۡسَ إِلَّا قَلِيلًا" ;
        quran:ayah_text_no_diacratic   "قد يعلم الله المعوقين منكم والقائلين لاخوٰنهم هلم الينا ولا ياتون الباس الا قليلا" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "21" ;
        quran:hizb                     "42" ;
        quran:index                    "3615" ;
        quran:page                     "420" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1377  quran:ayah_text            "أَوَلَا يَرَوۡنَ أَنَّهُمۡ يُفۡتَنُونَ فِي كُلِّ عَامٖ مَّرَّةً أَوۡ مَرَّتَيۡنِ ثُمَّ لَا يَتُوبُونَ وَلَا هُمۡ يَذَّكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "اولا يرون انهم يفتنون في كل عام مرة او مرتين ثم لا يتوبون ولا هم يذكرون" ;
        quran:ayahnumber               "126" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1377" ;
        quran:page                     "207" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4519  quran:ayah_text            "وَأَن لَّا تَعۡلُواْ عَلَى ٱللَّهِۖ إِنِّيٓ ءَاتِيكُم بِسُلۡطَٰنٖ مُّبِينٖ" ;
        quran:ayah_text_no_diacratic   "وان لا تعلوا على الله اني ءاتيكم بسلطٰن مبين" ;
        quran:ayahnumber               "19" ;
