        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:4449  quran:ayah_text            "أَفَأَنتَ تُسۡمِعُ ٱلصُّمَّ أَوۡ تَهۡدِي ٱلۡعُمۡيَ وَمَن كَانَ فِي ضَلَٰلٖ مُّبِينٖ" ;
        quran:ayah_text_no_diacratic   "افانت تسمع الصم او تهدي العمي ومن كان في ضلٰل مبين" ;
