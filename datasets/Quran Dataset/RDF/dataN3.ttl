quran:1214  quran:ayah_text            "وَقَٰتِلُوهُمۡ حَتَّىٰ لَا تَكُونَ فِتۡنَةٞ وَيَكُونَ ٱلدِّينُ كُلُّهُۥ لِلَّهِۚ فَإِنِ ٱنتَهَوۡاْ فَإِنَّ ٱللَّهَ بِمَا يَعۡمَلُونَ بَصِيرٞ" ;
        quran:ayah_text_no_diacratic   "وقٰتلوهم حتىٰ لا تكون فتنة ويكون الدين كله لله فان انتهوا فان الله بما يعملون بصير" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1214" ;
        quran:page                     "181" ;
