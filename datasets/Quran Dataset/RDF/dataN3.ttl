        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:4348  quran:ayah_text            "وَلَئِنۡ أَذَقۡنَٰهُ رَحۡمَةٗ مِّنَّا مِنۢ بَعۡدِ ضَرَّآءَ مَسَّتۡهُ لَيَقُولَنَّ هَٰذَا لِي وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةٗ وَلَئِن رُّجِعۡتُ إِلَىٰ رَبِّيٓ إِنَّ لِي عِندَهُۥ لَلۡحُسۡنَىٰۚ فَلَنُنَبِّئَنَّ ٱلَّذِينَ كَفَرُواْ بِمَا عَمِلُواْ وَلَنُذِيقَنَّهُم مِّنۡ عَذَابٍ غَلِيظٖ" ;
        quran:ayah_text_no_diacratic   "ولئن اذقنٰه رحمة منا من بعد ضراء مسته ليقولن هٰذا لي وما اظن الساعة قائمة ولئن رجعت الىٰ ربي ان لي عنده للحسنىٰ فلننبئن الذين كفروا بما عملوا ولنذيقنهم من عذاب غليظ" ;
        quran:ayahnumber               "50" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4348" ;
        quran:page                     "482" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2350  quran:ayah_text            "وَمَا نَتَنَزَّلُ إِلَّا بِأَمۡرِ رَبِّكَۖ لَهُۥ مَا بَيۡنَ أَيۡدِينَا وَمَا خَلۡفَنَا وَمَا بَيۡنَ ذَٰلِكَۚ وَمَا كَانَ رَبُّكَ نَسِيّٗا" ;
        quran:ayah_text_no_diacratic   "وما نتنزل الا بامر ربك له ما بين ايدينا وما خلفنا وما بين ذٰلك وما كان ربك نسيا" ;
        quran:ayahnumber               "64" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2350" ;
