        quran:surahnumber              "34" ;
        quran:surrahname_no_diacratic  "سورة سبا" .

quran:1466  quran:ayah_text            "وَقَالَ مُوسَىٰ يَٰقَوۡمِ إِن كُنتُمۡ ءَامَنتُم بِٱللَّهِ فَعَلَيۡهِ تَوَكَّلُوٓاْ إِن كُنتُم مُّسۡلِمِينَ" ;
        quran:ayah_text_no_diacratic   "وقال موسىٰ يٰقوم ان كنتم ءامنتم بالله فعليه توكلوا ان كنتم مسلمين" ;
        quran:ayahnumber               "84" ;
