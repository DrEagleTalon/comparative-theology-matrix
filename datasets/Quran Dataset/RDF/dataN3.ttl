quran:2206  quran:ayah_text            "۞وَٱضۡرِبۡ لَهُم مَّثَلٗا رَّجُلَيۡنِ جَعَلۡنَا لِأَحَدِهِمَا جَنَّتَيۡنِ مِنۡ أَعۡنَٰبٖ وَحَفَفۡنَٰهُمَا بِنَخۡلٖ وَجَعَلۡنَا بَيۡنَهُمَا زَرۡعٗا" ;
        quran:ayah_text_no_diacratic   "واضرب لهم مثلا رجلين جعلنا لاحدهما جنتين من اعنٰب وحففنٰهما بنخل وجعلنا بينهما زرعا" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2206" ;
        quran:page                     "297" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1112  quran:ayah_text            "وَكَتَبۡنَا لَهُۥ فِي ٱلۡأَلۡوَاحِ مِن كُلِّ شَيۡءٖ مَّوۡعِظَةٗ وَتَفۡصِيلٗا لِّكُلِّ شَيۡءٖ فَخُذۡهَا بِقُوَّةٖ وَأۡمُرۡ قَوۡمَكَ يَأۡخُذُواْ بِأَحۡسَنِهَاۚ سَأُوْرِيكُمۡ دَارَ ٱلۡفَٰسِقِينَ" ;
        quran:ayah_text_no_diacratic   "وكتبنا له في الالواح من كل شيء موعظة وتفصيلا لكل شيء فخذها بقوة وامر قومك ياخذوا باحسنها ساوريكم دار الفٰسقين" ;
        quran:ayahnumber               "145" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1112" ;
        quran:page                     "168" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:820  quran:ayah_text             "ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَعۡرِفُونَهُۥ كَمَا يَعۡرِفُونَ أَبۡنَآءَهُمُۘ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ فَهُمۡ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "الذين ءاتينٰهم الكتٰب يعرفونه كما يعرفون ابناءهم الذين خسروا انفسهم فهم لا يؤمنون" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "820" ;
        quran:page                     "130" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2016  quran:ayah_text            "وَإِذَا رَءَا ٱلَّذِينَ ظَلَمُواْ ٱلۡعَذَابَ فَلَا يُخَفَّفُ عَنۡهُمۡ وَلَا هُمۡ يُنظَرُونَ" ;
        quran:ayah_text_no_diacratic   "واذا رءا الذين ظلموا العذاب فلا يخفف عنهم ولا هم ينظرون" ;
        quran:ayahnumber               "85" ;
        quran:chapter                  "14" ;
