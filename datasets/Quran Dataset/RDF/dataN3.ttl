quran:2668  quran:ayah_text            "حُنَفَآءَ لِلَّهِ غَيۡرَ مُشۡرِكِينَ بِهِۦۚ وَمَن يُشۡرِكۡ بِٱللَّهِ فَكَأَنَّمَا خَرَّ مِنَ ٱلسَّمَآءِ فَتَخۡطَفُهُ ٱلطَّيۡرُ أَوۡ تَهۡوِي بِهِ ٱلرِّيحُ فِي مَكَانٖ سَحِيقٖ" ;
        quran:ayah_text_no_diacratic   "حنفاء لله غير مشركين به ومن يشرك بالله فكانما خر من السماء فتخطفه الطير او تهوي به الريح في مكان سحيق" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2668" ;
        quran:page                     "336" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:3812  quran:ayah_text            "وَءَايَةٞ لَّهُمُ ٱلَّيۡلُ نَسۡلَخُ مِنۡهُ ٱلنَّهَارَ فَإِذَا هُم مُّظۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "وءاية لهم اليل نسلخ منه النهار فاذا هم مظلمون" ;
        quran:ayahnumber               "37" ;
