        quran:surahname                "سُورَةُ القَمَرِ" ;
        quran:surahnumber              "54" ;
        quran:surrahname_no_diacratic  "سورة القمر" .

quran:355  quran:ayah_text             "وَأَمَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَيُوَفِّيهِمۡ أُجُورَهُمۡۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "واما الذين ءامنوا وعملوا الصٰلحٰت فيوفيهم اجورهم والله لا يحب الظٰلمين" ;
        quran:ayahnumber               "57" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "355" ;
