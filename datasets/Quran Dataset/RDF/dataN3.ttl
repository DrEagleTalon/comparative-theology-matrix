quran:1957  quran:ayah_text            "قَدۡ مَكَرَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَأَتَى ٱللَّهُ بُنۡيَٰنَهُم مِّنَ ٱلۡقَوَاعِدِ فَخَرَّ عَلَيۡهِمُ ٱلسَّقۡفُ مِن فَوۡقِهِمۡ وَأَتَىٰهُمُ ٱلۡعَذَابُ مِنۡ حَيۡثُ لَا يَشۡعُرُونَ" ;
        quran:ayah_text_no_diacratic   "قد مكر الذين من قبلهم فاتى الله بنيٰنهم من القواعد فخر عليهم السقف من فوقهم واتىٰهم العذاب من حيث لا يشعرون" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1957" ;
        quran:page                     "269" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:5692  quran:ayah_text            "فَرَّتۡ مِن قَسۡوَرَةِۭ" ;
