quran:6071  quran:ayah_text            "وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩" ;
        quran:ayah_text_no_diacratic   "واذا قرئ عليهم القرءان لا يسجدون" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "30" ;
