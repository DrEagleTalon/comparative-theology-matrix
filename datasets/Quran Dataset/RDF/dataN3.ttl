        quran:surahnumber              "32" ;
        quran:surrahname_no_diacratic  "سورة السجدة" .

quran:1581  quran:ayah_text            "قَالَ يَٰقَوۡمِ أَرَءَيۡتُمۡ إِن كُنتُ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّي وَرَزَقَنِي مِنۡهُ رِزۡقًا حَسَنٗاۚ وَمَآ أُرِيدُ أَنۡ أُخَالِفَكُمۡ إِلَىٰ مَآ أَنۡهَىٰكُمۡ عَنۡهُۚ إِنۡ أُرِيدُ إِلَّا ٱلۡإِصۡلَٰحَ مَا ٱسۡتَطَعۡتُۚ وَمَا تَوۡفِيقِيٓ إِلَّا بِٱللَّهِۚ عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ أُنِيبُ" ;
        quran:ayah_text_no_diacratic   "قال يٰقوم ارءيتم ان كنت علىٰ بينة من ربي ورزقني منه رزقا حسنا وما اريد ان اخالفكم الىٰ ما انهىٰكم عنه ان اريد الا الاصلٰح ما استطعت وما توفيقي الا بالله عليه توكلت واليه انيب" ;
        quran:ayahnumber               "88" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1581" ;
        quran:page                     "231" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4723  quran:ayah_text            "إِنَّمَا ٱلۡمُؤۡمِنُونَ ٱلَّذِينَ ءَامَنُواْ بِٱللَّهِ وَرَسُولِهِۦ ثُمَّ لَمۡ يَرۡتَابُواْ وَجَٰهَدُواْ بِأَمۡوَٰلِهِمۡ وَأَنفُسِهِمۡ فِي سَبِيلِ ٱللَّهِۚ أُوْلَٰٓئِكَ هُمُ ٱلصَّٰدِقُونَ" ;
        quran:ayah_text_no_diacratic   "انما المؤمنون الذين ءامنوا بالله ورسوله ثم لم يرتابوا وجٰهدوا باموٰلهم وانفسهم في سبيل الله اولٰئك هم الصٰدقون" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4723" ;
        quran:page                     "517" ;
        quran:surahname                "سُورَةُ الحُجُرَاتِ" ;
        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:2485  quran:ayah_text            "كَذَٰلِكَ نَقُصُّ عَلَيۡكَ مِنۡ أَنۢبَآءِ مَا قَدۡ سَبَقَۚ وَقَدۡ ءَاتَيۡنَٰكَ مِن لَّدُنَّا ذِكۡرٗا" ;
        quran:ayah_text_no_diacratic   "كذٰلك نقص عليك من انباء ما قد سبق وقد ءاتينٰك من لدنا ذكرا" ;
