        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:737  quran:ayah_text             "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ هَلۡ تَنقِمُونَ مِنَّآ إِلَّآ أَنۡ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ إِلَيۡنَا وَمَآ أُنزِلَ مِن قَبۡلُ وَأَنَّ أَكۡثَرَكُمۡ فَٰسِقُونَ" ;
        quran:ayah_text_no_diacratic   "قل يٰاهل الكتٰب هل تنقمون منا الا ان ءامنا بالله وما انزل الينا وما انزل من قبل وان اكثركم فٰسقون" ;
        quran:ayahnumber               "59" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "737" ;
        quran:page                     "118" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:547  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ ءَامِنُواْ بِمَا نَزَّلۡنَا مُصَدِّقٗا لِّمَا مَعَكُم مِّن قَبۡلِ أَن نَّطۡمِسَ وُجُوهٗا فَنَرُدَّهَا عَلَىٰٓ أَدۡبَارِهَآ أَوۡ نَلۡعَنَهُمۡ كَمَا لَعَنَّآ أَصۡحَٰبَ ٱلسَّبۡتِۚ وَكَانَ أَمۡرُ ٱللَّهِ مَفۡعُولًا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين اوتوا الكتٰب ءامنوا بما نزلنا مصدقا لما معكم من قبل ان نطمس وجوها فنردها علىٰ ادبارها او نلعنهم كما لعنا اصحٰب السبت وكان امر الله مفعولا" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "547" ;
        quran:page                     "86" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

