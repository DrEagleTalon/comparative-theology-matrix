quran:1450  quran:ayah_text            "قَالُواْ ٱتَّخَذَ ٱللَّهُ وَلَدٗاۗ سُبۡحَٰنَهُۥۖ هُوَ ٱلۡغَنِيُّۖ لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ إِنۡ عِندَكُم مِّن سُلۡطَٰنِۭ بِهَٰذَآۚ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "قالوا اتخذ الله ولدا سبحٰنه هو الغني له ما في السمٰوٰت وما في الارض ان عندكم من سلطٰن بهٰذا اتقولون على الله ما لا تعلمون" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1450" ;
        quran:page                     "216" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:3448  quran:ayah_text            "قُلۡ كَفَىٰ بِٱللَّهِ بَيۡنِي وَبَيۡنَكُمۡ شَهِيدٗاۖ يَعۡلَمُ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ وَٱلَّذِينَ ءَامَنُواْ بِٱلۡبَٰطِلِ وَكَفَرُواْ بِٱللَّهِ أُوْلَٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ" ;
        quran:ayah_text_no_diacratic   "قل كفىٰ بالله بيني وبينكم شهيدا يعلم ما في السمٰوٰت والارض والذين ءامنوا بالبٰطل وكفروا بالله اولٰئك هم الخٰسرون" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3448" ;
        quran:page                     "402" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:2354  quran:ayah_text            "فَوَرَبِّكَ لَنَحۡشُرَنَّهُمۡ وَٱلشَّيَٰطِينَ ثُمَّ لَنُحۡضِرَنَّهُمۡ حَوۡلَ جَهَنَّمَ جِثِيّٗا" ;
        quran:ayah_text_no_diacratic   "فوربك لنحشرنهم والشيٰطين ثم لنحضرنهم حول جهنم جثيا" ;
        quran:ayahnumber               "68" ;
