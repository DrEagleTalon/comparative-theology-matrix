quran:4697  quran:ayah_text            "وَعَدَكُمُ ٱللَّهُ مَغَانِمَ كَثِيرَةٗ تَأۡخُذُونَهَا فَعَجَّلَ لَكُمۡ هَٰذِهِۦ وَكَفَّ أَيۡدِيَ ٱلنَّاسِ عَنكُمۡ وَلِتَكُونَ ءَايَةٗ لِّلۡمُؤۡمِنِينَ وَيَهۡدِيَكُمۡ صِرَٰطٗا مُّسۡتَقِيمٗا" ;
        quran:ayah_text_no_diacratic   "وعدكم الله مغانم كثيرة تاخذونها فعجل لكم هٰذه وكف ايدي الناس عنكم ولتكون ءاية للمؤمنين ويهديكم صرٰطا مستقيما" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4697" ;
        quran:page                     "513" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:312  quran:ayah_text             "زُيِّنَ لِلنَّاسِ حُبُّ ٱلشَّهَوَٰتِ مِنَ ٱلنِّسَآءِ وَٱلۡبَنِينَ وَٱلۡقَنَٰطِيرِ ٱلۡمُقَنطَرَةِ مِنَ ٱلذَّهَبِ وَٱلۡفِضَّةِ وَٱلۡخَيۡلِ ٱلۡمُسَوَّمَةِ وَٱلۡأَنۡعَٰمِ وَٱلۡحَرۡثِۗ ذَٰلِكَ مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَٱللَّهُ عِندَهُۥ حُسۡنُ ٱلۡمَـَٔابِ" ;
        quran:ayah_text_no_diacratic   "زين للناس حب الشهوٰت من النساء والبنين والقنٰطير المقنطرة من الذهب والفضة والخيل المسومة والانعٰم والحرث ذٰلك متٰع الحيوٰة الدنيا والله عنده حسن الماب" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "312" ;
        quran:page                     "51" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

