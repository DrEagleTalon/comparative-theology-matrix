        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:827  quran:ayah_text             "وَلَوۡ تَرَىٰٓ إِذۡ وُقِفُواْ عَلَى ٱلنَّارِ فَقَالُواْ يَٰلَيۡتَنَا نُرَدُّ وَلَا نُكَذِّبَ بِـَٔايَٰتِ رَبِّنَا وَنَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "ولو ترىٰ اذ وقفوا على النار فقالوا يٰليتنا نرد ولا نكذب بايٰت ربنا ونكون من المؤمنين" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "827" ;
        quran:page                     "130" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:637  quran:ayah_text             "إِنَّ ٱلَّذِينَ ءَامَنُواْ ثُمَّ كَفَرُواْ ثُمَّ ءَامَنُواْ ثُمَّ كَفَرُواْ ثُمَّ ٱزۡدَادُواْ كُفۡرٗا لَّمۡ يَكُنِ ٱللَّهُ لِيَغۡفِرَ لَهُمۡ وَلَا لِيَهۡدِيَهُمۡ سَبِيلَۢا" ;
        quran:ayah_text_no_diacratic   "ان الذين ءامنوا ثم كفروا ثم ءامنوا ثم كفروا ثم ازدادوا كفرا لم يكن الله ليغفر لهم ولا ليهديهم سبيلا" ;
        quran:ayahnumber               "137" ;
        quran:chapter                  "5" ;
        quran:hizb                     "10" ;
        quran:index                    "637" ;
        quran:page                     "100" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:447  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِن تُطِيعُواْ ٱلَّذِينَ كَفَرُواْ يَرُدُّوكُمۡ عَلَىٰٓ أَعۡقَٰبِكُمۡ فَتَنقَلِبُواْ خَٰسِرِينَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا ان تطيعوا الذين كفروا يردوكم علىٰ اعقٰبكم فتنقلبوا خٰسرين" ;
        quran:ayahnumber               "149" ;
