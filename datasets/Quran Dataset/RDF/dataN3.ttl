quran:5036  quran:ayah_text            "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ" ;
        quran:ayah_text_no_diacratic   "ويبقىٰ وجه ربك ذو الجلٰل والاكرام" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "27" ;
        quran:hizb                     "53" ;
        quran:index                    "5036" ;
        quran:page                     "532" ;
        quran:surahname                "سُورَةُ الرَّحۡمَٰن" ;
        quran:surahnumber              "55" ;
        quran:surrahname_no_diacratic  "سورة الرحمٰن" .

quran:819  quran:ayah_text             "قُلۡ أَيُّ شَيۡءٍ أَكۡبَرُ شَهَٰدَةٗۖ قُلِ ٱللَّهُۖ شَهِيدُۢ بَيۡنِي وَبَيۡنَكُمۡۚ وَأُوحِيَ إِلَيَّ هَٰذَا ٱلۡقُرۡءَانُ لِأُنذِرَكُم بِهِۦ وَمَنۢ بَلَغَۚ أَئِنَّكُمۡ لَتَشۡهَدُونَ أَنَّ مَعَ ٱللَّهِ ءَالِهَةً أُخۡرَىٰۚ قُل لَّآ أَشۡهَدُۚ قُلۡ إِنَّمَا هُوَ إِلَٰهٞ وَٰحِدٞ وَإِنَّنِي بَرِيٓءٞ مِّمَّا تُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "قل اي شيء اكبر شهٰدة قل الله شهيد بيني وبينكم واوحي الي هٰذا القرءان لانذركم به ومن بلغ ائنكم لتشهدون ان مع الله ءالهة اخرىٰ قل لا اشهد قل انما هو الٰه وٰحد وانني بريء مما تشركون" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "819" ;
        quran:page                     "130" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:30  quran:ayah_text              "يَكَادُ ٱلۡبَرۡقُ يَخۡطَفُ أَبۡصَٰرَهُمۡۖ كُلَّمَآ أَضَآءَ لَهُم مَّشَوۡاْ فِيهِ وَإِذَآ أَظۡلَمَ عَلَيۡهِمۡ قَامُواْۚ وَلَوۡ شَآءَ ٱللَّهُ لَذَهَبَ بِسَمۡعِهِمۡ وَأَبۡصَٰرِهِمۡۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "يكاد البرق يخطف ابصٰرهم كلما اضاء لهم مشوا فيه واذا اظلم عليهم قاموا ولو شاء الله لذهب بسمعهم وابصٰرهم ان الله علىٰ كل شيء قدير" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "1" ;
        quran:hizb                     "0" ;
        quran:index                    "30" ;
        quran:page                     "4" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:629  quran:ayah_text             "وَلَن تَسۡتَطِيعُوٓاْ أَن تَعۡدِلُواْ بَيۡنَ ٱلنِّسَآءِ وَلَوۡ حَرَصۡتُمۡۖ فَلَا تَمِيلُواْ كُلَّ ٱلۡمَيۡلِ فَتَذَرُوهَا كَٱلۡمُعَلَّقَةِۚ وَإِن تُصۡلِحُواْ وَتَتَّقُواْ فَإِنَّ ٱللَّهَ كَانَ غَفُورٗا رَّحِيمٗا" ;
        quran:ayah_text_no_diacratic   "ولن تستطيعوا ان تعدلوا بين النساء ولو حرصتم فلا تميلوا كل الميل فتذروها كالمعلقة وان تصلحوا وتتقوا فان الله كان غفورا رحيما" ;
        quran:ayahnumber               "129" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "629" ;
        quran:page                     "99" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
