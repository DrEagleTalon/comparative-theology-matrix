        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:6041  quran:ayah_text            "إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ" ;
        quran:ayah_text_no_diacratic   "ان الذين اجرموا كانوا من الذين ءامنوا يضحكون" ;
        quran:ayahnumber               "29" ;
