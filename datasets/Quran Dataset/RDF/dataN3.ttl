        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:1010  quran:ayah_text            "وَنَزَعۡنَا مَا فِي صُدُورِهِم مِّنۡ غِلّٖ تَجۡرِي مِن تَحۡتِهِمُ ٱلۡأَنۡهَٰرُۖ وَقَالُواْ ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي هَدَىٰنَا لِهَٰذَا وَمَا كُنَّا لِنَهۡتَدِيَ لَوۡلَآ أَنۡ هَدَىٰنَا ٱللَّهُۖ لَقَدۡ جَآءَتۡ رُسُلُ رَبِّنَا بِٱلۡحَقِّۖ وَنُودُوٓاْ أَن تِلۡكُمُ ٱلۡجَنَّةُ أُورِثۡتُمُوهَا بِمَا كُنتُمۡ تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ونزعنا ما في صدورهم من غل تجري من تحتهم الانهٰر وقالوا الحمد لله الذي هدىٰنا لهٰذا وما كنا لنهتدي لولا ان هدىٰنا الله لقد جاءت رسل ربنا بالحق ونودوا ان تلكم الجنة اورثتموها بما كنتم تعملون" ;
        quran:ayahnumber               "43" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1010" ;
        quran:page                     "155" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:478  quran:ayah_text             "وَلَا يَحۡسَبَنَّ ٱلَّذِينَ يَبۡخَلُونَ بِمَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضۡلِهِۦ هُوَ خَيۡرٗا لَّهُمۖ بَلۡ هُوَ شَرّٞ لَّهُمۡۖ سَيُطَوَّقُونَ مَا بَخِلُواْ بِهِۦ يَوۡمَ ٱلۡقِيَٰمَةِۗ وَلِلَّهِ مِيرَٰثُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ" ;
        quran:ayah_text_no_diacratic   "ولا يحسبن الذين يبخلون بما ءاتىٰهم الله من فضله هو خيرا لهم بل هو شر لهم سيطوقون ما بخلوا به يوم القيٰمة ولله ميرٰث السمٰوٰت والارض والله بما تعملون خبير" ;
        quran:ayahnumber               "180" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "478" ;
        quran:page                     "73" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:288  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ وَذَرُواْ مَا بَقِيَ مِنَ ٱلرِّبَوٰٓاْ إِن كُنتُم مُّؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اتقوا الله وذروا ما بقي من الربوٰا ان كنتم مؤمنين" ;
        quran:ayahnumber               "278" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "288" ;
        quran:page                     "47" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1942  quran:ayah_text            "يُنۢبِتُ لَكُم بِهِ ٱلزَّرۡعَ وَٱلزَّيۡتُونَ وَٱلنَّخِيلَ وَٱلۡأَعۡنَٰبَ وَمِن كُلِّ ٱلثَّمَرَٰتِۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَتَفَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "ينبت لكم به الزرع والزيتون والنخيل والاعنٰب ومن كل الثمرٰت ان في ذٰلك لاية لقوم يتفكرون" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1942" ;
        quran:page                     "268" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2846  quran:ayah_text            "وَٱلۡخَٰمِسَةَ أَنَّ غَضَبَ ٱللَّهِ عَلَيۡهَآ إِن كَانَ مِنَ ٱلصَّٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "والخٰمسة ان غضب الله عليها ان كان من الصٰدقين" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2846" ;
