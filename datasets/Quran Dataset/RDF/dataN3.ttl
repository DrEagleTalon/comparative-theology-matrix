        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:5295  quran:ayah_text            "يَغۡفِرۡ لَكُمۡ ذُنُوبَكُمۡ وَيُدۡخِلۡكُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ وَمَسَٰكِنَ طَيِّبَةٗ فِي جَنَّٰتِ عَدۡنٖۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ" ;
        quran:ayah_text_no_diacratic   "يغفر لكم ذنوبكم ويدخلكم جنٰت تجري من تحتها الانهٰر ومسٰكن طيبة في جنٰت عدن ذٰلك الفوز العظيم" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5295" ;
        quran:page                     "552" ;
        quran:surahname                "سُورَةُ الصَّفِّ" ;
        quran:surahnumber              "61" ;
        quran:surrahname_no_diacratic  "سورة الصف" .

quran:2704  quran:ayah_text            "لِّكُلِّ أُمَّةٖ جَعَلۡنَا مَنسَكًا هُمۡ نَاسِكُوهُۖ فَلَا يُنَٰزِعُنَّكَ فِي ٱلۡأَمۡرِۚ وَٱدۡعُ إِلَىٰ رَبِّكَۖ إِنَّكَ لَعَلَىٰ هُدٗى مُّسۡتَقِيمٖ" ;
        quran:ayah_text_no_diacratic   "لكل امة جعلنا منسكا هم ناسكوه فلا ينٰزعنك في الامر وادع الىٰ ربك انك لعلىٰ هدى مستقيم" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "17" ;
        quran:hizb                     "34" ;
        quran:index                    "2704" ;
