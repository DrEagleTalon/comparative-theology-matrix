        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4296  quran:ayah_text            "فَلَمۡ يَكُ يَنفَعُهُمۡ إِيمَٰنُهُمۡ لَمَّا رَأَوۡاْ بَأۡسَنَاۖ سُنَّتَ ٱللَّهِ ٱلَّتِي قَدۡ خَلَتۡ فِي عِبَادِهِۦۖ وَخَسِرَ هُنَالِكَ ٱلۡكَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "فلم يك ينفعهم ايمٰنهم لما راوا باسنا سنت الله التي قد خلت في عباده وخسر هنالك الكٰفرون" ;
        quran:ayahnumber               "85" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4296" ;
        quran:page                     "476" ;
