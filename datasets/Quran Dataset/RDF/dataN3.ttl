quran:1007  quran:ayah_text            "إِنَّ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا وَٱسۡتَكۡبَرُواْ عَنۡهَا لَا تُفَتَّحُ لَهُمۡ أَبۡوَٰبُ ٱلسَّمَآءِ وَلَا يَدۡخُلُونَ ٱلۡجَنَّةَ حَتَّىٰ يَلِجَ ٱلۡجَمَلُ فِي سَمِّ ٱلۡخِيَاطِۚ وَكَذَٰلِكَ نَجۡزِي ٱلۡمُجۡرِمِينَ" ;
        quran:ayah_text_no_diacratic   "ان الذين كذبوا بايٰتنا واستكبروا عنها لا تفتح لهم ابوٰب السماء ولا يدخلون الجنة حتىٰ يلج الجمل في سم الخياط وكذٰلك نجزي المجرمين" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1007" ;
        quran:page                     "155" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:715  quran:ayah_text             "يُرِيدُونَ أَن يَخۡرُجُواْ مِنَ ٱلنَّارِ وَمَا هُم بِخَٰرِجِينَ مِنۡهَاۖ وَلَهُمۡ عَذَابٞ مُّقِيمٞ" ;
        quran:ayah_text_no_diacratic   "يريدون ان يخرجوا من النار وما هم بخٰرجين منها ولهم عذاب مقيم" ;
        quran:ayahnumber               "37" ;
