        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:1230  quran:ayah_text            "إِنَّ شَرَّ ٱلدَّوَآبِّ عِندَ ٱللَّهِ ٱلَّذِينَ كَفَرُواْ فَهُمۡ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "ان شر الدواب عند الله الذين كفروا فهم لا يؤمنون" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "10" ;
