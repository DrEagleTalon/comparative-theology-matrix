quran:4406  quran:ayah_text            "وَكَذَٰلِكَ أَوۡحَيۡنَآ إِلَيۡكَ رُوحٗا مِّنۡ أَمۡرِنَاۚ مَا كُنتَ تَدۡرِي مَا ٱلۡكِتَٰبُ وَلَا ٱلۡإِيمَٰنُ وَلَٰكِن جَعَلۡنَٰهُ نُورٗا نَّهۡدِي بِهِۦ مَن نَّشَآءُ مِنۡ عِبَادِنَاۚ وَإِنَّكَ لَتَهۡدِيٓ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك اوحينا اليك روحا من امرنا ما كنت تدري ما الكتٰب ولا الايمٰن ولٰكن جعلنٰه نورا نهدي به من نشاء من عبادنا وانك لتهدي الىٰ صرٰط مستقيم" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4406" ;
        quran:page                     "489" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:2168  quran:ayah_text            "قُلۡ ءَامِنُواْ بِهِۦٓ أَوۡ لَا تُؤۡمِنُوٓاْۚ إِنَّ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ مِن قَبۡلِهِۦٓ إِذَا يُتۡلَىٰ عَلَيۡهِمۡ يَخِرُّونَۤ لِلۡأَذۡقَانِۤ سُجَّدٗاۤ" ;
        quran:ayah_text_no_diacratic   "قل ءامنوا به او لا تؤمنوا ان الذين اوتوا العلم من قبله اذا يتلىٰ عليهم يخرون للاذقان سجدا" ;
        quran:ayahnumber               "107" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2168" ;
        quran:page                     "293" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3312  quran:ayah_text            "وَنُمَكِّنَ لَهُمۡ فِي ٱلۡأَرۡضِ وَنُرِيَ فِرۡعَوۡنَ وَهَٰمَٰنَ وَجُنُودَهُمَا مِنۡهُم مَّا كَانُواْ يَحۡذَرُونَ" ;
        quran:ayah_text_no_diacratic   "ونمكن لهم في الارض ونري فرعون وهٰمٰن وجنودهما منهم ما كانوا يحذرون" ;
