        quran:surrahname_no_diacratic  "سورة مريم" .

quran:4319  quran:ayah_text            "وَقَالُواْ لِجُلُودِهِمۡ لِمَ شَهِدتُّمۡ عَلَيۡنَاۖ قَالُوٓاْ أَنطَقَنَا ٱللَّهُ ٱلَّذِيٓ أَنطَقَ كُلَّ شَيۡءٖۚ وَهُوَ خَلَقَكُمۡ أَوَّلَ مَرَّةٖ وَإِلَيۡهِ تُرۡجَعُونَ" ;
        quran:ayah_text_no_diacratic   "وقالوا لجلودهم لم شهدتم علينا قالوا انطقنا الله الذي انطق كل شيء وهو خلقكم اول مرة واليه ترجعون" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4319" ;
        quran:page                     "479" ;
