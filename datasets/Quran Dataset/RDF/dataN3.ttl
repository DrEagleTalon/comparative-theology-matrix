        quran:index                    "3349" ;
        quran:page                     "390" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1351  quran:ayah_text            "وَٱلسَّٰبِقُونَ ٱلۡأَوَّلُونَ مِنَ ٱلۡمُهَٰجِرِينَ وَٱلۡأَنصَارِ وَٱلَّذِينَ ٱتَّبَعُوهُم بِإِحۡسَٰنٖ رَّضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُ وَأَعَدَّ لَهُمۡ جَنَّٰتٖ تَجۡرِي تَحۡتَهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ" ;
        quran:ayah_text_no_diacratic   "والسٰبقون الاولون من المهٰجرين والانصار والذين اتبعوهم باحسٰن رضي الله عنهم ورضوا عنه واعد لهم جنٰت تجري تحتها الانهٰر خٰلدين فيها ابدا ذٰلك الفوز العظيم" ;
        quran:ayahnumber               "100" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1351" ;
        quran:page                     "203" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2255  quran:ayah_text            "فَأَرَدۡنَآ أَن يُبۡدِلَهُمَا رَبُّهُمَا خَيۡرٗا مِّنۡهُ زَكَوٰةٗ وَأَقۡرَبَ رُحۡمٗا" ;
        quran:ayah_text_no_diacratic   "فاردنا ان يبدلهما ربهما خيرا منه زكوٰة واقرب رحما" ;
        quran:ayahnumber               "81" ;
