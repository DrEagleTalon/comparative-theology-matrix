quran:1350  quran:ayah_text            "وَمِنَ ٱلۡأَعۡرَابِ مَن يُؤۡمِنُ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَيَتَّخِذُ مَا يُنفِقُ قُرُبَٰتٍ عِندَ ٱللَّهِ وَصَلَوَٰتِ ٱلرَّسُولِۚ أَلَآ إِنَّهَا قُرۡبَةٞ لَّهُمۡۚ سَيُدۡخِلُهُمُ ٱللَّهُ فِي رَحۡمَتِهِۦٓۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "ومن الاعراب من يؤمن بالله واليوم الاخر ويتخذ ما ينفق قربٰت عند الله وصلوٰت الرسول الا انها قربة لهم سيدخلهم الله في رحمته ان الله غفور رحيم" ;
        quran:ayahnumber               "99" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1350" ;
        quran:page                     "202" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2254  quran:ayah_text            "وَأَمَّا ٱلۡغُلَٰمُ فَكَانَ أَبَوَاهُ مُؤۡمِنَيۡنِ فَخَشِينَآ أَن يُرۡهِقَهُمَا طُغۡيَٰنٗا وَكُفۡرٗا" ;
        quran:ayah_text_no_diacratic   "واما الغلٰم فكان ابواه مؤمنين فخشينا ان يرهقهما طغيٰنا وكفرا" ;
