quran:3619  quran:ayah_text            "وَلَمَّا رَءَا ٱلۡمُؤۡمِنُونَ ٱلۡأَحۡزَابَ قَالُواْ هَٰذَا مَا وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥ وَصَدَقَ ٱللَّهُ وَرَسُولُهُۥۚ وَمَا زَادَهُمۡ إِلَّآ إِيمَٰنٗا وَتَسۡلِيمٗا" ;
        quran:ayah_text_no_diacratic   "ولما رءا المؤمنون الاحزاب قالوا هٰذا ما وعدنا الله ورسوله وصدق الله ورسوله وما زادهم الا ايمٰنا وتسليما" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "21" ;
        quran:hizb                     "42" ;
        quran:index                    "3619" ;
        quran:page                     "420" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1621  quran:ayah_text            "نَحۡنُ نَقُصُّ عَلَيۡكَ أَحۡسَنَ ٱلۡقَصَصِ بِمَآ أَوۡحَيۡنَآ إِلَيۡكَ هَٰذَا ٱلۡقُرۡءَانَ وَإِن كُنتَ مِن قَبۡلِهِۦ لَمِنَ ٱلۡغَٰفِلِينَ" ;
        quran:ayah_text_no_diacratic   "نحن نقص عليك احسن القصص بما اوحينا اليك هٰذا القرءان وان كنت من قبله لمن الغٰفلين" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1621" ;
        quran:page                     "235" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2525  quran:ayah_text            "مَا يَأۡتِيهِم مِّن ذِكۡرٖ مِّن رَّبِّهِم مُّحۡدَثٍ إِلَّا ٱسۡتَمَعُوهُ وَهُمۡ يَلۡعَبُونَ" ;
        quran:ayah_text_no_diacratic   "ما ياتيهم من ذكر من ربهم محدث الا استمعوه وهم يلعبون" ;
        quran:ayahnumber               "2" ;
