quran:2020  quran:ayah_text            "وَيَوۡمَ نَبۡعَثُ فِي كُلِّ أُمَّةٖ شَهِيدًا عَلَيۡهِم مِّنۡ أَنفُسِهِمۡۖ وَجِئۡنَا بِكَ شَهِيدًا عَلَىٰ هَٰٓؤُلَآءِۚ وَنَزَّلۡنَا عَلَيۡكَ ٱلۡكِتَٰبَ تِبۡيَٰنٗا لِّكُلِّ شَيۡءٖ وَهُدٗى وَرَحۡمَةٗ وَبُشۡرَىٰ لِلۡمُسۡلِمِينَ" ;
        quran:ayah_text_no_diacratic   "ويوم نبعث في كل امة شهيدا عليهم من انفسهم وجئنا بك شهيدا علىٰ هٰؤلاء ونزلنا عليك الكتٰب تبيٰنا لكل شيء وهدى ورحمة وبشرىٰ للمسلمين" ;
        quran:ayahnumber               "89" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2020" ;
        quran:page                     "277" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
