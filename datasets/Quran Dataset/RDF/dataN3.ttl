quran:4652  quran:ayah_text            "مَّثَلُ ٱلۡجَنَّةِ ٱلَّتِي وُعِدَ ٱلۡمُتَّقُونَۖ فِيهَآ أَنۡهَٰرٞ مِّن مَّآءٍ غَيۡرِ ءَاسِنٖ وَأَنۡهَٰرٞ مِّن لَّبَنٖ لَّمۡ يَتَغَيَّرۡ طَعۡمُهُۥ وَأَنۡهَٰرٞ مِّنۡ خَمۡرٖ لَّذَّةٖ لِّلشَّٰرِبِينَ وَأَنۡهَٰرٞ مِّنۡ عَسَلٖ مُّصَفّٗىۖ وَلَهُمۡ فِيهَا مِن كُلِّ ٱلثَّمَرَٰتِ وَمَغۡفِرَةٞ مِّن رَّبِّهِمۡۖ كَمَنۡ هُوَ خَٰلِدٞ فِي ٱلنَّارِ وَسُقُواْ مَآءً حَمِيمٗا فَقَطَّعَ أَمۡعَآءَهُمۡ" ;
        quran:ayah_text_no_diacratic   "مثل الجنة التي وعد المتقون فيها انهٰر من ماء غير ءاسن وانهٰر من لبن لم يتغير طعمه وانهٰر من خمر لذة للشٰربين وانهٰر من عسل مصفى ولهم فيها من كل الثمرٰت ومغفرة من ربهم كمن هو خٰلد في النار وسقوا ماء حميما فقطع امعاءهم" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4652" ;
        quran:page                     "508" ;
        quran:surahname                "سُورَةُ مُحَمَّدٍ" ;
        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:5556  quran:ayah_text            "يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعٗا كَأَنَّهُمۡ إِلَىٰ نُصُبٖ يُوفِضُونَ" ;
