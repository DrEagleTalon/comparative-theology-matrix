        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2012  quran:ayah_text            "وَٱللَّهُ جَعَلَ لَكُم مِّمَّا خَلَقَ ظِلَٰلٗا وَجَعَلَ لَكُم مِّنَ ٱلۡجِبَالِ أَكۡنَٰنٗا وَجَعَلَ لَكُمۡ سَرَٰبِيلَ تَقِيكُمُ ٱلۡحَرَّ وَسَرَٰبِيلَ تَقِيكُم بَأۡسَكُمۡۚ كَذَٰلِكَ يُتِمُّ نِعۡمَتَهُۥ عَلَيۡكُمۡ لَعَلَّكُمۡ تُسۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "والله جعل لكم مما خلق ظلٰلا وجعل لكم من الجبال اكنٰنا وجعل لكم سرٰبيل تقيكم الحر وسرٰبيل تقيكم باسكم كذٰلك يتم نعمته عليكم لعلكم تسلمون" ;
        quran:ayahnumber               "81" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2012" ;
        quran:page                     "276" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:386  quran:ayah_text             "خَٰلِدِينَ فِيهَا لَا يُخَفَّفُ عَنۡهُمُ ٱلۡعَذَابُ وَلَا هُمۡ يُنظَرُونَ" ;
        quran:ayah_text_no_diacratic   "خٰلدين فيها لا يخفف عنهم العذاب ولا هم ينظرون" ;
