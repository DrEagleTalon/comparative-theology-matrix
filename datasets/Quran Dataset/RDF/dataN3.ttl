quran:1229  quran:ayah_text            "كَدَأۡبِ ءَالِ فِرۡعَوۡنَ وَٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَذَّبُواْ بِـَٔايَٰتِ رَبِّهِمۡ فَأَهۡلَكۡنَٰهُم بِذُنُوبِهِمۡ وَأَغۡرَقۡنَآ ءَالَ فِرۡعَوۡنَۚ وَكُلّٞ كَانُواْ ظَٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "كداب ءال فرعون والذين من قبلهم كذبوا بايٰت ربهم فاهلكنٰهم بذنوبهم واغرقنا ءال فرعون وكل كانوا ظٰلمين" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1229" ;
        quran:page                     "184" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:937  quran:ayah_text             "وَكَذَٰلِكَ زَيَّنَ لِكَثِيرٖ مِّنَ ٱلۡمُشۡرِكِينَ قَتۡلَ أَوۡلَٰدِهِمۡ شُرَكَآؤُهُمۡ لِيُرۡدُوهُمۡ وَلِيَلۡبِسُواْ عَلَيۡهِمۡ دِينَهُمۡۖ وَلَوۡ شَآءَ ٱللَّهُ مَا فَعَلُوهُۖ فَذَرۡهُمۡ وَمَا يَفۡتَرُونَ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك زين لكثير من المشركين قتل اولٰدهم شركاؤهم ليردوهم وليلبسوا عليهم دينهم ولو شاء الله ما فعلوه فذرهم وما يفترون" ;
        quran:ayahnumber               "137" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "937" ;
        quran:page                     "145" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1039  quran:ayah_text            "فَأَنجَيۡنَٰهُ وَٱلَّذِينَ مَعَهُۥ بِرَحۡمَةٖ مِّنَّا وَقَطَعۡنَا دَابِرَ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَاۖ وَمَا كَانُواْ مُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "فانجينٰه والذين معه برحمة منا وقطعنا دابر الذين كذبوا بايٰتنا وما كانوا مؤمنين" ;
        quran:ayahnumber               "72" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1039" ;
        quran:page                     "159" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:747  quran:ayah_text             "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَٱلَّذِينَ هَادُواْ وَٱلصَّٰبِـُٔونَ وَٱلنَّصَٰرَىٰ مَنۡ ءَامَنَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَعَمِلَ صَٰلِحٗا فَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ" ;
        quran:ayah_text_no_diacratic   "ان الذين ءامنوا والذين هادوا والصٰبون والنصٰرىٰ من ءامن بالله واليوم الاخر وعمل صٰلحا فلا خوف عليهم ولا هم يحزنون" ;
        quran:ayahnumber               "69" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "747" ;
        quran:page                     "119" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:557  quran:ayah_text             "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ سَنُدۡخِلُهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ لَّهُمۡ فِيهَآ أَزۡوَٰجٞ مُّطَهَّرَةٞۖ وَنُدۡخِلُهُمۡ ظِلّٗا ظَلِيلًا" ;
        quran:ayah_text_no_diacratic   "والذين ءامنوا وعملوا الصٰلحٰت سندخلهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها ابدا لهم فيها ازوٰج مطهرة وندخلهم ظلا ظليلا" ;
        quran:ayahnumber               "57" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "557" ;
        quran:page                     "87" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4992  quran:ayah_text            "وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ لِلذِّكۡرِ فَهَلۡ مِن مُّدَّكِرٖ" ;
