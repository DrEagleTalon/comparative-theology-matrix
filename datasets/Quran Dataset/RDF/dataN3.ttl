        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2311  quran:ayah_text            "وَهُزِّيٓ إِلَيۡكِ بِجِذۡعِ ٱلنَّخۡلَةِ تُسَٰقِطۡ عَلَيۡكِ رُطَبٗا جَنِيّٗا" ;
        quran:ayah_text_no_diacratic   "وهزي اليك بجذع النخلة تسٰقط عليك رطبا جنيا" ;
