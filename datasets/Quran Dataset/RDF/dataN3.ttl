        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2017  quran:ayah_text            "وَإِذَا رَءَا ٱلَّذِينَ أَشۡرَكُواْ شُرَكَآءَهُمۡ قَالُواْ رَبَّنَا هَٰٓؤُلَآءِ شُرَكَآؤُنَا ٱلَّذِينَ كُنَّا نَدۡعُواْ مِن دُونِكَۖ فَأَلۡقَوۡاْ إِلَيۡهِمُ ٱلۡقَوۡلَ إِنَّكُمۡ لَكَٰذِبُونَ" ;
        quran:ayah_text_no_diacratic   "واذا رءا الذين اشركوا شركاءهم قالوا ربنا هٰؤلاء شركاؤنا الذين كنا ندعوا من دونك فالقوا اليهم القول انكم لكٰذبون" ;
        quran:ayahnumber               "86" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2017" ;
        quran:page                     "276" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:631  quran:ayah_text             "وَلِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ وَلَقَدۡ وَصَّيۡنَا ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ مِن قَبۡلِكُمۡ وَإِيَّاكُمۡ أَنِ ٱتَّقُواْ ٱللَّهَۚ وَإِن تَكۡفُرُواْ فَإِنَّ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ وَكَانَ ٱللَّهُ غَنِيًّا حَمِيدٗا" ;
        quran:ayah_text_no_diacratic   "ولله ما في السمٰوٰت وما في الارض ولقد وصينا الذين اوتوا الكتٰب من قبلكم واياكم ان اتقوا الله وان تكفروا فان لله ما في السمٰوٰت وما في الارض وكان الله غنيا حميدا" ;
        quran:ayahnumber               "131" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "631" ;
        quran:page                     "99" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:441  quran:ayah_text             "وَلَقَدۡ كُنتُمۡ تَمَنَّوۡنَ ٱلۡمَوۡتَ مِن قَبۡلِ أَن تَلۡقَوۡهُ فَقَدۡ رَأَيۡتُمُوهُ وَأَنتُمۡ تَنظُرُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد كنتم تمنون الموت من قبل ان تلقوه فقد رايتموه وانتم تنظرون" ;
