quran:1555  quran:ayah_text            "قَالُواْ يَٰصَٰلِحُ قَدۡ كُنتَ فِينَا مَرۡجُوّٗا قَبۡلَ هَٰذَآۖ أَتَنۡهَىٰنَآ أَن نَّعۡبُدَ مَا يَعۡبُدُ ءَابَآؤُنَا وَإِنَّنَا لَفِي شَكّٖ مِّمَّا تَدۡعُونَآ إِلَيۡهِ مُرِيبٖ" ;
        quran:ayah_text_no_diacratic   "قالوا يٰصٰلح قد كنت فينا مرجوا قبل هٰذا اتنهىٰنا ان نعبد ما يعبد ءاباؤنا واننا لفي شك مما تدعونا اليه مريب" ;
        quran:ayahnumber               "62" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1555" ;
