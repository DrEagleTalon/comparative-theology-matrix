        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:1788  quran:ayah_text            "وَمَا لَنَآ أَلَّا نَتَوَكَّلَ عَلَى ٱللَّهِ وَقَدۡ هَدَىٰنَا سُبُلَنَاۚ وَلَنَصۡبِرَنَّ عَلَىٰ مَآ ءَاذَيۡتُمُونَاۚ وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ ٱلۡمُتَوَكِّلُونَ" ;
        quran:ayah_text_no_diacratic   "وما لنا الا نتوكل على الله وقد هدىٰنا سبلنا ولنصبرن علىٰ ما ءاذيتمونا وعلى الله فليتوكل المتوكلون" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1788" ;
        quran:page                     "257" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:2932  quran:ayah_text            "لَّقَدۡ أَضَلَّنِي عَنِ ٱلذِّكۡرِ بَعۡدَ إِذۡ جَآءَنِيۗ وَكَانَ ٱلشَّيۡطَٰنُ لِلۡإِنسَٰنِ خَذُولٗا" ;
        quran:ayah_text_no_diacratic   "لقد اضلني عن الذكر بعد اذ جاءني وكان الشيطٰن للانسٰن خذولا" ;
