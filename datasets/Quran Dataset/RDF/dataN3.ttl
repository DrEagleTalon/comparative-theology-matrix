quran:2007  quran:ayah_text            "وَضَرَبَ ٱللَّهُ مَثَلٗا رَّجُلَيۡنِ أَحَدُهُمَآ أَبۡكَمُ لَا يَقۡدِرُ عَلَىٰ شَيۡءٖ وَهُوَ كَلٌّ عَلَىٰ مَوۡلَىٰهُ أَيۡنَمَا يُوَجِّههُّ لَا يَأۡتِ بِخَيۡرٍ هَلۡ يَسۡتَوِي هُوَ وَمَن يَأۡمُرُ بِٱلۡعَدۡلِ وَهُوَ عَلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ" ;
        quran:ayah_text_no_diacratic   "وضرب الله مثلا رجلين احدهما ابكم لا يقدر علىٰ شيء وهو كل علىٰ مولىٰه اينما يوجهه لا يات بخير هل يستوي هو ومن يامر بالعدل وهو علىٰ صرٰط مستقيم" ;
        quran:ayahnumber               "76" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2007" ;
        quran:page                     "275" ;
