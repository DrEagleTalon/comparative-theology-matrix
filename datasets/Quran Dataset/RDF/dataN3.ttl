        quran:surahnumber              "76" ;
        quran:surrahname_no_diacratic  "سورة الانسان" .

quran:2929  quran:ayah_text            "ٱلۡمُلۡكُ يَوۡمَئِذٍ ٱلۡحَقُّ لِلرَّحۡمَٰنِۚ وَكَانَ يَوۡمًا عَلَى ٱلۡكَٰفِرِينَ عَسِيرٗا" ;
        quran:ayah_text_no_diacratic   "الملك يومئذ الحق للرحمٰن وكان يوما على الكٰفرين عسيرا" ;
