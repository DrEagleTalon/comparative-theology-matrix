        quran:surahnumber              "83" ;
        quran:surrahname_no_diacratic  "سورة المطففين" .

quran:81  quran:ayah_text              "قَالَ إِنَّهُۥ يَقُولُ إِنَّهَا بَقَرَةٞ لَّا ذَلُولٞ تُثِيرُ ٱلۡأَرۡضَ وَلَا تَسۡقِي ٱلۡحَرۡثَ مُسَلَّمَةٞ لَّا شِيَةَ فِيهَاۚ قَالُواْ ٱلۡـَٰٔنَ جِئۡتَ بِٱلۡحَقِّۚ فَذَبَحُوهَا وَمَا كَادُواْ يَفۡعَلُونَ" ;
        quran:ayah_text_no_diacratic   "قال انه يقول انها بقرة لا ذلول تثير الارض ولا تسقي الحرث مسلمة لا شية فيها قالوا الٰن جئت بالحق فذبحوها وما كادوا يفعلون" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "81" ;
        quran:page                     "11" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1212  quran:ayah_text            "لِيَمِيزَ ٱللَّهُ ٱلۡخَبِيثَ مِنَ ٱلطَّيِّبِ وَيَجۡعَلَ ٱلۡخَبِيثَ بَعۡضَهُۥ عَلَىٰ بَعۡضٖ فَيَرۡكُمَهُۥ جَمِيعٗا فَيَجۡعَلَهُۥ فِي جَهَنَّمَۚ أُوْلَٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ" ;
        quran:ayah_text_no_diacratic   "ليميز الله الخبيث من الطيب ويجعل الخبيث بعضه علىٰ بعض فيركمه جميعا فيجعله في جهنم اولٰئك هم الخٰسرون" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1212" ;
        quran:page                     "181" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:920  quran:ayah_text             "وَذَرُواْ ظَٰهِرَ ٱلۡإِثۡمِ وَبَاطِنَهُۥٓۚ إِنَّ ٱلَّذِينَ يَكۡسِبُونَ ٱلۡإِثۡمَ سَيُجۡزَوۡنَ بِمَا كَانُواْ يَقۡتَرِفُونَ" ;
        quran:ayah_text_no_diacratic   "وذروا ظٰهر الاثم وباطنه ان الذين يكسبون الاثم سيجزون بما كانوا يقترفون" ;
        quran:ayahnumber               "120" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "920" ;
        quran:page                     "143" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2116  quran:ayah_text            "وَرَبُّكَ أَعۡلَمُ بِمَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ وَلَقَدۡ فَضَّلۡنَا بَعۡضَ ٱلنَّبِيِّـۧنَ عَلَىٰ بَعۡضٖۖ وَءَاتَيۡنَا دَاوُۥدَ زَبُورٗا" ;
        quran:ayah_text_no_diacratic   "وربك اعلم بمن في السمٰوٰت والارض ولقد فضلنا بعض النبين علىٰ بعض وءاتينا داود زبورا" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2116" ;
        quran:page                     "287" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1022  quran:ayah_text            "ٱدۡعُواْ رَبَّكُمۡ تَضَرُّعٗا وَخُفۡيَةًۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡمُعۡتَدِينَ" ;
        quran:ayah_text_no_diacratic   "ادعوا ربكم تضرعا وخفية انه لا يحب المعتدين" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1022" ;
        quran:page                     "157" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:730  quran:ayah_text             "فَتَرَى ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ يُسَٰرِعُونَ فِيهِمۡ يَقُولُونَ نَخۡشَىٰٓ أَن تُصِيبَنَا دَآئِرَةٞۚ فَعَسَى ٱللَّهُ أَن يَأۡتِيَ بِٱلۡفَتۡحِ أَوۡ أَمۡرٖ مِّنۡ عِندِهِۦ فَيُصۡبِحُواْ عَلَىٰ مَآ أَسَرُّواْ فِيٓ أَنفُسِهِمۡ نَٰدِمِينَ" ;
        quran:ayah_text_no_diacratic   "فترى الذين في قلوبهم مرض يسٰرعون فيهم يقولون نخشىٰ ان تصيبنا دائرة فعسى الله ان ياتي بالفتح او امر من عنده فيصبحوا علىٰ ما اسروا في انفسهم نٰدمين" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "730" ;
        quran:page                     "117" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:540  quran:ayah_text             "إِنَّ ٱللَّهَ لَا يَظۡلِمُ مِثۡقَالَ ذَرَّةٖۖ وَإِن تَكُ حَسَنَةٗ يُضَٰعِفۡهَا وَيُؤۡتِ مِن لَّدُنۡهُ أَجۡرًا عَظِيمٗا" ;
        quran:ayah_text_no_diacratic   "ان الله لا يظلم مثقال ذرة وان تك حسنة يضٰعفها ويؤت من لدنه اجرا عظيما" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "540" ;
        quran:page                     "85" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:350  quran:ayah_text             "۞فَلَمَّآ أَحَسَّ عِيسَىٰ مِنۡهُمُ ٱلۡكُفۡرَ قَالَ مَنۡ أَنصَارِيٓ إِلَى ٱللَّهِۖ قَالَ ٱلۡحَوَارِيُّونَ نَحۡنُ أَنصَارُ ٱللَّهِ ءَامَنَّا بِٱللَّهِ وَٱشۡهَدۡ بِأَنَّا مُسۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "فلما احس عيسىٰ منهم الكفر قال من انصاري الى الله قال الحواريون نحن انصار الله ءامنا بالله واشهد بانا مسلمون" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "350" ;
        quran:page                     "56" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:160  quran:ayah_text             "وَمِنۡ حَيۡثُ خَرَجۡتَ فَوَلِّ وَجۡهَكَ شَطۡرَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِۚ وَحَيۡثُ مَا كُنتُمۡ فَوَلُّواْ وُجُوهَكُمۡ شَطۡرَهُۥ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيۡكُمۡ حُجَّةٌ إِلَّا ٱلَّذِينَ ظَلَمُواْ مِنۡهُمۡ فَلَا تَخۡشَوۡهُمۡ وَٱخۡشَوۡنِي وَلِأُتِمَّ نِعۡمَتِي عَلَيۡكُمۡ وَلَعَلَّكُمۡ تَهۡتَدُونَ" ;
        quran:ayah_text_no_diacratic   "ومن حيث خرجت فول وجهك شطر المسجد الحرام وحيث ما كنتم فولوا وجوهكم شطره لئلا يكون للناس عليكم حجة الا الذين ظلموا منهم فلا تخشوهم واخشوني ولاتم نعمتي عليكم ولعلكم تهتدون" ;
        quran:ayahnumber               "150" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "160" ;
        quran:page                     "23" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1954  quran:ayah_text            "لَا جَرَمَ أَنَّ ٱللَّهَ يَعۡلَمُ مَا يُسِرُّونَ وَمَا يُعۡلِنُونَۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡمُسۡتَكۡبِرِينَ" ;
        quran:ayah_text_no_diacratic   "لا جرم ان الله يعلم ما يسرون وما يعلنون انه لا يحب المستكبرين" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1954" ;
        quran:page                     "269" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2858  quran:ayah_text            "۞يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّبِعُواْ خُطُوَٰتِ ٱلشَّيۡطَٰنِۚ وَمَن يَتَّبِعۡ خُطُوَٰتِ ٱلشَّيۡطَٰنِ فَإِنَّهُۥ يَأۡمُرُ بِٱلۡفَحۡشَآءِ وَٱلۡمُنكَرِۚ وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ مَا زَكَىٰ مِنكُم مِّنۡ أَحَدٍ أَبَدٗا وَلَٰكِنَّ ٱللَّهَ يُزَكِّي مَن يَشَآءُۗ وَٱللَّهُ سَمِيعٌ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا تتبعوا خطوٰت الشيطٰن ومن يتبع خطوٰت الشيطٰن فانه يامر بالفحشاء والمنكر ولولا فضل الله عليكم ورحمته ما زكىٰ منكم من احد ابدا ولٰكن الله يزكي من يشاء والله سميع عليم" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "18" ;
