quran:1501  quran:ayah_text            "وَلَئِنۡ أَخَّرۡنَا عَنۡهُمُ ٱلۡعَذَابَ إِلَىٰٓ أُمَّةٖ مَّعۡدُودَةٖ لَّيَقُولُنَّ مَا يَحۡبِسُهُۥٓۗ أَلَا يَوۡمَ يَأۡتِيهِمۡ لَيۡسَ مَصۡرُوفًا عَنۡهُمۡ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ" ;
        quran:ayah_text_no_diacratic   "ولئن اخرنا عنهم العذاب الىٰ امة معدودة ليقولن ما يحبسه الا يوم ياتيهم ليس مصروفا عنهم وحاق بهم ما كانوا به يستهزءون" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "12" ;
        quran:hizb                     "22" ;
        quran:index                    "1501" ;
        quran:page                     "222" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:969  quran:ayah_text             "كِتَٰبٌ أُنزِلَ إِلَيۡكَ فَلَا يَكُن فِي صَدۡرِكَ حَرَجٞ مِّنۡهُ لِتُنذِرَ بِهِۦ وَذِكۡرَىٰ لِلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "كتٰب انزل اليك فلا يكن في صدرك حرج منه لتنذر به وذكرىٰ للمؤمنين" ;
        quran:ayahnumber               "2" ;
