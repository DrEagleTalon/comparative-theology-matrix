        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:860  quran:ayah_text             "وَهُوَ ٱلَّذِي يَتَوَفَّىٰكُم بِٱلَّيۡلِ وَيَعۡلَمُ مَا جَرَحۡتُم بِٱلنَّهَارِ ثُمَّ يَبۡعَثُكُمۡ فِيهِ لِيُقۡضَىٰٓ أَجَلٞ مُّسَمّٗىۖ ثُمَّ إِلَيۡهِ مَرۡجِعُكُمۡ ثُمَّ يُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "وهو الذي يتوفىٰكم باليل ويعلم ما جرحتم بالنهار ثم يبعثكم فيه ليقضىٰ اجل مسمى ثم اليه مرجعكم ثم ينبئكم بما كنتم تعملون" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "860" ;
        quran:page                     "135" ;
