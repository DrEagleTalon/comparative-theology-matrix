        quran:surahnumber              "87" ;
        quran:surrahname_no_diacratic  "سورة الاعلىٰ" .

quran:1307  quran:ayah_text            "وَيَحۡلِفُونَ بِٱللَّهِ إِنَّهُمۡ لَمِنكُمۡ وَمَا هُم مِّنكُمۡ وَلَٰكِنَّهُمۡ قَوۡمٞ يَفۡرَقُونَ" ;
        quran:ayah_text_no_diacratic   "ويحلفون بالله انهم لمنكم وما هم منكم ولٰكنهم قوم يفرقون" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1307" ;
        quran:page                     "196" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:5042  quran:ayah_text            "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ" ;
        quran:ayah_text_no_diacratic   "يٰمعشر الجن والانس ان استطعتم ان تنفذوا من اقطار السمٰوٰت والارض فانفذوا لا تنفذون الا بسلطٰن" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "27" ;
        quran:hizb                     "53" ;
        quran:index                    "5042" ;
        quran:page                     "532" ;
        quran:surahname                "سُورَةُ الرَّحۡمَٰن" ;
        quran:surahnumber              "55" ;
        quran:surrahname_no_diacratic  "سورة الرحمٰن" .

quran:1117  quran:ayah_text            "وَلَمَّا رَجَعَ مُوسَىٰٓ إِلَىٰ قَوۡمِهِۦ غَضۡبَٰنَ أَسِفٗا قَالَ بِئۡسَمَا خَلَفۡتُمُونِي مِنۢ بَعۡدِيٓۖ أَعَجِلۡتُمۡ أَمۡرَ رَبِّكُمۡۖ وَأَلۡقَى ٱلۡأَلۡوَاحَ وَأَخَذَ بِرَأۡسِ أَخِيهِ يَجُرُّهُۥٓ إِلَيۡهِۚ قَالَ ٱبۡنَ أُمَّ إِنَّ ٱلۡقَوۡمَ ٱسۡتَضۡعَفُونِي وَكَادُواْ يَقۡتُلُونَنِي فَلَا تُشۡمِتۡ بِيَ ٱلۡأَعۡدَآءَ وَلَا تَجۡعَلۡنِي مَعَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "ولما رجع موسىٰ الىٰ قومه غضبٰن اسفا قال بئسما خلفتموني من بعدي اعجلتم امر ربكم والقى الالواح واخذ براس اخيه يجره اليه قال ابن ام ان القوم استضعفوني وكادوا يقتلونني فلا تشمت بي الاعداء ولا تجعلني مع القوم الظٰلمين" ;
        quran:ayahnumber               "150" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1117" ;
        quran:page                     "169" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:825  quran:ayah_text             "وَمِنۡهُم مَّن يَسۡتَمِعُ إِلَيۡكَۖ وَجَعَلۡنَا عَلَىٰ قُلُوبِهِمۡ أَكِنَّةً أَن يَفۡقَهُوهُ وَفِيٓ ءَاذَانِهِمۡ وَقۡرٗاۚ وَإِن يَرَوۡاْ كُلَّ ءَايَةٖ لَّا يُؤۡمِنُواْ بِهَاۖ حَتَّىٰٓ إِذَا جَآءُوكَ يُجَٰدِلُونَكَ يَقُولُ ٱلَّذِينَ كَفَرُوٓاْ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "ومنهم من يستمع اليك وجعلنا علىٰ قلوبهم اكنة ان يفقهوه وفي ءاذانهم وقرا وان يروا كل ءاية لا يؤمنوا بها حتىٰ اذا جاءوك يجٰدلونك يقول الذين كفروا ان هٰذا الا اسٰطير الاولين" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "825" ;
        quran:page                     "130" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:635  quran:ayah_text             "۞يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُونُواْ قَوَّٰمِينَ بِٱلۡقِسۡطِ شُهَدَآءَ لِلَّهِ وَلَوۡ عَلَىٰٓ أَنفُسِكُمۡ أَوِ ٱلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَۚ إِن يَكُنۡ غَنِيًّا أَوۡ فَقِيرٗا فَٱللَّهُ أَوۡلَىٰ بِهِمَاۖ فَلَا تَتَّبِعُواْ ٱلۡهَوَىٰٓ أَن تَعۡدِلُواْۚ وَإِن تَلۡوُۥٓاْ أَوۡ تُعۡرِضُواْ فَإِنَّ ٱللَّهَ كَانَ بِمَا تَعۡمَلُونَ خَبِيرٗا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا كونوا قوٰمين بالقسط شهداء لله ولو علىٰ انفسكم او الوٰلدين والاقربين ان يكن غنيا او فقيرا فالله اولىٰ بهما فلا تتبعوا الهوىٰ ان تعدلوا وان تلوا او تعرضوا فان الله كان بما تعملون خبيرا" ;
        quran:ayahnumber               "135" ;
        quran:chapter                  "5" ;
        quran:hizb                     "10" ;
        quran:index                    "635" ;
        quran:page                     "100" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:445  quran:ayah_text             "وَمَا كَانَ قَوۡلَهُمۡ إِلَّآ أَن قَالُواْ رَبَّنَا ٱغۡفِرۡ لَنَا ذُنُوبَنَا وَإِسۡرَافَنَا فِيٓ أَمۡرِنَا وَثَبِّتۡ أَقۡدَامَنَا وَٱنصُرۡنَا عَلَى ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "وما كان قولهم الا ان قالوا ربنا اغفر لنا ذنوبنا واسرافنا في امرنا وثبت اقدامنا وانصرنا على القوم الكٰفرين" ;
        quran:ayahnumber               "147" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "445" ;
        quran:page                     "68" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5974  quran:ayah_text            "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ" ;
        quran:ayah_text_no_diacratic   "علمت نفس ما احضرت" ;
        quran:ayahnumber               "14" ;
