quran:503  quran:ayah_text             "وَإِنۡ خِفۡتُمۡ أَلَّا تُقۡسِطُواْ فِي ٱلۡيَتَٰمَىٰ فَٱنكِحُواْ مَا طَابَ لَكُم مِّنَ ٱلنِّسَآءِ مَثۡنَىٰ وَثُلَٰثَ وَرُبَٰعَۖ فَإِنۡ خِفۡتُمۡ أَلَّا تَعۡدِلُواْ فَوَٰحِدَةً أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُكُمۡۚ ذَٰلِكَ أَدۡنَىٰٓ أَلَّا تَعُولُواْ" ;
        quran:ayah_text_no_diacratic   "وان خفتم الا تقسطوا في اليتٰمىٰ فانكحوا ما طاب لكم من النساء مثنىٰ وثلٰث وربٰع فان خفتم الا تعدلوا فوٰحدة او ما ملكت ايمٰنكم ذٰلك ادنىٰ الا تعولوا" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "503" ;
        quran:page                     "77" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:3794  quran:ayah_text            "قَالُواْ طَٰٓئِرُكُم مَّعَكُمۡ أَئِن ذُكِّرۡتُمۚ بَلۡ أَنتُمۡ قَوۡمٞ مُّسۡرِفُونَ" ;
        quran:ayah_text_no_diacratic   "قالوا طٰئركم معكم ائن ذكرتم بل انتم قوم مسرفون" ;
