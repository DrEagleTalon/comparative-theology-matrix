quran:782  quran:ayah_text             "وَإِذَا قِيلَ لَهُمۡ تَعَالَوۡاْ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ قَالُواْ حَسۡبُنَا مَا وَجَدۡنَا عَلَيۡهِ ءَابَآءَنَآۚ أَوَلَوۡ كَانَ ءَابَآؤُهُمۡ لَا يَعۡلَمُونَ شَيۡـٔٗا وَلَا يَهۡتَدُونَ" ;
        quran:ayah_text_no_diacratic   "واذا قيل لهم تعالوا الىٰ ما انزل الله والى الرسول قالوا حسبنا ما وجدنا عليه ءاباءنا اولو كان ءاباؤهم لا يعلمون شيا ولا يهتدون" ;
        quran:ayahnumber               "104" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "782" ;
        quran:page                     "125" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:4216  quran:ayah_text            "كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحٖ وَٱلۡأَحۡزَابُ مِنۢ بَعۡدِهِمۡۖ وَهَمَّتۡ كُلُّ أُمَّةِۭ بِرَسُولِهِمۡ لِيَأۡخُذُوهُۖ وَجَٰدَلُواْ بِٱلۡبَٰطِلِ لِيُدۡحِضُواْ بِهِ ٱلۡحَقَّ فَأَخَذۡتُهُمۡۖ فَكَيۡفَ كَانَ عِقَابِ" ;
        quran:ayah_text_no_diacratic   "كذبت قبلهم قوم نوح والاحزاب من بعدهم وهمت كل امة برسولهم لياخذوه وجٰدلوا بالبٰطل ليدحضوا به الحق فاخذتهم فكيف كان عقاب" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "24" ;
        quran:hizb                     "46" ;
        quran:index                    "4216" ;
        quran:page                     "467" ;
        quran:surahname                "سُورَةُ غَافِرٍ" ;
        quran:surahnumber              "40" ;
        quran:surrahname_no_diacratic  "سورة غافر" .

quran:3122  quran:ayah_text            "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ" ;
