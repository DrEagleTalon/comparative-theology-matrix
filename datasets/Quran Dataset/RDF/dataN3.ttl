        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:756  quran:ayah_text             "لُعِنَ ٱلَّذِينَ كَفَرُواْ مِنۢ بَنِيٓ إِسۡرَٰٓءِيلَ عَلَىٰ لِسَانِ دَاوُۥدَ وَعِيسَى ٱبۡنِ مَرۡيَمَۚ ذَٰلِكَ بِمَا عَصَواْ وَّكَانُواْ يَعۡتَدُونَ" ;
        quran:ayah_text_no_diacratic   "لعن الذين كفروا من بني اسرٰءيل علىٰ لسان داود وعيسى ابن مريم ذٰلك بما عصوا وكانوا يعتدون" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "756" ;
        quran:page                     "121" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:566  quran:ayah_text             "وَلَوۡ أَنَّا كَتَبۡنَا عَلَيۡهِمۡ أَنِ ٱقۡتُلُوٓاْ أَنفُسَكُمۡ أَوِ ٱخۡرُجُواْ مِن دِيَٰرِكُم مَّا فَعَلُوهُ إِلَّا قَلِيلٞ مِّنۡهُمۡۖ وَلَوۡ أَنَّهُمۡ فَعَلُواْ مَا يُوعَظُونَ بِهِۦ لَكَانَ خَيۡرٗا لَّهُمۡ وَأَشَدَّ تَثۡبِيتٗا" ;
        quran:ayah_text_no_diacratic   "ولو انا كتبنا عليهم ان اقتلوا انفسكم او اخرجوا من ديٰركم ما فعلوه الا قليل منهم ولو انهم فعلوا ما يوعظون به لكان خيرا لهم واشد تثبيتا" ;
        quran:ayahnumber               "66" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "566" ;
        quran:page                     "89" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2002  quran:ayah_text            "وَٱللَّهُ فَضَّلَ بَعۡضَكُمۡ عَلَىٰ بَعۡضٖ فِي ٱلرِّزۡقِۚ فَمَا ٱلَّذِينَ فُضِّلُواْ بِرَآدِّي رِزۡقِهِمۡ عَلَىٰ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَهُمۡ فِيهِ سَوَآءٌۚ أَفَبِنِعۡمَةِ ٱللَّهِ يَجۡحَدُونَ" ;
        quran:ayah_text_no_diacratic   "والله فضل بعضكم علىٰ بعض في الرزق فما الذين فضلوا برادي رزقهم علىٰ ما ملكت ايمٰنهم فهم فيه سواء افبنعمة الله يجحدون" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2002" ;
        quran:page                     "274" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:376  quran:ayah_text             "وَإِنَّ مِنۡهُمۡ لَفَرِيقٗا يَلۡوُۥنَ أَلۡسِنَتَهُم بِٱلۡكِتَٰبِ لِتَحۡسَبُوهُ مِنَ ٱلۡكِتَٰبِ وَمَا هُوَ مِنَ ٱلۡكِتَٰبِ وَيَقُولُونَ هُوَ مِنۡ عِندِ ٱللَّهِ وَمَا هُوَ مِنۡ عِندِ ٱللَّهِۖ وَيَقُولُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ وَهُمۡ يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وان منهم لفريقا يلون السنتهم بالكتٰب لتحسبوه من الكتٰب وما هو من الكتٰب ويقولون هو من عند الله وما هو من عند الله ويقولون على الله الكذب وهم يعلمون" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "376" ;
        quran:page                     "60" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:186  quran:ayah_text             "ذَٰلِكَ بِأَنَّ ٱللَّهَ نَزَّلَ ٱلۡكِتَٰبَ بِٱلۡحَقِّۗ وَإِنَّ ٱلَّذِينَ ٱخۡتَلَفُواْ فِي ٱلۡكِتَٰبِ لَفِي شِقَاقِۭ بَعِيدٖ" ;
        quran:ayah_text_no_diacratic   "ذٰلك بان الله نزل الكتٰب بالحق وان الذين اختلفوا في الكتٰب لفي شقاق بعيد" ;
        quran:ayahnumber               "176" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "186" ;
        quran:page                     "26" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2934  quran:ayah_text            "وَكَذَٰلِكَ جَعَلۡنَا لِكُلِّ نَبِيٍّ عَدُوّٗا مِّنَ ٱلۡمُجۡرِمِينَۗ وَكَفَىٰ بِرَبِّكَ هَادِيٗا وَنَصِيرٗا" ;
        quran:ayah_text_no_diacratic   "وكذٰلك جعلنا لكل نبي عدوا من المجرمين وكفىٰ بربك هاديا ونصيرا" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "2934" ;
        quran:page                     "362" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:1840  quran:ayah_text            "وَلَقَدۡ أَرۡسَلۡنَا مِن قَبۡلِكَ فِي شِيَعِ ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "ولقد ارسلنا من قبلك في شيع الاولين" ;
