quran:1190  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا لَقِيتُمُ ٱلَّذِينَ كَفَرُواْ زَحۡفٗا فَلَا تُوَلُّوهُمُ ٱلۡأَدۡبَارَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اذا لقيتم الذين كفروا زحفا فلا تولوهم الادبار" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1190" ;
