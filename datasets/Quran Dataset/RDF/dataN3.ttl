        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:495  quran:ayah_text             "مَتَٰعٞ قَلِيلٞ ثُمَّ مَأۡوَىٰهُمۡ جَهَنَّمُۖ وَبِئۡسَ ٱلۡمِهَادُ" ;
