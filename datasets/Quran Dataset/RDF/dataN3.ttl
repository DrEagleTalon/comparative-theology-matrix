quran:242  quran:ayah_text             "وَإِذَا طَلَّقۡتُمُ ٱلنِّسَآءَ فَبَلَغۡنَ أَجَلَهُنَّ فَلَا تَعۡضُلُوهُنَّ أَن يَنكِحۡنَ أَزۡوَٰجَهُنَّ إِذَا تَرَٰضَوۡاْ بَيۡنَهُم بِٱلۡمَعۡرُوفِۗ ذَٰلِكَ يُوعَظُ بِهِۦ مَن كَانَ مِنكُمۡ يُؤۡمِنُ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۗ ذَٰلِكُمۡ أَزۡكَىٰ لَكُمۡ وَأَطۡهَرُۚ وَٱللَّهُ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "واذا طلقتم النساء فبلغن اجلهن فلا تعضلوهن ان ينكحن ازوٰجهن اذا ترٰضوا بينهم بالمعروف ذٰلك يوعظ به من كان منكم يؤمن بالله واليوم الاخر ذٰلكم ازكىٰ لكم واطهر والله يعلم وانتم لا تعلمون" ;
        quran:ayahnumber               "232" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "242" ;
        quran:page                     "37" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:5771  quran:ayah_text            "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا" ;
        quran:ayah_text_no_diacratic   "وما تشاءون الا ان يشاء الله ان الله كان عليما حكيما" ;
