        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:871  quran:ayah_text             "قُلۡ أَنَدۡعُواْ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُنَا وَلَا يَضُرُّنَا وَنُرَدُّ عَلَىٰٓ أَعۡقَابِنَا بَعۡدَ إِذۡ هَدَىٰنَا ٱللَّهُ كَٱلَّذِي ٱسۡتَهۡوَتۡهُ ٱلشَّيَٰطِينُ فِي ٱلۡأَرۡضِ حَيۡرَانَ لَهُۥٓ أَصۡحَٰبٞ يَدۡعُونَهُۥٓ إِلَى ٱلۡهُدَى ٱئۡتِنَاۗ قُلۡ إِنَّ هُدَى ٱللَّهِ هُوَ ٱلۡهُدَىٰۖ وَأُمِرۡنَا لِنُسۡلِمَ لِرَبِّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "قل اندعوا من دون الله ما لا ينفعنا ولا يضرنا ونرد علىٰ اعقابنا بعد اذ هدىٰنا الله كالذي استهوته الشيٰطين في الارض حيران له اصحٰب يدعونه الى الهدى ائتنا قل ان هدى الله هو الهدىٰ وامرنا لنسلم لرب العٰلمين" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "871" ;
        quran:page                     "136" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4305  quran:ayah_text            "ٱلَّذِينَ لَا يُؤۡتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلۡأٓخِرَةِ هُمۡ كَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "الذين لا يؤتون الزكوٰة وهم بالاخرة هم كٰفرون" ;
