quran:5356  quran:ayah_text            "رَّسُولٗا يَتۡلُواْ عَلَيۡكُمۡ ءَايَٰتِ ٱللَّهِ مُبَيِّنَٰتٖ لِّيُخۡرِجَ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ مِنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۚ وَمَن يُؤۡمِنۢ بِٱللَّهِ وَيَعۡمَلۡ صَٰلِحٗا يُدۡخِلۡهُ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ قَدۡ أَحۡسَنَ ٱللَّهُ لَهُۥ رِزۡقًا" ;
        quran:ayah_text_no_diacratic   "رسولا يتلوا عليكم ءايٰت الله مبينٰت ليخرج الذين ءامنوا وعملوا الصٰلحٰت من الظلمٰت الى النور ومن يؤمن بالله ويعمل صٰلحا يدخله جنٰت تجري من تحتها الانهٰر خٰلدين فيها ابدا قد احسن الله له رزقا" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5356" ;
        quran:page                     "559" ;
        quran:surahname                "سُورَةُ الطَّلَاقِ" ;
        quran:surahnumber              "65" ;
        quran:surrahname_no_diacratic  "سورة الطلاق" .

quran:4262  quran:ayah_text            "إِنَّا لَنَنصُرُ رُسُلَنَا وَٱلَّذِينَ ءَامَنُواْ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَيَوۡمَ يَقُومُ ٱلۡأَشۡهَٰدُ" ;
