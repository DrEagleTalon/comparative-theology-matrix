quran:1694  quran:ayah_text            "فَبَدَأَ بِأَوۡعِيَتِهِمۡ قَبۡلَ وِعَآءِ أَخِيهِ ثُمَّ ٱسۡتَخۡرَجَهَا مِن وِعَآءِ أَخِيهِۚ كَذَٰلِكَ كِدۡنَا لِيُوسُفَۖ مَا كَانَ لِيَأۡخُذَ أَخَاهُ فِي دِينِ ٱلۡمَلِكِ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ نَرۡفَعُ دَرَجَٰتٖ مَّن نَّشَآءُۗ وَفَوۡقَ كُلِّ ذِي عِلۡمٍ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "فبدا باوعيتهم قبل وعاء اخيه ثم استخرجها من وعاء اخيه كذٰلك كدنا ليوسف ما كان لياخذ اخاه في دين الملك الا ان يشاء الله نرفع درجٰت من نشاء وفوق كل ذي علم عليم" ;
        quran:ayahnumber               "76" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1694" ;
        quran:page                     "244" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

