        quran:surahname                "سُورَةُ القِيَامَةِ" ;
        quran:surahnumber              "75" ;
        quran:surrahname_no_diacratic  "سورة القيامة" .

quran:3497  quran:ayah_text            "فَأَقِمۡ وَجۡهَكَ لِلدِّينِ حَنِيفٗاۚ فِطۡرَتَ ٱللَّهِ ٱلَّتِي فَطَرَ ٱلنَّاسَ عَلَيۡهَاۚ لَا تَبۡدِيلَ لِخَلۡقِ ٱللَّهِۚ ذَٰلِكَ ٱلدِّينُ ٱلۡقَيِّمُ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "فاقم وجهك للدين حنيفا فطرت الله التي فطر الناس عليها لا تبديل لخلق الله ذٰلك الدين القيم ولٰكن اكثر الناس لا يعلمون" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3497" ;
        quran:page                     "407" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:4641  quran:ayah_text            "فَإِذَا لَقِيتُمُ ٱلَّذِينَ كَفَرُواْ فَضَرۡبَ ٱلرِّقَابِ حَتَّىٰٓ إِذَآ أَثۡخَنتُمُوهُمۡ فَشُدُّواْ ٱلۡوَثَاقَ فَإِمَّا مَنَّۢا بَعۡدُ وَإِمَّا فِدَآءً حَتَّىٰ تَضَعَ ٱلۡحَرۡبُ أَوۡزَارَهَاۚ ذَٰلِكَۖ وَلَوۡ يَشَآءُ ٱللَّهُ لَٱنتَصَرَ مِنۡهُمۡ وَلَٰكِن لِّيَبۡلُوَاْ بَعۡضَكُم بِبَعۡضٖۗ وَٱلَّذِينَ قُتِلُواْ فِي سَبِيلِ ٱللَّهِ فَلَن يُضِلَّ أَعۡمَٰلَهُمۡ" ;
        quran:ayah_text_no_diacratic   "فاذا لقيتم الذين كفروا فضرب الرقاب حتىٰ اذا اثخنتموهم فشدوا الوثاق فاما منا بعد واما فداء حتىٰ تضع الحرب اوزارها ذٰلك ولو يشاء الله لانتصر منهم ولٰكن ليبلوا بعضكم ببعض والذين قتلوا في سبيل الله فلن يضل اعمٰلهم" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4641" ;
        quran:page                     "507" ;
        quran:surahname                "سُورَةُ مُحَمَّدٍ" ;
        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:5545  quran:ayah_text            "وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ" ;
        quran:ayah_text_no_diacratic   "والذين هم لامٰنٰتهم وعهدهم رٰعون" ;
        quran:ayahnumber               "32" ;
