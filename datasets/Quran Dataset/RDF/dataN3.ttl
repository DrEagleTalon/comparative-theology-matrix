        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:4159  quran:ayah_text            "كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَأَتَىٰهُمُ ٱلۡعَذَابُ مِنۡ حَيۡثُ لَا يَشۡعُرُونَ" ;
        quran:ayah_text_no_diacratic   "كذب الذين من قبلهم فاتىٰهم العذاب من حيث لا يشعرون" ;
