quran:1486  quran:ayah_text            "قُلۡ يَٰٓأَيُّهَا ٱلنَّاسُ إِن كُنتُمۡ فِي شَكّٖ مِّن دِينِي فَلَآ أَعۡبُدُ ٱلَّذِينَ تَعۡبُدُونَ مِن دُونِ ٱللَّهِ وَلَٰكِنۡ أَعۡبُدُ ٱللَّهَ ٱلَّذِي يَتَوَفَّىٰكُمۡۖ وَأُمِرۡتُ أَنۡ أَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "قل يٰايها الناس ان كنتم في شك من ديني فلا اعبد الذين تعبدون من دون الله ولٰكن اعبد الله الذي يتوفىٰكم وامرت ان اكون من المؤمنين" ;
        quran:ayahnumber               "104" ;
        quran:chapter                  "11" ;
        quran:hizb                     "22" ;
        quran:index                    "1486" ;
        quran:page                     "220" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4628  quran:ayah_text            "فَلَوۡلَا نَصَرَهُمُ ٱلَّذِينَ ٱتَّخَذُواْ مِن دُونِ ٱللَّهِ قُرۡبَانًا ءَالِهَةَۢۖ بَلۡ ضَلُّواْ عَنۡهُمۡۚ وَذَٰلِكَ إِفۡكُهُمۡ وَمَا كَانُواْ يَفۡتَرُونَ" ;
        quran:ayah_text_no_diacratic   "فلولا نصرهم الذين اتخذوا من دون الله قربانا ءالهة بل ضلوا عنهم وذٰلك افكهم وما كانوا يفترون" ;
        quran:ayahnumber               "28" ;
