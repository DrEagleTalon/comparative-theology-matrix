        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:440  quran:ayah_text             "أَمۡ حَسِبۡتُمۡ أَن تَدۡخُلُواْ ٱلۡجَنَّةَ وَلَمَّا يَعۡلَمِ ٱللَّهُ ٱلَّذِينَ جَٰهَدُواْ مِنكُمۡ وَيَعۡلَمَ ٱلصَّٰبِرِينَ" ;
        quran:ayah_text_no_diacratic   "ام حسبتم ان تدخلوا الجنة ولما يعلم الله الذين جٰهدوا منكم ويعلم الصٰبرين" ;
        quran:ayahnumber               "142" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "440" ;
        quran:page                     "68" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:250  quran:ayah_text             "وَٱلَّذِينَ يُتَوَفَّوۡنَ مِنكُمۡ وَيَذَرُونَ أَزۡوَٰجٗا وَصِيَّةٗ لِّأَزۡوَٰجِهِم مَّتَٰعًا إِلَى ٱلۡحَوۡلِ غَيۡرَ إِخۡرَاجٖۚ فَإِنۡ خَرَجۡنَ فَلَا جُنَاحَ عَلَيۡكُمۡ فِي مَا فَعَلۡنَ فِيٓ أَنفُسِهِنَّ مِن مَّعۡرُوفٖۗ وَٱللَّهُ عَزِيزٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "والذين يتوفون منكم ويذرون ازوٰجا وصية لازوٰجهم متٰعا الى الحول غير اخراج فان خرجن فلا جناح عليكم في ما فعلن في انفسهن من معروف والله عزيز حكيم" ;
        quran:ayahnumber               "240" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "250" ;
        quran:page                     "39" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2948  quran:ayah_text            "أَلَمۡ تَرَ إِلَىٰ رَبِّكَ كَيۡفَ مَدَّ ٱلظِّلَّ وَلَوۡ شَآءَ لَجَعَلَهُۥ سَاكِنٗا ثُمَّ جَعَلۡنَا ٱلشَّمۡسَ عَلَيۡهِ دَلِيلٗا" ;
        quran:ayah_text_no_diacratic   "الم تر الىٰ ربك كيف مد الظل ولو شاء لجعله ساكنا ثم جعلنا الشمس عليه دليلا" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "19" ;
