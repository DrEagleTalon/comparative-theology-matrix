quran:1416  quran:ayah_text            "قُلۡ هَلۡ مِن شُرَكَآئِكُم مَّن يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥۚ قُلِ ٱللَّهُ يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥۖ فَأَنَّىٰ تُؤۡفَكُونَ" ;
        quran:ayah_text_no_diacratic   "قل هل من شركائكم من يبدؤا الخلق ثم يعيده قل الله يبدؤا الخلق ثم يعيده فانىٰ تؤفكون" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1416" ;
        quran:page                     "213" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:5151  quran:ayah_text            "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد علمتم النشاة الاولىٰ فلولا تذكرون" ;
