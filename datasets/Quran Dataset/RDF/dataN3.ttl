quran:3416  quran:ayah_text            "قُلۡ سِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ بَدَأَ ٱلۡخَلۡقَۚ ثُمَّ ٱللَّهُ يُنشِئُ ٱلنَّشۡأَةَ ٱلۡأٓخِرَةَۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "قل سيروا في الارض فانظروا كيف بدا الخلق ثم الله ينشئ النشاة الاخرة ان الله علىٰ كل شيء قدير" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3416" ;
        quran:page                     "398" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1178  quran:ayah_text            "ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ" ;
        quran:ayah_text_no_diacratic   "الذين يقيمون الصلوٰة ومما رزقنٰهم ينفقون" ;
        quran:ayahnumber               "3" ;
