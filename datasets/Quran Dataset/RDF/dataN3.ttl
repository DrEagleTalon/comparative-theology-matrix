        quran:surahnumber              "57" ;
        quran:surrahname_no_diacratic  "سورة الحديد" .

quran:2608  quran:ayah_text            "وَإِسۡمَٰعِيلَ وَإِدۡرِيسَ وَذَا ٱلۡكِفۡلِۖ كُلّٞ مِّنَ ٱلصَّٰبِرِينَ" ;
