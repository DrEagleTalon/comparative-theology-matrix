quran:2160  quran:ayah_text            "۞أَوَلَمۡ يَرَوۡاْ أَنَّ ٱللَّهَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ قَادِرٌ عَلَىٰٓ أَن يَخۡلُقَ مِثۡلَهُمۡ وَجَعَلَ لَهُمۡ أَجَلٗا لَّا رَيۡبَ فِيهِ فَأَبَى ٱلظَّٰلِمُونَ إِلَّا كُفُورٗا" ;
        quran:ayah_text_no_diacratic   "اولم يروا ان الله الذي خلق السمٰوٰت والارض قادر علىٰ ان يخلق مثلهم وجعل لهم اجلا لا ريب فيه فابى الظٰلمون الا كفورا" ;
        quran:ayahnumber               "99" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2160" ;
        quran:page                     "292" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:5302  quran:ayah_text            "وَءَاخَرِينَ مِنۡهُمۡ لَمَّا يَلۡحَقُواْ بِهِمۡۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ" ;
