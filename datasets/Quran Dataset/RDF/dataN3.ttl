quran:1134  quran:ayah_text            "وَإِذۡ تَأَذَّنَ رَبُّكَ لَيَبۡعَثَنَّ عَلَيۡهِمۡ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ مَن يَسُومُهُمۡ سُوٓءَ ٱلۡعَذَابِۗ إِنَّ رَبَّكَ لَسَرِيعُ ٱلۡعِقَابِ وَإِنَّهُۥ لَغَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "واذ تاذن ربك ليبعثن عليهم الىٰ يوم القيٰمة من يسومهم سوء العذاب ان ربك لسريع العقاب وانه لغفور رحيم" ;
        quran:ayahnumber               "167" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1134" ;
        quran:page                     "172" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:842  quran:ayah_text             "وَلَقَدۡ أَرۡسَلۡنَآ إِلَىٰٓ أُمَمٖ مِّن قَبۡلِكَ فَأَخَذۡنَٰهُم بِٱلۡبَأۡسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمۡ يَتَضَرَّعُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد ارسلنا الىٰ امم من قبلك فاخذنٰهم بالباساء والضراء لعلهم يتضرعون" ;
