        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:765  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تُحَرِّمُواْ طَيِّبَٰتِ مَآ أَحَلَّ ٱللَّهُ لَكُمۡ وَلَا تَعۡتَدُوٓاْۚ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلۡمُعۡتَدِينَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا تحرموا طيبٰت ما احل الله لكم ولا تعتدوا ان الله لا يحب المعتدين" ;
        quran:ayahnumber               "87" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "765" ;
        quran:page                     "122" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2201  quran:ayah_text            "وَٱتۡلُ مَآ أُوحِيَ إِلَيۡكَ مِن كِتَابِ رَبِّكَۖ لَا مُبَدِّلَ لِكَلِمَٰتِهِۦ وَلَن تَجِدَ مِن دُونِهِۦ مُلۡتَحَدٗا" ;
        quran:ayah_text_no_diacratic   "واتل ما اوحي اليك من كتاب ربك لا مبدل لكلمٰته ولن تجد من دونه ملتحدا" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "15" ;
