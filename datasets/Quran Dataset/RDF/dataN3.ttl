        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3423  quran:ayah_text            "وَوَهَبۡنَا لَهُۥٓ إِسۡحَٰقَ وَيَعۡقُوبَ وَجَعَلۡنَا فِي ذُرِّيَّتِهِ ٱلنُّبُوَّةَ وَٱلۡكِتَٰبَ وَءَاتَيۡنَٰهُ أَجۡرَهُۥ فِي ٱلدُّنۡيَاۖ وَإِنَّهُۥ فِي ٱلۡأٓخِرَةِ لَمِنَ ٱلصَّٰلِحِينَ" ;
        quran:ayah_text_no_diacratic   "ووهبنا له اسحٰق ويعقوب وجعلنا في ذريته النبوة والكتٰب وءاتينٰه اجره في الدنيا وانه في الاخرة لمن الصٰلحين" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3423" ;
        quran:page                     "399" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1185  quran:ayah_text            "وَمَا جَعَلَهُ ٱللَّهُ إِلَّا بُشۡرَىٰ وَلِتَطۡمَئِنَّ بِهِۦ قُلُوبُكُمۡۚ وَمَا ٱلنَّصۡرُ إِلَّا مِنۡ عِندِ ٱللَّهِۚ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ" ;
        quran:ayah_text_no_diacratic   "وما جعله الله الا بشرىٰ ولتطمئن به قلوبكم وما النصر الا من عند الله ان الله عزيز حكيم" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1185" ;
        quran:page                     "178" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:893  quran:ayah_text             "وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوۡ قَالَ أُوحِيَ إِلَيَّ وَلَمۡ يُوحَ إِلَيۡهِ شَيۡءٞ وَمَن قَالَ سَأُنزِلُ مِثۡلَ مَآ أَنزَلَ ٱللَّهُۗ وَلَوۡ تَرَىٰٓ إِذِ ٱلظَّٰلِمُونَ فِي غَمَرَٰتِ ٱلۡمَوۡتِ وَٱلۡمَلَٰٓئِكَةُ بَاسِطُوٓاْ أَيۡدِيهِمۡ أَخۡرِجُوٓاْ أَنفُسَكُمُۖ ٱلۡيَوۡمَ تُجۡزَوۡنَ عَذَابَ ٱلۡهُونِ بِمَا كُنتُمۡ تَقُولُونَ عَلَى ٱللَّهِ غَيۡرَ ٱلۡحَقِّ وَكُنتُمۡ عَنۡ ءَايَٰتِهِۦ تَسۡتَكۡبِرُونَ" ;
        quran:ayah_text_no_diacratic   "ومن اظلم ممن افترىٰ على الله كذبا او قال اوحي الي ولم يوح اليه شيء ومن قال سانزل مثل ما انزل الله ولو ترىٰ اذ الظٰلمون في غمرٰت الموت والملٰئكة باسطوا ايديهم اخرجوا انفسكم اليوم تجزون عذاب الهون بما كنتم تقولون على الله غير الحق وكنتم عن ءايٰته تستكبرون" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "893" ;
        quran:page                     "139" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4327  quran:ayah_text            "وَقَالَ ٱلَّذِينَ كَفَرُواْ رَبَّنَآ أَرِنَا ٱلَّذَيۡنِ أَضَلَّانَا مِنَ ٱلۡجِنِّ وَٱلۡإِنسِ نَجۡعَلۡهُمَا تَحۡتَ أَقۡدَامِنَا لِيَكُونَا مِنَ ٱلۡأَسۡفَلِينَ" ;
        quran:ayah_text_no_diacratic   "وقال الذين كفروا ربنا ارنا الذين اضلانا من الجن والانس نجعلهما تحت اقدامنا ليكونا من الاسفلين" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "24" ;
        quran:hizb                     "48" ;
        quran:index                    "4327" ;
        quran:page                     "479" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2089  quran:ayah_text            "وَإِمَّا تُعۡرِضَنَّ عَنۡهُمُ ٱبۡتِغَآءَ رَحۡمَةٖ مِّن رَّبِّكَ تَرۡجُوهَا فَقُل لَّهُمۡ قَوۡلٗا مَّيۡسُورٗا" ;
        quran:ayah_text_no_diacratic   "واما تعرضن عنهم ابتغاء رحمة من ربك ترجوها فقل لهم قولا ميسورا" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2089" ;
        quran:page                     "285" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3233  quran:ayah_text            "فَمَكَثَ غَيۡرَ بَعِيدٖ فَقَالَ أَحَطتُ بِمَا لَمۡ تُحِطۡ بِهِۦ وَجِئۡتُكَ مِن سَبَإِۭ بِنَبَإٖ يَقِينٍ" ;
        quran:ayah_text_no_diacratic   "فمكث غير بعيد فقال احطت بما لم تحط به وجئتك من سبا بنبا يقين" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3233" ;
        quran:page                     "378" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:4137  quran:ayah_text            "أَلَا لِلَّهِ ٱلدِّينُ ٱلۡخَالِصُۚ وَٱلَّذِينَ ٱتَّخَذُواْ مِن دُونِهِۦٓ أَوۡلِيَآءَ مَا نَعۡبُدُهُمۡ إِلَّا لِيُقَرِّبُونَآ إِلَى ٱللَّهِ زُلۡفَىٰٓ إِنَّ ٱللَّهَ يَحۡكُمُ بَيۡنَهُمۡ فِي مَا هُمۡ فِيهِ يَخۡتَلِفُونَۗ إِنَّ ٱللَّهَ لَا يَهۡدِي مَنۡ هُوَ كَٰذِبٞ كَفَّارٞ" ;
        quran:ayah_text_no_diacratic   "الا لله الدين الخالص والذين اتخذوا من دونه اولياء ما نعبدهم الا ليقربونا الى الله زلفىٰ ان الله يحكم بينهم في ما هم فيه يختلفون ان الله لا يهدي من هو كٰذب كفار" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
        quran:index                    "4137" ;
        quran:page                     "458" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:3043  quran:ayah_text            "فَلَمَّا تَرَٰٓءَا ٱلۡجَمۡعَانِ قَالَ أَصۡحَٰبُ مُوسَىٰٓ إِنَّا لَمُدۡرَكُونَ" ;
        quran:ayah_text_no_diacratic   "فلما ترٰءا الجمعان قال اصحٰب موسىٰ انا لمدركون" ;
        quran:ayahnumber               "61" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3043" ;
        quran:page                     "370" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:35  quran:ayah_text              "وَبَشِّرِ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ كُلَّمَا رُزِقُواْ مِنۡهَا مِن ثَمَرَةٖ رِّزۡقٗا قَالُواْ هَٰذَا ٱلَّذِي رُزِقۡنَا مِن قَبۡلُۖ وَأُتُواْ بِهِۦ مُتَشَٰبِهٗاۖ وَلَهُمۡ فِيهَآ أَزۡوَٰجٞ مُّطَهَّرَةٞۖ وَهُمۡ فِيهَا خَٰلِدُونَ" ;
        quran:ayah_text_no_diacratic   "وبشر الذين ءامنوا وعملوا الصٰلحٰت ان لهم جنٰت تجري من تحتها الانهٰر كلما رزقوا منها من ثمرة رزقا قالوا هٰذا الذي رزقنا من قبل واتوا به متشٰبها ولهم فيها ازوٰج مطهرة وهم فيها خٰلدون" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "1" ;
        quran:hizb                     "0" ;
        quran:index                    "35" ;
        quran:page                     "5" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:3975  quran:ayah_text            "وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "ونجينٰهما وقومهما من الكرب العظيم" ;
