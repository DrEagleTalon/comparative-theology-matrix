        quran:surrahname_no_diacratic  "سورة الليل" .

quran:1431  quran:ayah_text            "قُل لَّآ أَمۡلِكُ لِنَفۡسِي ضَرّٗا وَلَا نَفۡعًا إِلَّا مَا شَآءَ ٱللَّهُۗ لِكُلِّ أُمَّةٍ أَجَلٌۚ إِذَا جَآءَ أَجَلُهُمۡ فَلَا يَسۡتَـٔۡخِرُونَ سَاعَةٗ وَلَا يَسۡتَقۡدِمُونَ" ;
        quran:ayah_text_no_diacratic   "قل لا املك لنفسي ضرا ولا نفعا الا ما شاء الله لكل امة اجل اذا جاء اجلهم فلا يستخرون ساعة ولا يستقدمون" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1431" ;
        quran:page                     "214" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:3429  quran:ayah_text            "وَلَمَّآ أَن جَآءَتۡ رُسُلُنَا لُوطٗا سِيٓءَ بِهِمۡ وَضَاقَ بِهِمۡ ذَرۡعٗاۖ وَقَالُواْ لَا تَخَفۡ وَلَا تَحۡزَنۡ إِنَّا مُنَجُّوكَ وَأَهۡلَكَ إِلَّا ٱمۡرَأَتَكَ كَانَتۡ مِنَ ٱلۡغَٰبِرِينَ" ;
        quran:ayah_text_no_diacratic   "ولما ان جاءت رسلنا لوطا سيء بهم وضاق بهم ذرعا وقالوا لا تخف ولا تحزن انا منجوك واهلك الا امراتك كانت من الغٰبرين" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3429" ;
        quran:page                     "400" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:899  quran:ayah_text             "وَهُوَ ٱلَّذِيٓ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجۡنَا بِهِۦ نَبَاتَ كُلِّ شَيۡءٖ فَأَخۡرَجۡنَا مِنۡهُ خَضِرٗا نُّخۡرِجُ مِنۡهُ حَبّٗا مُّتَرَاكِبٗا وَمِنَ ٱلنَّخۡلِ مِن طَلۡعِهَا قِنۡوَانٞ دَانِيَةٞ وَجَنَّٰتٖ مِّنۡ أَعۡنَابٖ وَٱلزَّيۡتُونَ وَٱلرُّمَّانَ مُشۡتَبِهٗا وَغَيۡرَ مُتَشَٰبِهٍۗ ٱنظُرُوٓاْ إِلَىٰ ثَمَرِهِۦٓ إِذَآ أَثۡمَرَ وَيَنۡعِهِۦٓۚ إِنَّ فِي ذَٰلِكُمۡ لَأٓيَٰتٖ لِّقَوۡمٖ يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "وهو الذي انزل من السماء ماء فاخرجنا به نبات كل شيء فاخرجنا منه خضرا نخرج منه حبا متراكبا ومن النخل من طلعها قنوان دانية وجنٰت من اعناب والزيتون والرمان مشتبها وغير متشٰبه انظروا الىٰ ثمره اذا اثمر وينعه ان في ذٰلكم لايٰت لقوم يؤمنون" ;
        quran:ayahnumber               "99" ;
        quran:chapter                  "7" ;
        quran:hizb                     "14" ;
        quran:index                    "899" ;
        quran:page                     "140" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2335  quran:ayah_text            "فَلَمَّا ٱعۡتَزَلَهُمۡ وَمَا يَعۡبُدُونَ مِن دُونِ ٱللَّهِ وَهَبۡنَا لَهُۥٓ إِسۡحَٰقَ وَيَعۡقُوبَۖ وَكُلّٗا جَعَلۡنَا نَبِيّٗا" ;
        quran:ayah_text_no_diacratic   "فلما اعتزلهم وما يعبدون من دون الله وهبنا له اسحٰق ويعقوب وكلا جعلنا نبيا" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2335" ;
        quran:page                     "308" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:6070  quran:ayah_text            "فَمَا لَهُمۡ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "فما لهم لا يؤمنون" ;
        quran:ayahnumber               "20" ;
