quran:3476  quran:ayah_text            "أَوَلَمۡ يَسِيرُواْ فِي ٱلۡأَرۡضِ فَيَنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَانُوٓاْ أَشَدَّ مِنۡهُمۡ قُوَّةٗ وَأَثَارُواْ ٱلۡأَرۡضَ وَعَمَرُوهَآ أَكۡثَرَ مِمَّا عَمَرُوهَا وَجَآءَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِۖ فَمَا كَانَ ٱللَّهُ لِيَظۡلِمَهُمۡ وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "اولم يسيروا في الارض فينظروا كيف كان عٰقبة الذين من قبلهم كانوا اشد منهم قوة واثاروا الارض وعمروها اكثر مما عمروها وجاءتهم رسلهم بالبينٰت فما كان الله ليظلمهم ولٰكن كانوا انفسهم يظلمون" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3476" ;
        quran:page                     "405" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:4620  quran:ayah_text            "وَيَوۡمَ يُعۡرَضُ ٱلَّذِينَ كَفَرُواْ عَلَى ٱلنَّارِ أَذۡهَبۡتُمۡ طَيِّبَٰتِكُمۡ فِي حَيَاتِكُمُ ٱلدُّنۡيَا وَٱسۡتَمۡتَعۡتُم بِهَا فَٱلۡيَوۡمَ تُجۡزَوۡنَ عَذَابَ ٱلۡهُونِ بِمَا كُنتُمۡ تَسۡتَكۡبِرُونَ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّ وَبِمَا كُنتُمۡ تَفۡسُقُونَ" ;
        quran:ayah_text_no_diacratic   "ويوم يعرض الذين كفروا على النار اذهبتم طيبٰتكم في حياتكم الدنيا واستمتعتم بها فاليوم تجزون عذاب الهون بما كنتم تستكبرون في الارض بغير الحق وبما كنتم تفسقون" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4620" ;
        quran:page                     "504" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2382  quran:ayah_text            "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ سَيَجۡعَلُ لَهُمُ ٱلرَّحۡمَٰنُ وُدّٗا" ;
        quran:ayah_text_no_diacratic   "ان الذين ءامنوا وعملوا الصٰلحٰت سيجعل لهم الرحمٰن ودا" ;
