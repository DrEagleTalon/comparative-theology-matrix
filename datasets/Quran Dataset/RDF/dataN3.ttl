        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1096  quran:ayah_text            "قَالُوٓاْ أُوذِينَا مِن قَبۡلِ أَن تَأۡتِيَنَا وَمِنۢ بَعۡدِ مَا جِئۡتَنَاۚ قَالَ عَسَىٰ رَبُّكُمۡ أَن يُهۡلِكَ عَدُوَّكُمۡ وَيَسۡتَخۡلِفَكُمۡ فِي ٱلۡأَرۡضِ فَيَنظُرَ كَيۡفَ تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "قالوا اوذينا من قبل ان تاتينا ومن بعد ما جئتنا قال عسىٰ ربكم ان يهلك عدوكم ويستخلفكم في الارض فينظر كيف تعملون" ;
        quran:ayahnumber               "129" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1096" ;
        quran:page                     "165" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:2240  quran:ayah_text            "قَالَ لَهُۥ مُوسَىٰ هَلۡ أَتَّبِعُكَ عَلَىٰٓ أَن تُعَلِّمَنِ مِمَّا عُلِّمۡتَ رُشۡدٗا" ;
        quran:ayah_text_no_diacratic   "قال له موسىٰ هل اتبعك علىٰ ان تعلمن مما علمت رشدا" ;
        quran:ayahnumber               "66" ;
