quran:709  quran:ayah_text             "فَبَعَثَ ٱللَّهُ غُرَابٗا يَبۡحَثُ فِي ٱلۡأَرۡضِ لِيُرِيَهُۥ كَيۡفَ يُوَٰرِي سَوۡءَةَ أَخِيهِۚ قَالَ يَٰوَيۡلَتَىٰٓ أَعَجَزۡتُ أَنۡ أَكُونَ مِثۡلَ هَٰذَا ٱلۡغُرَابِ فَأُوَٰرِيَ سَوۡءَةَ أَخِيۖ فَأَصۡبَحَ مِنَ ٱلنَّٰدِمِينَ" ;
        quran:ayah_text_no_diacratic   "فبعث الله غرابا يبحث في الارض ليريه كيف يوٰري سوءة اخيه قال يٰويلتىٰ اعجزت ان اكون مثل هٰذا الغراب فاوٰري سوءة اخي فاصبح من النٰدمين" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "709" ;
        quran:page                     "112" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:519  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا يَحِلُّ لَكُمۡ أَن تَرِثُواْ ٱلنِّسَآءَ كَرۡهٗاۖ وَلَا تَعۡضُلُوهُنَّ لِتَذۡهَبُواْ بِبَعۡضِ مَآ ءَاتَيۡتُمُوهُنَّ إِلَّآ أَن يَأۡتِينَ بِفَٰحِشَةٖ مُّبَيِّنَةٖۚ وَعَاشِرُوهُنَّ بِٱلۡمَعۡرُوفِۚ فَإِن كَرِهۡتُمُوهُنَّ فَعَسَىٰٓ أَن تَكۡرَهُواْ شَيۡـٔٗا وَيَجۡعَلَ ٱللَّهُ فِيهِ خَيۡرٗا كَثِيرٗا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا يحل لكم ان ترثوا النساء كرها ولا تعضلوهن لتذهبوا ببعض ما ءاتيتموهن الا ان ياتين بفٰحشة مبينة وعاشروهن بالمعروف فان كرهتموهن فعسىٰ ان تكرهوا شيا ويجعل الله فيه خيرا كثيرا" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "4" ;
        quran:hizb                     "8" ;
        quran:index                    "519" ;
        quran:page                     "80" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4954  quran:ayah_text            "وَإِن يَرَوۡاْ ءَايَةٗ يُعۡرِضُواْ وَيَقُولُواْ سِحۡرٞ مُّسۡتَمِرّٞ" ;
