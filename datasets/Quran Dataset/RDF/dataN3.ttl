        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2442  quran:ayah_text            "وَلَقَدۡ أَرَيۡنَٰهُ ءَايَٰتِنَا كُلَّهَا فَكَذَّبَ وَأَبَىٰ" ;
        quran:ayah_text_no_diacratic   "ولقد ارينٰه ءايٰتنا كلها فكذب وابىٰ" ;
