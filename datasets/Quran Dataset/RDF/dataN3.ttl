quran:233  quran:ayah_text             "نِسَآؤُكُمۡ حَرۡثٞ لَّكُمۡ فَأۡتُواْ حَرۡثَكُمۡ أَنَّىٰ شِئۡتُمۡۖ وَقَدِّمُواْ لِأَنفُسِكُمۡۚ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّكُم مُّلَٰقُوهُۗ وَبَشِّرِ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "نساؤكم حرث لكم فاتوا حرثكم انىٰ شئتم وقدموا لانفسكم واتقوا الله واعلموا انكم ملٰقوه وبشر المؤمنين" ;
        quran:ayahnumber               "223" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "233" ;
        quran:page                     "35" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:5762  quran:ayah_text            "عَٰلِيَهُمۡ ثِيَابُ سُندُسٍ خُضۡرٞ وَإِسۡتَبۡرَقٞۖ وَحُلُّوٓاْ أَسَاوِرَ مِن فِضَّةٖ وَسَقَىٰهُمۡ رَبُّهُمۡ شَرَابٗا طَهُورًا" ;
        quran:ayah_text_no_diacratic   "عٰليهم ثياب سندس خضر واستبرق وحلوا اساور من فضة وسقىٰهم ربهم شرابا طهورا" ;
