quran:168  quran:ayah_text             "۞إِنَّ ٱلصَّفَا وَٱلۡمَرۡوَةَ مِن شَعَآئِرِ ٱللَّهِۖ فَمَنۡ حَجَّ ٱلۡبَيۡتَ أَوِ ٱعۡتَمَرَ فَلَا جُنَاحَ عَلَيۡهِ أَن يَطَّوَّفَ بِهِمَاۚ وَمَن تَطَوَّعَ خَيۡرٗا فَإِنَّ ٱللَّهَ شَاكِرٌ عَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "ان الصفا والمروة من شعائر الله فمن حج البيت او اعتمر فلا جناح عليه ان يطوف بهما ومن تطوع خيرا فان الله شاكر عليم" ;
        quran:ayahnumber               "158" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "168" ;
        quran:page                     "24" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
