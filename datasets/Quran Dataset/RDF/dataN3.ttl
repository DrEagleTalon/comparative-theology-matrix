quran:1247  quran:ayah_text            "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَهَاجَرُواْ وَجَٰهَدُواْ بِأَمۡوَٰلِهِمۡ وَأَنفُسِهِمۡ فِي سَبِيلِ ٱللَّهِ وَٱلَّذِينَ ءَاوَواْ وَّنَصَرُوٓاْ أُوْلَٰٓئِكَ بَعۡضُهُمۡ أَوۡلِيَآءُ بَعۡضٖۚ وَٱلَّذِينَ ءَامَنُواْ وَلَمۡ يُهَاجِرُواْ مَا لَكُم مِّن وَلَٰيَتِهِم مِّن شَيۡءٍ حَتَّىٰ يُهَاجِرُواْۚ وَإِنِ ٱسۡتَنصَرُوكُمۡ فِي ٱلدِّينِ فَعَلَيۡكُمُ ٱلنَّصۡرُ إِلَّا عَلَىٰ قَوۡمِۭ بَيۡنَكُمۡ وَبَيۡنَهُم مِّيثَٰقٞۗ وَٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرٞ" ;
        quran:ayah_text_no_diacratic   "ان الذين ءامنوا وهاجروا وجٰهدوا باموٰلهم وانفسهم في سبيل الله والذين ءاووا ونصروا اولٰئك بعضهم اولياء بعض والذين ءامنوا ولم يهاجروا ما لكم من ولٰيتهم من شيء حتىٰ يهاجروا وان استنصروكم في الدين فعليكم النصر الا علىٰ قوم بينكم وبينهم ميثٰق والله بما تعملون بصير" ;
        quran:ayahnumber               "72" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1247" ;
        quran:page                     "186" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:955  quran:ayah_text             "وَهَٰذَا كِتَٰبٌ أَنزَلۡنَٰهُ مُبَارَكٞ فَٱتَّبِعُوهُ وَٱتَّقُواْ لَعَلَّكُمۡ تُرۡحَمُونَ" ;
        quran:ayah_text_no_diacratic   "وهٰذا كتٰب انزلنٰه مبارك فاتبعوه واتقوا لعلكم ترحمون" ;
        quran:ayahnumber               "155" ;
