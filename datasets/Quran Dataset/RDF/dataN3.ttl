        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:5629  quran:ayah_text            "وَٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَٱهۡجُرۡهُمۡ هَجۡرٗا جَمِيلٗا" ;
        quran:ayah_text_no_diacratic   "واصبر علىٰ ما يقولون واهجرهم هجرا جميلا" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5629" ;
