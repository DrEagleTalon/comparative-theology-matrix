quran:695  quran:ayah_text             "لَّقَدۡ كَفَرَ ٱلَّذِينَ قَالُوٓاْ إِنَّ ٱللَّهَ هُوَ ٱلۡمَسِيحُ ٱبۡنُ مَرۡيَمَۚ قُلۡ فَمَن يَمۡلِكُ مِنَ ٱللَّهِ شَيۡـًٔا إِنۡ أَرَادَ أَن يُهۡلِكَ ٱلۡمَسِيحَ ٱبۡنَ مَرۡيَمَ وَأُمَّهُۥ وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗاۗ وَلِلَّهِ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَاۚ يَخۡلُقُ مَا يَشَآءُۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "لقد كفر الذين قالوا ان الله هو المسيح ابن مريم قل فمن يملك من الله شيا ان اراد ان يهلك المسيح ابن مريم وامه ومن في الارض جميعا ولله ملك السمٰوٰت والارض وما بينهما يخلق ما يشاء والله علىٰ كل شيء قدير" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "695" ;
        quran:page                     "110" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:4129  quran:ayah_text            "لَأَمۡلَأَنَّ جَهَنَّمَ مِنكَ وَمِمَّن تَبِعَكَ مِنۡهُمۡ أَجۡمَعِينَ" ;
