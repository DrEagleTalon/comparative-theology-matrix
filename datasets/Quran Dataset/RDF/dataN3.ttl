quran:5349  quran:ayah_text            "وَٱلَّٰٓـِٔي يَئِسۡنَ مِنَ ٱلۡمَحِيضِ مِن نِّسَآئِكُمۡ إِنِ ٱرۡتَبۡتُمۡ فَعِدَّتُهُنَّ ثَلَٰثَةُ أَشۡهُرٖ وَٱلَّٰٓـِٔي لَمۡ يَحِضۡنَۚ وَأُوْلَٰتُ ٱلۡأَحۡمَالِ أَجَلُهُنَّ أَن يَضَعۡنَ حَمۡلَهُنَّۚ وَمَن يَتَّقِ ٱللَّهَ يَجۡعَل لَّهُۥ مِنۡ أَمۡرِهِۦ يُسۡرٗا" ;
        quran:ayah_text_no_diacratic   "والٰي يئسن من المحيض من نسائكم ان ارتبتم فعدتهن ثلٰثة اشهر والٰي لم يحضن واولٰت الاحمال اجلهن ان يضعن حملهن ومن يتق الله يجعل له من امره يسرا" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5349" ;
        quran:page                     "558" ;
        quran:surahname                "سُورَةُ الطَّلَاقِ" ;
        quran:surahnumber              "65" ;
        quran:surrahname_no_diacratic  "سورة الطلاق" .

quran:3351  quran:ayah_text            "وَلَٰكِنَّآ أَنشَأۡنَا قُرُونٗا فَتَطَاوَلَ عَلَيۡهِمُ ٱلۡعُمُرُۚ وَمَا كُنتَ ثَاوِيٗا فِيٓ أَهۡلِ مَدۡيَنَ تَتۡلُواْ عَلَيۡهِمۡ ءَايَٰتِنَا وَلَٰكِنَّا كُنَّا مُرۡسِلِينَ" ;
        quran:ayah_text_no_diacratic   "ولٰكنا انشانا قرونا فتطاول عليهم العمر وما كنت ثاويا في اهل مدين تتلوا عليهم ءايٰتنا ولٰكنا كنا مرسلين" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3351" ;
        quran:page                     "391" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4255  quran:ayah_text            "فَسَتَذۡكُرُونَ مَآ أَقُولُ لَكُمۡۚ وَأُفَوِّضُ أَمۡرِيٓ إِلَى ٱللَّهِۚ إِنَّ ٱللَّهَ بَصِيرُۢ بِٱلۡعِبَادِ" ;
        quran:ayah_text_no_diacratic   "فستذكرون ما اقول لكم وافوض امري الى الله ان الله بصير بالعباد" ;
