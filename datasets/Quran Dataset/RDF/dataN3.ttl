        quran:index                    "2255" ;
        quran:page                     "302" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1161  quran:ayah_text            "إِنَّ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِ عِبَادٌ أَمۡثَالُكُمۡۖ فَٱدۡعُوهُمۡ فَلۡيَسۡتَجِيبُواْ لَكُمۡ إِن كُنتُمۡ صَٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "ان الذين تدعون من دون الله عباد امثالكم فادعوهم فليستجيبوا لكم ان كنتم صٰدقين" ;
        quran:ayahnumber               "194" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1161" ;
        quran:page                     "175" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:3159  quran:ayah_text            "إِذۡ قَالَ لَهُمۡ شُعَيۡبٌ أَلَا تَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "اذ قال لهم شعيب الا تتقون" ;
