quran:483  quran:ayah_text             "كُلُّ نَفۡسٖ ذَآئِقَةُ ٱلۡمَوۡتِۗ وَإِنَّمَا تُوَفَّوۡنَ أُجُورَكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِۖ فَمَن زُحۡزِحَ عَنِ ٱلنَّارِ وَأُدۡخِلَ ٱلۡجَنَّةَ فَقَدۡ فَازَۗ وَمَا ٱلۡحَيَوٰةُ ٱلدُّنۡيَآ إِلَّا مَتَٰعُ ٱلۡغُرُورِ" ;
        quran:ayah_text_no_diacratic   "كل نفس ذائقة الموت وانما توفون اجوركم يوم القيٰمة فمن زحزح عن النار وادخل الجنة فقد فاز وما الحيوٰة الدنيا الا متٰع الغرور" ;
        quran:ayahnumber               "185" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "483" ;
        quran:page                     "74" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:293  quran:ayah_text             "۞وَإِن كُنتُمۡ عَلَىٰ سَفَرٖ وَلَمۡ تَجِدُواْ كَاتِبٗا فَرِهَٰنٞ مَّقۡبُوضَةٞۖ فَإِنۡ أَمِنَ بَعۡضُكُم بَعۡضٗا فَلۡيُؤَدِّ ٱلَّذِي ٱؤۡتُمِنَ أَمَٰنَتَهُۥ وَلۡيَتَّقِ ٱللَّهَ رَبَّهُۥۗ وَلَا تَكۡتُمُواْ ٱلشَّهَٰدَةَۚ وَمَن يَكۡتُمۡهَا فَإِنَّهُۥٓ ءَاثِمٞ قَلۡبُهُۥۗ وَٱللَّهُ بِمَا تَعۡمَلُونَ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "وان كنتم علىٰ سفر ولم تجدوا كاتبا فرهٰن مقبوضة فان امن بعضكم بعضا فليؤد الذي اؤتمن امٰنته وليتق الله ربه ولا تكتموا الشهٰدة ومن يكتمها فانه ءاثم قلبه والله بما تعملون عليم" ;
        quran:ayahnumber               "283" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "293" ;
        quran:page                     "49" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1897  quran:ayah_text            "وَجَآءَ أَهۡلُ ٱلۡمَدِينَةِ يَسۡتَبۡشِرُونَ" ;
