        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:2467  quran:ayah_text            "كُلُواْ مِن طَيِّبَٰتِ مَا رَزَقۡنَٰكُمۡ وَلَا تَطۡغَوۡاْ فِيهِ فَيَحِلَّ عَلَيۡكُمۡ غَضَبِيۖ وَمَن يَحۡلِلۡ عَلَيۡهِ غَضَبِي فَقَدۡ هَوَىٰ" ;
        quran:ayah_text_no_diacratic   "كلوا من طيبٰت ما رزقنٰكم ولا تطغوا فيه فيحل عليكم غضبي ومن يحلل عليه غضبي فقد هوىٰ" ;
        quran:ayahnumber               "81" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2467" ;
        quran:page                     "317" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:5609  quran:ayah_text            "قُلۡ إِنَّمَآ أَدۡعُواْ رَبِّي وَلَآ أُشۡرِكُ بِهِۦٓ أَحَدٗا" ;
        quran:ayah_text_no_diacratic   "قل انما ادعوا ربي ولا اشرك به احدا" ;
