quran:225  quran:ayah_text             "يَسۡـَٔلُونَكَ مَاذَا يُنفِقُونَۖ قُلۡ مَآ أَنفَقۡتُم مِّنۡ خَيۡرٖ فَلِلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِۗ وَمَا تَفۡعَلُواْ مِنۡ خَيۡرٖ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "يسلونك ماذا ينفقون قل ما انفقتم من خير فللوٰلدين والاقربين واليتٰمىٰ والمسٰكين وابن السبيل وما تفعلوا من خير فان الله به عليم" ;
        quran:ayahnumber               "215" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "225" ;
        quran:page                     "33" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

