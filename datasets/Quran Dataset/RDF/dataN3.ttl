quran:253  quran:ayah_text             "۞أَلَمۡ تَرَ إِلَى ٱلَّذِينَ خَرَجُواْ مِن دِيَٰرِهِمۡ وَهُمۡ أُلُوفٌ حَذَرَ ٱلۡمَوۡتِ فَقَالَ لَهُمُ ٱللَّهُ مُوتُواْ ثُمَّ أَحۡيَٰهُمۡۚ إِنَّ ٱللَّهَ لَذُو فَضۡلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَشۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "الم تر الى الذين خرجوا من ديٰرهم وهم الوف حذر الموت فقال لهم الله موتوا ثم احيٰهم ان الله لذو فضل على الناس ولٰكن اكثر الناس لا يشكرون" ;
        quran:ayahnumber               "243" ;
        quran:chapter                  "2" ;
        quran:hizb                     "4" ;
        quran:index                    "253" ;
        quran:page                     "39" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

