quran:4629  quran:ayah_text            "وَإِذۡ صَرَفۡنَآ إِلَيۡكَ نَفَرٗا مِّنَ ٱلۡجِنِّ يَسۡتَمِعُونَ ٱلۡقُرۡءَانَ فَلَمَّا حَضَرُوهُ قَالُوٓاْ أَنصِتُواْۖ فَلَمَّا قُضِيَ وَلَّوۡاْ إِلَىٰ قَوۡمِهِم مُّنذِرِينَ" ;
        quran:ayah_text_no_diacratic   "واذ صرفنا اليك نفرا من الجن يستمعون القرءان فلما حضروه قالوا انصتوا فلما قضي ولوا الىٰ قومهم منذرين" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4629" ;
        quran:page                     "506" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2631  quran:ayah_text            "قُلۡ إِنَّمَا يُوحَىٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۖ فَهَلۡ أَنتُم مُّسۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "قل انما يوحىٰ الي انما الٰهكم الٰه وٰحد فهل انتم مسلمون" ;
        quran:ayahnumber               "108" ;
