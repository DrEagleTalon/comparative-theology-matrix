        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:3628  quran:ayah_text            "۞وَمَن يَقۡنُتۡ مِنكُنَّ لِلَّهِ وَرَسُولِهِۦ وَتَعۡمَلۡ صَٰلِحٗا نُّؤۡتِهَآ أَجۡرَهَا مَرَّتَيۡنِ وَأَعۡتَدۡنَا لَهَا رِزۡقٗا كَرِيمٗا" ;
        quran:ayah_text_no_diacratic   "ومن يقنت منكن لله ورسوله وتعمل صٰلحا نؤتها اجرها مرتين واعتدنا لها رزقا كريما" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3628" ;
        quran:page                     "422" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:2534  quran:ayah_text            "وَكَمۡ قَصَمۡنَا مِن قَرۡيَةٖ كَانَتۡ ظَالِمَةٗ وَأَنشَأۡنَا بَعۡدَهَا قَوۡمًا ءَاخَرِينَ" ;
        quran:ayah_text_no_diacratic   "وكم قصمنا من قرية كانت ظالمة وانشانا بعدها قوما ءاخرين" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2534" ;
        quran:page                     "323" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3438  quran:ayah_text            "إِنَّ ٱللَّهَ يَعۡلَمُ مَا يَدۡعُونَ مِن دُونِهِۦ مِن شَيۡءٖۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ" ;
        quran:ayah_text_no_diacratic   "ان الله يعلم ما يدعون من دونه من شيء وهو العزيز الحكيم" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3438" ;
