        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:797  quran:ayah_text             "قَالَ ٱللَّهُ هَٰذَا يَوۡمُ يَنفَعُ ٱلصَّٰدِقِينَ صِدۡقُهُمۡۚ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ رَّضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ" ;
        quran:ayah_text_no_diacratic   "قال الله هٰذا يوم ينفع الصٰدقين صدقهم لهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها ابدا رضي الله عنهم ورضوا عنه ذٰلك الفوز العظيم" ;
        quran:ayahnumber               "119" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "797" ;
        quran:page                     "127" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2233  quran:ayah_text            "وَتِلۡكَ ٱلۡقُرَىٰٓ أَهۡلَكۡنَٰهُمۡ لَمَّا ظَلَمُواْ وَجَعَلۡنَا لِمَهۡلِكِهِم مَّوۡعِدٗا" ;
        quran:ayah_text_no_diacratic   "وتلك القرىٰ اهلكنٰهم لما ظلموا وجعلنا لمهلكهم موعدا" ;
        quran:ayahnumber               "59" ;
        quran:chapter                  "15" ;
        quran:hizb                     "30" ;
        quran:index                    "2233" ;
        quran:page                     "300" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3137  quran:ayah_text            "قَالَ هَٰذِهِۦ نَاقَةٞ لَّهَا شِرۡبٞ وَلَكُمۡ شِرۡبُ يَوۡمٖ مَّعۡلُومٖ" ;
        quran:ayah_text_no_diacratic   "قال هٰذه ناقة لها شرب ولكم شرب يوم معلوم" ;
        quran:ayahnumber               "155" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3137" ;
        quran:page                     "373" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:2043  quran:ayah_text            "وَضَرَبَ ٱللَّهُ مَثَلٗا قَرۡيَةٗ كَانَتۡ ءَامِنَةٗ مُّطۡمَئِنَّةٗ يَأۡتِيهَا رِزۡقُهَا رَغَدٗا مِّن كُلِّ مَكَانٖ فَكَفَرَتۡ بِأَنۡعُمِ ٱللَّهِ فَأَذَٰقَهَا ٱللَّهُ لِبَاسَ ٱلۡجُوعِ وَٱلۡخَوۡفِ بِمَا كَانُواْ يَصۡنَعُونَ" ;
        quran:ayah_text_no_diacratic   "وضرب الله مثلا قرية كانت ءامنة مطمئنة ياتيها رزقها رغدا من كل مكان فكفرت بانعم الله فاذٰقها الله لباس الجوع والخوف بما كانوا يصنعون" ;
        quran:ayahnumber               "112" ;
        quran:chapter                  "14" ;
        quran:hizb                     "28" ;
        quran:index                    "2043" ;
        quran:page                     "280" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2975  quran:ayah_text            "وَٱلَّذِينَ لَا يَشۡهَدُونَ ٱلزُّورَ وَإِذَا مَرُّواْ بِٱللَّغۡوِ مَرُّواْ كِرَامٗا" ;
        quran:ayah_text_no_diacratic   "والذين لا يشهدون الزور واذا مروا باللغو مروا كراما" ;
        quran:ayahnumber               "72" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "2975" ;
        quran:page                     "366" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3879  quran:ayah_text            "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ" ;
        quran:ayah_text_no_diacratic   "فانما هي زجرة وٰحدة فاذا هم ينظرون" ;
        quran:ayahnumber               "19" ;
