quran:4361  quran:ayah_text            "وَكَذَٰلِكَ أَوۡحَيۡنَآ إِلَيۡكَ قُرۡءَانًا عَرَبِيّٗا لِّتُنذِرَ أُمَّ ٱلۡقُرَىٰ وَمَنۡ حَوۡلَهَا وَتُنذِرَ يَوۡمَ ٱلۡجَمۡعِ لَا رَيۡبَ فِيهِۚ فَرِيقٞ فِي ٱلۡجَنَّةِ وَفَرِيقٞ فِي ٱلسَّعِيرِ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك اوحينا اليك قرءانا عربيا لتنذر ام القرىٰ ومن حولها وتنذر يوم الجمع لا ريب فيه فريق في الجنة وفريق في السعير" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4361" ;
        quran:page                     "483" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:5265  quran:ayah_text            "هُوَ ٱللَّهُ ٱلَّذِي لَآ إِلَٰهَ إِلَّا هُوَ ٱلۡمَلِكُ ٱلۡقُدُّوسُ ٱلسَّلَٰمُ ٱلۡمُؤۡمِنُ ٱلۡمُهَيۡمِنُ ٱلۡعَزِيزُ ٱلۡجَبَّارُ ٱلۡمُتَكَبِّرُۚ سُبۡحَٰنَ ٱللَّهِ عَمَّا يُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "هو الله الذي لا الٰه الا هو الملك القدوس السلٰم المؤمن المهيمن العزيز الجبار المتكبر سبحٰن الله عما يشركون" ;
