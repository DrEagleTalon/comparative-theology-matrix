quran:585  quran:ayah_text             "مَّن يَشۡفَعۡ شَفَٰعَةً حَسَنَةٗ يَكُن لَّهُۥ نَصِيبٞ مِّنۡهَاۖ وَمَن يَشۡفَعۡ شَفَٰعَةٗ سَيِّئَةٗ يَكُن لَّهُۥ كِفۡلٞ مِّنۡهَاۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ مُّقِيتٗا" ;
        quran:ayah_text_no_diacratic   "من يشفع شفٰعة حسنة يكن له نصيب منها ومن يشفع شفٰعة سيئة يكن له كفل منها وكان الله علىٰ كل شيء مقيتا" ;
        quran:ayahnumber               "85" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "585" ;
        quran:page                     "91" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

