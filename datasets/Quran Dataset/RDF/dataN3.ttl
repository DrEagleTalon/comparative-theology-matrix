quran:3230  quran:ayah_text            "فَتَبَسَّمَ ضَاحِكٗا مِّن قَوۡلِهَا وَقَالَ رَبِّ أَوۡزِعۡنِيٓ أَنۡ أَشۡكُرَ نِعۡمَتَكَ ٱلَّتِيٓ أَنۡعَمۡتَ عَلَيَّ وَعَلَىٰ وَٰلِدَيَّ وَأَنۡ أَعۡمَلَ صَٰلِحٗا تَرۡضَىٰهُ وَأَدۡخِلۡنِي بِرَحۡمَتِكَ فِي عِبَادِكَ ٱلصَّٰلِحِينَ" ;
        quran:ayah_text_no_diacratic   "فتبسم ضاحكا من قولها وقال رب اوزعني ان اشكر نعمتك التي انعمت علي وعلىٰ وٰلدي وان اعمل صٰلحا ترضىٰه وادخلني برحمتك في عبادك الصٰلحين" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3230" ;
