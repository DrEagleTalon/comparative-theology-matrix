        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:4912  quran:ayah_text            "أَمۡ لِلۡإِنسَٰنِ مَا تَمَنَّىٰ" ;
        quran:ayah_text_no_diacratic   "ام للانسٰن ما تمنىٰ" ;
