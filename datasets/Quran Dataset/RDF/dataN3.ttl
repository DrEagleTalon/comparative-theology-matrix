quran:953  quran:ayah_text             "وَأَنَّ هَٰذَا صِرَٰطِي مُسۡتَقِيمٗا فَٱتَّبِعُوهُۖ وَلَا تَتَّبِعُواْ ٱلسُّبُلَ فَتَفَرَّقَ بِكُمۡ عَن سَبِيلِهِۦۚ ذَٰلِكُمۡ وَصَّىٰكُم بِهِۦ لَعَلَّكُمۡ تَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "وان هٰذا صرٰطي مستقيما فاتبعوه ولا تتبعوا السبل فتفرق بكم عن سبيله ذٰلكم وصىٰكم به لعلكم تتقون" ;
        quran:ayahnumber               "153" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "953" ;
        quran:page                     "149" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2149  quran:ayah_text            "قُل لَّئِنِ ٱجۡتَمَعَتِ ٱلۡإِنسُ وَٱلۡجِنُّ عَلَىٰٓ أَن يَأۡتُواْ بِمِثۡلِ هَٰذَا ٱلۡقُرۡءَانِ لَا يَأۡتُونَ بِمِثۡلِهِۦ وَلَوۡ كَانَ بَعۡضُهُمۡ لِبَعۡضٖ ظَهِيرٗا" ;
        quran:ayah_text_no_diacratic   "قل لئن اجتمعت الانس والجن علىٰ ان ياتوا بمثل هٰذا القرءان لا ياتون بمثله ولو كان بعضهم لبعض ظهيرا" ;
        quran:ayahnumber               "88" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2149" ;
        quran:page                     "291" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1055  quran:ayah_text            "۞قَالَ ٱلۡمَلَأُ ٱلَّذِينَ ٱسۡتَكۡبَرُواْ مِن قَوۡمِهِۦ لَنُخۡرِجَنَّكَ يَٰشُعَيۡبُ وَٱلَّذِينَ ءَامَنُواْ مَعَكَ مِن قَرۡيَتِنَآ أَوۡ لَتَعُودُنَّ فِي مِلَّتِنَاۚ قَالَ أَوَلَوۡ كُنَّا كَٰرِهِينَ" ;
        quran:ayah_text_no_diacratic   "قال الملا الذين استكبروا من قومه لنخرجنك يٰشعيب والذين ءامنوا معك من قريتنا او لتعودن في ملتنا قال اولو كنا كٰرهين" ;
        quran:ayahnumber               "88" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1055" ;
        quran:page                     "162" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:763  quran:ayah_text             "فَأَثَٰبَهُمُ ٱللَّهُ بِمَا قَالُواْ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "فاثٰبهم الله بما قالوا جنٰت تجري من تحتها الانهٰر خٰلدين فيها وذٰلك جزاء المحسنين" ;
        quran:ayahnumber               "85" ;
        quran:chapter                  "7" ;
