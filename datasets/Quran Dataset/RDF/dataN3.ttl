        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:650  quran:ayah_text             "إِنَّ ٱلَّذِينَ يَكۡفُرُونَ بِٱللَّهِ وَرُسُلِهِۦ وَيُرِيدُونَ أَن يُفَرِّقُواْ بَيۡنَ ٱللَّهِ وَرُسُلِهِۦ وَيَقُولُونَ نُؤۡمِنُ بِبَعۡضٖ وَنَكۡفُرُ بِبَعۡضٖ وَيُرِيدُونَ أَن يَتَّخِذُواْ بَيۡنَ ذَٰلِكَ سَبِيلًا" ;
        quran:ayah_text_no_diacratic   "ان الذين يكفرون بالله ورسله ويريدون ان يفرقوا بين الله ورسله ويقولون نؤمن ببعض ونكفر ببعض ويريدون ان يتخذوا بين ذٰلك سبيلا" ;
        quran:ayahnumber               "150" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "650" ;
        quran:page                     "102" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:460  quran:ayah_text             "أَفَمَنِ ٱتَّبَعَ رِضۡوَٰنَ ٱللَّهِ كَمَنۢ بَآءَ بِسَخَطٖ مِّنَ ٱللَّهِ وَمَأۡوَىٰهُ جَهَنَّمُۖ وَبِئۡسَ ٱلۡمَصِيرُ" ;
        quran:ayah_text_no_diacratic   "افمن اتبع رضوٰن الله كمن باء بسخط من الله وماوىٰه جهنم وبئس المصير" ;
        quran:ayahnumber               "162" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "460" ;
        quran:page                     "71" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:270  quran:ayah_text             "وَإِذۡ قَالَ إِبۡرَٰهِـۧمُ رَبِّ أَرِنِي كَيۡفَ تُحۡيِ ٱلۡمَوۡتَىٰۖ قَالَ أَوَلَمۡ تُؤۡمِنۖ قَالَ بَلَىٰ وَلَٰكِن لِّيَطۡمَئِنَّ قَلۡبِيۖ قَالَ فَخُذۡ أَرۡبَعَةٗ مِّنَ ٱلطَّيۡرِ فَصُرۡهُنَّ إِلَيۡكَ ثُمَّ ٱجۡعَلۡ عَلَىٰ كُلِّ جَبَلٖ مِّنۡهُنَّ جُزۡءٗا ثُمَّ ٱدۡعُهُنَّ يَأۡتِينَكَ سَعۡيٗاۚ وَٱعۡلَمۡ أَنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "واذ قال ابرٰهم رب ارني كيف تحي الموتىٰ قال اولم تؤمن قال بلىٰ ولٰكن ليطمئن قلبي قال فخذ اربعة من الطير فصرهن اليك ثم اجعل علىٰ كل جبل منهن جزءا ثم ادعهن ياتينك سعيا واعلم ان الله عزيز حكيم" ;
        quran:ayahnumber               "260" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "270" ;
        quran:page                     "44" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2968  quran:ayah_text            "وَٱلَّذِينَ يَقُولُونَ رَبَّنَا ٱصۡرِفۡ عَنَّا عَذَابَ جَهَنَّمَۖ إِنَّ عَذَابَهَا كَانَ غَرَامًا" ;
        quran:ayah_text_no_diacratic   "والذين يقولون ربنا اصرف عنا عذاب جهنم ان عذابها كان غراما" ;
