quran:74  quran:ayah_text              "ثُمَّ تَوَلَّيۡتُم مِّنۢ بَعۡدِ ذَٰلِكَۖ فَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ لَكُنتُم مِّنَ ٱلۡخَٰسِرِينَ" ;
        quran:ayah_text_no_diacratic   "ثم توليتم من بعد ذٰلك فلولا فضل الله عليكم ورحمته لكنتم من الخٰسرين" ;
        quran:ayahnumber               "64" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "74" ;
