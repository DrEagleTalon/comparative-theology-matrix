quran:3623  quran:ayah_text            "وَأَنزَلَ ٱلَّذِينَ ظَٰهَرُوهُم مِّنۡ أَهۡلِ ٱلۡكِتَٰبِ مِن صَيَاصِيهِمۡ وَقَذَفَ فِي قُلُوبِهِمُ ٱلرُّعۡبَ فَرِيقٗا تَقۡتُلُونَ وَتَأۡسِرُونَ فَرِيقٗا" ;
        quran:ayah_text_no_diacratic   "وانزل الذين ظٰهروهم من اهل الكتٰب من صياصيهم وقذف في قلوبهم الرعب فريقا تقتلون وتاسرون فريقا" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "21" ;
        quran:hizb                     "42" ;
        quran:index                    "3623" ;
        quran:page                     "421" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1385  quran:ayah_text            "إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ يُدَبِّرُ ٱلۡأَمۡرَۖ مَا مِن شَفِيعٍ إِلَّا مِنۢ بَعۡدِ إِذۡنِهِۦۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ فَٱعۡبُدُوهُۚ أَفَلَا تَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "ان ربكم الله الذي خلق السمٰوٰت والارض في ستة ايام ثم استوىٰ على العرش يدبر الامر ما من شفيع الا من بعد اذنه ذٰلكم الله ربكم فاعبدوه افلا تذكرون" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1385" ;
        quran:page                     "208" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

