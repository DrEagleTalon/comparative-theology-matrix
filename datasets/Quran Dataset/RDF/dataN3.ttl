        quran:surrahname_no_diacratic  "سورة طه" .

quran:3425  quran:ayah_text            "أَئِنَّكُمۡ لَتَأۡتُونَ ٱلرِّجَالَ وَتَقۡطَعُونَ ٱلسَّبِيلَ وَتَأۡتُونَ فِي نَادِيكُمُ ٱلۡمُنكَرَۖ فَمَا كَانَ جَوَابَ قَوۡمِهِۦٓ إِلَّآ أَن قَالُواْ ٱئۡتِنَا بِعَذَابِ ٱللَّهِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "ائنكم لتاتون الرجال وتقطعون السبيل وتاتون في ناديكم المنكر فما كان جواب قومه الا ان قالوا ائتنا بعذاب الله ان كنت من الصٰدقين" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3425" ;
        quran:page                     "399" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1187  quran:ayah_text            "إِذۡ يُوحِي رَبُّكَ إِلَى ٱلۡمَلَٰٓئِكَةِ أَنِّي مَعَكُمۡ فَثَبِّتُواْ ٱلَّذِينَ ءَامَنُواْۚ سَأُلۡقِي فِي قُلُوبِ ٱلَّذِينَ كَفَرُواْ ٱلرُّعۡبَ فَٱضۡرِبُواْ فَوۡقَ ٱلۡأَعۡنَاقِ وَٱضۡرِبُواْ مِنۡهُمۡ كُلَّ بَنَانٖ" ;
        quran:ayah_text_no_diacratic   "اذ يوحي ربك الى الملٰئكة اني معكم فثبتوا الذين ءامنوا سالقي في قلوب الذين كفروا الرعب فاضربوا فوق الاعناق واضربوا منهم كل بنان" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1187" ;
        quran:page                     "178" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:895  quran:ayah_text             "۞إِنَّ ٱللَّهَ فَالِقُ ٱلۡحَبِّ وَٱلنَّوَىٰۖ يُخۡرِجُ ٱلۡحَيَّ مِنَ ٱلۡمَيِّتِ وَمُخۡرِجُ ٱلۡمَيِّتِ مِنَ ٱلۡحَيِّۚ ذَٰلِكُمُ ٱللَّهُۖ فَأَنَّىٰ تُؤۡفَكُونَ" ;
        quran:ayah_text_no_diacratic   "ان الله فالق الحب والنوىٰ يخرج الحي من الميت ومخرج الميت من الحي ذٰلكم الله فانىٰ تؤفكون" ;
        quran:ayahnumber               "95" ;
        quran:chapter                  "7" ;
        quran:hizb                     "14" ;
        quran:index                    "895" ;
        quran:page                     "140" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4329  quran:ayah_text            "نَحۡنُ أَوۡلِيَآؤُكُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَفِي ٱلۡأٓخِرَةِۖ وَلَكُمۡ فِيهَا مَا تَشۡتَهِيٓ أَنفُسُكُمۡ وَلَكُمۡ فِيهَا مَا تَدَّعُونَ" ;
        quran:ayah_text_no_diacratic   "نحن اولياؤكم في الحيوٰة الدنيا وفي الاخرة ولكم فيها ما تشتهي انفسكم ولكم فيها ما تدعون" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "24" ;
        quran:hizb                     "48" ;
        quran:index                    "4329" ;
        quran:page                     "480" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2331  quran:ayah_text            "يَٰٓأَبَتِ إِنِّيٓ أَخَافُ أَن يَمَسَّكَ عَذَابٞ مِّنَ ٱلرَّحۡمَٰنِ فَتَكُونَ لِلشَّيۡطَٰنِ وَلِيّٗا" ;
        quran:ayah_text_no_diacratic   "يٰابت اني اخاف ان يمسك عذاب من الرحمٰن فتكون للشيطٰن وليا" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2331" ;
        quran:page                     "308" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:3235  quran:ayah_text            "وَجَدتُّهَا وَقَوۡمَهَا يَسۡجُدُونَ لِلشَّمۡسِ مِن دُونِ ٱللَّهِ وَزَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ أَعۡمَٰلَهُمۡ فَصَدَّهُمۡ عَنِ ٱلسَّبِيلِ فَهُمۡ لَا يَهۡتَدُونَ" ;
        quran:ayah_text_no_diacratic   "وجدتها وقومها يسجدون للشمس من دون الله وزين لهم الشيطٰن اعمٰلهم فصدهم عن السبيل فهم لا يهتدون" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3235" ;
        quran:page                     "379" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:2141  quran:ayah_text            "وَقُل رَّبِّ أَدۡخِلۡنِي مُدۡخَلَ صِدۡقٖ وَأَخۡرِجۡنِي مُخۡرَجَ صِدۡقٖ وَٱجۡعَل لِّي مِن لَّدُنكَ سُلۡطَٰنٗا نَّصِيرٗا" ;
        quran:ayah_text_no_diacratic   "وقل رب ادخلني مدخل صدق واخرجني مخرج صدق واجعل لي من لدنك سلطٰنا نصيرا" ;
        quran:ayahnumber               "80" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2141" ;
        quran:page                     "290" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:4139  quran:ayah_text            "خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۖ يُكَوِّرُ ٱلَّيۡلَ عَلَى ٱلنَّهَارِ وَيُكَوِّرُ ٱلنَّهَارَ عَلَى ٱلَّيۡلِۖ وَسَخَّرَ ٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ يَجۡرِي لِأَجَلٖ مُّسَمًّىۗ أَلَا هُوَ ٱلۡعَزِيزُ ٱلۡغَفَّٰرُ" ;
        quran:ayah_text_no_diacratic   "خلق السمٰوٰت والارض بالحق يكور اليل على النهار ويكور النهار على اليل وسخر الشمس والقمر كل يجري لاجل مسمى الا هو العزيز الغفٰر" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
        quran:index                    "4139" ;
        quran:page                     "458" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:3045  quran:ayah_text            "فَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضۡرِب بِّعَصَاكَ ٱلۡبَحۡرَۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرۡقٖ كَٱلطَّوۡدِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "فاوحينا الىٰ موسىٰ ان اضرب بعصاك البحر فانفلق فكان كل فرق كالطود العظيم" ;
