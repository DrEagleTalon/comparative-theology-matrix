        quran:surrahname_no_diacratic  "سورة السجدة" .

quran:4721  quran:ayah_text            "يَٰٓأَيُّهَا ٱلنَّاسُ إِنَّا خَلَقۡنَٰكُم مِّن ذَكَرٖ وَأُنثَىٰ وَجَعَلۡنَٰكُمۡ شُعُوبٗا وَقَبَآئِلَ لِتَعَارَفُوٓاْۚ إِنَّ أَكۡرَمَكُمۡ عِندَ ٱللَّهِ أَتۡقَىٰكُمۡۚ إِنَّ ٱللَّهَ عَلِيمٌ خَبِيرٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الناس انا خلقنٰكم من ذكر وانثىٰ وجعلنٰكم شعوبا وقبائل لتعارفوا ان اكرمكم عند الله اتقىٰكم ان الله عليم خبير" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4721" ;
        quran:page                     "517" ;
        quran:surahname                "سُورَةُ الحُجُرَاتِ" ;
        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:2483  quran:ayah_text            "قَالَ فَٱذۡهَبۡ فَإِنَّ لَكَ فِي ٱلۡحَيَوٰةِ أَن تَقُولَ لَا مِسَاسَۖ وَإِنَّ لَكَ مَوۡعِدٗا لَّن تُخۡلَفَهُۥۖ وَٱنظُرۡ إِلَىٰٓ إِلَٰهِكَ ٱلَّذِي ظَلۡتَ عَلَيۡهِ عَاكِفٗاۖ لَّنُحَرِّقَنَّهُۥ ثُمَّ لَنَنسِفَنَّهُۥ فِي ٱلۡيَمِّ نَسۡفًا" ;
        quran:ayah_text_no_diacratic   "قال فاذهب فان لك في الحيوٰة ان تقول لا مساس وان لك موعدا لن تخلفه وانظر الىٰ الٰهك الذي ظلت عليه عاكفا لنحرقنه ثم لننسفنه في اليم نسفا" ;
        quran:ayahnumber               "97" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2483" ;
        quran:page                     "318" ;
