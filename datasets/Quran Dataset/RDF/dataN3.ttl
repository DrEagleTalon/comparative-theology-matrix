quran:208  quran:ayah_text             "لَيۡسَ عَلَيۡكُمۡ جُنَاحٌ أَن تَبۡتَغُواْ فَضۡلٗا مِّن رَّبِّكُمۡۚ فَإِذَآ أَفَضۡتُم مِّنۡ عَرَفَٰتٖ فَٱذۡكُرُواْ ٱللَّهَ عِندَ ٱلۡمَشۡعَرِ ٱلۡحَرَامِۖ وَٱذۡكُرُوهُ كَمَا هَدَىٰكُمۡ وَإِن كُنتُم مِّن قَبۡلِهِۦ لَمِنَ ٱلضَّآلِّينَ" ;
        quran:ayah_text_no_diacratic   "ليس عليكم جناح ان تبتغوا فضلا من ربكم فاذا افضتم من عرفٰت فاذكروا الله عند المشعر الحرام واذكروه كما هدىٰكم وان كنتم من قبله لمن الضالين" ;
        quran:ayahnumber               "198" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "208" ;
        quran:page                     "31" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:5737  quran:ayah_text            "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ" ;
        quran:ayah_text_no_diacratic   "ثم كان علقة فخلق فسوىٰ" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5737" ;
        quran:page                     "578" ;
        quran:surahname                "سُورَةُ القِيَامَةِ" ;
        quran:surahnumber              "75" ;
        quran:surrahname_no_diacratic  "سورة القيامة" .

quran:3499  quran:ayah_text            "مِنَ ٱلَّذِينَ فَرَّقُواْ دِينَهُمۡ وَكَانُواْ شِيَعٗاۖ كُلُّ حِزۡبِۭ بِمَا لَدَيۡهِمۡ فَرِحُونَ" ;
        quran:ayah_text_no_diacratic   "من الذين فرقوا دينهم وكانوا شيعا كل حزب بما لديهم فرحون" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3499" ;
        quran:page                     "407" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:4643  quran:ayah_text            "وَيُدۡخِلُهُمُ ٱلۡجَنَّةَ عَرَّفَهَا لَهُمۡ" ;
        quran:ayah_text_no_diacratic   "ويدخلهم الجنة عرفها لهم" ;
        quran:ayahnumber               "6" ;
