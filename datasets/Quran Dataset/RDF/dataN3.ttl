        quran:surahnumber              "89" ;
        quran:surrahname_no_diacratic  "سورة الفجر" .

quran:3602  quran:ayah_text            "ٱدۡعُوهُمۡ لِأٓبَآئِهِمۡ هُوَ أَقۡسَطُ عِندَ ٱللَّهِۚ فَإِن لَّمۡ تَعۡلَمُوٓاْ ءَابَآءَهُمۡ فَإِخۡوَٰنُكُمۡ فِي ٱلدِّينِ وَمَوَٰلِيكُمۡۚ وَلَيۡسَ عَلَيۡكُمۡ جُنَاحٞ فِيمَآ أَخۡطَأۡتُم بِهِۦ وَلَٰكِن مَّا تَعَمَّدَتۡ قُلُوبُكُمۡۚ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمًا" ;
        quran:ayah_text_no_diacratic   "ادعوهم لابائهم هو اقسط عند الله فان لم تعلموا ءاباءهم فاخوٰنكم في الدين وموٰليكم وليس عليكم جناح فيما اخطاتم به ولٰكن ما تعمدت قلوبكم وكان الله غفورا رحيما" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3602" ;
        quran:page                     "418" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1364  quran:ayah_text            "مَا كَانَ لِلنَّبِيِّ وَٱلَّذِينَ ءَامَنُوٓاْ أَن يَسۡتَغۡفِرُواْ لِلۡمُشۡرِكِينَ وَلَوۡ كَانُوٓاْ أُوْلِي قُرۡبَىٰ مِنۢ بَعۡدِ مَا تَبَيَّنَ لَهُمۡ أَنَّهُمۡ أَصۡحَٰبُ ٱلۡجَحِيمِ" ;
        quran:ayah_text_no_diacratic   "ما كان للنبي والذين ءامنوا ان يستغفروا للمشركين ولو كانوا اولي قربىٰ من بعد ما تبين لهم انهم اصحٰب الجحيم" ;
        quran:ayahnumber               "113" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1364" ;
        quran:page                     "205" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4506  quran:ayah_text            "رَحۡمَةٗ مِّن رَّبِّكَۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ" ;
        quran:ayah_text_no_diacratic   "رحمة من ربك انه هو السميع العليم" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4506" ;
        quran:page                     "496" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2268  quran:ayah_text            "قَالُواْ يَٰذَا ٱلۡقَرۡنَيۡنِ إِنَّ يَأۡجُوجَ وَمَأۡجُوجَ مُفۡسِدُونَ فِي ٱلۡأَرۡضِ فَهَلۡ نَجۡعَلُ لَكَ خَرۡجًا عَلَىٰٓ أَن تَجۡعَلَ بَيۡنَنَا وَبَيۡنَهُمۡ سَدّٗا" ;
        quran:ayah_text_no_diacratic   "قالوا يٰذا القرنين ان ياجوج وماجوج مفسدون في الارض فهل نجعل لك خرجا علىٰ ان تجعل بيننا وبينهم سدا" ;
        quran:ayahnumber               "94" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2268" ;
        quran:page                     "303" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3412  quran:ayah_text            "وَإِبۡرَٰهِيمَ إِذۡ قَالَ لِقَوۡمِهِ ٱعۡبُدُواْ ٱللَّهَ وَٱتَّقُوهُۖ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وابرٰهيم اذ قال لقومه اعبدوا الله واتقوه ذٰلكم خير لكم ان كنتم تعلمون" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3412" ;
        quran:page                     "398" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

