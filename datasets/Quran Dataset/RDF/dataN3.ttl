        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2082  quran:ayah_text            "ٱنظُرۡ كَيۡفَ فَضَّلۡنَا بَعۡضَهُمۡ عَلَىٰ بَعۡضٖۚ وَلَلۡأٓخِرَةُ أَكۡبَرُ دَرَجَٰتٖ وَأَكۡبَرُ تَفۡضِيلٗا" ;
        quran:ayah_text_no_diacratic   "انظر كيف فضلنا بعضهم علىٰ بعض وللاخرة اكبر درجٰت واكبر تفضيلا" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2082" ;
