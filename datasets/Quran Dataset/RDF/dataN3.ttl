quran:751  quran:ayah_text             "لَّقَدۡ كَفَرَ ٱلَّذِينَ قَالُوٓاْ إِنَّ ٱللَّهَ ثَالِثُ ثَلَٰثَةٖۘ وَمَا مِنۡ إِلَٰهٍ إِلَّآ إِلَٰهٞ وَٰحِدٞۚ وَإِن لَّمۡ يَنتَهُواْ عَمَّا يَقُولُونَ لَيَمَسَّنَّ ٱلَّذِينَ كَفَرُواْ مِنۡهُمۡ عَذَابٌ أَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "لقد كفر الذين قالوا ان الله ثالث ثلٰثة وما من الٰه الا الٰه وٰحد وان لم ينتهوا عما يقولون ليمسن الذين كفروا منهم عذاب اليم" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "751" ;
        quran:page                     "120" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:561  quran:ayah_text             "وَإِذَا قِيلَ لَهُمۡ تَعَالَوۡاْ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ رَأَيۡتَ ٱلۡمُنَٰفِقِينَ يَصُدُّونَ عَنكَ صُدُودٗا" ;
        quran:ayah_text_no_diacratic   "واذا قيل لهم تعالوا الىٰ ما انزل الله والى الرسول رايت المنٰفقين يصدون عنك صدودا" ;
        quran:ayahnumber               "61" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "561" ;
        quran:page                     "88" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:371  quran:ayah_text             "وَلَا تُؤۡمِنُوٓاْ إِلَّا لِمَن تَبِعَ دِينَكُمۡ قُلۡ إِنَّ ٱلۡهُدَىٰ هُدَى ٱللَّهِ أَن يُؤۡتَىٰٓ أَحَدٞ مِّثۡلَ مَآ أُوتِيتُمۡ أَوۡ يُحَآجُّوكُمۡ عِندَ رَبِّكُمۡۗ قُلۡ إِنَّ ٱلۡفَضۡلَ بِيَدِ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "ولا تؤمنوا الا لمن تبع دينكم قل ان الهدىٰ هدى الله ان يؤتىٰ احد مثل ما اوتيتم او يحاجوكم عند ربكم قل ان الفضل بيد الله يؤتيه من يشاء والله وٰسع عليم" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "371" ;
        quran:page                     "59" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:181  quran:ayah_text             "وَمَثَلُ ٱلَّذِينَ كَفَرُواْ كَمَثَلِ ٱلَّذِي يَنۡعِقُ بِمَا لَا يَسۡمَعُ إِلَّا دُعَآءٗ وَنِدَآءٗۚ صُمُّۢ بُكۡمٌ عُمۡيٞ فَهُمۡ لَا يَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "ومثل الذين كفروا كمثل الذي ينعق بما لا يسمع الا دعاء ونداء صم بكم عمي فهم لا يعقلون" ;
        quran:ayahnumber               "171" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "181" ;
        quran:page                     "26" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1975  quran:ayah_text            "بِٱلۡبَيِّنَٰتِ وَٱلزُّبُرِۗ وَأَنزَلۡنَآ إِلَيۡكَ ٱلذِّكۡرَ لِتُبَيِّنَ لِلنَّاسِ مَا نُزِّلَ إِلَيۡهِمۡ وَلَعَلَّهُمۡ يَتَفَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "بالبينٰت والزبر وانزلنا اليك الذكر لتبين للناس ما نزل اليهم ولعلهم يتفكرون" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1975" ;
        quran:page                     "272" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2879  quran:ayah_text            "وَلِلَّهِ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَإِلَى ٱللَّهِ ٱلۡمَصِيرُ" ;
        quran:ayah_text_no_diacratic   "ولله ملك السمٰوٰت والارض والى الله المصير" ;
        quran:ayahnumber               "42" ;
