quran:1255  quran:ayah_text            "إِلَّا ٱلَّذِينَ عَٰهَدتُّم مِّنَ ٱلۡمُشۡرِكِينَ ثُمَّ لَمۡ يَنقُصُوكُمۡ شَيۡـٔٗا وَلَمۡ يُظَٰهِرُواْ عَلَيۡكُمۡ أَحَدٗا فَأَتِمُّوٓاْ إِلَيۡهِمۡ عَهۡدَهُمۡ إِلَىٰ مُدَّتِهِمۡۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "الا الذين عٰهدتم من المشركين ثم لم ينقصوكم شيا ولم يظٰهروا عليكم احدا فاتموا اليهم عهدهم الىٰ مدتهم ان الله يحب المتقين" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1255" ;
        quran:page                     "187" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:963  quran:ayah_text             "لَا شَرِيكَ لَهُۥۖ وَبِذَٰلِكَ أُمِرۡتُ وَأَنَا۠ أَوَّلُ ٱلۡمُسۡلِمِينَ" ;
        quran:ayah_text_no_diacratic   "لا شريك له وبذٰلك امرت وانا اول المسلمين" ;
