quran:1582  quran:ayah_text            "وَيَٰقَوۡمِ لَا يَجۡرِمَنَّكُمۡ شِقَاقِيٓ أَن يُصِيبَكُم مِّثۡلُ مَآ أَصَابَ قَوۡمَ نُوحٍ أَوۡ قَوۡمَ هُودٍ أَوۡ قَوۡمَ صَٰلِحٖۚ وَمَا قَوۡمُ لُوطٖ مِّنكُم بِبَعِيدٖ" ;
        quran:ayah_text_no_diacratic   "ويٰقوم لا يجرمنكم شقاقي ان يصيبكم مثل ما اصاب قوم نوح او قوم هود او قوم صٰلح وما قوم لوط منكم ببعيد" ;
        quran:ayahnumber               "89" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1582" ;
        quran:page                     "232" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4724  quran:ayah_text            "قُلۡ أَتُعَلِّمُونَ ٱللَّهَ بِدِينِكُمۡ وَٱللَّهُ يَعۡلَمُ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ وَٱللَّهُ بِكُلِّ شَيۡءٍ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "قل اتعلمون الله بدينكم والله يعلم ما في السمٰوٰت وما في الارض والله بكل شيء عليم" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "26" ;
