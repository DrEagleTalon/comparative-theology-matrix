quran:4176  quran:ayah_text            "ٱللَّهُ يَتَوَفَّى ٱلۡأَنفُسَ حِينَ مَوۡتِهَا وَٱلَّتِي لَمۡ تَمُتۡ فِي مَنَامِهَاۖ فَيُمۡسِكُ ٱلَّتِي قَضَىٰ عَلَيۡهَا ٱلۡمَوۡتَ وَيُرۡسِلُ ٱلۡأُخۡرَىٰٓ إِلَىٰٓ أَجَلٖ مُّسَمًّىۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَتَفَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "الله يتوفى الانفس حين موتها والتي لم تمت في منامها فيمسك التي قضىٰ عليها الموت ويرسل الاخرىٰ الىٰ اجل مسمى ان في ذٰلك لايٰت لقوم يتفكرون" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "24" ;
        quran:hizb                     "46" ;
        quran:index                    "4176" ;
        quran:page                     "463" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:5320  quran:ayah_text            "يَقُولُونَ لَئِن رَّجَعۡنَآ إِلَى ٱلۡمَدِينَةِ لَيُخۡرِجَنَّ ٱلۡأَعَزُّ مِنۡهَا ٱلۡأَذَلَّۚ وَلِلَّهِ ٱلۡعِزَّةُ وَلِرَسُولِهِۦ وَلِلۡمُؤۡمِنِينَ وَلَٰكِنَّ ٱلۡمُنَٰفِقِينَ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "يقولون لئن رجعنا الى المدينة ليخرجن الاعز منها الاذل ولله العزة ولرسوله وللمؤمنين ولٰكن المنٰفقين لا يعلمون" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5320" ;
        quran:page                     "555" ;
        quran:surahname                "سُورَةُ المُنَافِقُونَ" ;
        quran:surahnumber              "63" ;
        quran:surrahname_no_diacratic  "سورة المنافقون" .

