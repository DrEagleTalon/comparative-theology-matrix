        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:940  quran:ayah_text             "قَدۡ خَسِرَ ٱلَّذِينَ قَتَلُوٓاْ أَوۡلَٰدَهُمۡ سَفَهَۢا بِغَيۡرِ عِلۡمٖ وَحَرَّمُواْ مَا رَزَقَهُمُ ٱللَّهُ ٱفۡتِرَآءً عَلَى ٱللَّهِۚ قَدۡ ضَلُّواْ وَمَا كَانُواْ مُهۡتَدِينَ" ;
        quran:ayah_text_no_diacratic   "قد خسر الذين قتلوا اولٰدهم سفها بغير علم وحرموا ما رزقهم الله افتراء على الله قد ضلوا وما كانوا مهتدين" ;
        quran:ayahnumber               "140" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "940" ;
        quran:page                     "146" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2136  quran:ayah_text            "إِذٗا لَّأَذَقۡنَٰكَ ضِعۡفَ ٱلۡحَيَوٰةِ وَضِعۡفَ ٱلۡمَمَاتِ ثُمَّ لَا تَجِدُ لَكَ عَلَيۡنَا نَصِيرٗا" ;
        quran:ayah_text_no_diacratic   "اذا لاذقنٰك ضعف الحيوٰة وضعف الممات ثم لا تجد لك علينا نصيرا" ;
        quran:ayahnumber               "75" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2136" ;
        quran:page                     "289" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1042  quran:ayah_text            "قَالَ ٱلۡمَلَأُ ٱلَّذِينَ ٱسۡتَكۡبَرُواْ مِن قَوۡمِهِۦ لِلَّذِينَ ٱسۡتُضۡعِفُواْ لِمَنۡ ءَامَنَ مِنۡهُمۡ أَتَعۡلَمُونَ أَنَّ صَٰلِحٗا مُّرۡسَلٞ مِّن رَّبِّهِۦۚ قَالُوٓاْ إِنَّا بِمَآ أُرۡسِلَ بِهِۦ مُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "قال الملا الذين استكبروا من قومه للذين استضعفوا لمن ءامن منهم اتعلمون ان صٰلحا مرسل من ربه قالوا انا بما ارسل به مؤمنون" ;
        quran:ayahnumber               "75" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1042" ;
        quran:page                     "160" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:750  quran:ayah_text             "لَقَدۡ كَفَرَ ٱلَّذِينَ قَالُوٓاْ إِنَّ ٱللَّهَ هُوَ ٱلۡمَسِيحُ ٱبۡنُ مَرۡيَمَۖ وَقَالَ ٱلۡمَسِيحُ يَٰبَنِيٓ إِسۡرَٰٓءِيلَ ٱعۡبُدُواْ ٱللَّهَ رَبِّي وَرَبَّكُمۡۖ إِنَّهُۥ مَن يُشۡرِكۡ بِٱللَّهِ فَقَدۡ حَرَّمَ ٱللَّهُ عَلَيۡهِ ٱلۡجَنَّةَ وَمَأۡوَىٰهُ ٱلنَّارُۖ وَمَا لِلظَّٰلِمِينَ مِنۡ أَنصَارٖ" ;
        quran:ayah_text_no_diacratic   "لقد كفر الذين قالوا ان الله هو المسيح ابن مريم وقال المسيح يٰبني اسرٰءيل اعبدوا الله ربي وربكم انه من يشرك بالله فقد حرم الله عليه الجنة وماوىٰه النار وما للظٰلمين من انصار" ;
        quran:ayahnumber               "72" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "750" ;
        quran:page                     "120" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:560  quran:ayah_text             "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ يَزۡعُمُونَ أَنَّهُمۡ ءَامَنُواْ بِمَآ أُنزِلَ إِلَيۡكَ وَمَآ أُنزِلَ مِن قَبۡلِكَ يُرِيدُونَ أَن يَتَحَاكَمُوٓاْ إِلَى ٱلطَّٰغُوتِ وَقَدۡ أُمِرُوٓاْ أَن يَكۡفُرُواْ بِهِۦۖ وَيُرِيدُ ٱلشَّيۡطَٰنُ أَن يُضِلَّهُمۡ ضَلَٰلَۢا بَعِيدٗا" ;
        quran:ayah_text_no_diacratic   "الم تر الى الذين يزعمون انهم ءامنوا بما انزل اليك وما انزل من قبلك يريدون ان يتحاكموا الى الطٰغوت وقد امروا ان يكفروا به ويريد الشيطٰن ان يضلهم ضلٰلا بعيدا" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "5" ;
