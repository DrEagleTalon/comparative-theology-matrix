        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:4646  quran:ayah_text            "ذَٰلِكَ بِأَنَّهُمۡ كَرِهُواْ مَآ أَنزَلَ ٱللَّهُ فَأَحۡبَطَ أَعۡمَٰلَهُمۡ" ;
        quran:ayah_text_no_diacratic   "ذٰلك بانهم كرهوا ما انزل الله فاحبط اعمٰلهم" ;
