quran:960  quran:ayah_text             "مَن جَآءَ بِٱلۡحَسَنَةِ فَلَهُۥ عَشۡرُ أَمۡثَالِهَاۖ وَمَن جَآءَ بِٱلسَّيِّئَةِ فَلَا يُجۡزَىٰٓ إِلَّا مِثۡلَهَا وَهُمۡ لَا يُظۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "من جاء بالحسنة فله عشر امثالها ومن جاء بالسيئة فلا يجزىٰ الا مثلها وهم لا يظلمون" ;
        quran:ayahnumber               "160" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "960" ;
        quran:page                     "150" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
