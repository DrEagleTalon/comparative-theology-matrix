        quran:surrahname_no_diacratic  "سورة يونس" .

quran:5140  quran:ayah_text            "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ" ;
        quran:ayah_text_no_diacratic   "ثم انكم ايها الضالون المكذبون" ;
