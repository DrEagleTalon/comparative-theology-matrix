quran:785  quran:ayah_text             "فَإِنۡ عُثِرَ عَلَىٰٓ أَنَّهُمَا ٱسۡتَحَقَّآ إِثۡمٗا فَـَٔاخَرَانِ يَقُومَانِ مَقَامَهُمَا مِنَ ٱلَّذِينَ ٱسۡتَحَقَّ عَلَيۡهِمُ ٱلۡأَوۡلَيَٰنِ فَيُقۡسِمَانِ بِٱللَّهِ لَشَهَٰدَتُنَآ أَحَقُّ مِن شَهَٰدَتِهِمَا وَمَا ٱعۡتَدَيۡنَآ إِنَّآ إِذٗا لَّمِنَ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "فان عثر علىٰ انهما استحقا اثما فاخران يقومان مقامهما من الذين استحق عليهم الاوليٰن فيقسمان بالله لشهٰدتنا احق من شهٰدتهما وما اعتدينا انا اذا لمن الظٰلمين" ;
        quran:ayahnumber               "107" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "785" ;
        quran:page                     "125" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:4219  quran:ayah_text            "رَبَّنَا وَأَدۡخِلۡهُمۡ جَنَّٰتِ عَدۡنٍ ٱلَّتِي وَعَدتَّهُمۡ وَمَن صَلَحَ مِنۡ ءَابَآئِهِمۡ وَأَزۡوَٰجِهِمۡ وَذُرِّيَّٰتِهِمۡۚ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ" ;
        quran:ayah_text_no_diacratic   "ربنا وادخلهم جنٰت عدن التي وعدتهم ومن صلح من ءابائهم وازوٰجهم وذريٰتهم انك انت العزيز الحكيم" ;
        quran:ayahnumber               "8" ;
