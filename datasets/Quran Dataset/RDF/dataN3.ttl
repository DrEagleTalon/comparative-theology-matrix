quran:1344  quran:ayah_text            "۞إِنَّمَا ٱلسَّبِيلُ عَلَى ٱلَّذِينَ يَسۡتَـٔۡذِنُونَكَ وَهُمۡ أَغۡنِيَآءُۚ رَضُواْ بِأَن يَكُونُواْ مَعَ ٱلۡخَوَالِفِ وَطَبَعَ ٱللَّهُ عَلَىٰ قُلُوبِهِمۡ فَهُمۡ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "انما السبيل على الذين يستذنونك وهم اغنياء رضوا بان يكونوا مع الخوالف وطبع الله علىٰ قلوبهم فهم لا يعلمون" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "10" ;
        quran:hizb                     "20" ;
        quran:index                    "1344" ;
        quran:page                     "201" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2248  quran:ayah_text            "فَٱنطَلَقَا حَتَّىٰٓ إِذَا لَقِيَا غُلَٰمٗا فَقَتَلَهُۥ قَالَ أَقَتَلۡتَ نَفۡسٗا زَكِيَّةَۢ بِغَيۡرِ نَفۡسٖ لَّقَدۡ جِئۡتَ شَيۡـٔٗا نُّكۡرٗا" ;
        quran:ayah_text_no_diacratic   "فانطلقا حتىٰ اذا لقيا غلٰما فقتله قال اقتلت نفسا زكية بغير نفس لقد جئت شيا نكرا" ;
        quran:ayahnumber               "74" ;
        quran:chapter                  "15" ;
        quran:hizb                     "30" ;
        quran:index                    "2248" ;
        quran:page                     "301" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1154  quran:ayah_text            "يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَاۖ قُلۡ إِنَّمَا عِلۡمُهَا عِندَ رَبِّيۖ لَا يُجَلِّيهَا لِوَقۡتِهَآ إِلَّا هُوَۚ ثَقُلَتۡ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ لَا تَأۡتِيكُمۡ إِلَّا بَغۡتَةٗۗ يَسۡـَٔلُونَكَ كَأَنَّكَ حَفِيٌّ عَنۡهَاۖ قُلۡ إِنَّمَا عِلۡمُهَا عِندَ ٱللَّهِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "يسلونك عن الساعة ايان مرسىٰها قل انما علمها عند ربي لا يجليها لوقتها الا هو ثقلت في السمٰوٰت والارض لا تاتيكم الا بغتة يسلونك كانك حفي عنها قل انما علمها عند الله ولٰكن اكثر الناس لا يعلمون" ;
        quran:ayahnumber               "187" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1154" ;
        quran:page                     "174" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:862  quran:ayah_text             "ثُمَّ رُدُّوٓاْ إِلَى ٱللَّهِ مَوۡلَىٰهُمُ ٱلۡحَقِّۚ أَلَا لَهُ ٱلۡحُكۡمُ وَهُوَ أَسۡرَعُ ٱلۡحَٰسِبِينَ" ;
        quran:ayah_text_no_diacratic   "ثم ردوا الى الله مولىٰهم الحق الا له الحكم وهو اسرع الحٰسبين" ;
