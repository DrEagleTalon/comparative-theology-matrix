quran:856  quran:ayah_text             "قُلۡ إِنِّي نُهِيتُ أَنۡ أَعۡبُدَ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِۚ قُل لَّآ أَتَّبِعُ أَهۡوَآءَكُمۡ قَدۡ ضَلَلۡتُ إِذٗا وَمَآ أَنَا۠ مِنَ ٱلۡمُهۡتَدِينَ" ;
        quran:ayah_text_no_diacratic   "قل اني نهيت ان اعبد الذين تدعون من دون الله قل لا اتبع اهواءكم قد ضللت اذا وما انا من المهتدين" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "856" ;
        quran:page                     "134" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:666  quran:ayah_text             "لَّٰكِنِ ٱللَّهُ يَشۡهَدُ بِمَآ أَنزَلَ إِلَيۡكَۖ أَنزَلَهُۥ بِعِلۡمِهِۦۖ وَٱلۡمَلَٰٓئِكَةُ يَشۡهَدُونَۚ وَكَفَىٰ بِٱللَّهِ شَهِيدًا" ;
        quran:ayah_text_no_diacratic   "لٰكن الله يشهد بما انزل اليك انزله بعلمه والملٰئكة يشهدون وكفىٰ بالله شهيدا" ;
