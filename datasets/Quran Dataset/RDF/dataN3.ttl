quran:4183  quran:ayah_text            "فَإِذَا مَسَّ ٱلۡإِنسَٰنَ ضُرّٞ دَعَانَا ثُمَّ إِذَا خَوَّلۡنَٰهُ نِعۡمَةٗ مِّنَّا قَالَ إِنَّمَآ أُوتِيتُهُۥ عَلَىٰ عِلۡمِۭۚ بَلۡ هِيَ فِتۡنَةٞ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "فاذا مس الانسٰن ضر دعانا ثم اذا خولنٰه نعمة منا قال انما اوتيته علىٰ علم بل هي فتنة ولٰكن اكثرهم لا يعلمون" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "24" ;
        quran:hizb                     "46" ;
        quran:index                    "4183" ;
        quran:page                     "464" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:5087  quran:ayah_text            "تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ" ;
        quran:ayah_text_no_diacratic   "تبٰرك اسم ربك ذي الجلٰل والاكرام" ;
