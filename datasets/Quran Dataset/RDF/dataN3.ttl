        quran:surahnumber              "53" ;
        quran:surrahname_no_diacratic  "سورة النجم" .

quran:2911  quran:ayah_text            "أَوۡ يُلۡقَىٰٓ إِلَيۡهِ كَنزٌ أَوۡ تَكُونُ لَهُۥ جَنَّةٞ يَأۡكُلُ مِنۡهَاۚ وَقَالَ ٱلظَّٰلِمُونَ إِن تَتَّبِعُونَ إِلَّا رَجُلٗا مَّسۡحُورًا" ;
        quran:ayah_text_no_diacratic   "او يلقىٰ اليه كنز او تكون له جنة ياكل منها وقال الظٰلمون ان تتبعون الا رجلا مسحورا" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "18" ;
        quran:hizb                     "36" ;
        quran:index                    "2911" ;
        quran:page                     "360" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3815  quran:ayah_text            "لَا ٱلشَّمۡسُ يَنۢبَغِي لَهَآ أَن تُدۡرِكَ ٱلۡقَمَرَ وَلَا ٱلَّيۡلُ سَابِقُ ٱلنَّهَارِۚ وَكُلّٞ فِي فَلَكٖ يَسۡبَحُونَ" ;
        quran:ayah_text_no_diacratic   "لا الشمس ينبغي لها ان تدرك القمر ولا اليل سابق النهار وكل في فلك يسبحون" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "23" ;
        quran:hizb                     "44" ;
        quran:index                    "3815" ;
        quran:page                     "442" ;
        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:1577  quran:ayah_text            "۞وَإِلَىٰ مَدۡيَنَ أَخَاهُمۡ شُعَيۡبٗاۚ قَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥۖ وَلَا تَنقُصُواْ ٱلۡمِكۡيَالَ وَٱلۡمِيزَانَۖ إِنِّيٓ أَرَىٰكُم بِخَيۡرٖ وَإِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٖ مُّحِيطٖ" ;
        quran:ayah_text_no_diacratic   "والىٰ مدين اخاهم شعيبا قال يٰقوم اعبدوا الله ما لكم من الٰه غيره ولا تنقصوا المكيال والميزان اني ارىٰكم بخير واني اخاف عليكم عذاب يوم محيط" ;
        quran:ayahnumber               "84" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1577" ;
        quran:page                     "231" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4719  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا يَسۡخَرۡ قَوۡمٞ مِّن قَوۡمٍ عَسَىٰٓ أَن يَكُونُواْ خَيۡرٗا مِّنۡهُمۡ وَلَا نِسَآءٞ مِّن نِّسَآءٍ عَسَىٰٓ أَن يَكُنَّ خَيۡرٗا مِّنۡهُنَّۖ وَلَا تَلۡمِزُوٓاْ أَنفُسَكُمۡ وَلَا تَنَابَزُواْ بِٱلۡأَلۡقَٰبِۖ بِئۡسَ ٱلِٱسۡمُ ٱلۡفُسُوقُ بَعۡدَ ٱلۡإِيمَٰنِۚ وَمَن لَّمۡ يَتُبۡ فَأُوْلَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا يسخر قوم من قوم عسىٰ ان يكونوا خيرا منهم ولا نساء من نساء عسىٰ ان يكن خيرا منهن ولا تلمزوا انفسكم ولا تنابزوا بالالقٰب بئس الاسم الفسوق بعد الايمٰن ومن لم يتب فاولٰئك هم الظٰلمون" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4719" ;
        quran:page                     "516" ;
        quran:surahname                "سُورَةُ الحُجُرَاتِ" ;
        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:2721  quran:ayah_text            "وَٱلَّذِينَ هُمۡ لِلزَّكَوٰةِ فَٰعِلُونَ" ;
        quran:ayah_text_no_diacratic   "والذين هم للزكوٰة فٰعلون" ;
