        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:3519  quran:ayah_text            "فَإِنَّكَ لَا تُسۡمِعُ ٱلۡمَوۡتَىٰ وَلَا تُسۡمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوۡاْ مُدۡبِرِينَ" ;
        quran:ayah_text_no_diacratic   "فانك لا تسمع الموتىٰ ولا تسمع الصم الدعاء اذا ولوا مدبرين" ;
