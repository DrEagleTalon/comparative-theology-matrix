        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2009  quran:ayah_text            "وَٱللَّهُ أَخۡرَجَكُم مِّنۢ بُطُونِ أُمَّهَٰتِكُمۡ لَا تَعۡلَمُونَ شَيۡـٔٗا وَجَعَلَ لَكُمُ ٱلسَّمۡعَ وَٱلۡأَبۡصَٰرَ وَٱلۡأَفۡـِٔدَةَ لَعَلَّكُمۡ تَشۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "والله اخرجكم من بطون امهٰتكم لا تعلمون شيا وجعل لكم السمع والابصٰر والافدة لعلكم تشكرون" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2009" ;
        quran:page                     "275" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:623  quran:ayah_text             "لَّيۡسَ بِأَمَانِيِّكُمۡ وَلَآ أَمَانِيِّ أَهۡلِ ٱلۡكِتَٰبِۗ مَن يَعۡمَلۡ سُوٓءٗا يُجۡزَ بِهِۦ وَلَا يَجِدۡ لَهُۥ مِن دُونِ ٱللَّهِ وَلِيّٗا وَلَا نَصِيرٗا" ;
        quran:ayah_text_no_diacratic   "ليس بامانيكم ولا اماني اهل الكتٰب من يعمل سوءا يجز به ولا يجد له من دون الله وليا ولا نصيرا" ;
        quran:ayahnumber               "123" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "623" ;
        quran:page                     "98" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:433  quran:ayah_text             "وَٱلَّذِينَ إِذَا فَعَلُواْ فَٰحِشَةً أَوۡ ظَلَمُوٓاْ أَنفُسَهُمۡ ذَكَرُواْ ٱللَّهَ فَٱسۡتَغۡفَرُواْ لِذُنُوبِهِمۡ وَمَن يَغۡفِرُ ٱلذُّنُوبَ إِلَّا ٱللَّهُ وَلَمۡ يُصِرُّواْ عَلَىٰ مَا فَعَلُواْ وَهُمۡ يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "والذين اذا فعلوا فٰحشة او ظلموا انفسهم ذكروا الله فاستغفروا لذنوبهم ومن يغفر الذنوب الا الله ولم يصروا علىٰ ما فعلوا وهم يعلمون" ;
        quran:ayahnumber               "135" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "433" ;
        quran:page                     "67" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

