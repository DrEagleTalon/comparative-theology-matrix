quran:759  quran:ayah_text             "وَلَوۡ كَانُواْ يُؤۡمِنُونَ بِٱللَّهِ وَٱلنَّبِيِّ وَمَآ أُنزِلَ إِلَيۡهِ مَا ٱتَّخَذُوهُمۡ أَوۡلِيَآءَ وَلَٰكِنَّ كَثِيرٗا مِّنۡهُمۡ فَٰسِقُونَ" ;
        quran:ayah_text_no_diacratic   "ولو كانوا يؤمنون بالله والنبي وما انزل اليه ما اتخذوهم اولياء ولٰكن كثيرا منهم فٰسقون" ;
        quran:ayahnumber               "81" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "759" ;
        quran:page                     "121" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:1101  quran:ayah_text            "وَلَمَّا وَقَعَ عَلَيۡهِمُ ٱلرِّجۡزُ قَالُواْ يَٰمُوسَى ٱدۡعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَۖ لَئِن كَشَفۡتَ عَنَّا ٱلرِّجۡزَ لَنُؤۡمِنَنَّ لَكَ وَلَنُرۡسِلَنَّ مَعَكَ بَنِيٓ إِسۡرَٰٓءِيلَ" ;
        quran:ayah_text_no_diacratic   "ولما وقع عليهم الرجز قالوا يٰموسى ادع لنا ربك بما عهد عندك لئن كشفت عنا الرجز لنؤمنن لك ولنرسلن معك بني اسرٰءيل" ;
        quran:ayahnumber               "134" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1101" ;
        quran:page                     "166" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:569  quran:ayah_text             "وَمَن يُطِعِ ٱللَّهَ وَٱلرَّسُولَ فَأُوْلَٰٓئِكَ مَعَ ٱلَّذِينَ أَنۡعَمَ ٱللَّهُ عَلَيۡهِم مِّنَ ٱلنَّبِيِّـۧنَ وَٱلصِّدِّيقِينَ وَٱلشُّهَدَآءِ وَٱلصَّٰلِحِينَۚ وَحَسُنَ أُوْلَٰٓئِكَ رَفِيقٗا" ;
        quran:ayah_text_no_diacratic   "ومن يطع الله والرسول فاولٰئك مع الذين انعم الله عليهم من النبين والصديقين والشهداء والصٰلحين وحسن اولٰئك رفيقا" ;
        quran:ayahnumber               "69" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "569" ;
        quran:page                     "89" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2005  quran:ayah_text            "فَلَا تَضۡرِبُواْ لِلَّهِ ٱلۡأَمۡثَالَۚ إِنَّ ٱللَّهَ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "فلا تضربوا لله الامثال ان الله يعلم وانتم لا تعلمون" ;
        quran:ayahnumber               "74" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2005" ;
        quran:page                     "275" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:379  quran:ayah_text             "وَإِذۡ أَخَذَ ٱللَّهُ مِيثَٰقَ ٱلنَّبِيِّـۧنَ لَمَآ ءَاتَيۡتُكُم مِّن كِتَٰبٖ وَحِكۡمَةٖ ثُمَّ جَآءَكُمۡ رَسُولٞ مُّصَدِّقٞ لِّمَا مَعَكُمۡ لَتُؤۡمِنُنَّ بِهِۦ وَلَتَنصُرُنَّهُۥۚ قَالَ ءَأَقۡرَرۡتُمۡ وَأَخَذۡتُمۡ عَلَىٰ ذَٰلِكُمۡ إِصۡرِيۖ قَالُوٓاْ أَقۡرَرۡنَاۚ قَالَ فَٱشۡهَدُواْ وَأَنَا۠ مَعَكُم مِّنَ ٱلشَّٰهِدِينَ" ;
        quran:ayah_text_no_diacratic   "واذ اخذ الله ميثٰق النبين لما ءاتيتكم من كتٰب وحكمة ثم جاءكم رسول مصدق لما معكم لتؤمنن به ولتنصرنه قال ءاقررتم واخذتم علىٰ ذٰلكم اصري قالوا اقررنا قال فاشهدوا وانا معكم من الشٰهدين" ;
        quran:ayahnumber               "81" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "379" ;
        quran:page                     "60" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:189  quran:ayah_text             "وَلَكُمۡ فِي ٱلۡقِصَاصِ حَيَوٰةٞ يَٰٓأُوْلِي ٱلۡأَلۡبَٰبِ لَعَلَّكُمۡ تَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "ولكم في القصاص حيوٰة يٰاولي الالبٰب لعلكم تتقون" ;
