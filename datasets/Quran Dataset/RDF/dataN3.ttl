quran:958  quran:ayah_text             "هَلۡ يَنظُرُونَ إِلَّآ أَن تَأۡتِيَهُمُ ٱلۡمَلَٰٓئِكَةُ أَوۡ يَأۡتِيَ رَبُّكَ أَوۡ يَأۡتِيَ بَعۡضُ ءَايَٰتِ رَبِّكَۗ يَوۡمَ يَأۡتِي بَعۡضُ ءَايَٰتِ رَبِّكَ لَا يَنفَعُ نَفۡسًا إِيمَٰنُهَا لَمۡ تَكُنۡ ءَامَنَتۡ مِن قَبۡلُ أَوۡ كَسَبَتۡ فِيٓ إِيمَٰنِهَا خَيۡرٗاۗ قُلِ ٱنتَظِرُوٓاْ إِنَّا مُنتَظِرُونَ" ;
        quran:ayah_text_no_diacratic   "هل ينظرون الا ان تاتيهم الملٰئكة او ياتي ربك او ياتي بعض ءايٰت ربك يوم ياتي بعض ءايٰت ربك لا ينفع نفسا ايمٰنها لم تكن ءامنت من قبل او كسبت في ايمٰنها خيرا قل انتظروا انا منتظرون" ;
        quran:ayahnumber               "158" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "958" ;
        quran:page                     "150" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1300  quran:ayah_text            "وَمِنۡهُم مَّن يَقُولُ ٱئۡذَن لِّي وَلَا تَفۡتِنِّيٓۚ أَلَا فِي ٱلۡفِتۡنَةِ سَقَطُواْۗ وَإِنَّ جَهَنَّمَ لَمُحِيطَةُۢ بِٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "ومنهم من يقول ائذن لي ولا تفتني الا في الفتنة سقطوا وان جهنم لمحيطة بالكٰفرين" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1300" ;
        quran:page                     "195" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:768  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِنَّمَا ٱلۡخَمۡرُ وَٱلۡمَيۡسِرُ وَٱلۡأَنصَابُ وَٱلۡأَزۡلَٰمُ رِجۡسٞ مِّنۡ عَمَلِ ٱلشَّيۡطَٰنِ فَٱجۡتَنِبُوهُ لَعَلَّكُمۡ تُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا انما الخمر والميسر والانصاب والازلٰم رجس من عمل الشيطٰن فاجتنبوه لعلكم تفلحون" ;
        quran:ayahnumber               "90" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "768" ;
        quran:page                     "122" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2204  quran:ayah_text            "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ إِنَّا لَا نُضِيعُ أَجۡرَ مَنۡ أَحۡسَنَ عَمَلًا" ;
        quran:ayah_text_no_diacratic   "ان الذين ءامنوا وعملوا الصٰلحٰت انا لا نضيع اجر من احسن عملا" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2204" ;
        quran:page                     "297" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1110  quran:ayah_text            "وَلَمَّا جَآءَ مُوسَىٰ لِمِيقَٰتِنَا وَكَلَّمَهُۥ رَبُّهُۥ قَالَ رَبِّ أَرِنِيٓ أَنظُرۡ إِلَيۡكَۚ قَالَ لَن تَرَىٰنِي وَلَٰكِنِ ٱنظُرۡ إِلَى ٱلۡجَبَلِ فَإِنِ ٱسۡتَقَرَّ مَكَانَهُۥ فَسَوۡفَ تَرَىٰنِيۚ فَلَمَّا تَجَلَّىٰ رَبُّهُۥ لِلۡجَبَلِ جَعَلَهُۥ دَكّٗا وَخَرَّ مُوسَىٰ صَعِقٗاۚ فَلَمَّآ أَفَاقَ قَالَ سُبۡحَٰنَكَ تُبۡتُ إِلَيۡكَ وَأَنَا۠ أَوَّلُ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "ولما جاء موسىٰ لميقٰتنا وكلمه ربه قال رب ارني انظر اليك قال لن ترىٰني ولٰكن انظر الى الجبل فان استقر مكانه فسوف ترىٰني فلما تجلىٰ ربه للجبل جعله دكا وخر موسىٰ صعقا فلما افاق قال سبحٰنك تبت اليك وانا اول المؤمنين" ;
        quran:ayahnumber               "143" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1110" ;
        quran:page                     "167" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:3108  quran:ayah_text            "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ" ;
        quran:ayah_text_no_diacratic   "فاتقوا الله واطيعون" ;
        quran:ayahnumber               "126" ;
        quran:chapter                  "19" ;
