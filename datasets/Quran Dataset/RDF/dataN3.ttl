quran:4920  quran:ayah_text            "ٱلَّذِينَ يَجۡتَنِبُونَ كَبَٰٓئِرَ ٱلۡإِثۡمِ وَٱلۡفَوَٰحِشَ إِلَّا ٱللَّمَمَۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلۡمَغۡفِرَةِۚ هُوَ أَعۡلَمُ بِكُمۡ إِذۡ أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ وَإِذۡ أَنتُمۡ أَجِنَّةٞ فِي بُطُونِ أُمَّهَٰتِكُمۡۖ فَلَا تُزَكُّوٓاْ أَنفُسَكُمۡۖ هُوَ أَعۡلَمُ بِمَنِ ٱتَّقَىٰٓ" ;
        quran:ayah_text_no_diacratic   "الذين يجتنبون كبٰئر الاثم والفوٰحش الا اللمم ان ربك وٰسع المغفرة هو اعلم بكم اذ انشاكم من الارض واذ انتم اجنة في بطون امهٰتكم فلا تزكوا انفسكم هو اعلم بمن اتقىٰ" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "27" ;
        quran:hizb                     "52" ;
        quran:index                    "4920" ;
        quran:page                     "527" ;
        quran:surahname                "سُورَةُ النَّجۡمِ" ;
        quran:surahnumber              "53" ;
        quran:surrahname_no_diacratic  "سورة النجم" .

quran:2682  quran:ayah_text            "فَكَأَيِّن مِّن قَرۡيَةٍ أَهۡلَكۡنَٰهَا وَهِيَ ظَالِمَةٞ فَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَبِئۡرٖ مُّعَطَّلَةٖ وَقَصۡرٖ مَّشِيدٍ" ;
        quran:ayah_text_no_diacratic   "فكاين من قرية اهلكنٰها وهي ظالمة فهي خاوية علىٰ عروشها وبئر معطلة وقصر مشيد" ;
