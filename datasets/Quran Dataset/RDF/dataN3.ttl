quran:1021  quran:ayah_text            "إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ يُغۡشِي ٱلَّيۡلَ ٱلنَّهَارَ يَطۡلُبُهُۥ حَثِيثٗا وَٱلشَّمۡسَ وَٱلۡقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتِۭ بِأَمۡرِهِۦٓۗ أَلَا لَهُ ٱلۡخَلۡقُ وَٱلۡأَمۡرُۗ تَبَارَكَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "ان ربكم الله الذي خلق السمٰوٰت والارض في ستة ايام ثم استوىٰ على العرش يغشي اليل النهار يطلبه حثيثا والشمس والقمر والنجوم مسخرٰت بامره الا له الخلق والامر تبارك الله رب العٰلمين" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1021" ;
        quran:page                     "157" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:489  quran:ayah_text             "ٱلَّذِينَ يَذۡكُرُونَ ٱللَّهَ قِيَٰمٗا وَقُعُودٗا وَعَلَىٰ جُنُوبِهِمۡ وَيَتَفَكَّرُونَ فِي خَلۡقِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ رَبَّنَا مَا خَلَقۡتَ هَٰذَا بَٰطِلٗا سُبۡحَٰنَكَ فَقِنَا عَذَابَ ٱلنَّارِ" ;
        quran:ayah_text_no_diacratic   "الذين يذكرون الله قيٰما وقعودا وعلىٰ جنوبهم ويتفكرون في خلق السمٰوٰت والارض ربنا ما خلقت هٰذا بٰطلا سبحٰنك فقنا عذاب النار" ;
        quran:ayahnumber               "191" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "489" ;
        quran:page                     "75" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

