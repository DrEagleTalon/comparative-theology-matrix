quran:3443  quran:ayah_text            "وَكَذَٰلِكَ أَنزَلۡنَآ إِلَيۡكَ ٱلۡكِتَٰبَۚ فَٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يُؤۡمِنُونَ بِهِۦۖ وَمِنۡ هَٰٓؤُلَآءِ مَن يُؤۡمِنُ بِهِۦۚ وَمَا يَجۡحَدُ بِـَٔايَٰتِنَآ إِلَّا ٱلۡكَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك انزلنا اليك الكتٰب فالذين ءاتينٰهم الكتٰب يؤمنون به ومن هٰؤلاء من يؤمن به وما يجحد بايٰتنا الا الكٰفرون" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3443" ;
        quran:page                     "402" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
