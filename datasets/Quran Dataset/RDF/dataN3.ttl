quran:3714  quran:ayah_text            "فَٱلۡيَوۡمَ لَا يَمۡلِكُ بَعۡضُكُمۡ لِبَعۡضٖ نَّفۡعٗا وَلَا ضَرّٗا وَنَقُولُ لِلَّذِينَ ظَلَمُواْ ذُوقُواْ عَذَابَ ٱلنَّارِ ٱلَّتِي كُنتُم بِهَا تُكَذِّبُونَ" ;
        quran:ayah_text_no_diacratic   "فاليوم لا يملك بعضكم لبعض نفعا ولا ضرا ونقول للذين ظلموا ذوقوا عذاب النار التي كنتم بها تكذبون" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3714" ;
        quran:page                     "433" ;
        quran:surahname                "سُورَةُ سَبَإٍ" ;
        quran:surahnumber              "34" ;
        quran:surrahname_no_diacratic  "سورة سبا" .

quran:1476  quran:ayah_text            "فَإِن كُنتَ فِي شَكّٖ مِّمَّآ أَنزَلۡنَآ إِلَيۡكَ فَسۡـَٔلِ ٱلَّذِينَ يَقۡرَءُونَ ٱلۡكِتَٰبَ مِن قَبۡلِكَۚ لَقَدۡ جَآءَكَ ٱلۡحَقُّ مِن رَّبِّكَ فَلَا تَكُونَنَّ مِنَ ٱلۡمُمۡتَرِينَ" ;
        quran:ayah_text_no_diacratic   "فان كنت في شك مما انزلنا اليك فسل الذين يقرءون الكتٰب من قبلك لقد جاءك الحق من ربك فلا تكونن من الممترين" ;
        quran:ayahnumber               "94" ;
        quran:chapter                  "11" ;
        quran:hizb                     "22" ;
        quran:index                    "1476" ;
        quran:page                     "219" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4618  quran:ayah_text            "أُوْلَٰٓئِكَ ٱلَّذِينَ حَقَّ عَلَيۡهِمُ ٱلۡقَوۡلُ فِيٓ أُمَمٖ قَدۡ خَلَتۡ مِن قَبۡلِهِم مِّنَ ٱلۡجِنِّ وَٱلۡإِنسِۖ إِنَّهُمۡ كَانُواْ خَٰسِرِينَ" ;
        quran:ayah_text_no_diacratic   "اولٰئك الذين حق عليهم القول في امم قد خلت من قبلهم من الجن والانس انهم كانوا خٰسرين" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4618" ;
        quran:page                     "504" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2620  quran:ayah_text            "وَٱقۡتَرَبَ ٱلۡوَعۡدُ ٱلۡحَقُّ فَإِذَا هِيَ شَٰخِصَةٌ أَبۡصَٰرُ ٱلَّذِينَ كَفَرُواْ يَٰوَيۡلَنَا قَدۡ كُنَّا فِي غَفۡلَةٖ مِّنۡ هَٰذَا بَلۡ كُنَّا ظَٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "واقترب الوعد الحق فاذا هي شٰخصة ابصٰر الذين كفروا يٰويلنا قد كنا في غفلة من هٰذا بل كنا ظٰلمين" ;
        quran:ayahnumber               "97" ;
