quran:2865  quran:ayah_text            "فَإِن لَّمۡ تَجِدُواْ فِيهَآ أَحَدٗا فَلَا تَدۡخُلُوهَا حَتَّىٰ يُؤۡذَنَ لَكُمۡۖ وَإِن قِيلَ لَكُمُ ٱرۡجِعُواْ فَٱرۡجِعُواْۖ هُوَ أَزۡكَىٰ لَكُمۡۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "فان لم تجدوا فيها احدا فلا تدخلوها حتىٰ يؤذن لكم وان قيل لكم ارجعوا فارجعوا هو ازكىٰ لكم والله بما تعملون عليم" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2865" ;
        quran:page                     "353" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1771  quran:ayah_text            "وَإِن مَّا نُرِيَنَّكَ بَعۡضَ ٱلَّذِي نَعِدُهُمۡ أَوۡ نَتَوَفَّيَنَّكَ فَإِنَّمَا عَلَيۡكَ ٱلۡبَلَٰغُ وَعَلَيۡنَا ٱلۡحِسَابُ" ;
        quran:ayah_text_no_diacratic   "وان ما نرينك بعض الذي نعدهم او نتوفينك فانما عليك البلٰغ وعلينا الحساب" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1771" ;
        quran:page                     "254" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:3769  quran:ayah_text            "۞إِنَّ ٱللَّهَ يُمۡسِكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ أَن تَزُولَاۚ وَلَئِن زَالَتَآ إِنۡ أَمۡسَكَهُمَا مِنۡ أَحَدٖ مِّنۢ بَعۡدِهِۦٓۚ إِنَّهُۥ كَانَ حَلِيمًا غَفُورٗا" ;
        quran:ayah_text_no_diacratic   "ان الله يمسك السمٰوٰت والارض ان تزولا ولئن زالتا ان امسكهما من احد من بعده انه كان حليما غفورا" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "22" ;
        quran:hizb                     "44" ;
        quran:index                    "3769" ;
        quran:page                     "439" ;
        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:4913  quran:ayah_text            "فَلِلَّهِ ٱلۡأٓخِرَةُ وَٱلۡأُولَىٰ" ;
