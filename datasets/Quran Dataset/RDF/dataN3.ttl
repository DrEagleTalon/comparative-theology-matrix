        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2072  quran:ayah_text            "وَيَدۡعُ ٱلۡإِنسَٰنُ بِٱلشَّرِّ دُعَآءَهُۥ بِٱلۡخَيۡرِۖ وَكَانَ ٱلۡإِنسَٰنُ عَجُولٗا" ;
