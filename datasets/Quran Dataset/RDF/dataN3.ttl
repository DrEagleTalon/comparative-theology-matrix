quran:1063  quran:ayah_text            "وَلَوۡ أَنَّ أَهۡلَ ٱلۡقُرَىٰٓ ءَامَنُواْ وَٱتَّقَوۡاْ لَفَتَحۡنَا عَلَيۡهِم بَرَكَٰتٖ مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِ وَلَٰكِن كَذَّبُواْ فَأَخَذۡنَٰهُم بِمَا كَانُواْ يَكۡسِبُونَ" ;
        quran:ayah_text_no_diacratic   "ولو ان اهل القرىٰ ءامنوا واتقوا لفتحنا عليهم بركٰت من السماء والارض ولٰكن كذبوا فاخذنٰهم بما كانوا يكسبون" ;
        quran:ayahnumber               "96" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1063" ;
        quran:page                     "163" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:771  quran:ayah_text             "لَيۡسَ عَلَى ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ جُنَاحٞ فِيمَا طَعِمُوٓاْ إِذَا مَا ٱتَّقَواْ وَّءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ ثُمَّ ٱتَّقَواْ وَّءَامَنُواْ ثُمَّ ٱتَّقَواْ وَّأَحۡسَنُواْۚ وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "ليس على الذين ءامنوا وعملوا الصٰلحٰت جناح فيما طعموا اذا ما اتقوا وءامنوا وعملوا الصٰلحٰت ثم اتقوا وءامنوا ثم اتقوا واحسنوا والله يحب المحسنين" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "771" ;
        quran:page                     "123" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:4205  quran:ayah_text            "وَسِيقَ ٱلَّذِينَ كَفَرُوٓاْ إِلَىٰ جَهَنَّمَ زُمَرًاۖ حَتَّىٰٓ إِذَا جَآءُوهَا فُتِحَتۡ أَبۡوَٰبُهَا وَقَالَ لَهُمۡ خَزَنَتُهَآ أَلَمۡ يَأۡتِكُمۡ رُسُلٞ مِّنكُمۡ يَتۡلُونَ عَلَيۡكُمۡ ءَايَٰتِ رَبِّكُمۡ وَيُنذِرُونَكُمۡ لِقَآءَ يَوۡمِكُمۡ هَٰذَاۚ قَالُواْ بَلَىٰ وَلَٰكِنۡ حَقَّتۡ كَلِمَةُ ٱلۡعَذَابِ عَلَى ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "وسيق الذين كفروا الىٰ جهنم زمرا حتىٰ اذا جاءوها فتحت ابوٰبها وقال لهم خزنتها الم ياتكم رسل منكم يتلون عليكم ءايٰت ربكم وينذرونكم لقاء يومكم هٰذا قالوا بلىٰ ولٰكن حقت كلمة العذاب على الكٰفرين" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "24" ;
        quran:hizb                     "46" ;
        quran:index                    "4205" ;
        quran:page                     "466" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

