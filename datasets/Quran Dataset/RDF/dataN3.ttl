quran:597  quran:ayah_text             "إِنَّ ٱلَّذِينَ تَوَفَّىٰهُمُ ٱلۡمَلَٰٓئِكَةُ ظَالِمِيٓ أَنفُسِهِمۡ قَالُواْ فِيمَ كُنتُمۡۖ قَالُواْ كُنَّا مُسۡتَضۡعَفِينَ فِي ٱلۡأَرۡضِۚ قَالُوٓاْ أَلَمۡ تَكُنۡ أَرۡضُ ٱللَّهِ وَٰسِعَةٗ فَتُهَاجِرُواْ فِيهَاۚ فَأُوْلَٰٓئِكَ مَأۡوَىٰهُمۡ جَهَنَّمُۖ وَسَآءَتۡ مَصِيرًا" ;
        quran:ayah_text_no_diacratic   "ان الذين توفىٰهم الملٰئكة ظالمي انفسهم قالوا فيم كنتم قالوا كنا مستضعفين في الارض قالوا الم تكن ارض الله وٰسعة فتهاجروا فيها فاولٰئك ماوىٰهم جهنم وساءت مصيرا" ;
        quran:ayahnumber               "97" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "597" ;
        quran:page                     "94" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2033  quran:ayah_text            "قُلۡ نَزَّلَهُۥ رُوحُ ٱلۡقُدُسِ مِن رَّبِّكَ بِٱلۡحَقِّ لِيُثَبِّتَ ٱلَّذِينَ ءَامَنُواْ وَهُدٗى وَبُشۡرَىٰ لِلۡمُسۡلِمِينَ" ;
        quran:ayah_text_no_diacratic   "قل نزله روح القدس من ربك بالحق ليثبت الذين ءامنوا وهدى وبشرىٰ للمسلمين" ;
