        quran:index                    "3826" ;
        quran:page                     "443" ;
        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:1588  quran:ayah_text            "كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَآۗ أَلَا بُعۡدٗا لِّمَدۡيَنَ كَمَا بَعِدَتۡ ثَمُودُ" ;
        quran:ayah_text_no_diacratic   "كان لم يغنوا فيها الا بعدا لمدين كما بعدت ثمود" ;
        quran:ayahnumber               "95" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1588" ;
        quran:page                     "232" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2732  quran:ayah_text            "ثُمَّ إِنَّكُم بَعۡدَ ذَٰلِكَ لَمَيِّتُونَ" ;
        quran:ayah_text_no_diacratic   "ثم انكم بعد ذٰلك لميتون" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2732" ;
        quran:page                     "342" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3636  quran:ayah_text            "ٱلَّذِينَ يُبَلِّغُونَ رِسَٰلَٰتِ ٱللَّهِ وَيَخۡشَوۡنَهُۥ وَلَا يَخۡشَوۡنَ أَحَدًا إِلَّا ٱللَّهَۗ وَكَفَىٰ بِٱللَّهِ حَسِيبٗا" ;
        quran:ayah_text_no_diacratic   "الذين يبلغون رسٰلٰت الله ويخشونه ولا يخشون احدا الا الله وكفىٰ بالله حسيبا" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3636" ;
        quran:page                     "423" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1398  quran:ayah_text            "قُل لَّوۡ شَآءَ ٱللَّهُ مَا تَلَوۡتُهُۥ عَلَيۡكُمۡ وَلَآ أَدۡرَىٰكُم بِهِۦۖ فَقَدۡ لَبِثۡتُ فِيكُمۡ عُمُرٗا مِّن قَبۡلِهِۦٓۚ أَفَلَا تَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "قل لو شاء الله ما تلوته عليكم ولا ادرىٰكم به فقد لبثت فيكم عمرا من قبله افلا تعقلون" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1398" ;
        quran:page                     "210" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2542  quran:ayah_text            "وَلَهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَمَنۡ عِندَهُۥ لَا يَسۡتَكۡبِرُونَ عَنۡ عِبَادَتِهِۦ وَلَا يَسۡتَحۡسِرُونَ" ;
        quran:ayah_text_no_diacratic   "وله من في السمٰوٰت والارض ومن عنده لا يستكبرون عن عبادته ولا يستحسرون" ;
        quran:ayahnumber               "19" ;
