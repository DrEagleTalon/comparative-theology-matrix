quran:1564  quran:ayah_text            "وَٱمۡرَأَتُهُۥ قَآئِمَةٞ فَضَحِكَتۡ فَبَشَّرۡنَٰهَا بِإِسۡحَٰقَ وَمِن وَرَآءِ إِسۡحَٰقَ يَعۡقُوبَ" ;
        quran:ayah_text_no_diacratic   "وامراته قائمة فضحكت فبشرنٰها باسحٰق ومن وراء اسحٰق يعقوب" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1564" ;
        quran:page                     "229" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4706  quran:ayah_text            "مُّحَمَّدٞ رَّسُولُ ٱللَّهِۚ وَٱلَّذِينَ مَعَهُۥٓ أَشِدَّآءُ عَلَى ٱلۡكُفَّارِ رُحَمَآءُ بَيۡنَهُمۡۖ تَرَىٰهُمۡ رُكَّعٗا سُجَّدٗا يَبۡتَغُونَ فَضۡلٗا مِّنَ ٱللَّهِ وَرِضۡوَٰنٗاۖ سِيمَاهُمۡ فِي وُجُوهِهِم مِّنۡ أَثَرِ ٱلسُّجُودِۚ ذَٰلِكَ مَثَلُهُمۡ فِي ٱلتَّوۡرَىٰةِۚ وَمَثَلُهُمۡ فِي ٱلۡإِنجِيلِ كَزَرۡعٍ أَخۡرَجَ شَطۡـَٔهُۥ فَـَٔازَرَهُۥ فَٱسۡتَغۡلَظَ فَٱسۡتَوَىٰ عَلَىٰ سُوقِهِۦ يُعۡجِبُ ٱلزُّرَّاعَ لِيَغِيظَ بِهِمُ ٱلۡكُفَّارَۗ وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ مِنۡهُم مَّغۡفِرَةٗ وَأَجۡرًا عَظِيمَۢا" ;
        quran:ayah_text_no_diacratic   "محمد رسول الله والذين معه اشداء على الكفار رحماء بينهم ترىٰهم ركعا سجدا يبتغون فضلا من الله ورضوٰنا سيماهم في وجوههم من اثر السجود ذٰلك مثلهم في التورىٰة ومثلهم في الانجيل كزرع اخرج شطه فازره فاستغلظ فاستوىٰ علىٰ سوقه يعجب الزراع ليغيظ بهم الكفار وعد الله الذين ءامنوا وعملوا الصٰلحٰت منهم مغفرة واجرا عظيما" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4706" ;
        quran:page                     "515" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:2468  quran:ayah_text            "وَإِنِّي لَغَفَّارٞ لِّمَن تَابَ وَءَامَنَ وَعَمِلَ صَٰلِحٗا ثُمَّ ٱهۡتَدَىٰ" ;
        quran:ayah_text_no_diacratic   "واني لغفار لمن تاب وءامن وعمل صٰلحا ثم اهتدىٰ" ;
        quran:ayahnumber               "82" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2468" ;
