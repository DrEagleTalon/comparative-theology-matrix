        quran:surahname                "سُورَةُ الحِجۡرِ" ;
        quran:surahnumber              "15" ;
        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:3838  quran:ayah_text            "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي كُنتُمۡ تُوعَدُونَ" ;
        quran:ayah_text_no_diacratic   "هٰذه جهنم التي كنتم توعدون" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "23" ;
