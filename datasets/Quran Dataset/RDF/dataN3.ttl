quran:4293  quran:ayah_text            "أَفَلَمۡ يَسِيرُواْ فِي ٱلۡأَرۡضِ فَيَنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَانُوٓاْ أَكۡثَرَ مِنۡهُمۡ وَأَشَدَّ قُوَّةٗ وَءَاثَارٗا فِي ٱلۡأَرۡضِ فَمَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يَكۡسِبُونَ" ;
        quran:ayah_text_no_diacratic   "افلم يسيروا في الارض فينظروا كيف كان عٰقبة الذين من قبلهم كانوا اكثر منهم واشد قوة وءاثارا في الارض فما اغنىٰ عنهم ما كانوا يكسبون" ;
        quran:ayahnumber               "82" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4293" ;
        quran:page                     "476" ;
        quran:surahname                "سُورَةُ غَافِرٍ" ;
        quran:surahnumber              "40" ;
        quran:surrahname_no_diacratic  "سورة غافر" .

quran:1702  quran:ayah_text            "وَتَوَلَّىٰ عَنۡهُمۡ وَقَالَ يَٰٓأَسَفَىٰ عَلَىٰ يُوسُفَ وَٱبۡيَضَّتۡ عَيۡنَاهُ مِنَ ٱلۡحُزۡنِ فَهُوَ كَظِيمٞ" ;
        quran:ayah_text_no_diacratic   "وتولىٰ عنهم وقال يٰاسفىٰ علىٰ يوسف وابيضت عيناه من الحزن فهو كظيم" ;
        quran:ayahnumber               "84" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1702" ;
        quran:page                     "245" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5197  quran:ayah_text            "وَمَا لَكُمۡ أَلَّا تُنفِقُواْ فِي سَبِيلِ ٱللَّهِ وَلِلَّهِ مِيرَٰثُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ لَا يَسۡتَوِي مِنكُم مَّنۡ أَنفَقَ مِن قَبۡلِ ٱلۡفَتۡحِ وَقَٰتَلَۚ أُوْلَٰٓئِكَ أَعۡظَمُ دَرَجَةٗ مِّنَ ٱلَّذِينَ أَنفَقُواْ مِنۢ بَعۡدُ وَقَٰتَلُواْۚ وَكُلّٗا وَعَدَ ٱللَّهُ ٱلۡحُسۡنَىٰۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ" ;
        quran:ayah_text_no_diacratic   "وما لكم الا تنفقوا في سبيل الله ولله ميرٰث السمٰوٰت والارض لا يستوي منكم من انفق من قبل الفتح وقٰتل اولٰئك اعظم درجة من الذين انفقوا من بعد وقٰتلوا وكلا وعد الله الحسنىٰ والله بما تعملون خبير" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "27" ;
        quran:hizb                     "53" ;
        quran:index                    "5197" ;
        quran:page                     "538" ;
        quran:surahname                "سُورَةُ الحَدِيدِ" ;
        quran:surahnumber              "57" ;
        quran:surrahname_no_diacratic  "سورة الحديد" .

quran:2606  quran:ayah_text            "۞وَأَيُّوبَ إِذۡ نَادَىٰ رَبَّهُۥٓ أَنِّي مَسَّنِيَ ٱلضُّرُّ وَأَنتَ أَرۡحَمُ ٱلرَّٰحِمِينَ" ;
