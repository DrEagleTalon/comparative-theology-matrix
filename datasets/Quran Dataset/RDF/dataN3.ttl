quran:1736  quran:ayah_text            "۞وَإِن تَعۡجَبۡ فَعَجَبٞ قَوۡلُهُمۡ أَءِذَا كُنَّا تُرَٰبًا أَءِنَّا لَفِي خَلۡقٖ جَدِيدٍۗ أُوْلَٰٓئِكَ ٱلَّذِينَ كَفَرُواْ بِرَبِّهِمۡۖ وَأُوْلَٰٓئِكَ ٱلۡأَغۡلَٰلُ فِيٓ أَعۡنَاقِهِمۡۖ وَأُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ" ;
        quran:ayah_text_no_diacratic   "وان تعجب فعجب قولهم اءذا كنا ترٰبا اءنا لفي خلق جديد اولٰئك الذين كفروا بربهم واولٰئك الاغلٰل في اعناقهم واولٰئك اصحٰب النار هم فيها خٰلدون" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1736" ;
        quran:page                     "249" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

