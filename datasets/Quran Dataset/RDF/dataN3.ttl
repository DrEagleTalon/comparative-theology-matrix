quran:5861  quran:ayah_text            "لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا" ;
        quran:ayah_text_no_diacratic   "لا يسمعون فيها لغوا ولا كذٰبا" ;
