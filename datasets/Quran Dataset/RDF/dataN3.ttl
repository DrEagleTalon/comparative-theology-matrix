        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:628  quran:ayah_text             "وَإِنِ ٱمۡرَأَةٌ خَافَتۡ مِنۢ بَعۡلِهَا نُشُوزًا أَوۡ إِعۡرَاضٗا فَلَا جُنَاحَ عَلَيۡهِمَآ أَن يُصۡلِحَا بَيۡنَهُمَا صُلۡحٗاۚ وَٱلصُّلۡحُ خَيۡرٞۗ وَأُحۡضِرَتِ ٱلۡأَنفُسُ ٱلشُّحَّۚ وَإِن تُحۡسِنُواْ وَتَتَّقُواْ فَإِنَّ ٱللَّهَ كَانَ بِمَا تَعۡمَلُونَ خَبِيرٗا" ;
        quran:ayah_text_no_diacratic   "وان امراة خافت من بعلها نشوزا او اعراضا فلا جناح عليهما ان يصلحا بينهما صلحا والصلح خير واحضرت الانفس الشح وان تحسنوا وتتقوا فان الله كان بما تعملون خبيرا" ;
        quran:ayahnumber               "128" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "628" ;
        quran:page                     "99" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:438  quran:ayah_text             "إِن يَمۡسَسۡكُمۡ قَرۡحٞ فَقَدۡ مَسَّ ٱلۡقَوۡمَ قَرۡحٞ مِّثۡلُهُۥۚ وَتِلۡكَ ٱلۡأَيَّامُ نُدَاوِلُهَا بَيۡنَ ٱلنَّاسِ وَلِيَعۡلَمَ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ وَيَتَّخِذَ مِنكُمۡ شُهَدَآءَۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "ان يمسسكم قرح فقد مس القوم قرح مثله وتلك الايام نداولها بين الناس وليعلم الله الذين ءامنوا ويتخذ منكم شهداء والله لا يحب الظٰلمين" ;
        quran:ayahnumber               "140" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "438" ;
        quran:page                     "67" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5967  quran:ayah_text            "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ" ;
