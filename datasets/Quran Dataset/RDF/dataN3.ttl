quran:941  quran:ayah_text             "۞وَهُوَ ٱلَّذِيٓ أَنشَأَ جَنَّٰتٖ مَّعۡرُوشَٰتٖ وَغَيۡرَ مَعۡرُوشَٰتٖ وَٱلنَّخۡلَ وَٱلزَّرۡعَ مُخۡتَلِفًا أُكُلُهُۥ وَٱلزَّيۡتُونَ وَٱلرُّمَّانَ مُتَشَٰبِهٗا وَغَيۡرَ مُتَشَٰبِهٖۚ كُلُواْ مِن ثَمَرِهِۦٓ إِذَآ أَثۡمَرَ وَءَاتُواْ حَقَّهُۥ يَوۡمَ حَصَادِهِۦۖ وَلَا تُسۡرِفُوٓاْۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡمُسۡرِفِينَ" ;
        quran:ayah_text_no_diacratic   "وهو الذي انشا جنٰت معروشٰت وغير معروشٰت والنخل والزرع مختلفا اكله والزيتون والرمان متشٰبها وغير متشٰبه كلوا من ثمره اذا اثمر وءاتوا حقه يوم حصاده ولا تسرفوا انه لا يحب المسرفين" ;
        quran:ayahnumber               "141" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "941" ;
        quran:page                     "146" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2137  quran:ayah_text            "وَإِن كَادُواْ لَيَسۡتَفِزُّونَكَ مِنَ ٱلۡأَرۡضِ لِيُخۡرِجُوكَ مِنۡهَاۖ وَإِذٗا لَّا يَلۡبَثُونَ خِلَٰفَكَ إِلَّا قَلِيلٗا" ;
        quran:ayah_text_no_diacratic   "وان كادوا ليستفزونك من الارض ليخرجوك منها واذا لا يلبثون خلٰفك الا قليلا" ;
        quran:ayahnumber               "76" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2137" ;
        quran:page                     "290" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1043  quran:ayah_text            "قَالَ ٱلَّذِينَ ٱسۡتَكۡبَرُوٓاْ إِنَّا بِٱلَّذِيٓ ءَامَنتُم بِهِۦ كَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "قال الذين استكبروا انا بالذي ءامنتم به كٰفرون" ;
