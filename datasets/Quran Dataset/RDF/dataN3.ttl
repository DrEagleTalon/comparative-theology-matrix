quran:1279  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِنَّمَا ٱلۡمُشۡرِكُونَ نَجَسٞ فَلَا يَقۡرَبُواْ ٱلۡمَسۡجِدَ ٱلۡحَرَامَ بَعۡدَ عَامِهِمۡ هَٰذَاۚ وَإِنۡ خِفۡتُمۡ عَيۡلَةٗ فَسَوۡفَ يُغۡنِيكُمُ ٱللَّهُ مِن فَضۡلِهِۦٓ إِن شَآءَۚ إِنَّ ٱللَّهَ عَلِيمٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا انما المشركون نجس فلا يقربوا المسجد الحرام بعد عامهم هٰذا وان خفتم عيلة فسوف يغنيكم الله من فضله ان شاء ان الله عليم حكيم" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1279" ;
        quran:page                     "191" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:987  quran:ayah_text             "فَوَسۡوَسَ لَهُمَا ٱلشَّيۡطَٰنُ لِيُبۡدِيَ لَهُمَا مَا وُۥرِيَ عَنۡهُمَا مِن سَوۡءَٰتِهِمَا وَقَالَ مَا نَهَىٰكُمَا رَبُّكُمَا عَنۡ هَٰذِهِ ٱلشَّجَرَةِ إِلَّآ أَن تَكُونَا مَلَكَيۡنِ أَوۡ تَكُونَا مِنَ ٱلۡخَٰلِدِينَ" ;
        quran:ayah_text_no_diacratic   "فوسوس لهما الشيطٰن ليبدي لهما ما وري عنهما من سوءٰتهما وقال ما نهىٰكما ربكما عن هٰذه الشجرة الا ان تكونا ملكين او تكونا من الخٰلدين" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "987" ;
        quran:page                     "152" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:2423  quran:ayah_text            "وَلَقَدۡ مَنَنَّا عَلَيۡكَ مَرَّةً أُخۡرَىٰٓ" ;
        quran:ayah_text_no_diacratic   "ولقد مننا عليك مرة اخرىٰ" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2423" ;
        quran:page                     "313" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:3327  quran:ayah_text            "فَخَرَجَ مِنۡهَا خَآئِفٗا يَتَرَقَّبُۖ قَالَ رَبِّ نَجِّنِي مِنَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "فخرج منها خائفا يترقب قال رب نجني من القوم الظٰلمين" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3327" ;
        quran:page                     "387" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1089  quran:ayah_text            "رَبِّ مُوسَىٰ وَهَٰرُونَ" ;
        quran:ayah_text_no_diacratic   "رب موسىٰ وهٰرون" ;
        quran:ayahnumber               "122" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1089" ;
