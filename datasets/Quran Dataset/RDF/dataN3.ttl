        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:3895  quran:ayah_text            "إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ" ;
        quran:ayah_text_no_diacratic   "انهم كانوا اذا قيل لهم لا الٰه الا الله يستكبرون" ;
