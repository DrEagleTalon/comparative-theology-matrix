quran:204  quran:ayah_text             "ٱلشَّهۡرُ ٱلۡحَرَامُ بِٱلشَّهۡرِ ٱلۡحَرَامِ وَٱلۡحُرُمَٰتُ قِصَاصٞۚ فَمَنِ ٱعۡتَدَىٰ عَلَيۡكُمۡ فَٱعۡتَدُواْ عَلَيۡهِ بِمِثۡلِ مَا ٱعۡتَدَىٰ عَلَيۡكُمۡۚ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَعَ ٱلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "الشهر الحرام بالشهر الحرام والحرمٰت قصاص فمن اعتدىٰ عليكم فاعتدوا عليه بمثل ما اعتدىٰ عليكم واتقوا الله واعلموا ان الله مع المتقين" ;
        quran:ayahnumber               "194" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "204" ;
        quran:page                     "30" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

