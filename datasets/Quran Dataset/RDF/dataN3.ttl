quran:6055  quran:ayah_text            "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ" ;
        quran:ayah_text_no_diacratic   "واذنت لربها وحقت" ;
        quran:ayahnumber               "5" ;
