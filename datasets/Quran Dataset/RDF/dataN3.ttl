        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:1090  quran:ayah_text            "قَالَ فِرۡعَوۡنُ ءَامَنتُم بِهِۦ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّ هَٰذَا لَمَكۡرٞ مَّكَرۡتُمُوهُ فِي ٱلۡمَدِينَةِ لِتُخۡرِجُواْ مِنۡهَآ أَهۡلَهَاۖ فَسَوۡفَ تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "قال فرعون ءامنتم به قبل ان ءاذن لكم ان هٰذا لمكر مكرتموه في المدينة لتخرجوا منها اهلها فسوف تعلمون" ;
        quran:ayahnumber               "123" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1090" ;
        quran:page                     "165" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:4232  quran:ayah_text            "۞أَوَلَمۡ يَسِيرُواْ فِي ٱلۡأَرۡضِ فَيَنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ كَانُواْ مِن قَبۡلِهِمۡۚ كَانُواْ هُمۡ أَشَدَّ مِنۡهُمۡ قُوَّةٗ وَءَاثَارٗا فِي ٱلۡأَرۡضِ فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمۡ وَمَا كَانَ لَهُم مِّنَ ٱللَّهِ مِن وَاقٖ" ;
        quran:ayah_text_no_diacratic   "اولم يسيروا في الارض فينظروا كيف كان عٰقبة الذين كانوا من قبلهم كانوا هم اشد منهم قوة وءاثارا في الارض فاخذهم الله بذنوبهم وما كان لهم من الله من واق" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4232" ;
        quran:page                     "469" ;
        quran:surahname                "سُورَةُ غَافِرٍ" ;
        quran:surahnumber              "40" ;
        quran:surrahname_no_diacratic  "سورة غافر" .

quran:5136  quran:ayah_text            "وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ" ;
        quran:ayah_text_no_diacratic   "وكانوا يقولون ائذا متنا وكنا ترابا وعظٰما اءنا لمبعوثون" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "27" ;
        quran:hizb                     "53" ;
        quran:index                    "5136" ;
        quran:page                     "535" ;
        quran:surahname                "سُورَةُ الوَاقِعَةِ" ;
        quran:surahnumber              "56" ;
        quran:surrahname_no_diacratic  "سورة الواقعة" .

quran:4042  quran:ayah_text            "وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "والحمد لله رب العٰلمين" ;
