        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3055  quran:ayah_text            "أَوۡ يَنفَعُونَكُمۡ أَوۡ يَضُرُّونَ" ;
        quran:ayah_text_no_diacratic   "او ينفعونكم او يضرون" ;
