        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:892  quran:ayah_text             "وَهَٰذَا كِتَٰبٌ أَنزَلۡنَٰهُ مُبَارَكٞ مُّصَدِّقُ ٱلَّذِي بَيۡنَ يَدَيۡهِ وَلِتُنذِرَ أُمَّ ٱلۡقُرَىٰ وَمَنۡ حَوۡلَهَاۚ وَٱلَّذِينَ يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ يُؤۡمِنُونَ بِهِۦۖ وَهُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ" ;
        quran:ayah_text_no_diacratic   "وهٰذا كتٰب انزلنٰه مبارك مصدق الذي بين يديه ولتنذر ام القرىٰ ومن حولها والذين يؤمنون بالاخرة يؤمنون به وهم علىٰ صلاتهم يحافظون" ;
        quran:ayahnumber               "92" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "892" ;
        quran:page                     "139" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4326  quran:ayah_text            "ذَٰلِكَ جَزَآءُ أَعۡدَآءِ ٱللَّهِ ٱلنَّارُۖ لَهُمۡ فِيهَا دَارُ ٱلۡخُلۡدِ جَزَآءَۢ بِمَا كَانُواْ بِـَٔايَٰتِنَا يَجۡحَدُونَ" ;
        quran:ayah_text_no_diacratic   "ذٰلك جزاء اعداء الله النار لهم فيها دار الخلد جزاء بما كانوا بايٰتنا يجحدون" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "24" ;
        quran:hizb                     "48" ;
        quran:index                    "4326" ;
        quran:page                     "479" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
