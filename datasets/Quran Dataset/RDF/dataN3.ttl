        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3422  quran:ayah_text            "۞فَـَٔامَنَ لَهُۥ لُوطٞۘ وَقَالَ إِنِّي مُهَاجِرٌ إِلَىٰ رَبِّيٓۖ إِنَّهُۥ هُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ" ;
        quran:ayah_text_no_diacratic   "فامن له لوط وقال اني مهاجر الىٰ ربي انه هو العزيز الحكيم" ;
        quran:ayahnumber               "26" ;
