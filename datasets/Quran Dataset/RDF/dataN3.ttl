quran:3634  quran:ayah_text            "وَإِذۡ تَقُولُ لِلَّذِيٓ أَنۡعَمَ ٱللَّهُ عَلَيۡهِ وَأَنۡعَمۡتَ عَلَيۡهِ أَمۡسِكۡ عَلَيۡكَ زَوۡجَكَ وَٱتَّقِ ٱللَّهَ وَتُخۡفِي فِي نَفۡسِكَ مَا ٱللَّهُ مُبۡدِيهِ وَتَخۡشَى ٱلنَّاسَ وَٱللَّهُ أَحَقُّ أَن تَخۡشَىٰهُۖ فَلَمَّا قَضَىٰ زَيۡدٞ مِّنۡهَا وَطَرٗا زَوَّجۡنَٰكَهَا لِكَيۡ لَا يَكُونَ عَلَى ٱلۡمُؤۡمِنِينَ حَرَجٞ فِيٓ أَزۡوَٰجِ أَدۡعِيَآئِهِمۡ إِذَا قَضَوۡاْ مِنۡهُنَّ وَطَرٗاۚ وَكَانَ أَمۡرُ ٱللَّهِ مَفۡعُولٗا" ;
        quran:ayah_text_no_diacratic   "واذ تقول للذي انعم الله عليه وانعمت عليه امسك عليك زوجك واتق الله وتخفي في نفسك ما الله مبديه وتخشى الناس والله احق ان تخشىٰه فلما قضىٰ زيد منها وطرا زوجنٰكها لكي لا يكون على المؤمنين حرج في ازوٰج ادعيائهم اذا قضوا منهن وطرا وكان امر الله مفعولا" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3634" ;
        quran:page                     "423" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1396  quran:ayah_text            "ثُمَّ جَعَلۡنَٰكُمۡ خَلَٰٓئِفَ فِي ٱلۡأَرۡضِ مِنۢ بَعۡدِهِمۡ لِنَنظُرَ كَيۡفَ تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ثم جعلنٰكم خلٰئف في الارض من بعدهم لننظر كيف تعملون" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1396" ;
        quran:page                     "209" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4538  quran:ayah_text            "وَمَا خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا لَٰعِبِينَ" ;
        quran:ayah_text_no_diacratic   "وما خلقنا السمٰوٰت والارض وما بينهما لٰعبين" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4538" ;
        quran:page                     "497" ;
