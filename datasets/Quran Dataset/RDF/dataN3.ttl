quran:2788  quran:ayah_text            "وَلَوِ ٱتَّبَعَ ٱلۡحَقُّ أَهۡوَآءَهُمۡ لَفَسَدَتِ ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ وَمَن فِيهِنَّۚ بَلۡ أَتَيۡنَٰهُم بِذِكۡرِهِمۡ فَهُمۡ عَن ذِكۡرِهِم مُّعۡرِضُونَ" ;
        quran:ayah_text_no_diacratic   "ولو اتبع الحق اهواءهم لفسدت السمٰوٰت والارض ومن فيهن بل اتينٰهم بذكرهم فهم عن ذكرهم معرضون" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2788" ;
        quran:page                     "346" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3932  quran:ayah_text            "وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ" ;
