        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2723  quran:ayah_text            "إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ" ;
        quran:ayah_text_no_diacratic   "الا علىٰ ازوٰجهم او ما ملكت ايمٰنهم فانهم غير ملومين" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2723" ;
        quran:page                     "342" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3627  quran:ayah_text            "يَٰنِسَآءَ ٱلنَّبِيِّ مَن يَأۡتِ مِنكُنَّ بِفَٰحِشَةٖ مُّبَيِّنَةٖ يُضَٰعَفۡ لَهَا ٱلۡعَذَابُ ضِعۡفَيۡنِۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٗا" ;
        quran:ayah_text_no_diacratic   "يٰنساء النبي من يات منكن بفٰحشة مبينة يضٰعف لها العذاب ضعفين وكان ذٰلك على الله يسيرا" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "21" ;
        quran:hizb                     "42" ;
        quran:index                    "3627" ;
        quran:page                     "421" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1389  quran:ayah_text            "إِنَّ ٱلَّذِينَ لَا يَرۡجُونَ لِقَآءَنَا وَرَضُواْ بِٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَٱطۡمَأَنُّواْ بِهَا وَٱلَّذِينَ هُمۡ عَنۡ ءَايَٰتِنَا غَٰفِلُونَ" ;
        quran:ayah_text_no_diacratic   "ان الذين لا يرجون لقاءنا ورضوا بالحيوٰة الدنيا واطمانوا بها والذين هم عن ءايٰتنا غٰفلون" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1389" ;
        quran:page                     "209" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2533  quran:ayah_text            "لَقَدۡ أَنزَلۡنَآ إِلَيۡكُمۡ كِتَٰبٗا فِيهِ ذِكۡرُكُمۡۚ أَفَلَا تَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "لقد انزلنا اليكم كتٰبا فيه ذكركم افلا تعقلون" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2533" ;
        quran:page                     "322" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3437  quran:ayah_text            "مَثَلُ ٱلَّذِينَ ٱتَّخَذُواْ مِن دُونِ ٱللَّهِ أَوۡلِيَآءَ كَمَثَلِ ٱلۡعَنكَبُوتِ ٱتَّخَذَتۡ بَيۡتٗاۖ وَإِنَّ أَوۡهَنَ ٱلۡبُيُوتِ لَبَيۡتُ ٱلۡعَنكَبُوتِۚ لَوۡ كَانُواْ يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "مثل الذين اتخذوا من دون الله اولياء كمثل العنكبوت اتخذت بيتا وان اوهن البيوت لبيت العنكبوت لو كانوا يعلمون" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3437" ;
        quran:page                     "401" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
