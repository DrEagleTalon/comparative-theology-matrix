quran:4365  quran:ayah_text            "فَاطِرُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ جَعَلَ لَكُم مِّنۡ أَنفُسِكُمۡ أَزۡوَٰجٗا وَمِنَ ٱلۡأَنۡعَٰمِ أَزۡوَٰجٗا يَذۡرَؤُكُمۡ فِيهِۚ لَيۡسَ كَمِثۡلِهِۦ شَيۡءٞۖ وَهُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ" ;
        quran:ayah_text_no_diacratic   "فاطر السمٰوٰت والارض جعل لكم من انفسكم ازوٰجا ومن الانعٰم ازوٰجا يذرؤكم فيه ليس كمثله شيء وهو السميع البصير" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4365" ;
        quran:page                     "484" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:5269  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّخِذُواْ عَدُوِّي وَعَدُوَّكُمۡ أَوۡلِيَآءَ تُلۡقُونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ وَقَدۡ كَفَرُواْ بِمَا جَآءَكُم مِّنَ ٱلۡحَقِّ يُخۡرِجُونَ ٱلرَّسُولَ وَإِيَّاكُمۡ أَن تُؤۡمِنُواْ بِٱللَّهِ رَبِّكُمۡ إِن كُنتُمۡ خَرَجۡتُمۡ جِهَٰدٗا فِي سَبِيلِي وَٱبۡتِغَآءَ مَرۡضَاتِيۚ تُسِرُّونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ وَأَنَا۠ أَعۡلَمُ بِمَآ أَخۡفَيۡتُمۡ وَمَآ أَعۡلَنتُمۡۚ وَمَن يَفۡعَلۡهُ مِنكُمۡ فَقَدۡ ضَلَّ سَوَآءَ ٱلسَّبِيلِ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا تتخذوا عدوي وعدوكم اولياء تلقون اليهم بالمودة وقد كفروا بما جاءكم من الحق يخرجون الرسول واياكم ان تؤمنوا بالله ربكم ان كنتم خرجتم جهٰدا في سبيلي وابتغاء مرضاتي تسرون اليهم بالمودة وانا اعلم بما اخفيتم وما اعلنتم ومن يفعله منكم فقد ضل سواء السبيل" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5269" ;
        quran:page                     "549" ;
        quran:surahname                "سُورَةُ المُمۡتَحنَةِ" ;
        quran:surahnumber              "60" ;
        quran:surrahname_no_diacratic  "سورة الممتحنة" .

quran:3271  quran:ayah_text            "أَمَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَأَنزَلَ لَكُم مِّنَ ٱلسَّمَآءِ مَآءٗ فَأَنۢبَتۡنَا بِهِۦ حَدَآئِقَ ذَاتَ بَهۡجَةٖ مَّا كَانَ لَكُمۡ أَن تُنۢبِتُواْ شَجَرَهَآۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ بَلۡ هُمۡ قَوۡمٞ يَعۡدِلُونَ" ;
        quran:ayah_text_no_diacratic   "امن خلق السمٰوٰت والارض وانزل لكم من السماء ماء فانبتنا به حدائق ذات بهجة ما كان لكم ان تنبتوا شجرها اءلٰه مع الله بل هم قوم يعدلون" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3271" ;
        quran:page                     "382" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

