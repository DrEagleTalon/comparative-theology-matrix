        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:2744  quran:ayah_text            "فَأَوۡحَيۡنَآ إِلَيۡهِ أَنِ ٱصۡنَعِ ٱلۡفُلۡكَ بِأَعۡيُنِنَا وَوَحۡيِنَا فَإِذَا جَآءَ أَمۡرُنَا وَفَارَ ٱلتَّنُّورُ فَٱسۡلُكۡ فِيهَا مِن كُلّٖ زَوۡجَيۡنِ ٱثۡنَيۡنِ وَأَهۡلَكَ إِلَّا مَن سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ مِنۡهُمۡۖ وَلَا تُخَٰطِبۡنِي فِي ٱلَّذِينَ ظَلَمُوٓاْ إِنَّهُم مُّغۡرَقُونَ" ;
        quran:ayah_text_no_diacratic   "فاوحينا اليه ان اصنع الفلك باعيننا ووحينا فاذا جاء امرنا وفار التنور فاسلك فيها من كل زوجين اثنين واهلك الا من سبق عليه القول منهم ولا تخٰطبني في الذين ظلموا انهم مغرقون" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2744" ;
        quran:page                     "343" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3648  quran:ayah_text            "۞تُرۡجِي مَن تَشَآءُ مِنۡهُنَّ وَتُـٔۡوِيٓ إِلَيۡكَ مَن تَشَآءُۖ وَمَنِ ٱبۡتَغَيۡتَ مِمَّنۡ عَزَلۡتَ فَلَا جُنَاحَ عَلَيۡكَۚ ذَٰلِكَ أَدۡنَىٰٓ أَن تَقَرَّ أَعۡيُنُهُنَّ وَلَا يَحۡزَنَّ وَيَرۡضَيۡنَ بِمَآ ءَاتَيۡتَهُنَّ كُلُّهُنَّۚ وَٱللَّهُ يَعۡلَمُ مَا فِي قُلُوبِكُمۡۚ وَكَانَ ٱللَّهُ عَلِيمًا حَلِيمٗا" ;
        quran:ayah_text_no_diacratic   "ترجي من تشاء منهن وتوي اليك من تشاء ومن ابتغيت ممن عزلت فلا جناح عليك ذٰلك ادنىٰ ان تقر اعينهن ولا يحزن ويرضين بما ءاتيتهن كلهن والله يعلم ما في قلوبكم وكان الله عليما حليما" ;
        quran:ayahnumber               "51" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3648" ;
        quran:page                     "425" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1650  quran:ayah_text            "قَالَتۡ فَذَٰلِكُنَّ ٱلَّذِي لُمۡتُنَّنِي فِيهِۖ وَلَقَدۡ رَٰوَدتُّهُۥ عَن نَّفۡسِهِۦ فَٱسۡتَعۡصَمَۖ وَلَئِن لَّمۡ يَفۡعَلۡ مَآ ءَامُرُهُۥ لَيُسۡجَنَنَّ وَلَيَكُونٗا مِّنَ ٱلصَّٰغِرِينَ" ;
        quran:ayah_text_no_diacratic   "قالت فذٰلكن الذي لمتنني فيه ولقد رٰودته عن نفسه فاستعصم ولئن لم يفعل ما ءامره ليسجنن وليكونا من الصٰغرين" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "12" ;
        quran:hizb                     "24" ;
        quran:index                    "1650" ;
        quran:page                     "239" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2554  quran:ayah_text            "وَجَعَلۡنَا فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِهِمۡ وَجَعَلۡنَا فِيهَا فِجَاجٗا سُبُلٗا لَّعَلَّهُمۡ يَهۡتَدُونَ" ;
        quran:ayah_text_no_diacratic   "وجعلنا في الارض روٰسي ان تميد بهم وجعلنا فيها فجاجا سبلا لعلهم يهتدون" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
