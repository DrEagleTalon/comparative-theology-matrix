quran:1545  quran:ayah_text            "وَيَٰقَوۡمِ ٱسۡتَغۡفِرُواْ رَبَّكُمۡ ثُمَّ تُوبُوٓاْ إِلَيۡهِ يُرۡسِلِ ٱلسَّمَآءَ عَلَيۡكُم مِّدۡرَارٗا وَيَزِدۡكُمۡ قُوَّةً إِلَىٰ قُوَّتِكُمۡ وَلَا تَتَوَلَّوۡاْ مُجۡرِمِينَ" ;
        quran:ayah_text_no_diacratic   "ويٰقوم استغفروا ربكم ثم توبوا اليه يرسل السماء عليكم مدرارا ويزدكم قوة الىٰ قوتكم ولا تتولوا مجرمين" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "12" ;
        quran:hizb                     "22" ;
        quran:index                    "1545" ;
        quran:page                     "227" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:5280  quran:ayah_text            "يَٰٓأَيُّهَا ٱلنَّبِيُّ إِذَا جَآءَكَ ٱلۡمُؤۡمِنَٰتُ يُبَايِعۡنَكَ عَلَىٰٓ أَن لَّا يُشۡرِكۡنَ بِٱللَّهِ شَيۡـٔٗا وَلَا يَسۡرِقۡنَ وَلَا يَزۡنِينَ وَلَا يَقۡتُلۡنَ أَوۡلَٰدَهُنَّ وَلَا يَأۡتِينَ بِبُهۡتَٰنٖ يَفۡتَرِينَهُۥ بَيۡنَ أَيۡدِيهِنَّ وَأَرۡجُلِهِنَّ وَلَا يَعۡصِينَكَ فِي مَعۡرُوفٖ فَبَايِعۡهُنَّ وَٱسۡتَغۡفِرۡ لَهُنَّ ٱللَّهَۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها النبي اذا جاءك المؤمنٰت يبايعنك علىٰ ان لا يشركن بالله شيا ولا يسرقن ولا يزنين ولا يقتلن اولٰدهن ولا ياتين ببهتٰن يفترينه بين ايديهن وارجلهن ولا يعصينك في معروف فبايعهن واستغفر لهن الله ان الله غفور رحيم" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5280" ;
        quran:page                     "551" ;
        quran:surahname                "سُورَةُ المُمۡتَحنَةِ" ;
        quran:surahnumber              "60" ;
        quran:surrahname_no_diacratic  "سورة الممتحنة" .

quran:2449  quran:ayah_text            "قَالُوٓاْ إِنۡ هَٰذَٰنِ لَسَٰحِرَٰنِ يُرِيدَانِ أَن يُخۡرِجَاكُم مِّنۡ أَرۡضِكُم بِسِحۡرِهِمَا وَيَذۡهَبَا بِطَرِيقَتِكُمُ ٱلۡمُثۡلَىٰ" ;
        quran:ayah_text_no_diacratic   "قالوا ان هٰذٰن لسٰحرٰن يريدان ان يخرجاكم من ارضكم بسحرهما ويذهبا بطريقتكم المثلىٰ" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2449" ;
        quran:page                     "315" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:6184  quran:ayah_text            "فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ" ;
        quran:ayah_text_no_diacratic   "فاما الانسٰن اذا ما ابتلىٰه ربه فاكرمه ونعمه فيقول ربي اكرمن" ;
