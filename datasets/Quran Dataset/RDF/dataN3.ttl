        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:4342  quran:ayah_text            "وَلَوۡ جَعَلۡنَٰهُ قُرۡءَانًا أَعۡجَمِيّٗا لَّقَالُواْ لَوۡلَا فُصِّلَتۡ ءَايَٰتُهُۥٓۖ ءَا۬عۡجَمِيّٞ وَعَرَبِيّٞۗ قُلۡ هُوَ لِلَّذِينَ ءَامَنُواْ هُدٗى وَشِفَآءٞۚ وَٱلَّذِينَ لَا يُؤۡمِنُونَ فِيٓ ءَاذَانِهِمۡ وَقۡرٞ وَهُوَ عَلَيۡهِمۡ عَمًىۚ أُوْلَٰٓئِكَ يُنَادَوۡنَ مِن مَّكَانِۭ بَعِيدٖ" ;
        quran:ayah_text_no_diacratic   "ولو جعلنٰه قرءانا اعجميا لقالوا لولا فصلت ءايٰته ءاعجمي وعربي قل هو للذين ءامنوا هدى وشفاء والذين لا يؤمنون في ءاذانهم وقر وهو عليهم عمى اولٰئك ينادون من مكان بعيد" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "24" ;
        quran:hizb                     "48" ;
        quran:index                    "4342" ;
        quran:page                     "481" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:5246  quran:ayah_text            "ذَٰلِكَ بِأَنَّهُمۡ شَآقُّواْ ٱللَّهَ وَرَسُولَهُۥۖ وَمَن يُشَآقِّ ٱللَّهَ فَإِنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ" ;
        quran:ayah_text_no_diacratic   "ذٰلك بانهم شاقوا الله ورسوله ومن يشاق الله فان الله شديد العقاب" ;
