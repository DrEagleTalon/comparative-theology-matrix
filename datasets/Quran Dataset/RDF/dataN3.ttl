        quran:surrahname_no_diacratic  "سورة القلم" .

quran:3411  quran:ayah_text            "فَأَنجَيۡنَٰهُ وَأَصۡحَٰبَ ٱلسَّفِينَةِ وَجَعَلۡنَٰهَآ ءَايَةٗ لِّلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "فانجينٰه واصحٰب السفينة وجعلنٰها ءاية للعٰلمين" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3411" ;
        quran:page                     "398" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1173  quran:ayah_text            "إِنَّ ٱلَّذِينَ عِندَ رَبِّكَ لَا يَسۡتَكۡبِرُونَ عَنۡ عِبَادَتِهِۦ وَيُسَبِّحُونَهُۥ وَلَهُۥ يَسۡجُدُونَۤ۩" ;
        quran:ayah_text_no_diacratic   "ان الذين عند ربك لا يستكبرون عن عبادته ويسبحونه وله يسجدون" ;
        quran:ayahnumber               "206" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1173" ;
        quran:page                     "176" ;
        quran:sajdah                   "1" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:881  quran:ayah_text             "وَكَيۡفَ أَخَافُ مَآ أَشۡرَكۡتُمۡ وَلَا تَخَافُونَ أَنَّكُمۡ أَشۡرَكۡتُم بِٱللَّهِ مَا لَمۡ يُنَزِّلۡ بِهِۦ عَلَيۡكُمۡ سُلۡطَٰنٗاۚ فَأَيُّ ٱلۡفَرِيقَيۡنِ أَحَقُّ بِٱلۡأَمۡنِۖ إِن كُنتُمۡ تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وكيف اخاف ما اشركتم ولا تخافون انكم اشركتم بالله ما لم ينزل به عليكم سلطٰنا فاي الفريقين احق بالامن ان كنتم تعلمون" ;
        quran:ayahnumber               "81" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "881" ;
        quran:page                     "137" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4315  quran:ayah_text            "وَأَمَّا ثَمُودُ فَهَدَيۡنَٰهُمۡ فَٱسۡتَحَبُّواْ ٱلۡعَمَىٰ عَلَى ٱلۡهُدَىٰ فَأَخَذَتۡهُمۡ صَٰعِقَةُ ٱلۡعَذَابِ ٱلۡهُونِ بِمَا كَانُواْ يَكۡسِبُونَ" ;
        quran:ayah_text_no_diacratic   "واما ثمود فهدينٰهم فاستحبوا العمىٰ على الهدىٰ فاخذتهم صٰعقة العذاب الهون بما كانوا يكسبون" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4315" ;
        quran:page                     "478" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2077  quran:ayah_text            "وَإِذَآ أَرَدۡنَآ أَن نُّهۡلِكَ قَرۡيَةً أَمَرۡنَا مُتۡرَفِيهَا فَفَسَقُواْ فِيهَا فَحَقَّ عَلَيۡهَا ٱلۡقَوۡلُ فَدَمَّرۡنَٰهَا تَدۡمِيرٗا" ;
        quran:ayah_text_no_diacratic   "واذا اردنا ان نهلك قرية امرنا مترفيها ففسقوا فيها فحق عليها القول فدمرنٰها تدميرا" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2077" ;
        quran:page                     "283" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:5219  quran:ayah_text            "قَدۡ سَمِعَ ٱللَّهُ قَوۡلَ ٱلَّتِي تُجَٰدِلُكَ فِي زَوۡجِهَا وَتَشۡتَكِيٓ إِلَى ٱللَّهِ وَٱللَّهُ يَسۡمَعُ تَحَاوُرَكُمَآۚ إِنَّ ٱللَّهَ سَمِيعُۢ بَصِيرٌ" ;
        quran:ayah_text_no_diacratic   "قد سمع الله قول التي تجٰدلك في زوجها وتشتكي الى الله والله يسمع تحاوركما ان الله سميع بصير" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5219" ;
        quran:page                     "542" ;
        quran:surahname                "سُورَةُ المُجَادلَةِ" ;
        quran:surahnumber              "58" ;
        quran:surrahname_no_diacratic  "سورة المجادلة" .

quran:3221  quran:ayah_text            "وَأَلۡقِ عَصَاكَۚ فَلَمَّا رَءَاهَا تَهۡتَزُّ كَأَنَّهَا جَآنّٞ وَلَّىٰ مُدۡبِرٗا وَلَمۡ يُعَقِّبۡۚ يَٰمُوسَىٰ لَا تَخَفۡ إِنِّي لَا يَخَافُ لَدَيَّ ٱلۡمُرۡسَلُونَ" ;
        quran:ayah_text_no_diacratic   "والق عصاك فلما رءاها تهتز كانها جان ولىٰ مدبرا ولم يعقب يٰموسىٰ لا تخف اني لا يخاف لدي المرسلون" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3221" ;
        quran:page                     "377" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:691  quran:ayah_text             "فَبِمَا نَقۡضِهِم مِّيثَٰقَهُمۡ لَعَنَّٰهُمۡ وَجَعَلۡنَا قُلُوبَهُمۡ قَٰسِيَةٗۖ يُحَرِّفُونَ ٱلۡكَلِمَ عَن مَّوَاضِعِهِۦ وَنَسُواْ حَظّٗا مِّمَّا ذُكِّرُواْ بِهِۦۚ وَلَا تَزَالُ تَطَّلِعُ عَلَىٰ خَآئِنَةٖ مِّنۡهُمۡ إِلَّا قَلِيلٗا مِّنۡهُمۡۖ فَٱعۡفُ عَنۡهُمۡ وَٱصۡفَحۡۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "فبما نقضهم ميثٰقهم لعنٰهم وجعلنا قلوبهم قٰسية يحرفون الكلم عن مواضعه ونسوا حظا مما ذكروا به ولا تزال تطلع علىٰ خائنة منهم الا قليلا منهم فاعف عنهم واصفح ان الله يحب المحسنين" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "691" ;
        quran:page                     "109" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:4125  quran:ayah_text            "إِلَىٰ يَوۡمِ ٱلۡوَقۡتِ ٱلۡمَعۡلُومِ" ;
        quran:ayah_text_no_diacratic   "الىٰ يوم الوقت المعلوم" ;
        quran:ayahnumber               "81" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
