        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3824  quran:ayah_text            "مَا يَنظُرُونَ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ تَأۡخُذُهُمۡ وَهُمۡ يَخِصِّمُونَ" ;
        quran:ayah_text_no_diacratic   "ما ينظرون الا صيحة وٰحدة تاخذهم وهم يخصمون" ;
        quran:ayahnumber               "49" ;
