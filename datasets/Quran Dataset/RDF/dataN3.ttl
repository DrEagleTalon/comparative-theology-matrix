quran:175  quran:ayah_text             "وَمِنَ ٱلنَّاسِ مَن يَتَّخِذُ مِن دُونِ ٱللَّهِ أَندَادٗا يُحِبُّونَهُمۡ كَحُبِّ ٱللَّهِۖ وَٱلَّذِينَ ءَامَنُوٓاْ أَشَدُّ حُبّٗا لِّلَّهِۗ وَلَوۡ يَرَى ٱلَّذِينَ ظَلَمُوٓاْ إِذۡ يَرَوۡنَ ٱلۡعَذَابَ أَنَّ ٱلۡقُوَّةَ لِلَّهِ جَمِيعٗا وَأَنَّ ٱللَّهَ شَدِيدُ ٱلۡعَذَابِ" ;
        quran:ayah_text_no_diacratic   "ومن الناس من يتخذ من دون الله اندادا يحبونهم كحب الله والذين ءامنوا اشد حبا لله ولو يرى الذين ظلموا اذ يرون العذاب ان القوة لله جميعا وان الله شديد العذاب" ;
        quran:ayahnumber               "165" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "175" ;
        quran:page                     "25" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1969  quran:ayah_text            "وَأَقۡسَمُواْ بِٱللَّهِ جَهۡدَ أَيۡمَٰنِهِمۡ لَا يَبۡعَثُ ٱللَّهُ مَن يَمُوتُۚ بَلَىٰ وَعۡدًا عَلَيۡهِ حَقّٗا وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "واقسموا بالله جهد ايمٰنهم لا يبعث الله من يموت بلىٰ وعدا عليه حقا ولٰكن اكثر الناس لا يعلمون" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1969" ;
        quran:page                     "271" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:1779  quran:ayah_text            "ٱلَّذِينَ يَسۡتَحِبُّونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا عَلَى ٱلۡأٓخِرَةِ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَيَبۡغُونَهَا عِوَجًاۚ أُوْلَٰٓئِكَ فِي ضَلَٰلِۭ بَعِيدٖ" ;
        quran:ayah_text_no_diacratic   "الذين يستحبون الحيوٰة الدنيا على الاخرة ويصدون عن سبيل الله ويبغونها عوجا اولٰئك في ضلٰل بعيد" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1779" ;
        quran:page                     "255" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
