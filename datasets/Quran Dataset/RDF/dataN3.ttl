quran:5355  quran:ayah_text            "أَعَدَّ ٱللَّهُ لَهُمۡ عَذَابٗا شَدِيدٗاۖ فَٱتَّقُواْ ٱللَّهَ يَٰٓأُوْلِي ٱلۡأَلۡبَٰبِ ٱلَّذِينَ ءَامَنُواْۚ قَدۡ أَنزَلَ ٱللَّهُ إِلَيۡكُمۡ ذِكۡرٗا" ;
        quran:ayah_text_no_diacratic   "اعد الله لهم عذابا شديدا فاتقوا الله يٰاولي الالبٰب الذين ءامنوا قد انزل الله اليكم ذكرا" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5355" ;
        quran:page                     "559" ;
        quran:surahname                "سُورَةُ الطَّلَاقِ" ;
        quran:surahnumber              "65" ;
        quran:surrahname_no_diacratic  "سورة الطلاق" .

quran:6259  quran:ayah_text            "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ" ;
