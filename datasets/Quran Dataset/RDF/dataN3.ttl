        quran:surahnumber              "15" ;
        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:2799  quran:ayah_text            "قَالُوٓاْ أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ" ;
        quran:ayah_text_no_diacratic   "قالوا اءذا متنا وكنا ترابا وعظٰما اءنا لمبعوثون" ;
        quran:ayahnumber               "82" ;
