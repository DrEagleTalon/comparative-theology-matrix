quran:2090  quran:ayah_text            "وَلَا تَجۡعَلۡ يَدَكَ مَغۡلُولَةً إِلَىٰ عُنُقِكَ وَلَا تَبۡسُطۡهَا كُلَّ ٱلۡبَسۡطِ فَتَقۡعُدَ مَلُومٗا مَّحۡسُورًا" ;
        quran:ayah_text_no_diacratic   "ولا تجعل يدك مغلولة الىٰ عنقك ولا تبسطها كل البسط فتقعد ملوما محسورا" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2090" ;
        quran:page                     "285" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:4088  quran:ayah_text            "وَخُذۡ بِيَدِكَ ضِغۡثٗا فَٱضۡرِب بِّهِۦ وَلَا تَحۡنَثۡۗ إِنَّا وَجَدۡنَٰهُ صَابِرٗاۚ نِّعۡمَ ٱلۡعَبۡدُ إِنَّهُۥٓ أَوَّابٞ" ;
        quran:ayah_text_no_diacratic   "وخذ بيدك ضغثا فاضرب به ولا تحنث انا وجدنٰه صابرا نعم العبد انه اواب" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
        quran:index                    "4088" ;
        quran:page                     "456" ;
        quran:surahname                "سُورَةُ صٓ" ;
        quran:surahnumber              "38" ;
        quran:surrahname_no_diacratic  "سورة ص" .

quran:5232  quran:ayah_text            "۞أَلَمۡ تَرَ إِلَى ٱلَّذِينَ تَوَلَّوۡاْ قَوۡمًا غَضِبَ ٱللَّهُ عَلَيۡهِم مَّا هُم مِّنكُمۡ وَلَا مِنۡهُمۡ وَيَحۡلِفُونَ عَلَى ٱلۡكَذِبِ وَهُمۡ يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "الم تر الى الذين تولوا قوما غضب الله عليهم ما هم منكم ولا منهم ويحلفون على الكذب وهم يعلمون" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5232" ;
        quran:page                     "544" ;
        quran:surahname                "سُورَةُ المُجَادلَةِ" ;
        quran:surahnumber              "58" ;
        quran:surrahname_no_diacratic  "سورة المجادلة" .

quran:6136  quran:ayah_text            "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا" ;
        quran:ayah_text_no_diacratic   "بل تؤثرون الحيوٰة الدنيا" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "30" ;
        quran:hizb                     "59" ;
