quran:124  quran:ayah_text             "وَمَنۡ أَظۡلَمُ مِمَّن مَّنَعَ مَسَٰجِدَ ٱللَّهِ أَن يُذۡكَرَ فِيهَا ٱسۡمُهُۥ وَسَعَىٰ فِي خَرَابِهَآۚ أُوْلَٰٓئِكَ مَا كَانَ لَهُمۡ أَن يَدۡخُلُوهَآ إِلَّا خَآئِفِينَۚ لَهُمۡ فِي ٱلدُّنۡيَا خِزۡيٞ وَلَهُمۡ فِي ٱلۡأٓخِرَةِ عَذَابٌ عَظِيمٞ" ;
        quran:ayah_text_no_diacratic   "ومن اظلم ممن منع مسٰجد الله ان يذكر فيها اسمه وسعىٰ في خرابها اولٰئك ما كان لهم ان يدخلوها الا خائفين لهم في الدنيا خزي ولهم في الاخرة عذاب عظيم" ;
        quran:ayahnumber               "114" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "124" ;
        quran:page                     "18" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1918  quran:ayah_text            "لَا تَمُدَّنَّ عَيۡنَيۡكَ إِلَىٰ مَا مَتَّعۡنَا بِهِۦٓ أَزۡوَٰجٗا مِّنۡهُمۡ وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَٱخۡفِضۡ جَنَاحَكَ لِلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "لا تمدن عينيك الىٰ ما متعنا به ازوٰجا منهم ولا تحزن عليهم واخفض جناحك للمؤمنين" ;
