        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:5044  quran:ayah_text            "يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نَّارٖ وَنُحَاسٞ فَلَا تَنتَصِرَانِ" ;
        quran:ayah_text_no_diacratic   "يرسل عليكما شواظ من نار ونحاس فلا تنتصران" ;
