quran:99  quran:ayah_text              "وَلَمَّا جَآءَهُمۡ كِتَٰبٞ مِّنۡ عِندِ ٱللَّهِ مُصَدِّقٞ لِّمَا مَعَهُمۡ وَكَانُواْ مِن قَبۡلُ يَسۡتَفۡتِحُونَ عَلَى ٱلَّذِينَ كَفَرُواْ فَلَمَّا جَآءَهُم مَّا عَرَفُواْ كَفَرُواْ بِهِۦۚ فَلَعۡنَةُ ٱللَّهِ عَلَى ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "ولما جاءهم كتٰب من عند الله مصدق لما معهم وكانوا من قبل يستفتحون على الذين كفروا فلما جاءهم ما عرفوا كفروا به فلعنة الله على الكٰفرين" ;
        quran:ayahnumber               "89" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "99" ;
        quran:page                     "14" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:938  quran:ayah_text             "وَقَالُواْ هَٰذِهِۦٓ أَنۡعَٰمٞ وَحَرۡثٌ حِجۡرٞ لَّا يَطۡعَمُهَآ إِلَّا مَن نَّشَآءُ بِزَعۡمِهِمۡ وَأَنۡعَٰمٌ حُرِّمَتۡ ظُهُورُهَا وَأَنۡعَٰمٞ لَّا يَذۡكُرُونَ ٱسۡمَ ٱللَّهِ عَلَيۡهَا ٱفۡتِرَآءً عَلَيۡهِۚ سَيَجۡزِيهِم بِمَا كَانُواْ يَفۡتَرُونَ" ;
        quran:ayah_text_no_diacratic   "وقالوا هٰذه انعٰم وحرث حجر لا يطعمها الا من نشاء بزعمهم وانعٰم حرمت ظهورها وانعٰم لا يذكرون اسم الله عليها افتراء عليه سيجزيهم بما كانوا يفترون" ;
        quran:ayahnumber               "138" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "938" ;
        quran:page                     "146" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:748  quran:ayah_text             "لَقَدۡ أَخَذۡنَا مِيثَٰقَ بَنِيٓ إِسۡرَٰٓءِيلَ وَأَرۡسَلۡنَآ إِلَيۡهِمۡ رُسُلٗاۖ كُلَّمَا جَآءَهُمۡ رَسُولُۢ بِمَا لَا تَهۡوَىٰٓ أَنفُسُهُمۡ فَرِيقٗا كَذَّبُواْ وَفَرِيقٗا يَقۡتُلُونَ" ;
        quran:ayah_text_no_diacratic   "لقد اخذنا ميثٰق بني اسرٰءيل وارسلنا اليهم رسلا كلما جاءهم رسول بما لا تهوىٰ انفسهم فريقا كذبوا وفريقا يقتلون" ;
        quran:ayahnumber               "70" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "748" ;
        quran:page                     "119" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:558  quran:ayah_text             "۞إِنَّ ٱللَّهَ يَأۡمُرُكُمۡ أَن تُؤَدُّواْ ٱلۡأَمَٰنَٰتِ إِلَىٰٓ أَهۡلِهَا وَإِذَا حَكَمۡتُم بَيۡنَ ٱلنَّاسِ أَن تَحۡكُمُواْ بِٱلۡعَدۡلِۚ إِنَّ ٱللَّهَ نِعِمَّا يَعِظُكُم بِهِۦٓۗ إِنَّ ٱللَّهَ كَانَ سَمِيعَۢا بَصِيرٗا" ;
        quran:ayah_text_no_diacratic   "ان الله يامركم ان تؤدوا الامٰنٰت الىٰ اهلها واذا حكمتم بين الناس ان تحكموا بالعدل ان الله نعما يعظكم به ان الله كان سميعا بصيرا" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "558" ;
