        quran:index                    "4508" ;
        quran:page                     "496" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:3414  quran:ayah_text            "وَإِن تُكَذِّبُواْ فَقَدۡ كَذَّبَ أُمَمٞ مِّن قَبۡلِكُمۡۖ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلۡبَلَٰغُ ٱلۡمُبِينُ" ;
        quran:ayah_text_no_diacratic   "وان تكذبوا فقد كذب امم من قبلكم وما على الرسول الا البلٰغ المبين" ;
        quran:ayahnumber               "18" ;
