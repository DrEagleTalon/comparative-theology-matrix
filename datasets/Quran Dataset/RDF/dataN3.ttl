quran:1293  quran:ayah_text            "لَوۡ كَانَ عَرَضٗا قَرِيبٗا وَسَفَرٗا قَاصِدٗا لَّٱتَّبَعُوكَ وَلَٰكِنۢ بَعُدَتۡ عَلَيۡهِمُ ٱلشُّقَّةُۚ وَسَيَحۡلِفُونَ بِٱللَّهِ لَوِ ٱسۡتَطَعۡنَا لَخَرَجۡنَا مَعَكُمۡ يُهۡلِكُونَ أَنفُسَهُمۡ وَٱللَّهُ يَعۡلَمُ إِنَّهُمۡ لَكَٰذِبُونَ" ;
        quran:ayah_text_no_diacratic   "لو كان عرضا قريبا وسفرا قاصدا لاتبعوك ولٰكن بعدت عليهم الشقة وسيحلفون بالله لو استطعنا لخرجنا معكم يهلكون انفسهم والله يعلم انهم لكٰذبون" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1293" ;
        quran:page                     "194" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4435  quran:ayah_text            "وَإِذۡ قَالَ إِبۡرَٰهِيمُ لِأَبِيهِ وَقَوۡمِهِۦٓ إِنَّنِي بَرَآءٞ مِّمَّا تَعۡبُدُونَ" ;
        quran:ayah_text_no_diacratic   "واذ قال ابرٰهيم لابيه وقومه انني براء مما تعبدون" ;
