quran:5369  quran:ayah_text            "ضَرَبَ ٱللَّهُ مَثَلٗا لِّلَّذِينَ كَفَرُواْ ٱمۡرَأَتَ نُوحٖ وَٱمۡرَأَتَ لُوطٖۖ كَانَتَا تَحۡتَ عَبۡدَيۡنِ مِنۡ عِبَادِنَا صَٰلِحَيۡنِ فَخَانَتَاهُمَا فَلَمۡ يُغۡنِيَا عَنۡهُمَا مِنَ ٱللَّهِ شَيۡـٔٗا وَقِيلَ ٱدۡخُلَا ٱلنَّارَ مَعَ ٱلدَّٰخِلِينَ" ;
        quran:ayah_text_no_diacratic   "ضرب الله مثلا للذين كفروا امرات نوح وامرات لوط كانتا تحت عبدين من عبادنا صٰلحين فخانتاهما فلم يغنيا عنهما من الله شيا وقيل ادخلا النار مع الدٰخلين" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "28" ;
        quran:hizb                     "56" ;
        quran:index                    "5369" ;
        quran:page                     "561" ;
        quran:surahname                "سُورَةُ التَّحۡرِيمِ" ;
        quran:surahnumber              "66" ;
        quran:surrahname_no_diacratic  "سورة التحريم" .

