        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:493  quran:ayah_text             "فَٱسۡتَجَابَ لَهُمۡ رَبُّهُمۡ أَنِّي لَآ أُضِيعُ عَمَلَ عَٰمِلٖ مِّنكُم مِّن ذَكَرٍ أَوۡ أُنثَىٰۖ بَعۡضُكُم مِّنۢ بَعۡضٖۖ فَٱلَّذِينَ هَاجَرُواْ وَأُخۡرِجُواْ مِن دِيَٰرِهِمۡ وَأُوذُواْ فِي سَبِيلِي وَقَٰتَلُواْ وَقُتِلُواْ لَأُكَفِّرَنَّ عَنۡهُمۡ سَيِّـَٔاتِهِمۡ وَلَأُدۡخِلَنَّهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ ثَوَابٗا مِّنۡ عِندِ ٱللَّهِۚ وَٱللَّهُ عِندَهُۥ حُسۡنُ ٱلثَّوَابِ" ;
        quran:ayah_text_no_diacratic   "فاستجاب لهم ربهم اني لا اضيع عمل عٰمل منكم من ذكر او انثىٰ بعضكم من بعض فالذين هاجروا واخرجوا من ديٰرهم واوذوا في سبيلي وقٰتلوا وقتلوا لاكفرن عنهم سياتهم ولادخلنهم جنٰت تجري من تحتها الانهٰر ثوابا من عند الله والله عنده حسن الثواب" ;
        quran:ayahnumber               "195" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "493" ;
        quran:page                     "76" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:15  quran:ayah_text              "أُوْلَٰٓئِكَ عَلَىٰ هُدٗى مِّن رَّبِّهِمۡۖ وَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "اولٰئك علىٰ هدى من ربهم واولٰئك هم المفلحون" ;
        quran:ayahnumber               "5" ;
