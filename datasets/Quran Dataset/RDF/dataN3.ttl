        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2841  quran:ayah_text            "وَٱلَّذِينَ يَرۡمُونَ ٱلۡمُحۡصَنَٰتِ ثُمَّ لَمۡ يَأۡتُواْ بِأَرۡبَعَةِ شُهَدَآءَ فَٱجۡلِدُوهُمۡ ثَمَٰنِينَ جَلۡدَةٗ وَلَا تَقۡبَلُواْ لَهُمۡ شَهَٰدَةً أَبَدٗاۚ وَأُوْلَٰٓئِكَ هُمُ ٱلۡفَٰسِقُونَ" ;
        quran:ayah_text_no_diacratic   "والذين يرمون المحصنٰت ثم لم ياتوا باربعة شهداء فاجلدوهم ثمٰنين جلدة ولا تقبلوا لهم شهٰدة ابدا واولٰئك هم الفٰسقون" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2841" ;
