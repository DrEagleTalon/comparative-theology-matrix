        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:1539  quran:ayah_text            "قَالَ يَٰنُوحُ إِنَّهُۥ لَيۡسَ مِنۡ أَهۡلِكَۖ إِنَّهُۥ عَمَلٌ غَيۡرُ صَٰلِحٖۖ فَلَا تَسۡـَٔلۡنِ مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٌۖ إِنِّيٓ أَعِظُكَ أَن تَكُونَ مِنَ ٱلۡجَٰهِلِينَ" ;
        quran:ayah_text_no_diacratic   "قال يٰنوح انه ليس من اهلك انه عمل غير صٰلح فلا تسلن ما ليس لك به علم اني اعظك ان تكون من الجٰهلين" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "12" ;
        quran:hizb                     "22" ;
        quran:index                    "1539" ;
        quran:page                     "227" ;
