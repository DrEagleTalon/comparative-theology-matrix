quran:774  quran:ayah_text             "أُحِلَّ لَكُمۡ صَيۡدُ ٱلۡبَحۡرِ وَطَعَامُهُۥ مَتَٰعٗا لَّكُمۡ وَلِلسَّيَّارَةِۖ وَحُرِّمَ عَلَيۡكُمۡ صَيۡدُ ٱلۡبَرِّ مَا دُمۡتُمۡ حُرُمٗاۗ وَٱتَّقُواْ ٱللَّهَ ٱلَّذِيٓ إِلَيۡهِ تُحۡشَرُونَ" ;
        quran:ayah_text_no_diacratic   "احل لكم صيد البحر وطعامه متٰعا لكم وللسيارة وحرم عليكم صيد البر ما دمتم حرما واتقوا الله الذي اليه تحشرون" ;
        quran:ayahnumber               "96" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "774" ;
        quran:page                     "124" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2210  quran:ayah_text            "وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةٗ وَلَئِن رُّدِدتُّ إِلَىٰ رَبِّي لَأَجِدَنَّ خَيۡرٗا مِّنۡهَا مُنقَلَبٗا" ;
        quran:ayah_text_no_diacratic   "وما اظن الساعة قائمة ولئن رددت الىٰ ربي لاجدن خيرا منها منقلبا" ;
