        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:4303  quran:ayah_text            "وَقَالُواْ قُلُوبُنَا فِيٓ أَكِنَّةٖ مِّمَّا تَدۡعُونَآ إِلَيۡهِ وَفِيٓ ءَاذَانِنَا وَقۡرٞ وَمِنۢ بَيۡنِنَا وَبَيۡنِكَ حِجَابٞ فَٱعۡمَلۡ إِنَّنَا عَٰمِلُونَ" ;
        quran:ayah_text_no_diacratic   "وقالوا قلوبنا في اكنة مما تدعونا اليه وفي ءاذاننا وقر ومن بيننا وبينك حجاب فاعمل اننا عٰملون" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4303" ;
        quran:page                     "477" ;
