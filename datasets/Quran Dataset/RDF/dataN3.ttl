        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:720  quran:ayah_text             "سَمَّٰعُونَ لِلۡكَذِبِ أَكَّٰلُونَ لِلسُّحۡتِۚ فَإِن جَآءُوكَ فَٱحۡكُم بَيۡنَهُمۡ أَوۡ أَعۡرِضۡ عَنۡهُمۡۖ وَإِن تُعۡرِضۡ عَنۡهُمۡ فَلَن يَضُرُّوكَ شَيۡـٔٗاۖ وَإِنۡ حَكَمۡتَ فَٱحۡكُم بَيۡنَهُم بِٱلۡقِسۡطِۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُقۡسِطِينَ" ;
        quran:ayah_text_no_diacratic   "سمٰعون للكذب اكٰلون للسحت فان جاءوك فاحكم بينهم او اعرض عنهم وان تعرض عنهم فلن يضروك شيا وان حكمت فاحكم بينهم بالقسط ان الله يحب المقسطين" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "720" ;
        quran:page                     "115" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:530  quran:ayah_text             "وَمَن يَفۡعَلۡ ذَٰلِكَ عُدۡوَٰنٗا وَظُلۡمٗا فَسَوۡفَ نُصۡلِيهِ نَارٗاۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرًا" ;
        quran:ayah_text_no_diacratic   "ومن يفعل ذٰلك عدوٰنا وظلما فسوف نصليه نارا وكان ذٰلك على الله يسيرا" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "530" ;
        quran:page                     "83" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:340  quran:ayah_text             "وَإِذۡ قَالَتِ ٱلۡمَلَٰٓئِكَةُ يَٰمَرۡيَمُ إِنَّ ٱللَّهَ ٱصۡطَفَىٰكِ وَطَهَّرَكِ وَٱصۡطَفَىٰكِ عَلَىٰ نِسَآءِ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "واذ قالت الملٰئكة يٰمريم ان الله اصطفىٰك وطهرك واصطفىٰك علىٰ نساء العٰلمين" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "340" ;
        quran:page                     "55" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:150  quran:ayah_text             "أَمۡ تَقُولُونَ إِنَّ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ وَيَعۡقُوبَ وَٱلۡأَسۡبَاطَ كَانُواْ هُودًا أَوۡ نَصَٰرَىٰۗ قُلۡ ءَأَنتُمۡ أَعۡلَمُ أَمِ ٱللَّهُۗ وَمَنۡ أَظۡلَمُ مِمَّن كَتَمَ شَهَٰدَةً عِندَهُۥ مِنَ ٱللَّهِۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ام تقولون ان ابرٰهم واسمٰعيل واسحٰق ويعقوب والاسباط كانوا هودا او نصٰرىٰ قل ءانتم اعلم ام الله ومن اظلم ممن كتم شهٰدة عنده من الله وما الله بغٰفل عما تعملون" ;
        quran:ayahnumber               "140" ;
        quran:chapter                  "1" ;
        quran:hizb                     "2" ;
        quran:index                    "150" ;
        quran:page                     "21" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1944  quran:ayah_text            "وَمَا ذَرَأَ لَكُمۡ فِي ٱلۡأَرۡضِ مُخۡتَلِفًا أَلۡوَٰنُهُۥٓۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَذَّكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "وما ذرا لكم في الارض مختلفا الوٰنه ان في ذٰلك لاية لقوم يذكرون" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1944" ;
        quran:page                     "268" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2848  quran:ayah_text            "إِنَّ ٱلَّذِينَ جَآءُو بِٱلۡإِفۡكِ عُصۡبَةٞ مِّنكُمۡۚ لَا تَحۡسَبُوهُ شَرّٗا لَّكُمۖ بَلۡ هُوَ خَيۡرٞ لَّكُمۡۚ لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُم مَّا ٱكۡتَسَبَ مِنَ ٱلۡإِثۡمِۚ وَٱلَّذِي تَوَلَّىٰ كِبۡرَهُۥ مِنۡهُمۡ لَهُۥ عَذَابٌ عَظِيمٞ" ;
        quran:ayah_text_no_diacratic   "ان الذين جاءو بالافك عصبة منكم لا تحسبوه شرا لكم بل هو خير لكم لكل امري منهم ما اكتسب من الاثم والذي تولىٰ كبره منهم له عذاب عظيم" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2848" ;
        quran:page                     "351" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1754  quran:ayah_text            "جَنَّٰتُ عَدۡنٖ يَدۡخُلُونَهَا وَمَن صَلَحَ مِنۡ ءَابَآئِهِمۡ وَأَزۡوَٰجِهِمۡ وَذُرِّيَّٰتِهِمۡۖ وَٱلۡمَلَٰٓئِكَةُ يَدۡخُلُونَ عَلَيۡهِم مِّن كُلِّ بَابٖ" ;
        quran:ayah_text_no_diacratic   "جنٰت عدن يدخلونها ومن صلح من ءابائهم وازوٰجهم وذريٰتهم والملٰئكة يدخلون عليهم من كل باب" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1754" ;
        quran:page                     "252" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

