        quran:index                    "2016" ;
        quran:page                     "276" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:630  quran:ayah_text             "وَإِن يَتَفَرَّقَا يُغۡنِ ٱللَّهُ كُلّٗا مِّن سَعَتِهِۦۚ وَكَانَ ٱللَّهُ وَٰسِعًا حَكِيمٗا" ;
        quran:ayah_text_no_diacratic   "وان يتفرقا يغن الله كلا من سعته وكان الله وٰسعا حكيما" ;
        quran:ayahnumber               "130" ;
