quran:1587  quran:ayah_text            "وَلَمَّا جَآءَ أَمۡرُنَا نَجَّيۡنَا شُعَيۡبٗا وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ بِرَحۡمَةٖ مِّنَّا وَأَخَذَتِ ٱلَّذِينَ ظَلَمُواْ ٱلصَّيۡحَةُ فَأَصۡبَحُواْ فِي دِيَٰرِهِمۡ جَٰثِمِينَ" ;
        quran:ayah_text_no_diacratic   "ولما جاء امرنا نجينا شعيبا والذين ءامنوا معه برحمة منا واخذت الذين ظلموا الصيحة فاصبحوا في ديٰرهم جٰثمين" ;
        quran:ayahnumber               "94" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1587" ;
        quran:page                     "232" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

