        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:1884  quran:ayah_text            "قَالَ أَبَشَّرۡتُمُونِي عَلَىٰٓ أَن مَّسَّنِيَ ٱلۡكِبَرُ فَبِمَ تُبَشِّرُونَ" ;
        quran:ayah_text_no_diacratic   "قال ابشرتموني علىٰ ان مسني الكبر فبم تبشرون" ;
        quran:ayahnumber               "54" ;
