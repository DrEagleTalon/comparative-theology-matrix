quran:1751  quran:ayah_text            "ٱلَّذِينَ يُوفُونَ بِعَهۡدِ ٱللَّهِ وَلَا يَنقُضُونَ ٱلۡمِيثَٰقَ" ;
        quran:ayah_text_no_diacratic   "الذين يوفون بعهد الله ولا ينقضون الميثٰق" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1751" ;
        quran:page                     "252" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:2655  quran:ayah_text            "أَلَمۡ تَرَ أَنَّ ٱللَّهَ يَسۡجُدُۤ لَهُۥۤ مَن فِي ٱلسَّمَٰوَٰتِ وَمَن فِي ٱلۡأَرۡضِ وَٱلشَّمۡسُ وَٱلۡقَمَرُ وَٱلنُّجُومُ وَٱلۡجِبَالُ وَٱلشَّجَرُ وَٱلدَّوَآبُّ وَكَثِيرٞ مِّنَ ٱلنَّاسِۖ وَكَثِيرٌ حَقَّ عَلَيۡهِ ٱلۡعَذَابُۗ وَمَن يُهِنِ ٱللَّهُ فَمَا لَهُۥ مِن مُّكۡرِمٍۚ إِنَّ ٱللَّهَ يَفۡعَلُ مَا يَشَآءُ۩" ;
        quran:ayah_text_no_diacratic   "الم تر ان الله يسجد له من في السمٰوٰت ومن في الارض والشمس والقمر والنجوم والجبال والشجر والدواب وكثير من الناس وكثير حق عليه العذاب ومن يهن الله فما له من مكرم ان الله يفعل ما يشاء" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2655" ;
        quran:page                     "334" ;
        quran:sajdah                   "1" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:6390  quran:ayah_text            "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ" ;
        quran:ayah_text_no_diacratic   "التي تطلع على الافدة" ;
