quran:4390  quran:ayah_text            "فَمَآ أُوتِيتُم مِّن شَيۡءٖ فَمَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَمَا عِندَ ٱللَّهِ خَيۡرٞ وَأَبۡقَىٰ لِلَّذِينَ ءَامَنُواْ وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ" ;
        quran:ayah_text_no_diacratic   "فما اوتيتم من شيء فمتٰع الحيوٰة الدنيا وما عند الله خير وابقىٰ للذين ءامنوا وعلىٰ ربهم يتوكلون" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4390" ;
        quran:page                     "487" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:1559  quran:ayah_text            "فَلَمَّا جَآءَ أَمۡرُنَا نَجَّيۡنَا صَٰلِحٗا وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ بِرَحۡمَةٖ مِّنَّا وَمِنۡ خِزۡيِ يَوۡمِئِذٍۚ إِنَّ رَبَّكَ هُوَ ٱلۡقَوِيُّ ٱلۡعَزِيزُ" ;
        quran:ayah_text_no_diacratic   "فلما جاء امرنا نجينا صٰلحا والذين ءامنوا معه برحمة منا ومن خزي يومئذ ان ربك هو القوي العزيز" ;
        quran:ayahnumber               "66" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1559" ;
        quran:page                     "229" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:5294  quran:ayah_text            "تُؤۡمِنُونَ بِٱللَّهِ وَرَسُولِهِۦ وَتُجَٰهِدُونَ فِي سَبِيلِ ٱللَّهِ بِأَمۡوَٰلِكُمۡ وَأَنفُسِكُمۡۚ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "تؤمنون بالله ورسوله وتجٰهدون في سبيل الله باموٰلكم وانفسكم ذٰلكم خير لكم ان كنتم تعلمون" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5294" ;
        quran:page                     "552" ;
        quran:surahname                "سُورَةُ الصَّفِّ" ;
        quran:surahnumber              "61" ;
        quran:surrahname_no_diacratic  "سورة الصف" .

quran:2703  quran:ayah_text            "وَهُوَ ٱلَّذِيٓ أَحۡيَاكُمۡ ثُمَّ يُمِيتُكُمۡ ثُمَّ يُحۡيِيكُمۡۗ إِنَّ ٱلۡإِنسَٰنَ لَكَفُورٞ" ;
        quran:ayah_text_no_diacratic   "وهو الذي احياكم ثم يميتكم ثم يحييكم ان الانسٰن لكفور" ;
        quran:ayahnumber               "66" ;
