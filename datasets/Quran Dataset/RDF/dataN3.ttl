quran:1104  quran:ayah_text            "وَأَوۡرَثۡنَا ٱلۡقَوۡمَ ٱلَّذِينَ كَانُواْ يُسۡتَضۡعَفُونَ مَشَٰرِقَ ٱلۡأَرۡضِ وَمَغَٰرِبَهَا ٱلَّتِي بَٰرَكۡنَا فِيهَاۖ وَتَمَّتۡ كَلِمَتُ رَبِّكَ ٱلۡحُسۡنَىٰ عَلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ بِمَا صَبَرُواْۖ وَدَمَّرۡنَا مَا كَانَ يَصۡنَعُ فِرۡعَوۡنُ وَقَوۡمُهُۥ وَمَا كَانُواْ يَعۡرِشُونَ" ;
        quran:ayah_text_no_diacratic   "واورثنا القوم الذين كانوا يستضعفون مشٰرق الارض ومغٰربها التي بٰركنا فيها وتمت كلمت ربك الحسنىٰ علىٰ بني اسرٰءيل بما صبروا ودمرنا ما كان يصنع فرعون وقومه وما كانوا يعرشون" ;
        quran:ayahnumber               "137" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1104" ;
        quran:page                     "166" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:812  quran:ayah_text             "قُل لِّمَن مَّا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ قُل لِّلَّهِۚ كَتَبَ عَلَىٰ نَفۡسِهِ ٱلرَّحۡمَةَۚ لَيَجۡمَعَنَّكُمۡ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ لَا رَيۡبَ فِيهِۚ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ فَهُمۡ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "قل لمن ما في السمٰوٰت والارض قل لله كتب علىٰ نفسه الرحمة ليجمعنكم الىٰ يوم القيٰمة لا ريب فيه الذين خسروا انفسهم فهم لا يؤمنون" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "812" ;
        quran:page                     "129" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2008  quran:ayah_text            "وَلِلَّهِ غَيۡبُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَمَآ أَمۡرُ ٱلسَّاعَةِ إِلَّا كَلَمۡحِ ٱلۡبَصَرِ أَوۡ هُوَ أَقۡرَبُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "ولله غيب السمٰوٰت والارض وما امر الساعة الا كلمح البصر او هو اقرب ان الله علىٰ كل شيء قدير" ;
        quran:ayahnumber               "77" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2008" ;
        quran:page                     "275" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:622  quran:ayah_text             "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ سَنُدۡخِلُهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ وَعۡدَ ٱللَّهِ حَقّٗاۚ وَمَنۡ أَصۡدَقُ مِنَ ٱللَّهِ قِيلٗا" ;
        quran:ayah_text_no_diacratic   "والذين ءامنوا وعملوا الصٰلحٰت سندخلهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها ابدا وعد الله حقا ومن اصدق من الله قيلا" ;
        quran:ayahnumber               "122" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "622" ;
        quran:page                     "98" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:432  quran:ayah_text             "ٱلَّذِينَ يُنفِقُونَ فِي ٱلسَّرَّآءِ وَٱلضَّرَّآءِ وَٱلۡكَٰظِمِينَ ٱلۡغَيۡظَ وَٱلۡعَافِينَ عَنِ ٱلنَّاسِۗ وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "الذين ينفقون في السراء والضراء والكٰظمين الغيظ والعافين عن الناس والله يحب المحسنين" ;
        quran:ayahnumber               "134" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "432" ;
        quran:page                     "67" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

