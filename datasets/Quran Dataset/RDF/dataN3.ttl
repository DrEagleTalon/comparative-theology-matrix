quran:1334  quran:ayah_text            "فَإِن رَّجَعَكَ ٱللَّهُ إِلَىٰ طَآئِفَةٖ مِّنۡهُمۡ فَٱسۡتَـٔۡذَنُوكَ لِلۡخُرُوجِ فَقُل لَّن تَخۡرُجُواْ مَعِيَ أَبَدٗا وَلَن تُقَٰتِلُواْ مَعِيَ عَدُوًّاۖ إِنَّكُمۡ رَضِيتُم بِٱلۡقُعُودِ أَوَّلَ مَرَّةٖ فَٱقۡعُدُواْ مَعَ ٱلۡخَٰلِفِينَ" ;
        quran:ayah_text_no_diacratic   "فان رجعك الله الىٰ طائفة منهم فاستذنوك للخروج فقل لن تخرجوا معي ابدا ولن تقٰتلوا معي عدوا انكم رضيتم بالقعود اول مرة فاقعدوا مع الخٰلفين" ;
        quran:ayahnumber               "83" ;
        quran:chapter                  "10" ;
        quran:hizb                     "20" ;
        quran:index                    "1334" ;
        quran:page                     "200" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2238  quran:ayah_text            "قَالَ ذَٰلِكَ مَا كُنَّا نَبۡغِۚ فَٱرۡتَدَّا عَلَىٰٓ ءَاثَارِهِمَا قَصَصٗا" ;
        quran:ayah_text_no_diacratic   "قال ذٰلك ما كنا نبغ فارتدا علىٰ ءاثارهما قصصا" ;
        quran:ayahnumber               "64" ;
