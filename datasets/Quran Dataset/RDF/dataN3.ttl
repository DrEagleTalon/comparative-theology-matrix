        quran:index                    "1227" ;
        quran:page                     "183" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:935  quran:ayah_text             "قُلۡ يَٰقَوۡمِ ٱعۡمَلُواْ عَلَىٰ مَكَانَتِكُمۡ إِنِّي عَامِلٞۖ فَسَوۡفَ تَعۡلَمُونَ مَن تَكُونُ لَهُۥ عَٰقِبَةُ ٱلدَّارِۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلظَّٰلِمُونَ" ;
        quran:ayah_text_no_diacratic   "قل يٰقوم اعملوا علىٰ مكانتكم اني عامل فسوف تعلمون من تكون له عٰقبة الدار انه لا يفلح الظٰلمون" ;
        quran:ayahnumber               "135" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "935" ;
        quran:page                     "145" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1037  quran:ayah_text            "قَالُوٓاْ أَجِئۡتَنَا لِنَعۡبُدَ ٱللَّهَ وَحۡدَهُۥ وَنَذَرَ مَا كَانَ يَعۡبُدُ ءَابَآؤُنَا فَأۡتِنَا بِمَا تَعِدُنَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "قالوا اجئتنا لنعبد الله وحده ونذر ما كان يعبد ءاباؤنا فاتنا بما تعدنا ان كنت من الصٰدقين" ;
        quran:ayahnumber               "70" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1037" ;
        quran:page                     "159" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:745  quran:ayah_text             "۞يَٰٓأَيُّهَا ٱلرَّسُولُ بَلِّغۡ مَآ أُنزِلَ إِلَيۡكَ مِن رَّبِّكَۖ وَإِن لَّمۡ تَفۡعَلۡ فَمَا بَلَّغۡتَ رِسَالَتَهُۥۚ وَٱللَّهُ يَعۡصِمُكَ مِنَ ٱلنَّاسِۗ إِنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الرسول بلغ ما انزل اليك من ربك وان لم تفعل فما بلغت رسالته والله يعصمك من الناس ان الله لا يهدي القوم الكٰفرين" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "745" ;
        quran:page                     "119" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:555  quran:ayah_text             "فَمِنۡهُم مَّنۡ ءَامَنَ بِهِۦ وَمِنۡهُم مَّن صَدَّ عَنۡهُۚ وَكَفَىٰ بِجَهَنَّمَ سَعِيرًا" ;
        quran:ayah_text_no_diacratic   "فمنهم من ءامن به ومنهم من صد عنه وكفىٰ بجهنم سعيرا" ;
        quran:ayahnumber               "55" ;
