quran:1218  quran:ayah_text            "إِذۡ يُرِيكَهُمُ ٱللَّهُ فِي مَنَامِكَ قَلِيلٗاۖ وَلَوۡ أَرَىٰكَهُمۡ كَثِيرٗا لَّفَشِلۡتُمۡ وَلَتَنَٰزَعۡتُمۡ فِي ٱلۡأَمۡرِ وَلَٰكِنَّ ٱللَّهَ سَلَّمَۚ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ" ;
        quran:ayah_text_no_diacratic   "اذ يريكهم الله في منامك قليلا ولو ارىٰكهم كثيرا لفشلتم ولتنٰزعتم في الامر ولٰكن الله سلم انه عليم بذات الصدور" ;
        quran:ayahnumber               "43" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1218" ;
        quran:page                     "182" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:926  quran:ayah_text             "وَهَٰذَا صِرَٰطُ رَبِّكَ مُسۡتَقِيمٗاۗ قَدۡ فَصَّلۡنَا ٱلۡأٓيَٰتِ لِقَوۡمٖ يَذَّكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "وهٰذا صرٰط ربك مستقيما قد فصلنا الايٰت لقوم يذكرون" ;
        quran:ayahnumber               "126" ;
        quran:chapter                  "8" ;
