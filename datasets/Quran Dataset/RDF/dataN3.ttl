        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3119  quran:ayah_text            "إِنۡ هَٰذَآ إِلَّا خُلُقُ ٱلۡأَوَّلِينَ" ;
