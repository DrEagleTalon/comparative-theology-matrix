        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:5625  quran:ayah_text            "إِنَّ نَاشِئَةَ ٱلَّيۡلِ هِيَ أَشَدُّ وَطۡـٔٗا وَأَقۡوَمُ قِيلًا" ;
        quran:ayah_text_no_diacratic   "ان ناشئة اليل هي اشد وطا واقوم قيلا" ;
