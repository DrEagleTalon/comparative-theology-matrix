quran:1766  quran:ayah_text            "۞مَّثَلُ ٱلۡجَنَّةِ ٱلَّتِي وُعِدَ ٱلۡمُتَّقُونَۖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ أُكُلُهَا دَآئِمٞ وَظِلُّهَاۚ تِلۡكَ عُقۡبَى ٱلَّذِينَ ٱتَّقَواْۚ وَّعُقۡبَى ٱلۡكَٰفِرِينَ ٱلنَّارُ" ;
        quran:ayah_text_no_diacratic   "مثل الجنة التي وعد المتقون تجري من تحتها الانهٰر اكلها دائم وظلها تلك عقبى الذين اتقوا وعقبى الكٰفرين النار" ;
        quran:ayahnumber               "35" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1766" ;
        quran:page                     "254" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:2910  quran:ayah_text            "وَقَالُواْ مَالِ هَٰذَا ٱلرَّسُولِ يَأۡكُلُ ٱلطَّعَامَ وَيَمۡشِي فِي ٱلۡأَسۡوَاقِ لَوۡلَآ أُنزِلَ إِلَيۡهِ مَلَكٞ فَيَكُونَ مَعَهُۥ نَذِيرًا" ;
        quran:ayah_text_no_diacratic   "وقالوا مال هٰذا الرسول ياكل الطعام ويمشي في الاسواق لولا انزل اليه ملك فيكون معه نذيرا" ;
