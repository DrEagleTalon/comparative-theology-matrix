        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4267  quran:ayah_text            "إِنَّ ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِ ٱللَّهِ بِغَيۡرِ سُلۡطَٰنٍ أَتَىٰهُمۡ إِن فِي صُدُورِهِمۡ إِلَّا كِبۡرٞ مَّا هُم بِبَٰلِغِيهِۚ فَٱسۡتَعِذۡ بِٱللَّهِۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ" ;
        quran:ayah_text_no_diacratic   "ان الذين يجٰدلون في ءايٰت الله بغير سلطٰن اتىٰهم ان في صدورهم الا كبر ما هم ببٰلغيه فاستعذ بالله انه هو السميع البصير" ;
        quran:ayahnumber               "56" ;
