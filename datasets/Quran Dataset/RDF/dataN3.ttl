        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1286  quran:ayah_text            "يَوۡمَ يُحۡمَىٰ عَلَيۡهَا فِي نَارِ جَهَنَّمَ فَتُكۡوَىٰ بِهَا جِبَاهُهُمۡ وَجُنُوبُهُمۡ وَظُهُورُهُمۡۖ هَٰذَا مَا كَنَزۡتُمۡ لِأَنفُسِكُمۡ فَذُوقُواْ مَا كُنتُمۡ تَكۡنِزُونَ" ;
        quran:ayah_text_no_diacratic   "يوم يحمىٰ عليها في نار جهنم فتكوىٰ بها جباههم وجنوبهم وظهورهم هٰذا ما كنزتم لانفسكم فذوقوا ما كنتم تكنزون" ;
        quran:ayahnumber               "35" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1286" ;
        quran:page                     "192" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:994  quran:ayah_text             "يَٰبَنِيٓ ءَادَمَ لَا يَفۡتِنَنَّكُمُ ٱلشَّيۡطَٰنُ كَمَآ أَخۡرَجَ أَبَوَيۡكُم مِّنَ ٱلۡجَنَّةِ يَنزِعُ عَنۡهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا سَوۡءَٰتِهِمَآۚ إِنَّهُۥ يَرَىٰكُمۡ هُوَ وَقَبِيلُهُۥ مِنۡ حَيۡثُ لَا تَرَوۡنَهُمۡۗ إِنَّا جَعَلۡنَا ٱلشَّيَٰطِينَ أَوۡلِيَآءَ لِلَّذِينَ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "يٰبني ءادم لا يفتننكم الشيطٰن كما اخرج ابويكم من الجنة ينزع عنهما لباسهما ليريهما سوءٰتهما انه يرىٰكم هو وقبيله من حيث لا ترونهم انا جعلنا الشيٰطين اولياء للذين لا يؤمنون" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "994" ;
        quran:page                     "153" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:4428  quran:ayah_text            "وَجَعَلُواْ ٱلۡمَلَٰٓئِكَةَ ٱلَّذِينَ هُمۡ عِبَٰدُ ٱلرَّحۡمَٰنِ إِنَٰثًاۚ أَشَهِدُواْ خَلۡقَهُمۡۚ سَتُكۡتَبُ شَهَٰدَتُهُمۡ وَيُسۡـَٔلُونَ" ;
        quran:ayah_text_no_diacratic   "وجعلوا الملٰئكة الذين هم عبٰد الرحمٰن انٰثا اشهدوا خلقهم ستكتب شهٰدتهم ويسلون" ;
        quran:ayahnumber               "19" ;
