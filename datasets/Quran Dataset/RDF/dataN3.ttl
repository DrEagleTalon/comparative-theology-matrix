quran:3790  quran:ayah_text            "قَالُواْ مَآ أَنتُمۡ إِلَّا بَشَرٞ مِّثۡلُنَا وَمَآ أَنزَلَ ٱلرَّحۡمَٰنُ مِن شَيۡءٍ إِنۡ أَنتُمۡ إِلَّا تَكۡذِبُونَ" ;
        quran:ayah_text_no_diacratic   "قالوا ما انتم الا بشر مثلنا وما انزل الرحمٰن من شيء ان انتم الا تكذبون" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "22" ;
        quran:hizb                     "44" ;
        quran:index                    "3790" ;
