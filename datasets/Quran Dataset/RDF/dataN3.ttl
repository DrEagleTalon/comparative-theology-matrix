        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2312  quran:ayah_text            "فَكُلِي وَٱشۡرَبِي وَقَرِّي عَيۡنٗاۖ فَإِمَّا تَرَيِنَّ مِنَ ٱلۡبَشَرِ أَحَدٗا فَقُولِيٓ إِنِّي نَذَرۡتُ لِلرَّحۡمَٰنِ صَوۡمٗا فَلَنۡ أُكَلِّمَ ٱلۡيَوۡمَ إِنسِيّٗا" ;
        quran:ayah_text_no_diacratic   "فكلي واشربي وقري عينا فاما ترين من البشر احدا فقولي اني نذرت للرحمٰن صوما فلن اكلم اليوم انسيا" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2312" ;
        quran:page                     "307" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:3216  quran:ayah_text            "أُوْلَٰٓئِكَ ٱلَّذِينَ لَهُمۡ سُوٓءُ ٱلۡعَذَابِ وَهُمۡ فِي ٱلۡأٓخِرَةِ هُمُ ٱلۡأَخۡسَرُونَ" ;
        quran:ayah_text_no_diacratic   "اولٰئك الذين لهم سوء العذاب وهم في الاخرة هم الاخسرون" ;
        quran:ayahnumber               "5" ;
