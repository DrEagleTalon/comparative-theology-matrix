        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:2912  quran:ayah_text            "ٱنظُرۡ كَيۡفَ ضَرَبُواْ لَكَ ٱلۡأَمۡثَٰلَ فَضَلُّواْ فَلَا يَسۡتَطِيعُونَ سَبِيلٗا" ;
        quran:ayah_text_no_diacratic   "انظر كيف ضربوا لك الامثٰل فضلوا فلا يستطيعون سبيلا" ;
