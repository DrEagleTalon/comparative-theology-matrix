quran:472  quran:ayah_text             "فَٱنقَلَبُواْ بِنِعۡمَةٖ مِّنَ ٱللَّهِ وَفَضۡلٖ لَّمۡ يَمۡسَسۡهُمۡ سُوٓءٞ وَٱتَّبَعُواْ رِضۡوَٰنَ ٱللَّهِۗ وَٱللَّهُ ذُو فَضۡلٍ عَظِيمٍ" ;
        quran:ayah_text_no_diacratic   "فانقلبوا بنعمة من الله وفضل لم يمسسهم سوء واتبعوا رضوٰن الله والله ذو فضل عظيم" ;
        quran:ayahnumber               "174" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "472" ;
        quran:page                     "73" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:282  quran:ayah_text             "۞لَّيۡسَ عَلَيۡكَ هُدَىٰهُمۡ وَلَٰكِنَّ ٱللَّهَ يَهۡدِي مَن يَشَآءُۗ وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ فَلِأَنفُسِكُمۡۚ وَمَا تُنفِقُونَ إِلَّا ٱبۡتِغَآءَ وَجۡهِ ٱللَّهِۚ وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ يُوَفَّ إِلَيۡكُمۡ وَأَنتُمۡ لَا تُظۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ليس عليك هدىٰهم ولٰكن الله يهدي من يشاء وما تنفقوا من خير فلانفسكم وما تنفقون الا ابتغاء وجه الله وما تنفقوا من خير يوف اليكم وانتم لا تظلمون" ;
        quran:ayahnumber               "272" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "282" ;
        quran:page                     "46" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1886  quran:ayah_text            "قَالَ وَمَن يَقۡنَطُ مِن رَّحۡمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ" ;
        quran:ayah_text_no_diacratic   "قال ومن يقنط من رحمة ربه الا الضالون" ;
