        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:4619  quran:ayah_text            "وَلِكُلّٖ دَرَجَٰتٞ مِّمَّا عَمِلُواْۖ وَلِيُوَفِّيَهُمۡ أَعۡمَٰلَهُمۡ وَهُمۡ لَا يُظۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ولكل درجٰت مما عملوا وليوفيهم اعمٰلهم وهم لا يظلمون" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "26" ;
