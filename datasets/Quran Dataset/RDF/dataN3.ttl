quran:636  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ ءَامِنُواْ بِٱللَّهِ وَرَسُولِهِۦ وَٱلۡكِتَٰبِ ٱلَّذِي نَزَّلَ عَلَىٰ رَسُولِهِۦ وَٱلۡكِتَٰبِ ٱلَّذِيٓ أَنزَلَ مِن قَبۡلُۚ وَمَن يَكۡفُرۡ بِٱللَّهِ وَمَلَٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ فَقَدۡ ضَلَّ ضَلَٰلَۢا بَعِيدًا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا ءامنوا بالله ورسوله والكتٰب الذي نزل علىٰ رسوله والكتٰب الذي انزل من قبل ومن يكفر بالله وملٰئكته وكتبه ورسله واليوم الاخر فقد ضل ضلٰلا بعيدا" ;
        quran:ayahnumber               "136" ;
        quran:chapter                  "5" ;
        quran:hizb                     "10" ;
        quran:index                    "636" ;
        quran:page                     "100" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:446  quran:ayah_text             "فَـَٔاتَىٰهُمُ ٱللَّهُ ثَوَابَ ٱلدُّنۡيَا وَحُسۡنَ ثَوَابِ ٱلۡأٓخِرَةِۗ وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "فاتىٰهم الله ثواب الدنيا وحسن ثواب الاخرة والله يحب المحسنين" ;
        quran:ayahnumber               "148" ;
