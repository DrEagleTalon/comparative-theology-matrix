        quran:index                    "4974" ;
        quran:page                     "529" ;
        quran:surahname                "سُورَةُ القَمَرِ" ;
        quran:surahnumber              "54" ;
        quran:surrahname_no_diacratic  "سورة القمر" .

quran:349  quran:ayah_text             "إِنَّ ٱللَّهَ رَبِّي وَرَبُّكُمۡ فَٱعۡبُدُوهُۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ" ;
        quran:ayah_text_no_diacratic   "ان الله ربي وربكم فاعبدوه هٰذا صرٰط مستقيم" ;
