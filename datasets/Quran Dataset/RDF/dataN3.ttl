quran:6330  quran:ayah_text            "جَزَآؤُهُمۡ عِندَ رَبِّهِمۡ جَنَّٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ رَّضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُۚ ذَٰلِكَ لِمَنۡ خَشِيَ رَبَّهُۥ" ;
        quran:ayah_text_no_diacratic   "جزاؤهم عند ربهم جنٰت عدن تجري من تحتها الانهٰر خٰلدين فيها ابدا رضي الله عنهم ورضوا عنه ذٰلك لمن خشي ربه" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "30" ;
        quran:hizb                     "59" ;
        quran:index                    "6330" ;
        quran:page                     "599" ;
        quran:surahname                "سُورَةُ البَيِّنَةِ" ;
        quran:surahnumber              "98" ;
        quran:surrahname_no_diacratic  "سورة البينة" .

quran:4092  quran:ayah_text            "وَٱذۡكُرۡ إِسۡمَٰعِيلَ وَٱلۡيَسَعَ وَذَا ٱلۡكِفۡلِۖ وَكُلّٞ مِّنَ ٱلۡأَخۡيَارِ" ;
        quran:ayah_text_no_diacratic   "واذكر اسمٰعيل واليسع وذا الكفل وكل من الاخيار" ;
        quran:ayahnumber               "48" ;
