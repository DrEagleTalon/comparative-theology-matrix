quran:2859  quran:ayah_text            "وَلَا يَأۡتَلِ أُوْلُواْ ٱلۡفَضۡلِ مِنكُمۡ وَٱلسَّعَةِ أَن يُؤۡتُوٓاْ أُوْلِي ٱلۡقُرۡبَىٰ وَٱلۡمَسَٰكِينَ وَٱلۡمُهَٰجِرِينَ فِي سَبِيلِ ٱللَّهِۖ وَلۡيَعۡفُواْ وَلۡيَصۡفَحُوٓاْۗ أَلَا تُحِبُّونَ أَن يَغۡفِرَ ٱللَّهُ لَكُمۡۚ وَٱللَّهُ غَفُورٞ رَّحِيمٌ" ;
        quran:ayah_text_no_diacratic   "ولا ياتل اولوا الفضل منكم والسعة ان يؤتوا اولي القربىٰ والمسٰكين والمهٰجرين في سبيل الله وليعفوا وليصفحوا الا تحبون ان يغفر الله لكم والله غفور رحيم" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2859" ;
        quran:page                     "352" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1765  quran:ayah_text            "لَّهُمۡ عَذَابٞ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَشَقُّۖ وَمَا لَهُم مِّنَ ٱللَّهِ مِن وَاقٖ" ;
        quran:ayah_text_no_diacratic   "لهم عذاب في الحيوٰة الدنيا ولعذاب الاخرة اشق وما لهم من الله من واق" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1765" ;
