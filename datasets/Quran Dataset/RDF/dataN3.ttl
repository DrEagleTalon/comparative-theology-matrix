        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:769  quran:ayah_text             "إِنَّمَا يُرِيدُ ٱلشَّيۡطَٰنُ أَن يُوقِعَ بَيۡنَكُمُ ٱلۡعَدَٰوَةَ وَٱلۡبَغۡضَآءَ فِي ٱلۡخَمۡرِ وَٱلۡمَيۡسِرِ وَيَصُدَّكُمۡ عَن ذِكۡرِ ٱللَّهِ وَعَنِ ٱلصَّلَوٰةِۖ فَهَلۡ أَنتُم مُّنتَهُونَ" ;
        quran:ayah_text_no_diacratic   "انما يريد الشيطٰن ان يوقع بينكم العدٰوة والبغضاء في الخمر والميسر ويصدكم عن ذكر الله وعن الصلوٰة فهل انتم منتهون" ;
        quran:ayahnumber               "91" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "769" ;
        quran:page                     "123" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2205  quran:ayah_text            "أُوْلَٰٓئِكَ لَهُمۡ جَنَّٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهِمُ ٱلۡأَنۡهَٰرُ يُحَلَّوۡنَ فِيهَا مِنۡ أَسَاوِرَ مِن ذَهَبٖ وَيَلۡبَسُونَ ثِيَابًا خُضۡرٗا مِّن سُندُسٖ وَإِسۡتَبۡرَقٖ مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلۡأَرَآئِكِۚ نِعۡمَ ٱلثَّوَابُ وَحَسُنَتۡ مُرۡتَفَقٗا" ;
        quran:ayah_text_no_diacratic   "اولٰئك لهم جنٰت عدن تجري من تحتهم الانهٰر يحلون فيها من اساور من ذهب ويلبسون ثيابا خضرا من سندس واستبرق متكين فيها على الارائك نعم الثواب وحسنت مرتفقا" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2205" ;
        quran:page                     "297" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3109  quran:ayah_text            "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "وما اسلكم عليه من اجر ان اجري الا علىٰ رب العٰلمين" ;
        quran:ayahnumber               "127" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3109" ;
        quran:page                     "372" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:1111  quran:ayah_text            "قَالَ يَٰمُوسَىٰٓ إِنِّي ٱصۡطَفَيۡتُكَ عَلَى ٱلنَّاسِ بِرِسَٰلَٰتِي وَبِكَلَٰمِي فَخُذۡ مَآ ءَاتَيۡتُكَ وَكُن مِّنَ ٱلشَّٰكِرِينَ" ;
        quran:ayah_text_no_diacratic   "قال يٰموسىٰ اني اصطفيتك على الناس برسٰلٰتي وبكلٰمي فخذ ما ءاتيتك وكن من الشٰكرين" ;
        quran:ayahnumber               "144" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1111" ;
        quran:page                     "168" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:579  quran:ayah_text             "مَّآ أَصَابَكَ مِنۡ حَسَنَةٖ فَمِنَ ٱللَّهِۖ وَمَآ أَصَابَكَ مِن سَيِّئَةٖ فَمِن نَّفۡسِكَۚ وَأَرۡسَلۡنَٰكَ لِلنَّاسِ رَسُولٗاۚ وَكَفَىٰ بِٱللَّهِ شَهِيدٗا" ;
        quran:ayah_text_no_diacratic   "ما اصابك من حسنة فمن الله وما اصابك من سيئة فمن نفسك وارسلنٰك للناس رسولا وكفىٰ بالله شهيدا" ;
        quran:ayahnumber               "79" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "579" ;
        quran:page                     "90" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2015  quran:ayah_text            "وَيَوۡمَ نَبۡعَثُ مِن كُلِّ أُمَّةٖ شَهِيدٗا ثُمَّ لَا يُؤۡذَنُ لِلَّذِينَ كَفَرُواْ وَلَا هُمۡ يُسۡتَعۡتَبُونَ" ;
        quran:ayah_text_no_diacratic   "ويوم نبعث من كل امة شهيدا ثم لا يؤذن للذين كفروا ولا هم يستعتبون" ;
        quran:ayahnumber               "84" ;
        quran:chapter                  "14" ;
