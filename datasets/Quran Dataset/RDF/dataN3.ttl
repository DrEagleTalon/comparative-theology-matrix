quran:6306  quran:ayah_text            "أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ" ;
        quran:ayah_text_no_diacratic   "ارءيت ان كان على الهدىٰ" ;
        quran:ayahnumber               "11" ;
