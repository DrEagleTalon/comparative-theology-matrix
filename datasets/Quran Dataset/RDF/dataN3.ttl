quran:389  quran:ayah_text             "إِنَّ ٱلَّذِينَ كَفَرُواْ وَمَاتُواْ وَهُمۡ كُفَّارٞ فَلَن يُقۡبَلَ مِنۡ أَحَدِهِم مِّلۡءُ ٱلۡأَرۡضِ ذَهَبٗا وَلَوِ ٱفۡتَدَىٰ بِهِۦٓۗ أُوْلَٰٓئِكَ لَهُمۡ عَذَابٌ أَلِيمٞ وَمَا لَهُم مِّن نَّٰصِرِينَ" ;
        quran:ayah_text_no_diacratic   "ان الذين كفروا وماتوا وهم كفار فلن يقبل من احدهم ملء الارض ذهبا ولو افتدىٰ به اولٰئك لهم عذاب اليم وما لهم من نٰصرين" ;
        quran:ayahnumber               "91" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "389" ;
        quran:page                     "61" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:199  quran:ayah_text             "۞يَسۡـَٔلُونَكَ عَنِ ٱلۡأَهِلَّةِۖ قُلۡ هِيَ مَوَٰقِيتُ لِلنَّاسِ وَٱلۡحَجِّۗ وَلَيۡسَ ٱلۡبِرُّ بِأَن تَأۡتُواْ ٱلۡبُيُوتَ مِن ظُهُورِهَا وَلَٰكِنَّ ٱلۡبِرَّ مَنِ ٱتَّقَىٰۗ وَأۡتُواْ ٱلۡبُيُوتَ مِنۡ أَبۡوَٰبِهَاۚ وَٱتَّقُواْ ٱللَّهَ لَعَلَّكُمۡ تُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "يسلونك عن الاهلة قل هي موٰقيت للناس والحج وليس البر بان تاتوا البيوت من ظهورها ولٰكن البر من اتقىٰ واتوا البيوت من ابوٰبها واتقوا الله لعلكم تفلحون" ;
        quran:ayahnumber               "189" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "199" ;
        quran:page                     "29" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2947  quran:ayah_text            "أَمۡ تَحۡسَبُ أَنَّ أَكۡثَرَهُمۡ يَسۡمَعُونَ أَوۡ يَعۡقِلُونَۚ إِنۡ هُمۡ إِلَّا كَٱلۡأَنۡعَٰمِ بَلۡ هُمۡ أَضَلُّ سَبِيلًا" ;
        quran:ayah_text_no_diacratic   "ام تحسب ان اكثرهم يسمعون او يعقلون ان هم الا كالانعٰم بل هم اضل سبيلا" ;
