quran:3607  quran:ayah_text            "إِذۡ جَآءُوكُم مِّن فَوۡقِكُمۡ وَمِنۡ أَسۡفَلَ مِنكُمۡ وَإِذۡ زَاغَتِ ٱلۡأَبۡصَٰرُ وَبَلَغَتِ ٱلۡقُلُوبُ ٱلۡحَنَاجِرَ وَتَظُنُّونَ بِٱللَّهِ ٱلظُّنُونَا۠" ;
        quran:ayah_text_no_diacratic   "اذ جاءوكم من فوقكم ومن اسفل منكم واذ زاغت الابصٰر وبلغت القلوب الحناجر وتظنون بالله الظنونا" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3607" ;
        quran:page                     "419" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1369  quran:ayah_text            "وَعَلَى ٱلثَّلَٰثَةِ ٱلَّذِينَ خُلِّفُواْ حَتَّىٰٓ إِذَا ضَاقَتۡ عَلَيۡهِمُ ٱلۡأَرۡضُ بِمَا رَحُبَتۡ وَضَاقَتۡ عَلَيۡهِمۡ أَنفُسُهُمۡ وَظَنُّوٓاْ أَن لَّا مَلۡجَأَ مِنَ ٱللَّهِ إِلَّآ إِلَيۡهِ ثُمَّ تَابَ عَلَيۡهِمۡ لِيَتُوبُوٓاْۚ إِنَّ ٱللَّهَ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ" ;
        quran:ayah_text_no_diacratic   "وعلى الثلٰثة الذين خلفوا حتىٰ اذا ضاقت عليهم الارض بما رحبت وضاقت عليهم انفسهم وظنوا ان لا ملجا من الله الا اليه ثم تاب عليهم ليتوبوا ان الله هو التواب الرحيم" ;
        quran:ayahnumber               "118" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1369" ;
        quran:page                     "206" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2513  quran:ayah_text            "وَكَذَٰلِكَ نَجۡزِي مَنۡ أَسۡرَفَ وَلَمۡ يُؤۡمِنۢ بِـَٔايَٰتِ رَبِّهِۦۚ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَشَدُّ وَأَبۡقَىٰٓ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك نجزي من اسرف ولم يؤمن بايٰت ربه ولعذاب الاخرة اشد وابقىٰ" ;
        quran:ayahnumber               "127" ;
        quran:chapter                  "16" ;
        quran:hizb                     "32" ;
        quran:index                    "2513" ;
