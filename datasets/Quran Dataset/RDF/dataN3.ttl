quran:2654  quran:ayah_text            "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَٱلَّذِينَ هَادُواْ وَٱلصَّٰبِـِٔينَ وَٱلنَّصَٰرَىٰ وَٱلۡمَجُوسَ وَٱلَّذِينَ أَشۡرَكُوٓاْ إِنَّ ٱللَّهَ يَفۡصِلُ بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ" ;
        quran:ayah_text_no_diacratic   "ان الذين ءامنوا والذين هادوا والصٰبين والنصٰرىٰ والمجوس والذين اشركوا ان الله يفصل بينهم يوم القيٰمة ان الله علىٰ كل شيء شهيد" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2654" ;
        quran:page                     "334" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:3558  quran:ayah_text            "أَلَمۡ تَرَ أَنَّ ٱللَّهَ يُولِجُ ٱلَّيۡلَ فِي ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِي ٱلَّيۡلِ وَسَخَّرَ ٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ يَجۡرِيٓ إِلَىٰٓ أَجَلٖ مُّسَمّٗى وَأَنَّ ٱللَّهَ بِمَا تَعۡمَلُونَ خَبِيرٞ" ;
        quran:ayah_text_no_diacratic   "الم تر ان الله يولج اليل في النهار ويولج النهار في اليل وسخر الشمس والقمر كل يجري الىٰ اجل مسمى وان الله بما تعملون خبير" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3558" ;
        quran:page                     "414" ;
        quran:surahname                "سُورَةُ لُقۡمَانَ" ;
        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:1560  quran:ayah_text            "وَأَخَذَ ٱلَّذِينَ ظَلَمُواْ ٱلصَّيۡحَةُ فَأَصۡبَحُواْ فِي دِيَٰرِهِمۡ جَٰثِمِينَ" ;
        quran:ayah_text_no_diacratic   "واخذ الذين ظلموا الصيحة فاصبحوا في ديٰرهم جٰثمين" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1560" ;
        quran:page                     "229" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4702  quran:ayah_text            "هُمُ ٱلَّذِينَ كَفَرُواْ وَصَدُّوكُمۡ عَنِ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ وَٱلۡهَدۡيَ مَعۡكُوفًا أَن يَبۡلُغَ مَحِلَّهُۥۚ وَلَوۡلَا رِجَالٞ مُّؤۡمِنُونَ وَنِسَآءٞ مُّؤۡمِنَٰتٞ لَّمۡ تَعۡلَمُوهُمۡ أَن تَطَـُٔوهُمۡ فَتُصِيبَكُم مِّنۡهُم مَّعَرَّةُۢ بِغَيۡرِ عِلۡمٖۖ لِّيُدۡخِلَ ٱللَّهُ فِي رَحۡمَتِهِۦ مَن يَشَآءُۚ لَوۡ تَزَيَّلُواْ لَعَذَّبۡنَا ٱلَّذِينَ كَفَرُواْ مِنۡهُمۡ عَذَابًا أَلِيمًا" ;
        quran:ayah_text_no_diacratic   "هم الذين كفروا وصدوكم عن المسجد الحرام والهدي معكوفا ان يبلغ محله ولولا رجال مؤمنون ونساء مؤمنٰت لم تعلموهم ان تطوهم فتصيبكم منهم معرة بغير علم ليدخل الله في رحمته من يشاء لو تزيلوا لعذبنا الذين كفروا منهم عذابا اليما" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4702" ;
        quran:page                     "514" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:2464  quran:ayah_text            "فَأَتۡبَعَهُمۡ فِرۡعَوۡنُ بِجُنُودِهِۦ فَغَشِيَهُم مِّنَ ٱلۡيَمِّ مَا غَشِيَهُمۡ" ;
        quran:ayah_text_no_diacratic   "فاتبعهم فرعون بجنوده فغشيهم من اليم ما غشيهم" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "16" ;
