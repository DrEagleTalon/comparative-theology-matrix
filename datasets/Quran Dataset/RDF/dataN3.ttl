quran:1296  quran:ayah_text            "إِنَّمَا يَسۡتَـٔۡذِنُكَ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَٱرۡتَابَتۡ قُلُوبُهُمۡ فَهُمۡ فِي رَيۡبِهِمۡ يَتَرَدَّدُونَ" ;
        quran:ayah_text_no_diacratic   "انما يستذنك الذين لا يؤمنون بالله واليوم الاخر وارتابت قلوبهم فهم في ريبهم يترددون" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1296" ;
        quran:page                     "194" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4438  quran:ayah_text            "بَلۡ مَتَّعۡتُ هَٰٓؤُلَآءِ وَءَابَآءَهُمۡ حَتَّىٰ جَآءَهُمُ ٱلۡحَقُّ وَرَسُولٞ مُّبِينٞ" ;
        quran:ayah_text_no_diacratic   "بل متعت هٰؤلاء وءاباءهم حتىٰ جاءهم الحق ورسول مبين" ;
        quran:ayahnumber               "29" ;
