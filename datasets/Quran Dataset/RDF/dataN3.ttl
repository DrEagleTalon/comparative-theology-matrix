        quran:surahnumber              "37" ;
        quran:surrahname_no_diacratic  "سورة الصافات" .

quran:2010  quran:ayah_text            "أَلَمۡ يَرَوۡاْ إِلَى ٱلطَّيۡرِ مُسَخَّرَٰتٖ فِي جَوِّ ٱلسَّمَآءِ مَا يُمۡسِكُهُنَّ إِلَّا ٱللَّهُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "الم يروا الى الطير مسخرٰت في جو السماء ما يمسكهن الا الله ان في ذٰلك لايٰت لقوم يؤمنون" ;
        quran:ayahnumber               "79" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2010" ;
        quran:page                     "275" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:384  quran:ayah_text             "كَيۡفَ يَهۡدِي ٱللَّهُ قَوۡمٗا كَفَرُواْ بَعۡدَ إِيمَٰنِهِمۡ وَشَهِدُوٓاْ أَنَّ ٱلرَّسُولَ حَقّٞ وَجَآءَهُمُ ٱلۡبَيِّنَٰتُۚ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "كيف يهدي الله قوما كفروا بعد ايمٰنهم وشهدوا ان الرسول حق وجاءهم البينٰت والله لا يهدي القوم الظٰلمين" ;
        quran:ayahnumber               "86" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "384" ;
        quran:page                     "61" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:194  quran:ayah_text             "أَيَّامٗا مَّعۡدُودَٰتٖۚ فَمَن كَانَ مِنكُم مَّرِيضًا أَوۡ عَلَىٰ سَفَرٖ فَعِدَّةٞ مِّنۡ أَيَّامٍ أُخَرَۚ وَعَلَى ٱلَّذِينَ يُطِيقُونَهُۥ فِدۡيَةٞ طَعَامُ مِسۡكِينٖۖ فَمَن تَطَوَّعَ خَيۡرٗا فَهُوَ خَيۡرٞ لَّهُۥۚ وَأَن تَصُومُواْ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "اياما معدودٰت فمن كان منكم مريضا او علىٰ سفر فعدة من ايام اخر وعلى الذين يطيقونه فدية طعام مسكين فمن تطوع خيرا فهو خير له وان تصوموا خير لكم ان كنتم تعلمون" ;
        quran:ayahnumber               "184" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "194" ;
        quran:page                     "28" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1988  quran:ayah_text            "وَيَجۡعَلُونَ لِلَّهِ ٱلۡبَنَٰتِ سُبۡحَٰنَهُۥ وَلَهُم مَّا يَشۡتَهُونَ" ;
        quran:ayah_text_no_diacratic   "ويجعلون لله البنٰت سبحٰنه ولهم ما يشتهون" ;
        quran:ayahnumber               "57" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1988" ;
        quran:page                     "273" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:1798  quran:ayah_text            "وَقَالَ ٱلشَّيۡطَٰنُ لَمَّا قُضِيَ ٱلۡأَمۡرُ إِنَّ ٱللَّهَ وَعَدَكُمۡ وَعۡدَ ٱلۡحَقِّ وَوَعَدتُّكُمۡ فَأَخۡلَفۡتُكُمۡۖ وَمَا كَانَ لِيَ عَلَيۡكُم مِّن سُلۡطَٰنٍ إِلَّآ أَن دَعَوۡتُكُمۡ فَٱسۡتَجَبۡتُمۡ لِيۖ فَلَا تَلُومُونِي وَلُومُوٓاْ أَنفُسَكُمۖ مَّآ أَنَا۠ بِمُصۡرِخِكُمۡ وَمَآ أَنتُم بِمُصۡرِخِيَّ إِنِّي كَفَرۡتُ بِمَآ أَشۡرَكۡتُمُونِ مِن قَبۡلُۗ إِنَّ ٱلظَّٰلِمِينَ لَهُمۡ عَذَابٌ أَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "وقال الشيطٰن لما قضي الامر ان الله وعدكم وعد الحق ووعدتكم فاخلفتكم وما كان لي عليكم من سلطٰن الا ان دعوتكم فاستجبتم لي فلا تلوموني ولوموا انفسكم ما انا بمصرخكم وما انتم بمصرخي اني كفرت بما اشركتمون من قبل ان الظٰلمين لهم عذاب اليم" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1798" ;
        quran:page                     "258" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:2942  quran:ayah_text            "وَكُلّٗا ضَرَبۡنَا لَهُ ٱلۡأَمۡثَٰلَۖ وَكُلّٗا تَبَّرۡنَا تَتۡبِيرٗا" ;
        quran:ayah_text_no_diacratic   "وكلا ضربنا له الامثٰل وكلا تبرنا تتبيرا" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "19" ;
