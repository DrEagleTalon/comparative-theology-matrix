        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4608  quran:ayah_text            "أَمۡ يَقُولُونَ ٱفۡتَرَىٰهُۖ قُلۡ إِنِ ٱفۡتَرَيۡتُهُۥ فَلَا تَمۡلِكُونَ لِي مِنَ ٱللَّهِ شَيۡـًٔاۖ هُوَ أَعۡلَمُ بِمَا تُفِيضُونَ فِيهِۚ كَفَىٰ بِهِۦ شَهِيدَۢا بَيۡنِي وَبَيۡنَكُمۡۖ وَهُوَ ٱلۡغَفُورُ ٱلرَّحِيمُ" ;
        quran:ayah_text_no_diacratic   "ام يقولون افترىٰه قل ان افتريته فلا تملكون لي من الله شيا هو اعلم بما تفيضون فيه كفىٰ به شهيدا بيني وبينكم وهو الغفور الرحيم" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4608" ;
        quran:page                     "503" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2610  quran:ayah_text            "وَذَا ٱلنُّونِ إِذ ذَّهَبَ مُغَٰضِبٗا فَظَنَّ أَن لَّن نَّقۡدِرَ عَلَيۡهِ فَنَادَىٰ فِي ٱلظُّلُمَٰتِ أَن لَّآ إِلَٰهَ إِلَّآ أَنتَ سُبۡحَٰنَكَ إِنِّي كُنتُ مِنَ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "وذا النون اذ ذهب مغٰضبا فظن ان لن نقدر عليه فنادىٰ في الظلمٰت ان لا الٰه الا انت سبحٰنك اني كنت من الظٰلمين" ;
        quran:ayahnumber               "87" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2610" ;
        quran:page                     "329" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3514  quran:ayah_text            "وَلَقَدۡ أَرۡسَلۡنَا مِن قَبۡلِكَ رُسُلًا إِلَىٰ قَوۡمِهِمۡ فَجَآءُوهُم بِٱلۡبَيِّنَٰتِ فَٱنتَقَمۡنَا مِنَ ٱلَّذِينَ أَجۡرَمُواْۖ وَكَانَ حَقًّا عَلَيۡنَا نَصۡرُ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "ولقد ارسلنا من قبلك رسلا الىٰ قومهم فجاءوهم بالبينٰت فانتقمنا من الذين اجرموا وكان حقا علينا نصر المؤمنين" ;
        quran:ayahnumber               "47" ;
