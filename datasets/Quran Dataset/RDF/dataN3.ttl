        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:624  quran:ayah_text             "وَمَن يَعۡمَلۡ مِنَ ٱلصَّٰلِحَٰتِ مِن ذَكَرٍ أَوۡ أُنثَىٰ وَهُوَ مُؤۡمِنٞ فَأُوْلَٰٓئِكَ يَدۡخُلُونَ ٱلۡجَنَّةَ وَلَا يُظۡلَمُونَ نَقِيرٗا" ;
        quran:ayah_text_no_diacratic   "ومن يعمل من الصٰلحٰت من ذكر او انثىٰ وهو مؤمن فاولٰئك يدخلون الجنة ولا يظلمون نقيرا" ;
        quran:ayahnumber               "124" ;
        quran:chapter                  "5" ;
