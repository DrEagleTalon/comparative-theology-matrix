quran:613  quran:ayah_text             "وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكَ وَرَحۡمَتُهُۥ لَهَمَّت طَّآئِفَةٞ مِّنۡهُمۡ أَن يُضِلُّوكَ وَمَا يُضِلُّونَ إِلَّآ أَنفُسَهُمۡۖ وَمَا يَضُرُّونَكَ مِن شَيۡءٖۚ وَأَنزَلَ ٱللَّهُ عَلَيۡكَ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَعَلَّمَكَ مَا لَمۡ تَكُن تَعۡلَمُۚ وَكَانَ فَضۡلُ ٱللَّهِ عَلَيۡكَ عَظِيمٗا" ;
        quran:ayah_text_no_diacratic   "ولولا فضل الله عليك ورحمته لهمت طائفة منهم ان يضلوك وما يضلون الا انفسهم وما يضرونك من شيء وانزل الله عليك الكتٰب والحكمة وعلمك ما لم تكن تعلم وكان فضل الله عليك عظيما" ;
        quran:ayahnumber               "113" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "613" ;
        quran:page                     "96" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:423  quran:ayah_text             "بَلَىٰٓۚ إِن تَصۡبِرُواْ وَتَتَّقُواْ وَيَأۡتُوكُم مِّن فَوۡرِهِمۡ هَٰذَا يُمۡدِدۡكُمۡ رَبُّكُم بِخَمۡسَةِ ءَالَٰفٖ مِّنَ ٱلۡمَلَٰٓئِكَةِ مُسَوِّمِينَ" ;
        quran:ayah_text_no_diacratic   "بلىٰ ان تصبروا وتتقوا وياتوكم من فورهم هٰذا يمددكم ربكم بخمسة ءالٰف من الملٰئكة مسومين" ;
        quran:ayahnumber               "125" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "423" ;
