        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:372  quran:ayah_text             "يَخۡتَصُّ بِرَحۡمَتِهِۦ مَن يَشَآءُۗ وَٱللَّهُ ذُو ٱلۡفَضۡلِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "يختص برحمته من يشاء والله ذو الفضل العظيم" ;
