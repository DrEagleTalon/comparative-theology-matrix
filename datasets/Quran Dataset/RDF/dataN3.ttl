        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2888  quran:ayah_text            "إِنَّمَا كَانَ قَوۡلَ ٱلۡمُؤۡمِنِينَ إِذَا دُعُوٓاْ إِلَى ٱللَّهِ وَرَسُولِهِۦ لِيَحۡكُمَ بَيۡنَهُمۡ أَن يَقُولُواْ سَمِعۡنَا وَأَطَعۡنَاۚ وَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "انما كان قول المؤمنين اذا دعوا الى الله ورسوله ليحكم بينهم ان يقولوا سمعنا واطعنا واولٰئك هم المفلحون" ;
        quran:ayahnumber               "51" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2888" ;
        quran:page                     "356" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1794  quran:ayah_text            "مَّثَلُ ٱلَّذِينَ كَفَرُواْ بِرَبِّهِمۡۖ أَعۡمَٰلُهُمۡ كَرَمَادٍ ٱشۡتَدَّتۡ بِهِ ٱلرِّيحُ فِي يَوۡمٍ عَاصِفٖۖ لَّا يَقۡدِرُونَ مِمَّا كَسَبُواْ عَلَىٰ شَيۡءٖۚ ذَٰلِكَ هُوَ ٱلضَّلَٰلُ ٱلۡبَعِيدُ" ;
        quran:ayah_text_no_diacratic   "مثل الذين كفروا بربهم اعمٰلهم كرماد اشتدت به الريح في يوم عاصف لا يقدرون مما كسبوا علىٰ شيء ذٰلك هو الضلٰل البعيد" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1794" ;
        quran:page                     "257" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:4936  quran:ayah_text            "وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنَىٰ" ;
