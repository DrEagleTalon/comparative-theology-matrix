        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:1841  quran:ayah_text            "وَمَا يَأۡتِيهِم مِّن رَّسُولٍ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ" ;
        quran:ayah_text_no_diacratic   "وما ياتيهم من رسول الا كانوا به يستهزءون" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "14" ;
