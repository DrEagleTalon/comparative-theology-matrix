        quran:surahname                "سُورَةُ الحِجۡرِ" ;
        quran:surahnumber              "15" ;
        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:5594  quran:ayah_text            "وَأَنَّا ظَنَنَّآ أَن لَّن تَقُولَ ٱلۡإِنسُ وَٱلۡجِنُّ عَلَى ٱللَّهِ كَذِبٗا" ;
        quran:ayah_text_no_diacratic   "وانا ظننا ان لن تقول الانس والجن على الله كذبا" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5594" ;
        quran:page                     "572" ;
        quran:surahname                "سُورَةُ الجِنِّ" ;
        quran:surahnumber              "72" ;
        quran:surrahname_no_diacratic  "سورة الجن" .

quran:3907  quran:ayah_text            "لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ" ;
        quran:ayah_text_no_diacratic   "لا فيها غول ولا هم عنها ينزفون" ;
        quran:ayahnumber               "47" ;
