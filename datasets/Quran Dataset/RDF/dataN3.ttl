quran:1958  quran:ayah_text            "ثُمَّ يَوۡمَ ٱلۡقِيَٰمَةِ يُخۡزِيهِمۡ وَيَقُولُ أَيۡنَ شُرَكَآءِيَ ٱلَّذِينَ كُنتُمۡ تُشَٰٓقُّونَ فِيهِمۡۚ قَالَ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ إِنَّ ٱلۡخِزۡيَ ٱلۡيَوۡمَ وَٱلسُّوٓءَ عَلَى ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "ثم يوم القيٰمة يخزيهم ويقول اين شركاءي الذين كنتم تشٰقون فيهم قال الذين اوتوا العلم ان الخزي اليوم والسوء على الكٰفرين" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1958" ;
        quran:page                     "270" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:5693  quran:ayah_text            "بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ" ;
        quran:ayah_text_no_diacratic   "بل يريد كل امري منهم ان يؤتىٰ صحفا منشرة" ;
        quran:ayahnumber               "52" ;
