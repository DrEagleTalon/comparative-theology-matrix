quran:933  quran:ayah_text             "وَرَبُّكَ ٱلۡغَنِيُّ ذُو ٱلرَّحۡمَةِۚ إِن يَشَأۡ يُذۡهِبۡكُمۡ وَيَسۡتَخۡلِفۡ مِنۢ بَعۡدِكُم مَّا يَشَآءُ كَمَآ أَنشَأَكُم مِّن ذُرِّيَّةِ قَوۡمٍ ءَاخَرِينَ" ;
        quran:ayah_text_no_diacratic   "وربك الغني ذو الرحمة ان يشا يذهبكم ويستخلف من بعدكم ما يشاء كما انشاكم من ذرية قوم ءاخرين" ;
        quran:ayahnumber               "133" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "933" ;
        quran:page                     "145" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2129  quran:ayah_text            "أَفَأَمِنتُمۡ أَن يَخۡسِفَ بِكُمۡ جَانِبَ ٱلۡبَرِّ أَوۡ يُرۡسِلَ عَلَيۡكُمۡ حَاصِبٗا ثُمَّ لَا تَجِدُواْ لَكُمۡ وَكِيلًا" ;
        quran:ayah_text_no_diacratic   "افامنتم ان يخسف بكم جانب البر او يرسل عليكم حاصبا ثم لا تجدوا لكم وكيلا" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2129" ;
        quran:page                     "289" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1035  quran:ayah_text            "أُبَلِّغُكُمۡ رِسَٰلَٰتِ رَبِّي وَأَنَا۠ لَكُمۡ نَاصِحٌ أَمِينٌ" ;
        quran:ayah_text_no_diacratic   "ابلغكم رسٰلٰت ربي وانا لكم ناصح امين" ;
