        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1321  quran:ayah_text            "أَلَمۡ يَأۡتِهِمۡ نَبَأُ ٱلَّذِينَ مِن قَبۡلِهِمۡ قَوۡمِ نُوحٖ وَعَادٖ وَثَمُودَ وَقَوۡمِ إِبۡرَٰهِيمَ وَأَصۡحَٰبِ مَدۡيَنَ وَٱلۡمُؤۡتَفِكَٰتِۚ أَتَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِۖ فَمَا كَانَ ٱللَّهُ لِيَظۡلِمَهُمۡ وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "الم ياتهم نبا الذين من قبلهم قوم نوح وعاد وثمود وقوم ابرٰهيم واصحٰب مدين والمؤتفكٰت اتتهم رسلهم بالبينٰت فما كان الله ليظلمهم ولٰكن كانوا انفسهم يظلمون" ;
        quran:ayahnumber               "70" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1321" ;
        quran:page                     "198" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:789  quran:ayah_text             "وَإِذۡ أَوۡحَيۡتُ إِلَى ٱلۡحَوَارِيِّـۧنَ أَنۡ ءَامِنُواْ بِي وَبِرَسُولِي قَالُوٓاْ ءَامَنَّا وَٱشۡهَدۡ بِأَنَّنَا مُسۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "واذ اوحيت الى الحوارين ان ءامنوا بي وبرسولي قالوا ءامنا واشهد باننا مسلمون" ;
