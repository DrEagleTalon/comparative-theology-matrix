quran:2877  quran:ayah_text            "أَوۡ كَظُلُمَٰتٖ فِي بَحۡرٖ لُّجِّيّٖ يَغۡشَىٰهُ مَوۡجٞ مِّن فَوۡقِهِۦ مَوۡجٞ مِّن فَوۡقِهِۦ سَحَابٞۚ ظُلُمَٰتُۢ بَعۡضُهَا فَوۡقَ بَعۡضٍ إِذَآ أَخۡرَجَ يَدَهُۥ لَمۡ يَكَدۡ يَرَىٰهَاۗ وَمَن لَّمۡ يَجۡعَلِ ٱللَّهُ لَهُۥ نُورٗا فَمَا لَهُۥ مِن نُّورٍ" ;
        quran:ayah_text_no_diacratic   "او كظلمٰت في بحر لجي يغشىٰه موج من فوقه موج من فوقه سحاب ظلمٰت بعضها فوق بعض اذا اخرج يده لم يكد يرىٰها ومن لم يجعل الله له نورا فما له من نور" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2877" ;
        quran:page                     "355" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1783  quran:ayah_text            "وَإِذۡ تَأَذَّنَ رَبُّكُمۡ لَئِن شَكَرۡتُمۡ لَأَزِيدَنَّكُمۡۖ وَلَئِن كَفَرۡتُمۡ إِنَّ عَذَابِي لَشَدِيدٞ" ;
        quran:ayah_text_no_diacratic   "واذ تاذن ربكم لئن شكرتم لازيدنكم ولئن كفرتم ان عذابي لشديد" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1783" ;
        quran:page                     "256" ;
