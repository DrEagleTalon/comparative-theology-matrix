        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:3435  quran:ayah_text            "وَقَٰرُونَ وَفِرۡعَوۡنَ وَهَٰمَٰنَۖ وَلَقَدۡ جَآءَهُم مُّوسَىٰ بِٱلۡبَيِّنَٰتِ فَٱسۡتَكۡبَرُواْ فِي ٱلۡأَرۡضِ وَمَا كَانُواْ سَٰبِقِينَ" ;
        quran:ayah_text_no_diacratic   "وقٰرون وفرعون وهٰمٰن ولقد جاءهم موسىٰ بالبينٰت فاستكبروا في الارض وما كانوا سٰبقين" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3435" ;
        quran:page                     "401" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1197  quran:ayah_text            "۞إِنَّ شَرَّ ٱلدَّوَآبِّ عِندَ ٱللَّهِ ٱلصُّمُّ ٱلۡبُكۡمُ ٱلَّذِينَ لَا يَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "ان شر الدواب عند الله الصم البكم الذين لا يعقلون" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1197" ;
        quran:page                     "179" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:4339  quran:ayah_text            "إِنَّ ٱلَّذِينَ كَفَرُواْ بِٱلذِّكۡرِ لَمَّا جَآءَهُمۡۖ وَإِنَّهُۥ لَكِتَٰبٌ عَزِيزٞ" ;
        quran:ayah_text_no_diacratic   "ان الذين كفروا بالذكر لما جاءهم وانه لكتٰب عزيز" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "24" ;
        quran:hizb                     "48" ;
        quran:index                    "4339" ;
        quran:page                     "481" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2341  quran:ayah_text            "وَكَانَ يَأۡمُرُ أَهۡلَهُۥ بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ وَكَانَ عِندَ رَبِّهِۦ مَرۡضِيّٗا" ;
        quran:ayah_text_no_diacratic   "وكان يامر اهله بالصلوٰة والزكوٰة وكان عند ربه مرضيا" ;
        quran:ayahnumber               "55" ;
