        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:473  quran:ayah_text             "إِنَّمَا ذَٰلِكُمُ ٱلشَّيۡطَٰنُ يُخَوِّفُ أَوۡلِيَآءَهُۥ فَلَا تَخَافُوهُمۡ وَخَافُونِ إِن كُنتُم مُّؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "انما ذٰلكم الشيطٰن يخوف اولياءه فلا تخافوهم وخافون ان كنتم مؤمنين" ;
        quran:ayahnumber               "175" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "473" ;
        quran:page                     "73" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:283  quran:ayah_text             "لِلۡفُقَرَآءِ ٱلَّذِينَ أُحۡصِرُواْ فِي سَبِيلِ ٱللَّهِ لَا يَسۡتَطِيعُونَ ضَرۡبٗا فِي ٱلۡأَرۡضِ يَحۡسَبُهُمُ ٱلۡجَاهِلُ أَغۡنِيَآءَ مِنَ ٱلتَّعَفُّفِ تَعۡرِفُهُم بِسِيمَٰهُمۡ لَا يَسۡـَٔلُونَ ٱلنَّاسَ إِلۡحَافٗاۗ وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "للفقراء الذين احصروا في سبيل الله لا يستطيعون ضربا في الارض يحسبهم الجاهل اغنياء من التعفف تعرفهم بسيمٰهم لا يسلون الناس الحافا وما تنفقوا من خير فان الله به عليم" ;
        quran:ayahnumber               "273" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "283" ;
        quran:page                     "46" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1887  quran:ayah_text            "قَالَ فَمَا خَطۡبُكُمۡ أَيُّهَا ٱلۡمُرۡسَلُونَ" ;
