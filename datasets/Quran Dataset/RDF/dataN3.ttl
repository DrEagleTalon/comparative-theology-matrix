        quran:index                    "2514" ;
        quran:page                     "321" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:3418  quran:ayah_text            "وَمَآ أَنتُم بِمُعۡجِزِينَ فِي ٱلۡأَرۡضِ وَلَا فِي ٱلسَّمَآءِۖ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِيّٖ وَلَا نَصِيرٖ" ;
        quran:ayah_text_no_diacratic   "وما انتم بمعجزين في الارض ولا في السماء وما لكم من دون الله من ولي ولا نصير" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3418" ;
        quran:page                     "398" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1420  quran:ayah_text            "أَمۡ يَقُولُونَ ٱفۡتَرَىٰهُۖ قُلۡ فَأۡتُواْ بِسُورَةٖ مِّثۡلِهِۦ وَٱدۡعُواْ مَنِ ٱسۡتَطَعۡتُم مِّن دُونِ ٱللَّهِ إِن كُنتُمۡ صَٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "ام يقولون افترىٰه قل فاتوا بسورة مثله وادعوا من استطعتم من دون الله ان كنتم صٰدقين" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1420" ;
        quran:page                     "213" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:888  quran:ayah_text             "ذَٰلِكَ هُدَى ٱللَّهِ يَهۡدِي بِهِۦ مَن يَشَآءُ مِنۡ عِبَادِهِۦۚ وَلَوۡ أَشۡرَكُواْ لَحَبِطَ عَنۡهُم مَّا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ذٰلك هدى الله يهدي به من يشاء من عباده ولو اشركوا لحبط عنهم ما كانوا يعملون" ;
        quran:ayahnumber               "88" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "888" ;
        quran:page                     "138" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2324  quran:ayah_text            "أَسۡمِعۡ بِهِمۡ وَأَبۡصِرۡ يَوۡمَ يَأۡتُونَنَا لَٰكِنِ ٱلظَّٰلِمُونَ ٱلۡيَوۡمَ فِي ضَلَٰلٖ مُّبِينٖ" ;
        quran:ayah_text_no_diacratic   "اسمع بهم وابصر يوم ياتوننا لٰكن الظٰلمون اليوم في ضلٰل مبين" ;
        quran:ayahnumber               "38" ;
