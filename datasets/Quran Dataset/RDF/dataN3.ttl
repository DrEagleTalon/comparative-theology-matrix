        quran:index                    "33" ;
        quran:page                     "4" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:3973  quran:ayah_text            "وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ" ;
        quran:ayah_text_no_diacratic   "وبٰركنا عليه وعلىٰ اسحٰق ومن ذريتهما محسن وظالم لنفسه مبين" ;
