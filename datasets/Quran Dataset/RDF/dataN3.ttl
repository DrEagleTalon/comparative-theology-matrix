quran:72  quran:ayah_text              "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَٱلَّذِينَ هَادُواْ وَٱلنَّصَٰرَىٰ وَٱلصَّٰبِـِٔينَ مَنۡ ءَامَنَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَعَمِلَ صَٰلِحٗا فَلَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ" ;
        quran:ayah_text_no_diacratic   "ان الذين ءامنوا والذين هادوا والنصٰرىٰ والصٰبين من ءامن بالله واليوم الاخر وعمل صٰلحا فلهم اجرهم عند ربهم ولا خوف عليهم ولا هم يحزنون" ;
        quran:ayahnumber               "62" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "72" ;
        quran:page                     "10" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1203  quran:ayah_text            "وَٱعۡلَمُوٓاْ أَنَّمَآ أَمۡوَٰلُكُمۡ وَأَوۡلَٰدُكُمۡ فِتۡنَةٞ وَأَنَّ ٱللَّهَ عِندَهُۥٓ أَجۡرٌ عَظِيمٞ" ;
        quran:ayah_text_no_diacratic   "واعلموا انما اموٰلكم واولٰدكم فتنة وان الله عنده اجر عظيم" ;
