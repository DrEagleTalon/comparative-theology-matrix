        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:4202  quran:ayah_text            "وَنُفِخَ فِي ٱلصُّورِ فَصَعِقَ مَن فِي ٱلسَّمَٰوَٰتِ وَمَن فِي ٱلۡأَرۡضِ إِلَّا مَن شَآءَ ٱللَّهُۖ ثُمَّ نُفِخَ فِيهِ أُخۡرَىٰ فَإِذَا هُمۡ قِيَامٞ يَنظُرُونَ" ;
        quran:ayah_text_no_diacratic   "ونفخ في الصور فصعق من في السمٰوٰت ومن في الارض الا من شاء الله ثم نفخ فيه اخرىٰ فاذا هم قيام ينظرون" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "24" ;
        quran:hizb                     "46" ;
        quran:index                    "4202" ;
