quran:1674  quran:ayah_text            "وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِي ٱلۡأَرۡضِ يَتَبَوَّأُ مِنۡهَا حَيۡثُ يَشَآءُۚ نُصِيبُ بِرَحۡمَتِنَا مَن نَّشَآءُۖ وَلَا نُضِيعُ أَجۡرَ ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك مكنا ليوسف في الارض يتبوا منها حيث يشاء نصيب برحمتنا من نشاء ولا نضيع اجر المحسنين" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1674" ;
        quran:page                     "242" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:4816  quran:ayah_text            "وَفِي عَادٍ إِذۡ أَرۡسَلۡنَا عَلَيۡهِمُ ٱلرِّيحَ ٱلۡعَقِيمَ" ;
        quran:ayah_text_no_diacratic   "وفي عاد اذ ارسلنا عليهم الريح العقيم" ;
