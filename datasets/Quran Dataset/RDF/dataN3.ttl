quran:190  quran:ayah_text             "كُتِبَ عَلَيۡكُمۡ إِذَا حَضَرَ أَحَدَكُمُ ٱلۡمَوۡتُ إِن تَرَكَ خَيۡرًا ٱلۡوَصِيَّةُ لِلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَ بِٱلۡمَعۡرُوفِۖ حَقًّا عَلَى ٱلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "كتب عليكم اذا حضر احدكم الموت ان ترك خيرا الوصية للوٰلدين والاقربين بالمعروف حقا على المتقين" ;
        quran:ayahnumber               "180" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "190" ;
        quran:page                     "27" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1984  quran:ayah_text            "وَمَا بِكُم مِّن نِّعۡمَةٖ فَمِنَ ٱللَّهِۖ ثُمَّ إِذَا مَسَّكُمُ ٱلضُّرُّ فَإِلَيۡهِ تَجۡـَٔرُونَ" ;
        quran:ayah_text_no_diacratic   "وما بكم من نعمة فمن الله ثم اذا مسكم الضر فاليه تجرون" ;
        quran:ayahnumber               "53" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1984" ;
