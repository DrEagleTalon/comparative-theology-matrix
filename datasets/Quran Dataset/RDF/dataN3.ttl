        quran:hizb                     "30" ;
        quran:index                    "2236" ;
        quran:page                     "301" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1142  quran:ayah_text            "وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ ٱلَّذِيٓ ءَاتَيۡنَٰهُ ءَايَٰتِنَا فَٱنسَلَخَ مِنۡهَا فَأَتۡبَعَهُ ٱلشَّيۡطَٰنُ فَكَانَ مِنَ ٱلۡغَاوِينَ" ;
        quran:ayah_text_no_diacratic   "واتل عليهم نبا الذي ءاتينٰه ءايٰتنا فانسلخ منها فاتبعه الشيطٰن فكان من الغاوين" ;
        quran:ayahnumber               "175" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1142" ;
        quran:page                     "173" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:850  quran:ayah_text             "قُل لَّآ أَقُولُ لَكُمۡ عِندِي خَزَآئِنُ ٱللَّهِ وَلَآ أَعۡلَمُ ٱلۡغَيۡبَ وَلَآ أَقُولُ لَكُمۡ إِنِّي مَلَكٌۖ إِنۡ أَتَّبِعُ إِلَّا مَا يُوحَىٰٓ إِلَيَّۚ قُلۡ هَلۡ يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُۚ أَفَلَا تَتَفَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "قل لا اقول لكم عندي خزائن الله ولا اعلم الغيب ولا اقول لكم اني ملك ان اتبع الا ما يوحىٰ الي قل هل يستوي الاعمىٰ والبصير افلا تتفكرون" ;
        quran:ayahnumber               "50" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "850" ;
        quran:page                     "133" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2046  quran:ayah_text            "إِنَّمَا حَرَّمَ عَلَيۡكُمُ ٱلۡمَيۡتَةَ وَٱلدَّمَ وَلَحۡمَ ٱلۡخِنزِيرِ وَمَآ أُهِلَّ لِغَيۡرِ ٱللَّهِ بِهِۦۖ فَمَنِ ٱضۡطُرَّ غَيۡرَ بَاغٖ وَلَا عَادٖ فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "انما حرم عليكم الميتة والدم ولحم الخنزير وما اهل لغير الله به فمن اضطر غير باغ ولا عاد فان الله غفور رحيم" ;
        quran:ayahnumber               "115" ;
        quran:chapter                  "14" ;
        quran:hizb                     "28" ;
        quran:index                    "2046" ;
        quran:page                     "280" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:660  quran:ayah_text             "فَبِظُلۡمٖ مِّنَ ٱلَّذِينَ هَادُواْ حَرَّمۡنَا عَلَيۡهِمۡ طَيِّبَٰتٍ أُحِلَّتۡ لَهُمۡ وَبِصَدِّهِمۡ عَن سَبِيلِ ٱللَّهِ كَثِيرٗا" ;
        quran:ayah_text_no_diacratic   "فبظلم من الذين هادوا حرمنا عليهم طيبٰت احلت لهم وبصدهم عن سبيل الله كثيرا" ;
        quran:ayahnumber               "160" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "660" ;
        quran:page                     "103" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:3000  quran:ayah_text            "قَالَ أَلَمۡ نُرَبِّكَ فِينَا وَلِيدٗا وَلَبِثۡتَ فِينَا مِنۡ عُمُرِكَ سِنِينَ" ;
        quran:ayah_text_no_diacratic   "قال الم نربك فينا وليدا ولبثت فينا من عمرك سنين" ;
        quran:ayahnumber               "18" ;
