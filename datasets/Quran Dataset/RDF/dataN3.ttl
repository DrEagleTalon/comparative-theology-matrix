        quran:surrahname_no_diacratic  "سورة هود" .

quran:5244  quran:ayah_text            "هُوَ ٱلَّذِيٓ أَخۡرَجَ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ مِن دِيَٰرِهِمۡ لِأَوَّلِ ٱلۡحَشۡرِۚ مَا ظَنَنتُمۡ أَن يَخۡرُجُواْۖ وَظَنُّوٓاْ أَنَّهُم مَّانِعَتُهُمۡ حُصُونُهُم مِّنَ ٱللَّهِ فَأَتَىٰهُمُ ٱللَّهُ مِنۡ حَيۡثُ لَمۡ يَحۡتَسِبُواْۖ وَقَذَفَ فِي قُلُوبِهِمُ ٱلرُّعۡبَۚ يُخۡرِبُونَ بُيُوتَهُم بِأَيۡدِيهِمۡ وَأَيۡدِي ٱلۡمُؤۡمِنِينَ فَٱعۡتَبِرُواْ يَٰٓأُوْلِي ٱلۡأَبۡصَٰرِ" ;
        quran:ayah_text_no_diacratic   "هو الذي اخرج الذين كفروا من اهل الكتٰب من ديٰرهم لاول الحشر ما ظننتم ان يخرجوا وظنوا انهم مانعتهم حصونهم من الله فاتىٰهم الله من حيث لم يحتسبوا وقذف في قلوبهم الرعب يخربون بيوتهم بايديهم وايدي المؤمنين فاعتبروا يٰاولي الابصٰر" ;
        quran:ayahnumber               "2" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5244" ;
        quran:page                     "545" ;
        quran:surahname                "سُورَةُ الحَشۡرِ" ;
        quran:surahnumber              "59" ;
        quran:surrahname_no_diacratic  "سورة الحشر" .

