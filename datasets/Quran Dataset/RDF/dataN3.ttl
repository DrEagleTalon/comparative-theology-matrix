        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2856  quran:ayah_text            "إِنَّ ٱلَّذِينَ يُحِبُّونَ أَن تَشِيعَ ٱلۡفَٰحِشَةُ فِي ٱلَّذِينَ ءَامَنُواْ لَهُمۡ عَذَابٌ أَلِيمٞ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۚ وَٱللَّهُ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ان الذين يحبون ان تشيع الفٰحشة في الذين ءامنوا لهم عذاب اليم في الدنيا والاخرة والله يعلم وانتم لا تعلمون" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2856" ;
        quran:page                     "351" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1762  quran:ayah_text            "وَلَوۡ أَنَّ قُرۡءَانٗا سُيِّرَتۡ بِهِ ٱلۡجِبَالُ أَوۡ قُطِّعَتۡ بِهِ ٱلۡأَرۡضُ أَوۡ كُلِّمَ بِهِ ٱلۡمَوۡتَىٰۗ بَل لِّلَّهِ ٱلۡأَمۡرُ جَمِيعًاۗ أَفَلَمۡ يَاْيۡـَٔسِ ٱلَّذِينَ ءَامَنُوٓاْ أَن لَّوۡ يَشَآءُ ٱللَّهُ لَهَدَى ٱلنَّاسَ جَمِيعٗاۗ وَلَا يَزَالُ ٱلَّذِينَ كَفَرُواْ تُصِيبُهُم بِمَا صَنَعُواْ قَارِعَةٌ أَوۡ تَحُلُّ قَرِيبٗا مِّن دَارِهِمۡ حَتَّىٰ يَأۡتِيَ وَعۡدُ ٱللَّهِۚ إِنَّ ٱللَّهَ لَا يُخۡلِفُ ٱلۡمِيعَادَ" ;
        quran:ayah_text_no_diacratic   "ولو ان قرءانا سيرت به الجبال او قطعت به الارض او كلم به الموتىٰ بل لله الامر جميعا افلم يايس الذين ءامنوا ان لو يشاء الله لهدى الناس جميعا ولا يزال الذين كفروا تصيبهم بما صنعوا قارعة او تحل قريبا من دارهم حتىٰ ياتي وعد الله ان الله لا يخلف الميعاد" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1762" ;
        quran:page                     "253" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

