        quran:hizb                     "35" ;
        quran:index                    "2844" ;
        quran:page                     "350" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1750  quran:ayah_text            "۞أَفَمَن يَعۡلَمُ أَنَّمَآ أُنزِلَ إِلَيۡكَ مِن رَّبِّكَ ٱلۡحَقُّ كَمَنۡ هُوَ أَعۡمَىٰٓۚ إِنَّمَا يَتَذَكَّرُ أُوْلُواْ ٱلۡأَلۡبَٰبِ" ;
        quran:ayah_text_no_diacratic   "افمن يعلم انما انزل اليك من ربك الحق كمن هو اعمىٰ انما يتذكر اولوا الالبٰب" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1750" ;
