quran:93  quran:ayah_text              "وَإِذۡ أَخَذۡنَا مِيثَٰقَ بَنِيٓ إِسۡرَٰٓءِيلَ لَا تَعۡبُدُونَ إِلَّا ٱللَّهَ وَبِٱلۡوَٰلِدَيۡنِ إِحۡسَانٗا وَذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَقُولُواْ لِلنَّاسِ حُسۡنٗا وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ ثُمَّ تَوَلَّيۡتُمۡ إِلَّا قَلِيلٗا مِّنكُمۡ وَأَنتُم مُّعۡرِضُونَ" ;
        quran:ayah_text_no_diacratic   "واذ اخذنا ميثٰق بني اسرٰءيل لا تعبدون الا الله وبالوٰلدين احسانا وذي القربىٰ واليتٰمىٰ والمسٰكين وقولوا للناس حسنا واقيموا الصلوٰة وءاتوا الزكوٰة ثم توليتم الا قليلا منكم وانتم معرضون" ;
        quran:ayahnumber               "83" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "93" ;
        quran:page                     "12" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1224  quran:ayah_text            "إِذۡ يَقُولُ ٱلۡمُنَٰفِقُونَ وَٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٌ غَرَّ هَٰٓؤُلَآءِ دِينُهُمۡۗ وَمَن يَتَوَكَّلۡ عَلَى ٱللَّهِ فَإِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "اذ يقول المنٰفقون والذين في قلوبهم مرض غر هٰؤلاء دينهم ومن يتوكل على الله فان الله عزيز حكيم" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1224" ;
        quran:page                     "183" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:932  quran:ayah_text             "وَلِكُلّٖ دَرَجَٰتٞ مِّمَّا عَمِلُواْۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ولكل درجٰت مما عملوا وما ربك بغٰفل عما يعملون" ;
