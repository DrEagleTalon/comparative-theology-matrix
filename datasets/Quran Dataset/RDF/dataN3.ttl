        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1074  quran:ayah_text            "فَأَلۡقَىٰ عَصَاهُ فَإِذَا هِيَ ثُعۡبَانٞ مُّبِينٞ" ;
        quran:ayah_text_no_diacratic   "فالقىٰ عصاه فاذا هي ثعبان مبين" ;
