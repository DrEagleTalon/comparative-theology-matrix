        quran:surrahname_no_diacratic  "سورة النحل" .

quran:662  quran:ayah_text             "لَّٰكِنِ ٱلرَّٰسِخُونَ فِي ٱلۡعِلۡمِ مِنۡهُمۡ وَٱلۡمُؤۡمِنُونَ يُؤۡمِنُونَ بِمَآ أُنزِلَ إِلَيۡكَ وَمَآ أُنزِلَ مِن قَبۡلِكَۚ وَٱلۡمُقِيمِينَ ٱلصَّلَوٰةَۚ وَٱلۡمُؤۡتُونَ ٱلزَّكَوٰةَ وَٱلۡمُؤۡمِنُونَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ أُوْلَٰٓئِكَ سَنُؤۡتِيهِمۡ أَجۡرًا عَظِيمًا" ;
        quran:ayah_text_no_diacratic   "لٰكن الرٰسخون في العلم منهم والمؤمنون يؤمنون بما انزل اليك وما انزل من قبلك والمقيمين الصلوٰة والمؤتون الزكوٰة والمؤمنون بالله واليوم الاخر اولٰئك سنؤتيهم اجرا عظيما" ;
        quran:ayahnumber               "162" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "662" ;
        quran:page                     "103" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:3002  quran:ayah_text            "قَالَ فَعَلۡتُهَآ إِذٗا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ" ;
