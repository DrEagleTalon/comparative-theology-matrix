quran:2192  quran:ayah_text            "وَتَحۡسَبُهُمۡ أَيۡقَاظٗا وَهُمۡ رُقُودٞۚ وَنُقَلِّبُهُمۡ ذَاتَ ٱلۡيَمِينِ وَذَاتَ ٱلشِّمَالِۖ وَكَلۡبُهُم بَٰسِطٞ ذِرَاعَيۡهِ بِٱلۡوَصِيدِۚ لَوِ ٱطَّلَعۡتَ عَلَيۡهِمۡ لَوَلَّيۡتَ مِنۡهُمۡ فِرَارٗا وَلَمُلِئۡتَ مِنۡهُمۡ رُعۡبٗا" ;
        quran:ayah_text_no_diacratic   "وتحسبهم ايقاظا وهم رقود ونقلبهم ذات اليمين وذات الشمال وكلبهم بٰسط ذراعيه بالوصيد لو اطلعت عليهم لوليت منهم فرارا ولملئت منهم رعبا" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2192" ;
        quran:page                     "295" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:5334  quran:ayah_text            "يَوۡمَ يَجۡمَعُكُمۡ لِيَوۡمِ ٱلۡجَمۡعِۖ ذَٰلِكَ يَوۡمُ ٱلتَّغَابُنِۗ وَمَن يُؤۡمِنۢ بِٱللَّهِ وَيَعۡمَلۡ صَٰلِحٗا يُكَفِّرۡ عَنۡهُ سَيِّـَٔاتِهِۦ وَيُدۡخِلۡهُ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ" ;
        quran:ayah_text_no_diacratic   "يوم يجمعكم ليوم الجمع ذٰلك يوم التغابن ومن يؤمن بالله ويعمل صٰلحا يكفر عنه سياته ويدخله جنٰت تجري من تحتها الانهٰر خٰلدين فيها ابدا ذٰلك الفوز العظيم" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5334" ;
        quran:page                     "556" ;
        quran:surahname                "سُورَةُ التَّغَابُنِ" ;
        quran:surahnumber              "64" ;
        quran:surrahname_no_diacratic  "سورة التغابن" .

quran:3096  quran:ayah_text            "وَمَآ أَنَا۠ بِطَارِدِ ٱلۡمُؤۡمِنِينَ" ;
