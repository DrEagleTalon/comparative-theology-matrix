        quran:surrahname_no_diacratic  "سورة النمل" .

quran:696  quran:ayah_text             "وَقَالَتِ ٱلۡيَهُودُ وَٱلنَّصَٰرَىٰ نَحۡنُ أَبۡنَٰٓؤُاْ ٱللَّهِ وَأَحِبَّٰٓؤُهُۥۚ قُلۡ فَلِمَ يُعَذِّبُكُم بِذُنُوبِكُمۖ بَلۡ أَنتُم بَشَرٞ مِّمَّنۡ خَلَقَۚ يَغۡفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۚ وَلِلَّهِ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَاۖ وَإِلَيۡهِ ٱلۡمَصِيرُ" ;
        quran:ayah_text_no_diacratic   "وقالت اليهود والنصٰرىٰ نحن ابنٰؤا الله واحبٰؤه قل فلم يعذبكم بذنوبكم بل انتم بشر ممن خلق يغفر لمن يشاء ويعذب من يشاء ولله ملك السمٰوٰت والارض وما بينهما واليه المصير" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "696" ;
        quran:page                     "111" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2132  quran:ayah_text            "يَوۡمَ نَدۡعُواْ كُلَّ أُنَاسِۭ بِإِمَٰمِهِمۡۖ فَمَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَأُوْلَٰٓئِكَ يَقۡرَءُونَ كِتَٰبَهُمۡ وَلَا يُظۡلَمُونَ فَتِيلٗا" ;
        quran:ayah_text_no_diacratic   "يوم ندعوا كل اناس بامٰمهم فمن اوتي كتٰبه بيمينه فاولٰئك يقرءون كتٰبهم ولا يظلمون فتيلا" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "15" ;
