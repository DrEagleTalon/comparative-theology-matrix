        quran:hizb                     "15" ;
        quran:index                    "955" ;
        quran:page                     "149" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1057  quran:ayah_text            "وَقَالَ ٱلۡمَلَأُ ٱلَّذِينَ كَفَرُواْ مِن قَوۡمِهِۦ لَئِنِ ٱتَّبَعۡتُمۡ شُعَيۡبًا إِنَّكُمۡ إِذٗا لَّخَٰسِرُونَ" ;
        quran:ayah_text_no_diacratic   "وقال الملا الذين كفروا من قومه لئن اتبعتم شعيبا انكم اذا لخٰسرون" ;
        quran:ayahnumber               "90" ;
