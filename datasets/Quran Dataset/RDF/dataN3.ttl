quran:3506  quran:ayah_text            "وَمَآ ءَاتَيۡتُم مِّن رِّبٗا لِّيَرۡبُوَاْ فِيٓ أَمۡوَٰلِ ٱلنَّاسِ فَلَا يَرۡبُواْ عِندَ ٱللَّهِۖ وَمَآ ءَاتَيۡتُم مِّن زَكَوٰةٖ تُرِيدُونَ وَجۡهَ ٱللَّهِ فَأُوْلَٰٓئِكَ هُمُ ٱلۡمُضۡعِفُونَ" ;
        quran:ayah_text_no_diacratic   "وما ءاتيتم من ربا ليربوا في اموٰل الناس فلا يربوا عند الله وما ءاتيتم من زكوٰة تريدون وجه الله فاولٰئك هم المضعفون" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3506" ;
        quran:page                     "408" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1268  quran:ayah_text            "مَا كَانَ لِلۡمُشۡرِكِينَ أَن يَعۡمُرُواْ مَسَٰجِدَ ٱللَّهِ شَٰهِدِينَ عَلَىٰٓ أَنفُسِهِم بِٱلۡكُفۡرِۚ أُوْلَٰٓئِكَ حَبِطَتۡ أَعۡمَٰلُهُمۡ وَفِي ٱلنَّارِ هُمۡ خَٰلِدُونَ" ;
        quran:ayah_text_no_diacratic   "ما كان للمشركين ان يعمروا مسٰجد الله شٰهدين علىٰ انفسهم بالكفر اولٰئك حبطت اعمٰلهم وفي النار هم خٰلدون" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "10" ;
