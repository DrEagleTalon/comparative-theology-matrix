        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:4694  quran:ayah_text            "لَّيۡسَ عَلَى ٱلۡأَعۡمَىٰ حَرَجٞ وَلَا عَلَى ٱلۡأَعۡرَجِ حَرَجٞ وَلَا عَلَى ٱلۡمَرِيضِ حَرَجٞۗ وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ يُدۡخِلۡهُ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ وَمَن يَتَوَلَّ يُعَذِّبۡهُ عَذَابًا أَلِيمٗا" ;
        quran:ayah_text_no_diacratic   "ليس على الاعمىٰ حرج ولا على الاعرج حرج ولا على المريض حرج ومن يطع الله ورسوله يدخله جنٰت تجري من تحتها الانهٰر ومن يتول يعذبه عذابا اليما" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4694" ;
        quran:page                     "513" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:5598  quran:ayah_text            "وَأَنَّا كُنَّا نَقۡعُدُ مِنۡهَا مَقَٰعِدَ لِلسَّمۡعِۖ فَمَن يَسۡتَمِعِ ٱلۡأٓنَ يَجِدۡ لَهُۥ شِهَابٗا رَّصَدٗا" ;
        quran:ayah_text_no_diacratic   "وانا كنا نقعد منها مقٰعد للسمع فمن يستمع الان يجد له شهابا رصدا" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5598" ;
        quran:page                     "572" ;
        quran:surahname                "سُورَةُ الجِنِّ" ;
        quran:surahnumber              "72" ;
        quran:surrahname_no_diacratic  "سورة الجن" .

quran:1913  quran:ayah_text            "فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ مُصۡبِحِينَ" ;
