        quran:surrahname_no_diacratic  "سورة هود" .

quran:4704  quran:ayah_text            "لَّقَدۡ صَدَقَ ٱللَّهُ رَسُولَهُ ٱلرُّءۡيَا بِٱلۡحَقِّۖ لَتَدۡخُلُنَّ ٱلۡمَسۡجِدَ ٱلۡحَرَامَ إِن شَآءَ ٱللَّهُ ءَامِنِينَ مُحَلِّقِينَ رُءُوسَكُمۡ وَمُقَصِّرِينَ لَا تَخَافُونَۖ فَعَلِمَ مَا لَمۡ تَعۡلَمُواْ فَجَعَلَ مِن دُونِ ذَٰلِكَ فَتۡحٗا قَرِيبًا" ;
        quran:ayah_text_no_diacratic   "لقد صدق الله رسوله الرءيا بالحق لتدخلن المسجد الحرام ان شاء الله ءامنين محلقين رءوسكم ومقصرين لا تخافون فعلم ما لم تعلموا فجعل من دون ذٰلك فتحا قريبا" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4704" ;
        quran:page                     "514" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:2466  quran:ayah_text            "يَٰبَنِيٓ إِسۡرَٰٓءِيلَ قَدۡ أَنجَيۡنَٰكُم مِّنۡ عَدُوِّكُمۡ وَوَٰعَدۡنَٰكُمۡ جَانِبَ ٱلطُّورِ ٱلۡأَيۡمَنَ وَنَزَّلۡنَا عَلَيۡكُمُ ٱلۡمَنَّ وَٱلسَّلۡوَىٰ" ;
        quran:ayah_text_no_diacratic   "يٰبني اسرٰءيل قد انجينٰكم من عدوكم ووٰعدنٰكم جانب الطور الايمن ونزلنا عليكم المن والسلوىٰ" ;
        quran:ayahnumber               "80" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2466" ;
        quran:page                     "317" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:5608  quran:ayah_text            "وَأَنَّهُۥ لَمَّا قَامَ عَبۡدُ ٱللَّهِ يَدۡعُوهُ كَادُواْ يَكُونُونَ عَلَيۡهِ لِبَدٗا" ;
        quran:ayah_text_no_diacratic   "وانه لما قام عبد الله يدعوه كادوا يكونون عليه لبدا" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5608" ;
        quran:page                     "573" ;
        quran:surahname                "سُورَةُ الجِنِّ" ;
        quran:surahnumber              "72" ;
        quran:surrahname_no_diacratic  "سورة الجن" .

quran:3610  quran:ayah_text            "وَإِذۡ قَالَت طَّآئِفَةٞ مِّنۡهُمۡ يَٰٓأَهۡلَ يَثۡرِبَ لَا مُقَامَ لَكُمۡ فَٱرۡجِعُواْۚ وَيَسۡتَـٔۡذِنُ فَرِيقٞ مِّنۡهُمُ ٱلنَّبِيَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوۡرَةٞ وَمَا هِيَ بِعَوۡرَةٍۖ إِن يُرِيدُونَ إِلَّا فِرَارٗا" ;
        quran:ayah_text_no_diacratic   "واذ قالت طائفة منهم يٰاهل يثرب لا مقام لكم فارجعوا ويستذن فريق منهم النبي يقولون ان بيوتنا عورة وما هي بعورة ان يريدون الا فرارا" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3610" ;
        quran:page                     "419" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1372  quran:ayah_text            "وَلَا يُنفِقُونَ نَفَقَةٗ صَغِيرَةٗ وَلَا كَبِيرَةٗ وَلَا يَقۡطَعُونَ وَادِيًا إِلَّا كُتِبَ لَهُمۡ لِيَجۡزِيَهُمُ ٱللَّهُ أَحۡسَنَ مَا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ولا ينفقون نفقة صغيرة ولا كبيرة ولا يقطعون واديا الا كتب لهم ليجزيهم الله احسن ما كانوا يعملون" ;
        quran:ayahnumber               "121" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1372" ;
        quran:page                     "206" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4514  quran:ayah_text            "ثُمَّ تَوَلَّوۡاْ عَنۡهُ وَقَالُواْ مُعَلَّمٞ مَّجۡنُونٌ" ;
        quran:ayah_text_no_diacratic   "ثم تولوا عنه وقالوا معلم مجنون" ;
