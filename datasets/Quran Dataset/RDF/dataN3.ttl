quran:1639  quran:ayah_text            "وَقَالَ ٱلَّذِي ٱشۡتَرَىٰهُ مِن مِّصۡرَ لِٱمۡرَأَتِهِۦٓ أَكۡرِمِي مَثۡوَىٰهُ عَسَىٰٓ أَن يَنفَعَنَآ أَوۡ نَتَّخِذَهُۥ وَلَدٗاۚ وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِي ٱلۡأَرۡضِ وَلِنُعَلِّمَهُۥ مِن تَأۡوِيلِ ٱلۡأَحَادِيثِۚ وَٱللَّهُ غَالِبٌ عَلَىٰٓ أَمۡرِهِۦ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وقال الذي اشترىٰه من مصر لامراته اكرمي مثوىٰه عسىٰ ان ينفعنا او نتخذه ولدا وكذٰلك مكنا ليوسف في الارض ولنعلمه من تاويل الاحاديث والله غالب علىٰ امره ولٰكن اكثر الناس لا يعلمون" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1639" ;
        quran:page                     "237" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5374  quran:ayah_text            "تَبَٰرَكَ ٱلَّذِي بِيَدِهِ ٱلۡمُلۡكُ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ" ;
