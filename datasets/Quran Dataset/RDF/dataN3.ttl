        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:904  quran:ayah_text             "قَدۡ جَآءَكُم بَصَآئِرُ مِن رَّبِّكُمۡۖ فَمَنۡ أَبۡصَرَ فَلِنَفۡسِهِۦۖ وَمَنۡ عَمِيَ فَعَلَيۡهَاۚ وَمَآ أَنَا۠ عَلَيۡكُم بِحَفِيظٖ" ;
        quran:ayah_text_no_diacratic   "قد جاءكم بصائر من ربكم فمن ابصر فلنفسه ومن عمي فعليها وما انا عليكم بحفيظ" ;
        quran:ayahnumber               "104" ;
        quran:chapter                  "7" ;
        quran:hizb                     "14" ;
        quran:index                    "904" ;
        quran:page                     "141" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1006  quran:ayah_text            "وَقَالَتۡ أُولَىٰهُمۡ لِأُخۡرَىٰهُمۡ فَمَا كَانَ لَكُمۡ عَلَيۡنَا مِن فَضۡلٖ فَذُوقُواْ ٱلۡعَذَابَ بِمَا كُنتُمۡ تَكۡسِبُونَ" ;
        quran:ayah_text_no_diacratic   "وقالت اولىٰهم لاخرىٰهم فما كان لكم علينا من فضل فذوقوا العذاب بما كنتم تكسبون" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1006" ;
        quran:page                     "155" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:714  quran:ayah_text             "إِنَّ ٱلَّذِينَ كَفَرُواْ لَوۡ أَنَّ لَهُم مَّا فِي ٱلۡأَرۡضِ جَمِيعٗا وَمِثۡلَهُۥ مَعَهُۥ لِيَفۡتَدُواْ بِهِۦ مِنۡ عَذَابِ يَوۡمِ ٱلۡقِيَٰمَةِ مَا تُقُبِّلَ مِنۡهُمۡۖ وَلَهُمۡ عَذَابٌ أَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "ان الذين كفروا لو ان لهم ما في الارض جميعا ومثله معه ليفتدوا به من عذاب يوم القيٰمة ما تقبل منهم ولهم عذاب اليم" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "714" ;
        quran:page                     "113" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:524  quran:ayah_text             "۞وَٱلۡمُحۡصَنَٰتُ مِنَ ٱلنِّسَآءِ إِلَّا مَا مَلَكَتۡ أَيۡمَٰنُكُمۡۖ كِتَٰبَ ٱللَّهِ عَلَيۡكُمۡۚ وَأُحِلَّ لَكُم مَّا وَرَآءَ ذَٰلِكُمۡ أَن تَبۡتَغُواْ بِأَمۡوَٰلِكُم مُّحۡصِنِينَ غَيۡرَ مُسَٰفِحِينَۚ فَمَا ٱسۡتَمۡتَعۡتُم بِهِۦ مِنۡهُنَّ فَـَٔاتُوهُنَّ أُجُورَهُنَّ فَرِيضَةٗۚ وَلَا جُنَاحَ عَلَيۡكُمۡ فِيمَا تَرَٰضَيۡتُم بِهِۦ مِنۢ بَعۡدِ ٱلۡفَرِيضَةِۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا" ;
        quran:ayah_text_no_diacratic   "والمحصنٰت من النساء الا ما ملكت ايمٰنكم كتٰب الله عليكم واحل لكم ما وراء ذٰلكم ان تبتغوا باموٰلكم محصنين غير مسٰفحين فما استمتعتم به منهن فاتوهن اجورهن فريضة ولا جناح عليكم فيما ترٰضيتم به من بعد الفريضة ان الله كان عليما حكيما" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "524" ;
        quran:page                     "82" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:334  quran:ayah_text             "فَلَمَّا وَضَعَتۡهَا قَالَتۡ رَبِّ إِنِّي وَضَعۡتُهَآ أُنثَىٰ وَٱللَّهُ أَعۡلَمُ بِمَا وَضَعَتۡ وَلَيۡسَ ٱلذَّكَرُ كَٱلۡأُنثَىٰۖ وَإِنِّي سَمَّيۡتُهَا مَرۡيَمَ وَإِنِّيٓ أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ ٱلشَّيۡطَٰنِ ٱلرَّجِيمِ" ;
        quran:ayah_text_no_diacratic   "فلما وضعتها قالت رب اني وضعتها انثىٰ والله اعلم بما وضعت وليس الذكر كالانثىٰ واني سميتها مريم واني اعيذها بك وذريتها من الشيطٰن الرجيم" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "334" ;
        quran:page                     "54" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5863  quran:ayah_text            "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا" ;
        quran:ayah_text_no_diacratic   "رب السمٰوٰت والارض وما بينهما الرحمٰن لا يملكون منه خطابا" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "30" ;
        quran:hizb                     "58" ;
        quran:index                    "5863" ;
        quran:page                     "583" ;
        quran:surahname                "سُورَةُ النَّبَإِ" ;
        quran:surahnumber              "78" ;
        quran:surrahname_no_diacratic  "سورة النبا" .

quran:144  quran:ayah_text             "تِلۡكَ أُمَّةٞ قَدۡ خَلَتۡۖ لَهَا مَا كَسَبَتۡ وَلَكُم مَّا كَسَبۡتُمۡۖ وَلَا تُسۡـَٔلُونَ عَمَّا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "تلك امة قد خلت لها ما كسبت ولكم ما كسبتم ولا تسلون عما كانوا يعملون" ;
        quran:ayahnumber               "134" ;
        quran:chapter                  "1" ;
        quran:hizb                     "2" ;
        quran:index                    "144" ;
        quran:page                     "20" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1938  quran:ayah_text            "وَتَحۡمِلُ أَثۡقَالَكُمۡ إِلَىٰ بَلَدٖ لَّمۡ تَكُونُواْ بَٰلِغِيهِ إِلَّا بِشِقِّ ٱلۡأَنفُسِۚ إِنَّ رَبَّكُمۡ لَرَءُوفٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "وتحمل اثقالكم الىٰ بلد لم تكونوا بٰلغيه الا بشق الانفس ان ربكم لرءوف رحيم" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1938" ;
        quran:page                     "268" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
