quran:1136  quran:ayah_text            "فَخَلَفَ مِنۢ بَعۡدِهِمۡ خَلۡفٞ وَرِثُواْ ٱلۡكِتَٰبَ يَأۡخُذُونَ عَرَضَ هَٰذَا ٱلۡأَدۡنَىٰ وَيَقُولُونَ سَيُغۡفَرُ لَنَا وَإِن يَأۡتِهِمۡ عَرَضٞ مِّثۡلُهُۥ يَأۡخُذُوهُۚ أَلَمۡ يُؤۡخَذۡ عَلَيۡهِم مِّيثَٰقُ ٱلۡكِتَٰبِ أَن لَّا يَقُولُواْ عَلَى ٱللَّهِ إِلَّا ٱلۡحَقَّ وَدَرَسُواْ مَا فِيهِۗ وَٱلدَّارُ ٱلۡأٓخِرَةُ خَيۡرٞ لِّلَّذِينَ يَتَّقُونَۚ أَفَلَا تَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "فخلف من بعدهم خلف ورثوا الكتٰب ياخذون عرض هٰذا الادنىٰ ويقولون سيغفر لنا وان ياتهم عرض مثله ياخذوه الم يؤخذ عليهم ميثٰق الكتٰب ان لا يقولوا على الله الا الحق ودرسوا ما فيه والدار الاخرة خير للذين يتقون افلا تعقلون" ;
        quran:ayahnumber               "169" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1136" ;
        quran:page                     "172" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:844  quran:ayah_text             "فَلَمَّا نَسُواْ مَا ذُكِّرُواْ بِهِۦ فَتَحۡنَا عَلَيۡهِمۡ أَبۡوَٰبَ كُلِّ شَيۡءٍ حَتَّىٰٓ إِذَا فَرِحُواْ بِمَآ أُوتُوٓاْ أَخَذۡنَٰهُم بَغۡتَةٗ فَإِذَا هُم مُّبۡلِسُونَ" ;
        quran:ayah_text_no_diacratic   "فلما نسوا ما ذكروا به فتحنا عليهم ابوٰب كل شيء حتىٰ اذا فرحوا بما اوتوا اخذنٰهم بغتة فاذا هم مبلسون" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "844" ;
        quran:page                     "132" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:654  quran:ayah_text             "وَرَفَعۡنَا فَوۡقَهُمُ ٱلطُّورَ بِمِيثَٰقِهِمۡ وَقُلۡنَا لَهُمُ ٱدۡخُلُواْ ٱلۡبَابَ سُجَّدٗا وَقُلۡنَا لَهُمۡ لَا تَعۡدُواْ فِي ٱلسَّبۡتِ وَأَخَذۡنَا مِنۡهُم مِّيثَٰقًا غَلِيظٗا" ;
        quran:ayah_text_no_diacratic   "ورفعنا فوقهم الطور بميثٰقهم وقلنا لهم ادخلوا الباب سجدا وقلنا لهم لا تعدوا في السبت واخذنا منهم ميثٰقا غليظا" ;
        quran:ayahnumber               "154" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "654" ;
        quran:page                     "102" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:464  quran:ayah_text             "وَمَآ أَصَٰبَكُمۡ يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِ فَبِإِذۡنِ ٱللَّهِ وَلِيَعۡلَمَ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "وما اصٰبكم يوم التقى الجمعان فباذن الله وليعلم المؤمنين" ;
