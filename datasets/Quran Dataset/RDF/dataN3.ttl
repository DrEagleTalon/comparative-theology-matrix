quran:1456  quran:ayah_text            "ثُمَّ بَعَثۡنَا مِنۢ بَعۡدِهِۦ رُسُلًا إِلَىٰ قَوۡمِهِمۡ فَجَآءُوهُم بِٱلۡبَيِّنَٰتِ فَمَا كَانُواْ لِيُؤۡمِنُواْ بِمَا كَذَّبُواْ بِهِۦ مِن قَبۡلُۚ كَذَٰلِكَ نَطۡبَعُ عَلَىٰ قُلُوبِ ٱلۡمُعۡتَدِينَ" ;
        quran:ayah_text_no_diacratic   "ثم بعثنا من بعده رسلا الىٰ قومهم فجاءوهم بالبينٰت فما كانوا ليؤمنوا بما كذبوا به من قبل كذٰلك نطبع علىٰ قلوب المعتدين" ;
        quran:ayahnumber               "74" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1456" ;
        quran:page                     "217" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:5191  quran:ayah_text            "هُوَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ يَعۡلَمُ مَا يَلِجُ فِي ٱلۡأَرۡضِ وَمَا يَخۡرُجُ مِنۡهَا وَمَا يَنزِلُ مِنَ ٱلسَّمَآءِ وَمَا يَعۡرُجُ فِيهَاۖ وَهُوَ مَعَكُمۡ أَيۡنَ مَا كُنتُمۡۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرٞ" ;
        quran:ayah_text_no_diacratic   "هو الذي خلق السمٰوٰت والارض في ستة ايام ثم استوىٰ على العرش يعلم ما يلج في الارض وما يخرج منها وما ينزل من السماء وما يعرج فيها وهو معكم اين ما كنتم والله بما تعملون بصير" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "27" ;
        quran:hizb                     "53" ;
        quran:index                    "5191" ;
        quran:page                     "538" ;
        quran:surahname                "سُورَةُ الحَدِيدِ" ;
        quran:surahnumber              "57" ;
        quran:surrahname_no_diacratic  "سورة الحديد" .

quran:2600  quran:ayah_text            "وَنَصَرۡنَٰهُ مِنَ ٱلۡقَوۡمِ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَآۚ إِنَّهُمۡ كَانُواْ قَوۡمَ سَوۡءٖ فَأَغۡرَقۡنَٰهُمۡ أَجۡمَعِينَ" ;
        quran:ayah_text_no_diacratic   "ونصرنٰه من القوم الذين كذبوا بايٰتنا انهم كانوا قوم سوء فاغرقنٰهم اجمعين" ;
