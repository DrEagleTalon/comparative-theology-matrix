        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2065  quran:ayah_text            "وَقَضَيۡنَآ إِلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ فِي ٱلۡكِتَٰبِ لَتُفۡسِدُنَّ فِي ٱلۡأَرۡضِ مَرَّتَيۡنِ وَلَتَعۡلُنَّ عُلُوّٗا كَبِيرٗا" ;
        quran:ayah_text_no_diacratic   "وقضينا الىٰ بني اسرٰءيل في الكتٰب لتفسدن في الارض مرتين ولتعلن علوا كبيرا" ;
        quran:ayahnumber               "4" ;
