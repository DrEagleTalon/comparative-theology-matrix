quran:3278  quran:ayah_text            "وَقَالَ ٱلَّذِينَ كَفَرُوٓاْ أَءِذَا كُنَّا تُرَٰبٗا وَءَابَآؤُنَآ أَئِنَّا لَمُخۡرَجُونَ" ;
        quran:ayah_text_no_diacratic   "وقال الذين كفروا اءذا كنا ترٰبا وءاباؤنا ائنا لمخرجون" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3278" ;
        quran:page                     "383" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:1280  quran:ayah_text            "قَٰتِلُواْ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱللَّهِ وَلَا بِٱلۡيَوۡمِ ٱلۡأٓخِرِ وَلَا يُحَرِّمُونَ مَا حَرَّمَ ٱللَّهُ وَرَسُولُهُۥ وَلَا يَدِينُونَ دِينَ ٱلۡحَقِّ مِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ حَتَّىٰ يُعۡطُواْ ٱلۡجِزۡيَةَ عَن يَدٖ وَهُمۡ صَٰغِرُونَ" ;
        quran:ayah_text_no_diacratic   "قٰتلوا الذين لا يؤمنون بالله ولا باليوم الاخر ولا يحرمون ما حرم الله ورسوله ولا يدينون دين الحق من الذين اوتوا الكتٰب حتىٰ يعطوا الجزية عن يد وهم صٰغرون" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1280" ;
        quran:page                     "191" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4422  quran:ayah_text            "لِتَسۡتَوُۥاْ عَلَىٰ ظُهُورِهِۦ ثُمَّ تَذۡكُرُواْ نِعۡمَةَ رَبِّكُمۡ إِذَا ٱسۡتَوَيۡتُمۡ عَلَيۡهِ وَتَقُولُواْ سُبۡحَٰنَ ٱلَّذِي سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُۥ مُقۡرِنِينَ" ;
        quran:ayah_text_no_diacratic   "لتستوا علىٰ ظهوره ثم تذكروا نعمة ربكم اذا استويتم عليه وتقولوا سبحٰن الذي سخر لنا هٰذا وما كنا له مقرنين" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4422" ;
        quran:page                     "490" ;
        quran:surahname                "سُورَةُ الزُّخۡرُفِ" ;
        quran:surahnumber              "43" ;
        quran:surrahname_no_diacratic  "سورة الزخرف" .

quran:2184  quran:ayah_text            "إِذۡ أَوَى ٱلۡفِتۡيَةُ إِلَى ٱلۡكَهۡفِ فَقَالُواْ رَبَّنَآ ءَاتِنَا مِن لَّدُنكَ رَحۡمَةٗ وَهَيِّئۡ لَنَا مِنۡ أَمۡرِنَا رَشَدٗا" ;
        quran:ayah_text_no_diacratic   "اذ اوى الفتية الى الكهف فقالوا ربنا ءاتنا من لدنك رحمة وهيئ لنا من امرنا رشدا" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2184" ;
        quran:page                     "294" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:5326  quran:ayah_text            "يُسَبِّحُ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۖ لَهُ ٱلۡمُلۡكُ وَلَهُ ٱلۡحَمۡدُۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ" ;
        quran:ayah_text_no_diacratic   "يسبح لله ما في السمٰوٰت وما في الارض له الملك وله الحمد وهو علىٰ كل شيء قدير" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5326" ;
        quran:page                     "556" ;
        quran:surahname                "سُورَةُ التَّغَابُنِ" ;
        quran:surahnumber              "64" ;
        quran:surrahname_no_diacratic  "سورة التغابن" .

quran:3088  quran:ayah_text            "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ نُوحٌ أَلَا تَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "اذ قال لهم اخوهم نوح الا تتقون" ;
        quran:ayahnumber               "106" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
