quran:497  quran:ayah_text             "وَإِنَّ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ لَمَن يُؤۡمِنُ بِٱللَّهِ وَمَآ أُنزِلَ إِلَيۡكُمۡ وَمَآ أُنزِلَ إِلَيۡهِمۡ خَٰشِعِينَ لِلَّهِ لَا يَشۡتَرُونَ بِـَٔايَٰتِ ٱللَّهِ ثَمَنٗا قَلِيلًاۚ أُوْلَٰٓئِكَ لَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡۗ إِنَّ ٱللَّهَ سَرِيعُ ٱلۡحِسَابِ" ;
        quran:ayah_text_no_diacratic   "وان من اهل الكتٰب لمن يؤمن بالله وما انزل اليكم وما انزل اليهم خٰشعين لله لا يشترون بايٰت الله ثمنا قليلا اولٰئك لهم اجرهم عند ربهم ان الله سريع الحساب" ;
        quran:ayahnumber               "199" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "497" ;
        quran:page                     "76" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:19  quran:ayah_text              "يُخَٰدِعُونَ ٱللَّهَ وَٱلَّذِينَ ءَامَنُواْ وَمَا يَخۡدَعُونَ إِلَّآ أَنفُسَهُمۡ وَمَا يَشۡعُرُونَ" ;
        quran:ayah_text_no_diacratic   "يخٰدعون الله والذين ءامنوا وما يخدعون الا انفسهم وما يشعرون" ;
