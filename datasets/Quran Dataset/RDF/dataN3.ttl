        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:453  quran:ayah_text             "إِنَّ ٱلَّذِينَ تَوَلَّوۡاْ مِنكُمۡ يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِ إِنَّمَا ٱسۡتَزَلَّهُمُ ٱلشَّيۡطَٰنُ بِبَعۡضِ مَا كَسَبُواْۖ وَلَقَدۡ عَفَا ٱللَّهُ عَنۡهُمۡۗ إِنَّ ٱللَّهَ غَفُورٌ حَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "ان الذين تولوا منكم يوم التقى الجمعان انما استزلهم الشيطٰن ببعض ما كسبوا ولقد عفا الله عنهم ان الله غفور حليم" ;
        quran:ayahnumber               "155" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "453" ;
        quran:page                     "70" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

