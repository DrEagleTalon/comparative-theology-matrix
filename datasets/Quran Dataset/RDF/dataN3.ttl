        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1967  quran:ayah_text            "وَلَقَدۡ بَعَثۡنَا فِي كُلِّ أُمَّةٖ رَّسُولًا أَنِ ٱعۡبُدُواْ ٱللَّهَ وَٱجۡتَنِبُواْ ٱلطَّٰغُوتَۖ فَمِنۡهُم مَّنۡ هَدَى ٱللَّهُ وَمِنۡهُم مَّنۡ حَقَّتۡ عَلَيۡهِ ٱلضَّلَٰلَةُۚ فَسِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُكَذِّبِينَ" ;
        quran:ayah_text_no_diacratic   "ولقد بعثنا في كل امة رسولا ان اعبدوا الله واجتنبوا الطٰغوت فمنهم من هدى الله ومنهم من حقت عليه الضلٰلة فسيروا في الارض فانظروا كيف كان عٰقبة المكذبين" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1967" ;
        quran:page                     "271" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:1777  quran:ayah_text            "الٓرۚ كِتَٰبٌ أَنزَلۡنَٰهُ إِلَيۡكَ لِتُخۡرِجَ ٱلنَّاسَ مِنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِ بِإِذۡنِ رَبِّهِمۡ إِلَىٰ صِرَٰطِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ" ;
        quran:ayah_text_no_diacratic   "الر كتٰب انزلنٰه اليك لتخرج الناس من الظلمٰت الى النور باذن ربهم الىٰ صرٰط العزيز الحميد" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1777" ;
        quran:page                     "255" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:4919  quran:ayah_text            "وَلِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ لِيَجۡزِيَ ٱلَّذِينَ أَسَٰٓـُٔواْ بِمَا عَمِلُواْ وَيَجۡزِيَ ٱلَّذِينَ أَحۡسَنُواْ بِٱلۡحُسۡنَى" ;
        quran:ayah_text_no_diacratic   "ولله ما في السمٰوٰت وما في الارض ليجزي الذين اسٰوا بما عملوا ويجزي الذين احسنوا بالحسنى" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "27" ;
        quran:hizb                     "52" ;
        quran:index                    "4919" ;
        quran:page                     "527" ;
        quran:surahname                "سُورَةُ النَّجۡمِ" ;
        quran:surahnumber              "53" ;
        quran:surrahname_no_diacratic  "سورة النجم" .

quran:2921  quran:ayah_text            "قَالُواْ سُبۡحَٰنَكَ مَا كَانَ يَنۢبَغِي لَنَآ أَن نَّتَّخِذَ مِن دُونِكَ مِنۡ أَوۡلِيَآءَ وَلَٰكِن مَّتَّعۡتَهُمۡ وَءَابَآءَهُمۡ حَتَّىٰ نَسُواْ ٱلذِّكۡرَ وَكَانُواْ قَوۡمَۢا بُورٗا" ;
        quran:ayah_text_no_diacratic   "قالوا سبحٰنك ما كان ينبغي لنا ان نتخذ من دونك من اولياء ولٰكن متعتهم وءاباءهم حتىٰ نسوا الذكر وكانوا قوما بورا" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "18" ;
        quran:hizb                     "36" ;
        quran:index                    "2921" ;
        quran:page                     "361" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3825  quran:ayah_text            "فَلَا يَسۡتَطِيعُونَ تَوۡصِيَةٗ وَلَآ إِلَىٰٓ أَهۡلِهِمۡ يَرۡجِعُونَ" ;
        quran:ayah_text_no_diacratic   "فلا يستطيعون توصية ولا الىٰ اهلهم يرجعون" ;
        quran:ayahnumber               "50" ;
