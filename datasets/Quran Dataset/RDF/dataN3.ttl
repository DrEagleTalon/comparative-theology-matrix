        quran:surrahname_no_diacratic  "سورة النحل" .

quran:653  quran:ayah_text             "يَسۡـَٔلُكَ أَهۡلُ ٱلۡكِتَٰبِ أَن تُنَزِّلَ عَلَيۡهِمۡ كِتَٰبٗا مِّنَ ٱلسَّمَآءِۚ فَقَدۡ سَأَلُواْ مُوسَىٰٓ أَكۡبَرَ مِن ذَٰلِكَ فَقَالُوٓاْ أَرِنَا ٱللَّهَ جَهۡرَةٗ فَأَخَذَتۡهُمُ ٱلصَّٰعِقَةُ بِظُلۡمِهِمۡۚ ثُمَّ ٱتَّخَذُواْ ٱلۡعِجۡلَ مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَٰتُ فَعَفَوۡنَا عَن ذَٰلِكَۚ وَءَاتَيۡنَا مُوسَىٰ سُلۡطَٰنٗا مُّبِينٗا" ;
        quran:ayah_text_no_diacratic   "يسلك اهل الكتٰب ان تنزل عليهم كتٰبا من السماء فقد سالوا موسىٰ اكبر من ذٰلك فقالوا ارنا الله جهرة فاخذتهم الصٰعقة بظلمهم ثم اتخذوا العجل من بعد ما جاءتهم البينٰت فعفونا عن ذٰلك وءاتينا موسىٰ سلطٰنا مبينا" ;
        quran:ayahnumber               "153" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "653" ;
        quran:page                     "102" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:463  quran:ayah_text             "أَوَلَمَّآ أَصَٰبَتۡكُم مُّصِيبَةٞ قَدۡ أَصَبۡتُم مِّثۡلَيۡهَا قُلۡتُمۡ أَنَّىٰ هَٰذَاۖ قُلۡ هُوَ مِنۡ عِندِ أَنفُسِكُمۡۗ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "اولما اصٰبتكم مصيبة قد اصبتم مثليها قلتم انىٰ هٰذا قل هو من عند انفسكم ان الله علىٰ كل شيء قدير" ;
