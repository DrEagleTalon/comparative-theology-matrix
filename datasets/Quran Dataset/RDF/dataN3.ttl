quran:2834  quran:ayah_text            "وَمَن يَدۡعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ لَا بُرۡهَٰنَ لَهُۥ بِهِۦ فَإِنَّمَا حِسَابُهُۥ عِندَ رَبِّهِۦٓۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلۡكَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "ومن يدع مع الله الٰها ءاخر لا برهٰن له به فانما حسابه عند ربه انه لا يفلح الكٰفرون" ;
        quran:ayahnumber               "117" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2834" ;
