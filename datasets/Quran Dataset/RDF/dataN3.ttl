quran:230  quran:ayah_text             "فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۗ وَيَسۡـَٔلُونَكَ عَنِ ٱلۡيَتَٰمَىٰۖ قُلۡ إِصۡلَاحٞ لَّهُمۡ خَيۡرٞۖ وَإِن تُخَالِطُوهُمۡ فَإِخۡوَٰنُكُمۡۚ وَٱللَّهُ يَعۡلَمُ ٱلۡمُفۡسِدَ مِنَ ٱلۡمُصۡلِحِۚ وَلَوۡ شَآءَ ٱللَّهُ لَأَعۡنَتَكُمۡۚ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "في الدنيا والاخرة ويسلونك عن اليتٰمىٰ قل اصلاح لهم خير وان تخالطوهم فاخوٰنكم والله يعلم المفسد من المصلح ولو شاء الله لاعنتكم ان الله عزيز حكيم" ;
        quran:ayahnumber               "220" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "230" ;
        quran:page                     "35" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2928  quran:ayah_text            "وَيَوۡمَ تَشَقَّقُ ٱلسَّمَآءُ بِٱلۡغَمَٰمِ وَنُزِّلَ ٱلۡمَلَٰٓئِكَةُ تَنزِيلًا" ;
