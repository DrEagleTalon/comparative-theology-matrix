        quran:surrahname_no_diacratic  "سورة ص" .

quran:948  quran:ayah_text             "سَيَقُولُ ٱلَّذِينَ أَشۡرَكُواْ لَوۡ شَآءَ ٱللَّهُ مَآ أَشۡرَكۡنَا وَلَآ ءَابَآؤُنَا وَلَا حَرَّمۡنَا مِن شَيۡءٖۚ كَذَٰلِكَ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ حَتَّىٰ ذَاقُواْ بَأۡسَنَاۗ قُلۡ هَلۡ عِندَكُم مِّنۡ عِلۡمٖ فَتُخۡرِجُوهُ لَنَآۖ إِن تَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنۡ أَنتُمۡ إِلَّا تَخۡرُصُونَ" ;
        quran:ayah_text_no_diacratic   "سيقول الذين اشركوا لو شاء الله ما اشركنا ولا ءاباؤنا ولا حرمنا من شيء كذٰلك كذب الذين من قبلهم حتىٰ ذاقوا باسنا قل هل عندكم من علم فتخرجوه لنا ان تتبعون الا الظن وان انتم الا تخرصون" ;
        quran:ayahnumber               "148" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "948" ;
        quran:page                     "148" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:758  quran:ayah_text             "تَرَىٰ كَثِيرٗا مِّنۡهُمۡ يَتَوَلَّوۡنَ ٱلَّذِينَ كَفَرُواْۚ لَبِئۡسَ مَا قَدَّمَتۡ لَهُمۡ أَنفُسُهُمۡ أَن سَخِطَ ٱللَّهُ عَلَيۡهِمۡ وَفِي ٱلۡعَذَابِ هُمۡ خَٰلِدُونَ" ;
        quran:ayah_text_no_diacratic   "ترىٰ كثيرا منهم يتولون الذين كفروا لبئس ما قدمت لهم انفسهم ان سخط الله عليهم وفي العذاب هم خٰلدون" ;
        quran:ayahnumber               "80" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "758" ;
        quran:page                     "121" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:1100  quran:ayah_text            "فَأَرۡسَلۡنَا عَلَيۡهِمُ ٱلطُّوفَانَ وَٱلۡجَرَادَ وَٱلۡقُمَّلَ وَٱلضَّفَادِعَ وَٱلدَّمَ ءَايَٰتٖ مُّفَصَّلَٰتٖ فَٱسۡتَكۡبَرُواْ وَكَانُواْ قَوۡمٗا مُّجۡرِمِينَ" ;
        quran:ayah_text_no_diacratic   "فارسلنا عليهم الطوفان والجراد والقمل والضفادع والدم ءايٰت مفصلٰت فاستكبروا وكانوا قوما مجرمين" ;
        quran:ayahnumber               "133" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1100" ;
        quran:page                     "166" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:568  quran:ayah_text             "وَلَهَدَيۡنَٰهُمۡ صِرَٰطٗا مُّسۡتَقِيمٗا" ;
        quran:ayah_text_no_diacratic   "ولهدينٰهم صرٰطا مستقيما" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "568" ;
        quran:page                     "89" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2004  quran:ayah_text            "وَيَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَمۡلِكُ لَهُمۡ رِزۡقٗا مِّنَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ شَيۡـٔٗا وَلَا يَسۡتَطِيعُونَ" ;
        quran:ayah_text_no_diacratic   "ويعبدون من دون الله ما لا يملك لهم رزقا من السمٰوٰت والارض شيا ولا يستطيعون" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2004" ;
        quran:page                     "275" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:378  quran:ayah_text             "وَلَا يَأۡمُرَكُمۡ أَن تَتَّخِذُواْ ٱلۡمَلَٰٓئِكَةَ وَٱلنَّبِيِّـۧنَ أَرۡبَابًاۚ أَيَأۡمُرُكُم بِٱلۡكُفۡرِ بَعۡدَ إِذۡ أَنتُم مُّسۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "ولا يامركم ان تتخذوا الملٰئكة والنبين اربابا ايامركم بالكفر بعد اذ انتم مسلمون" ;
        quran:ayahnumber               "80" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "378" ;
        quran:page                     "60" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:188  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُتِبَ عَلَيۡكُمُ ٱلۡقِصَاصُ فِي ٱلۡقَتۡلَىۖ ٱلۡحُرُّ بِٱلۡحُرِّ وَٱلۡعَبۡدُ بِٱلۡعَبۡدِ وَٱلۡأُنثَىٰ بِٱلۡأُنثَىٰۚ فَمَنۡ عُفِيَ لَهُۥ مِنۡ أَخِيهِ شَيۡءٞ فَٱتِّبَاعُۢ بِٱلۡمَعۡرُوفِ وَأَدَآءٌ إِلَيۡهِ بِإِحۡسَٰنٖۗ ذَٰلِكَ تَخۡفِيفٞ مِّن رَّبِّكُمۡ وَرَحۡمَةٞۗ فَمَنِ ٱعۡتَدَىٰ بَعۡدَ ذَٰلِكَ فَلَهُۥ عَذَابٌ أَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا كتب عليكم القصاص في القتلى الحر بالحر والعبد بالعبد والانثىٰ بالانثىٰ فمن عفي له من اخيه شيء فاتباع بالمعروف واداء اليه باحسٰن ذٰلك تخفيف من ربكم ورحمة فمن اعتدىٰ بعد ذٰلك فله عذاب اليم" ;
        quran:ayahnumber               "178" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "188" ;
        quran:page                     "27" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2936  quran:ayah_text            "وَلَا يَأۡتُونَكَ بِمَثَلٍ إِلَّا جِئۡنَٰكَ بِٱلۡحَقِّ وَأَحۡسَنَ تَفۡسِيرًا" ;
        quran:ayah_text_no_diacratic   "ولا ياتونك بمثل الا جئنٰك بالحق واحسن تفسيرا" ;
