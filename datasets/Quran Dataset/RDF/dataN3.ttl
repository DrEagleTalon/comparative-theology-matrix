        quran:surahname                "سُورَةُ الزُّخۡرُفِ" ;
        quran:surahnumber              "43" ;
        quran:surrahname_no_diacratic  "سورة الزخرف" .

quran:2175  quran:ayah_text            "ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِيٓ أَنزَلَ عَلَىٰ عَبۡدِهِ ٱلۡكِتَٰبَ وَلَمۡ يَجۡعَل لَّهُۥ عِوَجَاۜ" ;
        quran:ayah_text_no_diacratic   "الحمد لله الذي انزل علىٰ عبده الكتٰب ولم يجعل له عوجا" ;
