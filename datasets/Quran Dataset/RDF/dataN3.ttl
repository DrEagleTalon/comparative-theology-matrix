quran:1542  quran:ayah_text            "تِلۡكَ مِنۡ أَنۢبَآءِ ٱلۡغَيۡبِ نُوحِيهَآ إِلَيۡكَۖ مَا كُنتَ تَعۡلَمُهَآ أَنتَ وَلَا قَوۡمُكَ مِن قَبۡلِ هَٰذَاۖ فَٱصۡبِرۡۖ إِنَّ ٱلۡعَٰقِبَةَ لِلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "تلك من انباء الغيب نوحيها اليك ما كنت تعلمها انت ولا قومك من قبل هٰذا فاصبر ان العٰقبة للمتقين" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "12" ;
        quran:hizb                     "22" ;
        quran:index                    "1542" ;
        quran:page                     "227" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2446  quran:ayah_text            "فَتَوَلَّىٰ فِرۡعَوۡنُ فَجَمَعَ كَيۡدَهُۥ ثُمَّ أَتَىٰ" ;
        quran:ayah_text_no_diacratic   "فتولىٰ فرعون فجمع كيده ثم اتىٰ" ;
        quran:ayahnumber               "60" ;
