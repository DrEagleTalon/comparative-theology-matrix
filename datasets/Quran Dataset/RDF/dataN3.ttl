        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:3417  quran:ayah_text            "يُعَذِّبُ مَن يَشَآءُ وَيَرۡحَمُ مَن يَشَآءُۖ وَإِلَيۡهِ تُقۡلَبُونَ" ;
        quran:ayah_text_no_diacratic   "يعذب من يشاء ويرحم من يشاء واليه تقلبون" ;
        quran:ayahnumber               "21" ;
