quran:2219  quran:ayah_text            "وَٱضۡرِبۡ لَهُم مَّثَلَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا كَمَآءٍ أَنزَلۡنَٰهُ مِنَ ٱلسَّمَآءِ فَٱخۡتَلَطَ بِهِۦ نَبَاتُ ٱلۡأَرۡضِ فَأَصۡبَحَ هَشِيمٗا تَذۡرُوهُ ٱلرِّيَٰحُۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ مُّقۡتَدِرًا" ;
        quran:ayah_text_no_diacratic   "واضرب لهم مثل الحيوٰة الدنيا كماء انزلنٰه من السماء فاختلط به نبات الارض فاصبح هشيما تذروه الريٰح وكان الله علىٰ كل شيء مقتدرا" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2219" ;
        quran:page                     "298" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1125  quran:ayah_text            "قُلۡ يَٰٓأَيُّهَا ٱلنَّاسُ إِنِّي رَسُولُ ٱللَّهِ إِلَيۡكُمۡ جَمِيعًا ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ لَآ إِلَٰهَ إِلَّا هُوَ يُحۡيِۦ وَيُمِيتُۖ فَـَٔامِنُواْ بِٱللَّهِ وَرَسُولِهِ ٱلنَّبِيِّ ٱلۡأُمِّيِّ ٱلَّذِي يُؤۡمِنُ بِٱللَّهِ وَكَلِمَٰتِهِۦ وَٱتَّبِعُوهُ لَعَلَّكُمۡ تَهۡتَدُونَ" ;
        quran:ayah_text_no_diacratic   "قل يٰايها الناس اني رسول الله اليكم جميعا الذي له ملك السمٰوٰت والارض لا الٰه الا هو يحي ويميت فامنوا بالله ورسوله النبي الامي الذي يؤمن بالله وكلمٰته واتبعوه لعلكم تهتدون" ;
        quran:ayahnumber               "158" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1125" ;
        quran:page                     "170" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:833  quran:ayah_text             "قَدۡ نَعۡلَمُ إِنَّهُۥ لَيَحۡزُنُكَ ٱلَّذِي يَقُولُونَۖ فَإِنَّهُمۡ لَا يُكَذِّبُونَكَ وَلَٰكِنَّ ٱلظَّٰلِمِينَ بِـَٔايَٰتِ ٱللَّهِ يَجۡحَدُونَ" ;
        quran:ayah_text_no_diacratic   "قد نعلم انه ليحزنك الذي يقولون فانهم لا يكذبونك ولٰكن الظٰلمين بايٰت الله يجحدون" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "833" ;
        quran:page                     "131" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2029  quran:ayah_text            "فَإِذَا قَرَأۡتَ ٱلۡقُرۡءَانَ فَٱسۡتَعِذۡ بِٱللَّهِ مِنَ ٱلشَّيۡطَٰنِ ٱلرَّجِيمِ" ;
        quran:ayah_text_no_diacratic   "فاذا قرات القرءان فاستعذ بالله من الشيطٰن الرجيم" ;
        quran:ayahnumber               "98" ;
