        quran:surrahname_no_diacratic  "سورة ص" .

quran:2121  quran:ayah_text            "وَإِذۡ قُلۡنَا لَكَ إِنَّ رَبَّكَ أَحَاطَ بِٱلنَّاسِۚ وَمَا جَعَلۡنَا ٱلرُّءۡيَا ٱلَّتِيٓ أَرَيۡنَٰكَ إِلَّا فِتۡنَةٗ لِّلنَّاسِ وَٱلشَّجَرَةَ ٱلۡمَلۡعُونَةَ فِي ٱلۡقُرۡءَانِۚ وَنُخَوِّفُهُمۡ فَمَا يَزِيدُهُمۡ إِلَّا طُغۡيَٰنٗا كَبِيرٗا" ;
        quran:ayah_text_no_diacratic   "واذ قلنا لك ان ربك احاط بالناس وما جعلنا الرءيا التي ارينٰك الا فتنة للناس والشجرة الملعونة في القرءان ونخوفهم فما يزيدهم الا طغيٰنا كبيرا" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2121" ;
        quran:page                     "288" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3025  quran:ayah_text            "قَالَ لَهُم مُّوسَىٰٓ أَلۡقُواْ مَآ أَنتُم مُّلۡقُونَ" ;
        quran:ayah_text_no_diacratic   "قال لهم موسىٰ القوا ما انتم ملقون" ;
        quran:ayahnumber               "43" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "3025" ;
