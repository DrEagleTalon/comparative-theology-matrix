quran:3569  quran:ayah_text            "ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ مَا لَكُم مِّن دُونِهِۦ مِن وَلِيّٖ وَلَا شَفِيعٍۚ أَفَلَا تَتَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "الله الذي خلق السمٰوٰت والارض وما بينهما في ستة ايام ثم استوىٰ على العرش ما لكم من دونه من ولي ولا شفيع افلا تتذكرون" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3569" ;
        quran:page                     "415" ;
        quran:surahname                "سُورَةُ السَّجۡدَةِ" ;
        quran:surahnumber              "32" ;
        quran:surrahname_no_diacratic  "سورة السجدة" .

quran:1571  quran:ayah_text            "وَجَآءَهُۥ قَوۡمُهُۥ يُهۡرَعُونَ إِلَيۡهِ وَمِن قَبۡلُ كَانُواْ يَعۡمَلُونَ ٱلسَّيِّـَٔاتِۚ قَالَ يَٰقَوۡمِ هَٰٓؤُلَآءِ بَنَاتِي هُنَّ أَطۡهَرُ لَكُمۡۖ فَٱتَّقُواْ ٱللَّهَ وَلَا تُخۡزُونِ فِي ضَيۡفِيٓۖ أَلَيۡسَ مِنكُمۡ رَجُلٞ رَّشِيدٞ" ;
        quran:ayah_text_no_diacratic   "وجاءه قومه يهرعون اليه ومن قبل كانوا يعملون السيات قال يٰقوم هٰؤلاء بناتي هن اطهر لكم فاتقوا الله ولا تخزون في ضيفي اليس منكم رجل رشيد" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1571" ;
        quran:page                     "230" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4713  quran:ayah_text            "وَلَوۡ أَنَّهُمۡ صَبَرُواْ حَتَّىٰ تَخۡرُجَ إِلَيۡهِمۡ لَكَانَ خَيۡرٗا لَّهُمۡۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "ولو انهم صبروا حتىٰ تخرج اليهم لكان خيرا لهم والله غفور رحيم" ;
