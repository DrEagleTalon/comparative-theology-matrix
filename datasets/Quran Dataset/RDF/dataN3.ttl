quran:5263  quran:ayah_text            "لَوۡ أَنزَلۡنَا هَٰذَا ٱلۡقُرۡءَانَ عَلَىٰ جَبَلٖ لَّرَأَيۡتَهُۥ خَٰشِعٗا مُّتَصَدِّعٗا مِّنۡ خَشۡيَةِ ٱللَّهِۚ وَتِلۡكَ ٱلۡأَمۡثَٰلُ نَضۡرِبُهَا لِلنَّاسِ لَعَلَّهُمۡ يَتَفَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "لو انزلنا هٰذا القرءان علىٰ جبل لرايته خٰشعا متصدعا من خشية الله وتلك الامثٰل نضربها للناس لعلهم يتفكرون" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5263" ;
        quran:page                     "548" ;
        quran:surahname                "سُورَةُ الحَشۡرِ" ;
