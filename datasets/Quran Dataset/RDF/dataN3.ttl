        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2128  quran:ayah_text            "وَإِذَا مَسَّكُمُ ٱلضُّرُّ فِي ٱلۡبَحۡرِ ضَلَّ مَن تَدۡعُونَ إِلَّآ إِيَّاهُۖ فَلَمَّا نَجَّىٰكُمۡ إِلَى ٱلۡبَرِّ أَعۡرَضۡتُمۡۚ وَكَانَ ٱلۡإِنسَٰنُ كَفُورًا" ;
        quran:ayah_text_no_diacratic   "واذا مسكم الضر في البحر ضل من تدعون الا اياه فلما نجىٰكم الى البر اعرضتم وكان الانسٰن كفورا" ;
        quran:ayahnumber               "67" ;
