quran:229  quran:ayah_text             "۞يَسۡـَٔلُونَكَ عَنِ ٱلۡخَمۡرِ وَٱلۡمَيۡسِرِۖ قُلۡ فِيهِمَآ إِثۡمٞ كَبِيرٞ وَمَنَٰفِعُ لِلنَّاسِ وَإِثۡمُهُمَآ أَكۡبَرُ مِن نَّفۡعِهِمَاۗ وَيَسۡـَٔلُونَكَ مَاذَا يُنفِقُونَۖ قُلِ ٱلۡعَفۡوَۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِ لَعَلَّكُمۡ تَتَفَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "يسلونك عن الخمر والميسر قل فيهما اثم كبير ومنٰفع للناس واثمهما اكبر من نفعهما ويسلونك ماذا ينفقون قل العفو كذٰلك يبين الله لكم الايٰت لعلكم تتفكرون" ;
        quran:ayahnumber               "219" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "229" ;
        quran:page                     "34" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

