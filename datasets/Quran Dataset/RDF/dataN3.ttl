quran:2905  quran:ayah_text            "ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَلَمۡ يَتَّخِذۡ وَلَدٗا وَلَمۡ يَكُن لَّهُۥ شَرِيكٞ فِي ٱلۡمُلۡكِ وَخَلَقَ كُلَّ شَيۡءٖ فَقَدَّرَهُۥ تَقۡدِيرٗا" ;
        quran:ayah_text_no_diacratic   "الذي له ملك السمٰوٰت والارض ولم يتخذ ولدا ولم يكن له شريك في الملك وخلق كل شيء فقدره تقديرا" ;
        quran:ayahnumber               "2" ;
        quran:chapter                  "18" ;
        quran:hizb                     "36" ;
        quran:index                    "2905" ;
        quran:page                     "359" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3809  quran:ayah_text            "وَجَعَلۡنَا فِيهَا جَنَّٰتٖ مِّن نَّخِيلٖ وَأَعۡنَٰبٖ وَفَجَّرۡنَا فِيهَا مِنَ ٱلۡعُيُونِ" ;
        quran:ayah_text_no_diacratic   "وجعلنا فيها جنٰت من نخيل واعنٰب وفجرنا فيها من العيون" ;
        quran:ayahnumber               "34" ;
