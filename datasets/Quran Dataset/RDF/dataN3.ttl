quran:743  quran:ayah_text             "وَلَوۡ أَنَّ أَهۡلَ ٱلۡكِتَٰبِ ءَامَنُواْ وَٱتَّقَوۡاْ لَكَفَّرۡنَا عَنۡهُمۡ سَيِّـَٔاتِهِمۡ وَلَأَدۡخَلۡنَٰهُمۡ جَنَّٰتِ ٱلنَّعِيمِ" ;
        quran:ayah_text_no_diacratic   "ولو ان اهل الكتٰب ءامنوا واتقوا لكفرنا عنهم سياتهم ولادخلنٰهم جنٰت النعيم" ;
        quran:ayahnumber               "65" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "743" ;
        quran:page                     "119" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:553  quran:ayah_text             "أَمۡ لَهُمۡ نَصِيبٞ مِّنَ ٱلۡمُلۡكِ فَإِذٗا لَّا يُؤۡتُونَ ٱلنَّاسَ نَقِيرًا" ;
        quran:ayah_text_no_diacratic   "ام لهم نصيب من الملك فاذا لا يؤتون الناس نقيرا" ;
        quran:ayahnumber               "53" ;
