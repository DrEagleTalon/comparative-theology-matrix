quran:909  quran:ayah_text             "وَأَقۡسَمُواْ بِٱللَّهِ جَهۡدَ أَيۡمَٰنِهِمۡ لَئِن جَآءَتۡهُمۡ ءَايَةٞ لَّيُؤۡمِنُنَّ بِهَاۚ قُلۡ إِنَّمَا ٱلۡأٓيَٰتُ عِندَ ٱللَّهِۖ وَمَا يُشۡعِرُكُمۡ أَنَّهَآ إِذَا جَآءَتۡ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "واقسموا بالله جهد ايمٰنهم لئن جاءتهم ءاية ليؤمنن بها قل انما الايٰت عند الله وما يشعركم انها اذا جاءت لا يؤمنون" ;
        quran:ayahnumber               "109" ;
        quran:chapter                  "7" ;
        quran:hizb                     "14" ;
        quran:index                    "909" ;
        quran:page                     "141" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:719  quran:ayah_text             "۞يَٰٓأَيُّهَا ٱلرَّسُولُ لَا يَحۡزُنكَ ٱلَّذِينَ يُسَٰرِعُونَ فِي ٱلۡكُفۡرِ مِنَ ٱلَّذِينَ قَالُوٓاْ ءَامَنَّا بِأَفۡوَٰهِهِمۡ وَلَمۡ تُؤۡمِن قُلُوبُهُمۡۛ وَمِنَ ٱلَّذِينَ هَادُواْۛ سَمَّٰعُونَ لِلۡكَذِبِ سَمَّٰعُونَ لِقَوۡمٍ ءَاخَرِينَ لَمۡ يَأۡتُوكَۖ يُحَرِّفُونَ ٱلۡكَلِمَ مِنۢ بَعۡدِ مَوَاضِعِهِۦۖ يَقُولُونَ إِنۡ أُوتِيتُمۡ هَٰذَا فَخُذُوهُ وَإِن لَّمۡ تُؤۡتَوۡهُ فَٱحۡذَرُواْۚ وَمَن يُرِدِ ٱللَّهُ فِتۡنَتَهُۥ فَلَن تَمۡلِكَ لَهُۥ مِنَ ٱللَّهِ شَيۡـًٔاۚ أُوْلَٰٓئِكَ ٱلَّذِينَ لَمۡ يُرِدِ ٱللَّهُ أَن يُطَهِّرَ قُلُوبَهُمۡۚ لَهُمۡ فِي ٱلدُّنۡيَا خِزۡيٞۖ وَلَهُمۡ فِي ٱلۡأٓخِرَةِ عَذَابٌ عَظِيمٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الرسول لا يحزنك الذين يسٰرعون في الكفر من الذين قالوا ءامنا بافوٰههم ولم تؤمن قلوبهم ومن الذين هادوا سمٰعون للكذب سمٰعون لقوم ءاخرين لم ياتوك يحرفون الكلم من بعد مواضعه يقولون ان اوتيتم هٰذا فخذوه وان لم تؤتوه فاحذروا ومن يرد الله فتنته فلن تملك له من الله شيا اولٰئك الذين لم يرد الله ان يطهر قلوبهم لهم في الدنيا خزي ولهم في الاخرة عذاب عظيم" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "719" ;
        quran:page                     "114" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:529  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَأۡكُلُوٓاْ أَمۡوَٰلَكُم بَيۡنَكُم بِٱلۡبَٰطِلِ إِلَّآ أَن تَكُونَ تِجَٰرَةً عَن تَرَاضٖ مِّنكُمۡۚ وَلَا تَقۡتُلُوٓاْ أَنفُسَكُمۡۚ إِنَّ ٱللَّهَ كَانَ بِكُمۡ رَحِيمٗا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا تاكلوا اموٰلكم بينكم بالبٰطل الا ان تكون تجٰرة عن تراض منكم ولا تقتلوا انفسكم ان الله كان بكم رحيما" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "529" ;
        quran:page                     "83" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4964  quran:ayah_text            "وَفَجَّرۡنَا ٱلۡأَرۡضَ عُيُونٗا فَٱلۡتَقَى ٱلۡمَآءُ عَلَىٰٓ أَمۡرٖ قَدۡ قُدِرَ" ;
        quran:ayah_text_no_diacratic   "وفجرنا الارض عيونا فالتقى الماء علىٰ امر قد قدر" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "27" ;
        quran:hizb                     "53" ;
        quran:index                    "4964" ;
        quran:page                     "529" ;
        quran:surahname                "سُورَةُ القَمَرِ" ;
        quran:surahnumber              "54" ;
        quran:surrahname_no_diacratic  "سورة القمر" .

quran:339  quran:ayah_text             "قَالَ رَبِّ ٱجۡعَل لِّيٓ ءَايَةٗۖ قَالَ ءَايَتُكَ أَلَّا تُكَلِّمَ ٱلنَّاسَ ثَلَٰثَةَ أَيَّامٍ إِلَّا رَمۡزٗاۗ وَٱذۡكُر رَّبَّكَ كَثِيرٗا وَسَبِّحۡ بِٱلۡعَشِيِّ وَٱلۡإِبۡكَٰرِ" ;
        quran:ayah_text_no_diacratic   "قال رب اجعل لي ءاية قال ءايتك الا تكلم الناس ثلٰثة ايام الا رمزا واذكر ربك كثيرا وسبح بالعشي والابكٰر" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "339" ;
        quran:page                     "55" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

