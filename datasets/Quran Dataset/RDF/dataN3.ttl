        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:647  quran:ayah_text             "مَّا يَفۡعَلُ ٱللَّهُ بِعَذَابِكُمۡ إِن شَكَرۡتُمۡ وَءَامَنتُمۡۚ وَكَانَ ٱللَّهُ شَاكِرًا عَلِيمٗا" ;
        quran:ayah_text_no_diacratic   "ما يفعل الله بعذابكم ان شكرتم وءامنتم وكان الله شاكرا عليما" ;
