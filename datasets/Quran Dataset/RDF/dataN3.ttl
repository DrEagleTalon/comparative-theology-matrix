        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:525  quran:ayah_text             "وَمَن لَّمۡ يَسۡتَطِعۡ مِنكُمۡ طَوۡلًا أَن يَنكِحَ ٱلۡمُحۡصَنَٰتِ ٱلۡمُؤۡمِنَٰتِ فَمِن مَّا مَلَكَتۡ أَيۡمَٰنُكُم مِّن فَتَيَٰتِكُمُ ٱلۡمُؤۡمِنَٰتِۚ وَٱللَّهُ أَعۡلَمُ بِإِيمَٰنِكُمۚ بَعۡضُكُم مِّنۢ بَعۡضٖۚ فَٱنكِحُوهُنَّ بِإِذۡنِ أَهۡلِهِنَّ وَءَاتُوهُنَّ أُجُورَهُنَّ بِٱلۡمَعۡرُوفِ مُحۡصَنَٰتٍ غَيۡرَ مُسَٰفِحَٰتٖ وَلَا مُتَّخِذَٰتِ أَخۡدَانٖۚ فَإِذَآ أُحۡصِنَّ فَإِنۡ أَتَيۡنَ بِفَٰحِشَةٖ فَعَلَيۡهِنَّ نِصۡفُ مَا عَلَى ٱلۡمُحۡصَنَٰتِ مِنَ ٱلۡعَذَابِۚ ذَٰلِكَ لِمَنۡ خَشِيَ ٱلۡعَنَتَ مِنكُمۡۚ وَأَن تَصۡبِرُواْ خَيۡرٞ لَّكُمۡۗ وَٱللَّهُ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "ومن لم يستطع منكم طولا ان ينكح المحصنٰت المؤمنٰت فمن ما ملكت ايمٰنكم من فتيٰتكم المؤمنٰت والله اعلم بايمٰنكم بعضكم من بعض فانكحوهن باذن اهلهن وءاتوهن اجورهن بالمعروف محصنٰت غير مسٰفحٰت ولا متخذٰت اخدان فاذا احصن فان اتين بفٰحشة فعليهن نصف ما على المحصنٰت من العذاب ذٰلك لمن خشي العنت منكم وان تصبروا خير لكم والله غفور رحيم" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "525" ;
        quran:page                     "82" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4960  quran:ayah_text            "مُّهۡطِعِينَ إِلَى ٱلدَّاعِۖ يَقُولُ ٱلۡكَٰفِرُونَ هَٰذَا يَوۡمٌ عَسِرٞ" ;
        quran:ayah_text_no_diacratic   "مهطعين الى الداع يقول الكٰفرون هٰذا يوم عسر" ;
