quran:1156  quran:ayah_text            "۞هُوَ ٱلَّذِي خَلَقَكُم مِّن نَّفۡسٖ وَٰحِدَةٖ وَجَعَلَ مِنۡهَا زَوۡجَهَا لِيَسۡكُنَ إِلَيۡهَاۖ فَلَمَّا تَغَشَّىٰهَا حَمَلَتۡ حَمۡلًا خَفِيفٗا فَمَرَّتۡ بِهِۦۖ فَلَمَّآ أَثۡقَلَت دَّعَوَا ٱللَّهَ رَبَّهُمَا لَئِنۡ ءَاتَيۡتَنَا صَٰلِحٗا لَّنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ" ;
        quran:ayah_text_no_diacratic   "هو الذي خلقكم من نفس وٰحدة وجعل منها زوجها ليسكن اليها فلما تغشىٰها حملت حملا خفيفا فمرت به فلما اثقلت دعوا الله ربهما لئن ءاتيتنا صٰلحا لنكونن من الشٰكرين" ;
        quran:ayahnumber               "189" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1156" ;
        quran:page                     "175" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:864  quran:ayah_text             "قُلِ ٱللَّهُ يُنَجِّيكُم مِّنۡهَا وَمِن كُلِّ كَرۡبٖ ثُمَّ أَنتُمۡ تُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "قل الله ينجيكم منها ومن كل كرب ثم انتم تشركون" ;
