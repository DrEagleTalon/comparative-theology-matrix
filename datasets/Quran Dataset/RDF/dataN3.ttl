        quran:surrahname_no_diacratic  "سورة النحل" .

quran:3202  quran:ayah_text            "إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ" ;
        quran:ayah_text_no_diacratic   "انه هو السميع العليم" ;
