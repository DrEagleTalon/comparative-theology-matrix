        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:3795  quran:ayah_text            "وَجَآءَ مِنۡ أَقۡصَا ٱلۡمَدِينَةِ رَجُلٞ يَسۡعَىٰ قَالَ يَٰقَوۡمِ ٱتَّبِعُواْ ٱلۡمُرۡسَلِينَ" ;
        quran:ayah_text_no_diacratic   "وجاء من اقصا المدينة رجل يسعىٰ قال يٰقوم اتبعوا المرسلين" ;
        quran:ayahnumber               "20" ;
