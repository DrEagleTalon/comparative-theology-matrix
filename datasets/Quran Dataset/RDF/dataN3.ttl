        quran:surrahname_no_diacratic  "سورة هود" .

quran:4717  quran:ayah_text            "وَإِن طَآئِفَتَانِ مِنَ ٱلۡمُؤۡمِنِينَ ٱقۡتَتَلُواْ فَأَصۡلِحُواْ بَيۡنَهُمَاۖ فَإِنۢ بَغَتۡ إِحۡدَىٰهُمَا عَلَى ٱلۡأُخۡرَىٰ فَقَٰتِلُواْ ٱلَّتِي تَبۡغِي حَتَّىٰ تَفِيٓءَ إِلَىٰٓ أَمۡرِ ٱللَّهِۚ فَإِن فَآءَتۡ فَأَصۡلِحُواْ بَيۡنَهُمَا بِٱلۡعَدۡلِ وَأَقۡسِطُوٓاْۖ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُقۡسِطِينَ" ;
        quran:ayah_text_no_diacratic   "وان طائفتان من المؤمنين اقتتلوا فاصلحوا بينهما فان بغت احدىٰهما على الاخرىٰ فقٰتلوا التي تبغي حتىٰ تفيء الىٰ امر الله فان فاءت فاصلحوا بينهما بالعدل واقسطوا ان الله يحب المقسطين" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4717" ;
        quran:page                     "516" ;
        quran:surahname                "سُورَةُ الحُجُرَاتِ" ;
        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

