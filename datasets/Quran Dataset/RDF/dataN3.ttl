        quran:surrahname_no_diacratic  "سورة الروم" .

quran:989  quran:ayah_text             "فَدَلَّىٰهُمَا بِغُرُورٖۚ فَلَمَّا ذَاقَا ٱلشَّجَرَةَ بَدَتۡ لَهُمَا سَوۡءَٰتُهُمَا وَطَفِقَا يَخۡصِفَانِ عَلَيۡهِمَا مِن وَرَقِ ٱلۡجَنَّةِۖ وَنَادَىٰهُمَا رَبُّهُمَآ أَلَمۡ أَنۡهَكُمَا عَن تِلۡكُمَا ٱلشَّجَرَةِ وَأَقُل لَّكُمَآ إِنَّ ٱلشَّيۡطَٰنَ لَكُمَا عَدُوّٞ مُّبِينٞ" ;
        quran:ayah_text_no_diacratic   "فدلىٰهما بغرور فلما ذاقا الشجرة بدت لهما سوءٰتهما وطفقا يخصفان عليهما من ورق الجنة ونادىٰهما ربهما الم انهكما عن تلكما الشجرة واقل لكما ان الشيطٰن لكما عدو مبين" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "989" ;
        quran:page                     "152" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:2425  quran:ayah_text            "أَنِ ٱقۡذِفِيهِ فِي ٱلتَّابُوتِ فَٱقۡذِفِيهِ فِي ٱلۡيَمِّ فَلۡيُلۡقِهِ ٱلۡيَمُّ بِٱلسَّاحِلِ يَأۡخُذۡهُ عَدُوّٞ لِّي وَعَدُوّٞ لَّهُۥۚ وَأَلۡقَيۡتُ عَلَيۡكَ مَحَبَّةٗ مِّنِّي وَلِتُصۡنَعَ عَلَىٰ عَيۡنِيٓ" ;
        quran:ayah_text_no_diacratic   "ان اقذفيه في التابوت فاقذفيه في اليم فليلقه اليم بالساحل ياخذه عدو لي وعدو له والقيت عليك محبة مني ولتصنع علىٰ عيني" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2425" ;
        quran:page                     "314" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

