        quran:surrahname_no_diacratic  "سورة يس" .

quran:4695  quran:ayah_text            "۞لَّقَدۡ رَضِيَ ٱللَّهُ عَنِ ٱلۡمُؤۡمِنِينَ إِذۡ يُبَايِعُونَكَ تَحۡتَ ٱلشَّجَرَةِ فَعَلِمَ مَا فِي قُلُوبِهِمۡ فَأَنزَلَ ٱلسَّكِينَةَ عَلَيۡهِمۡ وَأَثَٰبَهُمۡ فَتۡحٗا قَرِيبٗا" ;
        quran:ayah_text_no_diacratic   "لقد رضي الله عن المؤمنين اذ يبايعونك تحت الشجرة فعلم ما في قلوبهم فانزل السكينة عليهم واثٰبهم فتحا قريبا" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4695" ;
        quran:page                     "513" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:310  quran:ayah_text             "قُل لِّلَّذِينَ كَفَرُواْ سَتُغۡلَبُونَ وَتُحۡشَرُونَ إِلَىٰ جَهَنَّمَۖ وَبِئۡسَ ٱلۡمِهَادُ" ;
        quran:ayah_text_no_diacratic   "قل للذين كفروا ستغلبون وتحشرون الىٰ جهنم وبئس المهاد" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
