        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:921  quran:ayah_text             "وَلَا تَأۡكُلُواْ مِمَّا لَمۡ يُذۡكَرِ ٱسۡمُ ٱللَّهِ عَلَيۡهِ وَإِنَّهُۥ لَفِسۡقٞۗ وَإِنَّ ٱلشَّيَٰطِينَ لَيُوحُونَ إِلَىٰٓ أَوۡلِيَآئِهِمۡ لِيُجَٰدِلُوكُمۡۖ وَإِنۡ أَطَعۡتُمُوهُمۡ إِنَّكُمۡ لَمُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تاكلوا مما لم يذكر اسم الله عليه وانه لفسق وان الشيٰطين ليوحون الىٰ اوليائهم ليجٰدلوكم وان اطعتموهم انكم لمشركون" ;
        quran:ayahnumber               "121" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "921" ;
        quran:page                     "143" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2117  quran:ayah_text            "قُلِ ٱدۡعُواْ ٱلَّذِينَ زَعَمۡتُم مِّن دُونِهِۦ فَلَا يَمۡلِكُونَ كَشۡفَ ٱلضُّرِّ عَنكُمۡ وَلَا تَحۡوِيلًا" ;
        quran:ayah_text_no_diacratic   "قل ادعوا الذين زعمتم من دونه فلا يملكون كشف الضر عنكم ولا تحويلا" ;
