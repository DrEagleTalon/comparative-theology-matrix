quran:3616  quran:ayah_text            "أَشِحَّةً عَلَيۡكُمۡۖ فَإِذَا جَآءَ ٱلۡخَوۡفُ رَأَيۡتَهُمۡ يَنظُرُونَ إِلَيۡكَ تَدُورُ أَعۡيُنُهُمۡ كَٱلَّذِي يُغۡشَىٰ عَلَيۡهِ مِنَ ٱلۡمَوۡتِۖ فَإِذَا ذَهَبَ ٱلۡخَوۡفُ سَلَقُوكُم بِأَلۡسِنَةٍ حِدَادٍ أَشِحَّةً عَلَى ٱلۡخَيۡرِۚ أُوْلَٰٓئِكَ لَمۡ يُؤۡمِنُواْ فَأَحۡبَطَ ٱللَّهُ أَعۡمَٰلَهُمۡۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٗا" ;
        quran:ayah_text_no_diacratic   "اشحة عليكم فاذا جاء الخوف رايتهم ينظرون اليك تدور اعينهم كالذي يغشىٰ عليه من الموت فاذا ذهب الخوف سلقوكم بالسنة حداد اشحة على الخير اولٰئك لم يؤمنوا فاحبط الله اعمٰلهم وكان ذٰلك على الله يسيرا" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "21" ;
        quran:hizb                     "42" ;
        quran:index                    "3616" ;
        quran:page                     "420" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1378  quran:ayah_text            "وَإِذَا مَآ أُنزِلَتۡ سُورَةٞ نَّظَرَ بَعۡضُهُمۡ إِلَىٰ بَعۡضٍ هَلۡ يَرَىٰكُم مِّنۡ أَحَدٖ ثُمَّ ٱنصَرَفُواْۚ صَرَفَ ٱللَّهُ قُلُوبَهُم بِأَنَّهُمۡ قَوۡمٞ لَّا يَفۡقَهُونَ" ;
        quran:ayah_text_no_diacratic   "واذا ما انزلت سورة نظر بعضهم الىٰ بعض هل يرىٰكم من احد ثم انصرفوا صرف الله قلوبهم بانهم قوم لا يفقهون" ;
        quran:ayahnumber               "127" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1378" ;
        quran:page                     "207" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

