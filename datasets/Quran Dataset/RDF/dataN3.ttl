quran:1352  quran:ayah_text            "وَمِمَّنۡ حَوۡلَكُم مِّنَ ٱلۡأَعۡرَابِ مُنَٰفِقُونَۖ وَمِنۡ أَهۡلِ ٱلۡمَدِينَةِ مَرَدُواْ عَلَى ٱلنِّفَاقِ لَا تَعۡلَمُهُمۡۖ نَحۡنُ نَعۡلَمُهُمۡۚ سَنُعَذِّبُهُم مَّرَّتَيۡنِ ثُمَّ يُرَدُّونَ إِلَىٰ عَذَابٍ عَظِيمٖ" ;
        quran:ayah_text_no_diacratic   "وممن حولكم من الاعراب منٰفقون ومن اهل المدينة مردوا على النفاق لا تعلمهم نحن نعلمهم سنعذبهم مرتين ثم يردون الىٰ عذاب عظيم" ;
        quran:ayahnumber               "101" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1352" ;
        quran:page                     "203" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2256  quran:ayah_text            "وَأَمَّا ٱلۡجِدَارُ فَكَانَ لِغُلَٰمَيۡنِ يَتِيمَيۡنِ فِي ٱلۡمَدِينَةِ وَكَانَ تَحۡتَهُۥ كَنزٞ لَّهُمَا وَكَانَ أَبُوهُمَا صَٰلِحٗا فَأَرَادَ رَبُّكَ أَن يَبۡلُغَآ أَشُدَّهُمَا وَيَسۡتَخۡرِجَا كَنزَهُمَا رَحۡمَةٗ مِّن رَّبِّكَۚ وَمَا فَعَلۡتُهُۥ عَنۡ أَمۡرِيۚ ذَٰلِكَ تَأۡوِيلُ مَا لَمۡ تَسۡطِع عَّلَيۡهِ صَبۡرٗا" ;
        quran:ayah_text_no_diacratic   "واما الجدار فكان لغلٰمين يتيمين في المدينة وكان تحته كنز لهما وكان ابوهما صٰلحا فاراد ربك ان يبلغا اشدهما ويستخرجا كنزهما رحمة من ربك وما فعلته عن امري ذٰلك تاويل ما لم تسطع عليه صبرا" ;
        quran:ayahnumber               "82" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2256" ;
        quran:page                     "302" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3400  quran:ayah_text            "أَمۡ حَسِبَ ٱلَّذِينَ يَعۡمَلُونَ ٱلسَّيِّـَٔاتِ أَن يَسۡبِقُونَاۚ سَآءَ مَا يَحۡكُمُونَ" ;
        quran:ayah_text_no_diacratic   "ام حسب الذين يعملون السيات ان يسبقونا ساء ما يحكمون" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3400" ;
        quran:page                     "396" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1162  quran:ayah_text            "أَلَهُمۡ أَرۡجُلٞ يَمۡشُونَ بِهَآۖ أَمۡ لَهُمۡ أَيۡدٖ يَبۡطِشُونَ بِهَآۖ أَمۡ لَهُمۡ أَعۡيُنٞ يُبۡصِرُونَ بِهَآۖ أَمۡ لَهُمۡ ءَاذَانٞ يَسۡمَعُونَ بِهَاۗ قُلِ ٱدۡعُواْ شُرَكَآءَكُمۡ ثُمَّ كِيدُونِ فَلَا تُنظِرُونِ" ;
        quran:ayah_text_no_diacratic   "الهم ارجل يمشون بها ام لهم ايد يبطشون بها ام لهم اعين يبصرون بها ام لهم ءاذان يسمعون بها قل ادعوا شركاءكم ثم كيدون فلا تنظرون" ;
        quran:ayahnumber               "195" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1162" ;
        quran:page                     "175" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:870  quran:ayah_text             "وَذَرِ ٱلَّذِينَ ٱتَّخَذُواْ دِينَهُمۡ لَعِبٗا وَلَهۡوٗا وَغَرَّتۡهُمُ ٱلۡحَيَوٰةُ ٱلدُّنۡيَاۚ وَذَكِّرۡ بِهِۦٓ أَن تُبۡسَلَ نَفۡسُۢ بِمَا كَسَبَتۡ لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ وَلِيّٞ وَلَا شَفِيعٞ وَإِن تَعۡدِلۡ كُلَّ عَدۡلٖ لَّا يُؤۡخَذۡ مِنۡهَآۗ أُوْلَٰٓئِكَ ٱلَّذِينَ أُبۡسِلُواْ بِمَا كَسَبُواْۖ لَهُمۡ شَرَابٞ مِّنۡ حَمِيمٖ وَعَذَابٌ أَلِيمُۢ بِمَا كَانُواْ يَكۡفُرُونَ" ;
        quran:ayah_text_no_diacratic   "وذر الذين اتخذوا دينهم لعبا ولهوا وغرتهم الحيوٰة الدنيا وذكر به ان تبسل نفس بما كسبت ليس لها من دون الله ولي ولا شفيع وان تعدل كل عدل لا يؤخذ منها اولٰئك الذين ابسلوا بما كسبوا لهم شراب من حميم وعذاب اليم بما كانوا يكفرون" ;
        quran:ayahnumber               "70" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "870" ;
        quran:page                     "136" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4304  quran:ayah_text            "قُلۡ إِنَّمَآ أَنَا۠ بَشَرٞ مِّثۡلُكُمۡ يُوحَىٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞ فَٱسۡتَقِيمُوٓاْ إِلَيۡهِ وَٱسۡتَغۡفِرُوهُۗ وَوَيۡلٞ لِّلۡمُشۡرِكِينَ" ;
        quran:ayah_text_no_diacratic   "قل انما انا بشر مثلكم يوحىٰ الي انما الٰهكم الٰه وٰحد فاستقيموا اليه واستغفروه وويل للمشركين" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4304" ;
        quran:page                     "477" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2066  quran:ayah_text            "فَإِذَا جَآءَ وَعۡدُ أُولَىٰهُمَا بَعَثۡنَا عَلَيۡكُمۡ عِبَادٗا لَّنَآ أُوْلِي بَأۡسٖ شَدِيدٖ فَجَاسُواْ خِلَٰلَ ٱلدِّيَارِۚ وَكَانَ وَعۡدٗا مَّفۡعُولٗا" ;
        quran:ayah_text_no_diacratic   "فاذا جاء وعد اولىٰهما بعثنا عليكم عبادا لنا اولي باس شديد فجاسوا خلٰل الديار وكان وعدا مفعولا" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2066" ;
        quran:page                     "282" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:5208  quran:ayah_text            "سَابِقُوٓاْ إِلَىٰ مَغۡفِرَةٖ مِّن رَّبِّكُمۡ وَجَنَّةٍ عَرۡضُهَا كَعَرۡضِ ٱلسَّمَآءِ وَٱلۡأَرۡضِ أُعِدَّتۡ لِلَّذِينَ ءَامَنُواْ بِٱللَّهِ وَرُسُلِهِۦۚ ذَٰلِكَ فَضۡلُ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۚ وَٱللَّهُ ذُو ٱلۡفَضۡلِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "سابقوا الىٰ مغفرة من ربكم وجنة عرضها كعرض السماء والارض اعدت للذين ءامنوا بالله ورسله ذٰلك فضل الله يؤتيه من يشاء والله ذو الفضل العظيم" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "27" ;
        quran:hizb                     "54" ;
        quran:index                    "5208" ;
        quran:page                     "540" ;
        quran:surahname                "سُورَةُ الحَدِيدِ" ;
        quran:surahnumber              "57" ;
        quran:surrahname_no_diacratic  "سورة الحديد" .

