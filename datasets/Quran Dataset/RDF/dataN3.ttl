        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:363  quran:ayah_text             "يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لِمَ تُحَآجُّونَ فِيٓ إِبۡرَٰهِيمَ وَمَآ أُنزِلَتِ ٱلتَّوۡرَىٰةُ وَٱلۡإِنجِيلُ إِلَّا مِنۢ بَعۡدِهِۦٓۚ أَفَلَا تَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "يٰاهل الكتٰب لم تحاجون في ابرٰهيم وما انزلت التورىٰة والانجيل الا من بعده افلا تعقلون" ;
        quran:ayahnumber               "65" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "363" ;
        quran:page                     "58" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5892  quran:ayah_text            "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ" ;
