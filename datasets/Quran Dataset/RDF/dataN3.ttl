        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5370  quran:ayah_text            "وَضَرَبَ ٱللَّهُ مَثَلٗا لِّلَّذِينَ ءَامَنُواْ ٱمۡرَأَتَ فِرۡعَوۡنَ إِذۡ قَالَتۡ رَبِّ ٱبۡنِ لِي عِندَكَ بَيۡتٗا فِي ٱلۡجَنَّةِ وَنَجِّنِي مِن فِرۡعَوۡنَ وَعَمَلِهِۦ وَنَجِّنِي مِنَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "وضرب الله مثلا للذين ءامنوا امرات فرعون اذ قالت رب ابن لي عندك بيتا في الجنة ونجني من فرعون وعمله ونجني من القوم الظٰلمين" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "28" ;
        quran:hizb                     "56" ;
        quran:index                    "5370" ;
        quran:page                     "561" ;
        quran:surahname                "سُورَةُ التَّحۡرِيمِ" ;
        quran:surahnumber              "66" ;
        quran:surrahname_no_diacratic  "سورة التحريم" .

quran:2539  quran:ayah_text            "وَمَا خَلَقۡنَا ٱلسَّمَآءَ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا لَٰعِبِينَ" ;
        quran:ayah_text_no_diacratic   "وما خلقنا السماء والارض وما بينهما لٰعبين" ;
