        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:1297  quran:ayah_text            "۞وَلَوۡ أَرَادُواْ ٱلۡخُرُوجَ لَأَعَدُّواْ لَهُۥ عُدَّةٗ وَلَٰكِن كَرِهَ ٱللَّهُ ٱنۢبِعَاثَهُمۡ فَثَبَّطَهُمۡ وَقِيلَ ٱقۡعُدُواْ مَعَ ٱلۡقَٰعِدِينَ" ;
        quran:ayah_text_no_diacratic   "ولو ارادوا الخروج لاعدوا له عدة ولٰكن كره الله انبعاثهم فثبطهم وقيل اقعدوا مع القٰعدين" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1297" ;
        quran:page                     "194" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2441  quran:ayah_text            "۞مِنۡهَا خَلَقۡنَٰكُمۡ وَفِيهَا نُعِيدُكُمۡ وَمِنۡهَا نُخۡرِجُكُمۡ تَارَةً أُخۡرَىٰ" ;
        quran:ayah_text_no_diacratic   "منها خلقنٰكم وفيها نعيدكم ومنها نخرجكم تارة اخرىٰ" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "16" ;
