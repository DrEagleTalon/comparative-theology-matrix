        quran:surahnumber              "37" ;
        quran:surrahname_no_diacratic  "سورة الصافات" .

quran:1688  quran:ayah_text            "فَلَمَّا جَهَّزَهُم بِجَهَازِهِمۡ جَعَلَ ٱلسِّقَايَةَ فِي رَحۡلِ أَخِيهِ ثُمَّ أَذَّنَ مُؤَذِّنٌ أَيَّتُهَا ٱلۡعِيرُ إِنَّكُمۡ لَسَٰرِقُونَ" ;
        quran:ayah_text_no_diacratic   "فلما جهزهم بجهازهم جعل السقاية في رحل اخيه ثم اذن مؤذن ايتها العير انكم لسٰرقون" ;
        quran:ayahnumber               "70" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1688" ;
        quran:page                     "244" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2832  quran:ayah_text            "أَفَحَسِبۡتُمۡ أَنَّمَا خَلَقۡنَٰكُمۡ عَبَثٗا وَأَنَّكُمۡ إِلَيۡنَا لَا تُرۡجَعُونَ" ;
        quran:ayah_text_no_diacratic   "افحسبتم انما خلقنٰكم عبثا وانكم الينا لا ترجعون" ;
        quran:ayahnumber               "115" ;
        quran:chapter                  "18" ;
