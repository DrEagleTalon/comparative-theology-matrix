        quran:surahnumber              "71" ;
        quran:surrahname_no_diacratic  "سورة نوح" .

quran:4493  quran:ayah_text            "وَهُوَ ٱلَّذِي فِي ٱلسَّمَآءِ إِلَٰهٞ وَفِي ٱلۡأَرۡضِ إِلَٰهٞۚ وَهُوَ ٱلۡحَكِيمُ ٱلۡعَلِيمُ" ;
        quran:ayah_text_no_diacratic   "وهو الذي في السماء الٰه وفي الارض الٰه وهو الحكيم العليم" ;
