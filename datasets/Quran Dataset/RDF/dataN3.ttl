quran:1682  quran:ayah_text            "قَالَ هَلۡ ءَامَنُكُمۡ عَلَيۡهِ إِلَّا كَمَآ أَمِنتُكُمۡ عَلَىٰٓ أَخِيهِ مِن قَبۡلُ فَٱللَّهُ خَيۡرٌ حَٰفِظٗاۖ وَهُوَ أَرۡحَمُ ٱلرَّٰحِمِينَ" ;
        quran:ayah_text_no_diacratic   "قال هل ءامنكم عليه الا كما امنتكم علىٰ اخيه من قبل فالله خير حٰفظا وهو ارحم الرٰحمين" ;
        quran:ayahnumber               "64" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1682" ;
        quran:page                     "243" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:4824  quran:ayah_text            "وَمِن كُلِّ شَيۡءٍ خَلَقۡنَا زَوۡجَيۡنِ لَعَلَّكُمۡ تَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "ومن كل شيء خلقنا زوجين لعلكم تذكرون" ;
