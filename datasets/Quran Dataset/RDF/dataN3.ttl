        quran:surrahname_no_diacratic  "سورة التين" .

quran:3459  quran:ayah_text            "وَلَئِن سَأَلۡتَهُم مَّن نَّزَّلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَحۡيَا بِهِ ٱلۡأَرۡضَ مِنۢ بَعۡدِ مَوۡتِهَا لَيَقُولُنَّ ٱللَّهُۚ قُلِ ٱلۡحَمۡدُ لِلَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "ولئن سالتهم من نزل من السماء ماء فاحيا به الارض من بعد موتها ليقولن الله قل الحمد لله بل اكثرهم لا يعقلون" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3459" ;
        quran:page                     "403" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1461  quran:ayah_text            "وَقَالَ فِرۡعَوۡنُ ٱئۡتُونِي بِكُلِّ سَٰحِرٍ عَلِيمٖ" ;
        quran:ayah_text_no_diacratic   "وقال فرعون ائتوني بكل سٰحر عليم" ;
