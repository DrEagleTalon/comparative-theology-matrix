quran:2023  quran:ayah_text            "وَلَا تَكُونُواْ كَٱلَّتِي نَقَضَتۡ غَزۡلَهَا مِنۢ بَعۡدِ قُوَّةٍ أَنكَٰثٗا تَتَّخِذُونَ أَيۡمَٰنَكُمۡ دَخَلَۢا بَيۡنَكُمۡ أَن تَكُونَ أُمَّةٌ هِيَ أَرۡبَىٰ مِنۡ أُمَّةٍۚ إِنَّمَا يَبۡلُوكُمُ ٱللَّهُ بِهِۦۚ وَلَيُبَيِّنَنَّ لَكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ مَا كُنتُمۡ فِيهِ تَخۡتَلِفُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تكونوا كالتي نقضت غزلها من بعد قوة انكٰثا تتخذون ايمٰنكم دخلا بينكم ان تكون امة هي اربىٰ من امة انما يبلوكم الله به وليبينن لكم يوم القيٰمة ما كنتم فيه تختلفون" ;
        quran:ayahnumber               "92" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2023" ;
        quran:page                     "277" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:397  quran:ayah_text             "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لِمَ تَصُدُّونَ عَن سَبِيلِ ٱللَّهِ مَنۡ ءَامَنَ تَبۡغُونَهَا عِوَجٗا وَأَنتُمۡ شُهَدَآءُۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "قل يٰاهل الكتٰب لم تصدون عن سبيل الله من ءامن تبغونها عوجا وانتم شهداء وما الله بغٰفل عما تعملون" ;
