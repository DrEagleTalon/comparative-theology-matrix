quran:4369  quran:ayah_text            "فَلِذَٰلِكَ فَٱدۡعُۖ وَٱسۡتَقِمۡ كَمَآ أُمِرۡتَۖ وَلَا تَتَّبِعۡ أَهۡوَآءَهُمۡۖ وَقُلۡ ءَامَنتُ بِمَآ أَنزَلَ ٱللَّهُ مِن كِتَٰبٖۖ وَأُمِرۡتُ لِأَعۡدِلَ بَيۡنَكُمُۖ ٱللَّهُ رَبُّنَا وَرَبُّكُمۡۖ لَنَآ أَعۡمَٰلُنَا وَلَكُمۡ أَعۡمَٰلُكُمۡۖ لَا حُجَّةَ بَيۡنَنَا وَبَيۡنَكُمُۖ ٱللَّهُ يَجۡمَعُ بَيۡنَنَاۖ وَإِلَيۡهِ ٱلۡمَصِيرُ" ;
        quran:ayah_text_no_diacratic   "فلذٰلك فادع واستقم كما امرت ولا تتبع اهواءهم وقل ءامنت بما انزل الله من كتٰب وامرت لاعدل بينكم الله ربنا وربكم لنا اعمٰلنا ولكم اعمٰلكم لا حجة بيننا وبينكم الله يجمع بيننا واليه المصير" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4369" ;
        quran:page                     "484" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:2371  quran:ayah_text            "يَوۡمَ نَحۡشُرُ ٱلۡمُتَّقِينَ إِلَى ٱلرَّحۡمَٰنِ وَفۡدٗا" ;
