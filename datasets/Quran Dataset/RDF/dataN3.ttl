quran:857  quran:ayah_text             "قُلۡ إِنِّي عَلَىٰ بَيِّنَةٖ مِّن رَّبِّي وَكَذَّبۡتُم بِهِۦۚ مَا عِندِي مَا تَسۡتَعۡجِلُونَ بِهِۦٓۚ إِنِ ٱلۡحُكۡمُ إِلَّا لِلَّهِۖ يَقُصُّ ٱلۡحَقَّۖ وَهُوَ خَيۡرُ ٱلۡفَٰصِلِينَ" ;
        quran:ayah_text_no_diacratic   "قل اني علىٰ بينة من ربي وكذبتم به ما عندي ما تستعجلون به ان الحكم الا لله يقص الحق وهو خير الفٰصلين" ;
        quran:ayahnumber               "57" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "857" ;
        quran:page                     "134" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:667  quran:ayah_text             "إِنَّ ٱلَّذِينَ كَفَرُواْ وَصَدُّواْ عَن سَبِيلِ ٱللَّهِ قَدۡ ضَلُّواْ ضَلَٰلَۢا بَعِيدًا" ;
        quran:ayah_text_no_diacratic   "ان الذين كفروا وصدوا عن سبيل الله قد ضلوا ضلٰلا بعيدا" ;
