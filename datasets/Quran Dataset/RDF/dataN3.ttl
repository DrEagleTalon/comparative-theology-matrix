quran:2621  quran:ayah_text            "إِنَّكُمۡ وَمَا تَعۡبُدُونَ مِن دُونِ ٱللَّهِ حَصَبُ جَهَنَّمَ أَنتُمۡ لَهَا وَٰرِدُونَ" ;
        quran:ayah_text_no_diacratic   "انكم وما تعبدون من دون الله حصب جهنم انتم لها وٰردون" ;
        quran:ayahnumber               "98" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2621" ;
