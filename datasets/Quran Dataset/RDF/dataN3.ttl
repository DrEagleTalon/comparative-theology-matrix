quran:1556  quran:ayah_text            "قَالَ يَٰقَوۡمِ أَرَءَيۡتُمۡ إِن كُنتُ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّي وَءَاتَىٰنِي مِنۡهُ رَحۡمَةٗ فَمَن يَنصُرُنِي مِنَ ٱللَّهِ إِنۡ عَصَيۡتُهُۥۖ فَمَا تَزِيدُونَنِي غَيۡرَ تَخۡسِيرٖ" ;
        quran:ayah_text_no_diacratic   "قال يٰقوم ارءيتم ان كنت علىٰ بينة من ربي وءاتىٰني منه رحمة فمن ينصرني من الله ان عصيته فما تزيدونني غير تخسير" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1556" ;
        quran:page                     "229" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:5291  quran:ayah_text            "يُرِيدُونَ لِيُطۡفِـُٔواْ نُورَ ٱللَّهِ بِأَفۡوَٰهِهِمۡ وَٱللَّهُ مُتِمُّ نُورِهِۦ وَلَوۡ كَرِهَ ٱلۡكَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "يريدون ليطفوا نور الله بافوٰههم والله متم نوره ولو كره الكٰفرون" ;
        quran:ayahnumber               "8" ;
