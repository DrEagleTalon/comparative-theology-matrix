quran:2750  quran:ayah_text            "وَقَالَ ٱلۡمَلَأُ مِن قَوۡمِهِ ٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِلِقَآءِ ٱلۡأٓخِرَةِ وَأَتۡرَفۡنَٰهُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا مَا هَٰذَآ إِلَّا بَشَرٞ مِّثۡلُكُمۡ يَأۡكُلُ مِمَّا تَأۡكُلُونَ مِنۡهُ وَيَشۡرَبُ مِمَّا تَشۡرَبُونَ" ;
        quran:ayah_text_no_diacratic   "وقال الملا من قومه الذين كفروا وكذبوا بلقاء الاخرة واترفنٰهم في الحيوٰة الدنيا ما هٰذا الا بشر مثلكم ياكل مما تاكلون منه ويشرب مما تشربون" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2750" ;
        quran:page                     "344" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3654  quran:ayah_text            "إِنَّ ٱلَّذِينَ يُؤۡذُونَ ٱللَّهَ وَرَسُولَهُۥ لَعَنَهُمُ ٱللَّهُ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَأَعَدَّ لَهُمۡ عَذَابٗا مُّهِينٗا" ;
        quran:ayah_text_no_diacratic   "ان الذين يؤذون الله ورسوله لعنهم الله في الدنيا والاخرة واعد لهم عذابا مهينا" ;
