        quran:surrahname_no_diacratic  "سورة الانشقاق" .

quran:3239  quran:ayah_text            "ٱذۡهَب بِّكِتَٰبِي هَٰذَا فَأَلۡقِهۡ إِلَيۡهِمۡ ثُمَّ تَوَلَّ عَنۡهُمۡ فَٱنظُرۡ مَاذَا يَرۡجِعُونَ" ;
        quran:ayah_text_no_diacratic   "اذهب بكتٰبي هٰذا فالقه اليهم ثم تول عنهم فانظر ماذا يرجعون" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "19" ;
        quran:hizb                     "38" ;
        quran:index                    "3239" ;
        quran:page                     "379" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:1241  quran:ayah_text            "ٱلۡـَٰٔنَ خَفَّفَ ٱللَّهُ عَنكُمۡ وَعَلِمَ أَنَّ فِيكُمۡ ضَعۡفٗاۚ فَإِن يَكُن مِّنكُم مِّاْئَةٞ صَابِرَةٞ يَغۡلِبُواْ مِاْئَتَيۡنِۚ وَإِن يَكُن مِّنكُمۡ أَلۡفٞ يَغۡلِبُوٓاْ أَلۡفَيۡنِ بِإِذۡنِ ٱللَّهِۗ وَٱللَّهُ مَعَ ٱلصَّٰبِرِينَ" ;
        quran:ayah_text_no_diacratic   "الٰن خفف الله عنكم وعلم ان فيكم ضعفا فان يكن منكم مائة صابرة يغلبوا مائتين وان يكن منكم الف يغلبوا الفين باذن الله والله مع الصٰبرين" ;
        quran:ayahnumber               "66" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1241" ;
        quran:page                     "185" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
