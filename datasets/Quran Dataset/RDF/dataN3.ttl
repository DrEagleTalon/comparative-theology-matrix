quran:1067  quran:ayah_text            "أَوَلَمۡ يَهۡدِ لِلَّذِينَ يَرِثُونَ ٱلۡأَرۡضَ مِنۢ بَعۡدِ أَهۡلِهَآ أَن لَّوۡ نَشَآءُ أَصَبۡنَٰهُم بِذُنُوبِهِمۡۚ وَنَطۡبَعُ عَلَىٰ قُلُوبِهِمۡ فَهُمۡ لَا يَسۡمَعُونَ" ;
        quran:ayah_text_no_diacratic   "اولم يهد للذين يرثون الارض من بعد اهلها ان لو نشاء اصبنٰهم بذنوبهم ونطبع علىٰ قلوبهم فهم لا يسمعون" ;
        quran:ayahnumber               "100" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1067" ;
        quran:page                     "163" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:775  quran:ayah_text             "۞جَعَلَ ٱللَّهُ ٱلۡكَعۡبَةَ ٱلۡبَيۡتَ ٱلۡحَرَامَ قِيَٰمٗا لِّلنَّاسِ وَٱلشَّهۡرَ ٱلۡحَرَامَ وَٱلۡهَدۡيَ وَٱلۡقَلَٰٓئِدَۚ ذَٰلِكَ لِتَعۡلَمُوٓاْ أَنَّ ٱللَّهَ يَعۡلَمُ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ وَأَنَّ ٱللَّهَ بِكُلِّ شَيۡءٍ عَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "جعل الله الكعبة البيت الحرام قيٰما للناس والشهر الحرام والهدي والقلٰئد ذٰلك لتعلموا ان الله يعلم ما في السمٰوٰت وما في الارض وان الله بكل شيء عليم" ;
        quran:ayahnumber               "97" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "775" ;
        quran:page                     "124" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:4209  quran:ayah_text            "وَتَرَى ٱلۡمَلَٰٓئِكَةَ حَآفِّينَ مِنۡ حَوۡلِ ٱلۡعَرۡشِ يُسَبِّحُونَ بِحَمۡدِ رَبِّهِمۡۚ وَقُضِيَ بَيۡنَهُم بِٱلۡحَقِّۚ وَقِيلَ ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "وترى الملٰئكة حافين من حول العرش يسبحون بحمد ربهم وقضي بينهم بالحق وقيل الحمد لله رب العٰلمين" ;
        quran:ayahnumber               "75" ;
        quran:chapter                  "24" ;
        quran:hizb                     "46" ;
        quran:index                    "4209" ;
        quran:page                     "467" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:2211  quran:ayah_text            "قَالَ لَهُۥ صَاحِبُهُۥ وَهُوَ يُحَاوِرُهُۥٓ أَكَفَرۡتَ بِٱلَّذِي خَلَقَكَ مِن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ سَوَّىٰكَ رَجُلٗا" ;
        quran:ayah_text_no_diacratic   "قال له صاحبه وهو يحاوره اكفرت بالذي خلقك من تراب ثم من نطفة ثم سوىٰك رجلا" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "15" ;
