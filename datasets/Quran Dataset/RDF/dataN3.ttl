quran:4312  quran:ayah_text            "إِذۡ جَآءَتۡهُمُ ٱلرُّسُلُ مِنۢ بَيۡنِ أَيۡدِيهِمۡ وَمِنۡ خَلۡفِهِمۡ أَلَّا تَعۡبُدُوٓاْ إِلَّا ٱللَّهَۖ قَالُواْ لَوۡ شَآءَ رَبُّنَا لَأَنزَلَ مَلَٰٓئِكَةٗ فَإِنَّا بِمَآ أُرۡسِلۡتُم بِهِۦ كَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "اذ جاءتهم الرسل من بين ايديهم ومن خلفهم الا تعبدوا الا الله قالوا لو شاء ربنا لانزل ملٰئكة فانا بما ارسلتم به كٰفرون" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4312" ;
        quran:page                     "478" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2074  quran:ayah_text            "وَكُلَّ إِنسَٰنٍ أَلۡزَمۡنَٰهُ طَٰٓئِرَهُۥ فِي عُنُقِهِۦۖ وَنُخۡرِجُ لَهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ كِتَٰبٗا يَلۡقَىٰهُ مَنشُورًا" ;
        quran:ayah_text_no_diacratic   "وكل انسٰن الزمنٰه طٰئره في عنقه ونخرج له يوم القيٰمة كتٰبا يلقىٰه منشورا" ;
        quran:ayahnumber               "13" ;
