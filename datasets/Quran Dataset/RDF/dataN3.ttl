        quran:surahnumber              "72" ;
        quran:surrahname_no_diacratic  "سورة الجن" .

quran:3364  quran:ayah_text            "وَكَمۡ أَهۡلَكۡنَا مِن قَرۡيَةِۭ بَطِرَتۡ مَعِيشَتَهَاۖ فَتِلۡكَ مَسَٰكِنُهُمۡ لَمۡ تُسۡكَن مِّنۢ بَعۡدِهِمۡ إِلَّا قَلِيلٗاۖ وَكُنَّا نَحۡنُ ٱلۡوَٰرِثِينَ" ;
        quran:ayah_text_no_diacratic   "وكم اهلكنا من قرية بطرت معيشتها فتلك مسٰكنهم لم تسكن من بعدهم الا قليلا وكنا نحن الوٰرثين" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3364" ;
        quran:page                     "392" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:2270  quran:ayah_text            "ءَاتُونِي زُبَرَ ٱلۡحَدِيدِۖ حَتَّىٰٓ إِذَا سَاوَىٰ بَيۡنَ ٱلصَّدَفَيۡنِ قَالَ ٱنفُخُواْۖ حَتَّىٰٓ إِذَا جَعَلَهُۥ نَارٗا قَالَ ءَاتُونِيٓ أُفۡرِغۡ عَلَيۡهِ قِطۡرٗا" ;
        quran:ayah_text_no_diacratic   "ءاتوني زبر الحديد حتىٰ اذا ساوىٰ بين الصدفين قال انفخوا حتىٰ اذا جعله نارا قال ءاتوني افرغ عليه قطرا" ;
        quran:ayahnumber               "96" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2270" ;
