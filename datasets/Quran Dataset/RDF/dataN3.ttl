        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1915  quran:ayah_text            "وَمَا خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَآ إِلَّا بِٱلۡحَقِّۗ وَإِنَّ ٱلسَّاعَةَ لَأٓتِيَةٞۖ فَٱصۡفَحِ ٱلصَّفۡحَ ٱلۡجَمِيلَ" ;
        quran:ayah_text_no_diacratic   "وما خلقنا السمٰوٰت والارض وما بينهما الا بالحق وان الساعة لاتية فاصفح الصفح الجميل" ;
