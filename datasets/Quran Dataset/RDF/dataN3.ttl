        quran:surrahname_no_diacratic  "سورة الجن" .

quran:3363  quran:ayah_text            "وَقَالُوٓاْ إِن نَّتَّبِعِ ٱلۡهُدَىٰ مَعَكَ نُتَخَطَّفۡ مِنۡ أَرۡضِنَآۚ أَوَلَمۡ نُمَكِّن لَّهُمۡ حَرَمًا ءَامِنٗا يُجۡبَىٰٓ إِلَيۡهِ ثَمَرَٰتُ كُلِّ شَيۡءٖ رِّزۡقٗا مِّن لَّدُنَّا وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "وقالوا ان نتبع الهدىٰ معك نتخطف من ارضنا اولم نمكن لهم حرما ءامنا يجبىٰ اليه ثمرٰت كل شيء رزقا من لدنا ولٰكن اكثرهم لا يعلمون" ;
        quran:ayahnumber               "57" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3363" ;
        quran:page                     "392" ;
