quran:1659  quran:ayah_text            "يَٰصَٰحِبَيِ ٱلسِّجۡنِ أَمَّآ أَحَدُكُمَا فَيَسۡقِي رَبَّهُۥ خَمۡرٗاۖ وَأَمَّا ٱلۡأٓخَرُ فَيُصۡلَبُ فَتَأۡكُلُ ٱلطَّيۡرُ مِن رَّأۡسِهِۦۚ قُضِيَ ٱلۡأَمۡرُ ٱلَّذِي فِيهِ تَسۡتَفۡتِيَانِ" ;
        quran:ayah_text_no_diacratic   "يٰصٰحبي السجن اما احدكما فيسقي ربه خمرا واما الاخر فيصلب فتاكل الطير من راسه قضي الامر الذي فيه تستفتيان" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "12" ;
        quran:hizb                     "24" ;
        quran:index                    "1659" ;
        quran:page                     "240" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5394  quran:ayah_text            "أَمَّنۡ هَٰذَا ٱلَّذِي يَرۡزُقُكُمۡ إِنۡ أَمۡسَكَ رِزۡقَهُۥۚ بَل لَّجُّواْ فِي عُتُوّٖ وَنُفُورٍ" ;
        quran:ayah_text_no_diacratic   "امن هٰذا الذي يرزقكم ان امسك رزقه بل لجوا في عتو ونفور" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "29" ;
        quran:hizb                     "56" ;
        quran:index                    "5394" ;
        quran:page                     "563" ;
        quran:surahname                "سُورَةُ المُلۡكِ" ;
