quran:4261  quran:ayah_text            "قَالُوٓاْ أَوَلَمۡ تَكُ تَأۡتِيكُمۡ رُسُلُكُم بِٱلۡبَيِّنَٰتِۖ قَالُواْ بَلَىٰۚ قَالُواْ فَٱدۡعُواْۗ وَمَا دُعَٰٓؤُاْ ٱلۡكَٰفِرِينَ إِلَّا فِي ضَلَٰلٍ" ;
        quran:ayah_text_no_diacratic   "قالوا اولم تك تاتيكم رسلكم بالبينٰت قالوا بلىٰ قالوا فادعوا وما دعٰؤا الكٰفرين الا في ضلٰل" ;
        quran:ayahnumber               "50" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4261" ;
        quran:page                     "473" ;
        quran:surahname                "سُورَةُ غَافِرٍ" ;
        quran:surahnumber              "40" ;
        quran:surrahname_no_diacratic  "سورة غافر" .

quran:5165  quran:ayah_text            "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ" ;
