        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:853  quran:ayah_text             "وَكَذَٰلِكَ فَتَنَّا بَعۡضَهُم بِبَعۡضٖ لِّيَقُولُوٓاْ أَهَٰٓؤُلَآءِ مَنَّ ٱللَّهُ عَلَيۡهِم مِّنۢ بَيۡنِنَآۗ أَلَيۡسَ ٱللَّهُ بِأَعۡلَمَ بِٱلشَّٰكِرِينَ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك فتنا بعضهم ببعض ليقولوا اهٰؤلاء من الله عليهم من بيننا اليس الله باعلم بالشٰكرين" ;
        quran:ayahnumber               "53" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "853" ;
        quran:page                     "134" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2049  quran:ayah_text            "وَعَلَى ٱلَّذِينَ هَادُواْ حَرَّمۡنَا مَا قَصَصۡنَا عَلَيۡكَ مِن قَبۡلُۖ وَمَا ظَلَمۡنَٰهُمۡ وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ" ;
        quran:ayah_text_no_diacratic   "وعلى الذين هادوا حرمنا ما قصصنا عليك من قبل وما ظلمنٰهم ولٰكن كانوا انفسهم يظلمون" ;
        quran:ayahnumber               "118" ;
        quran:chapter                  "14" ;
