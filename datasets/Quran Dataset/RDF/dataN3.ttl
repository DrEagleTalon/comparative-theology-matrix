quran:1522  quran:ayah_text            "وَيَٰقَوۡمِ لَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مَالًاۖ إِنۡ أَجۡرِيَ إِلَّا عَلَى ٱللَّهِۚ وَمَآ أَنَا۠ بِطَارِدِ ٱلَّذِينَ ءَامَنُوٓاْۚ إِنَّهُم مُّلَٰقُواْ رَبِّهِمۡ وَلَٰكِنِّيٓ أَرَىٰكُمۡ قَوۡمٗا تَجۡهَلُونَ" ;
        quran:ayah_text_no_diacratic   "ويٰقوم لا اسلكم عليه مالا ان اجري الا على الله وما انا بطارد الذين ءامنوا انهم ملٰقوا ربهم ولٰكني ارىٰكم قوما تجهلون" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "12" ;
        quran:hizb                     "22" ;
        quran:index                    "1522" ;
        quran:page                     "225" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2426  quran:ayah_text            "إِذۡ تَمۡشِيٓ أُخۡتُكَ فَتَقُولُ هَلۡ أَدُلُّكُمۡ عَلَىٰ مَن يَكۡفُلُهُۥۖ فَرَجَعۡنَٰكَ إِلَىٰٓ أُمِّكَ كَيۡ تَقَرَّ عَيۡنُهَا وَلَا تَحۡزَنَۚ وَقَتَلۡتَ نَفۡسٗا فَنَجَّيۡنَٰكَ مِنَ ٱلۡغَمِّ وَفَتَنَّٰكَ فُتُونٗاۚ فَلَبِثۡتَ سِنِينَ فِيٓ أَهۡلِ مَدۡيَنَ ثُمَّ جِئۡتَ عَلَىٰ قَدَرٖ يَٰمُوسَىٰ" ;
        quran:ayah_text_no_diacratic   "اذ تمشي اختك فتقول هل ادلكم علىٰ من يكفله فرجعنٰك الىٰ امك كي تقر عينها ولا تحزن وقتلت نفسا فنجينٰك من الغم وفتنٰك فتونا فلبثت سنين في اهل مدين ثم جئت علىٰ قدر يٰموسىٰ" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2426" ;
        quran:page                     "314" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:6161  quran:ayah_text            "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ" ;
        quran:ayah_text_no_diacratic   "والى الارض كيف سطحت" ;
