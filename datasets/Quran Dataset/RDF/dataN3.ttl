quran:1182  quran:ayah_text            "وَإِذۡ يَعِدُكُمُ ٱللَّهُ إِحۡدَى ٱلطَّآئِفَتَيۡنِ أَنَّهَا لَكُمۡ وَتَوَدُّونَ أَنَّ غَيۡرَ ذَاتِ ٱلشَّوۡكَةِ تَكُونُ لَكُمۡ وَيُرِيدُ ٱللَّهُ أَن يُحِقَّ ٱلۡحَقَّ بِكَلِمَٰتِهِۦ وَيَقۡطَعَ دَابِرَ ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "واذ يعدكم الله احدى الطائفتين انها لكم وتودون ان غير ذات الشوكة تكون لكم ويريد الله ان يحق الحق بكلمٰته ويقطع دابر الكٰفرين" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1182" ;
        quran:page                     "177" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:890  quran:ayah_text             "أُوْلَٰٓئِكَ ٱلَّذِينَ هَدَى ٱللَّهُۖ فَبِهُدَىٰهُمُ ٱقۡتَدِهۡۗ قُل لَّآ أَسۡـَٔلُكُمۡ عَلَيۡهِ أَجۡرًاۖ إِنۡ هُوَ إِلَّا ذِكۡرَىٰ لِلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "اولٰئك الذين هدى الله فبهدىٰهم اقتده قل لا اسلكم عليه اجرا ان هو الا ذكرىٰ للعٰلمين" ;
        quran:ayahnumber               "90" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "890" ;
        quran:page                     "138" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4324  quran:ayah_text            "وَقَالَ ٱلَّذِينَ كَفَرُواْ لَا تَسۡمَعُواْ لِهَٰذَا ٱلۡقُرۡءَانِ وَٱلۡغَوۡاْ فِيهِ لَعَلَّكُمۡ تَغۡلِبُونَ" ;
        quran:ayah_text_no_diacratic   "وقال الذين كفروا لا تسمعوا لهٰذا القرءان والغوا فيه لعلكم تغلبون" ;
