        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1936  quran:ayah_text            "وَٱلۡأَنۡعَٰمَ خَلَقَهَاۖ لَكُمۡ فِيهَا دِفۡءٞ وَمَنَٰفِعُ وَمِنۡهَا تَأۡكُلُونَ" ;
        quran:ayah_text_no_diacratic   "والانعٰم خلقها لكم فيها دفء ومنٰفع ومنها تاكلون" ;
