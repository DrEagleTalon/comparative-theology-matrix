        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1155  quran:ayah_text            "قُل لَّآ أَمۡلِكُ لِنَفۡسِي نَفۡعٗا وَلَا ضَرًّا إِلَّا مَا شَآءَ ٱللَّهُۚ وَلَوۡ كُنتُ أَعۡلَمُ ٱلۡغَيۡبَ لَٱسۡتَكۡثَرۡتُ مِنَ ٱلۡخَيۡرِ وَمَا مَسَّنِيَ ٱلسُّوٓءُۚ إِنۡ أَنَا۠ إِلَّا نَذِيرٞ وَبَشِيرٞ لِّقَوۡمٖ يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "قل لا املك لنفسي نفعا ولا ضرا الا ما شاء الله ولو كنت اعلم الغيب لاستكثرت من الخير وما مسني السوء ان انا الا نذير وبشير لقوم يؤمنون" ;
        quran:ayahnumber               "188" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1155" ;
        quran:page                     "175" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:863  quran:ayah_text             "قُلۡ مَن يُنَجِّيكُم مِّن ظُلُمَٰتِ ٱلۡبَرِّ وَٱلۡبَحۡرِ تَدۡعُونَهُۥ تَضَرُّعٗا وَخُفۡيَةٗ لَّئِنۡ أَنجَىٰنَا مِنۡ هَٰذِهِۦ لَنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ" ;
        quran:ayah_text_no_diacratic   "قل من ينجيكم من ظلمٰت البر والبحر تدعونه تضرعا وخفية لئن انجىٰنا من هٰذه لنكونن من الشٰكرين" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "863" ;
        quran:page                     "135" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2059  quran:ayah_text            "إِنَّ ٱللَّهَ مَعَ ٱلَّذِينَ ٱتَّقَواْ وَّٱلَّذِينَ هُم مُّحۡسِنُونَ" ;
        quran:ayah_text_no_diacratic   "ان الله مع الذين اتقوا والذين هم محسنون" ;
        quran:ayahnumber               "128" ;
        quran:chapter                  "14" ;
