        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1440  quran:ayah_text            "قُلۡ بِفَضۡلِ ٱللَّهِ وَبِرَحۡمَتِهِۦ فَبِذَٰلِكَ فَلۡيَفۡرَحُواْ هُوَ خَيۡرٞ مِّمَّا يَجۡمَعُونَ" ;
        quran:ayah_text_no_diacratic   "قل بفضل الله وبرحمته فبذٰلك فليفرحوا هو خير مما يجمعون" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1440" ;
        quran:page                     "215" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2344  quran:ayah_text            "أُوْلَٰٓئِكَ ٱلَّذِينَ أَنۡعَمَ ٱللَّهُ عَلَيۡهِم مِّنَ ٱلنَّبِيِّـۧنَ مِن ذُرِّيَّةِ ءَادَمَ وَمِمَّنۡ حَمَلۡنَا مَعَ نُوحٖ وَمِن ذُرِّيَّةِ إِبۡرَٰهِيمَ وَإِسۡرَٰٓءِيلَ وَمِمَّنۡ هَدَيۡنَا وَٱجۡتَبَيۡنَآۚ إِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُ ٱلرَّحۡمَٰنِ خَرُّواْۤ سُجَّدٗاۤ وَبُكِيّٗا۩" ;
        quran:ayah_text_no_diacratic   "اولٰئك الذين انعم الله عليهم من النبين من ذرية ءادم وممن حملنا مع نوح ومن ذرية ابرٰهيم واسرٰءيل وممن هدينا واجتبينا اذا تتلىٰ عليهم ءايٰت الرحمٰن خروا سجدا وبكيا" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2344" ;
        quran:page                     "309" ;
        quran:sajdah                   "1" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:3248  quran:ayah_text            "ٱرۡجِعۡ إِلَيۡهِمۡ فَلَنَأۡتِيَنَّهُم بِجُنُودٖ لَّا قِبَلَ لَهُم بِهَا وَلَنُخۡرِجَنَّهُم مِّنۡهَآ أَذِلَّةٗ وَهُمۡ صَٰغِرُونَ" ;
        quran:ayah_text_no_diacratic   "ارجع اليهم فلناتينهم بجنود لا قبل لهم بها ولنخرجنهم منها اذلة وهم صٰغرون" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "19" ;
        quran:hizb                     "38" ;
        quran:index                    "3248" ;
        quran:page                     "380" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:1250  quran:ayah_text            "وَٱلَّذِينَ ءَامَنُواْ مِنۢ بَعۡدُ وَهَاجَرُواْ وَجَٰهَدُواْ مَعَكُمۡ فَأُوْلَٰٓئِكَ مِنكُمۡۚ وَأُوْلُواْ ٱلۡأَرۡحَامِ بَعۡضُهُمۡ أَوۡلَىٰ بِبَعۡضٖ فِي كِتَٰبِ ٱللَّهِۚ إِنَّ ٱللَّهَ بِكُلِّ شَيۡءٍ عَلِيمُۢ" ;
        quran:ayah_text_no_diacratic   "والذين ءامنوا من بعد وهاجروا وجٰهدوا معكم فاولٰئك منكم واولوا الارحام بعضهم اولىٰ ببعض في كتٰب الله ان الله بكل شيء عليم" ;
        quran:ayahnumber               "75" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1250" ;
        quran:page                     "186" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:2154  quran:ayah_text            "أَوۡ يَكُونَ لَكَ بَيۡتٞ مِّن زُخۡرُفٍ أَوۡ تَرۡقَىٰ فِي ٱلسَّمَآءِ وَلَن نُّؤۡمِنَ لِرُقِيِّكَ حَتَّىٰ تُنَزِّلَ عَلَيۡنَا كِتَٰبٗا نَّقۡرَؤُهُۥۗ قُلۡ سُبۡحَانَ رَبِّي هَلۡ كُنتُ إِلَّا بَشَرٗا رَّسُولٗا" ;
        quran:ayah_text_no_diacratic   "او يكون لك بيت من زخرف او ترقىٰ في السماء ولن نؤمن لرقيك حتىٰ تنزل علينا كتٰبا نقرؤه قل سبحان ربي هل كنت الا بشرا رسولا" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2154" ;
        quran:page                     "291" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3058  quran:ayah_text            "أَنتُمۡ وَءَابَآؤُكُمُ ٱلۡأَقۡدَمُونَ" ;
