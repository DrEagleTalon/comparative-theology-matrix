        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:4457  quran:ayah_text            "وَمَا نُرِيهِم مِّنۡ ءَايَةٍ إِلَّا هِيَ أَكۡبَرُ مِنۡ أُخۡتِهَاۖ وَأَخَذۡنَٰهُم بِٱلۡعَذَابِ لَعَلَّهُمۡ يَرۡجِعُونَ" ;
        quran:ayah_text_no_diacratic   "وما نريهم من ءاية الا هي اكبر من اختها واخذنٰهم بالعذاب لعلهم يرجعون" ;
        quran:ayahnumber               "48" ;
