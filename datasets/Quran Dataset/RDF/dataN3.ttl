quran:88  quran:ayah_text              "وَمِنۡهُمۡ أُمِّيُّونَ لَا يَعۡلَمُونَ ٱلۡكِتَٰبَ إِلَّآ أَمَانِيَّ وَإِنۡ هُمۡ إِلَّا يَظُنُّونَ" ;
        quran:ayah_text_no_diacratic   "ومنهم اميون لا يعلمون الكتٰب الا اماني وان هم الا يظنون" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "88" ;
        quran:page                     "12" ;
