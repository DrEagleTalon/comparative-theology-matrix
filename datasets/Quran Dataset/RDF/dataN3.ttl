        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3536  quran:ayah_text            "وَإِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا وَلَّىٰ مُسۡتَكۡبِرٗا كَأَن لَّمۡ يَسۡمَعۡهَا كَأَنَّ فِيٓ أُذُنَيۡهِ وَقۡرٗاۖ فَبَشِّرۡهُ بِعَذَابٍ أَلِيمٍ" ;
        quran:ayah_text_no_diacratic   "واذا تتلىٰ عليه ءايٰتنا ولىٰ مستكبرا كان لم يسمعها كان في اذنيه وقرا فبشره بعذاب اليم" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3536" ;
        quran:page                     "411" ;
        quran:surahname                "سُورَةُ لُقۡمَانَ" ;
        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:1298  quran:ayah_text            "لَوۡ خَرَجُواْ فِيكُم مَّا زَادُوكُمۡ إِلَّا خَبَالٗا وَلَأَوۡضَعُواْ خِلَٰلَكُمۡ يَبۡغُونَكُمُ ٱلۡفِتۡنَةَ وَفِيكُمۡ سَمَّٰعُونَ لَهُمۡۗ وَٱللَّهُ عَلِيمُۢ بِٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "لو خرجوا فيكم ما زادوكم الا خبالا ولاوضعوا خلٰلكم يبغونكم الفتنة وفيكم سمٰعون لهم والله عليم بالظٰلمين" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1298" ;
