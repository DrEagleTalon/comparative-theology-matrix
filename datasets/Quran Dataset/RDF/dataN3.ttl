quran:4377  quran:ayah_text            "ذَٰلِكَ ٱلَّذِي يُبَشِّرُ ٱللَّهُ عِبَادَهُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِۗ قُل لَّآ أَسۡـَٔلُكُمۡ عَلَيۡهِ أَجۡرًا إِلَّا ٱلۡمَوَدَّةَ فِي ٱلۡقُرۡبَىٰۗ وَمَن يَقۡتَرِفۡ حَسَنَةٗ نَّزِدۡ لَهُۥ فِيهَا حُسۡنًاۚ إِنَّ ٱللَّهَ غَفُورٞ شَكُورٌ" ;
        quran:ayah_text_no_diacratic   "ذٰلك الذي يبشر الله عباده الذين ءامنوا وعملوا الصٰلحٰت قل لا اسلكم عليه اجرا الا المودة في القربىٰ ومن يقترف حسنة نزد له فيها حسنا ان الله غفور شكور" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4377" ;
        quran:page                     "486" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

