        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:4664  quran:ayah_text            "فَكَيۡفَ إِذَا تَوَفَّتۡهُمُ ٱلۡمَلَٰٓئِكَةُ يَضۡرِبُونَ وُجُوهَهُمۡ وَأَدۡبَٰرَهُمۡ" ;
        quran:ayah_text_no_diacratic   "فكيف اذا توفتهم الملٰئكة يضربون وجوههم وادبٰرهم" ;
