quran:1963  quran:ayah_text            "ٱلَّذِينَ تَتَوَفَّىٰهُمُ ٱلۡمَلَٰٓئِكَةُ طَيِّبِينَ يَقُولُونَ سَلَٰمٌ عَلَيۡكُمُ ٱدۡخُلُواْ ٱلۡجَنَّةَ بِمَا كُنتُمۡ تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "الذين تتوفىٰهم الملٰئكة طيبين يقولون سلٰم عليكم ادخلوا الجنة بما كنتم تعملون" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1963" ;
        quran:page                     "270" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2867  quran:ayah_text            "قُل لِّلۡمُؤۡمِنِينَ يَغُضُّواْ مِنۡ أَبۡصَٰرِهِمۡ وَيَحۡفَظُواْ فُرُوجَهُمۡۚ ذَٰلِكَ أَزۡكَىٰ لَهُمۡۚ إِنَّ ٱللَّهَ خَبِيرُۢ بِمَا يَصۡنَعُونَ" ;
        quran:ayah_text_no_diacratic   "قل للمؤمنين يغضوا من ابصٰرهم ويحفظوا فروجهم ذٰلك ازكىٰ لهم ان الله خبير بما يصنعون" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2867" ;
        quran:page                     "353" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1773  quran:ayah_text            "وَقَدۡ مَكَرَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَلِلَّهِ ٱلۡمَكۡرُ جَمِيعٗاۖ يَعۡلَمُ مَا تَكۡسِبُ كُلُّ نَفۡسٖۗ وَسَيَعۡلَمُ ٱلۡكُفَّٰرُ لِمَنۡ عُقۡبَى ٱلدَّارِ" ;
        quran:ayah_text_no_diacratic   "وقد مكر الذين من قبلهم فلله المكر جميعا يعلم ما تكسب كل نفس وسيعلم الكفٰر لمن عقبى الدار" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1773" ;
        quran:page                     "254" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:4915  quran:ayah_text            "إِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ لَيُسَمُّونَ ٱلۡمَلَٰٓئِكَةَ تَسۡمِيَةَ ٱلۡأُنثَىٰ" ;
        quran:ayah_text_no_diacratic   "ان الذين لا يؤمنون بالاخرة ليسمون الملٰئكة تسمية الانثىٰ" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "27" ;
        quran:hizb                     "52" ;
        quran:index                    "4915" ;
        quran:page                     "527" ;
        quran:surahname                "سُورَةُ النَّجۡمِ" ;
        quran:surahnumber              "53" ;
        quran:surrahname_no_diacratic  "سورة النجم" .

quran:2677  quran:ayah_text            "ٱلَّذِينَ أُخۡرِجُواْ مِن دِيَٰرِهِم بِغَيۡرِ حَقٍّ إِلَّآ أَن يَقُولُواْ رَبُّنَا ٱللَّهُۗ وَلَوۡلَا دَفۡعُ ٱللَّهِ ٱلنَّاسَ بَعۡضَهُم بِبَعۡضٖ لَّهُدِّمَتۡ صَوَٰمِعُ وَبِيَعٞ وَصَلَوَٰتٞ وَمَسَٰجِدُ يُذۡكَرُ فِيهَا ٱسۡمُ ٱللَّهِ كَثِيرٗاۗ وَلَيَنصُرَنَّ ٱللَّهُ مَن يَنصُرُهُۥٓۚ إِنَّ ٱللَّهَ لَقَوِيٌّ عَزِيزٌ" ;
        quran:ayah_text_no_diacratic   "الذين اخرجوا من ديٰرهم بغير حق الا ان يقولوا ربنا الله ولولا دفع الله الناس بعضهم ببعض لهدمت صوٰمع وبيع وصلوٰت ومسٰجد يذكر فيها اسم الله كثيرا ولينصرن الله من ينصره ان الله لقوي عزيز" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2677" ;
        quran:page                     "337" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:5819  quran:ayah_text            "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ" ;
        quran:ayah_text_no_diacratic   "ويل يومئذ للمكذبين" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "29" ;
        quran:hizb                     "58" ;
        quran:index                    "5819" ;
        quran:page                     "581" ;
        quran:surahname                "سُورَةُ المُرۡسَلَاتِ" ;
        quran:surahnumber              "77" ;
        quran:surrahname_no_diacratic  "سورة المرسلات" .

quran:3821  quran:ayah_text            "وَمَا تَأۡتِيهِم مِّنۡ ءَايَةٖ مِّنۡ ءَايَٰتِ رَبِّهِمۡ إِلَّا كَانُواْ عَنۡهَا مُعۡرِضِينَ" ;
        quran:ayah_text_no_diacratic   "وما تاتيهم من ءاية من ءايٰت ربهم الا كانوا عنها معرضين" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "23" ;
        quran:hizb                     "44" ;
        quran:index                    "3821" ;
        quran:page                     "443" ;
        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:1583  quran:ayah_text            "وَٱسۡتَغۡفِرُواْ رَبَّكُمۡ ثُمَّ تُوبُوٓاْ إِلَيۡهِۚ إِنَّ رَبِّي رَحِيمٞ وَدُودٞ" ;
        quran:ayah_text_no_diacratic   "واستغفروا ربكم ثم توبوا اليه ان ربي رحيم ودود" ;
        quran:ayahnumber               "90" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1583" ;
        quran:page                     "232" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4725  quran:ayah_text            "يَمُنُّونَ عَلَيۡكَ أَنۡ أَسۡلَمُواْۖ قُل لَّا تَمُنُّواْ عَلَيَّ إِسۡلَٰمَكُمۖ بَلِ ٱللَّهُ يَمُنُّ عَلَيۡكُمۡ أَنۡ هَدَىٰكُمۡ لِلۡإِيمَٰنِ إِن كُنتُمۡ صَٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "يمنون عليك ان اسلموا قل لا تمنوا علي اسلٰمكم بل الله يمن عليكم ان هدىٰكم للايمٰن ان كنتم صٰدقين" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4725" ;
        quran:page                     "517" ;
        quran:surahname                "سُورَةُ الحُجُرَاتِ" ;
        quran:surahnumber              "49" ;
        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:2487  quran:ayah_text            "خَٰلِدِينَ فِيهِۖ وَسَآءَ لَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ حِمۡلٗا" ;
        quran:ayah_text_no_diacratic   "خٰلدين فيه وساء لهم يوم القيٰمة حملا" ;
        quran:ayahnumber               "101" ;
        quran:chapter                  "16" ;
