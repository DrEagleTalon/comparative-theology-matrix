quran:85  quran:ayah_text              "۞أَفَتَطۡمَعُونَ أَن يُؤۡمِنُواْ لَكُمۡ وَقَدۡ كَانَ فَرِيقٞ مِّنۡهُمۡ يَسۡمَعُونَ كَلَٰمَ ٱللَّهِ ثُمَّ يُحَرِّفُونَهُۥ مِنۢ بَعۡدِ مَا عَقَلُوهُ وَهُمۡ يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "افتطمعون ان يؤمنوا لكم وقد كان فريق منهم يسمعون كلٰم الله ثم يحرفونه من بعد ما عقلوه وهم يعلمون" ;
        quran:ayahnumber               "75" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "85" ;
        quran:page                     "11" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1216  quran:ayah_text            "۞وَٱعۡلَمُوٓاْ أَنَّمَا غَنِمۡتُم مِّن شَيۡءٖ فَأَنَّ لِلَّهِ خُمُسَهُۥ وَلِلرَّسُولِ وَلِذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِ إِن كُنتُمۡ ءَامَنتُم بِٱللَّهِ وَمَآ أَنزَلۡنَا عَلَىٰ عَبۡدِنَا يَوۡمَ ٱلۡفُرۡقَانِ يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ" ;
        quran:ayah_text_no_diacratic   "واعلموا انما غنمتم من شيء فان لله خمسه وللرسول ولذي القربىٰ واليتٰمىٰ والمسٰكين وابن السبيل ان كنتم ءامنتم بالله وما انزلنا علىٰ عبدنا يوم الفرقان يوم التقى الجمعان والله علىٰ كل شيء قدير" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1216" ;
        quran:page                     "182" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:924  quran:ayah_text             "وَإِذَا جَآءَتۡهُمۡ ءَايَةٞ قَالُواْ لَن نُّؤۡمِنَ حَتَّىٰ نُؤۡتَىٰ مِثۡلَ مَآ أُوتِيَ رُسُلُ ٱللَّهِۘ ٱللَّهُ أَعۡلَمُ حَيۡثُ يَجۡعَلُ رِسَالَتَهُۥۗ سَيُصِيبُ ٱلَّذِينَ أَجۡرَمُواْ صَغَارٌ عِندَ ٱللَّهِ وَعَذَابٞ شَدِيدُۢ بِمَا كَانُواْ يَمۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "واذا جاءتهم ءاية قالوا لن نؤمن حتىٰ نؤتىٰ مثل ما اوتي رسل الله الله اعلم حيث يجعل رسالته سيصيب الذين اجرموا صغار عند الله وعذاب شديد بما كانوا يمكرون" ;
        quran:ayahnumber               "124" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "924" ;
        quran:page                     "143" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1026  quran:ayah_text            "لَقَدۡ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦ فَقَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓ إِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ عَظِيمٖ" ;
        quran:ayah_text_no_diacratic   "لقد ارسلنا نوحا الىٰ قومه فقال يٰقوم اعبدوا الله ما لكم من الٰه غيره اني اخاف عليكم عذاب يوم عظيم" ;
        quran:ayahnumber               "59" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1026" ;
        quran:page                     "158" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:734  quran:ayah_text             "وَمَن يَتَوَلَّ ٱللَّهَ وَرَسُولَهُۥ وَٱلَّذِينَ ءَامَنُواْ فَإِنَّ حِزۡبَ ٱللَّهِ هُمُ ٱلۡغَٰلِبُونَ" ;
        quran:ayah_text_no_diacratic   "ومن يتول الله ورسوله والذين ءامنوا فان حزب الله هم الغٰلبون" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "734" ;
        quran:page                     "117" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:544  quran:ayah_text             "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ أُوتُواْ نَصِيبٗا مِّنَ ٱلۡكِتَٰبِ يَشۡتَرُونَ ٱلضَّلَٰلَةَ وَيُرِيدُونَ أَن تَضِلُّواْ ٱلسَّبِيلَ" ;
        quran:ayah_text_no_diacratic   "الم تر الى الذين اوتوا نصيبا من الكتٰب يشترون الضلٰلة ويريدون ان تضلوا السبيل" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "544" ;
        quran:page                     "85" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:354  quran:ayah_text             "فَأَمَّا ٱلَّذِينَ كَفَرُواْ فَأُعَذِّبُهُمۡ عَذَابٗا شَدِيدٗا فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَمَا لَهُم مِّن نَّٰصِرِينَ" ;
        quran:ayah_text_no_diacratic   "فاما الذين كفروا فاعذبهم عذابا شديدا في الدنيا والاخرة وما لهم من نٰصرين" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "354" ;
        quran:page                     "57" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

