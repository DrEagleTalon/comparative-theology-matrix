quran:95  quran:ayah_text              "ثُمَّ أَنتُمۡ هَٰٓؤُلَآءِ تَقۡتُلُونَ أَنفُسَكُمۡ وَتُخۡرِجُونَ فَرِيقٗا مِّنكُم مِّن دِيَٰرِهِمۡ تَظَٰهَرُونَ عَلَيۡهِم بِٱلۡإِثۡمِ وَٱلۡعُدۡوَٰنِ وَإِن يَأۡتُوكُمۡ أُسَٰرَىٰ تُفَٰدُوهُمۡ وَهُوَ مُحَرَّمٌ عَلَيۡكُمۡ إِخۡرَاجُهُمۡۚ أَفَتُؤۡمِنُونَ بِبَعۡضِ ٱلۡكِتَٰبِ وَتَكۡفُرُونَ بِبَعۡضٖۚ فَمَا جَزَآءُ مَن يَفۡعَلُ ذَٰلِكَ مِنكُمۡ إِلَّا خِزۡيٞ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَيَوۡمَ ٱلۡقِيَٰمَةِ يُرَدُّونَ إِلَىٰٓ أَشَدِّ ٱلۡعَذَابِۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ثم انتم هٰؤلاء تقتلون انفسكم وتخرجون فريقا منكم من ديٰرهم تظٰهرون عليهم بالاثم والعدوٰن وان ياتوكم اسٰرىٰ تفٰدوهم وهو محرم عليكم اخراجهم افتؤمنون ببعض الكتٰب وتكفرون ببعض فما جزاء من يفعل ذٰلك منكم الا خزي في الحيوٰة الدنيا ويوم القيٰمة يردون الىٰ اشد العذاب وما الله بغٰفل عما تعملون" ;
        quran:ayahnumber               "85" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "95" ;
        quran:page                     "13" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1226  quran:ayah_text            "ذَٰلِكَ بِمَا قَدَّمَتۡ أَيۡدِيكُمۡ وَأَنَّ ٱللَّهَ لَيۡسَ بِظَلَّٰمٖ لِّلۡعَبِيدِ" ;
        quran:ayah_text_no_diacratic   "ذٰلك بما قدمت ايديكم وان الله ليس بظلٰم للعبيد" ;
        quran:ayahnumber               "51" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1226" ;
        quran:page                     "183" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:934  quran:ayah_text             "إِنَّ مَا تُوعَدُونَ لَأٓتٖۖ وَمَآ أَنتُم بِمُعۡجِزِينَ" ;
        quran:ayah_text_no_diacratic   "ان ما توعدون لات وما انتم بمعجزين" ;
        quran:ayahnumber               "134" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "934" ;
        quran:page                     "145" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1036  quran:ayah_text            "أَوَعَجِبۡتُمۡ أَن جَآءَكُمۡ ذِكۡرٞ مِّن رَّبِّكُمۡ عَلَىٰ رَجُلٖ مِّنكُمۡ لِيُنذِرَكُمۡۚ وَٱذۡكُرُوٓاْ إِذۡ جَعَلَكُمۡ خُلَفَآءَ مِنۢ بَعۡدِ قَوۡمِ نُوحٖ وَزَادَكُمۡ فِي ٱلۡخَلۡقِ بَصۜۡطَةٗۖ فَٱذۡكُرُوٓاْ ءَالَآءَ ٱللَّهِ لَعَلَّكُمۡ تُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "اوعجبتم ان جاءكم ذكر من ربكم علىٰ رجل منكم لينذركم واذكروا اذ جعلكم خلفاء من بعد قوم نوح وزادكم في الخلق بصطة فاذكروا ءالاء الله لعلكم تفلحون" ;
        quran:ayahnumber               "69" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1036" ;
        quran:page                     "159" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:744  quran:ayah_text             "وَلَوۡ أَنَّهُمۡ أَقَامُواْ ٱلتَّوۡرَىٰةَ وَٱلۡإِنجِيلَ وَمَآ أُنزِلَ إِلَيۡهِم مِّن رَّبِّهِمۡ لَأَكَلُواْ مِن فَوۡقِهِمۡ وَمِن تَحۡتِ أَرۡجُلِهِمۚ مِّنۡهُمۡ أُمَّةٞ مُّقۡتَصِدَةٞۖ وَكَثِيرٞ مِّنۡهُمۡ سَآءَ مَا يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ولو انهم اقاموا التورىٰة والانجيل وما انزل اليهم من ربهم لاكلوا من فوقهم ومن تحت ارجلهم منهم امة مقتصدة وكثير منهم ساء ما يعملون" ;
        quran:ayahnumber               "66" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "744" ;
        quran:page                     "119" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:554  quran:ayah_text             "أَمۡ يَحۡسُدُونَ ٱلنَّاسَ عَلَىٰ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضۡلِهِۦۖ فَقَدۡ ءَاتَيۡنَآ ءَالَ إِبۡرَٰهِيمَ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَءَاتَيۡنَٰهُم مُّلۡكًا عَظِيمٗا" ;
        quran:ayah_text_no_diacratic   "ام يحسدون الناس علىٰ ما ءاتىٰهم الله من فضله فقد ءاتينا ءال ابرٰهيم الكتٰب والحكمة وءاتينٰهم ملكا عظيما" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "554" ;
        quran:page                     "87" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:364  quran:ayah_text             "هَٰٓأَنتُمۡ هَٰٓؤُلَآءِ حَٰجَجۡتُمۡ فِيمَا لَكُم بِهِۦ عِلۡمٞ فَلِمَ تُحَآجُّونَ فِيمَا لَيۡسَ لَكُم بِهِۦ عِلۡمٞۚ وَٱللَّهُ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "هٰانتم هٰؤلاء حٰججتم فيما لكم به علم فلم تحاجون فيما ليس لكم به علم والله يعلم وانتم لا تعلمون" ;
        quran:ayahnumber               "66" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "364" ;
        quran:page                     "58" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5893  quran:ayah_text            "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ" ;
        quran:ayah_text_no_diacratic   "فاخذه الله نكال الاخرة والاولىٰ" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "30" ;
        quran:hizb                     "58" ;
        quran:index                    "5893" ;
        quran:page                     "584" ;
        quran:surahname                "سُورَةُ النَّازِعَاتِ" ;
        quran:surahnumber              "79" ;
        quran:surrahname_no_diacratic  "سورة النازعات" .

quran:174  quran:ayah_text             "إِنَّ فِي خَلۡقِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ وَٱلۡفُلۡكِ ٱلَّتِي تَجۡرِي فِي ٱلۡبَحۡرِ بِمَا يَنفَعُ ٱلنَّاسَ وَمَآ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَآءِ مِن مَّآءٖ فَأَحۡيَا بِهِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٖ وَتَصۡرِيفِ ٱلرِّيَٰحِ وَٱلسَّحَابِ ٱلۡمُسَخَّرِ بَيۡنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِ لَأٓيَٰتٖ لِّقَوۡمٖ يَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "ان في خلق السمٰوٰت والارض واختلٰف اليل والنهار والفلك التي تجري في البحر بما ينفع الناس وما انزل الله من السماء من ماء فاحيا به الارض بعد موتها وبث فيها من كل دابة وتصريف الريٰح والسحاب المسخر بين السماء والارض لايٰت لقوم يعقلون" ;
        quran:ayahnumber               "164" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "174" ;
        quran:page                     "25" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1968  quran:ayah_text            "إِن تَحۡرِصۡ عَلَىٰ هُدَىٰهُمۡ فَإِنَّ ٱللَّهَ لَا يَهۡدِي مَن يُضِلُّۖ وَمَا لَهُم مِّن نَّٰصِرِينَ" ;
        quran:ayah_text_no_diacratic   "ان تحرص علىٰ هدىٰهم فان الله لا يهدي من يضل وما لهم من نٰصرين" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1968" ;
        quran:page                     "271" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:1778  quran:ayah_text            "ٱللَّهِ ٱلَّذِي لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ وَوَيۡلٞ لِّلۡكَٰفِرِينَ مِنۡ عَذَابٖ شَدِيدٍ" ;
        quran:ayah_text_no_diacratic   "الله الذي له ما في السمٰوٰت وما في الارض وويل للكٰفرين من عذاب شديد" ;
        quran:ayahnumber               "2" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1778" ;
        quran:page                     "255" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:2922  quran:ayah_text            "فَقَدۡ كَذَّبُوكُم بِمَا تَقُولُونَ فَمَا تَسۡتَطِيعُونَ صَرۡفٗا وَلَا نَصۡرٗاۚ وَمَن يَظۡلِم مِّنكُمۡ نُذِقۡهُ عَذَابٗا كَبِيرٗا" ;
        quran:ayah_text_no_diacratic   "فقد كذبوكم بما تقولون فما تستطيعون صرفا ولا نصرا ومن يظلم منكم نذقه عذابا كبيرا" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "18" ;
        quran:hizb                     "36" ;
        quran:index                    "2922" ;
        quran:page                     "361" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3826  quran:ayah_text            "وَنُفِخَ فِي ٱلصُّورِ فَإِذَا هُم مِّنَ ٱلۡأَجۡدَاثِ إِلَىٰ رَبِّهِمۡ يَنسِلُونَ" ;
        quran:ayah_text_no_diacratic   "ونفخ في الصور فاذا هم من الاجداث الىٰ ربهم ينسلون" ;
        quran:ayahnumber               "51" ;
        quran:chapter                  "23" ;
