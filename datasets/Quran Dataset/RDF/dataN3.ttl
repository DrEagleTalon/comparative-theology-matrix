quran:4080  quran:ayah_text            "فَسَخَّرۡنَا لَهُ ٱلرِّيحَ تَجۡرِي بِأَمۡرِهِۦ رُخَآءً حَيۡثُ أَصَابَ" ;
        quran:ayah_text_no_diacratic   "فسخرنا له الريح تجري بامره رخاء حيث اصاب" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
        quran:index                    "4080" ;
        quran:page                     "455" ;
        quran:surahname                "سُورَةُ صٓ" ;
        quran:surahnumber              "38" ;
        quran:surrahname_no_diacratic  "سورة ص" .

quran:1249  quran:ayah_text            "وَٱلَّذِينَ ءَامَنُواْ وَهَاجَرُواْ وَجَٰهَدُواْ فِي سَبِيلِ ٱللَّهِ وَٱلَّذِينَ ءَاوَواْ وَّنَصَرُوٓاْ أُوْلَٰٓئِكَ هُمُ ٱلۡمُؤۡمِنُونَ حَقّٗاۚ لَّهُم مَّغۡفِرَةٞ وَرِزۡقٞ كَرِيمٞ" ;
        quran:ayah_text_no_diacratic   "والذين ءامنوا وهاجروا وجٰهدوا في سبيل الله والذين ءاووا ونصروا اولٰئك هم المؤمنون حقا لهم مغفرة ورزق كريم" ;
        quran:ayahnumber               "74" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1249" ;
        quran:page                     "186" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:957  quran:ayah_text             "أَوۡ تَقُولُواْ لَوۡ أَنَّآ أُنزِلَ عَلَيۡنَا ٱلۡكِتَٰبُ لَكُنَّآ أَهۡدَىٰ مِنۡهُمۡۚ فَقَدۡ جَآءَكُم بَيِّنَةٞ مِّن رَّبِّكُمۡ وَهُدٗى وَرَحۡمَةٞۚ فَمَنۡ أَظۡلَمُ مِمَّن كَذَّبَ بِـَٔايَٰتِ ٱللَّهِ وَصَدَفَ عَنۡهَاۗ سَنَجۡزِي ٱلَّذِينَ يَصۡدِفُونَ عَنۡ ءَايَٰتِنَا سُوٓءَ ٱلۡعَذَابِ بِمَا كَانُواْ يَصۡدِفُونَ" ;
        quran:ayah_text_no_diacratic   "او تقولوا لو انا انزل علينا الكتٰب لكنا اهدىٰ منهم فقد جاءكم بينة من ربكم وهدى ورحمة فمن اظلم ممن كذب بايٰت الله وصدف عنها سنجزي الذين يصدفون عن ءايٰتنا سوء العذاب بما كانوا يصدفون" ;
        quran:ayahnumber               "157" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "957" ;
        quran:page                     "149" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1059  quran:ayah_text            "ٱلَّذِينَ كَذَّبُواْ شُعَيۡبٗا كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَاۚ ٱلَّذِينَ كَذَّبُواْ شُعَيۡبٗا كَانُواْ هُمُ ٱلۡخَٰسِرِينَ" ;
        quran:ayah_text_no_diacratic   "الذين كذبوا شعيبا كان لم يغنوا فيها الذين كذبوا شعيبا كانوا هم الخٰسرين" ;
        quran:ayahnumber               "92" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1059" ;
        quran:page                     "162" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:767  quran:ayah_text             "لَا يُؤَاخِذُكُمُ ٱللَّهُ بِٱللَّغۡوِ فِيٓ أَيۡمَٰنِكُمۡ وَلَٰكِن يُؤَاخِذُكُم بِمَا عَقَّدتُّمُ ٱلۡأَيۡمَٰنَۖ فَكَفَّٰرَتُهُۥٓ إِطۡعَامُ عَشَرَةِ مَسَٰكِينَ مِنۡ أَوۡسَطِ مَا تُطۡعِمُونَ أَهۡلِيكُمۡ أَوۡ كِسۡوَتُهُمۡ أَوۡ تَحۡرِيرُ رَقَبَةٖۖ فَمَن لَّمۡ يَجِدۡ فَصِيَامُ ثَلَٰثَةِ أَيَّامٖۚ ذَٰلِكَ كَفَّٰرَةُ أَيۡمَٰنِكُمۡ إِذَا حَلَفۡتُمۡۚ وَٱحۡفَظُوٓاْ أَيۡمَٰنَكُمۡۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمۡ ءَايَٰتِهِۦ لَعَلَّكُمۡ تَشۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "لا يؤاخذكم الله باللغو في ايمٰنكم ولٰكن يؤاخذكم بما عقدتم الايمٰن فكفٰرته اطعام عشرة مسٰكين من اوسط ما تطعمون اهليكم او كسوتهم او تحرير رقبة فمن لم يجد فصيام ثلٰثة ايام ذٰلك كفٰرة ايمٰنكم اذا حلفتم واحفظوا ايمٰنكم كذٰلك يبين الله لكم ءايٰته لعلكم تشكرون" ;
        quran:ayahnumber               "89" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "767" ;
        quran:page                     "122" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2203  quran:ayah_text            "وَقُلِ ٱلۡحَقُّ مِن رَّبِّكُمۡۖ فَمَن شَآءَ فَلۡيُؤۡمِن وَمَن شَآءَ فَلۡيَكۡفُرۡۚ إِنَّآ أَعۡتَدۡنَا لِلظَّٰلِمِينَ نَارًا أَحَاطَ بِهِمۡ سُرَادِقُهَاۚ وَإِن يَسۡتَغِيثُواْ يُغَاثُواْ بِمَآءٖ كَٱلۡمُهۡلِ يَشۡوِي ٱلۡوُجُوهَۚ بِئۡسَ ٱلشَّرَابُ وَسَآءَتۡ مُرۡتَفَقًا" ;
        quran:ayah_text_no_diacratic   "وقل الحق من ربكم فمن شاء فليؤمن ومن شاء فليكفر انا اعتدنا للظٰلمين نارا احاط بهم سرادقها وان يستغيثوا يغاثوا بماء كالمهل يشوي الوجوه بئس الشراب وساءت مرتفقا" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2203" ;
        quran:page                     "297" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3107  quran:ayah_text            "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ" ;
        quran:ayah_text_no_diacratic   "اني لكم رسول امين" ;
        quran:ayahnumber               "125" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3107" ;
        quran:page                     "372" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:577  quran:ayah_text             "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ قِيلَ لَهُمۡ كُفُّوٓاْ أَيۡدِيَكُمۡ وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ فَلَمَّا كُتِبَ عَلَيۡهِمُ ٱلۡقِتَالُ إِذَا فَرِيقٞ مِّنۡهُمۡ يَخۡشَوۡنَ ٱلنَّاسَ كَخَشۡيَةِ ٱللَّهِ أَوۡ أَشَدَّ خَشۡيَةٗۚ وَقَالُواْ رَبَّنَا لِمَ كَتَبۡتَ عَلَيۡنَا ٱلۡقِتَالَ لَوۡلَآ أَخَّرۡتَنَآ إِلَىٰٓ أَجَلٖ قَرِيبٖۗ قُلۡ مَتَٰعُ ٱلدُّنۡيَا قَلِيلٞ وَٱلۡأٓخِرَةُ خَيۡرٞ لِّمَنِ ٱتَّقَىٰ وَلَا تُظۡلَمُونَ فَتِيلًا" ;
        quran:ayah_text_no_diacratic   "الم تر الى الذين قيل لهم كفوا ايديكم واقيموا الصلوٰة وءاتوا الزكوٰة فلما كتب عليهم القتال اذا فريق منهم يخشون الناس كخشية الله او اشد خشية وقالوا ربنا لم كتبت علينا القتال لولا اخرتنا الىٰ اجل قريب قل متٰع الدنيا قليل والاخرة خير لمن اتقىٰ ولا تظلمون فتيلا" ;
        quran:ayahnumber               "77" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "577" ;
        quran:page                     "90" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2013  quran:ayah_text            "فَإِن تَوَلَّوۡاْ فَإِنَّمَا عَلَيۡكَ ٱلۡبَلَٰغُ ٱلۡمُبِينُ" ;
        quran:ayah_text_no_diacratic   "فان تولوا فانما عليك البلٰغ المبين" ;
        quran:ayahnumber               "82" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2013" ;
        quran:page                     "276" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:387  quran:ayah_text             "إِلَّا ٱلَّذِينَ تَابُواْ مِنۢ بَعۡدِ ذَٰلِكَ وَأَصۡلَحُواْ فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ" ;
        quran:ayah_text_no_diacratic   "الا الذين تابوا من بعد ذٰلك واصلحوا فان الله غفور رحيم" ;
        quran:ayahnumber               "89" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "387" ;
        quran:page                     "61" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:197  quran:ayah_text             "أُحِلَّ لَكُمۡ لَيۡلَةَ ٱلصِّيَامِ ٱلرَّفَثُ إِلَىٰ نِسَآئِكُمۡۚ هُنَّ لِبَاسٞ لَّكُمۡ وَأَنتُمۡ لِبَاسٞ لَّهُنَّۗ عَلِمَ ٱللَّهُ أَنَّكُمۡ كُنتُمۡ تَخۡتَانُونَ أَنفُسَكُمۡ فَتَابَ عَلَيۡكُمۡ وَعَفَا عَنكُمۡۖ فَٱلۡـَٰٔنَ بَٰشِرُوهُنَّ وَٱبۡتَغُواْ مَا كَتَبَ ٱللَّهُ لَكُمۡۚ وَكُلُواْ وَٱشۡرَبُواْ حَتَّىٰ يَتَبَيَّنَ لَكُمُ ٱلۡخَيۡطُ ٱلۡأَبۡيَضُ مِنَ ٱلۡخَيۡطِ ٱلۡأَسۡوَدِ مِنَ ٱلۡفَجۡرِۖ ثُمَّ أَتِمُّواْ ٱلصِّيَامَ إِلَى ٱلَّيۡلِۚ وَلَا تُبَٰشِرُوهُنَّ وَأَنتُمۡ عَٰكِفُونَ فِي ٱلۡمَسَٰجِدِۗ تِلۡكَ حُدُودُ ٱللَّهِ فَلَا تَقۡرَبُوهَاۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ ءَايَٰتِهِۦ لِلنَّاسِ لَعَلَّهُمۡ يَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "احل لكم ليلة الصيام الرفث الىٰ نسائكم هن لباس لكم وانتم لباس لهن علم الله انكم كنتم تختانون انفسكم فتاب عليكم وعفا عنكم فالٰن بٰشروهن وابتغوا ما كتب الله لكم وكلوا واشربوا حتىٰ يتبين لكم الخيط الابيض من الخيط الاسود من الفجر ثم اتموا الصيام الى اليل ولا تبٰشروهن وانتم عٰكفون في المسٰجد تلك حدود الله فلا تقربوها كذٰلك يبين الله ءايٰته للناس لعلهم يتقون" ;
        quran:ayahnumber               "187" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "197" ;
        quran:page                     "29" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2945  quran:ayah_text            "إِن كَادَ لَيُضِلُّنَا عَنۡ ءَالِهَتِنَا لَوۡلَآ أَن صَبَرۡنَا عَلَيۡهَاۚ وَسَوۡفَ يَعۡلَمُونَ حِينَ يَرَوۡنَ ٱلۡعَذَابَ مَنۡ أَضَلُّ سَبِيلًا" ;
        quran:ayah_text_no_diacratic   "ان كاد ليضلنا عن ءالهتنا لولا ان صبرنا عليها وسوف يعلمون حين يرون العذاب من اضل سبيلا" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "2945" ;
        quran:page                     "363" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3849  quran:ayah_text            "وَٱتَّخَذُواْ مِن دُونِ ٱللَّهِ ءَالِهَةٗ لَّعَلَّهُمۡ يُنصَرُونَ" ;
        quran:ayah_text_no_diacratic   "واتخذوا من دون الله ءالهة لعلهم ينصرون" ;
        quran:ayahnumber               "74" ;
        quran:chapter                  "23" ;
        quran:hizb                     "44" ;
        quran:index                    "3849" ;
        quran:page                     "445" ;
        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:1851  quran:ayah_text            "وَإِن مِّن شَيۡءٍ إِلَّا عِندَنَا خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ إِلَّا بِقَدَرٖ مَّعۡلُومٖ" ;
        quran:ayah_text_no_diacratic   "وان من شيء الا عندنا خزائنه وما ننزله الا بقدر معلوم" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1851" ;
        quran:page                     "263" ;
        quran:surahname                "سُورَةُ الحِجۡرِ" ;
        quran:surahnumber              "15" ;
        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:2755  quran:ayah_text            "إِنۡ هُوَ إِلَّا رَجُلٌ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبٗا وَمَا نَحۡنُ لَهُۥ بِمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "ان هو الا رجل افترىٰ على الله كذبا وما نحن له بمؤمنين" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2755" ;
        quran:page                     "344" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3659  quran:ayah_text            "سُنَّةَ ٱللَّهِ فِي ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلُۖ وَلَن تَجِدَ لِسُنَّةِ ٱللَّهِ تَبۡدِيلٗا" ;
        quran:ayah_text_no_diacratic   "سنة الله في الذين خلوا من قبل ولن تجد لسنة الله تبديلا" ;
        quran:ayahnumber               "62" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3659" ;
        quran:page                     "426" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1661  quran:ayah_text            "وَقَالَ ٱلۡمَلِكُ إِنِّيٓ أَرَىٰ سَبۡعَ بَقَرَٰتٖ سِمَانٖ يَأۡكُلُهُنَّ سَبۡعٌ عِجَافٞ وَسَبۡعَ سُنۢبُلَٰتٍ خُضۡرٖ وَأُخَرَ يَابِسَٰتٖۖ يَٰٓأَيُّهَا ٱلۡمَلَأُ أَفۡتُونِي فِي رُءۡيَٰيَ إِن كُنتُمۡ لِلرُّءۡيَا تَعۡبُرُونَ" ;
        quran:ayah_text_no_diacratic   "وقال الملك اني ارىٰ سبع بقرٰت سمان ياكلهن سبع عجاف وسبع سنبلٰت خضر واخر يابسٰت يٰايها الملا افتوني في رءيٰي ان كنتم للرءيا تعبرون" ;
