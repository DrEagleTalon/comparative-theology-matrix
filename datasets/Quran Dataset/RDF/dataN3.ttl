        quran:index                    "1841" ;
        quran:page                     "262" ;
        quran:surahname                "سُورَةُ الحِجۡرِ" ;
        quran:surahnumber              "15" ;
        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:2745  quran:ayah_text            "فَإِذَا ٱسۡتَوَيۡتَ أَنتَ وَمَن مَّعَكَ عَلَى ٱلۡفُلۡكِ فَقُلِ ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي نَجَّىٰنَا مِنَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "فاذا استويت انت ومن معك على الفلك فقل الحمد لله الذي نجىٰنا من القوم الظٰلمين" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2745" ;
        quran:page                     "344" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:1651  quran:ayah_text            "قَالَ رَبِّ ٱلسِّجۡنُ أَحَبُّ إِلَيَّ مِمَّا يَدۡعُونَنِيٓ إِلَيۡهِۖ وَإِلَّا تَصۡرِفۡ عَنِّي كَيۡدَهُنَّ أَصۡبُ إِلَيۡهِنَّ وَأَكُن مِّنَ ٱلۡجَٰهِلِينَ" ;
        quran:ayah_text_no_diacratic   "قال رب السجن احب الي مما يدعونني اليه والا تصرف عني كيدهن اصب اليهن واكن من الجٰهلين" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "12" ;
        quran:hizb                     "24" ;
        quran:index                    "1651" ;
        quran:page                     "239" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:3649  quran:ayah_text            "لَّا يَحِلُّ لَكَ ٱلنِّسَآءُ مِنۢ بَعۡدُ وَلَآ أَن تَبَدَّلَ بِهِنَّ مِنۡ أَزۡوَٰجٖ وَلَوۡ أَعۡجَبَكَ حُسۡنُهُنَّ إِلَّا مَا مَلَكَتۡ يَمِينُكَۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ رَّقِيبٗا" ;
        quran:ayah_text_no_diacratic   "لا يحل لك النساء من بعد ولا ان تبدل بهن من ازوٰج ولو اعجبك حسنهن الا ما ملكت يمينك وكان الله علىٰ كل شيء رقيبا" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3649" ;
        quran:page                     "425" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:2555  quran:ayah_text            "وَجَعَلۡنَا ٱلسَّمَآءَ سَقۡفٗا مَّحۡفُوظٗاۖ وَهُمۡ عَنۡ ءَايَٰتِهَا مُعۡرِضُونَ" ;
        quran:ayah_text_no_diacratic   "وجعلنا السماء سقفا محفوظا وهم عن ءايٰتها معرضون" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2555" ;
