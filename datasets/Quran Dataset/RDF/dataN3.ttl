quran:232  quran:ayah_text             "وَيَسۡـَٔلُونَكَ عَنِ ٱلۡمَحِيضِۖ قُلۡ هُوَ أَذٗى فَٱعۡتَزِلُواْ ٱلنِّسَآءَ فِي ٱلۡمَحِيضِ وَلَا تَقۡرَبُوهُنَّ حَتَّىٰ يَطۡهُرۡنَۖ فَإِذَا تَطَهَّرۡنَ فَأۡتُوهُنَّ مِنۡ حَيۡثُ أَمَرَكُمُ ٱللَّهُۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلتَّوَّٰبِينَ وَيُحِبُّ ٱلۡمُتَطَهِّرِينَ" ;
        quran:ayah_text_no_diacratic   "ويسلونك عن المحيض قل هو اذى فاعتزلوا النساء في المحيض ولا تقربوهن حتىٰ يطهرن فاذا تطهرن فاتوهن من حيث امركم الله ان الله يحب التوٰبين ويحب المتطهرين" ;
        quran:ayahnumber               "222" ;
        quran:chapter                  "2" ;
        quran:hizb                     "3" ;
        quran:index                    "232" ;
        quran:page                     "35" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:5761  quran:ayah_text            "وَإِذَا رَأَيۡتَ ثَمَّ رَأَيۡتَ نَعِيمٗا وَمُلۡكٗا كَبِيرًا" ;
        quran:ayah_text_no_diacratic   "واذا رايت ثم رايت نعيما وملكا كبيرا" ;
