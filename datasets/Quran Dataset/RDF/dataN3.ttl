quran:1105  quran:ayah_text            "وَجَٰوَزۡنَا بِبَنِيٓ إِسۡرَٰٓءِيلَ ٱلۡبَحۡرَ فَأَتَوۡاْ عَلَىٰ قَوۡمٖ يَعۡكُفُونَ عَلَىٰٓ أَصۡنَامٖ لَّهُمۡۚ قَالُواْ يَٰمُوسَى ٱجۡعَل لَّنَآ إِلَٰهٗا كَمَا لَهُمۡ ءَالِهَةٞۚ قَالَ إِنَّكُمۡ قَوۡمٞ تَجۡهَلُونَ" ;
        quran:ayah_text_no_diacratic   "وجٰوزنا ببني اسرٰءيل البحر فاتوا علىٰ قوم يعكفون علىٰ اصنام لهم قالوا يٰموسى اجعل لنا الٰها كما لهم ءالهة قال انكم قوم تجهلون" ;
        quran:ayahnumber               "138" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1105" ;
        quran:page                     "167" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:813  quran:ayah_text             "۞وَلَهُۥ مَا سَكَنَ فِي ٱلَّيۡلِ وَٱلنَّهَارِۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ" ;
        quran:ayah_text_no_diacratic   "وله ما سكن في اليل والنهار وهو السميع العليم" ;
        quran:ayahnumber               "13" ;
