quran:3880  quran:ayah_text            "وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ" ;
        quran:ayah_text_no_diacratic   "وقالوا يٰويلنا هٰذا يوم الدين" ;
        quran:ayahnumber               "20" ;
