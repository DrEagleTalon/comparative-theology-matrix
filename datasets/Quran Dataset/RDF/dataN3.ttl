        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:5098  quran:ayah_text            "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ" ;
