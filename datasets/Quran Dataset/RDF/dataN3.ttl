quran:3325  quran:ayah_text            "فَلَمَّآ أَنۡ أَرَادَ أَن يَبۡطِشَ بِٱلَّذِي هُوَ عَدُوّٞ لَّهُمَا قَالَ يَٰمُوسَىٰٓ أَتُرِيدُ أَن تَقۡتُلَنِي كَمَا قَتَلۡتَ نَفۡسَۢا بِٱلۡأَمۡسِۖ إِن تُرِيدُ إِلَّآ أَن تَكُونَ جَبَّارٗا فِي ٱلۡأَرۡضِ وَمَا تُرِيدُ أَن تَكُونَ مِنَ ٱلۡمُصۡلِحِينَ" ;
        quran:ayah_text_no_diacratic   "فلما ان اراد ان يبطش بالذي هو عدو لهما قال يٰموسىٰ اتريد ان تقتلني كما قتلت نفسا بالامس ان تريد الا ان تكون جبارا في الارض وما تريد ان تكون من المصلحين" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3325" ;
        quran:page                     "387" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

