        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3738  quran:ayah_text            "مَن كَانَ يُرِيدُ ٱلۡعِزَّةَ فَلِلَّهِ ٱلۡعِزَّةُ جَمِيعًاۚ إِلَيۡهِ يَصۡعَدُ ٱلۡكَلِمُ ٱلطَّيِّبُ وَٱلۡعَمَلُ ٱلصَّٰلِحُ يَرۡفَعُهُۥۚ وَٱلَّذِينَ يَمۡكُرُونَ ٱلسَّيِّـَٔاتِ لَهُمۡ عَذَابٞ شَدِيدٞۖ وَمَكۡرُ أُوْلَٰٓئِكَ هُوَ يَبُورُ" ;
        quran:ayah_text_no_diacratic   "من كان يريد العزة فلله العزة جميعا اليه يصعد الكلم الطيب والعمل الصٰلح يرفعه والذين يمكرون السيات لهم عذاب شديد ومكر اولٰئك هو يبور" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3738" ;
        quran:page                     "435" ;
        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:1740  quran:ayah_text            "عَٰلِمُ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ ٱلۡكَبِيرُ ٱلۡمُتَعَالِ" ;
        quran:ayah_text_no_diacratic   "عٰلم الغيب والشهٰدة الكبير المتعال" ;
        quran:ayahnumber               "9" ;
