        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:930  quran:ayah_text             "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ أَلَمۡ يَأۡتِكُمۡ رُسُلٞ مِّنكُمۡ يَقُصُّونَ عَلَيۡكُمۡ ءَايَٰتِي وَيُنذِرُونَكُمۡ لِقَآءَ يَوۡمِكُمۡ هَٰذَاۚ قَالُواْ شَهِدۡنَا عَلَىٰٓ أَنفُسِنَاۖ وَغَرَّتۡهُمُ ٱلۡحَيَوٰةُ ٱلدُّنۡيَا وَشَهِدُواْ عَلَىٰٓ أَنفُسِهِمۡ أَنَّهُمۡ كَانُواْ كَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "يٰمعشر الجن والانس الم ياتكم رسل منكم يقصون عليكم ءايٰتي وينذرونكم لقاء يومكم هٰذا قالوا شهدنا علىٰ انفسنا وغرتهم الحيوٰة الدنيا وشهدوا علىٰ انفسهم انهم كانوا كٰفرين" ;
        quran:ayahnumber               "130" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "930" ;
        quran:page                     "144" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2126  quran:ayah_text            "إِنَّ عِبَادِي لَيۡسَ لَكَ عَلَيۡهِمۡ سُلۡطَٰنٞۚ وَكَفَىٰ بِرَبِّكَ وَكِيلٗا" ;
        quran:ayah_text_no_diacratic   "ان عبادي ليس لك عليهم سلطٰن وكفىٰ بربك وكيلا" ;
