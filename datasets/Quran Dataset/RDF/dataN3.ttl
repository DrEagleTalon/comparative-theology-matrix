quran:4359  quran:ayah_text            "تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرۡنَ مِن فَوۡقِهِنَّۚ وَٱلۡمَلَٰٓئِكَةُ يُسَبِّحُونَ بِحَمۡدِ رَبِّهِمۡ وَيَسۡتَغۡفِرُونَ لِمَن فِي ٱلۡأَرۡضِۗ أَلَآ إِنَّ ٱللَّهَ هُوَ ٱلۡغَفُورُ ٱلرَّحِيمُ" ;
        quran:ayah_text_no_diacratic   "تكاد السمٰوٰت يتفطرن من فوقهن والملٰئكة يسبحون بحمد ربهم ويستغفرون لمن في الارض الا ان الله هو الغفور الرحيم" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4359" ;
        quran:page                     "483" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
