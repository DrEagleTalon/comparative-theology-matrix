quran:1410  quran:ayah_text            "وَيَوۡمَ نَحۡشُرُهُمۡ جَمِيعٗا ثُمَّ نَقُولُ لِلَّذِينَ أَشۡرَكُواْ مَكَانَكُمۡ أَنتُمۡ وَشُرَكَآؤُكُمۡۚ فَزَيَّلۡنَا بَيۡنَهُمۡۖ وَقَالَ شُرَكَآؤُهُم مَّا كُنتُمۡ إِيَّانَا تَعۡبُدُونَ" ;
        quran:ayah_text_no_diacratic   "ويوم نحشرهم جميعا ثم نقول للذين اشركوا مكانكم انتم وشركاؤكم فزيلنا بينهم وقال شركاؤهم ما كنتم ايانا تعبدون" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1410" ;
        quran:page                     "212" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:3408  quran:ayah_text            "وَقَالَ ٱلَّذِينَ كَفَرُواْ لِلَّذِينَ ءَامَنُواْ ٱتَّبِعُواْ سَبِيلَنَا وَلۡنَحۡمِلۡ خَطَٰيَٰكُمۡ وَمَا هُم بِحَٰمِلِينَ مِنۡ خَطَٰيَٰهُم مِّن شَيۡءٍۖ إِنَّهُمۡ لَكَٰذِبُونَ" ;
        quran:ayah_text_no_diacratic   "وقال الذين كفروا للذين ءامنوا اتبعوا سبيلنا ولنحمل خطٰيٰكم وما هم بحٰملين من خطٰيٰهم من شيء انهم لكٰذبون" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3408" ;
        quran:page                     "397" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:878  quran:ayah_text             "فَلَمَّا رَءَا ٱلشَّمۡسَ بَازِغَةٗ قَالَ هَٰذَا رَبِّي هَٰذَآ أَكۡبَرُۖ فَلَمَّآ أَفَلَتۡ قَالَ يَٰقَوۡمِ إِنِّي بَرِيٓءٞ مِّمَّا تُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "فلما رءا الشمس بازغة قال هٰذا ربي هٰذا اكبر فلما افلت قال يٰقوم اني بريء مما تشركون" ;
        quran:ayahnumber               "78" ;
        quran:chapter                  "7" ;
