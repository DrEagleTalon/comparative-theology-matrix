quran:3495  quran:ayah_text            "ضَرَبَ لَكُم مَّثَلٗا مِّنۡ أَنفُسِكُمۡۖ هَل لَّكُم مِّن مَّا مَلَكَتۡ أَيۡمَٰنُكُم مِّن شُرَكَآءَ فِي مَا رَزَقۡنَٰكُمۡ فَأَنتُمۡ فِيهِ سَوَآءٞ تَخَافُونَهُمۡ كَخِيفَتِكُمۡ أَنفُسَكُمۡۚ كَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "ضرب لكم مثلا من انفسكم هل لكم من ما ملكت ايمٰنكم من شركاء في ما رزقنٰكم فانتم فيه سواء تخافونهم كخيفتكم انفسكم كذٰلك نفصل الايٰت لقوم يعقلون" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3495" ;
        quran:page                     "407" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:4399  quran:ayah_text            "وَتَرَىٰهُمۡ يُعۡرَضُونَ عَلَيۡهَا خَٰشِعِينَ مِنَ ٱلذُّلِّ يَنظُرُونَ مِن طَرۡفٍ خَفِيّٖۗ وَقَالَ ٱلَّذِينَ ءَامَنُوٓاْ إِنَّ ٱلۡخَٰسِرِينَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ وَأَهۡلِيهِمۡ يَوۡمَ ٱلۡقِيَٰمَةِۗ أَلَآ إِنَّ ٱلظَّٰلِمِينَ فِي عَذَابٖ مُّقِيمٖ" ;
        quran:ayah_text_no_diacratic   "وترىٰهم يعرضون عليها خٰشعين من الذل ينظرون من طرف خفي وقال الذين ءامنوا ان الخٰسرين الذين خسروا انفسهم واهليهم يوم القيٰمة الا ان الظٰلمين في عذاب مقيم" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4399" ;
        quran:page                     "488" ;
        quran:surahname                "سُورَةُ الشُّورَىٰ" ;
        quran:surahnumber              "42" ;
        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:1808  quran:ayah_text            "ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجَ بِهِۦ مِنَ ٱلثَّمَرَٰتِ رِزۡقٗا لَّكُمۡۖ وَسَخَّرَ لَكُمُ ٱلۡفُلۡكَ لِتَجۡرِيَ فِي ٱلۡبَحۡرِ بِأَمۡرِهِۦۖ وَسَخَّرَ لَكُمُ ٱلۡأَنۡهَٰرَ" ;
        quran:ayah_text_no_diacratic   "الله الذي خلق السمٰوٰت والارض وانزل من السماء ماء فاخرج به من الثمرٰت رزقا لكم وسخر لكم الفلك لتجري في البحر بامره وسخر لكم الانهٰر" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "13" ;
        quran:hizb                     "26" ;
        quran:index                    "1808" ;
        quran:page                     "259" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:5543  quran:ayah_text            "إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ" ;
        quran:ayah_text_no_diacratic   "الا علىٰ ازوٰجهم او ما ملكت ايمٰنهم فانهم غير ملومين" ;
