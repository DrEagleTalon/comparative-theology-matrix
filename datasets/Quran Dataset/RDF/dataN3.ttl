quran:1311  quran:ayah_text            "۞إِنَّمَا ٱلصَّدَقَٰتُ لِلۡفُقَرَآءِ وَٱلۡمَسَٰكِينِ وَٱلۡعَٰمِلِينَ عَلَيۡهَا وَٱلۡمُؤَلَّفَةِ قُلُوبُهُمۡ وَفِي ٱلرِّقَابِ وَٱلۡغَٰرِمِينَ وَفِي سَبِيلِ ٱللَّهِ وَٱبۡنِ ٱلسَّبِيلِۖ فَرِيضَةٗ مِّنَ ٱللَّهِۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "انما الصدقٰت للفقراء والمسٰكين والعٰملين عليها والمؤلفة قلوبهم وفي الرقاب والغٰرمين وفي سبيل الله وابن السبيل فريضة من الله والله عليم حكيم" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1311" ;
        quran:page                     "196" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:3309  quran:ayah_text            "نَتۡلُواْ عَلَيۡكَ مِن نَّبَإِ مُوسَىٰ وَفِرۡعَوۡنَ بِٱلۡحَقِّ لِقَوۡمٖ يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "نتلوا عليك من نبا موسىٰ وفرعون بالحق لقوم يؤمنون" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3309" ;
        quran:page                     "385" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:779  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَسۡـَٔلُواْ عَنۡ أَشۡيَآءَ إِن تُبۡدَ لَكُمۡ تَسُؤۡكُمۡ وَإِن تَسۡـَٔلُواْ عَنۡهَا حِينَ يُنَزَّلُ ٱلۡقُرۡءَانُ تُبۡدَ لَكُمۡ عَفَا ٱللَّهُ عَنۡهَاۗ وَٱللَّهُ غَفُورٌ حَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا تسلوا عن اشياء ان تبد لكم تسؤكم وان تسلوا عنها حين ينزل القرءان تبد لكم عفا الله عنها والله غفور حليم" ;
        quran:ayahnumber               "101" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "779" ;
        quran:page                     "124" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2215  quran:ayah_text            "أَوۡ يُصۡبِحَ مَآؤُهَا غَوۡرٗا فَلَن تَسۡتَطِيعَ لَهُۥ طَلَبٗا" ;
        quran:ayah_text_no_diacratic   "او يصبح ماؤها غورا فلن تستطيع له طلبا" ;
        quran:ayahnumber               "41" ;
