        quran:surahnumber              "40" ;
        quran:surrahname_no_diacratic  "سورة غافر" .

quran:2221  quran:ayah_text            "وَيَوۡمَ نُسَيِّرُ ٱلۡجِبَالَ وَتَرَى ٱلۡأَرۡضَ بَارِزَةٗ وَحَشَرۡنَٰهُمۡ فَلَمۡ نُغَادِرۡ مِنۡهُمۡ أَحَدٗا" ;
