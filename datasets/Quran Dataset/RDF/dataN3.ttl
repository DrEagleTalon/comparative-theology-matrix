quran:1236  quran:ayah_text            "۞وَإِن جَنَحُواْ لِلسَّلۡمِ فَٱجۡنَحۡ لَهَا وَتَوَكَّلۡ عَلَى ٱللَّهِۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ" ;
        quran:ayah_text_no_diacratic   "وان جنحوا للسلم فاجنح لها وتوكل على الله انه هو السميع العليم" ;
        quran:ayahnumber               "61" ;
        quran:chapter                  "10" ;
