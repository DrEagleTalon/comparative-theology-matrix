        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:426  quran:ayah_text             "لَيۡسَ لَكَ مِنَ ٱلۡأَمۡرِ شَيۡءٌ أَوۡ يَتُوبَ عَلَيۡهِمۡ أَوۡ يُعَذِّبَهُمۡ فَإِنَّهُمۡ ظَٰلِمُونَ" ;
        quran:ayah_text_no_diacratic   "ليس لك من الامر شيء او يتوب عليهم او يعذبهم فانهم ظٰلمون" ;
