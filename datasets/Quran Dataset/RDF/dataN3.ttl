quran:5308  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا نُودِيَ لِلصَّلَوٰةِ مِن يَوۡمِ ٱلۡجُمُعَةِ فَٱسۡعَوۡاْ إِلَىٰ ذِكۡرِ ٱللَّهِ وَذَرُواْ ٱلۡبَيۡعَۚ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اذا نودي للصلوٰة من يوم الجمعة فاسعوا الىٰ ذكر الله وذروا البيع ذٰلكم خير لكم ان كنتم تعلمون" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5308" ;
        quran:page                     "554" ;
        quran:surahname                "سُورَةُ الجُمُعَةِ" ;
        quran:surahnumber              "62" ;
        quran:surrahname_no_diacratic  "سورة الجمعة" .

quran:3310  quran:ayah_text            "إِنَّ فِرۡعَوۡنَ عَلَا فِي ٱلۡأَرۡضِ وَجَعَلَ أَهۡلَهَا شِيَعٗا يَسۡتَضۡعِفُ طَآئِفَةٗ مِّنۡهُمۡ يُذَبِّحُ أَبۡنَآءَهُمۡ وَيَسۡتَحۡيِۦ نِسَآءَهُمۡۚ إِنَّهُۥ كَانَ مِنَ ٱلۡمُفۡسِدِينَ" ;
        quran:ayah_text_no_diacratic   "ان فرعون علا في الارض وجعل اهلها شيعا يستضعف طائفة منهم يذبح ابناءهم ويستحي نساءهم انه كان من المفسدين" ;
