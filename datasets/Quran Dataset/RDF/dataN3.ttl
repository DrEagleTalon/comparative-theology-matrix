        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:944  quran:ayah_text             "وَمِنَ ٱلۡإِبِلِ ٱثۡنَيۡنِ وَمِنَ ٱلۡبَقَرِ ٱثۡنَيۡنِۗ قُلۡ ءَآلذَّكَرَيۡنِ حَرَّمَ أَمِ ٱلۡأُنثَيَيۡنِ أَمَّا ٱشۡتَمَلَتۡ عَلَيۡهِ أَرۡحَامُ ٱلۡأُنثَيَيۡنِۖ أَمۡ كُنتُمۡ شُهَدَآءَ إِذۡ وَصَّىٰكُمُ ٱللَّهُ بِهَٰذَاۚ فَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبٗا لِّيُضِلَّ ٱلنَّاسَ بِغَيۡرِ عِلۡمٍۚ إِنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "ومن الابل اثنين ومن البقر اثنين قل ءالذكرين حرم ام الانثيين اما اشتملت عليه ارحام الانثيين ام كنتم شهداء اذ وصىٰكم الله بهٰذا فمن اظلم ممن افترىٰ على الله كذبا ليضل الناس بغير علم ان الله لا يهدي القوم الظٰلمين" ;
        quran:ayahnumber               "144" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "944" ;
        quran:page                     "147" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1046  quran:ayah_text            "فَتَوَلَّىٰ عَنۡهُمۡ وَقَالَ يَٰقَوۡمِ لَقَدۡ أَبۡلَغۡتُكُمۡ رِسَالَةَ رَبِّي وَنَصَحۡتُ لَكُمۡ وَلَٰكِن لَّا تُحِبُّونَ ٱلنَّٰصِحِينَ" ;
        quran:ayah_text_no_diacratic   "فتولىٰ عنهم وقال يٰقوم لقد ابلغتكم رسالة ربي ونصحت لكم ولٰكن لا تحبون النٰصحين" ;
        quran:ayahnumber               "79" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1046" ;
        quran:page                     "160" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:754  quran:ayah_text             "قُلۡ أَتَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَمۡلِكُ لَكُمۡ ضَرّٗا وَلَا نَفۡعٗاۚ وَٱللَّهُ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ" ;
        quran:ayah_text_no_diacratic   "قل اتعبدون من دون الله ما لا يملك لكم ضرا ولا نفعا والله هو السميع العليم" ;
        quran:ayahnumber               "76" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "754" ;
        quran:page                     "120" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:564  quran:ayah_text             "وَمَآ أَرۡسَلۡنَا مِن رَّسُولٍ إِلَّا لِيُطَاعَ بِإِذۡنِ ٱللَّهِۚ وَلَوۡ أَنَّهُمۡ إِذ ظَّلَمُوٓاْ أَنفُسَهُمۡ جَآءُوكَ فَٱسۡتَغۡفَرُواْ ٱللَّهَ وَٱسۡتَغۡفَرَ لَهُمُ ٱلرَّسُولُ لَوَجَدُواْ ٱللَّهَ تَوَّابٗا رَّحِيمٗا" ;
        quran:ayah_text_no_diacratic   "وما ارسلنا من رسول الا ليطاع باذن الله ولو انهم اذ ظلموا انفسهم جاءوك فاستغفروا الله واستغفر لهم الرسول لوجدوا الله توابا رحيما" ;
        quran:ayahnumber               "64" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "564" ;
        quran:page                     "88" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2000  quran:ayah_text            "ثُمَّ كُلِي مِن كُلِّ ٱلثَّمَرَٰتِ فَٱسۡلُكِي سُبُلَ رَبِّكِ ذُلُلٗاۚ يَخۡرُجُ مِنۢ بُطُونِهَا شَرَابٞ مُّخۡتَلِفٌ أَلۡوَٰنُهُۥ فِيهِ شِفَآءٞ لِّلنَّاسِۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَتَفَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "ثم كلي من كل الثمرٰت فاسلكي سبل ربك ذللا يخرج من بطونها شراب مختلف الوٰنه فيه شفاء للناس ان في ذٰلك لاية لقوم يتفكرون" ;
        quran:ayahnumber               "69" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2000" ;
        quran:page                     "274" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:374  quran:ayah_text             "بَلَىٰۚ مَنۡ أَوۡفَىٰ بِعَهۡدِهِۦ وَٱتَّقَىٰ فَإِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "بلىٰ من اوفىٰ بعهده واتقىٰ فان الله يحب المتقين" ;
        quran:ayahnumber               "76" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "374" ;
        quran:page                     "59" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:184  quran:ayah_text             "إِنَّ ٱلَّذِينَ يَكۡتُمُونَ مَآ أَنزَلَ ٱللَّهُ مِنَ ٱلۡكِتَٰبِ وَيَشۡتَرُونَ بِهِۦ ثَمَنٗا قَلِيلًا أُوْلَٰٓئِكَ مَا يَأۡكُلُونَ فِي بُطُونِهِمۡ إِلَّا ٱلنَّارَ وَلَا يُكَلِّمُهُمُ ٱللَّهُ يَوۡمَ ٱلۡقِيَٰمَةِ وَلَا يُزَكِّيهِمۡ وَلَهُمۡ عَذَابٌ أَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "ان الذين يكتمون ما انزل الله من الكتٰب ويشترون به ثمنا قليلا اولٰئك ما ياكلون في بطونهم الا النار ولا يكلمهم الله يوم القيٰمة ولا يزكيهم ولهم عذاب اليم" ;
        quran:ayahnumber               "174" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "184" ;
        quran:page                     "26" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1978  quran:ayah_text            "أَوۡ يَأۡخُذَهُمۡ عَلَىٰ تَخَوُّفٖ فَإِنَّ رَبَّكُمۡ لَرَءُوفٞ رَّحِيمٌ" ;
        quran:ayah_text_no_diacratic   "او ياخذهم علىٰ تخوف فان ربكم لرءوف رحيم" ;
        quran:ayahnumber               "47" ;
