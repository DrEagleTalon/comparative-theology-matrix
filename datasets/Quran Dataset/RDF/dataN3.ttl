        quran:page                     "442" ;
        quran:surahname                "سُورَةُ يسٓ" ;
        quran:surahnumber              "36" ;
        quran:surrahname_no_diacratic  "سورة يس" .

quran:1566  quran:ayah_text            "قَالُوٓاْ أَتَعۡجَبِينَ مِنۡ أَمۡرِ ٱللَّهِۖ رَحۡمَتُ ٱللَّهِ وَبَرَكَٰتُهُۥ عَلَيۡكُمۡ أَهۡلَ ٱلۡبَيۡتِۚ إِنَّهُۥ حَمِيدٞ مَّجِيدٞ" ;
        quran:ayah_text_no_diacratic   "قالوا اتعجبين من امر الله رحمت الله وبركٰته عليكم اهل البيت انه حميد مجيد" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1566" ;
        quran:page                     "230" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:4708  quran:ayah_text            "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ" ;
        quran:ayah_text_no_diacratic   "بسم الله الرحمٰن الرحيم" ;
