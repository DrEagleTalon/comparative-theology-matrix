        quran:surrahname_no_diacratic  "سورة ق" .

quran:3652  quran:ayah_text            "لَّا جُنَاحَ عَلَيۡهِنَّ فِيٓ ءَابَآئِهِنَّ وَلَآ أَبۡنَآئِهِنَّ وَلَآ إِخۡوَٰنِهِنَّ وَلَآ أَبۡنَآءِ إِخۡوَٰنِهِنَّ وَلَآ أَبۡنَآءِ أَخَوَٰتِهِنَّ وَلَا نِسَآئِهِنَّ وَلَا مَا مَلَكَتۡ أَيۡمَٰنُهُنَّۗ وَٱتَّقِينَ ٱللَّهَۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدًا" ;
        quran:ayah_text_no_diacratic   "لا جناح عليهن في ءابائهن ولا ابنائهن ولا اخوٰنهن ولا ابناء اخوٰنهن ولا ابناء اخوٰتهن ولا نسائهن ولا ما ملكت ايمٰنهن واتقين الله ان الله كان علىٰ كل شيء شهيدا" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3652" ;
        quran:page                     "426" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:4556  quran:ayah_text            "لَا يَذُوقُونَ فِيهَا ٱلۡمَوۡتَ إِلَّا ٱلۡمَوۡتَةَ ٱلۡأُولَىٰۖ وَوَقَىٰهُمۡ عَذَابَ ٱلۡجَحِيمِ" ;
        quran:ayah_text_no_diacratic   "لا يذوقون فيها الموت الا الموتة الاولىٰ ووقىٰهم عذاب الجحيم" ;
        quran:ayahnumber               "56" ;
