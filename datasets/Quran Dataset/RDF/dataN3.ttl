        quran:surrahname_no_diacratic  "سورة النور" .

quran:3765  quran:ayah_text            "وَهُمۡ يَصۡطَرِخُونَ فِيهَا رَبَّنَآ أَخۡرِجۡنَا نَعۡمَلۡ صَٰلِحًا غَيۡرَ ٱلَّذِي كُنَّا نَعۡمَلُۚ أَوَلَمۡ نُعَمِّرۡكُم مَّا يَتَذَكَّرُ فِيهِ مَن تَذَكَّرَ وَجَآءَكُمُ ٱلنَّذِيرُۖ فَذُوقُواْ فَمَا لِلظَّٰلِمِينَ مِن نَّصِيرٍ" ;
        quran:ayah_text_no_diacratic   "وهم يصطرخون فيها ربنا اخرجنا نعمل صٰلحا غير الذي كنا نعمل اولم نعمركم ما يتذكر فيه من تذكر وجاءكم النذير فذوقوا فما للظٰلمين من نصير" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3765" ;
        quran:page                     "438" ;
        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:4669  quran:ayah_text            "إِنَّ ٱلَّذِينَ كَفَرُواْ وَصَدُّواْ عَن سَبِيلِ ٱللَّهِ وَشَآقُّواْ ٱلرَّسُولَ مِنۢ بَعۡدِ مَا تَبَيَّنَ لَهُمُ ٱلۡهُدَىٰ لَن يَضُرُّواْ ٱللَّهَ شَيۡـٔٗا وَسَيُحۡبِطُ أَعۡمَٰلَهُمۡ" ;
        quran:ayah_text_no_diacratic   "ان الذين كفروا وصدوا عن سبيل الله وشاقوا الرسول من بعد ما تبين لهم الهدىٰ لن يضروا الله شيا وسيحبط اعمٰلهم" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4669" ;
        quran:page                     "510" ;
        quran:surahname                "سُورَةُ مُحَمَّدٍ" ;
        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:2671  quran:ayah_text            "وَلِكُلِّ أُمَّةٖ جَعَلۡنَا مَنسَكٗا لِّيَذۡكُرُواْ ٱسۡمَ ٱللَّهِ عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلۡأَنۡعَٰمِۗ فَإِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞ فَلَهُۥٓ أَسۡلِمُواْۗ وَبَشِّرِ ٱلۡمُخۡبِتِينَ" ;
        quran:ayah_text_no_diacratic   "ولكل امة جعلنا منسكا ليذكروا اسم الله علىٰ ما رزقهم من بهيمة الانعٰم فالٰهكم الٰه وٰحد فله اسلموا وبشر المخبتين" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2671" ;
        quran:page                     "336" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

