        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:5290  quran:ayah_text            "وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ ٱلۡكَذِبَ وَهُوَ يُدۡعَىٰٓ إِلَى ٱلۡإِسۡلَٰمِۚ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "ومن اظلم ممن افترىٰ على الله الكذب وهو يدعىٰ الى الاسلٰم والله لا يهدي القوم الظٰلمين" ;
