quran:84  quran:ayah_text              "ثُمَّ قَسَتۡ قُلُوبُكُم مِّنۢ بَعۡدِ ذَٰلِكَ فَهِيَ كَٱلۡحِجَارَةِ أَوۡ أَشَدُّ قَسۡوَةٗۚ وَإِنَّ مِنَ ٱلۡحِجَارَةِ لَمَا يَتَفَجَّرُ مِنۡهُ ٱلۡأَنۡهَٰرُۚ وَإِنَّ مِنۡهَا لَمَا يَشَّقَّقُ فَيَخۡرُجُ مِنۡهُ ٱلۡمَآءُۚ وَإِنَّ مِنۡهَا لَمَا يَهۡبِطُ مِنۡ خَشۡيَةِ ٱللَّهِۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "ثم قست قلوبكم من بعد ذٰلك فهي كالحجارة او اشد قسوة وان من الحجارة لما يتفجر منه الانهٰر وان منها لما يشقق فيخرج منه الماء وان منها لما يهبط من خشية الله وما الله بغٰفل عما تعملون" ;
        quran:ayahnumber               "74" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "84" ;
        quran:page                     "11" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1215  quran:ayah_text            "وَإِن تَوَلَّوۡاْ فَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَوۡلَىٰكُمۡۚ نِعۡمَ ٱلۡمَوۡلَىٰ وَنِعۡمَ ٱلنَّصِيرُ" ;
        quran:ayah_text_no_diacratic   "وان تولوا فاعلموا ان الله مولىٰكم نعم المولىٰ ونعم النصير" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1215" ;
        quran:page                     "181" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:923  quran:ayah_text             "وَكَذَٰلِكَ جَعَلۡنَا فِي كُلِّ قَرۡيَةٍ أَكَٰبِرَ مُجۡرِمِيهَا لِيَمۡكُرُواْ فِيهَاۖ وَمَا يَمۡكُرُونَ إِلَّا بِأَنفُسِهِمۡ وَمَا يَشۡعُرُونَ" ;
        quran:ayah_text_no_diacratic   "وكذٰلك جعلنا في كل قرية اكٰبر مجرميها ليمكروا فيها وما يمكرون الا بانفسهم وما يشعرون" ;
        quran:ayahnumber               "123" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "923" ;
        quran:page                     "143" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2119  quran:ayah_text            "وَإِن مِّن قَرۡيَةٍ إِلَّا نَحۡنُ مُهۡلِكُوهَا قَبۡلَ يَوۡمِ ٱلۡقِيَٰمَةِ أَوۡ مُعَذِّبُوهَا عَذَابٗا شَدِيدٗاۚ كَانَ ذَٰلِكَ فِي ٱلۡكِتَٰبِ مَسۡطُورٗا" ;
        quran:ayah_text_no_diacratic   "وان من قرية الا نحن مهلكوها قبل يوم القيٰمة او معذبوها عذابا شديدا كان ذٰلك في الكتٰب مسطورا" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2119" ;
        quran:page                     "287" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1025  quran:ayah_text            "وَٱلۡبَلَدُ ٱلطَّيِّبُ يَخۡرُجُ نَبَاتُهُۥ بِإِذۡنِ رَبِّهِۦۖ وَٱلَّذِي خَبُثَ لَا يَخۡرُجُ إِلَّا نَكِدٗاۚ كَذَٰلِكَ نُصَرِّفُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَشۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "والبلد الطيب يخرج نباته باذن ربه والذي خبث لا يخرج الا نكدا كذٰلك نصرف الايٰت لقوم يشكرون" ;
        quran:ayahnumber               "58" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1025" ;
        quran:page                     "158" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:733  quran:ayah_text             "إِنَّمَا وَلِيُّكُمُ ٱللَّهُ وَرَسُولُهُۥ وَٱلَّذِينَ ءَامَنُواْ ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤۡتُونَ ٱلزَّكَوٰةَ وَهُمۡ رَٰكِعُونَ" ;
        quran:ayah_text_no_diacratic   "انما وليكم الله ورسوله والذين ءامنوا الذين يقيمون الصلوٰة ويؤتون الزكوٰة وهم رٰكعون" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "733" ;
        quran:page                     "117" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:543  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَقۡرَبُواْ ٱلصَّلَوٰةَ وَأَنتُمۡ سُكَٰرَىٰ حَتَّىٰ تَعۡلَمُواْ مَا تَقُولُونَ وَلَا جُنُبًا إِلَّا عَابِرِي سَبِيلٍ حَتَّىٰ تَغۡتَسِلُواْۚ وَإِن كُنتُم مَّرۡضَىٰٓ أَوۡ عَلَىٰ سَفَرٍ أَوۡ جَآءَ أَحَدٞ مِّنكُم مِّنَ ٱلۡغَآئِطِ أَوۡ لَٰمَسۡتُمُ ٱلنِّسَآءَ فَلَمۡ تَجِدُواْ مَآءٗ فَتَيَمَّمُواْ صَعِيدٗا طَيِّبٗا فَٱمۡسَحُواْ بِوُجُوهِكُمۡ وَأَيۡدِيكُمۡۗ إِنَّ ٱللَّهَ كَانَ عَفُوًّا غَفُورًا" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا تقربوا الصلوٰة وانتم سكٰرىٰ حتىٰ تعلموا ما تقولون ولا جنبا الا عابري سبيل حتىٰ تغتسلوا وان كنتم مرضىٰ او علىٰ سفر او جاء احد منكم من الغائط او لٰمستم النساء فلم تجدوا ماء فتيمموا صعيدا طيبا فامسحوا بوجوهكم وايديكم ان الله كان عفوا غفورا" ;
        quran:ayahnumber               "43" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "543" ;
        quran:page                     "85" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:353  quran:ayah_text             "إِذۡ قَالَ ٱللَّهُ يَٰعِيسَىٰٓ إِنِّي مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ وَمُطَهِّرُكَ مِنَ ٱلَّذِينَ كَفَرُواْ وَجَاعِلُ ٱلَّذِينَ ٱتَّبَعُوكَ فَوۡقَ ٱلَّذِينَ كَفَرُوٓاْ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِۖ ثُمَّ إِلَيَّ مَرۡجِعُكُمۡ فَأَحۡكُمُ بَيۡنَكُمۡ فِيمَا كُنتُمۡ فِيهِ تَخۡتَلِفُونَ" ;
        quran:ayah_text_no_diacratic   "اذ قال الله يٰعيسىٰ اني متوفيك ورافعك الي ومطهرك من الذين كفروا وجاعل الذين اتبعوك فوق الذين كفروا الىٰ يوم القيٰمة ثم الي مرجعكم فاحكم بينكم فيما كنتم فيه تختلفون" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "353" ;
        quran:page                     "57" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:5882  quran:ayah_text            "فَإِذَا هُم بِٱلسَّاهِرَةِ" ;
