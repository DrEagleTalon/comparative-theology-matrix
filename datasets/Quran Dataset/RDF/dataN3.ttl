quran:4662  quran:ayah_text            "إِنَّ ٱلَّذِينَ ٱرۡتَدُّواْ عَلَىٰٓ أَدۡبَٰرِهِم مِّنۢ بَعۡدِ مَا تَبَيَّنَ لَهُمُ ٱلۡهُدَى ٱلشَّيۡطَٰنُ سَوَّلَ لَهُمۡ وَأَمۡلَىٰ لَهُمۡ" ;
        quran:ayah_text_no_diacratic   "ان الذين ارتدوا علىٰ ادبٰرهم من بعد ما تبين لهم الهدى الشيطٰن سول لهم واملىٰ لهم" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4662" ;
        quran:page                     "509" ;
        quran:surahname                "سُورَةُ مُحَمَّدٍ" ;
        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:5566  quran:ayah_text            "وَإِنِّي كُلَّمَا دَعَوۡتُهُمۡ لِتَغۡفِرَ لَهُمۡ جَعَلُوٓاْ أَصَٰبِعَهُمۡ فِيٓ ءَاذَانِهِمۡ وَٱسۡتَغۡشَوۡاْ ثِيَابَهُمۡ وَأَصَرُّواْ وَٱسۡتَكۡبَرُواْ ٱسۡتِكۡبَارٗا" ;
        quran:ayah_text_no_diacratic   "واني كلما دعوتهم لتغفر لهم جعلوا اصٰبعهم في ءاذانهم واستغشوا ثيابهم واصروا واستكبروا استكبارا" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5566" ;
        quran:page                     "570" ;
        quran:surahname                "سُورَةُ نُوحٍ" ;
        quran:surahnumber              "71" ;
        quran:surrahname_no_diacratic  "سورة نوح" .

quran:4472  quran:ayah_text            "وَلَمَّا جَآءَ عِيسَىٰ بِٱلۡبَيِّنَٰتِ قَالَ قَدۡ جِئۡتُكُم بِٱلۡحِكۡمَةِ وَلِأُبَيِّنَ لَكُم بَعۡضَ ٱلَّذِي تَخۡتَلِفُونَ فِيهِۖ فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ" ;
        quran:ayah_text_no_diacratic   "ولما جاء عيسىٰ بالبينٰت قال قد جئتكم بالحكمة ولابين لكم بعض الذي تختلفون فيه فاتقوا الله واطيعون" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4472" ;
        quran:page                     "494" ;
        quran:surahname                "سُورَةُ الزُّخۡرُفِ" ;
        quran:surahnumber              "43" ;
        quran:surrahname_no_diacratic  "سورة الزخرف" .

quran:5376  quran:ayah_text            "ٱلَّذِي خَلَقَ سَبۡعَ سَمَٰوَٰتٖ طِبَاقٗاۖ مَّا تَرَىٰ فِي خَلۡقِ ٱلرَّحۡمَٰنِ مِن تَفَٰوُتٖۖ فَٱرۡجِعِ ٱلۡبَصَرَ هَلۡ تَرَىٰ مِن فُطُورٖ" ;
        quran:ayah_text_no_diacratic   "الذي خلق سبع سمٰوٰت طباقا ما ترىٰ في خلق الرحمٰن من تفٰوت فارجع البصر هل ترىٰ من فطور" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "29" ;
        quran:hizb                     "56" ;
        quran:index                    "5376" ;
        quran:page                     "562" ;
        quran:surahname                "سُورَةُ المُلۡكِ" ;
        quran:surahnumber              "67" ;
        quran:surrahname_no_diacratic  "سورة الملك" .

quran:4282  quran:ayah_text            "إِذِ ٱلۡأَغۡلَٰلُ فِيٓ أَعۡنَٰقِهِمۡ وَٱلسَّلَٰسِلُ يُسۡحَبُونَ" ;
        quran:ayah_text_no_diacratic   "اذ الاغلٰل في اعنٰقهم والسلٰسل يسحبون" ;
