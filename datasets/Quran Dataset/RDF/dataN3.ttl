quran:1004  quran:ayah_text            "فَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوۡ كَذَّبَ بِـَٔايَٰتِهِۦٓۚ أُوْلَٰٓئِكَ يَنَالُهُمۡ نَصِيبُهُم مِّنَ ٱلۡكِتَٰبِۖ حَتَّىٰٓ إِذَا جَآءَتۡهُمۡ رُسُلُنَا يَتَوَفَّوۡنَهُمۡ قَالُوٓاْ أَيۡنَ مَا كُنتُمۡ تَدۡعُونَ مِن دُونِ ٱللَّهِۖ قَالُواْ ضَلُّواْ عَنَّا وَشَهِدُواْ عَلَىٰٓ أَنفُسِهِمۡ أَنَّهُمۡ كَانُواْ كَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "فمن اظلم ممن افترىٰ على الله كذبا او كذب بايٰته اولٰئك ينالهم نصيبهم من الكتٰب حتىٰ اذا جاءتهم رسلنا يتوفونهم قالوا اين ما كنتم تدعون من دون الله قالوا ضلوا عنا وشهدوا علىٰ انفسهم انهم كانوا كٰفرين" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1004" ;
        quran:page                     "154" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:712  quran:ayah_text             "إِلَّا ٱلَّذِينَ تَابُواْ مِن قَبۡلِ أَن تَقۡدِرُواْ عَلَيۡهِمۡۖ فَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "الا الذين تابوا من قبل ان تقدروا عليهم فاعلموا ان الله غفور رحيم" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "6" ;
