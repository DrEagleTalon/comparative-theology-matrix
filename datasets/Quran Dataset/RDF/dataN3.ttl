quran:1322  quran:ayah_text            "وَٱلۡمُؤۡمِنُونَ وَٱلۡمُؤۡمِنَٰتُ بَعۡضُهُمۡ أَوۡلِيَآءُ بَعۡضٖۚ يَأۡمُرُونَ بِٱلۡمَعۡرُوفِ وَيَنۡهَوۡنَ عَنِ ٱلۡمُنكَرِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤۡتُونَ ٱلزَّكَوٰةَ وَيُطِيعُونَ ٱللَّهَ وَرَسُولَهُۥٓۚ أُوْلَٰٓئِكَ سَيَرۡحَمُهُمُ ٱللَّهُۗ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "والمؤمنون والمؤمنٰت بعضهم اولياء بعض يامرون بالمعروف وينهون عن المنكر ويقيمون الصلوٰة ويؤتون الزكوٰة ويطيعون الله ورسوله اولٰئك سيرحمهم الله ان الله عزيز حكيم" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1322" ;
        quran:page                     "198" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2226  quran:ayah_text            "وَيَوۡمَ يَقُولُ نَادُواْ شُرَكَآءِيَ ٱلَّذِينَ زَعَمۡتُمۡ فَدَعَوۡهُمۡ فَلَمۡ يَسۡتَجِيبُواْ لَهُمۡ وَجَعَلۡنَا بَيۡنَهُم مَّوۡبِقٗا" ;
        quran:ayah_text_no_diacratic   "ويوم يقول نادوا شركاءي الذين زعمتم فدعوهم فلم يستجيبوا لهم وجعلنا بينهم موبقا" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "15" ;
