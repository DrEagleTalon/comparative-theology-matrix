quran:685  quran:ayah_text             "وَٱذۡكُرُواْ نِعۡمَةَ ٱللَّهِ عَلَيۡكُمۡ وَمِيثَٰقَهُ ٱلَّذِي وَاثَقَكُم بِهِۦٓ إِذۡ قُلۡتُمۡ سَمِعۡنَا وَأَطَعۡنَاۖ وَٱتَّقُواْ ٱللَّهَۚ إِنَّ ٱللَّهَ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ" ;
        quran:ayah_text_no_diacratic   "واذكروا نعمة الله عليكم وميثٰقه الذي واثقكم به اذ قلتم سمعنا واطعنا واتقوا الله ان الله عليم بذات الصدور" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "685" ;
        quran:page                     "108" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:4119  quran:ayah_text            "قَالَ يَٰٓإِبۡلِيسُ مَا مَنَعَكَ أَن تَسۡجُدَ لِمَا خَلَقۡتُ بِيَدَيَّۖ أَسۡتَكۡبَرۡتَ أَمۡ كُنتَ مِنَ ٱلۡعَالِينَ" ;
        quran:ayah_text_no_diacratic   "قال يٰابليس ما منعك ان تسجد لما خلقت بيدي استكبرت ام كنت من العالين" ;
        quran:ayahnumber               "75" ;
