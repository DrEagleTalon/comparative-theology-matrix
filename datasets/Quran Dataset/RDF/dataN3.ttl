        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:5587  quran:ayah_text            "رَّبِّ ٱغۡفِرۡ لِي وَلِوَٰلِدَيَّ وَلِمَن دَخَلَ بَيۡتِيَ مُؤۡمِنٗا وَلِلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِۖ وَلَا تَزِدِ ٱلظَّٰلِمِينَ إِلَّا تَبَارَۢا" ;
        quran:ayah_text_no_diacratic   "رب اغفر لي ولوٰلدي ولمن دخل بيتي مؤمنا وللمؤمنين والمؤمنٰت ولا تزد الظٰلمين الا تبارا" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5587" ;
        quran:page                     "571" ;
