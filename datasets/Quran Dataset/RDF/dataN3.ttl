        quran:index                    "2896" ;
        quran:page                     "358" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:509  quran:ayah_text             "وَلۡيَخۡشَ ٱلَّذِينَ لَوۡ تَرَكُواْ مِنۡ خَلۡفِهِمۡ ذُرِّيَّةٗ ضِعَٰفًا خَافُواْ عَلَيۡهِمۡ فَلۡيَتَّقُواْ ٱللَّهَ وَلۡيَقُولُواْ قَوۡلٗا سَدِيدًا" ;
        quran:ayah_text_no_diacratic   "وليخش الذين لو تركوا من خلفهم ذرية ضعٰفا خافوا عليهم فليتقوا الله وليقولوا قولا سديدا" ;
