        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2058  quran:ayah_text            "وَٱصۡبِرۡ وَمَا صَبۡرُكَ إِلَّا بِٱللَّهِۚ وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَلَا تَكُ فِي ضَيۡقٖ مِّمَّا يَمۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "واصبر وما صبرك الا بالله ولا تحزن عليهم ولا تك في ضيق مما يمكرون" ;
