quran:567  quran:ayah_text             "وَإِذٗا لَّأٓتَيۡنَٰهُم مِّن لَّدُنَّآ أَجۡرًا عَظِيمٗا" ;
        quran:ayah_text_no_diacratic   "واذا لاتينٰهم من لدنا اجرا عظيما" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "567" ;
        quran:page                     "89" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2003  quran:ayah_text            "وَٱللَّهُ جَعَلَ لَكُم مِّنۡ أَنفُسِكُمۡ أَزۡوَٰجٗا وَجَعَلَ لَكُم مِّنۡ أَزۡوَٰجِكُم بَنِينَ وَحَفَدَةٗ وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِۚ أَفَبِٱلۡبَٰطِلِ يُؤۡمِنُونَ وَبِنِعۡمَتِ ٱللَّهِ هُمۡ يَكۡفُرُونَ" ;
        quran:ayah_text_no_diacratic   "والله جعل لكم من انفسكم ازوٰجا وجعل لكم من ازوٰجكم بنين وحفدة ورزقكم من الطيبٰت افبالبٰطل يؤمنون وبنعمت الله هم يكفرون" ;
        quran:ayahnumber               "72" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2003" ;
        quran:page                     "274" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:377  quran:ayah_text             "مَا كَانَ لِبَشَرٍ أَن يُؤۡتِيَهُ ٱللَّهُ ٱلۡكِتَٰبَ وَٱلۡحُكۡمَ وَٱلنُّبُوَّةَ ثُمَّ يَقُولَ لِلنَّاسِ كُونُواْ عِبَادٗا لِّي مِن دُونِ ٱللَّهِ وَلَٰكِن كُونُواْ رَبَّٰنِيِّـۧنَ بِمَا كُنتُمۡ تُعَلِّمُونَ ٱلۡكِتَٰبَ وَبِمَا كُنتُمۡ تَدۡرُسُونَ" ;
        quran:ayah_text_no_diacratic   "ما كان لبشر ان يؤتيه الله الكتٰب والحكم والنبوة ثم يقول للناس كونوا عبادا لي من دون الله ولٰكن كونوا ربٰنين بما كنتم تعلمون الكتٰب وبما كنتم تدرسون" ;
        quran:ayahnumber               "79" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "377" ;
        quran:page                     "60" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:187  quran:ayah_text             "۞لَّيۡسَ ٱلۡبِرَّ أَن تُوَلُّواْ وُجُوهَكُمۡ قِبَلَ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ وَلَٰكِنَّ ٱلۡبِرَّ مَنۡ ءَامَنَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَٱلۡمَلَٰٓئِكَةِ وَٱلۡكِتَٰبِ وَٱلنَّبِيِّـۧنَ وَءَاتَى ٱلۡمَالَ عَلَىٰ حُبِّهِۦ ذَوِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينَ وَٱبۡنَ ٱلسَّبِيلِ وَٱلسَّآئِلِينَ وَفِي ٱلرِّقَابِ وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ وَٱلۡمُوفُونَ بِعَهۡدِهِمۡ إِذَا عَٰهَدُواْۖ وَٱلصَّٰبِرِينَ فِي ٱلۡبَأۡسَآءِ وَٱلضَّرَّآءِ وَحِينَ ٱلۡبَأۡسِۗ أُوْلَٰٓئِكَ ٱلَّذِينَ صَدَقُواْۖ وَأُوْلَٰٓئِكَ هُمُ ٱلۡمُتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "ليس البر ان تولوا وجوهكم قبل المشرق والمغرب ولٰكن البر من ءامن بالله واليوم الاخر والملٰئكة والكتٰب والنبين وءاتى المال علىٰ حبه ذوي القربىٰ واليتٰمىٰ والمسٰكين وابن السبيل والسائلين وفي الرقاب واقام الصلوٰة وءاتى الزكوٰة والموفون بعهدهم اذا عٰهدوا والصٰبرين في الباساء والضراء وحين الباس اولٰئك الذين صدقوا واولٰئك هم المتقون" ;
        quran:ayahnumber               "177" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "187" ;
        quran:page                     "27" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2935  quran:ayah_text            "وَقَالَ ٱلَّذِينَ كَفَرُواْ لَوۡلَا نُزِّلَ عَلَيۡهِ ٱلۡقُرۡءَانُ جُمۡلَةٗ وَٰحِدَةٗۚ كَذَٰلِكَ لِنُثَبِّتَ بِهِۦ فُؤَادَكَۖ وَرَتَّلۡنَٰهُ تَرۡتِيلٗا" ;
        quran:ayah_text_no_diacratic   "وقال الذين كفروا لولا نزل عليه القرءان جملة وٰحدة كذٰلك لنثبت به فؤادك ورتلنٰه ترتيلا" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "2935" ;
        quran:page                     "362" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3839  quran:ayah_text            "ٱصۡلَوۡهَا ٱلۡيَوۡمَ بِمَا كُنتُمۡ تَكۡفُرُونَ" ;
        quran:ayah_text_no_diacratic   "اصلوها اليوم بما كنتم تكفرون" ;
        quran:ayahnumber               "64" ;
