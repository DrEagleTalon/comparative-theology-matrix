        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2540  quran:ayah_text            "لَوۡ أَرَدۡنَآ أَن نَّتَّخِذَ لَهۡوٗا لَّٱتَّخَذۡنَٰهُ مِن لَّدُنَّآ إِن كُنَّا فَٰعِلِينَ" ;
        quran:ayah_text_no_diacratic   "لو اردنا ان نتخذ لهوا لاتخذنٰه من لدنا ان كنا فٰعلين" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2540" ;
        quran:page                     "323" ;
