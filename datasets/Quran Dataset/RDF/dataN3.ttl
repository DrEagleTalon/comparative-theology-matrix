        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:5580  quran:ayah_text            "قَالَ نُوحٞ رَّبِّ إِنَّهُمۡ عَصَوۡنِي وَٱتَّبَعُواْ مَن لَّمۡ يَزِدۡهُ مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا خَسَارٗا" ;
        quran:ayah_text_no_diacratic   "قال نوح رب انهم عصوني واتبعوا من لم يزده ماله وولده الا خسارا" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "29" ;
        quran:hizb                     "57" ;
        quran:index                    "5580" ;
        quran:page                     "571" ;
        quran:surahname                "سُورَةُ نُوحٍ" ;
        quran:surahnumber              "71" ;
        quran:surrahname_no_diacratic  "سورة نوح" .

quran:2749  quran:ayah_text            "فَأَرۡسَلۡنَا فِيهِمۡ رَسُولٗا مِّنۡهُمۡ أَنِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓۚ أَفَلَا تَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "فارسلنا فيهم رسولا منهم ان اعبدوا الله ما لكم من الٰه غيره افلا تتقون" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2749" ;
        quran:page                     "344" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:1655  quran:ayah_text            "قَالَ لَا يَأۡتِيكُمَا طَعَامٞ تُرۡزَقَانِهِۦٓ إِلَّا نَبَّأۡتُكُمَا بِتَأۡوِيلِهِۦ قَبۡلَ أَن يَأۡتِيَكُمَاۚ ذَٰلِكُمَا مِمَّا عَلَّمَنِي رَبِّيٓۚ إِنِّي تَرَكۡتُ مِلَّةَ قَوۡمٖ لَّا يُؤۡمِنُونَ بِٱللَّهِ وَهُم بِٱلۡأٓخِرَةِ هُمۡ كَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "قال لا ياتيكما طعام ترزقانه الا نباتكما بتاويله قبل ان ياتيكما ذٰلكما مما علمني ربي اني تركت ملة قوم لا يؤمنون بالله وهم بالاخرة هم كٰفرون" ;
        quran:ayahnumber               "37" ;
        quran:chapter                  "12" ;
        quran:hizb                     "24" ;
        quran:index                    "1655" ;
        quran:page                     "239" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5390  quran:ayah_text            "أَمۡ أَمِنتُم مَّن فِي ٱلسَّمَآءِ أَن يُرۡسِلَ عَلَيۡكُمۡ حَاصِبٗاۖ فَسَتَعۡلَمُونَ كَيۡفَ نَذِيرِ" ;
        quran:ayah_text_no_diacratic   "ام امنتم من في السماء ان يرسل عليكم حاصبا فستعلمون كيف نذير" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "29" ;
        quran:hizb                     "56" ;
        quran:index                    "5390" ;
        quran:page                     "563" ;
        quran:surahname                "سُورَةُ المُلۡكِ" ;
        quran:surahnumber              "67" ;
        quran:surrahname_no_diacratic  "سورة الملك" .

quran:2559  quran:ayah_text            "وَإِذَا رَءَاكَ ٱلَّذِينَ كَفَرُوٓاْ إِن يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا ٱلَّذِي يَذۡكُرُ ءَالِهَتَكُمۡ وَهُم بِذِكۡرِ ٱلرَّحۡمَٰنِ هُمۡ كَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "واذا رءاك الذين كفروا ان يتخذونك الا هزوا اهٰذا الذي يذكر ءالهتكم وهم بذكر الرحمٰن هم كٰفرون" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2559" ;
        quran:page                     "325" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

