        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1388  quran:ayah_text            "إِنَّ فِي ٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ وَمَا خَلَقَ ٱللَّهُ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ لَأٓيَٰتٖ لِّقَوۡمٖ يَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "ان في اختلٰف اليل والنهار وما خلق الله في السمٰوٰت والارض لايٰت لقوم يتقون" ;
