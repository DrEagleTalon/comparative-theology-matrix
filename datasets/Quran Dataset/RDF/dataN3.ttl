quran:1109  quran:ayah_text            "۞وَوَٰعَدۡنَا مُوسَىٰ ثَلَٰثِينَ لَيۡلَةٗ وَأَتۡمَمۡنَٰهَا بِعَشۡرٖ فَتَمَّ مِيقَٰتُ رَبِّهِۦٓ أَرۡبَعِينَ لَيۡلَةٗۚ وَقَالَ مُوسَىٰ لِأَخِيهِ هَٰرُونَ ٱخۡلُفۡنِي فِي قَوۡمِي وَأَصۡلِحۡ وَلَا تَتَّبِعۡ سَبِيلَ ٱلۡمُفۡسِدِينَ" ;
        quran:ayah_text_no_diacratic   "ووٰعدنا موسىٰ ثلٰثين ليلة واتممنٰها بعشر فتم ميقٰت ربه اربعين ليلة وقال موسىٰ لاخيه هٰرون اخلفني في قومي واصلح ولا تتبع سبيل المفسدين" ;
        quran:ayahnumber               "142" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1109" ;
        quran:page                     "167" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:817  quran:ayah_text             "وَإِن يَمۡسَسۡكَ ٱللَّهُ بِضُرّٖ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَۖ وَإِن يَمۡسَسۡكَ بِخَيۡرٖ فَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "وان يمسسك الله بضر فلا كاشف له الا هو وان يمسسك بخير فهو علىٰ كل شيء قدير" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "817" ;
        quran:page                     "129" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:627  quran:ayah_text             "وَيَسۡتَفۡتُونَكَ فِي ٱلنِّسَآءِۖ قُلِ ٱللَّهُ يُفۡتِيكُمۡ فِيهِنَّ وَمَا يُتۡلَىٰ عَلَيۡكُمۡ فِي ٱلۡكِتَٰبِ فِي يَتَٰمَى ٱلنِّسَآءِ ٱلَّٰتِي لَا تُؤۡتُونَهُنَّ مَا كُتِبَ لَهُنَّ وَتَرۡغَبُونَ أَن تَنكِحُوهُنَّ وَٱلۡمُسۡتَضۡعَفِينَ مِنَ ٱلۡوِلۡدَٰنِ وَأَن تَقُومُواْ لِلۡيَتَٰمَىٰ بِٱلۡقِسۡطِۚ وَمَا تَفۡعَلُواْ مِنۡ خَيۡرٖ فَإِنَّ ٱللَّهَ كَانَ بِهِۦ عَلِيمٗا" ;
        quran:ayah_text_no_diacratic   "ويستفتونك في النساء قل الله يفتيكم فيهن وما يتلىٰ عليكم في الكتٰب في يتٰمى النساء الٰتي لا تؤتونهن ما كتب لهن وترغبون ان تنكحوهن والمستضعفين من الولدٰن وان تقوموا لليتٰمىٰ بالقسط وما تفعلوا من خير فان الله كان به عليما" ;
        quran:ayahnumber               "127" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "627" ;
        quran:page                     "98" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:437  quran:ayah_text             "وَلَا تَهِنُواْ وَلَا تَحۡزَنُواْ وَأَنتُمُ ٱلۡأَعۡلَوۡنَ إِن كُنتُم مُّؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "ولا تهنوا ولا تحزنوا وانتم الاعلون ان كنتم مؤمنين" ;
