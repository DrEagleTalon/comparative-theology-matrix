quran:1756  quran:ayah_text            "وَٱلَّذِينَ يَنقُضُونَ عَهۡدَ ٱللَّهِ مِنۢ بَعۡدِ مِيثَٰقِهِۦ وَيَقۡطَعُونَ مَآ أَمَرَ ٱللَّهُ بِهِۦٓ أَن يُوصَلَ وَيُفۡسِدُونَ فِي ٱلۡأَرۡضِ أُوْلَٰٓئِكَ لَهُمُ ٱللَّعۡنَةُ وَلَهُمۡ سُوٓءُ ٱلدَّارِ" ;
        quran:ayah_text_no_diacratic   "والذين ينقضون عهد الله من بعد ميثٰقه ويقطعون ما امر الله به ان يوصل ويفسدون في الارض اولٰئك لهم اللعنة ولهم سوء الدار" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1756" ;
        quran:page                     "252" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:5491  quran:ayah_text            "ثُمَّ فِي سِلۡسِلَةٖ ذَرۡعُهَا سَبۡعُونَ ذِرَاعٗا فَٱسۡلُكُوهُ" ;
        quran:ayah_text_no_diacratic   "ثم في سلسلة ذرعها سبعون ذراعا فاسلكوه" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "29" ;
        quran:hizb                     "56" ;
        quran:index                    "5491" ;
        quran:page                     "567" ;
        quran:surahname                "سُورَةُ الحَاقَّةِ" ;
        quran:surahnumber              "69" ;
        quran:surrahname_no_diacratic  "سورة الحاقة" .

quran:2900  quran:ayah_text            "لَّا تَجۡعَلُواْ دُعَآءَ ٱلرَّسُولِ بَيۡنَكُمۡ كَدُعَآءِ بَعۡضِكُم بَعۡضٗاۚ قَدۡ يَعۡلَمُ ٱللَّهُ ٱلَّذِينَ يَتَسَلَّلُونَ مِنكُمۡ لِوَاذٗاۚ فَلۡيَحۡذَرِ ٱلَّذِينَ يُخَالِفُونَ عَنۡ أَمۡرِهِۦٓ أَن تُصِيبَهُمۡ فِتۡنَةٌ أَوۡ يُصِيبَهُمۡ عَذَابٌ أَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "لا تجعلوا دعاء الرسول بينكم كدعاء بعضكم بعضا قد يعلم الله الذين يتسللون منكم لواذا فليحذر الذين يخالفون عن امره ان تصيبهم فتنة او يصيبهم عذاب اليم" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2900" ;
        quran:page                     "359" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:6395  quran:ayah_text            "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ" ;
        quran:ayah_text_no_diacratic   "الم تر كيف فعل ربك باصحٰب الفيل" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "30" ;
        quran:hizb                     "60" ;
        quran:index                    "6395" ;
        quran:page                     "601" ;
        quran:surahname                "سُورَةُ الفِيلِ" ;
        quran:surahnumber              "105" ;
        quran:surrahname_no_diacratic  "سورة الفيل" .

quran:3804  quran:ayah_text            "إِن كَانَتۡ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ فَإِذَا هُمۡ خَٰمِدُونَ" ;
        quran:ayah_text_no_diacratic   "ان كانت الا صيحة وٰحدة فاذا هم خٰمدون" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "23" ;
