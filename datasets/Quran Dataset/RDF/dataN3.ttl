        quran:ayahnumber               "14" ;
        quran:chapter                  "30" ;
        quran:hizb                     "58" ;
        quran:index                    "5882" ;
        quran:page                     "583" ;
        quran:surahname                "سُورَةُ النَّازِعَاتِ" ;
        quran:surahnumber              "79" ;
        quran:surrahname_no_diacratic  "سورة النازعات" .

quran:163  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱسۡتَعِينُواْ بِٱلصَّبۡرِ وَٱلصَّلَوٰةِۚ إِنَّ ٱللَّهَ مَعَ ٱلصَّٰبِرِينَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا استعينوا بالصبر والصلوٰة ان الله مع الصٰبرين" ;
        quran:ayahnumber               "153" ;
