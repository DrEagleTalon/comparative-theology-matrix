        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:470  quran:ayah_text             "ٱلَّذِينَ ٱسۡتَجَابُواْ لِلَّهِ وَٱلرَّسُولِ مِنۢ بَعۡدِ مَآ أَصَابَهُمُ ٱلۡقَرۡحُۚ لِلَّذِينَ أَحۡسَنُواْ مِنۡهُمۡ وَٱتَّقَوۡاْ أَجۡرٌ عَظِيمٌ" ;
        quran:ayah_text_no_diacratic   "الذين استجابوا لله والرسول من بعد ما اصابهم القرح للذين احسنوا منهم واتقوا اجر عظيم" ;
        quran:ayahnumber               "172" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "470" ;
        quran:page                     "72" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:280  quran:ayah_text             "وَمَآ أَنفَقۡتُم مِّن نَّفَقَةٍ أَوۡ نَذَرۡتُم مِّن نَّذۡرٖ فَإِنَّ ٱللَّهَ يَعۡلَمُهُۥۗ وَمَا لِلظَّٰلِمِينَ مِنۡ أَنصَارٍ" ;
        quran:ayah_text_no_diacratic   "وما انفقتم من نفقة او نذرتم من نذر فان الله يعلمه وما للظٰلمين من انصار" ;
        quran:ayahnumber               "270" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "280" ;
        quran:page                     "46" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2978  quran:ayah_text            "أُوْلَٰٓئِكَ يُجۡزَوۡنَ ٱلۡغُرۡفَةَ بِمَا صَبَرُواْ وَيُلَقَّوۡنَ فِيهَا تَحِيَّةٗ وَسَلَٰمًا" ;
        quran:ayah_text_no_diacratic   "اولٰئك يجزون الغرفة بما صبروا ويلقون فيها تحية وسلٰما" ;
