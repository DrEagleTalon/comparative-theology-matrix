quran:5367  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ تُوبُوٓاْ إِلَى ٱللَّهِ تَوۡبَةٗ نَّصُوحًا عَسَىٰ رَبُّكُمۡ أَن يُكَفِّرَ عَنكُمۡ سَيِّـَٔاتِكُمۡ وَيُدۡخِلَكُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ يَوۡمَ لَا يُخۡزِي ٱللَّهُ ٱلنَّبِيَّ وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥۖ نُورُهُمۡ يَسۡعَىٰ بَيۡنَ أَيۡدِيهِمۡ وَبِأَيۡمَٰنِهِمۡ يَقُولُونَ رَبَّنَآ أَتۡمِمۡ لَنَا نُورَنَا وَٱغۡفِرۡ لَنَآۖ إِنَّكَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا توبوا الى الله توبة نصوحا عسىٰ ربكم ان يكفر عنكم سياتكم ويدخلكم جنٰت تجري من تحتها الانهٰر يوم لا يخزي الله النبي والذين ءامنوا معه نورهم يسعىٰ بين ايديهم وبايمٰنهم يقولون ربنا اتمم لنا نورنا واغفر لنا انك علىٰ كل شيء قدير" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "28" ;
        quran:hizb                     "56" ;
        quran:index                    "5367" ;
        quran:page                     "561" ;
        quran:surahname                "سُورَةُ التَّحۡرِيمِ" ;
        quran:surahnumber              "66" ;
        quran:surrahname_no_diacratic  "سورة التحريم" .

quran:4273  quran:ayah_text            "ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ خَٰلِقُ كُلِّ شَيۡءٖ لَّآ إِلَٰهَ إِلَّا هُوَۖ فَأَنَّىٰ تُؤۡفَكُونَ" ;
        quran:ayah_text_no_diacratic   "ذٰلكم الله ربكم خٰلق كل شيء لا الٰه الا هو فانىٰ تؤفكون" ;
