        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:5492  quran:ayah_text            "إِنَّهُۥ كَانَ لَا يُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "انه كان لا يؤمن بالله العظيم" ;
