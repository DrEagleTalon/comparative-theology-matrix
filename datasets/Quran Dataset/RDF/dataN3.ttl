quran:1764  quran:ayah_text            "أَفَمَنۡ هُوَ قَآئِمٌ عَلَىٰ كُلِّ نَفۡسِۭ بِمَا كَسَبَتۡۗ وَجَعَلُواْ لِلَّهِ شُرَكَآءَ قُلۡ سَمُّوهُمۡۚ أَمۡ تُنَبِّـُٔونَهُۥ بِمَا لَا يَعۡلَمُ فِي ٱلۡأَرۡضِ أَم بِظَٰهِرٖ مِّنَ ٱلۡقَوۡلِۗ بَلۡ زُيِّنَ لِلَّذِينَ كَفَرُواْ مَكۡرُهُمۡ وَصُدُّواْ عَنِ ٱلسَّبِيلِۗ وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِنۡ هَادٖ" ;
        quran:ayah_text_no_diacratic   "افمن هو قائم علىٰ كل نفس بما كسبت وجعلوا لله شركاء قل سموهم ام تنبونه بما لا يعلم في الارض ام بظٰهر من القول بل زين للذين كفروا مكرهم وصدوا عن السبيل ومن يضلل الله فما له من هاد" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1764" ;
        quran:page                     "253" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:4906  quran:ayah_text            "لَقَدۡ رَأَىٰ مِنۡ ءَايَٰتِ رَبِّهِ ٱلۡكُبۡرَىٰٓ" ;
        quran:ayah_text_no_diacratic   "لقد راىٰ من ءايٰت ربه الكبرىٰ" ;
