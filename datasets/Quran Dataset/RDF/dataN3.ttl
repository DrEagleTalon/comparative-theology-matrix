        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4632  quran:ayah_text            "وَمَن لَّا يُجِبۡ دَاعِيَ ٱللَّهِ فَلَيۡسَ بِمُعۡجِزٖ فِي ٱلۡأَرۡضِ وَلَيۡسَ لَهُۥ مِن دُونِهِۦٓ أَوۡلِيَآءُۚ أُوْلَٰٓئِكَ فِي ضَلَٰلٖ مُّبِينٍ" ;
        quran:ayah_text_no_diacratic   "ومن لا يجب داعي الله فليس بمعجز في الارض وليس له من دونه اولياء اولٰئك في ضلٰل مبين" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4632" ;
