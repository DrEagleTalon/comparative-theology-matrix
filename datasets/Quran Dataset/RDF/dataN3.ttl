        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3535  quran:ayah_text            "وَمِنَ ٱلنَّاسِ مَن يَشۡتَرِي لَهۡوَ ٱلۡحَدِيثِ لِيُضِلَّ عَن سَبِيلِ ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَيَتَّخِذَهَا هُزُوًاۚ أُوْلَٰٓئِكَ لَهُمۡ عَذَابٞ مُّهِينٞ" ;
        quran:ayah_text_no_diacratic   "ومن الناس من يشتري لهو الحديث ليضل عن سبيل الله بغير علم ويتخذها هزوا اولٰئك لهم عذاب مهين" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3535" ;
        quran:page                     "411" ;
