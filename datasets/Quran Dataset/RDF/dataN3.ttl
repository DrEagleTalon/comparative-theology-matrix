quran:2891  quran:ayah_text            "قُلۡ أَطِيعُواْ ٱللَّهَ وَأَطِيعُواْ ٱلرَّسُولَۖ فَإِن تَوَلَّوۡاْ فَإِنَّمَا عَلَيۡهِ مَا حُمِّلَ وَعَلَيۡكُم مَّا حُمِّلۡتُمۡۖ وَإِن تُطِيعُوهُ تَهۡتَدُواْۚ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلۡبَلَٰغُ ٱلۡمُبِينُ" ;
        quran:ayah_text_no_diacratic   "قل اطيعوا الله واطيعوا الرسول فان تولوا فانما عليه ما حمل وعليكم ما حملتم وان تطيعوه تهتدوا وما على الرسول الا البلٰغ المبين" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2891" ;
        quran:page                     "357" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:504  quran:ayah_text             "وَءَاتُواْ ٱلنِّسَآءَ صَدُقَٰتِهِنَّ نِحۡلَةٗۚ فَإِن طِبۡنَ لَكُمۡ عَن شَيۡءٖ مِّنۡهُ نَفۡسٗا فَكُلُوهُ هَنِيٓـٔٗا مَّرِيٓـٔٗا" ;
        quran:ayah_text_no_diacratic   "وءاتوا النساء صدقٰتهن نحلة فان طبن لكم عن شيء منه نفسا فكلوه هنيا مريا" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "504" ;
