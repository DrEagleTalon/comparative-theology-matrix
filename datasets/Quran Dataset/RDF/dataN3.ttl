quran:911  quran:ayah_text             "۞وَلَوۡ أَنَّنَا نَزَّلۡنَآ إِلَيۡهِمُ ٱلۡمَلَٰٓئِكَةَ وَكَلَّمَهُمُ ٱلۡمَوۡتَىٰ وَحَشَرۡنَا عَلَيۡهِمۡ كُلَّ شَيۡءٖ قُبُلٗا مَّا كَانُواْ لِيُؤۡمِنُوٓاْ إِلَّآ أَن يَشَآءَ ٱللَّهُ وَلَٰكِنَّ أَكۡثَرَهُمۡ يَجۡهَلُونَ" ;
        quran:ayah_text_no_diacratic   "ولو اننا نزلنا اليهم الملٰئكة وكلمهم الموتىٰ وحشرنا عليهم كل شيء قبلا ما كانوا ليؤمنوا الا ان يشاء الله ولٰكن اكثرهم يجهلون" ;
        quran:ayahnumber               "111" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "911" ;
        quran:page                     "142" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2107  quran:ayah_text            "وَجَعَلۡنَا عَلَىٰ قُلُوبِهِمۡ أَكِنَّةً أَن يَفۡقَهُوهُ وَفِيٓ ءَاذَانِهِمۡ وَقۡرٗاۚ وَإِذَا ذَكَرۡتَ رَبَّكَ فِي ٱلۡقُرۡءَانِ وَحۡدَهُۥ وَلَّوۡاْ عَلَىٰٓ أَدۡبَٰرِهِمۡ نُفُورٗا" ;
        quran:ayah_text_no_diacratic   "وجعلنا علىٰ قلوبهم اكنة ان يفقهوه وفي ءاذانهم وقرا واذا ذكرت ربك في القرءان وحده ولوا علىٰ ادبٰرهم نفورا" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2107" ;
        quran:page                     "286" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:1013  quran:ayah_text            "وَبَيۡنَهُمَا حِجَابٞۚ وَعَلَى ٱلۡأَعۡرَافِ رِجَالٞ يَعۡرِفُونَ كُلَّۢا بِسِيمَىٰهُمۡۚ وَنَادَوۡاْ أَصۡحَٰبَ ٱلۡجَنَّةِ أَن سَلَٰمٌ عَلَيۡكُمۡۚ لَمۡ يَدۡخُلُوهَا وَهُمۡ يَطۡمَعُونَ" ;
        quran:ayah_text_no_diacratic   "وبينهما حجاب وعلى الاعراف رجال يعرفون كلا بسيمىٰهم ونادوا اصحٰب الجنة ان سلٰم عليكم لم يدخلوها وهم يطمعون" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1013" ;
        quran:page                     "156" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:721  quran:ayah_text             "وَكَيۡفَ يُحَكِّمُونَكَ وَعِندَهُمُ ٱلتَّوۡرَىٰةُ فِيهَا حُكۡمُ ٱللَّهِ ثُمَّ يَتَوَلَّوۡنَ مِنۢ بَعۡدِ ذَٰلِكَۚ وَمَآ أُوْلَٰٓئِكَ بِٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "وكيف يحكمونك وعندهم التورىٰة فيها حكم الله ثم يتولون من بعد ذٰلك وما اولٰئك بالمؤمنين" ;
        quran:ayahnumber               "43" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "721" ;
        quran:page                     "115" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:531  quran:ayah_text             "إِن تَجۡتَنِبُواْ كَبَآئِرَ مَا تُنۡهَوۡنَ عَنۡهُ نُكَفِّرۡ عَنكُمۡ سَيِّـَٔاتِكُمۡ وَنُدۡخِلۡكُم مُّدۡخَلٗا كَرِيمٗا" ;
        quran:ayah_text_no_diacratic   "ان تجتنبوا كبائر ما تنهون عنه نكفر عنكم سياتكم وندخلكم مدخلا كريما" ;
