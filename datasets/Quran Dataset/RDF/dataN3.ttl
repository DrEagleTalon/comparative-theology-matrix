        quran:surrahname_no_diacratic  "سورة الشورىٰ" .

quran:5266  quran:ayah_text            "هُوَ ٱللَّهُ ٱلۡخَٰلِقُ ٱلۡبَارِئُ ٱلۡمُصَوِّرُۖ لَهُ ٱلۡأَسۡمَآءُ ٱلۡحُسۡنَىٰۚ يُسَبِّحُ لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ" ;
        quran:ayah_text_no_diacratic   "هو الله الخٰلق البارئ المصور له الاسماء الحسنىٰ يسبح له ما في السمٰوٰت والارض وهو العزيز الحكيم" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5266" ;
        quran:page                     "548" ;
        quran:surahname                "سُورَةُ الحَشۡرِ" ;
        quran:surahnumber              "59" ;
        quran:surrahname_no_diacratic  "سورة الحشر" .

quran:6410  quran:ayah_text            "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ" ;
        quran:ayah_text_no_diacratic   "ولا يحض علىٰ طعام المسكين" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "30" ;
        quran:hizb                     "60" ;
        quran:index                    "6410" ;
        quran:page                     "602" ;
        quran:surahname                "سُورَةُ المَاعُونِ" ;
        quran:surahnumber              "107" ;
        quran:surrahname_no_diacratic  "سورة الماعون" .

quran:4172  quran:ayah_text            "وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ لَيَقُولُنَّ ٱللَّهُۚ قُلۡ أَفَرَءَيۡتُم مَّا تَدۡعُونَ مِن دُونِ ٱللَّهِ إِنۡ أَرَادَنِيَ ٱللَّهُ بِضُرٍّ هَلۡ هُنَّ كَٰشِفَٰتُ ضُرِّهِۦٓ أَوۡ أَرَادَنِي بِرَحۡمَةٍ هَلۡ هُنَّ مُمۡسِكَٰتُ رَحۡمَتِهِۦۚ قُلۡ حَسۡبِيَ ٱللَّهُۖ عَلَيۡهِ يَتَوَكَّلُ ٱلۡمُتَوَكِّلُونَ" ;
        quran:ayah_text_no_diacratic   "ولئن سالتهم من خلق السمٰوٰت والارض ليقولن الله قل افرءيتم ما تدعون من دون الله ان ارادني الله بضر هل هن كٰشفٰت ضره او ارادني برحمة هل هن ممسكٰت رحمته قل حسبي الله عليه يتوكل المتوكلون" ;
        quran:ayahnumber               "38" ;
        quran:chapter                  "24" ;
        quran:hizb                     "46" ;
        quran:index                    "4172" ;
        quran:page                     "462" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:5076  quran:ayah_text            "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ" ;
        quran:ayah_text_no_diacratic   "فباي ءالاء ربكما تكذبان" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "27" ;
        quran:hizb                     "53" ;
        quran:index                    "5076" ;
