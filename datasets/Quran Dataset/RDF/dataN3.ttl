quran:3603  quran:ayah_text            "ٱلنَّبِيُّ أَوۡلَىٰ بِٱلۡمُؤۡمِنِينَ مِنۡ أَنفُسِهِمۡۖ وَأَزۡوَٰجُهُۥٓ أُمَّهَٰتُهُمۡۗ وَأُوْلُواْ ٱلۡأَرۡحَامِ بَعۡضُهُمۡ أَوۡلَىٰ بِبَعۡضٖ فِي كِتَٰبِ ٱللَّهِ مِنَ ٱلۡمُؤۡمِنِينَ وَٱلۡمُهَٰجِرِينَ إِلَّآ أَن تَفۡعَلُوٓاْ إِلَىٰٓ أَوۡلِيَآئِكُم مَّعۡرُوفٗاۚ كَانَ ذَٰلِكَ فِي ٱلۡكِتَٰبِ مَسۡطُورٗا" ;
        quran:ayah_text_no_diacratic   "النبي اولىٰ بالمؤمنين من انفسهم وازوٰجه امهٰتهم واولوا الارحام بعضهم اولىٰ ببعض في كتٰب الله من المؤمنين والمهٰجرين الا ان تفعلوا الىٰ اوليائكم معروفا كان ذٰلك في الكتٰب مسطورا" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3603" ;
        quran:page                     "418" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1365  quran:ayah_text            "وَمَا كَانَ ٱسۡتِغۡفَارُ إِبۡرَٰهِيمَ لِأَبِيهِ إِلَّا عَن مَّوۡعِدَةٖ وَعَدَهَآ إِيَّاهُ فَلَمَّا تَبَيَّنَ لَهُۥٓ أَنَّهُۥ عَدُوّٞ لِّلَّهِ تَبَرَّأَ مِنۡهُۚ إِنَّ إِبۡرَٰهِيمَ لَأَوَّٰهٌ حَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "وما كان استغفار ابرٰهيم لابيه الا عن موعدة وعدها اياه فلما تبين له انه عدو لله تبرا منه ان ابرٰهيم لاوٰه حليم" ;
        quran:ayahnumber               "114" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1365" ;
        quran:page                     "205" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4507  quran:ayah_text            "رَبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُم مُّوقِنِينَ" ;
        quran:ayah_text_no_diacratic   "رب السمٰوٰت والارض وما بينهما ان كنتم موقنين" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4507" ;
        quran:page                     "496" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2269  quran:ayah_text            "قَالَ مَا مَكَّنِّي فِيهِ رَبِّي خَيۡرٞ فَأَعِينُونِي بِقُوَّةٍ أَجۡعَلۡ بَيۡنَكُمۡ وَبَيۡنَهُمۡ رَدۡمًا" ;
        quran:ayah_text_no_diacratic   "قال ما مكني فيه ربي خير فاعينوني بقوة اجعل بينكم وبينهم ردما" ;
        quran:ayahnumber               "95" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2269" ;
        quran:page                     "303" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3413  quran:ayah_text            "إِنَّمَا تَعۡبُدُونَ مِن دُونِ ٱللَّهِ أَوۡثَٰنٗا وَتَخۡلُقُونَ إِفۡكًاۚ إِنَّ ٱلَّذِينَ تَعۡبُدُونَ مِن دُونِ ٱللَّهِ لَا يَمۡلِكُونَ لَكُمۡ رِزۡقٗا فَٱبۡتَغُواْ عِندَ ٱللَّهِ ٱلرِّزۡقَ وَٱعۡبُدُوهُ وَٱشۡكُرُواْ لَهُۥٓۖ إِلَيۡهِ تُرۡجَعُونَ" ;
        quran:ayah_text_no_diacratic   "انما تعبدون من دون الله اوثٰنا وتخلقون افكا ان الذين تعبدون من دون الله لا يملكون لكم رزقا فابتغوا عند الله الرزق واعبدوه واشكروا له اليه ترجعون" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3413" ;
        quran:page                     "398" ;
