        quran:surahnumber              "37" ;
        quran:surrahname_no_diacratic  "سورة الصافات" .

quran:1669  quran:ayah_text            "قَالَ مَا خَطۡبُكُنَّ إِذۡ رَٰوَدتُّنَّ يُوسُفَ عَن نَّفۡسِهِۦۚ قُلۡنَ حَٰشَ لِلَّهِ مَا عَلِمۡنَا عَلَيۡهِ مِن سُوٓءٖۚ قَالَتِ ٱمۡرَأَتُ ٱلۡعَزِيزِ ٱلۡـَٰٔنَ حَصۡحَصَ ٱلۡحَقُّ أَنَا۠ رَٰوَدتُّهُۥ عَن نَّفۡسِهِۦ وَإِنَّهُۥ لَمِنَ ٱلصَّٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "قال ما خطبكن اذ رٰودتن يوسف عن نفسه قلن حٰش لله ما علمنا عليه من سوء قالت امرات العزيز الٰن حصحص الحق انا رٰودته عن نفسه وانه لمن الصٰدقين" ;
        quran:ayahnumber               "51" ;
        quran:chapter                  "12" ;
        quran:hizb                     "24" ;
        quran:index                    "1669" ;
        quran:page                     "241" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2813  quran:ayah_text            "ٱدۡفَعۡ بِٱلَّتِي هِيَ أَحۡسَنُ ٱلسَّيِّئَةَۚ نَحۡنُ أَعۡلَمُ بِمَا يَصِفُونَ" ;
        quran:ayah_text_no_diacratic   "ادفع بالتي هي احسن السيئة نحن اعلم بما يصفون" ;
        quran:ayahnumber               "96" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2813" ;
        quran:page                     "348" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3717  quran:ayah_text            "وَكَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ وَمَا بَلَغُواْ مِعۡشَارَ مَآ ءَاتَيۡنَٰهُمۡ فَكَذَّبُواْ رُسُلِيۖ فَكَيۡفَ كَانَ نَكِيرِ" ;
        quran:ayah_text_no_diacratic   "وكذب الذين من قبلهم وما بلغوا معشار ما ءاتينٰهم فكذبوا رسلي فكيف كان نكير" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "22" ;
