quran:4858  quran:ayah_text            "وَٱلَّذِينَ ءَامَنُواْ وَٱتَّبَعَتۡهُمۡ ذُرِّيَّتُهُم بِإِيمَٰنٍ أَلۡحَقۡنَا بِهِمۡ ذُرِّيَّتَهُمۡ وَمَآ أَلَتۡنَٰهُم مِّنۡ عَمَلِهِم مِّن شَيۡءٖۚ كُلُّ ٱمۡرِيِٕۭ بِمَا كَسَبَ رَهِينٞ" ;
        quran:ayah_text_no_diacratic   "والذين ءامنوا واتبعتهم ذريتهم بايمٰن الحقنا بهم ذريتهم وما التنٰهم من عملهم من شيء كل امري بما كسب رهين" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "27" ;
        quran:hizb                     "52" ;
        quran:index                    "4858" ;
        quran:page                     "524" ;
        quran:surahname                "سُورَةُ الطُّورِ" ;
        quran:surahnumber              "52" ;
        quran:surrahname_no_diacratic  "سورة الطور" .

quran:2860  quran:ayah_text            "إِنَّ ٱلَّذِينَ يَرۡمُونَ ٱلۡمُحۡصَنَٰتِ ٱلۡغَٰفِلَٰتِ ٱلۡمُؤۡمِنَٰتِ لُعِنُواْ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَلَهُمۡ عَذَابٌ عَظِيمٞ" ;
        quran:ayah_text_no_diacratic   "ان الذين يرمون المحصنٰت الغٰفلٰت المؤمنٰت لعنوا في الدنيا والاخرة ولهم عذاب عظيم" ;
        quran:ayahnumber               "23" ;
