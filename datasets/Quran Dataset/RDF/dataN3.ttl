        quran:hizb                     "13" ;
        quran:index                    "838" ;
        quran:page                     "132" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:648  quran:ayah_text             "۞لَّا يُحِبُّ ٱللَّهُ ٱلۡجَهۡرَ بِٱلسُّوٓءِ مِنَ ٱلۡقَوۡلِ إِلَّا مَن ظُلِمَۚ وَكَانَ ٱللَّهُ سَمِيعًا عَلِيمًا" ;
        quran:ayah_text_no_diacratic   "لا يحب الله الجهر بالسوء من القول الا من ظلم وكان الله سميعا عليما" ;
