quran:1165  quran:ayah_text            "وَإِن تَدۡعُوهُمۡ إِلَى ٱلۡهُدَىٰ لَا يَسۡمَعُواْۖ وَتَرَىٰهُمۡ يَنظُرُونَ إِلَيۡكَ وَهُمۡ لَا يُبۡصِرُونَ" ;
        quran:ayah_text_no_diacratic   "وان تدعوهم الى الهدىٰ لا يسمعوا وترىٰهم ينظرون اليك وهم لا يبصرون" ;
        quran:ayahnumber               "198" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1165" ;
        quran:page                     "176" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:873  quran:ayah_text             "وَهُوَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۖ وَيَوۡمَ يَقُولُ كُن فَيَكُونُۚ قَوۡلُهُ ٱلۡحَقُّۚ وَلَهُ ٱلۡمُلۡكُ يَوۡمَ يُنفَخُ فِي ٱلصُّورِۚ عَٰلِمُ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِۚ وَهُوَ ٱلۡحَكِيمُ ٱلۡخَبِيرُ" ;
        quran:ayah_text_no_diacratic   "وهو الذي خلق السمٰوٰت والارض بالحق ويوم يقول كن فيكون قوله الحق وله الملك يوم ينفخ في الصور عٰلم الغيب والشهٰدة وهو الحكيم الخبير" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "873" ;
        quran:page                     "136" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4307  quran:ayah_text            "۞قُلۡ أَئِنَّكُمۡ لَتَكۡفُرُونَ بِٱلَّذِي خَلَقَ ٱلۡأَرۡضَ فِي يَوۡمَيۡنِ وَتَجۡعَلُونَ لَهُۥٓ أَندَادٗاۚ ذَٰلِكَ رَبُّ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "قل ائنكم لتكفرون بالذي خلق الارض في يومين وتجعلون له اندادا ذٰلك رب العٰلمين" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4307" ;
        quran:page                     "477" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2069  quran:ayah_text            "عَسَىٰ رَبُّكُمۡ أَن يَرۡحَمَكُمۡۚ وَإِنۡ عُدتُّمۡ عُدۡنَاۚ وَجَعَلۡنَا جَهَنَّمَ لِلۡكَٰفِرِينَ حَصِيرًا" ;
        quran:ayah_text_no_diacratic   "عسىٰ ربكم ان يرحمكم وان عدتم عدنا وجعلنا جهنم للكٰفرين حصيرا" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2069" ;
        quran:page                     "283" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3213  quran:ayah_text            "هُدٗى وَبُشۡرَىٰ لِلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "هدى وبشرىٰ للمؤمنين" ;
