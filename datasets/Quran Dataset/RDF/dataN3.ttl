        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3352" ;
        quran:page                     "391" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4256  quran:ayah_text            "فَوَقَىٰهُ ٱللَّهُ سَيِّـَٔاتِ مَا مَكَرُواْۖ وَحَاقَ بِـَٔالِ فِرۡعَوۡنَ سُوٓءُ ٱلۡعَذَابِ" ;
        quran:ayah_text_no_diacratic   "فوقىٰه الله سيات ما مكروا وحاق بال فرعون سوء العذاب" ;
