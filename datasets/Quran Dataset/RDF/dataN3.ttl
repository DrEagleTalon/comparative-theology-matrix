        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:5229  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا قِيلَ لَكُمۡ تَفَسَّحُواْ فِي ٱلۡمَجَٰلِسِ فَٱفۡسَحُواْ يَفۡسَحِ ٱللَّهُ لَكُمۡۖ وَإِذَا قِيلَ ٱنشُزُواْ فَٱنشُزُواْ يَرۡفَعِ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ مِنكُمۡ وَٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ دَرَجَٰتٖۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا اذا قيل لكم تفسحوا في المجٰلس فافسحوا يفسح الله لكم واذا قيل انشزوا فانشزوا يرفع الله الذين ءامنوا منكم والذين اوتوا العلم درجٰت والله بما تعملون خبير" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5229" ;
        quran:page                     "543" ;
        quran:surahname                "سُورَةُ المُجَادلَةِ" ;
        quran:surahnumber              "58" ;
        quran:surrahname_no_diacratic  "سورة المجادلة" .

quran:3231  quran:ayah_text            "وَتَفَقَّدَ ٱلطَّيۡرَ فَقَالَ مَالِيَ لَآ أَرَى ٱلۡهُدۡهُدَ أَمۡ كَانَ مِنَ ٱلۡغَآئِبِينَ" ;
        quran:ayah_text_no_diacratic   "وتفقد الطير فقال مالي لا ارى الهدهد ام كان من الغائبين" ;
