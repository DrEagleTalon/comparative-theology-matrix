        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2611  quran:ayah_text            "فَٱسۡتَجَبۡنَا لَهُۥ وَنَجَّيۡنَٰهُ مِنَ ٱلۡغَمِّۚ وَكَذَٰلِكَ نُـۨجِي ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "فاستجبنا له ونجينٰه من الغم وكذٰلك نجي المؤمنين" ;
        quran:ayahnumber               "88" ;
        quran:chapter                  "17" ;
