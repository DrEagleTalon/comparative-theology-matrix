quran:1741  quran:ayah_text            "سَوَآءٞ مِّنكُم مَّنۡ أَسَرَّ ٱلۡقَوۡلَ وَمَن جَهَرَ بِهِۦ وَمَنۡ هُوَ مُسۡتَخۡفِۭ بِٱلَّيۡلِ وَسَارِبُۢ بِٱلنَّهَارِ" ;
        quran:ayah_text_no_diacratic   "سواء منكم من اسر القول ومن جهر به ومن هو مستخف باليل وسارب بالنهار" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1741" ;
        quran:page                     "250" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:3739  quran:ayah_text            "وَٱللَّهُ خَلَقَكُم مِّن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ جَعَلَكُمۡ أَزۡوَٰجٗاۚ وَمَا تَحۡمِلُ مِنۡ أُنثَىٰ وَلَا تَضَعُ إِلَّا بِعِلۡمِهِۦۚ وَمَا يُعَمَّرُ مِن مُّعَمَّرٖ وَلَا يُنقَصُ مِنۡ عُمُرِهِۦٓ إِلَّا فِي كِتَٰبٍۚ إِنَّ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٞ" ;
        quran:ayah_text_no_diacratic   "والله خلقكم من تراب ثم من نطفة ثم جعلكم ازوٰجا وما تحمل من انثىٰ ولا تضع الا بعلمه وما يعمر من معمر ولا ينقص من عمره الا في كتٰب ان ذٰلك على الله يسير" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3739" ;
        quran:page                     "435" ;
        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:2645  quran:ayah_text            "وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَلَا هُدٗى وَلَا كِتَٰبٖ مُّنِيرٖ" ;
        quran:ayah_text_no_diacratic   "ومن الناس من يجٰدل في الله بغير علم ولا هدى ولا كتٰب منير" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2645" ;
        quran:page                     "333" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

