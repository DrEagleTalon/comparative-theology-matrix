quran:1586  quran:ayah_text            "وَيَٰقَوۡمِ ٱعۡمَلُواْ عَلَىٰ مَكَانَتِكُمۡ إِنِّي عَٰمِلٞۖ سَوۡفَ تَعۡلَمُونَ مَن يَأۡتِيهِ عَذَابٞ يُخۡزِيهِ وَمَنۡ هُوَ كَٰذِبٞۖ وَٱرۡتَقِبُوٓاْ إِنِّي مَعَكُمۡ رَقِيبٞ" ;
        quran:ayah_text_no_diacratic   "ويٰقوم اعملوا علىٰ مكانتكم اني عٰمل سوف تعلمون من ياتيه عذاب يخزيه ومن هو كٰذب وارتقبوا اني معكم رقيب" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1586" ;
        quran:page                     "232" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2730  quran:ayah_text            "ثُمَّ جَعَلۡنَٰهُ نُطۡفَةٗ فِي قَرَارٖ مَّكِينٖ" ;
