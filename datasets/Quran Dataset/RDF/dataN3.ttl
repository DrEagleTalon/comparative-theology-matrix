        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1172  quran:ayah_text            "وَٱذۡكُر رَّبَّكَ فِي نَفۡسِكَ تَضَرُّعٗا وَخِيفَةٗ وَدُونَ ٱلۡجَهۡرِ مِنَ ٱلۡقَوۡلِ بِٱلۡغُدُوِّ وَٱلۡأٓصَالِ وَلَا تَكُن مِّنَ ٱلۡغَٰفِلِينَ" ;
        quran:ayah_text_no_diacratic   "واذكر ربك في نفسك تضرعا وخيفة ودون الجهر من القول بالغدو والاصال ولا تكن من الغٰفلين" ;
        quran:ayahnumber               "205" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1172" ;
        quran:page                     "176" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:880  quran:ayah_text             "وَحَآجَّهُۥ قَوۡمُهُۥۚ قَالَ أَتُحَٰٓجُّوٓنِّي فِي ٱللَّهِ وَقَدۡ هَدَىٰنِۚ وَلَآ أَخَافُ مَا تُشۡرِكُونَ بِهِۦٓ إِلَّآ أَن يَشَآءَ رَبِّي شَيۡـٔٗاۚ وَسِعَ رَبِّي كُلَّ شَيۡءٍ عِلۡمًاۚ أَفَلَا تَتَذَكَّرُونَ" ;
        quran:ayah_text_no_diacratic   "وحاجه قومه قال اتحٰجوني في الله وقد هدىٰن ولا اخاف ما تشركون به الا ان يشاء ربي شيا وسع ربي كل شيء علما افلا تتذكرون" ;
        quran:ayahnumber               "80" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "880" ;
        quran:page                     "137" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:4314  quran:ayah_text            "فَأَرۡسَلۡنَا عَلَيۡهِمۡ رِيحٗا صَرۡصَرٗا فِيٓ أَيَّامٖ نَّحِسَاتٖ لِّنُذِيقَهُمۡ عَذَابَ ٱلۡخِزۡيِ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَخۡزَىٰۖ وَهُمۡ لَا يُنصَرُونَ" ;
        quran:ayah_text_no_diacratic   "فارسلنا عليهم ريحا صرصرا في ايام نحسات لنذيقهم عذاب الخزي في الحيوٰة الدنيا ولعذاب الاخرة اخزىٰ وهم لا ينصرون" ;
        quran:ayahnumber               "16" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4314" ;
        quran:page                     "478" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2076  quran:ayah_text            "مَّنِ ٱهۡتَدَىٰ فَإِنَّمَا يَهۡتَدِي لِنَفۡسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيۡهَاۚ وَلَا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰۗ وَمَا كُنَّا مُعَذِّبِينَ حَتَّىٰ نَبۡعَثَ رَسُولٗا" ;
        quran:ayah_text_no_diacratic   "من اهتدىٰ فانما يهتدي لنفسه ومن ضل فانما يضل عليها ولا تزر وازرة وزر اخرىٰ وما كنا معذبين حتىٰ نبعث رسولا" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2076" ;
        quran:page                     "283" ;
