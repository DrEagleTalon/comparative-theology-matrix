        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1206  quran:ayah_text            "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُنَا قَالُواْ قَدۡ سَمِعۡنَا لَوۡ نَشَآءُ لَقُلۡنَا مِثۡلَ هَٰذَآ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "واذا تتلىٰ عليهم ءايٰتنا قالوا قد سمعنا لو نشاء لقلنا مثل هٰذا ان هٰذا الا اسٰطير الاولين" ;
        quran:ayahnumber               "31" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1206" ;
        quran:page                     "180" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:914  quran:ayah_text             "أَفَغَيۡرَ ٱللَّهِ أَبۡتَغِي حَكَمٗا وَهُوَ ٱلَّذِيٓ أَنزَلَ إِلَيۡكُمُ ٱلۡكِتَٰبَ مُفَصَّلٗاۚ وَٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَعۡلَمُونَ أَنَّهُۥ مُنَزَّلٞ مِّن رَّبِّكَ بِٱلۡحَقِّۖ فَلَا تَكُونَنَّ مِنَ ٱلۡمُمۡتَرِينَ" ;
        quran:ayah_text_no_diacratic   "افغير الله ابتغي حكما وهو الذي انزل اليكم الكتٰب مفصلا والذين ءاتينٰهم الكتٰب يعلمون انه منزل من ربك بالحق فلا تكونن من الممترين" ;
        quran:ayahnumber               "114" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "914" ;
        quran:page                     "142" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1016  quran:ayah_text            "أَهَٰٓؤُلَآءِ ٱلَّذِينَ أَقۡسَمۡتُمۡ لَا يَنَالُهُمُ ٱللَّهُ بِرَحۡمَةٍۚ ٱدۡخُلُواْ ٱلۡجَنَّةَ لَا خَوۡفٌ عَلَيۡكُمۡ وَلَآ أَنتُمۡ تَحۡزَنُونَ" ;
        quran:ayah_text_no_diacratic   "اهٰؤلاء الذين اقسمتم لا ينالهم الله برحمة ادخلوا الجنة لا خوف عليكم ولا انتم تحزنون" ;
        quran:ayahnumber               "49" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1016" ;
        quran:page                     "156" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:724  quran:ayah_text             "وَقَفَّيۡنَا عَلَىٰٓ ءَاثَٰرِهِم بِعِيسَى ٱبۡنِ مَرۡيَمَ مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ مِنَ ٱلتَّوۡرَىٰةِۖ وَءَاتَيۡنَٰهُ ٱلۡإِنجِيلَ فِيهِ هُدٗى وَنُورٞ وَمُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ مِنَ ٱلتَّوۡرَىٰةِ وَهُدٗى وَمَوۡعِظَةٗ لِّلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "وقفينا علىٰ ءاثٰرهم بعيسى ابن مريم مصدقا لما بين يديه من التورىٰة وءاتينٰه الانجيل فيه هدى ونور ومصدقا لما بين يديه من التورىٰة وهدى وموعظة للمتقين" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "724" ;
        quran:page                     "116" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:534  quran:ayah_text             "ٱلرِّجَالُ قَوَّٰمُونَ عَلَى ٱلنِّسَآءِ بِمَا فَضَّلَ ٱللَّهُ بَعۡضَهُمۡ عَلَىٰ بَعۡضٖ وَبِمَآ أَنفَقُواْ مِنۡ أَمۡوَٰلِهِمۡۚ فَٱلصَّٰلِحَٰتُ قَٰنِتَٰتٌ حَٰفِظَٰتٞ لِّلۡغَيۡبِ بِمَا حَفِظَ ٱللَّهُۚ وَٱلَّٰتِي تَخَافُونَ نُشُوزَهُنَّ فَعِظُوهُنَّ وَٱهۡجُرُوهُنَّ فِي ٱلۡمَضَاجِعِ وَٱضۡرِبُوهُنَّۖ فَإِنۡ أَطَعۡنَكُمۡ فَلَا تَبۡغُواْ عَلَيۡهِنَّ سَبِيلًاۗ إِنَّ ٱللَّهَ كَانَ عَلِيّٗا كَبِيرٗا" ;
        quran:ayah_text_no_diacratic   "الرجال قوٰمون على النساء بما فضل الله بعضهم علىٰ بعض وبما انفقوا من اموٰلهم فالصٰلحٰت قٰنتٰت حٰفظٰت للغيب بما حفظ الله والٰتي تخافون نشوزهن فعظوهن واهجروهن في المضاجع واضربوهن فان اطعنكم فلا تبغوا عليهن سبيلا ان الله كان عليا كبيرا" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "534" ;
        quran:page                     "84" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:344  quran:ayah_text             "وَيُكَلِّمُ ٱلنَّاسَ فِي ٱلۡمَهۡدِ وَكَهۡلٗا وَمِنَ ٱلصَّٰلِحِينَ" ;
        quran:ayah_text_no_diacratic   "ويكلم الناس في المهد وكهلا ومن الصٰلحين" ;
