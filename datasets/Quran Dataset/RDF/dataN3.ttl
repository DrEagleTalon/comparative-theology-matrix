        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1099  quran:ayah_text            "وَقَالُواْ مَهۡمَا تَأۡتِنَا بِهِۦ مِنۡ ءَايَةٖ لِّتَسۡحَرَنَا بِهَا فَمَا نَحۡنُ لَكَ بِمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "وقالوا مهما تاتنا به من ءاية لتسحرنا بها فما نحن لك بمؤمنين" ;
