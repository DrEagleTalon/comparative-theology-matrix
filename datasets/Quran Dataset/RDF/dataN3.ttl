        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1176  quran:ayah_text            "يَسۡـَٔلُونَكَ عَنِ ٱلۡأَنفَالِۖ قُلِ ٱلۡأَنفَالُ لِلَّهِ وَٱلرَّسُولِۖ فَٱتَّقُواْ ٱللَّهَ وَأَصۡلِحُواْ ذَاتَ بَيۡنِكُمۡۖ وَأَطِيعُواْ ٱللَّهَ وَرَسُولَهُۥٓ إِن كُنتُم مُّؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "يسلونك عن الانفال قل الانفال لله والرسول فاتقوا الله واصلحوا ذات بينكم واطيعوا الله ورسوله ان كنتم مؤمنين" ;
        quran:ayahnumber               "1" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1176" ;
        quran:page                     "177" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:884  quran:ayah_text             "وَوَهَبۡنَا لَهُۥٓ إِسۡحَٰقَ وَيَعۡقُوبَۚ كُلًّا هَدَيۡنَاۚ وَنُوحًا هَدَيۡنَا مِن قَبۡلُۖ وَمِن ذُرِّيَّتِهِۦ دَاوُۥدَ وَسُلَيۡمَٰنَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَىٰ وَهَٰرُونَۚ وَكَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "ووهبنا له اسحٰق ويعقوب كلا هدينا ونوحا هدينا من قبل ومن ذريته داود وسليمٰن وايوب ويوسف وموسىٰ وهٰرون وكذٰلك نجزي المحسنين" ;
        quran:ayahnumber               "84" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "884" ;
        quran:page                     "138" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
