        quran:surrahname_no_diacratic  "سورة هود" .

quran:4705  quran:ayah_text            "هُوَ ٱلَّذِيٓ أَرۡسَلَ رَسُولَهُۥ بِٱلۡهُدَىٰ وَدِينِ ٱلۡحَقِّ لِيُظۡهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦۚ وَكَفَىٰ بِٱللَّهِ شَهِيدٗا" ;
        quran:ayah_text_no_diacratic   "هو الذي ارسل رسوله بالهدىٰ ودين الحق ليظهره على الدين كله وكفىٰ بالله شهيدا" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4705" ;
