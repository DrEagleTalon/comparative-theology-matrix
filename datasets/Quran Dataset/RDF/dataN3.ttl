quran:1054  quran:ayah_text            "وَإِن كَانَ طَآئِفَةٞ مِّنكُمۡ ءَامَنُواْ بِٱلَّذِيٓ أُرۡسِلۡتُ بِهِۦ وَطَآئِفَةٞ لَّمۡ يُؤۡمِنُواْ فَٱصۡبِرُواْ حَتَّىٰ يَحۡكُمَ ٱللَّهُ بَيۡنَنَاۚ وَهُوَ خَيۡرُ ٱلۡحَٰكِمِينَ" ;
        quran:ayah_text_no_diacratic   "وان كان طائفة منكم ءامنوا بالذي ارسلت به وطائفة لم يؤمنوا فاصبروا حتىٰ يحكم الله بيننا وهو خير الحٰكمين" ;
        quran:ayahnumber               "87" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1054" ;
        quran:page                     "161" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:762  quran:ayah_text             "وَمَا لَنَا لَا نُؤۡمِنُ بِٱللَّهِ وَمَا جَآءَنَا مِنَ ٱلۡحَقِّ وَنَطۡمَعُ أَن يُدۡخِلَنَا رَبُّنَا مَعَ ٱلۡقَوۡمِ ٱلصَّٰلِحِينَ" ;
        quran:ayah_text_no_diacratic   "وما لنا لا نؤمن بالله وما جاءنا من الحق ونطمع ان يدخلنا ربنا مع القوم الصٰلحين" ;
        quran:ayahnumber               "84" ;
