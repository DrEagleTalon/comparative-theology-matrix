        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4245  quran:ayah_text            "وَلَقَدۡ جَآءَكُمۡ يُوسُفُ مِن قَبۡلُ بِٱلۡبَيِّنَٰتِ فَمَا زِلۡتُمۡ فِي شَكّٖ مِّمَّا جَآءَكُم بِهِۦۖ حَتَّىٰٓ إِذَا هَلَكَ قُلۡتُمۡ لَن يَبۡعَثَ ٱللَّهُ مِنۢ بَعۡدِهِۦ رَسُولٗاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَنۡ هُوَ مُسۡرِفٞ مُّرۡتَابٌ" ;
        quran:ayah_text_no_diacratic   "ولقد جاءكم يوسف من قبل بالبينٰت فما زلتم في شك مما جاءكم به حتىٰ اذا هلك قلتم لن يبعث الله من بعده رسولا كذٰلك يضل الله من هو مسرف مرتاب" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4245" ;
