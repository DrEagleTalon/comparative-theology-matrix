        quran:surahname                "سُورَةُ الحَاقَّةِ" ;
        quran:surahnumber              "69" ;
        quran:surrahname_no_diacratic  "سورة الحاقة" .

quran:6386  quran:ayah_text            "يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ" ;
        quran:ayah_text_no_diacratic   "يحسب ان ماله اخلده" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "30" ;
        quran:hizb                     "60" ;
        quran:index                    "6386" ;
        quran:page                     "601" ;
        quran:surahname                "سُورَةُ الهُمَزَةِ" ;
        quran:surahnumber              "104" ;
        quran:surrahname_no_diacratic  "سورة الهمزة" .

quran:1557  quran:ayah_text            "وَيَٰقَوۡمِ هَٰذِهِۦ نَاقَةُ ٱللَّهِ لَكُمۡ ءَايَةٗۖ فَذَرُوهَا تَأۡكُلۡ فِيٓ أَرۡضِ ٱللَّهِۖ وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَأۡخُذَكُمۡ عَذَابٞ قَرِيبٞ" ;
        quran:ayah_text_no_diacratic   "ويٰقوم هٰذه ناقة الله لكم ءاية فذروها تاكل في ارض الله ولا تمسوها بسوء فياخذكم عذاب قريب" ;
        quran:ayahnumber               "64" ;
        quran:chapter                  "12" ;
        quran:hizb                     "23" ;
        quran:index                    "1557" ;
        quran:page                     "229" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:5292  quran:ayah_text            "هُوَ ٱلَّذِيٓ أَرۡسَلَ رَسُولَهُۥ بِٱلۡهُدَىٰ وَدِينِ ٱلۡحَقِّ لِيُظۡهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦ وَلَوۡ كَرِهَ ٱلۡمُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "هو الذي ارسل رسوله بالهدىٰ ودين الحق ليظهره على الدين كله ولو كره المشركون" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "28" ;
        quran:hizb                     "55" ;
        quran:index                    "5292" ;
        quran:page                     "552" ;
        quran:surahname                "سُورَةُ الصَّفِّ" ;
        quran:surahnumber              "61" ;
        quran:surrahname_no_diacratic  "سورة الصف" .

quran:2701  quran:ayah_text            "لَّهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ وَإِنَّ ٱللَّهَ لَهُوَ ٱلۡغَنِيُّ ٱلۡحَمِيدُ" ;
        quran:ayah_text_no_diacratic   "له ما في السمٰوٰت وما في الارض وان الله لهو الغني الحميد" ;
        quran:ayahnumber               "64" ;
        quran:chapter                  "17" ;
        quran:hizb                     "34" ;
        quran:index                    "2701" ;
        quran:page                     "339" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:6196  quran:ayah_text            "يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ" ;
