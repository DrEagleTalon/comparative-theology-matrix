        quran:surrahname_no_diacratic  "سورة مريم" .

quran:3245  quran:ayah_text            "قَالَتۡ إِنَّ ٱلۡمُلُوكَ إِذَا دَخَلُواْ قَرۡيَةً أَفۡسَدُوهَا وَجَعَلُوٓاْ أَعِزَّةَ أَهۡلِهَآ أَذِلَّةٗۚ وَكَذَٰلِكَ يَفۡعَلُونَ" ;
        quran:ayah_text_no_diacratic   "قالت ان الملوك اذا دخلوا قرية افسدوها وجعلوا اعزة اهلها اذلة وكذٰلك يفعلون" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "19" ;
        quran:hizb                     "38" ;
        quran:index                    "3245" ;
        quran:page                     "379" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:4149  quran:ayah_text            "فَٱعۡبُدُواْ مَا شِئۡتُم مِّن دُونِهِۦۗ قُلۡ إِنَّ ٱلۡخَٰسِرِينَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ وَأَهۡلِيهِمۡ يَوۡمَ ٱلۡقِيَٰمَةِۗ أَلَا ذَٰلِكَ هُوَ ٱلۡخُسۡرَانُ ٱلۡمُبِينُ" ;
        quran:ayah_text_no_diacratic   "فاعبدوا ما شئتم من دونه قل ان الخٰسرين الذين خسروا انفسهم واهليهم يوم القيٰمة الا ذٰلك هو الخسران المبين" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "23" ;
        quran:hizb                     "46" ;
        quran:index                    "4149" ;
        quran:page                     "460" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:2151  quran:ayah_text            "وَقَالُواْ لَن نُّؤۡمِنَ لَكَ حَتَّىٰ تَفۡجُرَ لَنَا مِنَ ٱلۡأَرۡضِ يَنۢبُوعًا" ;
        quran:ayah_text_no_diacratic   "وقالوا لن نؤمن لك حتىٰ تفجر لنا من الارض ينبوعا" ;
