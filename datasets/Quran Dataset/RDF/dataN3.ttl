quran:2200  quran:ayah_text            "قُلِ ٱللَّهُ أَعۡلَمُ بِمَا لَبِثُواْۖ لَهُۥ غَيۡبُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ أَبۡصِرۡ بِهِۦ وَأَسۡمِعۡۚ مَا لَهُم مِّن دُونِهِۦ مِن وَلِيّٖ وَلَا يُشۡرِكُ فِي حُكۡمِهِۦٓ أَحَدٗا" ;
        quran:ayah_text_no_diacratic   "قل الله اعلم بما لبثوا له غيب السمٰوٰت والارض ابصر به واسمع ما لهم من دونه من ولي ولا يشرك في حكمه احدا" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2200" ;
        quran:page                     "296" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3104  quran:ayah_text            "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ" ;
        quran:ayah_text_no_diacratic   "وان ربك لهو العزيز الرحيم" ;
