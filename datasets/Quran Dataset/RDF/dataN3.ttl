        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2103  quran:ayah_text            "قُل لَّوۡ كَانَ مَعَهُۥٓ ءَالِهَةٞ كَمَا يَقُولُونَ إِذٗا لَّٱبۡتَغَوۡاْ إِلَىٰ ذِي ٱلۡعَرۡشِ سَبِيلٗا" ;
        quran:ayah_text_no_diacratic   "قل لو كان معه ءالهة كما يقولون اذا لابتغوا الىٰ ذي العرش سبيلا" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2103" ;
