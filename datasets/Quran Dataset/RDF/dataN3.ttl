quran:3604  quran:ayah_text            "وَإِذۡ أَخَذۡنَا مِنَ ٱلنَّبِيِّـۧنَ مِيثَٰقَهُمۡ وَمِنكَ وَمِن نُّوحٖ وَإِبۡرَٰهِيمَ وَمُوسَىٰ وَعِيسَى ٱبۡنِ مَرۡيَمَۖ وَأَخَذۡنَا مِنۡهُم مِّيثَٰقًا غَلِيظٗا" ;
        quran:ayah_text_no_diacratic   "واذ اخذنا من النبين ميثٰقهم ومنك ومن نوح وابرٰهيم وموسىٰ وعيسى ابن مريم واخذنا منهم ميثٰقا غليظا" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3604" ;
        quran:page                     "419" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1366  quran:ayah_text            "وَمَا كَانَ ٱللَّهُ لِيُضِلَّ قَوۡمَۢا بَعۡدَ إِذۡ هَدَىٰهُمۡ حَتَّىٰ يُبَيِّنَ لَهُم مَّا يَتَّقُونَۚ إِنَّ ٱللَّهَ بِكُلِّ شَيۡءٍ عَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "وما كان الله ليضل قوما بعد اذ هدىٰهم حتىٰ يبين لهم ما يتقون ان الله بكل شيء عليم" ;
        quran:ayahnumber               "115" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1366" ;
        quran:page                     "205" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2510  quran:ayah_text            "وَمَنۡ أَعۡرَضَ عَن ذِكۡرِي فَإِنَّ لَهُۥ مَعِيشَةٗ ضَنكٗا وَنَحۡشُرُهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ أَعۡمَىٰ" ;
        quran:ayah_text_no_diacratic   "ومن اعرض عن ذكري فان له معيشة ضنكا ونحشره يوم القيٰمة اعمىٰ" ;
        quran:ayahnumber               "124" ;
        quran:chapter                  "16" ;
        quran:hizb                     "32" ;
        quran:index                    "2510" ;
        quran:page                     "320" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:4508  quran:ayah_text            "لَآ إِلَٰهَ إِلَّا هُوَ يُحۡيِۦ وَيُمِيتُۖ رَبُّكُمۡ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "لا الٰه الا هو يحي ويميت ربكم ورب ءابائكم الاولين" ;
