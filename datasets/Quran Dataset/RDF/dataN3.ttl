        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3515  quran:ayah_text            "ٱللَّهُ ٱلَّذِي يُرۡسِلُ ٱلرِّيَٰحَ فَتُثِيرُ سَحَابٗا فَيَبۡسُطُهُۥ فِي ٱلسَّمَآءِ كَيۡفَ يَشَآءُ وَيَجۡعَلُهُۥ كِسَفٗا فَتَرَى ٱلۡوَدۡقَ يَخۡرُجُ مِنۡ خِلَٰلِهِۦۖ فَإِذَآ أَصَابَ بِهِۦ مَن يَشَآءُ مِنۡ عِبَادِهِۦٓ إِذَا هُمۡ يَسۡتَبۡشِرُونَ" ;
        quran:ayah_text_no_diacratic   "الله الذي يرسل الريٰح فتثير سحابا فيبسطه في السماء كيف يشاء ويجعله كسفا فترى الودق يخرج من خلٰله فاذا اصاب به من يشاء من عباده اذا هم يستبشرون" ;
        quran:ayahnumber               "48" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3515" ;
        quran:page                     "409" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1277  quran:ayah_text            "ثُمَّ أَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلۡمُؤۡمِنِينَ وَأَنزَلَ جُنُودٗا لَّمۡ تَرَوۡهَا وَعَذَّبَ ٱلَّذِينَ كَفَرُواْۚ وَذَٰلِكَ جَزَآءُ ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "ثم انزل الله سكينته علىٰ رسوله وعلى المؤمنين وانزل جنودا لم تروها وعذب الذين كفروا وذٰلك جزاء الكٰفرين" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1277" ;
        quran:page                     "190" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:985  quran:ayah_text             "قَالَ ٱخۡرُجۡ مِنۡهَا مَذۡءُومٗا مَّدۡحُورٗاۖ لَّمَن تَبِعَكَ مِنۡهُمۡ لَأَمۡلَأَنَّ جَهَنَّمَ مِنكُمۡ أَجۡمَعِينَ" ;
        quran:ayah_text_no_diacratic   "قال اخرج منها مذءوما مدحورا لمن تبعك منهم لاملان جهنم منكم اجمعين" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "8" ;
