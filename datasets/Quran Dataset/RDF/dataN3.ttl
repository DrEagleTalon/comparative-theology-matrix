        quran:surahname                "سُورَةُ الرَّحۡمَٰن" ;
        quran:surahnumber              "55" ;
        quran:surrahname_no_diacratic  "سورة الرحمٰن" .

quran:6220  quran:ayah_text            "وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ" ;
        quran:ayah_text_no_diacratic   "والذين كفروا بايٰتنا هم اصحٰب المشمة" ;
        quran:ayahnumber               "19" ;
        quran:chapter                  "30" ;
        quran:hizb                     "59" ;
        quran:index                    "6220" ;
        quran:page                     "595" ;
        quran:surahname                "سُورَةُ البَلَدِ" ;
        quran:surahnumber              "90" ;
        quran:surrahname_no_diacratic  "سورة البلد" .

quran:859  quran:ayah_text             "۞وَعِندَهُۥ مَفَاتِحُ ٱلۡغَيۡبِ لَا يَعۡلَمُهَآ إِلَّا هُوَۚ وَيَعۡلَمُ مَا فِي ٱلۡبَرِّ وَٱلۡبَحۡرِۚ وَمَا تَسۡقُطُ مِن وَرَقَةٍ إِلَّا يَعۡلَمُهَا وَلَا حَبَّةٖ فِي ظُلُمَٰتِ ٱلۡأَرۡضِ وَلَا رَطۡبٖ وَلَا يَابِسٍ إِلَّا فِي كِتَٰبٖ مُّبِينٖ" ;
        quran:ayah_text_no_diacratic   "وعنده مفاتح الغيب لا يعلمها الا هو ويعلم ما في البر والبحر وما تسقط من ورقة الا يعلمها ولا حبة في ظلمٰت الارض ولا رطب ولا يابس الا في كتٰب مبين" ;
        quran:ayahnumber               "59" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "859" ;
        quran:page                     "134" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:6030  quran:ayah_text            "كَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ" ;
        quran:ayah_text_no_diacratic   "كلا ان كتٰب الابرار لفي عليين" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "30" ;
        quran:hizb                     "58" ;
        quran:index                    "6030" ;
        quran:page                     "588" ;
        quran:surahname                "سُورَةُ المُطَفِّفِينَ" ;
        quran:surahnumber              "83" ;
        quran:surrahname_no_diacratic  "سورة المطففين" .

quran:70  quran:ayah_text              "۞وَإِذِ ٱسۡتَسۡقَىٰ مُوسَىٰ لِقَوۡمِهِۦ فَقُلۡنَا ٱضۡرِب بِّعَصَاكَ ٱلۡحَجَرَۖ فَٱنفَجَرَتۡ مِنۡهُ ٱثۡنَتَا عَشۡرَةَ عَيۡنٗاۖ قَدۡ عَلِمَ كُلُّ أُنَاسٖ مَّشۡرَبَهُمۡۖ كُلُواْ وَٱشۡرَبُواْ مِن رِّزۡقِ ٱللَّهِ وَلَا تَعۡثَوۡاْ فِي ٱلۡأَرۡضِ مُفۡسِدِينَ" ;
        quran:ayah_text_no_diacratic   "واذ استسقىٰ موسىٰ لقومه فقلنا اضرب بعصاك الحجر فانفجرت منه اثنتا عشرة عينا قد علم كل اناس مشربهم كلوا واشربوا من رزق الله ولا تعثوا في الارض مفسدين" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "70" ;
        quran:page                     "9" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1201  quran:ayah_text            "وَٱذۡكُرُوٓاْ إِذۡ أَنتُمۡ قَلِيلٞ مُّسۡتَضۡعَفُونَ فِي ٱلۡأَرۡضِ تَخَافُونَ أَن يَتَخَطَّفَكُمُ ٱلنَّاسُ فَـَٔاوَىٰكُمۡ وَأَيَّدَكُم بِنَصۡرِهِۦ وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِ لَعَلَّكُمۡ تَشۡكُرُونَ" ;
        quran:ayah_text_no_diacratic   "واذكروا اذ انتم قليل مستضعفون في الارض تخافون ان يتخطفكم الناس فاوىٰكم وايدكم بنصره ورزقكم من الطيبٰت لعلكم تشكرون" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1201" ;
        quran:page                     "180" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:669  quran:ayah_text             "إِلَّا طَرِيقَ جَهَنَّمَ خَٰلِدِينَ فِيهَآ أَبَدٗاۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٗا" ;
        quran:ayah_text_no_diacratic   "الا طريق جهنم خٰلدين فيها ابدا وكان ذٰلك على الله يسيرا" ;
        quran:ayahnumber               "169" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "669" ;
        quran:page                     "104" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2105  quran:ayah_text            "تُسَبِّحُ لَهُ ٱلسَّمَٰوَٰتُ ٱلسَّبۡعُ وَٱلۡأَرۡضُ وَمَن فِيهِنَّۚ وَإِن مِّن شَيۡءٍ إِلَّا يُسَبِّحُ بِحَمۡدِهِۦ وَلَٰكِن لَّا تَفۡقَهُونَ تَسۡبِيحَهُمۡۚ إِنَّهُۥ كَانَ حَلِيمًا غَفُورٗا" ;
        quran:ayah_text_no_diacratic   "تسبح له السمٰوٰت السبع والارض ومن فيهن وان من شيء الا يسبح بحمده ولٰكن لا تفقهون تسبيحهم انه كان حليما غفورا" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2105" ;
        quran:page                     "286" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3009  quran:ayah_text            "قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِيٓ أُرۡسِلَ إِلَيۡكُمۡ لَمَجۡنُونٞ" ;
        quran:ayah_text_no_diacratic   "قال ان رسولكم الذي ارسل اليكم لمجنون" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "3009" ;
        quran:page                     "368" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:1011  quran:ayah_text            "وَنَادَىٰٓ أَصۡحَٰبُ ٱلۡجَنَّةِ أَصۡحَٰبَ ٱلنَّارِ أَن قَدۡ وَجَدۡنَا مَا وَعَدَنَا رَبُّنَا حَقّٗا فَهَلۡ وَجَدتُّم مَّا وَعَدَ رَبُّكُمۡ حَقّٗاۖ قَالُواْ نَعَمۡۚ فَأَذَّنَ مُؤَذِّنُۢ بَيۡنَهُمۡ أَن لَّعۡنَةُ ٱللَّهِ عَلَى ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "ونادىٰ اصحٰب الجنة اصحٰب النار ان قد وجدنا ما وعدنا ربنا حقا فهل وجدتم ما وعد ربكم حقا قالوا نعم فاذن مؤذن بينهم ان لعنة الله على الظٰلمين" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1011" ;
        quran:page                     "156" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:479  quran:ayah_text             "لَّقَدۡ سَمِعَ ٱللَّهُ قَوۡلَ ٱلَّذِينَ قَالُوٓاْ إِنَّ ٱللَّهَ فَقِيرٞ وَنَحۡنُ أَغۡنِيَآءُۘ سَنَكۡتُبُ مَا قَالُواْ وَقَتۡلَهُمُ ٱلۡأَنۢبِيَآءَ بِغَيۡرِ حَقّٖ وَنَقُولُ ذُوقُواْ عَذَابَ ٱلۡحَرِيقِ" ;
        quran:ayah_text_no_diacratic   "لقد سمع الله قول الذين قالوا ان الله فقير ونحن اغنياء سنكتب ما قالوا وقتلهم الانبياء بغير حق ونقول ذوقوا عذاب الحريق" ;
        quran:ayahnumber               "181" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "479" ;
        quran:page                     "74" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:289  quran:ayah_text             "فَإِن لَّمۡ تَفۡعَلُواْ فَأۡذَنُواْ بِحَرۡبٖ مِّنَ ٱللَّهِ وَرَسُولِهِۦۖ وَإِن تُبۡتُمۡ فَلَكُمۡ رُءُوسُ أَمۡوَٰلِكُمۡ لَا تَظۡلِمُونَ وَلَا تُظۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "فان لم تفعلوا فاذنوا بحرب من الله ورسوله وان تبتم فلكم رءوس اموٰلكم لا تظلمون ولا تظلمون" ;
        quran:ayahnumber               "279" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "289" ;
        quran:page                     "47" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1943  quran:ayah_text            "وَسَخَّرَ لَكُمُ ٱلَّيۡلَ وَٱلنَّهَارَ وَٱلشَّمۡسَ وَٱلۡقَمَرَۖ وَٱلنُّجُومُ مُسَخَّرَٰتُۢ بِأَمۡرِهِۦٓۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "وسخر لكم اليل والنهار والشمس والقمر والنجوم مسخرٰت بامره ان في ذٰلك لايٰت لقوم يعقلون" ;
        quran:ayahnumber               "12" ;
        quran:chapter                  "14" ;
        quran:hizb                     "26" ;
        quran:index                    "1943" ;
        quran:page                     "268" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2847  quran:ayah_text            "وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ وَأَنَّ ٱللَّهَ تَوَّابٌ حَكِيمٌ" ;
        quran:ayah_text_no_diacratic   "ولولا فضل الله عليكم ورحمته وان الله تواب حكيم" ;
        quran:ayahnumber               "10" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2847" ;
        quran:page                     "350" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:1753  quran:ayah_text            "وَٱلَّذِينَ صَبَرُواْ ٱبۡتِغَآءَ وَجۡهِ رَبِّهِمۡ وَأَقَامُواْ ٱلصَّلَوٰةَ وَأَنفَقُواْ مِمَّا رَزَقۡنَٰهُمۡ سِرّٗا وَعَلَانِيَةٗ وَيَدۡرَءُونَ بِٱلۡحَسَنَةِ ٱلسَّيِّئَةَ أُوْلَٰٓئِكَ لَهُمۡ عُقۡبَى ٱلدَّارِ" ;
        quran:ayah_text_no_diacratic   "والذين صبروا ابتغاء وجه ربهم واقاموا الصلوٰة وانفقوا مما رزقنٰهم سرا وعلانية ويدرءون بالحسنة السيئة اولٰئك لهم عقبى الدار" ;
        quran:ayahnumber               "22" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1753" ;
        quran:page                     "252" ;
        quran:surahname                "سُورَةُ الرَّعۡدِ" ;
        quran:surahnumber              "13" ;
        quran:surrahname_no_diacratic  "سورة الرعد" .

quran:2657  quran:ayah_text            "يُصۡهَرُ بِهِۦ مَا فِي بُطُونِهِمۡ وَٱلۡجُلُودُ" ;
        quran:ayah_text_no_diacratic   "يصهر به ما في بطونهم والجلود" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2657" ;
        quran:page                     "334" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:6392  quran:ayah_text            "فِي عَمَدٖ مُّمَدَّدَةِۭ" ;
        quran:ayah_text_no_diacratic   "في عمد ممددة" ;
        quran:ayahnumber               "9" ;
        quran:chapter                  "30" ;
        quran:hizb                     "60" ;
        quran:index                    "6392" ;
        quran:page                     "601" ;
