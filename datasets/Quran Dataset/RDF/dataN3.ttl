        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3625  quran:ayah_text            "يَٰٓأَيُّهَا ٱلنَّبِيُّ قُل لِّأَزۡوَٰجِكَ إِن كُنتُنَّ تُرِدۡنَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا وَزِينَتَهَا فَتَعَالَيۡنَ أُمَتِّعۡكُنَّ وَأُسَرِّحۡكُنَّ سَرَاحٗا جَمِيلٗا" ;
        quran:ayah_text_no_diacratic   "يٰايها النبي قل لازوٰجك ان كنتن تردن الحيوٰة الدنيا وزينتها فتعالين امتعكن واسرحكن سراحا جميلا" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "21" ;
        quran:hizb                     "42" ;
        quran:index                    "3625" ;
        quran:page                     "421" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1387  quran:ayah_text            "هُوَ ٱلَّذِي جَعَلَ ٱلشَّمۡسَ ضِيَآءٗ وَٱلۡقَمَرَ نُورٗا وَقَدَّرَهُۥ مَنَازِلَ لِتَعۡلَمُواْ عَدَدَ ٱلسِّنِينَ وَٱلۡحِسَابَۚ مَا خَلَقَ ٱللَّهُ ذَٰلِكَ إِلَّا بِٱلۡحَقِّۚ يُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "هو الذي جعل الشمس ضياء والقمر نورا وقدره منازل لتعلموا عدد السنين والحساب ما خلق الله ذٰلك الا بالحق يفصل الايٰت لقوم يعلمون" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1387" ;
        quran:page                     "208" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2531  quran:ayah_text            "وَمَا جَعَلۡنَٰهُمۡ جَسَدٗا لَّا يَأۡكُلُونَ ٱلطَّعَامَ وَمَا كَانُواْ خَٰلِدِينَ" ;
        quran:ayah_text_no_diacratic   "وما جعلنٰهم جسدا لا ياكلون الطعام وما كانوا خٰلدين" ;
        quran:ayahnumber               "8" ;
        quran:chapter                  "17" ;
        quran:hizb                     "32" ;
        quran:index                    "2531" ;
        quran:page                     "322" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:4529  quran:ayah_text            "فَمَا بَكَتۡ عَلَيۡهِمُ ٱلسَّمَآءُ وَٱلۡأَرۡضُ وَمَا كَانُواْ مُنظَرِينَ" ;
        quran:ayah_text_no_diacratic   "فما بكت عليهم السماء والارض وما كانوا منظرين" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "25" ;
