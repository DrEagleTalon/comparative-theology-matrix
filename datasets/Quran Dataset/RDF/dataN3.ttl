        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:303  quran:ayah_text             "إِنَّ ٱللَّهَ لَا يَخۡفَىٰ عَلَيۡهِ شَيۡءٞ فِي ٱلۡأَرۡضِ وَلَا فِي ٱلسَّمَآءِ" ;
        quran:ayah_text_no_diacratic   "ان الله لا يخفىٰ عليه شيء في الارض ولا في السماء" ;
