quran:1400  quran:ayah_text            "وَيَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَضُرُّهُمۡ وَلَا يَنفَعُهُمۡ وَيَقُولُونَ هَٰٓؤُلَآءِ شُفَعَٰٓؤُنَا عِندَ ٱللَّهِۚ قُلۡ أَتُنَبِّـُٔونَ ٱللَّهَ بِمَا لَا يَعۡلَمُ فِي ٱلسَّمَٰوَٰتِ وَلَا فِي ٱلۡأَرۡضِۚ سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ" ;
        quran:ayah_text_no_diacratic   "ويعبدون من دون الله ما لا يضرهم ولا ينفعهم ويقولون هٰؤلاء شفعٰؤنا عند الله قل اتنبون الله بما لا يعلم في السمٰوٰت ولا في الارض سبحٰنه وتعٰلىٰ عما يشركون" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1400" ;
        quran:page                     "210" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:868  quran:ayah_text             "وَإِذَا رَأَيۡتَ ٱلَّذِينَ يَخُوضُونَ فِيٓ ءَايَٰتِنَا فَأَعۡرِضۡ عَنۡهُمۡ حَتَّىٰ يَخُوضُواْ فِي حَدِيثٍ غَيۡرِهِۦۚ وَإِمَّا يُنسِيَنَّكَ ٱلشَّيۡطَٰنُ فَلَا تَقۡعُدۡ بَعۡدَ ٱلذِّكۡرَىٰ مَعَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "واذا رايت الذين يخوضون في ءايٰتنا فاعرض عنهم حتىٰ يخوضوا في حديث غيره واما ينسينك الشيطٰن فلا تقعد بعد الذكرىٰ مع القوم الظٰلمين" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "868" ;
        quran:page                     "135" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2304  quran:ayah_text            "قَالَتۡ إِنِّيٓ أَعُوذُ بِٱلرَّحۡمَٰنِ مِنكَ إِن كُنتَ تَقِيّٗا" ;
        quran:ayah_text_no_diacratic   "قالت اني اعوذ بالرحمٰن منك ان كنت تقيا" ;
        quran:ayahnumber               "18" ;
