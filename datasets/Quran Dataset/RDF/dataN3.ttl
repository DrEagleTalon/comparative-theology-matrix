        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2087  quran:ayah_text            "وَءَاتِ ذَا ٱلۡقُرۡبَىٰ حَقَّهُۥ وَٱلۡمِسۡكِينَ وَٱبۡنَ ٱلسَّبِيلِ وَلَا تُبَذِّرۡ تَبۡذِيرًا" ;
        quran:ayah_text_no_diacratic   "وءات ذا القربىٰ حقه والمسكين وابن السبيل ولا تبذر تبذيرا" ;
