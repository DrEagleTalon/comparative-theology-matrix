quran:3342  quran:ayah_text            "فَلَمَّا جَآءَهُم مُّوسَىٰ بِـَٔايَٰتِنَا بَيِّنَٰتٖ قَالُواْ مَا هَٰذَآ إِلَّا سِحۡرٞ مُّفۡتَرٗى وَمَا سَمِعۡنَا بِهَٰذَا فِيٓ ءَابَآئِنَا ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "فلما جاءهم موسىٰ بايٰتنا بينٰت قالوا ما هٰذا الا سحر مفترى وما سمعنا بهٰذا في ءابائنا الاولين" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3342" ;
        quran:page                     "390" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4246  quran:ayah_text            "ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِ ٱللَّهِ بِغَيۡرِ سُلۡطَٰنٍ أَتَىٰهُمۡۖ كَبُرَ مَقۡتًا عِندَ ٱللَّهِ وَعِندَ ٱلَّذِينَ ءَامَنُواْۚ كَذَٰلِكَ يَطۡبَعُ ٱللَّهُ عَلَىٰ كُلِّ قَلۡبِ مُتَكَبِّرٖ جَبَّارٖ" ;
        quran:ayah_text_no_diacratic   "الذين يجٰدلون في ءايٰت الله بغير سلطٰن اتىٰهم كبر مقتا عند الله وعند الذين ءامنوا كذٰلك يطبع الله علىٰ كل قلب متكبر جبار" ;
        quran:ayahnumber               "35" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4246" ;
        quran:page                     "471" ;
