        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:3228  quran:ayah_text            "وَحُشِرَ لِسُلَيۡمَٰنَ جُنُودُهُۥ مِنَ ٱلۡجِنِّ وَٱلۡإِنسِ وَٱلطَّيۡرِ فَهُمۡ يُوزَعُونَ" ;
        quran:ayah_text_no_diacratic   "وحشر لسليمٰن جنوده من الجن والانس والطير فهم يوزعون" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3228" ;
        quran:page                     "378" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:698  quran:ayah_text             "وَإِذۡ قَالَ مُوسَىٰ لِقَوۡمِهِۦ يَٰقَوۡمِ ٱذۡكُرُواْ نِعۡمَةَ ٱللَّهِ عَلَيۡكُمۡ إِذۡ جَعَلَ فِيكُمۡ أَنۢبِيَآءَ وَجَعَلَكُم مُّلُوكٗا وَءَاتَىٰكُم مَّا لَمۡ يُؤۡتِ أَحَدٗا مِّنَ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "واذ قال موسىٰ لقومه يٰقوم اذكروا نعمة الله عليكم اذ جعل فيكم انبياء وجعلكم ملوكا وءاتىٰكم ما لم يؤت احدا من العٰلمين" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "698" ;
        quran:page                     "111" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:2134  quran:ayah_text            "وَإِن كَادُواْ لَيَفۡتِنُونَكَ عَنِ ٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ لِتَفۡتَرِيَ عَلَيۡنَا غَيۡرَهُۥۖ وَإِذٗا لَّٱتَّخَذُوكَ خَلِيلٗا" ;
        quran:ayah_text_no_diacratic   "وان كادوا ليفتنونك عن الذي اوحينا اليك لتفتري علينا غيره واذا لاتخذوك خليلا" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2134" ;
        quran:page                     "289" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3038  quran:ayah_text            "وَإِنَّا لَجَمِيعٌ حَٰذِرُونَ" ;
        quran:ayah_text_no_diacratic   "وانا لجميع حٰذرون" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3038" ;
        quran:page                     "369" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:1040  quran:ayah_text            "وَإِلَىٰ ثَمُودَ أَخَاهُمۡ صَٰلِحٗاۚ قَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥۖ قَدۡ جَآءَتۡكُم بَيِّنَةٞ مِّن رَّبِّكُمۡۖ هَٰذِهِۦ نَاقَةُ ٱللَّهِ لَكُمۡ ءَايَةٗۖ فَذَرُوهَا تَأۡكُلۡ فِيٓ أَرۡضِ ٱللَّهِۖ وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَأۡخُذَكُمۡ عَذَابٌ أَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "والىٰ ثمود اخاهم صٰلحا قال يٰقوم اعبدوا الله ما لكم من الٰه غيره قد جاءتكم بينة من ربكم هٰذه ناقة الله لكم ءاية فذروها تاكل في ارض الله ولا تمسوها بسوء فياخذكم عذاب اليم" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1040" ;
        quran:page                     "159" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:1972  quran:ayah_text            "وَٱلَّذِينَ هَاجَرُواْ فِي ٱللَّهِ مِنۢ بَعۡدِ مَا ظُلِمُواْ لَنُبَوِّئَنَّهُمۡ فِي ٱلدُّنۡيَا حَسَنَةٗۖ وَلَأَجۡرُ ٱلۡأٓخِرَةِ أَكۡبَرُۚ لَوۡ كَانُواْ يَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "والذين هاجروا في الله من بعد ما ظلموا لنبوئنهم في الدنيا حسنة ولاجر الاخرة اكبر لو كانوا يعلمون" ;
        quran:ayahnumber               "41" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1972" ;
        quran:page                     "271" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:2876  quran:ayah_text            "وَٱلَّذِينَ كَفَرُوٓاْ أَعۡمَٰلُهُمۡ كَسَرَابِۭ بِقِيعَةٖ يَحۡسَبُهُ ٱلظَّمۡـَٔانُ مَآءً حَتَّىٰٓ إِذَا جَآءَهُۥ لَمۡ يَجِدۡهُ شَيۡـٔٗا وَوَجَدَ ٱللَّهَ عِندَهُۥ فَوَفَّىٰهُ حِسَابَهُۥۗ وَٱللَّهُ سَرِيعُ ٱلۡحِسَابِ" ;
        quran:ayah_text_no_diacratic   "والذين كفروا اعمٰلهم كسراب بقيعة يحسبه الظمان ماء حتىٰ اذا جاءه لم يجده شيا ووجد الله عنده فوفىٰه حسابه والله سريع الحساب" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2876" ;
        quran:page                     "355" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
