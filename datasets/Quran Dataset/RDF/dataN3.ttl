quran:1238  quran:ayah_text            "وَأَلَّفَ بَيۡنَ قُلُوبِهِمۡۚ لَوۡ أَنفَقۡتَ مَا فِي ٱلۡأَرۡضِ جَمِيعٗا مَّآ أَلَّفۡتَ بَيۡنَ قُلُوبِهِمۡ وَلَٰكِنَّ ٱللَّهَ أَلَّفَ بَيۡنَهُمۡۚ إِنَّهُۥ عَزِيزٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "والف بين قلوبهم لو انفقت ما في الارض جميعا ما الفت بين قلوبهم ولٰكن الله الف بينهم انه عزيز حكيم" ;
        quran:ayahnumber               "63" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1238" ;
        quran:page                     "185" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:946  quran:ayah_text             "وَعَلَى ٱلَّذِينَ هَادُواْ حَرَّمۡنَا كُلَّ ذِي ظُفُرٖۖ وَمِنَ ٱلۡبَقَرِ وَٱلۡغَنَمِ حَرَّمۡنَا عَلَيۡهِمۡ شُحُومَهُمَآ إِلَّا مَا حَمَلَتۡ ظُهُورُهُمَآ أَوِ ٱلۡحَوَايَآ أَوۡ مَا ٱخۡتَلَطَ بِعَظۡمٖۚ ذَٰلِكَ جَزَيۡنَٰهُم بِبَغۡيِهِمۡۖ وَإِنَّا لَصَٰدِقُونَ" ;
        quran:ayah_text_no_diacratic   "وعلى الذين هادوا حرمنا كل ذي ظفر ومن البقر والغنم حرمنا عليهم شحومهما الا ما حملت ظهورهما او الحوايا او ما اختلط بعظم ذٰلك جزينٰهم ببغيهم وانا لصٰدقون" ;
        quran:ayahnumber               "146" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "946" ;
        quran:page                     "147" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1048  quran:ayah_text            "إِنَّكُمۡ لَتَأۡتُونَ ٱلرِّجَالَ شَهۡوَةٗ مِّن دُونِ ٱلنِّسَآءِۚ بَلۡ أَنتُمۡ قَوۡمٞ مُّسۡرِفُونَ" ;
        quran:ayah_text_no_diacratic   "انكم لتاتون الرجال شهوة من دون النساء بل انتم قوم مسرفون" ;
        quran:ayahnumber               "81" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1048" ;
        quran:page                     "160" ;
