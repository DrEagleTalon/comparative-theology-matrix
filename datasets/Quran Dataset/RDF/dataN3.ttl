        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:5331  quran:ayah_text            "ذَٰلِكَ بِأَنَّهُۥ كَانَت تَّأۡتِيهِمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ فَقَالُوٓاْ أَبَشَرٞ يَهۡدُونَنَا فَكَفَرُواْ وَتَوَلَّواْۖ وَّٱسۡتَغۡنَى ٱللَّهُۚ وَٱللَّهُ غَنِيٌّ حَمِيدٞ" ;
        quran:ayah_text_no_diacratic   "ذٰلك بانه كانت تاتيهم رسلهم بالبينٰت فقالوا ابشر يهدوننا فكفروا وتولوا واستغنى الله والله غني حميد" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "28" ;
