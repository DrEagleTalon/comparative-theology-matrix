        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:673  quran:ayah_text             "فَأَمَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَيُوَفِّيهِمۡ أُجُورَهُمۡ وَيَزِيدُهُم مِّن فَضۡلِهِۦۖ وَأَمَّا ٱلَّذِينَ ٱسۡتَنكَفُواْ وَٱسۡتَكۡبَرُواْ فَيُعَذِّبُهُمۡ عَذَابًا أَلِيمٗا وَلَا يَجِدُونَ لَهُم مِّن دُونِ ٱللَّهِ وَلِيّٗا وَلَا نَصِيرٗا" ;
        quran:ayah_text_no_diacratic   "فاما الذين ءامنوا وعملوا الصٰلحٰت فيوفيهم اجورهم ويزيدهم من فضله واما الذين استنكفوا واستكبروا فيعذبهم عذابا اليما ولا يجدون لهم من دون الله وليا ولا نصيرا" ;
        quran:ayahnumber               "173" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "673" ;
        quran:page                     "105" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4107  quran:ayah_text            "أَتَّخَذۡنَٰهُمۡ سِخۡرِيًّا أَمۡ زَاغَتۡ عَنۡهُمُ ٱلۡأَبۡصَٰرُ" ;
        quran:ayah_text_no_diacratic   "اتخذنٰهم سخريا ام زاغت عنهم الابصٰر" ;
