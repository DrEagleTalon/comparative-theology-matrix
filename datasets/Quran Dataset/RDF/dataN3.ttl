quran:3007  quran:ayah_text            "قَالَ لِمَنۡ حَوۡلَهُۥٓ أَلَا تَسۡتَمِعُونَ" ;
        quran:ayah_text_no_diacratic   "قال لمن حوله الا تستمعون" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "19" ;
