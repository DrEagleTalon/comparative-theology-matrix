        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1217  quran:ayah_text            "إِذۡ أَنتُم بِٱلۡعُدۡوَةِ ٱلدُّنۡيَا وَهُم بِٱلۡعُدۡوَةِ ٱلۡقُصۡوَىٰ وَٱلرَّكۡبُ أَسۡفَلَ مِنكُمۡۚ وَلَوۡ تَوَاعَدتُّمۡ لَٱخۡتَلَفۡتُمۡ فِي ٱلۡمِيعَٰدِ وَلَٰكِن لِّيَقۡضِيَ ٱللَّهُ أَمۡرٗا كَانَ مَفۡعُولٗا لِّيَهۡلِكَ مَنۡ هَلَكَ عَنۢ بَيِّنَةٖ وَيَحۡيَىٰ مَنۡ حَيَّ عَنۢ بَيِّنَةٖۗ وَإِنَّ ٱللَّهَ لَسَمِيعٌ عَلِيمٌ" ;
        quran:ayah_text_no_diacratic   "اذ انتم بالعدوة الدنيا وهم بالعدوة القصوىٰ والركب اسفل منكم ولو تواعدتم لاختلفتم في الميعٰد ولٰكن ليقضي الله امرا كان مفعولا ليهلك من هلك عن بينة ويحيىٰ من حي عن بينة وان الله لسميع عليم" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1217" ;
        quran:page                     "182" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:925  quran:ayah_text             "فَمَن يُرِدِ ٱللَّهُ أَن يَهۡدِيَهُۥ يَشۡرَحۡ صَدۡرَهُۥ لِلۡإِسۡلَٰمِۖ وَمَن يُرِدۡ أَن يُضِلَّهُۥ يَجۡعَلۡ صَدۡرَهُۥ ضَيِّقًا حَرَجٗا كَأَنَّمَا يَصَّعَّدُ فِي ٱلسَّمَآءِۚ كَذَٰلِكَ يَجۡعَلُ ٱللَّهُ ٱلرِّجۡسَ عَلَى ٱلَّذِينَ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "فمن يرد الله ان يهديه يشرح صدره للاسلٰم ومن يرد ان يضله يجعل صدره ضيقا حرجا كانما يصعد في السماء كذٰلك يجعل الله الرجس على الذين لا يؤمنون" ;
        quran:ayahnumber               "125" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "925" ;
        quran:page                     "144" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1027  quran:ayah_text            "قَالَ ٱلۡمَلَأُ مِن قَوۡمِهِۦٓ إِنَّا لَنَرَىٰكَ فِي ضَلَٰلٖ مُّبِينٖ" ;
        quran:ayah_text_no_diacratic   "قال الملا من قومه انا لنرىٰك في ضلٰل مبين" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1027" ;
        quran:page                     "158" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:735  quran:ayah_text             "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّخِذُواْ ٱلَّذِينَ ٱتَّخَذُواْ دِينَكُمۡ هُزُوٗا وَلَعِبٗا مِّنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ مِن قَبۡلِكُمۡ وَٱلۡكُفَّارَ أَوۡلِيَآءَۚ وَٱتَّقُواْ ٱللَّهَ إِن كُنتُم مُّؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا لا تتخذوا الذين اتخذوا دينكم هزوا ولعبا من الذين اوتوا الكتٰب من قبلكم والكفار اولياء واتقوا الله ان كنتم مؤمنين" ;
        quran:ayahnumber               "57" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "735" ;
        quran:page                     "117" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:545  quran:ayah_text             "وَٱللَّهُ أَعۡلَمُ بِأَعۡدَآئِكُمۡۚ وَكَفَىٰ بِٱللَّهِ وَلِيّٗا وَكَفَىٰ بِٱللَّهِ نَصِيرٗا" ;
        quran:ayah_text_no_diacratic   "والله اعلم باعدائكم وكفىٰ بالله وليا وكفىٰ بالله نصيرا" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "545" ;
        quran:page                     "86" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4980  quran:ayah_text            "وَنَبِّئۡهُمۡ أَنَّ ٱلۡمَآءَ قِسۡمَةُۢ بَيۡنَهُمۡۖ كُلُّ شِرۡبٖ مُّحۡتَضَرٞ" ;
        quran:ayah_text_no_diacratic   "ونبئهم ان الماء قسمة بينهم كل شرب محتضر" ;
        quran:ayahnumber               "28" ;
