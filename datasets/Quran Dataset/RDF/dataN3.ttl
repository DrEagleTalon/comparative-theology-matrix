quran:1654  quran:ayah_text            "وَدَخَلَ مَعَهُ ٱلسِّجۡنَ فَتَيَانِۖ قَالَ أَحَدُهُمَآ إِنِّيٓ أَرَىٰنِيٓ أَعۡصِرُ خَمۡرٗاۖ وَقَالَ ٱلۡأٓخَرُ إِنِّيٓ أَرَىٰنِيٓ أَحۡمِلُ فَوۡقَ رَأۡسِي خُبۡزٗا تَأۡكُلُ ٱلطَّيۡرُ مِنۡهُۖ نَبِّئۡنَا بِتَأۡوِيلِهِۦٓۖ إِنَّا نَرَىٰكَ مِنَ ٱلۡمُحۡسِنِينَ" ;
        quran:ayah_text_no_diacratic   "ودخل معه السجن فتيان قال احدهما اني ارىٰني اعصر خمرا وقال الاخر اني ارىٰني احمل فوق راسي خبزا تاكل الطير منه نبئنا بتاويله انا نرىٰك من المحسنين" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "12" ;
        quran:hizb                     "24" ;
        quran:index                    "1654" ;
        quran:page                     "239" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2558  quran:ayah_text            "كُلُّ نَفۡسٖ ذَآئِقَةُ ٱلۡمَوۡتِۗ وَنَبۡلُوكُم بِٱلشَّرِّ وَٱلۡخَيۡرِ فِتۡنَةٗۖ وَإِلَيۡنَا تُرۡجَعُونَ" ;
        quran:ayah_text_no_diacratic   "كل نفس ذائقة الموت ونبلوكم بالشر والخير فتنة والينا ترجعون" ;
