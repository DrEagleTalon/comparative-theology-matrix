        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1269  quran:ayah_text            "إِنَّمَا يَعۡمُرُ مَسَٰجِدَ ٱللَّهِ مَنۡ ءَامَنَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ وَلَمۡ يَخۡشَ إِلَّا ٱللَّهَۖ فَعَسَىٰٓ أُوْلَٰٓئِكَ أَن يَكُونُواْ مِنَ ٱلۡمُهۡتَدِينَ" ;
        quran:ayah_text_no_diacratic   "انما يعمر مسٰجد الله من ءامن بالله واليوم الاخر واقام الصلوٰة وءاتى الزكوٰة ولم يخش الا الله فعسىٰ اولٰئك ان يكونوا من المهتدين" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1269" ;
