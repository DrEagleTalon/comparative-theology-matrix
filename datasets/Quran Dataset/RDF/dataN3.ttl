quran:583  quran:ayah_text             "وَإِذَا جَآءَهُمۡ أَمۡرٞ مِّنَ ٱلۡأَمۡنِ أَوِ ٱلۡخَوۡفِ أَذَاعُواْ بِهِۦۖ وَلَوۡ رَدُّوهُ إِلَى ٱلرَّسُولِ وَإِلَىٰٓ أُوْلِي ٱلۡأَمۡرِ مِنۡهُمۡ لَعَلِمَهُ ٱلَّذِينَ يَسۡتَنۢبِطُونَهُۥ مِنۡهُمۡۗ وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ لَٱتَّبَعۡتُمُ ٱلشَّيۡطَٰنَ إِلَّا قَلِيلٗا" ;
        quran:ayah_text_no_diacratic   "واذا جاءهم امر من الامن او الخوف اذاعوا به ولو ردوه الى الرسول والىٰ اولي الامر منهم لعلمه الذين يستنبطونه منهم ولولا فضل الله عليكم ورحمته لاتبعتم الشيطٰن الا قليلا" ;
        quran:ayahnumber               "83" ;
        quran:chapter                  "5" ;
        quran:hizb                     "9" ;
        quran:index                    "583" ;
        quran:page                     "91" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4017  quran:ayah_text            "فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "فاتوا بكتٰبكم ان كنتم صٰدقين" ;
