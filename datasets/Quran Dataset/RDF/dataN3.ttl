        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4603  quran:ayah_text            "مَا خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَآ إِلَّا بِٱلۡحَقِّ وَأَجَلٖ مُّسَمّٗىۚ وَٱلَّذِينَ كَفَرُواْ عَمَّآ أُنذِرُواْ مُعۡرِضُونَ" ;
        quran:ayah_text_no_diacratic   "ما خلقنا السمٰوٰت والارض وما بينهما الا بالحق واجل مسمى والذين كفروا عما انذروا معرضون" ;
        quran:ayahnumber               "3" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4603" ;
        quran:page                     "502" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

quran:2365  quran:ayah_text            "كَلَّاۚ سَنَكۡتُبُ مَا يَقُولُ وَنَمُدُّ لَهُۥ مِنَ ٱلۡعَذَابِ مَدّٗا" ;
        quran:ayah_text_no_diacratic   "كلا سنكتب ما يقول ونمد له من العذاب مدا" ;
