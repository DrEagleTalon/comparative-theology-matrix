quran:2189  quran:ayah_text            "هَٰٓؤُلَآءِ قَوۡمُنَا ٱتَّخَذُواْ مِن دُونِهِۦٓ ءَالِهَةٗۖ لَّوۡلَا يَأۡتُونَ عَلَيۡهِم بِسُلۡطَٰنِۭ بَيِّنٖۖ فَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبٗا" ;
        quran:ayah_text_no_diacratic   "هٰؤلاء قومنا اتخذوا من دونه ءالهة لولا ياتون عليهم بسلطٰن بين فمن اظلم ممن افترىٰ على الله كذبا" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2189" ;
        quran:page                     "294" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3333  quran:ayah_text            "قَالَ إِنِّيٓ أُرِيدُ أَنۡ أُنكِحَكَ إِحۡدَى ٱبۡنَتَيَّ هَٰتَيۡنِ عَلَىٰٓ أَن تَأۡجُرَنِي ثَمَٰنِيَ حِجَجٖۖ فَإِنۡ أَتۡمَمۡتَ عَشۡرٗا فَمِنۡ عِندِكَۖ وَمَآ أُرِيدُ أَنۡ أَشُقَّ عَلَيۡكَۚ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰلِحِينَ" ;
        quran:ayah_text_no_diacratic   "قال اني اريد ان انكحك احدى ابنتي هٰتين علىٰ ان تاجرني ثمٰني حجج فان اتممت عشرا فمن عندك وما اريد ان اشق عليك ستجدني ان شاء الله من الصٰلحين" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "20" ;
        quran:hizb                     "38" ;
        quran:index                    "3333" ;
        quran:page                     "388" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1095  quran:ayah_text            "قَالَ مُوسَىٰ لِقَوۡمِهِ ٱسۡتَعِينُواْ بِٱللَّهِ وَٱصۡبِرُوٓاْۖ إِنَّ ٱلۡأَرۡضَ لِلَّهِ يُورِثُهَا مَن يَشَآءُ مِنۡ عِبَادِهِۦۖ وَٱلۡعَٰقِبَةُ لِلۡمُتَّقِينَ" ;
        quran:ayah_text_no_diacratic   "قال موسىٰ لقومه استعينوا بالله واصبروا ان الارض لله يورثها من يشاء من عباده والعٰقبة للمتقين" ;
        quran:ayahnumber               "128" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1095" ;
        quran:page                     "165" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:4237  quran:ayah_text            "وَقَالَ فِرۡعَوۡنُ ذَرُونِيٓ أَقۡتُلۡ مُوسَىٰ وَلۡيَدۡعُ رَبَّهُۥٓۖ إِنِّيٓ أَخَافُ أَن يُبَدِّلَ دِينَكُمۡ أَوۡ أَن يُظۡهِرَ فِي ٱلۡأَرۡضِ ٱلۡفَسَادَ" ;
        quran:ayah_text_no_diacratic   "وقال فرعون ذروني اقتل موسىٰ وليدع ربه اني اخاف ان يبدل دينكم او ان يظهر في الارض الفساد" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "24" ;
