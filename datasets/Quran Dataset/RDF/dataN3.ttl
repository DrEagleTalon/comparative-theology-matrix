quran:2662  quran:ayah_text            "إِنَّ ٱلَّذِينَ كَفَرُواْ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَٱلۡمَسۡجِدِ ٱلۡحَرَامِ ٱلَّذِي جَعَلۡنَٰهُ لِلنَّاسِ سَوَآءً ٱلۡعَٰكِفُ فِيهِ وَٱلۡبَادِۚ وَمَن يُرِدۡ فِيهِ بِإِلۡحَادِۭ بِظُلۡمٖ نُّذِقۡهُ مِنۡ عَذَابٍ أَلِيمٖ" ;
        quran:ayah_text_no_diacratic   "ان الذين كفروا ويصدون عن سبيل الله والمسجد الحرام الذي جعلنٰه للناس سواء العٰكف فيه والباد ومن يرد فيه بالحاد بظلم نذقه من عذاب اليم" ;
        quran:ayahnumber               "25" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2662" ;
        quran:page                     "335" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

