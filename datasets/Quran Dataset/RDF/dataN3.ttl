        quran:index                    "4701" ;
        quran:page                     "514" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:2463  quran:ayah_text            "وَلَقَدۡ أَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنۡ أَسۡرِ بِعِبَادِي فَٱضۡرِبۡ لَهُمۡ طَرِيقٗا فِي ٱلۡبَحۡرِ يَبَسٗا لَّا تَخَٰفُ دَرَكٗا وَلَا تَخۡشَىٰ" ;
        quran:ayah_text_no_diacratic   "ولقد اوحينا الىٰ موسىٰ ان اسر بعبادي فاضرب لهم طريقا في البحر يبسا لا تخٰف دركا ولا تخشىٰ" ;
        quran:ayahnumber               "77" ;
