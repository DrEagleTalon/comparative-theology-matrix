quran:2702  quran:ayah_text            "أَلَمۡ تَرَ أَنَّ ٱللَّهَ سَخَّرَ لَكُم مَّا فِي ٱلۡأَرۡضِ وَٱلۡفُلۡكَ تَجۡرِي فِي ٱلۡبَحۡرِ بِأَمۡرِهِۦ وَيُمۡسِكُ ٱلسَّمَآءَ أَن تَقَعَ عَلَى ٱلۡأَرۡضِ إِلَّا بِإِذۡنِهِۦٓۚ إِنَّ ٱللَّهَ بِٱلنَّاسِ لَرَءُوفٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "الم تر ان الله سخر لكم ما في الارض والفلك تجري في البحر بامره ويمسك السماء ان تقع على الارض الا باذنه ان الله بالناس لرءوف رحيم" ;
        quran:ayahnumber               "65" ;
        quran:chapter                  "17" ;
        quran:hizb                     "34" ;
        quran:index                    "2702" ;
        quran:page                     "340" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:6197  quran:ayah_text            "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ" ;
        quran:ayah_text_no_diacratic   "ارجعي الىٰ ربك راضية مرضية" ;
