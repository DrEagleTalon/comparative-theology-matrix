        quran:surahname                "سُورَةُ المُزَّمِّلِ" ;
        quran:surahnumber              "73" ;
        quran:surrahname_no_diacratic  "سورة المزمل" .

quran:3631  quran:ayah_text            "وَٱذۡكُرۡنَ مَا يُتۡلَىٰ فِي بُيُوتِكُنَّ مِنۡ ءَايَٰتِ ٱللَّهِ وَٱلۡحِكۡمَةِۚ إِنَّ ٱللَّهَ كَانَ لَطِيفًا خَبِيرًا" ;
        quran:ayah_text_no_diacratic   "واذكرن ما يتلىٰ في بيوتكن من ءايٰت الله والحكمة ان الله كان لطيفا خبيرا" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "22" ;
        quran:hizb                     "42" ;
        quran:index                    "3631" ;
        quran:page                     "422" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1393  quran:ayah_text            "۞وَلَوۡ يُعَجِّلُ ٱللَّهُ لِلنَّاسِ ٱلشَّرَّ ٱسۡتِعۡجَالَهُم بِٱلۡخَيۡرِ لَقُضِيَ إِلَيۡهِمۡ أَجَلُهُمۡۖ فَنَذَرُ ٱلَّذِينَ لَا يَرۡجُونَ لِقَآءَنَا فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ" ;
        quran:ayah_text_no_diacratic   "ولو يعجل الله للناس الشر استعجالهم بالخير لقضي اليهم اجلهم فنذر الذين لا يرجون لقاءنا في طغيٰنهم يعمهون" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1393" ;
        quran:page                     "209" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4535  quran:ayah_text            "إِنۡ هِيَ إِلَّا مَوۡتَتُنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُنشَرِينَ" ;
        quran:ayah_text_no_diacratic   "ان هي الا موتتنا الاولىٰ وما نحن بمنشرين" ;
        quran:ayahnumber               "35" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4535" ;
        quran:page                     "497" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2297  quran:ayah_text            "فَخَرَجَ عَلَىٰ قَوۡمِهِۦ مِنَ ٱلۡمِحۡرَابِ فَأَوۡحَىٰٓ إِلَيۡهِمۡ أَن سَبِّحُواْ بُكۡرَةٗ وَعَشِيّٗا" ;
        quran:ayah_text_no_diacratic   "فخرج علىٰ قومه من المحراب فاوحىٰ اليهم ان سبحوا بكرة وعشيا" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2297" ;
        quran:page                     "305" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:5439  quran:ayah_text            "إِنَّ لِلۡمُتَّقِينَ عِندَ رَبِّهِمۡ جَنَّٰتِ ٱلنَّعِيمِ" ;
        quran:ayah_text_no_diacratic   "ان للمتقين عند ربهم جنٰت النعيم" ;
        quran:ayahnumber               "34" ;
        quran:chapter                  "29" ;
        quran:hizb                     "56" ;
        quran:index                    "5439" ;
        quran:page                     "565" ;
        quran:surahname                "سُورَةُ القَلَمِ" ;
        quran:surahnumber              "68" ;
        quran:surrahname_no_diacratic  "سورة القلم" .

quran:3441  quran:ayah_text            "ٱتۡلُ مَآ أُوحِيَ إِلَيۡكَ مِنَ ٱلۡكِتَٰبِ وَأَقِمِ ٱلصَّلَوٰةَۖ إِنَّ ٱلصَّلَوٰةَ تَنۡهَىٰ عَنِ ٱلۡفَحۡشَآءِ وَٱلۡمُنكَرِۗ وَلَذِكۡرُ ٱللَّهِ أَكۡبَرُۗ وَٱللَّهُ يَعۡلَمُ مَا تَصۡنَعُونَ" ;
        quran:ayah_text_no_diacratic   "اتل ما اوحي اليك من الكتٰب واقم الصلوٰة ان الصلوٰة تنهىٰ عن الفحشاء والمنكر ولذكر الله اكبر والله يعلم ما تصنعون" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3441" ;
        quran:page                     "401" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:4345  quran:ayah_text            "۞إِلَيۡهِ يُرَدُّ عِلۡمُ ٱلسَّاعَةِۚ وَمَا تَخۡرُجُ مِن ثَمَرَٰتٖ مِّنۡ أَكۡمَامِهَا وَمَا تَحۡمِلُ مِنۡ أُنثَىٰ وَلَا تَضَعُ إِلَّا بِعِلۡمِهِۦۚ وَيَوۡمَ يُنَادِيهِمۡ أَيۡنَ شُرَكَآءِي قَالُوٓاْ ءَاذَنَّٰكَ مَامِنَّا مِن شَهِيدٖ" ;
        quran:ayah_text_no_diacratic   "اليه يرد علم الساعة وما تخرج من ثمرٰت من اكمامها وما تحمل من انثىٰ ولا تضع الا بعلمه ويوم يناديهم اين شركاءي قالوا ءاذنٰك مامنا من شهيد" ;
        quran:ayahnumber               "47" ;
        quran:chapter                  "25" ;
        quran:hizb                     "48" ;
        quran:index                    "4345" ;
        quran:page                     "482" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:5249  quran:ayah_text            "مَّآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ مِنۡ أَهۡلِ ٱلۡقُرَىٰ فَلِلَّهِ وَلِلرَّسُولِ وَلِذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِ كَيۡ لَا يَكُونَ دُولَةَۢ بَيۡنَ ٱلۡأَغۡنِيَآءِ مِنكُمۡۚ وَمَآ ءَاتَىٰكُمُ ٱلرَّسُولُ فَخُذُوهُ وَمَا نَهَىٰكُمۡ عَنۡهُ فَٱنتَهُواْۚ وَٱتَّقُواْ ٱللَّهَۖ إِنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ" ;
        quran:ayah_text_no_diacratic   "ما افاء الله علىٰ رسوله من اهل القرىٰ فلله وللرسول ولذي القربىٰ واليتٰمىٰ والمسٰكين وابن السبيل كي لا يكون دولة بين الاغنياء منكم وما ءاتىٰكم الرسول فخذوه وما نهىٰكم عنه فانتهوا واتقوا الله ان الله شديد العقاب" ;
        quran:ayahnumber               "7" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5249" ;
        quran:page                     "546" ;
        quran:surahname                "سُورَةُ الحَشۡرِ" ;
        quran:surahnumber              "59" ;
        quran:surrahname_no_diacratic  "سورة الحشر" .

quran:3251  quran:ayah_text            "قَالَ ٱلَّذِي عِندَهُۥ عِلۡمٞ مِّنَ ٱلۡكِتَٰبِ أَنَا۠ ءَاتِيكَ بِهِۦ قَبۡلَ أَن يَرۡتَدَّ إِلَيۡكَ طَرۡفُكَۚ فَلَمَّا رَءَاهُ مُسۡتَقِرًّا عِندَهُۥ قَالَ هَٰذَا مِن فَضۡلِ رَبِّي لِيَبۡلُوَنِيٓ ءَأَشۡكُرُ أَمۡ أَكۡفُرُۖ وَمَن شَكَرَ فَإِنَّمَا يَشۡكُرُ لِنَفۡسِهِۦۖ وَمَن كَفَرَ فَإِنَّ رَبِّي غَنِيّٞ كَرِيمٞ" ;
        quran:ayah_text_no_diacratic   "قال الذي عنده علم من الكتٰب انا ءاتيك به قبل ان يرتد اليك طرفك فلما رءاه مستقرا عنده قال هٰذا من فضل ربي ليبلوني ءاشكر ام اكفر ومن شكر فانما يشكر لنفسه ومن كفر فان ربي غني كريم" ;
        quran:ayahnumber               "40" ;
        quran:chapter                  "19" ;
        quran:hizb                     "38" ;
        quran:index                    "3251" ;
        quran:page                     "380" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:4155  quran:ayah_text            "أَلَمۡ تَرَ أَنَّ ٱللَّهَ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَسَلَكَهُۥ يَنَٰبِيعَ فِي ٱلۡأَرۡضِ ثُمَّ يُخۡرِجُ بِهِۦ زَرۡعٗا مُّخۡتَلِفًا أَلۡوَٰنُهُۥ ثُمَّ يَهِيجُ فَتَرَىٰهُ مُصۡفَرّٗا ثُمَّ يَجۡعَلُهُۥ حُطَٰمًاۚ إِنَّ فِي ذَٰلِكَ لَذِكۡرَىٰ لِأُوْلِي ٱلۡأَلۡبَٰبِ" ;
        quran:ayah_text_no_diacratic   "الم تر ان الله انزل من السماء ماء فسلكه ينٰبيع في الارض ثم يخرج به زرعا مختلفا الوٰنه ثم يهيج فترىٰه مصفرا ثم يجعله حطٰما ان في ذٰلك لذكرىٰ لاولي الالبٰب" ;
