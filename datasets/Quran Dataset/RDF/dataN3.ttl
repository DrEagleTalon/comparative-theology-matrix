quran:2741  quran:ayah_text            "فَقَالَ ٱلۡمَلَؤُاْ ٱلَّذِينَ كَفَرُواْ مِن قَوۡمِهِۦ مَا هَٰذَآ إِلَّا بَشَرٞ مِّثۡلُكُمۡ يُرِيدُ أَن يَتَفَضَّلَ عَلَيۡكُمۡ وَلَوۡ شَآءَ ٱللَّهُ لَأَنزَلَ مَلَٰٓئِكَةٗ مَّا سَمِعۡنَا بِهَٰذَا فِيٓ ءَابَآئِنَا ٱلۡأَوَّلِينَ" ;
        quran:ayah_text_no_diacratic   "فقال الملؤا الذين كفروا من قومه ما هٰذا الا بشر مثلكم يريد ان يتفضل عليكم ولو شاء الله لانزل ملٰئكة ما سمعنا بهٰذا في ءابائنا الاولين" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "18" ;
        quran:hizb                     "34" ;
        quran:index                    "2741" ;
        quran:page                     "343" ;
        quran:surahname                "سُورَةُ المُؤۡمِنُونَ" ;
        quran:surahnumber              "23" ;
        quran:surrahname_no_diacratic  "سورة المؤمنون" .

quran:3645  quran:ayah_text            "وَلَا تُطِعِ ٱلۡكَٰفِرِينَ وَٱلۡمُنَٰفِقِينَ وَدَعۡ أَذَىٰهُمۡ وَتَوَكَّلۡ عَلَى ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلٗا" ;
        quran:ayah_text_no_diacratic   "ولا تطع الكٰفرين والمنٰفقين ودع اذىٰهم وتوكل على الله وكفىٰ بالله وكيلا" ;
        quran:ayahnumber               "48" ;
        quran:chapter                  "22" ;
