quran:3338  quran:ayah_text            "ٱسۡلُكۡ يَدَكَ فِي جَيۡبِكَ تَخۡرُجۡ بَيۡضَآءَ مِنۡ غَيۡرِ سُوٓءٖ وَٱضۡمُمۡ إِلَيۡكَ جَنَاحَكَ مِنَ ٱلرَّهۡبِۖ فَذَٰنِكَ بُرۡهَٰنَانِ مِن رَّبِّكَ إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦٓۚ إِنَّهُمۡ كَانُواْ قَوۡمٗا فَٰسِقِينَ" ;
        quran:ayah_text_no_diacratic   "اسلك يدك في جيبك تخرج بيضاء من غير سوء واضمم اليك جناحك من الرهب فذٰنك برهٰنان من ربك الىٰ فرعون وملايه انهم كانوا قوما فٰسقين" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "20" ;
        quran:hizb                     "39" ;
        quran:index                    "3338" ;
        quran:page                     "389" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:1340  quran:ayah_text            "أَعَدَّ ٱللَّهُ لَهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ" ;
        quran:ayah_text_no_diacratic   "اعد الله لهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها ذٰلك الفوز العظيم" ;
        quran:ayahnumber               "89" ;
