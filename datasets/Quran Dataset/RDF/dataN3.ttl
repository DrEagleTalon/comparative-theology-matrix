        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:718  quran:ayah_text             "أَلَمۡ تَعۡلَمۡ أَنَّ ٱللَّهَ لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ يُعَذِّبُ مَن يَشَآءُ وَيَغۡفِرُ لِمَن يَشَآءُۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "الم تعلم ان الله له ملك السمٰوٰت والارض يعذب من يشاء ويغفر لمن يشاء والله علىٰ كل شيء قدير" ;
