quran:77  quran:ayah_text              "وَإِذۡ قَالَ مُوسَىٰ لِقَوۡمِهِۦٓ إِنَّ ٱللَّهَ يَأۡمُرُكُمۡ أَن تَذۡبَحُواْ بَقَرَةٗۖ قَالُوٓاْ أَتَتَّخِذُنَا هُزُوٗاۖ قَالَ أَعُوذُ بِٱللَّهِ أَنۡ أَكُونَ مِنَ ٱلۡجَٰهِلِينَ" ;
        quran:ayah_text_no_diacratic   "واذ قال موسىٰ لقومه ان الله يامركم ان تذبحوا بقرة قالوا اتتخذنا هزوا قال اعوذ بالله ان اكون من الجٰهلين" ;
        quran:ayahnumber               "67" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "77" ;
        quran:page                     "10" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1208  quran:ayah_text            "وَمَا كَانَ ٱللَّهُ لِيُعَذِّبَهُمۡ وَأَنتَ فِيهِمۡۚ وَمَا كَانَ ٱللَّهُ مُعَذِّبَهُمۡ وَهُمۡ يَسۡتَغۡفِرُونَ" ;
        quran:ayah_text_no_diacratic   "وما كان الله ليعذبهم وانت فيهم وما كان الله معذبهم وهم يستغفرون" ;
        quran:ayahnumber               "33" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1208" ;
        quran:page                     "180" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:916  quran:ayah_text             "وَإِن تُطِعۡ أَكۡثَرَ مَن فِي ٱلۡأَرۡضِ يُضِلُّوكَ عَن سَبِيلِ ٱللَّهِۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنۡ هُمۡ إِلَّا يَخۡرُصُونَ" ;
        quran:ayah_text_no_diacratic   "وان تطع اكثر من في الارض يضلوك عن سبيل الله ان يتبعون الا الظن وان هم الا يخرصون" ;
        quran:ayahnumber               "116" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "916" ;
        quran:page                     "142" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1018  quran:ayah_text            "ٱلَّذِينَ ٱتَّخَذُواْ دِينَهُمۡ لَهۡوٗا وَلَعِبٗا وَغَرَّتۡهُمُ ٱلۡحَيَوٰةُ ٱلدُّنۡيَاۚ فَٱلۡيَوۡمَ نَنسَىٰهُمۡ كَمَا نَسُواْ لِقَآءَ يَوۡمِهِمۡ هَٰذَا وَمَا كَانُواْ بِـَٔايَٰتِنَا يَجۡحَدُونَ" ;
        quran:ayah_text_no_diacratic   "الذين اتخذوا دينهم لهوا ولعبا وغرتهم الحيوٰة الدنيا فاليوم ننسىٰهم كما نسوا لقاء يومهم هٰذا وما كانوا بايٰتنا يجحدون" ;
        quran:ayahnumber               "51" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "1018" ;
        quran:page                     "156" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:726  quran:ayah_text             "وَأَنزَلۡنَآ إِلَيۡكَ ٱلۡكِتَٰبَ بِٱلۡحَقِّ مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ مِنَ ٱلۡكِتَٰبِ وَمُهَيۡمِنًا عَلَيۡهِۖ فَٱحۡكُم بَيۡنَهُم بِمَآ أَنزَلَ ٱللَّهُۖ وَلَا تَتَّبِعۡ أَهۡوَآءَهُمۡ عَمَّا جَآءَكَ مِنَ ٱلۡحَقِّۚ لِكُلّٖ جَعَلۡنَا مِنكُمۡ شِرۡعَةٗ وَمِنۡهَاجٗاۚ وَلَوۡ شَآءَ ٱللَّهُ لَجَعَلَكُمۡ أُمَّةٗ وَٰحِدَةٗ وَلَٰكِن لِّيَبۡلُوَكُمۡ فِي مَآ ءَاتَىٰكُمۡۖ فَٱسۡتَبِقُواْ ٱلۡخَيۡرَٰتِۚ إِلَى ٱللَّهِ مَرۡجِعُكُمۡ جَمِيعٗا فَيُنَبِّئُكُم بِمَا كُنتُمۡ فِيهِ تَخۡتَلِفُونَ" ;
        quran:ayah_text_no_diacratic   "وانزلنا اليك الكتٰب بالحق مصدقا لما بين يديه من الكتٰب ومهيمنا عليه فاحكم بينهم بما انزل الله ولا تتبع اهواءهم عما جاءك من الحق لكل جعلنا منكم شرعة ومنهاجا ولو شاء الله لجعلكم امة وٰحدة ولٰكن ليبلوكم في ما ءاتىٰكم فاستبقوا الخيرٰت الى الله مرجعكم جميعا فينبئكم بما كنتم فيه تختلفون" ;
        quran:ayahnumber               "48" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "726" ;
        quran:page                     "116" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:536  quran:ayah_text             "۞وَٱعۡبُدُواْ ٱللَّهَ وَلَا تُشۡرِكُواْ بِهِۦ شَيۡـٔٗاۖ وَبِٱلۡوَٰلِدَيۡنِ إِحۡسَٰنٗا وَبِذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱلۡجَارِ ذِي ٱلۡقُرۡبَىٰ وَٱلۡجَارِ ٱلۡجُنُبِ وَٱلصَّاحِبِ بِٱلۡجَنۢبِ وَٱبۡنِ ٱلسَّبِيلِ وَمَا مَلَكَتۡ أَيۡمَٰنُكُمۡۗ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ مُخۡتَالٗا فَخُورًا" ;
        quran:ayah_text_no_diacratic   "واعبدوا الله ولا تشركوا به شيا وبالوٰلدين احسٰنا وبذي القربىٰ واليتٰمىٰ والمسٰكين والجار ذي القربىٰ والجار الجنب والصاحب بالجنب وابن السبيل وما ملكت ايمٰنكم ان الله لا يحب من كان مختالا فخورا" ;
        quran:ayahnumber               "36" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "536" ;
        quran:page                     "84" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4971  quran:ayah_text            "إِنَّآ أَرۡسَلۡنَا عَلَيۡهِمۡ رِيحٗا صَرۡصَرٗا فِي يَوۡمِ نَحۡسٖ مُّسۡتَمِرّٖ" ;
        quran:ayah_text_no_diacratic   "انا ارسلنا عليهم ريحا صرصرا في يوم نحس مستمر" ;
