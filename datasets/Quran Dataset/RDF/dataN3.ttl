        quran:surrahname_no_diacratic  "سورة العصر" .

quran:3549  quran:ayah_text            "أَلَمۡ تَرَوۡاْ أَنَّ ٱللَّهَ سَخَّرَ لَكُم مَّا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ وَأَسۡبَغَ عَلَيۡكُمۡ نِعَمَهُۥ ظَٰهِرَةٗ وَبَاطِنَةٗۗ وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَلَا هُدٗى وَلَا كِتَٰبٖ مُّنِيرٖ" ;
        quran:ayah_text_no_diacratic   "الم تروا ان الله سخر لكم ما في السمٰوٰت وما في الارض واسبغ عليكم نعمه ظٰهرة وباطنة ومن الناس من يجٰدل في الله بغير علم ولا هدى ولا كتٰب منير" ;
        quran:ayahnumber               "20" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3549" ;
        quran:page                     "413" ;
        quran:surahname                "سُورَةُ لُقۡمَانَ" ;
