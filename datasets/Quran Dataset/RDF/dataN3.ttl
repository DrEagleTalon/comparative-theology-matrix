quran:652  quran:ayah_text             "وَٱلَّذِينَ ءَامَنُواْ بِٱللَّهِ وَرُسُلِهِۦ وَلَمۡ يُفَرِّقُواْ بَيۡنَ أَحَدٖ مِّنۡهُمۡ أُوْلَٰٓئِكَ سَوۡفَ يُؤۡتِيهِمۡ أُجُورَهُمۡۚ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمٗا" ;
        quran:ayah_text_no_diacratic   "والذين ءامنوا بالله ورسله ولم يفرقوا بين احد منهم اولٰئك سوف يؤتيهم اجورهم وكان الله غفورا رحيما" ;
        quran:ayahnumber               "152" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "652" ;
        quran:page                     "102" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:462  quran:ayah_text             "لَقَدۡ مَنَّ ٱللَّهُ عَلَى ٱلۡمُؤۡمِنِينَ إِذۡ بَعَثَ فِيهِمۡ رَسُولٗا مِّنۡ أَنفُسِهِمۡ يَتۡلُواْ عَلَيۡهِمۡ ءَايَٰتِهِۦ وَيُزَكِّيهِمۡ وَيُعَلِّمُهُمُ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَإِن كَانُواْ مِن قَبۡلُ لَفِي ضَلَٰلٖ مُّبِينٍ" ;
        quran:ayah_text_no_diacratic   "لقد من الله على المؤمنين اذ بعث فيهم رسولا من انفسهم يتلوا عليهم ءايٰته ويزكيهم ويعلمهم الكتٰب والحكمة وان كانوا من قبل لفي ضلٰل مبين" ;
        quran:ayahnumber               "164" ;
        quran:chapter                  "4" ;
