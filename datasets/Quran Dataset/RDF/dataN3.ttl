quran:313  quran:ayah_text             "۞قُلۡ أَؤُنَبِّئُكُم بِخَيۡرٖ مِّن ذَٰلِكُمۡۖ لِلَّذِينَ ٱتَّقَوۡاْ عِندَ رَبِّهِمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا وَأَزۡوَٰجٞ مُّطَهَّرَةٞ وَرِضۡوَٰنٞ مِّنَ ٱللَّهِۗ وَٱللَّهُ بَصِيرُۢ بِٱلۡعِبَادِ" ;
        quran:ayah_text_no_diacratic   "قل اؤنبئكم بخير من ذٰلكم للذين اتقوا عند ربهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها وازوٰج مطهرة ورضوٰن من الله والله بصير بالعباد" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "313" ;
        quran:page                     "51" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

