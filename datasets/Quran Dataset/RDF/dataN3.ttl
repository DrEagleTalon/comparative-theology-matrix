        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2428  quran:ayah_text            "ٱذۡهَبۡ أَنتَ وَأَخُوكَ بِـَٔايَٰتِي وَلَا تَنِيَا فِي ذِكۡرِي" ;
        quran:ayah_text_no_diacratic   "اذهب انت واخوك بايٰتي ولا تنيا في ذكري" ;
