        quran:surrahname_no_diacratic  "سورة الروم" .

quran:1510  quran:ayah_text            "أَفَمَن كَانَ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّهِۦ وَيَتۡلُوهُ شَاهِدٞ مِّنۡهُ وَمِن قَبۡلِهِۦ كِتَٰبُ مُوسَىٰٓ إِمَامٗا وَرَحۡمَةًۚ أُوْلَٰٓئِكَ يُؤۡمِنُونَ بِهِۦۚ وَمَن يَكۡفُرۡ بِهِۦ مِنَ ٱلۡأَحۡزَابِ فَٱلنَّارُ مَوۡعِدُهُۥۚ فَلَا تَكُ فِي مِرۡيَةٖ مِّنۡهُۚ إِنَّهُ ٱلۡحَقُّ مِن رَّبِّكَ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يُؤۡمِنُونَ" ;
        quran:ayah_text_no_diacratic   "افمن كان علىٰ بينة من ربه ويتلوه شاهد منه ومن قبله كتٰب موسىٰ اماما ورحمة اولٰئك يؤمنون به ومن يكفر به من الاحزاب فالنار موعده فلا تك في مرية منه انه الحق من ربك ولٰكن اكثر الناس لا يؤمنون" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "12" ;
        quran:hizb                     "22" ;
        quran:index                    "1510" ;
        quran:page                     "223" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:978  quran:ayah_text             "وَلَقَدۡ خَلَقۡنَٰكُمۡ ثُمَّ صَوَّرۡنَٰكُمۡ ثُمَّ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ لَمۡ يَكُن مِّنَ ٱلسَّٰجِدِينَ" ;
        quran:ayah_text_no_diacratic   "ولقد خلقنٰكم ثم صورنٰكم ثم قلنا للملٰئكة اسجدوا لادم فسجدوا الا ابليس لم يكن من السٰجدين" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "8" ;
        quran:hizb                     "15" ;
        quran:index                    "978" ;
        quran:page                     "151" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:2414  quran:ayah_text            "يَفۡقَهُواْ قَوۡلِي" ;
        quran:ayah_text_no_diacratic   "يفقهوا قولي" ;
        quran:ayahnumber               "28" ;
