        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1124  quran:ayah_text            "ٱلَّذِينَ يَتَّبِعُونَ ٱلرَّسُولَ ٱلنَّبِيَّ ٱلۡأُمِّيَّ ٱلَّذِي يَجِدُونَهُۥ مَكۡتُوبًا عِندَهُمۡ فِي ٱلتَّوۡرَىٰةِ وَٱلۡإِنجِيلِ يَأۡمُرُهُم بِٱلۡمَعۡرُوفِ وَيَنۡهَىٰهُمۡ عَنِ ٱلۡمُنكَرِ وَيُحِلُّ لَهُمُ ٱلطَّيِّبَٰتِ وَيُحَرِّمُ عَلَيۡهِمُ ٱلۡخَبَٰٓئِثَ وَيَضَعُ عَنۡهُمۡ إِصۡرَهُمۡ وَٱلۡأَغۡلَٰلَ ٱلَّتِي كَانَتۡ عَلَيۡهِمۡۚ فَٱلَّذِينَ ءَامَنُواْ بِهِۦ وَعَزَّرُوهُ وَنَصَرُوهُ وَٱتَّبَعُواْ ٱلنُّورَ ٱلَّذِيٓ أُنزِلَ مَعَهُۥٓ أُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ" ;
        quran:ayah_text_no_diacratic   "الذين يتبعون الرسول النبي الامي الذي يجدونه مكتوبا عندهم في التورىٰة والانجيل يامرهم بالمعروف وينهىٰهم عن المنكر ويحل لهم الطيبٰت ويحرم عليهم الخبٰئث ويضع عنهم اصرهم والاغلٰل التي كانت عليهم فالذين ءامنوا به وعزروه ونصروه واتبعوا النور الذي انزل معه اولٰئك هم المفلحون" ;
        quran:ayahnumber               "157" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1124" ;
        quran:page                     "170" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:832  quran:ayah_text             "وَمَا ٱلۡحَيَوٰةُ ٱلدُّنۡيَآ إِلَّا لَعِبٞ وَلَهۡوٞۖ وَلَلدَّارُ ٱلۡأٓخِرَةُ خَيۡرٞ لِّلَّذِينَ يَتَّقُونَۚ أَفَلَا تَعۡقِلُونَ" ;
        quran:ayah_text_no_diacratic   "وما الحيوٰة الدنيا الا لعب ولهو وللدار الاخرة خير للذين يتقون افلا تعقلون" ;
        quran:ayahnumber               "32" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "832" ;
        quran:page                     "131" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2028  quran:ayah_text            "مَنۡ عَمِلَ صَٰلِحٗا مِّن ذَكَرٍ أَوۡ أُنثَىٰ وَهُوَ مُؤۡمِنٞ فَلَنُحۡيِيَنَّهُۥ حَيَوٰةٗ طَيِّبَةٗۖ وَلَنَجۡزِيَنَّهُمۡ أَجۡرَهُم بِأَحۡسَنِ مَا كَانُواْ يَعۡمَلُونَ" ;
        quran:ayah_text_no_diacratic   "من عمل صٰلحا من ذكر او انثىٰ وهو مؤمن فلنحيينه حيوٰة طيبة ولنجزينهم اجرهم باحسن ما كانوا يعملون" ;
        quran:ayahnumber               "97" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2028" ;
        quran:page                     "278" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:642  quran:ayah_text             "إِنَّ ٱلۡمُنَٰفِقِينَ يُخَٰدِعُونَ ٱللَّهَ وَهُوَ خَٰدِعُهُمۡ وَإِذَا قَامُوٓاْ إِلَى ٱلصَّلَوٰةِ قَامُواْ كُسَالَىٰ يُرَآءُونَ ٱلنَّاسَ وَلَا يَذۡكُرُونَ ٱللَّهَ إِلَّا قَلِيلٗا" ;
        quran:ayah_text_no_diacratic   "ان المنٰفقين يخٰدعون الله وهو خٰدعهم واذا قاموا الى الصلوٰة قاموا كسالىٰ يراءون الناس ولا يذكرون الله الا قليلا" ;
        quran:ayahnumber               "142" ;
        quran:chapter                  "5" ;
        quran:hizb                     "10" ;
        quran:index                    "642" ;
        quran:page                     "101" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:452  quran:ayah_text             "ثُمَّ أَنزَلَ عَلَيۡكُم مِّنۢ بَعۡدِ ٱلۡغَمِّ أَمَنَةٗ نُّعَاسٗا يَغۡشَىٰ طَآئِفَةٗ مِّنكُمۡۖ وَطَآئِفَةٞ قَدۡ أَهَمَّتۡهُمۡ أَنفُسُهُمۡ يَظُنُّونَ بِٱللَّهِ غَيۡرَ ٱلۡحَقِّ ظَنَّ ٱلۡجَٰهِلِيَّةِۖ يَقُولُونَ هَل لَّنَا مِنَ ٱلۡأَمۡرِ مِن شَيۡءٖۗ قُلۡ إِنَّ ٱلۡأَمۡرَ كُلَّهُۥ لِلَّهِۗ يُخۡفُونَ فِيٓ أَنفُسِهِم مَّا لَا يُبۡدُونَ لَكَۖ يَقُولُونَ لَوۡ كَانَ لَنَا مِنَ ٱلۡأَمۡرِ شَيۡءٞ مَّا قُتِلۡنَا هَٰهُنَاۗ قُل لَّوۡ كُنتُمۡ فِي بُيُوتِكُمۡ لَبَرَزَ ٱلَّذِينَ كُتِبَ عَلَيۡهِمُ ٱلۡقَتۡلُ إِلَىٰ مَضَاجِعِهِمۡۖ وَلِيَبۡتَلِيَ ٱللَّهُ مَا فِي صُدُورِكُمۡ وَلِيُمَحِّصَ مَا فِي قُلُوبِكُمۡۚ وَٱللَّهُ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ" ;
        quran:ayah_text_no_diacratic   "ثم انزل عليكم من بعد الغم امنة نعاسا يغشىٰ طائفة منكم وطائفة قد اهمتهم انفسهم يظنون بالله غير الحق ظن الجٰهلية يقولون هل لنا من الامر من شيء قل ان الامر كله لله يخفون في انفسهم ما لا يبدون لك يقولون لو كان لنا من الامر شيء ما قتلنا هٰهنا قل لو كنتم في بيوتكم لبرز الذين كتب عليهم القتل الىٰ مضاجعهم وليبتلي الله ما في صدوركم وليمحص ما في قلوبكم والله عليم بذات الصدور" ;
        quran:ayahnumber               "154" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "452" ;
        quran:page                     "70" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

