        quran:surahnumber              "15" ;
        quran:surrahname_no_diacratic  "سورة الحجر" .

quran:3936  quran:ayah_text            "وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ" ;
        quran:ayah_text_no_diacratic   "ونجينٰه واهله من الكرب العظيم" ;
        quran:ayahnumber               "76" ;
