        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:1859  quran:ayah_text            "فَإِذَا سَوَّيۡتُهُۥ وَنَفَخۡتُ فِيهِ مِن رُّوحِي فَقَعُواْ لَهُۥ سَٰجِدِينَ" ;
        quran:ayah_text_no_diacratic   "فاذا سويته ونفخت فيه من روحي فقعوا له سٰجدين" ;
        quran:ayahnumber               "29" ;
        quran:chapter                  "14" ;
