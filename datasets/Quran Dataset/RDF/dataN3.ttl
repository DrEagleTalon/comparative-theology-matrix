        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:5363  quran:ayah_text            "إِن تَتُوبَآ إِلَى ٱللَّهِ فَقَدۡ صَغَتۡ قُلُوبُكُمَاۖ وَإِن تَظَٰهَرَا عَلَيۡهِ فَإِنَّ ٱللَّهَ هُوَ مَوۡلَىٰهُ وَجِبۡرِيلُ وَصَٰلِحُ ٱلۡمُؤۡمِنِينَۖ وَٱلۡمَلَٰٓئِكَةُ بَعۡدَ ذَٰلِكَ ظَهِيرٌ" ;
        quran:ayah_text_no_diacratic   "ان تتوبا الى الله فقد صغت قلوبكما وان تظٰهرا عليه فان الله هو مولىٰه وجبريل وصٰلح المؤمنين والملٰئكة بعد ذٰلك ظهير" ;
        quran:ayahnumber               "4" ;
