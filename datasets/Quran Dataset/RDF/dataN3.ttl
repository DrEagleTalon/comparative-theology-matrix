quran:1312  quran:ayah_text            "وَمِنۡهُمُ ٱلَّذِينَ يُؤۡذُونَ ٱلنَّبِيَّ وَيَقُولُونَ هُوَ أُذُنٞۚ قُلۡ أُذُنُ خَيۡرٖ لَّكُمۡ يُؤۡمِنُ بِٱللَّهِ وَيُؤۡمِنُ لِلۡمُؤۡمِنِينَ وَرَحۡمَةٞ لِّلَّذِينَ ءَامَنُواْ مِنكُمۡۚ وَٱلَّذِينَ يُؤۡذُونَ رَسُولَ ٱللَّهِ لَهُمۡ عَذَابٌ أَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "ومنهم الذين يؤذون النبي ويقولون هو اذن قل اذن خير لكم يؤمن بالله ويؤمن للمؤمنين ورحمة للذين ءامنوا منكم والذين يؤذون رسول الله لهم عذاب اليم" ;
        quran:ayahnumber               "61" ;
        quran:chapter                  "10" ;
        quran:hizb                     "19" ;
        quran:index                    "1312" ;
        quran:page                     "196" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:2216  quran:ayah_text            "وَأُحِيطَ بِثَمَرِهِۦ فَأَصۡبَحَ يُقَلِّبُ كَفَّيۡهِ عَلَىٰ مَآ أَنفَقَ فِيهَا وَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُشۡرِكۡ بِرَبِّيٓ أَحَدٗا" ;
        quran:ayah_text_no_diacratic   "واحيط بثمره فاصبح يقلب كفيه علىٰ ما انفق فيها وهي خاوية علىٰ عروشها ويقول يٰليتني لم اشرك بربي احدا" ;
        quran:ayahnumber               "42" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2216" ;
        quran:page                     "298" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1122  quran:ayah_text            "وَٱخۡتَارَ مُوسَىٰ قَوۡمَهُۥ سَبۡعِينَ رَجُلٗا لِّمِيقَٰتِنَاۖ فَلَمَّآ أَخَذَتۡهُمُ ٱلرَّجۡفَةُ قَالَ رَبِّ لَوۡ شِئۡتَ أَهۡلَكۡتَهُم مِّن قَبۡلُ وَإِيَّٰيَۖ أَتُهۡلِكُنَا بِمَا فَعَلَ ٱلسُّفَهَآءُ مِنَّآۖ إِنۡ هِيَ إِلَّا فِتۡنَتُكَ تُضِلُّ بِهَا مَن تَشَآءُ وَتَهۡدِي مَن تَشَآءُۖ أَنتَ وَلِيُّنَا فَٱغۡفِرۡ لَنَا وَٱرۡحَمۡنَاۖ وَأَنتَ خَيۡرُ ٱلۡغَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "واختار موسىٰ قومه سبعين رجلا لميقٰتنا فلما اخذتهم الرجفة قال رب لو شئت اهلكتهم من قبل وايٰي اتهلكنا بما فعل السفهاء منا ان هي الا فتنتك تضل بها من تشاء وتهدي من تشاء انت ولينا فاغفر لنا وارحمنا وانت خير الغٰفرين" ;
        quran:ayahnumber               "155" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1122" ;
        quran:page                     "169" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:830  quran:ayah_text             "وَلَوۡ تَرَىٰٓ إِذۡ وُقِفُواْ عَلَىٰ رَبِّهِمۡۚ قَالَ أَلَيۡسَ هَٰذَا بِٱلۡحَقِّۚ قَالُواْ بَلَىٰ وَرَبِّنَاۚ قَالَ فَذُوقُواْ ٱلۡعَذَابَ بِمَا كُنتُمۡ تَكۡفُرُونَ" ;
        quran:ayah_text_no_diacratic   "ولو ترىٰ اذ وقفوا علىٰ ربهم قال اليس هٰذا بالحق قالوا بلىٰ وربنا قال فذوقوا العذاب بما كنتم تكفرون" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "830" ;
        quran:page                     "131" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2026  quran:ayah_text            "وَلَا تَشۡتَرُواْ بِعَهۡدِ ٱللَّهِ ثَمَنٗا قَلِيلًاۚ إِنَّمَا عِندَ ٱللَّهِ هُوَ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "ولا تشتروا بعهد الله ثمنا قليلا انما عند الله هو خير لكم ان كنتم تعلمون" ;
        quran:ayahnumber               "95" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2026" ;
        quran:page                     "278" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:640  quran:ayah_text             "وَقَدۡ نَزَّلَ عَلَيۡكُمۡ فِي ٱلۡكِتَٰبِ أَنۡ إِذَا سَمِعۡتُمۡ ءَايَٰتِ ٱللَّهِ يُكۡفَرُ بِهَا وَيُسۡتَهۡزَأُ بِهَا فَلَا تَقۡعُدُواْ مَعَهُمۡ حَتَّىٰ يَخُوضُواْ فِي حَدِيثٍ غَيۡرِهِۦٓ إِنَّكُمۡ إِذٗا مِّثۡلُهُمۡۗ إِنَّ ٱللَّهَ جَامِعُ ٱلۡمُنَٰفِقِينَ وَٱلۡكَٰفِرِينَ فِي جَهَنَّمَ جَمِيعًا" ;
        quran:ayah_text_no_diacratic   "وقد نزل عليكم في الكتٰب ان اذا سمعتم ءايٰت الله يكفر بها ويستهزا بها فلا تقعدوا معهم حتىٰ يخوضوا في حديث غيره انكم اذا مثلهم ان الله جامع المنٰفقين والكٰفرين في جهنم جميعا" ;
        quran:ayahnumber               "140" ;
        quran:chapter                  "5" ;
        quran:hizb                     "10" ;
        quran:index                    "640" ;
        quran:page                     "100" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:450  quran:ayah_text             "وَلَقَدۡ صَدَقَكُمُ ٱللَّهُ وَعۡدَهُۥٓ إِذۡ تَحُسُّونَهُم بِإِذۡنِهِۦۖ حَتَّىٰٓ إِذَا فَشِلۡتُمۡ وَتَنَٰزَعۡتُمۡ فِي ٱلۡأَمۡرِ وَعَصَيۡتُم مِّنۢ بَعۡدِ مَآ أَرَىٰكُم مَّا تُحِبُّونَۚ مِنكُم مَّن يُرِيدُ ٱلدُّنۡيَا وَمِنكُم مَّن يُرِيدُ ٱلۡأٓخِرَةَۚ ثُمَّ صَرَفَكُمۡ عَنۡهُمۡ لِيَبۡتَلِيَكُمۡۖ وَلَقَدۡ عَفَا عَنكُمۡۗ وَٱللَّهُ ذُو فَضۡلٍ عَلَى ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "ولقد صدقكم الله وعده اذ تحسونهم باذنه حتىٰ اذا فشلتم وتنٰزعتم في الامر وعصيتم من بعد ما ارىٰكم ما تحبون منكم من يريد الدنيا ومنكم من يريد الاخرة ثم صرفكم عنهم ليبتليكم ولقد عفا عنكم والله ذو فضل على المؤمنين" ;
        quran:ayahnumber               "152" ;
        quran:chapter                  "4" ;
        quran:hizb                     "6" ;
        quran:index                    "450" ;
        quran:page                     "69" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:260  quran:ayah_text             "وَلَمَّا بَرَزُواْ لِجَالُوتَ وَجُنُودِهِۦ قَالُواْ رَبَّنَآ أَفۡرِغۡ عَلَيۡنَا صَبۡرٗا وَثَبِّتۡ أَقۡدَامَنَا وَٱنصُرۡنَا عَلَى ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "ولما برزوا لجالوت وجنوده قالوا ربنا افرغ علينا صبرا وثبت اقدامنا وانصرنا على القوم الكٰفرين" ;
        quran:ayahnumber               "250" ;
        quran:chapter                  "2" ;
        quran:hizb                     "4" ;
        quran:index                    "260" ;
        quran:page                     "41" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2958  quran:ayah_text            "وَيَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُهُمۡ وَلَا يَضُرُّهُمۡۗ وَكَانَ ٱلۡكَافِرُ عَلَىٰ رَبِّهِۦ ظَهِيرٗا" ;
        quran:ayah_text_no_diacratic   "ويعبدون من دون الله ما لا ينفعهم ولا يضرهم وكان الكافر علىٰ ربه ظهيرا" ;
        quran:ayahnumber               "55" ;
        quran:chapter                  "19" ;
        quran:hizb                     "36" ;
        quran:index                    "2958" ;
        quran:page                     "364" ;
        quran:surahname                "سُورَةُ الفُرۡقَانِ" ;
        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:1864  quran:ayah_text            "قَالَ فَٱخۡرُجۡ مِنۡهَا فَإِنَّكَ رَجِيمٞ" ;
        quran:ayah_text_no_diacratic   "قال فاخرج منها فانك رجيم" ;
