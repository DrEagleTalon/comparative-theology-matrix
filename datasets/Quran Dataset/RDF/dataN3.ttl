quran:1138  quran:ayah_text            "۞وَإِذۡ نَتَقۡنَا ٱلۡجَبَلَ فَوۡقَهُمۡ كَأَنَّهُۥ ظُلَّةٞ وَظَنُّوٓاْ أَنَّهُۥ وَاقِعُۢ بِهِمۡ خُذُواْ مَآ ءَاتَيۡنَٰكُم بِقُوَّةٖ وَٱذۡكُرُواْ مَا فِيهِ لَعَلَّكُمۡ تَتَّقُونَ" ;
        quran:ayah_text_no_diacratic   "واذ نتقنا الجبل فوقهم كانه ظلة وظنوا انه واقع بهم خذوا ما ءاتينٰكم بقوة واذكروا ما فيه لعلكم تتقون" ;
        quran:ayahnumber               "171" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1138" ;
        quran:page                     "173" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:846  quran:ayah_text             "قُلۡ أَرَءَيۡتُمۡ إِنۡ أَخَذَ ٱللَّهُ سَمۡعَكُمۡ وَأَبۡصَٰرَكُمۡ وَخَتَمَ عَلَىٰ قُلُوبِكُم مَّنۡ إِلَٰهٌ غَيۡرُ ٱللَّهِ يَأۡتِيكُم بِهِۗ ٱنظُرۡ كَيۡفَ نُصَرِّفُ ٱلۡأٓيَٰتِ ثُمَّ هُمۡ يَصۡدِفُونَ" ;
        quran:ayah_text_no_diacratic   "قل ارءيتم ان اخذ الله سمعكم وابصٰركم وختم علىٰ قلوبكم من الٰه غير الله ياتيكم به انظر كيف نصرف الايٰت ثم هم يصدفون" ;
        quran:ayahnumber               "46" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "846" ;
        quran:page                     "133" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

