        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2551  quran:ayah_text            "يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡ وَلَا يَشۡفَعُونَ إِلَّا لِمَنِ ٱرۡتَضَىٰ وَهُم مِّنۡ خَشۡيَتِهِۦ مُشۡفِقُونَ" ;
        quran:ayah_text_no_diacratic   "يعلم ما بين ايديهم وما خلفهم ولا يشفعون الا لمن ارتضىٰ وهم من خشيته مشفقون" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "17" ;
