quran:2667  quran:ayah_text            "ذَٰلِكَۖ وَمَن يُعَظِّمۡ حُرُمَٰتِ ٱللَّهِ فَهُوَ خَيۡرٞ لَّهُۥ عِندَ رَبِّهِۦۗ وَأُحِلَّتۡ لَكُمُ ٱلۡأَنۡعَٰمُ إِلَّا مَا يُتۡلَىٰ عَلَيۡكُمۡۖ فَٱجۡتَنِبُواْ ٱلرِّجۡسَ مِنَ ٱلۡأَوۡثَٰنِ وَٱجۡتَنِبُواْ قَوۡلَ ٱلزُّورِ" ;
        quran:ayah_text_no_diacratic   "ذٰلك ومن يعظم حرمٰت الله فهو خير له عند ربه واحلت لكم الانعٰم الا ما يتلىٰ عليكم فاجتنبوا الرجس من الاوثٰن واجتنبوا قول الزور" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "17" ;
