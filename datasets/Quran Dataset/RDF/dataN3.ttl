        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:945  quran:ayah_text             "قُل لَّآ أَجِدُ فِي مَآ أُوحِيَ إِلَيَّ مُحَرَّمًا عَلَىٰ طَاعِمٖ يَطۡعَمُهُۥٓ إِلَّآ أَن يَكُونَ مَيۡتَةً أَوۡ دَمٗا مَّسۡفُوحًا أَوۡ لَحۡمَ خِنزِيرٖ فَإِنَّهُۥ رِجۡسٌ أَوۡ فِسۡقًا أُهِلَّ لِغَيۡرِ ٱللَّهِ بِهِۦۚ فَمَنِ ٱضۡطُرَّ غَيۡرَ بَاغٖ وَلَا عَادٖ فَإِنَّ رَبَّكَ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "قل لا اجد في ما اوحي الي محرما علىٰ طاعم يطعمه الا ان يكون ميتة او دما مسفوحا او لحم خنزير فانه رجس او فسقا اهل لغير الله به فمن اضطر غير باغ ولا عاد فان ربك غفور رحيم" ;
        quran:ayahnumber               "145" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "945" ;
        quran:page                     "147" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1047  quran:ayah_text            "وَلُوطًا إِذۡ قَالَ لِقَوۡمِهِۦٓ أَتَأۡتُونَ ٱلۡفَٰحِشَةَ مَا سَبَقَكُم بِهَا مِنۡ أَحَدٖ مِّنَ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "ولوطا اذ قال لقومه اتاتون الفٰحشة ما سبقكم بها من احد من العٰلمين" ;
        quran:ayahnumber               "80" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1047" ;
        quran:page                     "160" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:755  quran:ayah_text             "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لَا تَغۡلُواْ فِي دِينِكُمۡ غَيۡرَ ٱلۡحَقِّ وَلَا تَتَّبِعُوٓاْ أَهۡوَآءَ قَوۡمٖ قَدۡ ضَلُّواْ مِن قَبۡلُ وَأَضَلُّواْ كَثِيرٗا وَضَلُّواْ عَن سَوَآءِ ٱلسَّبِيلِ" ;
        quran:ayah_text_no_diacratic   "قل يٰاهل الكتٰب لا تغلوا في دينكم غير الحق ولا تتبعوا اهواء قوم قد ضلوا من قبل واضلوا كثيرا وضلوا عن سواء السبيل" ;
        quran:ayahnumber               "77" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "755" ;
        quran:page                     "120" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:565  quran:ayah_text             "فَلَا وَرَبِّكَ لَا يُؤۡمِنُونَ حَتَّىٰ يُحَكِّمُوكَ فِيمَا شَجَرَ بَيۡنَهُمۡ ثُمَّ لَا يَجِدُواْ فِيٓ أَنفُسِهِمۡ حَرَجٗا مِّمَّا قَضَيۡتَ وَيُسَلِّمُواْ تَسۡلِيمٗا" ;
        quran:ayah_text_no_diacratic   "فلا وربك لا يؤمنون حتىٰ يحكموك فيما شجر بينهم ثم لا يجدوا في انفسهم حرجا مما قضيت ويسلموا تسليما" ;
        quran:ayahnumber               "65" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "565" ;
        quran:page                     "88" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2001  quran:ayah_text            "وَٱللَّهُ خَلَقَكُمۡ ثُمَّ يَتَوَفَّىٰكُمۡۚ وَمِنكُم مَّن يُرَدُّ إِلَىٰٓ أَرۡذَلِ ٱلۡعُمُرِ لِكَيۡ لَا يَعۡلَمَ بَعۡدَ عِلۡمٖ شَيۡـًٔاۚ إِنَّ ٱللَّهَ عَلِيمٞ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "والله خلقكم ثم يتوفىٰكم ومنكم من يرد الىٰ ارذل العمر لكي لا يعلم بعد علم شيا ان الله عليم قدير" ;
        quran:ayahnumber               "70" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "2001" ;
        quran:page                     "274" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:375  quran:ayah_text             "إِنَّ ٱلَّذِينَ يَشۡتَرُونَ بِعَهۡدِ ٱللَّهِ وَأَيۡمَٰنِهِمۡ ثَمَنٗا قَلِيلًا أُوْلَٰٓئِكَ لَا خَلَٰقَ لَهُمۡ فِي ٱلۡأٓخِرَةِ وَلَا يُكَلِّمُهُمُ ٱللَّهُ وَلَا يَنظُرُ إِلَيۡهِمۡ يَوۡمَ ٱلۡقِيَٰمَةِ وَلَا يُزَكِّيهِمۡ وَلَهُمۡ عَذَابٌ أَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "ان الذين يشترون بعهد الله وايمٰنهم ثمنا قليلا اولٰئك لا خلٰق لهم في الاخرة ولا يكلمهم الله ولا ينظر اليهم يوم القيٰمة ولا يزكيهم ولهم عذاب اليم" ;
        quran:ayahnumber               "77" ;
        quran:chapter                  "3" ;
        quran:hizb                     "6" ;
        quran:index                    "375" ;
        quran:page                     "59" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:185  quran:ayah_text             "أُوْلَٰٓئِكَ ٱلَّذِينَ ٱشۡتَرَوُاْ ٱلضَّلَٰلَةَ بِٱلۡهُدَىٰ وَٱلۡعَذَابَ بِٱلۡمَغۡفِرَةِۚ فَمَآ أَصۡبَرَهُمۡ عَلَى ٱلنَّارِ" ;
        quran:ayah_text_no_diacratic   "اولٰئك الذين اشتروا الضلٰلة بالهدىٰ والعذاب بالمغفرة فما اصبرهم على النار" ;
        quran:ayahnumber               "175" ;
        quran:chapter                  "2" ;
        quran:hizb                     "2" ;
        quran:index                    "185" ;
        quran:page                     "26" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1979  quran:ayah_text            "أَوَلَمۡ يَرَوۡاْ إِلَىٰ مَا خَلَقَ ٱللَّهُ مِن شَيۡءٖ يَتَفَيَّؤُاْ ظِلَٰلُهُۥ عَنِ ٱلۡيَمِينِ وَٱلشَّمَآئِلِ سُجَّدٗا لِّلَّهِ وَهُمۡ دَٰخِرُونَ" ;
        quran:ayah_text_no_diacratic   "اولم يروا الىٰ ما خلق الله من شيء يتفيؤا ظلٰله عن اليمين والشمائل سجدا لله وهم دٰخرون" ;
        quran:ayahnumber               "48" ;
        quran:chapter                  "14" ;
        quran:hizb                     "27" ;
        quran:index                    "1979" ;
        quran:page                     "272" ;
        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:1789  quran:ayah_text            "وَقَالَ ٱلَّذِينَ كَفَرُواْ لِرُسُلِهِمۡ لَنُخۡرِجَنَّكُم مِّنۡ أَرۡضِنَآ أَوۡ لَتَعُودُنَّ فِي مِلَّتِنَاۖ فَأَوۡحَىٰٓ إِلَيۡهِمۡ رَبُّهُمۡ لَنُهۡلِكَنَّ ٱلظَّٰلِمِينَ" ;
        quran:ayah_text_no_diacratic   "وقال الذين كفروا لرسلهم لنخرجنكم من ارضنا او لتعودن في ملتنا فاوحىٰ اليهم ربهم لنهلكن الظٰلمين" ;
        quran:ayahnumber               "13" ;
        quran:chapter                  "13" ;
        quran:hizb                     "25" ;
        quran:index                    "1789" ;
        quran:page                     "257" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:2933  quran:ayah_text            "وَقَالَ ٱلرَّسُولُ يَٰرَبِّ إِنَّ قَوۡمِي ٱتَّخَذُواْ هَٰذَا ٱلۡقُرۡءَانَ مَهۡجُورٗا" ;
        quran:ayah_text_no_diacratic   "وقال الرسول يٰرب ان قومي اتخذوا هٰذا القرءان مهجورا" ;
