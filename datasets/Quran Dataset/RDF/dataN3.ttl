        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:5270  quran:ayah_text            "إِن يَثۡقَفُوكُمۡ يَكُونُواْ لَكُمۡ أَعۡدَآءٗ وَيَبۡسُطُوٓاْ إِلَيۡكُمۡ أَيۡدِيَهُمۡ وَأَلۡسِنَتَهُم بِٱلسُّوٓءِ وَوَدُّواْ لَوۡ تَكۡفُرُونَ" ;
        quran:ayah_text_no_diacratic   "ان يثقفوكم يكونوا لكم اعداء ويبسطوا اليكم ايديهم والسنتهم بالسوء وودوا لو تكفرون" ;
        quran:ayahnumber               "2" ;
        quran:chapter                  "28" ;
        quran:hizb                     "54" ;
        quran:index                    "5270" ;
        quran:page                     "549" ;
        quran:surahname                "سُورَةُ المُمۡتَحنَةِ" ;
        quran:surahnumber              "60" ;
        quran:surrahname_no_diacratic  "سورة الممتحنة" .

quran:2439  quran:ayah_text            "ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ مَهۡدٗا وَسَلَكَ لَكُمۡ فِيهَا سُبُلٗا وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجۡنَا بِهِۦٓ أَزۡوَٰجٗا مِّن نَّبَاتٖ شَتَّىٰ" ;
        quran:ayah_text_no_diacratic   "الذي جعل لكم الارض مهدا وسلك لكم فيها سبلا وانزل من السماء ماء فاخرجنا به ازوٰجا من نبات شتىٰ" ;
        quran:ayahnumber               "53" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2439" ;
