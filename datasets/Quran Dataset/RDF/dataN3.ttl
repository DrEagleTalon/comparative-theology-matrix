        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:1113  quran:ayah_text            "سَأَصۡرِفُ عَنۡ ءَايَٰتِيَ ٱلَّذِينَ يَتَكَبَّرُونَ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّ وَإِن يَرَوۡاْ كُلَّ ءَايَةٖ لَّا يُؤۡمِنُواْ بِهَا وَإِن يَرَوۡاْ سَبِيلَ ٱلرُّشۡدِ لَا يَتَّخِذُوهُ سَبِيلٗا وَإِن يَرَوۡاْ سَبِيلَ ٱلۡغَيِّ يَتَّخِذُوهُ سَبِيلٗاۚ ذَٰلِكَ بِأَنَّهُمۡ كَذَّبُواْ بِـَٔايَٰتِنَا وَكَانُواْ عَنۡهَا غَٰفِلِينَ" ;
        quran:ayah_text_no_diacratic   "ساصرف عن ءايٰتي الذين يتكبرون في الارض بغير الحق وان يروا كل ءاية لا يؤمنوا بها وان يروا سبيل الرشد لا يتخذوه سبيلا وان يروا سبيل الغي يتخذوه سبيلا ذٰلك بانهم كذبوا بايٰتنا وكانوا عنها غٰفلين" ;
        quran:ayahnumber               "146" ;
        quran:chapter                  "9" ;
        quran:hizb                     "16" ;
        quran:index                    "1113" ;
        quran:page                     "168" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:821  quran:ayah_text             "وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوۡ كَذَّبَ بِـَٔايَٰتِهِۦٓۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلظَّٰلِمُونَ" ;
        quran:ayah_text_no_diacratic   "ومن اظلم ممن افترىٰ على الله كذبا او كذب بايٰته انه لا يفلح الظٰلمون" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
