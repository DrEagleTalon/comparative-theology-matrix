quran:1469  quran:ayah_text            "وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰ وَأَخِيهِ أَن تَبَوَّءَا لِقَوۡمِكُمَا بِمِصۡرَ بُيُوتٗا وَٱجۡعَلُواْ بُيُوتَكُمۡ قِبۡلَةٗ وَأَقِيمُواْ ٱلصَّلَوٰةَۗ وَبَشِّرِ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "واوحينا الىٰ موسىٰ واخيه ان تبوءا لقومكما بمصر بيوتا واجعلوا بيوتكم قبلة واقيموا الصلوٰة وبشر المؤمنين" ;
        quran:ayahnumber               "87" ;
        quran:chapter                  "11" ;
        quran:hizb                     "21" ;
        quran:index                    "1469" ;
        quran:page                     "218" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2613  quran:ayah_text            "فَٱسۡتَجَبۡنَا لَهُۥ وَوَهَبۡنَا لَهُۥ يَحۡيَىٰ وَأَصۡلَحۡنَا لَهُۥ زَوۡجَهُۥٓۚ إِنَّهُمۡ كَانُواْ يُسَٰرِعُونَ فِي ٱلۡخَيۡرَٰتِ وَيَدۡعُونَنَا رَغَبٗا وَرَهَبٗاۖ وَكَانُواْ لَنَا خَٰشِعِينَ" ;
        quran:ayah_text_no_diacratic   "فاستجبنا له ووهبنا له يحيىٰ واصلحنا له زوجه انهم كانوا يسٰرعون في الخيرٰت ويدعوننا رغبا ورهبا وكانوا لنا خٰشعين" ;
        quran:ayahnumber               "90" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2613" ;
        quran:page                     "329" ;
        quran:surahname                "سُورَةُ الأَنبِيَاءِ" ;
        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3517  quran:ayah_text            "فَٱنظُرۡ إِلَىٰٓ ءَاثَٰرِ رَحۡمَتِ ٱللَّهِ كَيۡفَ يُحۡيِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَآۚ إِنَّ ذَٰلِكَ لَمُحۡيِ ٱلۡمَوۡتَىٰۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "فانظر الىٰ ءاثٰر رحمت الله كيف يحي الارض بعد موتها ان ذٰلك لمحي الموتىٰ وهو علىٰ كل شيء قدير" ;
        quran:ayahnumber               "50" ;
        quran:chapter                  "21" ;
        quran:hizb                     "40" ;
        quran:index                    "3517" ;
        quran:page                     "409" ;
        quran:surahname                "سُورَةُ الرُّومِ" ;
        quran:surahnumber              "30" ;
        quran:surrahname_no_diacratic  "سورة الروم" .
