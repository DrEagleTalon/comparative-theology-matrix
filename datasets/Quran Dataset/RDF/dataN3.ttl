        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1227  quran:ayah_text            "كَدَأۡبِ ءَالِ فِرۡعَوۡنَ وَٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَفَرُواْ بِـَٔايَٰتِ ٱللَّهِ فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمۡۚ إِنَّ ٱللَّهَ قَوِيّٞ شَدِيدُ ٱلۡعِقَابِ" ;
        quran:ayah_text_no_diacratic   "كداب ءال فرعون والذين من قبلهم كفروا بايٰت الله فاخذهم الله بذنوبهم ان الله قوي شديد العقاب" ;
        quran:ayahnumber               "52" ;
        quran:chapter                  "10" ;
