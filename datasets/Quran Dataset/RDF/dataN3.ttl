quran:5201  quran:ayah_text            "يُنَادُونَهُمۡ أَلَمۡ نَكُن مَّعَكُمۡۖ قَالُواْ بَلَىٰ وَلَٰكِنَّكُمۡ فَتَنتُمۡ أَنفُسَكُمۡ وَتَرَبَّصۡتُمۡ وَٱرۡتَبۡتُمۡ وَغَرَّتۡكُمُ ٱلۡأَمَانِيُّ حَتَّىٰ جَآءَ أَمۡرُ ٱللَّهِ وَغَرَّكُم بِٱللَّهِ ٱلۡغَرُورُ" ;
        quran:ayah_text_no_diacratic   "ينادونهم الم نكن معكم قالوا بلىٰ ولٰكنكم فتنتم انفسكم وتربصتم وارتبتم وغرتكم الاماني حتىٰ جاء امر الله وغركم بالله الغرور" ;
        quran:ayahnumber               "14" ;
        quran:chapter                  "27" ;
        quran:hizb                     "53" ;
        quran:index                    "5201" ;
        quran:page                     "539" ;
        quran:surahname                "سُورَةُ الحَدِيدِ" ;
        quran:surahnumber              "57" ;
        quran:surrahname_no_diacratic  "سورة الحديد" .

