        quran:surahnumber              "37" ;
        quran:surrahname_no_diacratic  "سورة الصافات" .

quran:1698  quran:ayah_text            "فَلَمَّا ٱسۡتَيۡـَٔسُواْ مِنۡهُ خَلَصُواْ نَجِيّٗاۖ قَالَ كَبِيرُهُمۡ أَلَمۡ تَعۡلَمُوٓاْ أَنَّ أَبَاكُمۡ قَدۡ أَخَذَ عَلَيۡكُم مَّوۡثِقٗا مِّنَ ٱللَّهِ وَمِن قَبۡلُ مَا فَرَّطتُمۡ فِي يُوسُفَۖ فَلَنۡ أَبۡرَحَ ٱلۡأَرۡضَ حَتَّىٰ يَأۡذَنَ لِيٓ أَبِيٓ أَوۡ يَحۡكُمَ ٱللَّهُ لِيۖ وَهُوَ خَيۡرُ ٱلۡحَٰكِمِينَ" ;
        quran:ayah_text_no_diacratic   "فلما استيسوا منه خلصوا نجيا قال كبيرهم الم تعلموا ان اباكم قد اخذ عليكم موثقا من الله ومن قبل ما فرطتم في يوسف فلن ابرح الارض حتىٰ ياذن لي ابي او يحكم الله لي وهو خير الحٰكمين" ;
        quran:ayahnumber               "80" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1698" ;
        quran:page                     "245" ;
        quran:surahname                "سُورَةُ يُوسُفَ" ;
        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2842  quran:ayah_text            "إِلَّا ٱلَّذِينَ تَابُواْ مِنۢ بَعۡدِ ذَٰلِكَ وَأَصۡلَحُواْ فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "الا الذين تابوا من بعد ذٰلك واصلحوا فان الله غفور رحيم" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2842" ;
        quran:page                     "350" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:3746  quran:ayah_text            "وَلَا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰۚ وَإِن تَدۡعُ مُثۡقَلَةٌ إِلَىٰ حِمۡلِهَا لَا يُحۡمَلۡ مِنۡهُ شَيۡءٞ وَلَوۡ كَانَ ذَا قُرۡبَىٰٓۗ إِنَّمَا تُنذِرُ ٱلَّذِينَ يَخۡشَوۡنَ رَبَّهُم بِٱلۡغَيۡبِ وَأَقَامُواْ ٱلصَّلَوٰةَۚ وَمَن تَزَكَّىٰ فَإِنَّمَا يَتَزَكَّىٰ لِنَفۡسِهِۦۚ وَإِلَى ٱللَّهِ ٱلۡمَصِيرُ" ;
        quran:ayah_text_no_diacratic   "ولا تزر وازرة وزر اخرىٰ وان تدع مثقلة الىٰ حملها لا يحمل منه شيء ولو كان ذا قربىٰ انما تنذر الذين يخشون ربهم بالغيب واقاموا الصلوٰة ومن تزكىٰ فانما يتزكىٰ لنفسه والى الله المصير" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "22" ;
        quran:hizb                     "43" ;
        quran:index                    "3746" ;
        quran:page                     "436" ;
        quran:surahname                "سُورَةُ فَاطِرٍ" ;
        quran:surahnumber              "35" ;
        quran:surrahname_no_diacratic  "سورة فاطر" .

quran:2652  quran:ayah_text            "مَن كَانَ يَظُنُّ أَن لَّن يَنصُرَهُ ٱللَّهُ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ فَلۡيَمۡدُدۡ بِسَبَبٍ إِلَى ٱلسَّمَآءِ ثُمَّ لۡيَقۡطَعۡ فَلۡيَنظُرۡ هَلۡ يُذۡهِبَنَّ كَيۡدُهُۥ مَا يَغِيظُ" ;
        quran:ayah_text_no_diacratic   "من كان يظن ان لن ينصره الله في الدنيا والاخرة فليمدد بسبب الى السماء ثم ليقطع فلينظر هل يذهبن كيده ما يغيظ" ;
        quran:ayahnumber               "15" ;
        quran:chapter                  "17" ;
        quran:hizb                     "33" ;
        quran:index                    "2652" ;
        quran:page                     "333" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:3556  quran:ayah_text            "وَلَوۡ أَنَّمَا فِي ٱلۡأَرۡضِ مِن شَجَرَةٍ أَقۡلَٰمٞ وَٱلۡبَحۡرُ يَمُدُّهُۥ مِنۢ بَعۡدِهِۦ سَبۡعَةُ أَبۡحُرٖ مَّا نَفِدَتۡ كَلِمَٰتُ ٱللَّهِۚ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ" ;
        quran:ayah_text_no_diacratic   "ولو انما في الارض من شجرة اقلٰم والبحر يمده من بعده سبعة ابحر ما نفدت كلمٰت الله ان الله عزيز حكيم" ;
        quran:ayahnumber               "27" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3556" ;
        quran:page                     "413" ;
        quran:surahname                "سُورَةُ لُقۡمَانَ" ;
        quran:surahnumber              "31" ;
        quran:surrahname_no_diacratic  "سورة لقمان" .

quran:4700  quran:ayah_text            "سُنَّةَ ٱللَّهِ ٱلَّتِي قَدۡ خَلَتۡ مِن قَبۡلُۖ وَلَن تَجِدَ لِسُنَّةِ ٱللَّهِ تَبۡدِيلٗا" ;
        quran:ayah_text_no_diacratic   "سنة الله التي قد خلت من قبل ولن تجد لسنة الله تبديلا" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "26" ;
        quran:hizb                     "51" ;
        quran:index                    "4700" ;
        quran:page                     "513" ;
        quran:surahname                "سُورَةُ الفَتۡحِ" ;
        quran:surahnumber              "48" ;
        quran:surrahname_no_diacratic  "سورة الفتح" .

quran:2462  quran:ayah_text            "جَنَّٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ مَن تَزَكَّىٰ" ;
        quran:ayah_text_no_diacratic   "جنٰت عدن تجري من تحتها الانهٰر خٰلدين فيها وذٰلك جزاء من تزكىٰ" ;
