        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1205  quran:ayah_text            "وَإِذۡ يَمۡكُرُ بِكَ ٱلَّذِينَ كَفَرُواْ لِيُثۡبِتُوكَ أَوۡ يَقۡتُلُوكَ أَوۡ يُخۡرِجُوكَۚ وَيَمۡكُرُونَ وَيَمۡكُرُ ٱللَّهُۖ وَٱللَّهُ خَيۡرُ ٱلۡمَٰكِرِينَ" ;
        quran:ayah_text_no_diacratic   "واذ يمكر بك الذين كفروا ليثبتوك او يقتلوك او يخرجوك ويمكرون ويمكر الله والله خير المٰكرين" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "9" ;
        quran:hizb                     "18" ;
        quran:index                    "1205" ;
        quran:page                     "180" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:913  quran:ayah_text             "وَلِتَصۡغَىٰٓ إِلَيۡهِ أَفۡـِٔدَةُ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ وَلِيَرۡضَوۡهُ وَلِيَقۡتَرِفُواْ مَا هُم مُّقۡتَرِفُونَ" ;
        quran:ayah_text_no_diacratic   "ولتصغىٰ اليه افدة الذين لا يؤمنون بالاخرة وليرضوه وليقترفوا ما هم مقترفون" ;
        quran:ayahnumber               "113" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "913" ;
        quran:page                     "142" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
