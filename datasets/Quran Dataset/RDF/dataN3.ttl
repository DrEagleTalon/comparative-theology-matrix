        quran:surahnumber              "25" ;
        quran:surrahname_no_diacratic  "سورة الفرقان" .

quran:3846  quran:ayah_text            "أَوَلَمۡ يَرَوۡاْ أَنَّا خَلَقۡنَا لَهُم مِّمَّا عَمِلَتۡ أَيۡدِينَآ أَنۡعَٰمٗا فَهُمۡ لَهَا مَٰلِكُونَ" ;
        quran:ayah_text_no_diacratic   "اولم يروا انا خلقنا لهم مما عملت ايدينا انعٰما فهم لها مٰلكون" ;
        quran:ayahnumber               "71" ;
