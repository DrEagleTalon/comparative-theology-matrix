        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:2088  quran:ayah_text            "إِنَّ ٱلۡمُبَذِّرِينَ كَانُوٓاْ إِخۡوَٰنَ ٱلشَّيَٰطِينِۖ وَكَانَ ٱلشَّيۡطَٰنُ لِرَبِّهِۦ كَفُورٗا" ;
        quran:ayah_text_no_diacratic   "ان المبذرين كانوا اخوٰن الشيٰطين وكان الشيطٰن لربه كفورا" ;
        quran:ayahnumber               "27" ;
