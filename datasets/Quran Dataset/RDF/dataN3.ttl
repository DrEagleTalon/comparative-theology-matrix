quran:4322  quran:ayah_text            "فَإِن يَصۡبِرُواْ فَٱلنَّارُ مَثۡوٗى لَّهُمۡۖ وَإِن يَسۡتَعۡتِبُواْ فَمَا هُم مِّنَ ٱلۡمُعۡتَبِينَ" ;
        quran:ayah_text_no_diacratic   "فان يصبروا فالنار مثوى لهم وان يستعتبوا فما هم من المعتبين" ;
        quran:ayahnumber               "24" ;
        quran:chapter                  "24" ;
        quran:hizb                     "47" ;
        quran:index                    "4322" ;
        quran:page                     "479" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
