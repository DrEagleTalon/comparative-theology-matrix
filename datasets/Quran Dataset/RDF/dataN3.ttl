quran:2202  quran:ayah_text            "وَٱصۡبِرۡ نَفۡسَكَ مَعَ ٱلَّذِينَ يَدۡعُونَ رَبَّهُم بِٱلۡغَدَوٰةِ وَٱلۡعَشِيِّ يُرِيدُونَ وَجۡهَهُۥۖ وَلَا تَعۡدُ عَيۡنَاكَ عَنۡهُمۡ تُرِيدُ زِينَةَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَلَا تُطِعۡ مَنۡ أَغۡفَلۡنَا قَلۡبَهُۥ عَن ذِكۡرِنَا وَٱتَّبَعَ هَوَىٰهُ وَكَانَ أَمۡرُهُۥ فُرُطٗا" ;
        quran:ayah_text_no_diacratic   "واصبر نفسك مع الذين يدعون ربهم بالغدوٰة والعشي يريدون وجهه ولا تعد عيناك عنهم تريد زينة الحيوٰة الدنيا ولا تطع من اغفلنا قلبه عن ذكرنا واتبع هوىٰه وكان امره فرطا" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2202" ;
        quran:page                     "297" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:3106  quran:ayah_text            "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ هُودٌ أَلَا تَتَّقُونَ" ;
