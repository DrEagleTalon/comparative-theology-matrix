quran:97  quran:ayah_text              "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ وَقَفَّيۡنَا مِنۢ بَعۡدِهِۦ بِٱلرُّسُلِۖ وَءَاتَيۡنَا عِيسَى ٱبۡنَ مَرۡيَمَ ٱلۡبَيِّنَٰتِ وَأَيَّدۡنَٰهُ بِرُوحِ ٱلۡقُدُسِۗ أَفَكُلَّمَا جَآءَكُمۡ رَسُولُۢ بِمَا لَا تَهۡوَىٰٓ أَنفُسُكُمُ ٱسۡتَكۡبَرۡتُمۡ فَفَرِيقٗا كَذَّبۡتُمۡ وَفَرِيقٗا تَقۡتُلُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد ءاتينا موسى الكتٰب وقفينا من بعده بالرسل وءاتينا عيسى ابن مريم البينٰت وايدنٰه بروح القدس افكلما جاءكم رسول بما لا تهوىٰ انفسكم استكبرتم ففريقا كذبتم وفريقا تقتلون" ;
        quran:ayahnumber               "87" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "97" ;
        quran:page                     "13" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1228  quran:ayah_text            "ذَٰلِكَ بِأَنَّ ٱللَّهَ لَمۡ يَكُ مُغَيِّرٗا نِّعۡمَةً أَنۡعَمَهَا عَلَىٰ قَوۡمٍ حَتَّىٰ يُغَيِّرُواْ مَا بِأَنفُسِهِمۡ وَأَنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "ذٰلك بان الله لم يك مغيرا نعمة انعمها علىٰ قوم حتىٰ يغيروا ما بانفسهم وان الله سميع عليم" ;
        quran:ayahnumber               "53" ;
        quran:chapter                  "10" ;
        quran:hizb                     "18" ;
        quran:index                    "1228" ;
        quran:page                     "184" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:936  quran:ayah_text             "وَجَعَلُواْ لِلَّهِ مِمَّا ذَرَأَ مِنَ ٱلۡحَرۡثِ وَٱلۡأَنۡعَٰمِ نَصِيبٗا فَقَالُواْ هَٰذَا لِلَّهِ بِزَعۡمِهِمۡ وَهَٰذَا لِشُرَكَآئِنَاۖ فَمَا كَانَ لِشُرَكَآئِهِمۡ فَلَا يَصِلُ إِلَى ٱللَّهِۖ وَمَا كَانَ لِلَّهِ فَهُوَ يَصِلُ إِلَىٰ شُرَكَآئِهِمۡۗ سَآءَ مَا يَحۡكُمُونَ" ;
        quran:ayah_text_no_diacratic   "وجعلوا لله مما ذرا من الحرث والانعٰم نصيبا فقالوا هٰذا لله بزعمهم وهٰذا لشركائنا فما كان لشركائهم فلا يصل الى الله وما كان لله فهو يصل الىٰ شركائهم ساء ما يحكمون" ;
        quran:ayahnumber               "136" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "936" ;
        quran:page                     "145" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:1038  quran:ayah_text            "قَالَ قَدۡ وَقَعَ عَلَيۡكُم مِّن رَّبِّكُمۡ رِجۡسٞ وَغَضَبٌۖ أَتُجَٰدِلُونَنِي فِيٓ أَسۡمَآءٖ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّا نَزَّلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٖۚ فَٱنتَظِرُوٓاْ إِنِّي مَعَكُم مِّنَ ٱلۡمُنتَظِرِينَ" ;
        quran:ayah_text_no_diacratic   "قال قد وقع عليكم من ربكم رجس وغضب اتجٰدلونني في اسماء سميتموها انتم وءاباؤكم ما نزل الله بها من سلطٰن فانتظروا اني معكم من المنتظرين" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "8" ;
        quran:hizb                     "16" ;
        quran:index                    "1038" ;
        quran:page                     "159" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:746  quran:ayah_text             "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لَسۡتُمۡ عَلَىٰ شَيۡءٍ حَتَّىٰ تُقِيمُواْ ٱلتَّوۡرَىٰةَ وَٱلۡإِنجِيلَ وَمَآ أُنزِلَ إِلَيۡكُم مِّن رَّبِّكُمۡۗ وَلَيَزِيدَنَّ كَثِيرٗا مِّنۡهُم مَّآ أُنزِلَ إِلَيۡكَ مِن رَّبِّكَ طُغۡيَٰنٗا وَكُفۡرٗاۖ فَلَا تَأۡسَ عَلَى ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ" ;
        quran:ayah_text_no_diacratic   "قل يٰاهل الكتٰب لستم علىٰ شيء حتىٰ تقيموا التورىٰة والانجيل وما انزل اليكم من ربكم وليزيدن كثيرا منهم ما انزل اليك من ربك طغيٰنا وكفرا فلا تاس على القوم الكٰفرين" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "6" ;
        quran:hizb                     "12" ;
        quran:index                    "746" ;
        quran:page                     "119" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:556  quran:ayah_text             "إِنَّ ٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا سَوۡفَ نُصۡلِيهِمۡ نَارٗا كُلَّمَا نَضِجَتۡ جُلُودُهُم بَدَّلۡنَٰهُمۡ جُلُودًا غَيۡرَهَا لِيَذُوقُواْ ٱلۡعَذَابَۗ إِنَّ ٱللَّهَ كَانَ عَزِيزًا حَكِيمٗا" ;
        quran:ayah_text_no_diacratic   "ان الذين كفروا بايٰتنا سوف نصليهم نارا كلما نضجت جلودهم بدلنٰهم جلودا غيرها ليذوقوا العذاب ان الله كان عزيزا حكيما" ;
        quran:ayahnumber               "56" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "556" ;
        quran:page                     "87" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

