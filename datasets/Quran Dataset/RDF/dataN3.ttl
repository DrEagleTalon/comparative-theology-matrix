        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4109  quran:ayah_text            "قُلۡ إِنَّمَآ أَنَا۠ مُنذِرٞۖ وَمَا مِنۡ إِلَٰهٍ إِلَّا ٱللَّهُ ٱلۡوَٰحِدُ ٱلۡقَهَّارُ" ;
        quran:ayah_text_no_diacratic   "قل انما انا منذر وما من الٰه الا الله الوٰحد القهار" ;
