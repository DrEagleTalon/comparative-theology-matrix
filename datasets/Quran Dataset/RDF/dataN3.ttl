quran:672  quran:ayah_text             "لَّن يَسۡتَنكِفَ ٱلۡمَسِيحُ أَن يَكُونَ عَبۡدٗا لِّلَّهِ وَلَا ٱلۡمَلَٰٓئِكَةُ ٱلۡمُقَرَّبُونَۚ وَمَن يَسۡتَنكِفۡ عَنۡ عِبَادَتِهِۦ وَيَسۡتَكۡبِرۡ فَسَيَحۡشُرُهُمۡ إِلَيۡهِ جَمِيعٗا" ;
        quran:ayah_text_no_diacratic   "لن يستنكف المسيح ان يكون عبدا لله ولا الملٰئكة المقربون ومن يستنكف عن عبادته ويستكبر فسيحشرهم اليه جميعا" ;
        quran:ayahnumber               "172" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "672" ;
        quran:page                     "105" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4106  quran:ayah_text            "وَقَالُواْ مَا لَنَا لَا نَرَىٰ رِجَالٗا كُنَّا نَعُدُّهُم مِّنَ ٱلۡأَشۡرَارِ" ;
