quran:806  quran:ayah_text             "أَلَمۡ يَرَوۡاْ كَمۡ أَهۡلَكۡنَا مِن قَبۡلِهِم مِّن قَرۡنٖ مَّكَّنَّٰهُمۡ فِي ٱلۡأَرۡضِ مَا لَمۡ نُمَكِّن لَّكُمۡ وَأَرۡسَلۡنَا ٱلسَّمَآءَ عَلَيۡهِم مِّدۡرَارٗا وَجَعَلۡنَا ٱلۡأَنۡهَٰرَ تَجۡرِي مِن تَحۡتِهِمۡ فَأَهۡلَكۡنَٰهُم بِذُنُوبِهِمۡ وَأَنشَأۡنَا مِنۢ بَعۡدِهِمۡ قَرۡنًا ءَاخَرِينَ" ;
        quran:ayah_text_no_diacratic   "الم يروا كم اهلكنا من قبلهم من قرن مكنٰهم في الارض ما لم نمكن لكم وارسلنا السماء عليهم مدرارا وجعلنا الانهٰر تجري من تحتهم فاهلكنٰهم بذنوبهم وانشانا من بعدهم قرنا ءاخرين" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "7" ;
        quran:hizb                     "12" ;
        quran:index                    "806" ;
        quran:page                     "128" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:616  quran:ayah_text             "إِنَّ ٱللَّهَ لَا يَغۡفِرُ أَن يُشۡرَكَ بِهِۦ وَيَغۡفِرُ مَا دُونَ ذَٰلِكَ لِمَن يَشَآءُۚ وَمَن يُشۡرِكۡ بِٱللَّهِ فَقَدۡ ضَلَّ ضَلَٰلَۢا بَعِيدًا" ;
        quran:ayah_text_no_diacratic   "ان الله لا يغفر ان يشرك به ويغفر ما دون ذٰلك لمن يشاء ومن يشرك بالله فقد ضل ضلٰلا بعيدا" ;
        quran:ayahnumber               "116" ;
        quran:chapter                  "5" ;
