        quran:surrahname_no_diacratic  "سورة الحجرات" .

quran:2710  quran:ayah_text            "يَٰٓأَيُّهَا ٱلنَّاسُ ضُرِبَ مَثَلٞ فَٱسۡتَمِعُواْ لَهُۥٓۚ إِنَّ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِ لَن يَخۡلُقُواْ ذُبَابٗا وَلَوِ ٱجۡتَمَعُواْ لَهُۥۖ وَإِن يَسۡلُبۡهُمُ ٱلذُّبَابُ شَيۡـٔٗا لَّا يَسۡتَنقِذُوهُ مِنۡهُۚ ضَعُفَ ٱلطَّالِبُ وَٱلۡمَطۡلُوبُ" ;
        quran:ayah_text_no_diacratic   "يٰايها الناس ضرب مثل فاستمعوا له ان الذين تدعون من دون الله لن يخلقوا ذبابا ولو اجتمعوا له وان يسلبهم الذباب شيا لا يستنقذوه منه ضعف الطالب والمطلوب" ;
        quran:ayahnumber               "73" ;
        quran:chapter                  "17" ;
        quran:hizb                     "34" ;
        quran:index                    "2710" ;
        quran:page                     "341" ;
        quran:surahname                "سُورَةُ الحَجِّ" ;
        quran:surahnumber              "22" ;
        quran:surrahname_no_diacratic  "سورة الحج" .

quran:3614  quran:ayah_text            "قُلۡ مَن ذَا ٱلَّذِي يَعۡصِمُكُم مِّنَ ٱللَّهِ إِنۡ أَرَادَ بِكُمۡ سُوٓءًا أَوۡ أَرَادَ بِكُمۡ رَحۡمَةٗۚ وَلَا يَجِدُونَ لَهُم مِّن دُونِ ٱللَّهِ وَلِيّٗا وَلَا نَصِيرٗا" ;
        quran:ayah_text_no_diacratic   "قل من ذا الذي يعصمكم من الله ان اراد بكم سوءا او اراد بكم رحمة ولا يجدون لهم من دون الله وليا ولا نصيرا" ;
        quran:ayahnumber               "17" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3614" ;
        quran:page                     "420" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1376  quran:ayah_text            "وَأَمَّا ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ فَزَادَتۡهُمۡ رِجۡسًا إِلَىٰ رِجۡسِهِمۡ وَمَاتُواْ وَهُمۡ كَٰفِرُونَ" ;
        quran:ayah_text_no_diacratic   "واما الذين في قلوبهم مرض فزادتهم رجسا الىٰ رجسهم وماتوا وهم كٰفرون" ;
        quran:ayahnumber               "125" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1376" ;
        quran:page                     "207" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4518  quran:ayah_text            "أَنۡ أَدُّوٓاْ إِلَيَّ عِبَادَ ٱللَّهِۖ إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ" ;
        quran:ayah_text_no_diacratic   "ان ادوا الي عباد الله اني لكم رسول امين" ;
        quran:ayahnumber               "18" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4518" ;
        quran:page                     "496" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2520  quran:ayah_text            "وَلَوۡ أَنَّآ أَهۡلَكۡنَٰهُم بِعَذَابٖ مِّن قَبۡلِهِۦ لَقَالُواْ رَبَّنَا لَوۡلَآ أَرۡسَلۡتَ إِلَيۡنَا رَسُولٗا فَنَتَّبِعَ ءَايَٰتِكَ مِن قَبۡلِ أَن نَّذِلَّ وَنَخۡزَىٰ" ;
        quran:ayah_text_no_diacratic   "ولو انا اهلكنٰهم بعذاب من قبله لقالوا ربنا لولا ارسلت الينا رسولا فنتبع ءايٰتك من قبل ان نذل ونخزىٰ" ;
        quran:ayahnumber               "134" ;
        quran:chapter                  "16" ;
        quran:hizb                     "32" ;
        quran:index                    "2520" ;
        quran:page                     "321" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:3424  quran:ayah_text            "وَلُوطًا إِذۡ قَالَ لِقَوۡمِهِۦٓ إِنَّكُمۡ لَتَأۡتُونَ ٱلۡفَٰحِشَةَ مَا سَبَقَكُم بِهَا مِنۡ أَحَدٖ مِّنَ ٱلۡعَٰلَمِينَ" ;
        quran:ayah_text_no_diacratic   "ولوطا اذ قال لقومه انكم لتاتون الفٰحشة ما سبقكم بها من احد من العٰلمين" ;
        quran:ayahnumber               "28" ;
        quran:chapter                  "20" ;
        quran:hizb                     "40" ;
        quran:index                    "3424" ;
        quran:page                     "399" ;
        quran:surahname                "سُورَةُ العَنكَبُوتِ" ;
        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1186  quran:ayah_text            "إِذۡ يُغَشِّيكُمُ ٱلنُّعَاسَ أَمَنَةٗ مِّنۡهُ وَيُنَزِّلُ عَلَيۡكُم مِّنَ ٱلسَّمَآءِ مَآءٗ لِّيُطَهِّرَكُم بِهِۦ وَيُذۡهِبَ عَنكُمۡ رِجۡزَ ٱلشَّيۡطَٰنِ وَلِيَرۡبِطَ عَلَىٰ قُلُوبِكُمۡ وَيُثَبِّتَ بِهِ ٱلۡأَقۡدَامَ" ;
        quran:ayah_text_no_diacratic   "اذ يغشيكم النعاس امنة منه وينزل عليكم من السماء ماء ليطهركم به ويذهب عنكم رجز الشيطٰن وليربط علىٰ قلوبكم ويثبت به الاقدام" ;
        quran:ayahnumber               "11" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1186" ;
        quran:page                     "178" ;
        quran:surahname                "سُورَةُ الأَنفَالِ" ;
        quran:surahnumber              "8" ;
        quran:surrahname_no_diacratic  "سورة الانفال" .

quran:894  quran:ayah_text             "وَلَقَدۡ جِئۡتُمُونَا فُرَٰدَىٰ كَمَا خَلَقۡنَٰكُمۡ أَوَّلَ مَرَّةٖ وَتَرَكۡتُم مَّا خَوَّلۡنَٰكُمۡ وَرَآءَ ظُهُورِكُمۡۖ وَمَا نَرَىٰ مَعَكُمۡ شُفَعَآءَكُمُ ٱلَّذِينَ زَعَمۡتُمۡ أَنَّهُمۡ فِيكُمۡ شُرَكَٰٓؤُاْۚ لَقَد تَّقَطَّعَ بَيۡنَكُمۡ وَضَلَّ عَنكُم مَّا كُنتُمۡ تَزۡعُمُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد جئتمونا فرٰدىٰ كما خلقنٰكم اول مرة وتركتم ما خولنٰكم وراء ظهوركم وما نرىٰ معكم شفعاءكم الذين زعمتم انهم فيكم شركٰؤا لقد تقطع بينكم وضل عنكم ما كنتم تزعمون" ;
        quran:ayahnumber               "94" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "894" ;
        quran:page                     "139" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:2330  quran:ayah_text            "يَٰٓأَبَتِ لَا تَعۡبُدِ ٱلشَّيۡطَٰنَۖ إِنَّ ٱلشَّيۡطَٰنَ كَانَ لِلرَّحۡمَٰنِ عَصِيّٗا" ;
        quran:ayah_text_no_diacratic   "يٰابت لا تعبد الشيطٰن ان الشيطٰن كان للرحمٰن عصيا" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2330" ;
        quran:page                     "308" ;
        quran:surahname                "سُورَةُ مَرۡيَمَ" ;
        quran:surahnumber              "19" ;
        quran:surrahname_no_diacratic  "سورة مريم" .

quran:4328  quran:ayah_text            "إِنَّ ٱلَّذِينَ قَالُواْ رَبُّنَا ٱللَّهُ ثُمَّ ٱسۡتَقَٰمُواْ تَتَنَزَّلُ عَلَيۡهِمُ ٱلۡمَلَٰٓئِكَةُ أَلَّا تَخَافُواْ وَلَا تَحۡزَنُواْ وَأَبۡشِرُواْ بِٱلۡجَنَّةِ ٱلَّتِي كُنتُمۡ تُوعَدُونَ" ;
        quran:ayah_text_no_diacratic   "ان الذين قالوا ربنا الله ثم استقٰموا تتنزل عليهم الملٰئكة الا تخافوا ولا تحزنوا وابشروا بالجنة التي كنتم توعدون" ;
        quran:ayahnumber               "30" ;
        quran:chapter                  "24" ;
        quran:hizb                     "48" ;
        quran:index                    "4328" ;
        quran:page                     "480" ;
        quran:surahname                "سُورَةُ فُصِّلَتۡ" ;
        quran:surahnumber              "41" ;
        quran:surrahname_no_diacratic  "سورة فصلت" .

quran:3234  quran:ayah_text            "إِنِّي وَجَدتُّ ٱمۡرَأَةٗ تَمۡلِكُهُمۡ وَأُوتِيَتۡ مِن كُلِّ شَيۡءٖ وَلَهَا عَرۡشٌ عَظِيمٞ" ;
        quran:ayah_text_no_diacratic   "اني وجدت امراة تملكهم واوتيت من كل شيء ولها عرش عظيم" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3234" ;
        quran:page                     "379" ;
        quran:surahname                "سُورَةُ النَّمۡلِ" ;
        quran:surahnumber              "27" ;
        quran:surrahname_no_diacratic  "سورة النمل" .

quran:4138  quran:ayah_text            "لَّوۡ أَرَادَ ٱللَّهُ أَن يَتَّخِذَ وَلَدٗا لَّٱصۡطَفَىٰ مِمَّا يَخۡلُقُ مَا يَشَآءُۚ سُبۡحَٰنَهُۥۖ هُوَ ٱللَّهُ ٱلۡوَٰحِدُ ٱلۡقَهَّارُ" ;
        quran:ayah_text_no_diacratic   "لو اراد الله ان يتخذ ولدا لاصطفىٰ مما يخلق ما يشاء سبحٰنه هو الله الوٰحد القهار" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
        quran:index                    "4138" ;
        quran:page                     "458" ;
        quran:surahname                "سُورَةُ الزُّمَرِ" ;
        quran:surahnumber              "39" ;
        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:2140  quran:ayah_text            "وَمِنَ ٱلَّيۡلِ فَتَهَجَّدۡ بِهِۦ نَافِلَةٗ لَّكَ عَسَىٰٓ أَن يَبۡعَثَكَ رَبُّكَ مَقَامٗا مَّحۡمُودٗا" ;
        quran:ayah_text_no_diacratic   "ومن اليل فتهجد به نافلة لك عسىٰ ان يبعثك ربك مقاما محمودا" ;
        quran:ayahnumber               "79" ;
        quran:chapter                  "15" ;
        quran:hizb                     "29" ;
        quran:index                    "2140" ;
        quran:page                     "290" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3044  quran:ayah_text            "قَالَ كَلَّآۖ إِنَّ مَعِيَ رَبِّي سَيَهۡدِينِ" ;
        quran:ayah_text_no_diacratic   "قال كلا ان معي ربي سيهدين" ;
        quran:ayahnumber               "62" ;
        quran:chapter                  "19" ;
        quran:hizb                     "37" ;
        quran:index                    "3044" ;
        quran:page                     "370" ;
        quran:surahname                "سُورَةُ الشُّعَرَاءِ" ;
        quran:surahnumber              "26" ;
        quran:surrahname_no_diacratic  "سورة الشعراء" .

quran:36  quran:ayah_text              "۞إِنَّ ٱللَّهَ لَا يَسۡتَحۡيِۦٓ أَن يَضۡرِبَ مَثَلٗا مَّا بَعُوضَةٗ فَمَا فَوۡقَهَاۚ فَأَمَّا ٱلَّذِينَ ءَامَنُواْ فَيَعۡلَمُونَ أَنَّهُ ٱلۡحَقُّ مِن رَّبِّهِمۡۖ وَأَمَّا ٱلَّذِينَ كَفَرُواْ فَيَقُولُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗاۘ يُضِلُّ بِهِۦ كَثِيرٗا وَيَهۡدِي بِهِۦ كَثِيرٗاۚ وَمَا يُضِلُّ بِهِۦٓ إِلَّا ٱلۡفَٰسِقِينَ" ;
        quran:ayah_text_no_diacratic   "ان الله لا يستحي ان يضرب مثلا ما بعوضة فما فوقها فاما الذين ءامنوا فيعلمون انه الحق من ربهم واما الذين كفروا فيقولون ماذا اراد الله بهٰذا مثلا يضل به كثيرا ويهدي به كثيرا وما يضل به الا الفٰسقين" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "1" ;
        quran:hizb                     "0" ;
        quran:index                    "36" ;
        quran:page                     "5" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:3976  quran:ayah_text            "وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ" ;
        quran:ayah_text_no_diacratic   "ونصرنٰهم فكانوا هم الغٰلبين" ;
        quran:ayahnumber               "116" ;
        quran:chapter                  "23" ;
        quran:hizb                     "45" ;
        quran:index                    "3976" ;
        quran:page                     "450" ;
        quran:surahname                "سُورَةُ الصَّافَّاتِ" ;
        quran:surahnumber              "37" ;
        quran:surrahname_no_diacratic  "سورة الصافات" .

quran:2882  quran:ayah_text            "وَٱللَّهُ خَلَقَ كُلَّ دَآبَّةٖ مِّن مَّآءٖۖ فَمِنۡهُم مَّن يَمۡشِي عَلَىٰ بَطۡنِهِۦ وَمِنۡهُم مَّن يَمۡشِي عَلَىٰ رِجۡلَيۡنِ وَمِنۡهُم مَّن يَمۡشِي عَلَىٰٓ أَرۡبَعٖۚ يَخۡلُقُ ٱللَّهُ مَا يَشَآءُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ" ;
        quran:ayah_text_no_diacratic   "والله خلق كل دابة من ماء فمنهم من يمشي علىٰ بطنه ومنهم من يمشي علىٰ رجلين ومنهم من يمشي علىٰ اربع يخلق الله ما يشاء ان الله علىٰ كل شيء قدير" ;
        quran:ayahnumber               "45" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2882" ;
        quran:page                     "356" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:3786  quran:ayah_text            "إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكۡرَ وَخَشِيَ ٱلرَّحۡمَٰنَ بِٱلۡغَيۡبِۖ فَبَشِّرۡهُ بِمَغۡفِرَةٖ وَأَجۡرٖ كَرِيمٍ" ;
        quran:ayah_text_no_diacratic   "انما تنذر من اتبع الذكر وخشي الرحمٰن بالغيب فبشره بمغفرة واجر كريم" ;
