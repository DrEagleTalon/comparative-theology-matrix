        quran:index                    "3390" ;
        quran:page                     "395" ;
        quran:surahname                "سُورَةُ القَصَصِ" ;
        quran:surahnumber              "28" ;
        quran:surrahname_no_diacratic  "سورة القصص" .

quran:4294  quran:ayah_text            "فَلَمَّا جَآءَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ فَرِحُواْ بِمَا عِندَهُم مِّنَ ٱلۡعِلۡمِ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ" ;
        quran:ayah_text_no_diacratic   "فلما جاءتهم رسلهم بالبينٰت فرحوا بما عندهم من العلم وحاق بهم ما كانوا به يستهزءون" ;
