        quran:surahnumber              "12" ;
        quran:surrahname_no_diacratic  "سورة يوسف" .

quran:2843  quran:ayah_text            "وَٱلَّذِينَ يَرۡمُونَ أَزۡوَٰجَهُمۡ وَلَمۡ يَكُن لَّهُمۡ شُهَدَآءُ إِلَّآ أَنفُسُهُمۡ فَشَهَٰدَةُ أَحَدِهِمۡ أَرۡبَعُ شَهَٰدَٰتِۭ بِٱللَّهِ إِنَّهُۥ لَمِنَ ٱلصَّٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "والذين يرمون ازوٰجهم ولم يكن لهم شهداء الا انفسهم فشهٰدة احدهم اربع شهٰدٰت بالله انه لمن الصٰدقين" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "18" ;
        quran:hizb                     "35" ;
        quran:index                    "2843" ;
        quran:page                     "350" ;
        quran:surahname                "سُورَةُ النُّورِ" ;
        quran:surahnumber              "24" ;
        quran:surrahname_no_diacratic  "سورة النور" .

quran:3747  quran:ayah_text            "وَمَا يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ" ;
        quran:ayah_text_no_diacratic   "وما يستوي الاعمىٰ والبصير" ;
