quran:1146  quran:ayah_text            "وَلَقَدۡ ذَرَأۡنَا لِجَهَنَّمَ كَثِيرٗا مِّنَ ٱلۡجِنِّ وَٱلۡإِنسِۖ لَهُمۡ قُلُوبٞ لَّا يَفۡقَهُونَ بِهَا وَلَهُمۡ أَعۡيُنٞ لَّا يُبۡصِرُونَ بِهَا وَلَهُمۡ ءَاذَانٞ لَّا يَسۡمَعُونَ بِهَآۚ أُوْلَٰٓئِكَ كَٱلۡأَنۡعَٰمِ بَلۡ هُمۡ أَضَلُّۚ أُوْلَٰٓئِكَ هُمُ ٱلۡغَٰفِلُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد ذرانا لجهنم كثيرا من الجن والانس لهم قلوب لا يفقهون بها ولهم اعين لا يبصرون بها ولهم ءاذان لا يسمعون بها اولٰئك كالانعٰم بل هم اضل اولٰئك هم الغٰفلون" ;
        quran:ayahnumber               "179" ;
        quran:chapter                  "9" ;
        quran:hizb                     "17" ;
        quran:index                    "1146" ;
        quran:page                     "174" ;
        quran:surahname                "سُورَةُ الأَعۡرَافِ" ;
        quran:surahnumber              "7" ;
        quran:surrahname_no_diacratic  "سورة الاعراف" .

quran:854  quran:ayah_text             "وَإِذَا جَآءَكَ ٱلَّذِينَ يُؤۡمِنُونَ بِـَٔايَٰتِنَا فَقُلۡ سَلَٰمٌ عَلَيۡكُمۡۖ كَتَبَ رَبُّكُمۡ عَلَىٰ نَفۡسِهِ ٱلرَّحۡمَةَ أَنَّهُۥ مَنۡ عَمِلَ مِنكُمۡ سُوٓءَۢا بِجَهَٰلَةٖ ثُمَّ تَابَ مِنۢ بَعۡدِهِۦ وَأَصۡلَحَ فَأَنَّهُۥ غَفُورٞ رَّحِيمٞ" ;
        quran:ayah_text_no_diacratic   "واذا جاءك الذين يؤمنون بايٰتنا فقل سلٰم عليكم كتب ربكم علىٰ نفسه الرحمة انه من عمل منكم سوءا بجهٰلة ثم تاب من بعده واصلح فانه غفور رحيم" ;
        quran:ayahnumber               "54" ;
        quran:chapter                  "7" ;
        quran:hizb                     "13" ;
        quran:index                    "854" ;
        quran:page                     "134" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:664  quran:ayah_text             "وَرُسُلٗا قَدۡ قَصَصۡنَٰهُمۡ عَلَيۡكَ مِن قَبۡلُ وَرُسُلٗا لَّمۡ نَقۡصُصۡهُمۡ عَلَيۡكَۚ وَكَلَّمَ ٱللَّهُ مُوسَىٰ تَكۡلِيمٗا" ;
        quran:ayah_text_no_diacratic   "ورسلا قد قصصنٰهم عليك من قبل ورسلا لم نقصصهم عليك وكلم الله موسىٰ تكليما" ;
        quran:ayahnumber               "164" ;
        quran:chapter                  "6" ;
        quran:hizb                     "10" ;
        quran:index                    "664" ;
        quran:page                     "104" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:2100  quran:ayah_text            "ذَٰلِكَ مِمَّآ أَوۡحَىٰٓ إِلَيۡكَ رَبُّكَ مِنَ ٱلۡحِكۡمَةِۗ وَلَا تَجۡعَلۡ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَتُلۡقَىٰ فِي جَهَنَّمَ مَلُومٗا مَّدۡحُورًا" ;
        quran:ayah_text_no_diacratic   "ذٰلك مما اوحىٰ اليك ربك من الحكمة ولا تجعل مع الله الٰها ءاخر فتلقىٰ في جهنم ملوما مدحورا" ;
        quran:ayahnumber               "39" ;
        quran:chapter                  "15" ;
        quran:hizb                     "28" ;
        quran:index                    "2100" ;
        quran:page                     "286" ;
        quran:surahname                "سُورَةُ الإِسۡرَاءِ" ;
        quran:surahnumber              "17" ;
        quran:surrahname_no_diacratic  "سورة الاسراء" .

quran:3004  quran:ayah_text            "وَتِلۡكَ نِعۡمَةٞ تَمُنُّهَا عَلَيَّ أَنۡ عَبَّدتَّ بَنِيٓ إِسۡرَٰٓءِيلَ" ;
        quran:ayah_text_no_diacratic   "وتلك نعمة تمنها علي ان عبدت بني اسرٰءيل" ;
        quran:ayahnumber               "22" ;
