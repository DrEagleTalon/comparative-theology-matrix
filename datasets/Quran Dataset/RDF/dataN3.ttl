        quran:index                    "1395" ;
        quran:page                     "209" ;
        quran:surahname                "سُورَةُ يُونُسَ" ;
        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4537  quran:ayah_text            "أَهُمۡ خَيۡرٌ أَمۡ قَوۡمُ تُبَّعٖ وَٱلَّذِينَ مِن قَبۡلِهِمۡ أَهۡلَكۡنَٰهُمۡۚ إِنَّهُمۡ كَانُواْ مُجۡرِمِينَ" ;
        quran:ayah_text_no_diacratic   "اهم خير ام قوم تبع والذين من قبلهم اهلكنٰهم انهم كانوا مجرمين" ;
        quran:ayahnumber               "37" ;
