quran:481  quran:ayah_text             "ٱلَّذِينَ قَالُوٓاْ إِنَّ ٱللَّهَ عَهِدَ إِلَيۡنَآ أَلَّا نُؤۡمِنَ لِرَسُولٍ حَتَّىٰ يَأۡتِيَنَا بِقُرۡبَانٖ تَأۡكُلُهُ ٱلنَّارُۗ قُلۡ قَدۡ جَآءَكُمۡ رُسُلٞ مِّن قَبۡلِي بِٱلۡبَيِّنَٰتِ وَبِٱلَّذِي قُلۡتُمۡ فَلِمَ قَتَلۡتُمُوهُمۡ إِن كُنتُمۡ صَٰدِقِينَ" ;
        quran:ayah_text_no_diacratic   "الذين قالوا ان الله عهد الينا الا نؤمن لرسول حتىٰ ياتينا بقربان تاكله النار قل قد جاءكم رسل من قبلي بالبينٰت وبالذي قلتم فلم قتلتموهم ان كنتم صٰدقين" ;
        quran:ayahnumber               "183" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "481" ;
        quran:page                     "74" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:291  quran:ayah_text             "وَٱتَّقُواْ يَوۡمٗا تُرۡجَعُونَ فِيهِ إِلَى ٱللَّهِۖ ثُمَّ تُوَفَّىٰ كُلُّ نَفۡسٖ مَّا كَسَبَتۡ وَهُمۡ لَا يُظۡلَمُونَ" ;
        quran:ayah_text_no_diacratic   "واتقوا يوما ترجعون فيه الى الله ثم توفىٰ كل نفس ما كسبت وهم لا يظلمون" ;
        quran:ayahnumber               "281" ;
        quran:chapter                  "3" ;
        quran:hizb                     "4" ;
        quran:index                    "291" ;
        quran:page                     "47" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:2989  quran:ayah_text            "أَوَلَمۡ يَرَوۡاْ إِلَى ٱلۡأَرۡضِ كَمۡ أَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ" ;
        quran:ayah_text_no_diacratic   "اولم يروا الى الارض كم انبتنا فيها من كل زوج كريم" ;
