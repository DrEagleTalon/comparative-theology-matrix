        quran:surahname                "سُورَةُ النَّحۡلِ" ;
        quran:surahnumber              "16" ;
        quran:surrahname_no_diacratic  "سورة النحل" .

quran:643  quran:ayah_text             "مُّذَبۡذَبِينَ بَيۡنَ ذَٰلِكَ لَآ إِلَىٰ هَٰٓؤُلَآءِ وَلَآ إِلَىٰ هَٰٓؤُلَآءِۚ وَمَن يُضۡلِلِ ٱللَّهُ فَلَن تَجِدَ لَهُۥ سَبِيلٗا" ;
        quran:ayah_text_no_diacratic   "مذبذبين بين ذٰلك لا الىٰ هٰؤلاء ولا الىٰ هٰؤلاء ومن يضلل الله فلن تجد له سبيلا" ;
        quran:ayahnumber               "143" ;
        quran:chapter                  "5" ;
        quran:hizb                     "10" ;
        quran:index                    "643" ;
        quran:page                     "101" ;
