quran:5365  quran:ayah_text            "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ قُوٓاْ أَنفُسَكُمۡ وَأَهۡلِيكُمۡ نَارٗا وَقُودُهَا ٱلنَّاسُ وَٱلۡحِجَارَةُ عَلَيۡهَا مَلَٰٓئِكَةٌ غِلَاظٞ شِدَادٞ لَّا يَعۡصُونَ ٱللَّهَ مَآ أَمَرَهُمۡ وَيَفۡعَلُونَ مَا يُؤۡمَرُونَ" ;
        quran:ayah_text_no_diacratic   "يٰايها الذين ءامنوا قوا انفسكم واهليكم نارا وقودها الناس والحجارة عليها ملٰئكة غلاظ شداد لا يعصون الله ما امرهم ويفعلون ما يؤمرون" ;
        quran:ayahnumber               "6" ;
        quran:chapter                  "28" ;
        quran:hizb                     "56" ;
        quran:index                    "5365" ;
        quran:page                     "560" ;
        quran:surahname                "سُورَةُ التَّحۡرِيمِ" ;
        quran:surahnumber              "66" ;
        quran:surrahname_no_diacratic  "سورة التحريم" .

