quran:1553  quran:ayah_text            "وَأُتۡبِعُواْ فِي هَٰذِهِ ٱلدُّنۡيَا لَعۡنَةٗ وَيَوۡمَ ٱلۡقِيَٰمَةِۗ أَلَآ إِنَّ عَادٗا كَفَرُواْ رَبَّهُمۡۗ أَلَا بُعۡدٗا لِّعَادٖ قَوۡمِ هُودٖ" ;
        quran:ayah_text_no_diacratic   "واتبعوا في هٰذه الدنيا لعنة ويوم القيٰمة الا ان عادا كفروا ربهم الا بعدا لعاد قوم هود" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "12" ;
        quran:hizb                     "22" ;
        quran:index                    "1553" ;
        quran:page                     "228" ;
        quran:surahname                "سُورَةُ هُودٍ" ;
        quran:surahnumber              "11" ;
        quran:surrahname_no_diacratic  "سورة هود" .

quran:2457  quran:ayah_text            "قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِي عَلَّمَكُمُ ٱلسِّحۡرَۖ فَلَأُقَطِّعَنَّ أَيۡدِيَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمۡ فِي جُذُوعِ ٱلنَّخۡلِ وَلَتَعۡلَمُنَّ أَيُّنَآ أَشَدُّ عَذَابٗا وَأَبۡقَىٰ" ;
        quran:ayah_text_no_diacratic   "قال ءامنتم له قبل ان ءاذن لكم انه لكبيركم الذي علمكم السحر فلاقطعن ايديكم وارجلكم من خلٰف ولاصلبنكم في جذوع النخل ولتعلمن اينا اشد عذابا وابقىٰ" ;
        quran:ayahnumber               "71" ;
        quran:chapter                  "16" ;
        quran:hizb                     "31" ;
        quran:index                    "2457" ;
        quran:page                     "316" ;
        quran:surahname                "سُورَةُ طه" ;
        quran:surahnumber              "20" ;
        quran:surrahname_no_diacratic  "سورة طه" .

quran:6192  quran:ayah_text            "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ" ;
        quran:ayah_text_no_diacratic   "وجايء يومئذ بجهنم يومئذ يتذكر الانسٰن وانىٰ له الذكرىٰ" ;
        quran:ayahnumber               "23" ;
        quran:chapter                  "30" ;
        quran:hizb                     "59" ;
        quran:index                    "6192" ;
        quran:page                     "594" ;
        quran:surahname                "سُورَةُ الفَجۡرِ" ;
        quran:surahnumber              "89" ;
        quran:surrahname_no_diacratic  "سورة الفجر" .

quran:3601  quran:ayah_text            "مَّا جَعَلَ ٱللَّهُ لِرَجُلٖ مِّن قَلۡبَيۡنِ فِي جَوۡفِهِۦۚ وَمَا جَعَلَ أَزۡوَٰجَكُمُ ٱلَّٰٓـِٔي تُظَٰهِرُونَ مِنۡهُنَّ أُمَّهَٰتِكُمۡۚ وَمَا جَعَلَ أَدۡعِيَآءَكُمۡ أَبۡنَآءَكُمۡۚ ذَٰلِكُمۡ قَوۡلُكُم بِأَفۡوَٰهِكُمۡۖ وَٱللَّهُ يَقُولُ ٱلۡحَقَّ وَهُوَ يَهۡدِي ٱلسَّبِيلَ" ;
        quran:ayah_text_no_diacratic   "ما جعل الله لرجل من قلبين في جوفه وما جعل ازوٰجكم الٰي تظٰهرون منهن امهٰتكم وما جعل ادعياءكم ابناءكم ذٰلكم قولكم بافوٰهكم والله يقول الحق وهو يهدي السبيل" ;
        quran:ayahnumber               "4" ;
        quran:chapter                  "21" ;
        quran:hizb                     "41" ;
        quran:index                    "3601" ;
        quran:page                     "418" ;
        quran:surahname                "سُورَةُ الأَحۡزَابِ" ;
        quran:surahnumber              "33" ;
        quran:surrahname_no_diacratic  "سورة الاحزاب" .

quran:1363  quran:ayah_text            "ٱلتَّٰٓئِبُونَ ٱلۡعَٰبِدُونَ ٱلۡحَٰمِدُونَ ٱلسَّٰٓئِحُونَ ٱلرَّٰكِعُونَ ٱلسَّٰجِدُونَ ٱلۡأٓمِرُونَ بِٱلۡمَعۡرُوفِ وَٱلنَّاهُونَ عَنِ ٱلۡمُنكَرِ وَٱلۡحَٰفِظُونَ لِحُدُودِ ٱللَّهِۗ وَبَشِّرِ ٱلۡمُؤۡمِنِينَ" ;
        quran:ayah_text_no_diacratic   "التٰئبون العٰبدون الحٰمدون السٰئحون الرٰكعون السٰجدون الامرون بالمعروف والناهون عن المنكر والحٰفظون لحدود الله وبشر المؤمنين" ;
        quran:ayahnumber               "112" ;
        quran:chapter                  "11" ;
        quran:hizb                     "20" ;
        quran:index                    "1363" ;
        quran:page                     "205" ;
        quran:surahname                "سُورَةُ التَّوۡبَةِ" ;
        quran:surahnumber              "9" ;
        quran:surrahname_no_diacratic  "سورة التوبة" .

quran:4505  quran:ayah_text            "أَمۡرٗا مِّنۡ عِندِنَآۚ إِنَّا كُنَّا مُرۡسِلِينَ" ;
        quran:ayah_text_no_diacratic   "امرا من عندنا انا كنا مرسلين" ;
        quran:ayahnumber               "5" ;
        quran:chapter                  "25" ;
        quran:hizb                     "49" ;
        quran:index                    "4505" ;
        quran:page                     "496" ;
        quran:surahname                "سُورَةُ الدُّخَانِ" ;
        quran:surahnumber              "44" ;
        quran:surrahname_no_diacratic  "سورة الدخان" .

quran:2267  quran:ayah_text            "حَتَّىٰٓ إِذَا بَلَغَ بَيۡنَ ٱلسَّدَّيۡنِ وَجَدَ مِن دُونِهِمَا قَوۡمٗا لَّا يَكَادُونَ يَفۡقَهُونَ قَوۡلٗا" ;
        quran:ayah_text_no_diacratic   "حتىٰ اذا بلغ بين السدين وجد من دونهما قوما لا يكادون يفقهون قولا" ;
        quran:ayahnumber               "93" ;
        quran:chapter                  "16" ;
        quran:hizb                     "30" ;
        quran:index                    "2267" ;
        quran:page                     "303" ;
        quran:surahname                "سُورَةُ الكَهۡفِ" ;
        quran:surahnumber              "18" ;
        quran:surrahname_no_diacratic  "سورة الكهف" .

quran:5409  quran:ayah_text            "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖ" ;
        quran:ayah_text_no_diacratic   "وانك لعلىٰ خلق عظيم" ;
        quran:ayahnumber               "4" ;
