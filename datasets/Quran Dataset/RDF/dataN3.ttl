        quran:surahnumber              "10" ;
        quran:surrahname_no_diacratic  "سورة يونس" .

quran:2307  quran:ayah_text            "قَالَ كَذَٰلِكِ قَالَ رَبُّكِ هُوَ عَلَيَّ هَيِّنٞۖ وَلِنَجۡعَلَهُۥٓ ءَايَةٗ لِّلنَّاسِ وَرَحۡمَةٗ مِّنَّاۚ وَكَانَ أَمۡرٗا مَّقۡضِيّٗا" ;
        quran:ayah_text_no_diacratic   "قال كذٰلك قال ربك هو علي هين ولنجعله ءاية للناس ورحمة منا وكان امرا مقضيا" ;
        quran:ayahnumber               "21" ;
        quran:chapter                  "16" ;
