        quran:surrahname_no_diacratic  "سورة الزمر" .

quran:1319  quran:ayah_text            "وَعَدَ ٱللَّهُ ٱلۡمُنَٰفِقِينَ وَٱلۡمُنَٰفِقَٰتِ وَٱلۡكُفَّارَ نَارَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۚ هِيَ حَسۡبُهُمۡۚ وَلَعَنَهُمُ ٱللَّهُۖ وَلَهُمۡ عَذَابٞ مُّقِيمٞ" ;
        quran:ayah_text_no_diacratic   "وعد الله المنٰفقين والمنٰفقٰت والكفار نار جهنم خٰلدين فيها هي حسبهم ولعنهم الله ولهم عذاب مقيم" ;
        quran:ayahnumber               "68" ;
        quran:chapter                  "10" ;
