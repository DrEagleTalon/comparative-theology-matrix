quran:89  quran:ayah_text              "فَوَيۡلٞ لِّلَّذِينَ يَكۡتُبُونَ ٱلۡكِتَٰبَ بِأَيۡدِيهِمۡ ثُمَّ يَقُولُونَ هَٰذَا مِنۡ عِندِ ٱللَّهِ لِيَشۡتَرُواْ بِهِۦ ثَمَنٗا قَلِيلٗاۖ فَوَيۡلٞ لَّهُم مِّمَّا كَتَبَتۡ أَيۡدِيهِمۡ وَوَيۡلٞ لَّهُم مِّمَّا يَكۡسِبُونَ" ;
        quran:ayah_text_no_diacratic   "فويل للذين يكتبون الكتٰب بايديهم ثم يقولون هٰذا من عند الله ليشتروا به ثمنا قليلا فويل لهم مما كتبت ايديهم وويل لهم مما يكسبون" ;
        quran:ayahnumber               "79" ;
        quran:chapter                  "1" ;
        quran:hizb                     "1" ;
        quran:index                    "89" ;
        quran:page                     "12" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:928  quran:ayah_text             "وَيَوۡمَ يَحۡشُرُهُمۡ جَمِيعٗا يَٰمَعۡشَرَ ٱلۡجِنِّ قَدِ ٱسۡتَكۡثَرۡتُم مِّنَ ٱلۡإِنسِۖ وَقَالَ أَوۡلِيَآؤُهُم مِّنَ ٱلۡإِنسِ رَبَّنَا ٱسۡتَمۡتَعَ بَعۡضُنَا بِبَعۡضٖ وَبَلَغۡنَآ أَجَلَنَا ٱلَّذِيٓ أَجَّلۡتَ لَنَاۚ قَالَ ٱلنَّارُ مَثۡوَىٰكُمۡ خَٰلِدِينَ فِيهَآ إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٞ" ;
        quran:ayah_text_no_diacratic   "ويوم يحشرهم جميعا يٰمعشر الجن قد استكثرتم من الانس وقال اولياؤهم من الانس ربنا استمتع بعضنا ببعض وبلغنا اجلنا الذي اجلت لنا قال النار مثوىٰكم خٰلدين فيها الا ما شاء الله ان ربك حكيم عليم" ;
        quran:ayahnumber               "128" ;
        quran:chapter                  "8" ;
        quran:hizb                     "14" ;
        quran:index                    "928" ;
        quran:page                     "144" ;
        quran:surahname                "سُورَةُ الأَنۡعَامِ" ;
        quran:surahnumber              "6" ;
        quran:surrahname_no_diacratic  "سورة الانعام" .

quran:738  quran:ayah_text             "قُلۡ هَلۡ أُنَبِّئُكُم بِشَرّٖ مِّن ذَٰلِكَ مَثُوبَةً عِندَ ٱللَّهِۚ مَن لَّعَنَهُ ٱللَّهُ وَغَضِبَ عَلَيۡهِ وَجَعَلَ مِنۡهُمُ ٱلۡقِرَدَةَ وَٱلۡخَنَازِيرَ وَعَبَدَ ٱلطَّٰغُوتَۚ أُوْلَٰٓئِكَ شَرّٞ مَّكَانٗا وَأَضَلُّ عَن سَوَآءِ ٱلسَّبِيلِ" ;
        quran:ayah_text_no_diacratic   "قل هل انبئكم بشر من ذٰلك مثوبة عند الله من لعنه الله وغضب عليه وجعل منهم القردة والخنازير وعبد الطٰغوت اولٰئك شر مكانا واضل عن سواء السبيل" ;
        quran:ayahnumber               "60" ;
        quran:chapter                  "6" ;
        quran:hizb                     "11" ;
        quran:index                    "738" ;
        quran:page                     "118" ;
        quran:surahname                "سُورَةُ المَائـِدَةِ" ;
        quran:surahnumber              "5" ;
        quran:surrahname_no_diacratic  "سورة المائدة" .

quran:548  quran:ayah_text             "إِنَّ ٱللَّهَ لَا يَغۡفِرُ أَن يُشۡرَكَ بِهِۦ وَيَغۡفِرُ مَا دُونَ ذَٰلِكَ لِمَن يَشَآءُۚ وَمَن يُشۡرِكۡ بِٱللَّهِ فَقَدِ ٱفۡتَرَىٰٓ إِثۡمًا عَظِيمًا" ;
        quran:ayah_text_no_diacratic   "ان الله لا يغفر ان يشرك به ويغفر ما دون ذٰلك لمن يشاء ومن يشرك بالله فقد افترىٰ اثما عظيما" ;
        quran:ayahnumber               "48" ;
        quran:chapter                  "5" ;
        quran:hizb                     "8" ;
        quran:index                    "548" ;
        quran:page                     "86" ;
        quran:surahname                "سُورَةُ النِّسَاءِ" ;
        quran:surahnumber              "4" ;
        quran:surrahname_no_diacratic  "سورة النساء" .

quran:4983  quran:ayah_text            "إِنَّآ أَرۡسَلۡنَا عَلَيۡهِمۡ صَيۡحَةٗ وَٰحِدَةٗ فَكَانُواْ كَهَشِيمِ ٱلۡمُحۡتَظِرِ" ;
        quran:ayah_text_no_diacratic   "انا ارسلنا عليهم صيحة وٰحدة فكانوا كهشيم المحتظر" ;
