        quran:surahnumber              "21" ;
        quran:surrahname_no_diacratic  "سورة الانبياء" .

quran:3457  quran:ayah_text            "وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَسَخَّرَ ٱلشَّمۡسَ وَٱلۡقَمَرَ لَيَقُولُنَّ ٱللَّهُۖ فَأَنَّىٰ يُؤۡفَكُونَ" ;
        quran:ayah_text_no_diacratic   "ولئن سالتهم من خلق السمٰوٰت والارض وسخر الشمس والقمر ليقولن الله فانىٰ يؤفكون" ;
