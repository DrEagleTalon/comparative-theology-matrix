        quran:surrahname_no_diacratic  "سورة الروم" .

quran:4398  quran:ayah_text            "وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِن وَلِيّٖ مِّنۢ بَعۡدِهِۦۗ وَتَرَى ٱلظَّٰلِمِينَ لَمَّا رَأَوُاْ ٱلۡعَذَابَ يَقُولُونَ هَلۡ إِلَىٰ مَرَدّٖ مِّن سَبِيلٖ" ;
        quran:ayah_text_no_diacratic   "ومن يضلل الله فما له من ولي من بعده وترى الظٰلمين لما راوا العذاب يقولون هل الىٰ مرد من سبيل" ;
        quran:ayahnumber               "44" ;
