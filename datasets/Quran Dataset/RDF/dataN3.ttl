quran:484  quran:ayah_text             "۞لَتُبۡلَوُنَّ فِيٓ أَمۡوَٰلِكُمۡ وَأَنفُسِكُمۡ وَلَتَسۡمَعُنَّ مِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ مِن قَبۡلِكُمۡ وَمِنَ ٱلَّذِينَ أَشۡرَكُوٓاْ أَذٗى كَثِيرٗاۚ وَإِن تَصۡبِرُواْ وَتَتَّقُواْ فَإِنَّ ذَٰلِكَ مِنۡ عَزۡمِ ٱلۡأُمُورِ" ;
        quran:ayah_text_no_diacratic   "لتبلون في اموٰلكم وانفسكم ولتسمعن من الذين اوتوا الكتٰب من قبلكم ومن الذين اشركوا اذى كثيرا وان تصبروا وتتقوا فان ذٰلك من عزم الامور" ;
        quran:ayahnumber               "186" ;
        quran:chapter                  "4" ;
        quran:hizb                     "7" ;
        quran:index                    "484" ;
        quran:page                     "74" ;
        quran:surahname                "سُورَةُ آلِ عِمۡرَانَ" ;
        quran:surahnumber              "3" ;
        quran:surrahname_no_diacratic  "سورة ال عمران" .

quran:294  quran:ayah_text             "لِّلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ وَإِن تُبۡدُواْ مَا فِيٓ أَنفُسِكُمۡ أَوۡ تُخۡفُوهُ يُحَاسِبۡكُم بِهِ ٱللَّهُۖ فَيَغۡفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ" ;
        quran:ayah_text_no_diacratic   "لله ما في السمٰوٰت وما في الارض وان تبدوا ما في انفسكم او تخفوه يحاسبكم به الله فيغفر لمن يشاء ويعذب من يشاء والله علىٰ كل شيء قدير" ;
        quran:ayahnumber               "284" ;
        quran:chapter                  "3" ;
        quran:hizb                     "5" ;
        quran:index                    "294" ;
        quran:page                     "49" ;
        quran:surahname                "سُورَةُ البَقَرَةِ" ;
        quran:surahnumber              "2" ;
        quran:surrahname_no_diacratic  "سورة البقرة" .

quran:1898  quran:ayah_text            "قَالَ إِنَّ هَٰٓؤُلَآءِ ضَيۡفِي فَلَا تَفۡضَحُونِ" ;
