        quran:surrahname_no_diacratic  "سورة يونس" .

quran:4626  quran:ayah_text            "وَلَقَدۡ مَكَّنَّٰهُمۡ فِيمَآ إِن مَّكَّنَّٰكُمۡ فِيهِ وَجَعَلۡنَا لَهُمۡ سَمۡعٗا وَأَبۡصَٰرٗا وَأَفۡـِٔدَةٗ فَمَآ أَغۡنَىٰ عَنۡهُمۡ سَمۡعُهُمۡ وَلَآ أَبۡصَٰرُهُمۡ وَلَآ أَفۡـِٔدَتُهُم مِّن شَيۡءٍ إِذۡ كَانُواْ يَجۡحَدُونَ بِـَٔايَٰتِ ٱللَّهِ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ" ;
        quran:ayah_text_no_diacratic   "ولقد مكنٰهم فيما ان مكنٰكم فيه وجعلنا لهم سمعا وابصٰرا وافدة فما اغنىٰ عنهم سمعهم ولا ابصٰرهم ولا افدتهم من شيء اذ كانوا يجحدون بايٰت الله وحاق بهم ما كانوا به يستهزءون" ;
        quran:ayahnumber               "26" ;
        quran:chapter                  "26" ;
        quran:hizb                     "50" ;
        quran:index                    "4626" ;
        quran:page                     "505" ;
        quran:surahname                "سُورَةُ الأَحۡقَافِ" ;
        quran:surahnumber              "46" ;
        quran:surrahname_no_diacratic  "سورة الاحقاف" .

