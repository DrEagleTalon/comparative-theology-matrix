quran:1820  quran:ayah_text            "وَأَنذِرِ ٱلنَّاسَ يَوۡمَ يَأۡتِيهِمُ ٱلۡعَذَابُ فَيَقُولُ ٱلَّذِينَ ظَلَمُواْ رَبَّنَآ أَخِّرۡنَآ إِلَىٰٓ أَجَلٖ قَرِيبٖ نُّجِبۡ دَعۡوَتَكَ وَنَتَّبِعِ ٱلرُّسُلَۗ أَوَلَمۡ تَكُونُوٓاْ أَقۡسَمۡتُم مِّن قَبۡلُ مَا لَكُم مِّن زَوَالٖ" ;
        quran:ayah_text_no_diacratic   "وانذر الناس يوم ياتيهم العذاب فيقول الذين ظلموا ربنا اخرنا الىٰ اجل قريب نجب دعوتك ونتبع الرسل اولم تكونوا اقسمتم من قبل ما لكم من زوال" ;
        quran:ayahnumber               "44" ;
        quran:chapter                  "13" ;
        quran:hizb                     "26" ;
        quran:index                    "1820" ;
        quran:page                     "261" ;
        quran:surahname                "سُورَةُ إِبۡرَاهِيمَ" ;
        quran:surahnumber              "14" ;
        quran:surrahname_no_diacratic  "سورة ابراهيم" .

quran:2724  quran:ayah_text            "فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ" ;
        quran:ayah_text_no_diacratic   "فمن ابتغىٰ وراء ذٰلك فاولٰئك هم العادون" ;
        quran:ayahnumber               "7" ;
