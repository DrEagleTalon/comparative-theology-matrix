        quran:surahnumber              "47" ;
        quran:surrahname_no_diacratic  "سورة محمد" .

quran:2651  quran:ayah_text            "إِنَّ ٱللَّهَ يُدۡخِلُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ إِنَّ ٱللَّهَ يَفۡعَلُ مَا يُرِيدُ" ;
        quran:ayah_text_no_diacratic   "ان الله يدخل الذين ءامنوا وعملوا الصٰلحٰت جنٰت تجري من تحتها الانهٰر ان الله يفعل ما يريد" ;
