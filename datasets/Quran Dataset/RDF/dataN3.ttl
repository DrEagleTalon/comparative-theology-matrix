quran:6421  quran:ayah_text            "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ" ;
        quran:ayah_text_no_diacratic   "بسم الله الرحمٰن الرحيم" ;
