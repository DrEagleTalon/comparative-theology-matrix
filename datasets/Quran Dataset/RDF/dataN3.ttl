quran:1699  quran:ayah_text            "ٱرۡجِعُوٓاْ إِلَىٰٓ أَبِيكُمۡ فَقُولُواْ يَٰٓأَبَانَآ إِنَّ ٱبۡنَكَ سَرَقَ وَمَا شَهِدۡنَآ إِلَّا بِمَا عَلِمۡنَا وَمَا كُنَّا لِلۡغَيۡبِ حَٰفِظِينَ" ;
        quran:ayah_text_no_diacratic   "ارجعوا الىٰ ابيكم فقولوا يٰابانا ان ابنك سرق وما شهدنا الا بما علمنا وما كنا للغيب حٰفظين" ;
        quran:ayahnumber               "81" ;
        quran:chapter                  "13" ;
        quran:hizb                     "24" ;
        quran:index                    "1699" ;
