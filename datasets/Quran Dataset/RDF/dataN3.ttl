        quran:surahnumber              "29" ;
        quran:surrahname_no_diacratic  "سورة العنكبوت" .

quran:1183  quran:ayah_text            "لِيُحِقَّ ٱلۡحَقَّ وَيُبۡطِلَ ٱلۡبَٰطِلَ وَلَوۡ كَرِهَ ٱلۡمُجۡرِمُونَ" ;
        quran:ayah_text_no_diacratic   "ليحق الحق ويبطل البٰطل ولو كره المجرمون" ;
        quran:ayahnumber               "8" ;
