  }, {
    "@id" : "quran:2686",
    "ayah_text" : "قُلۡ يَٰٓأَيُّهَا ٱلنَّاسُ إِنَّمَآ أَنَا۠ لَكُمۡ نَذِيرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "قل يٰايها الناس انما انا لكم نذير مبين",
    "ayahnumber" : "49",
