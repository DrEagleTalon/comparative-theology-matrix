    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1164",
    "ayah_text" : "وَٱلَّذِينَ تَدۡعُونَ مِن دُونِهِۦ لَا يَسۡتَطِيعُونَ نَصۡرَكُمۡ وَلَآ أَنفُسَهُمۡ يَنصُرُونَ",
    "ayah_text_no_diacratic" : "والذين تدعون من دونه لا يستطيعون نصركم ولا انفسهم ينصرون",
