    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2033",
    "ayah_text" : "قُلۡ نَزَّلَهُۥ رُوحُ ٱلۡقُدُسِ مِن رَّبِّكَ بِٱلۡحَقِّ لِيُثَبِّتَ ٱلَّذِينَ ءَامَنُواْ وَهُدٗى وَبُشۡرَىٰ لِلۡمُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "قل نزله روح القدس من ربك بالحق ليثبت الذين ءامنوا وهدى وبشرىٰ للمسلمين",
    "ayahnumber" : "102",
    "chapter" : "14",
