    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4815",
    "ayah_text" : "فَأَخَذۡنَٰهُ وَجُنُودَهُۥ فَنَبَذۡنَٰهُمۡ فِي ٱلۡيَمِّ وَهُوَ مُلِيمٞ",
    "ayah_text_no_diacratic" : "فاخذنٰه وجنوده فنبذنٰهم في اليم وهو مليم",
