  }, {
    "@id" : "quran:5465",
    "ayah_text" : "وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ",
    "ayah_text_no_diacratic" : "واما عاد فاهلكوا بريح صرصر عاتية",
