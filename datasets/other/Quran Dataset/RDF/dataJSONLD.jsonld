    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4971",
    "ayah_text" : "إِنَّآ أَرۡسَلۡنَا عَلَيۡهِمۡ رِيحٗا صَرۡصَرٗا فِي يَوۡمِ نَحۡسٖ مُّسۡتَمِرّٖ",
    "ayah_text_no_diacratic" : "انا ارسلنا عليهم ريحا صرصرا في يوم نحس مستمر",
