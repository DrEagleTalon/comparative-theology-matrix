  }, {
    "@id" : "quran:2299",
    "ayah_text" : "وَحَنَانٗا مِّن لَّدُنَّا وَزَكَوٰةٗۖ وَكَانَ تَقِيّٗا",
    "ayah_text_no_diacratic" : "وحنانا من لدنا وزكوٰة وكان تقيا",
