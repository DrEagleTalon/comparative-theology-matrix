    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:17",
    "ayah_text" : "خَتَمَ ٱللَّهُ عَلَىٰ قُلُوبِهِمۡ وَعَلَىٰ سَمۡعِهِمۡۖ وَعَلَىٰٓ أَبۡصَٰرِهِمۡ غِشَٰوَةٞۖ وَلَهُمۡ عَذَابٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "ختم الله علىٰ قلوبهم وعلىٰ سمعهم وعلىٰ ابصٰرهم غشٰوة ولهم عذاب عظيم",
    "ayahnumber" : "7",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "17",
    "page" : "3",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:170",
    "ayah_text" : "إِلَّا ٱلَّذِينَ تَابُواْ وَأَصۡلَحُواْ وَبَيَّنُواْ فَأُوْلَٰٓئِكَ أَتُوبُ عَلَيۡهِمۡ وَأَنَا ٱلتَّوَّابُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "الا الذين تابوا واصلحوا وبينوا فاولٰئك اتوب عليهم وانا التواب الرحيم",
    "ayahnumber" : "160",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "170",
    "page" : "24",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1700",
    "ayah_text" : "وَسۡـَٔلِ ٱلۡقَرۡيَةَ ٱلَّتِي كُنَّا فِيهَا وَٱلۡعِيرَ ٱلَّتِيٓ أَقۡبَلۡنَا فِيهَاۖ وَإِنَّا لَصَٰدِقُونَ",
    "ayah_text_no_diacratic" : "وسل القرية التي كنا فيها والعير التي اقبلنا فيها وانا لصٰدقون",
    "ayahnumber" : "82",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1700",
    "page" : "245",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1701",
    "ayah_text" : "قَالَ بَلۡ سَوَّلَتۡ لَكُمۡ أَنفُسُكُمۡ أَمۡرٗاۖ فَصَبۡرٞ جَمِيلٌۖ عَسَى ٱللَّهُ أَن يَأۡتِيَنِي بِهِمۡ جَمِيعًاۚ إِنَّهُۥ هُوَ ٱلۡعَلِيمُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "قال بل سولت لكم انفسكم امرا فصبر جميل عسى الله ان ياتيني بهم جميعا انه هو العليم الحكيم",
    "ayahnumber" : "83",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1701",
    "page" : "245",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1702",
    "ayah_text" : "وَتَوَلَّىٰ عَنۡهُمۡ وَقَالَ يَٰٓأَسَفَىٰ عَلَىٰ يُوسُفَ وَٱبۡيَضَّتۡ عَيۡنَاهُ مِنَ ٱلۡحُزۡنِ فَهُوَ كَظِيمٞ",
    "ayah_text_no_diacratic" : "وتولىٰ عنهم وقال يٰاسفىٰ علىٰ يوسف وابيضت عيناه من الحزن فهو كظيم",
    "ayahnumber" : "84",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1702",
    "page" : "245",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1703",
    "ayah_text" : "قَالُواْ تَٱللَّهِ تَفۡتَؤُاْ تَذۡكُرُ يُوسُفَ حَتَّىٰ تَكُونَ حَرَضًا أَوۡ تَكُونَ مِنَ ٱلۡهَٰلِكِينَ",
    "ayah_text_no_diacratic" : "قالوا تالله تفتؤا تذكر يوسف حتىٰ تكون حرضا او تكون من الهٰلكين",
    "ayahnumber" : "85",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1703",
    "page" : "245",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1704",
    "ayah_text" : "قَالَ إِنَّمَآ أَشۡكُواْ بَثِّي وَحُزۡنِيٓ إِلَى ٱللَّهِ وَأَعۡلَمُ مِنَ ٱللَّهِ مَا لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قال انما اشكوا بثي وحزني الى الله واعلم من الله ما لا تعلمون",
    "ayahnumber" : "86",
    "chapter" : "13",
