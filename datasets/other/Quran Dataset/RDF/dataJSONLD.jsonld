  }, {
    "@id" : "quran:770",
    "ayah_text" : "وَأَطِيعُواْ ٱللَّهَ وَأَطِيعُواْ ٱلرَّسُولَ وَٱحۡذَرُواْۚ فَإِن تَوَلَّيۡتُمۡ فَٱعۡلَمُوٓاْ أَنَّمَا عَلَىٰ رَسُولِنَا ٱلۡبَلَٰغُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "واطيعوا الله واطيعوا الرسول واحذروا فان توليتم فاعلموا انما علىٰ رسولنا البلٰغ المبين",
    "ayahnumber" : "92",
