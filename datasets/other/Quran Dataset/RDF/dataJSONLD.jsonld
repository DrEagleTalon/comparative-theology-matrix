  }, {
    "@id" : "quran:8",
    "ayah_text" : "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
    "ayah_text_no_diacratic" : "صرٰط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين",
    "ayahnumber" : "7",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "8",
    "page" : "1",
    "surahname" : "سُورَةُ الفَاتِحَةِ",
    "surahnumber" : "1",
    "surrahname_no_diacratic" : "سورة الفاتحة"
  }, {
    "@id" : "quran:80",
    "ayah_text" : "قَالُواْ ٱدۡعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا هِيَ إِنَّ ٱلۡبَقَرَ تَشَٰبَهَ عَلَيۡنَا وَإِنَّآ إِن شَآءَ ٱللَّهُ لَمُهۡتَدُونَ",
    "ayah_text_no_diacratic" : "قالوا ادع لنا ربك يبين لنا ما هي ان البقر تشٰبه علينا وانا ان شاء الله لمهتدون",
    "ayahnumber" : "70",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "80",
    "page" : "11",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:800",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "7",
    "hizb" : "12",
