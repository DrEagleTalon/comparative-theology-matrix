    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4935",
    "ayah_text" : "وَأَنَّ عَلَيۡهِ ٱلنَّشۡأَةَ ٱلۡأُخۡرَىٰ",
    "ayah_text_no_diacratic" : "وان عليه النشاة الاخرىٰ",
