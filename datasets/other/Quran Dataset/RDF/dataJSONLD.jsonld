    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4968",
    "ayah_text" : "فَكَيۡفَ كَانَ عَذَابِي وَنُذُرِ",
    "ayah_text_no_diacratic" : "فكيف كان عذابي ونذر",
    "ayahnumber" : "16",
    "chapter" : "27",
    "hizb" : "53",
