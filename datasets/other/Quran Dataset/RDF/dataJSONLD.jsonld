    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3505",
    "ayah_text" : "فَـَٔاتِ ذَا ٱلۡقُرۡبَىٰ حَقَّهُۥ وَٱلۡمِسۡكِينَ وَٱبۡنَ ٱلسَّبِيلِۚ ذَٰلِكَ خَيۡرٞ لِّلَّذِينَ يُرِيدُونَ وَجۡهَ ٱللَّهِۖ وَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "فات ذا القربىٰ حقه والمسكين وابن السبيل ذٰلك خير للذين يريدون وجه الله واولٰئك هم المفلحون",
    "ayahnumber" : "38",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3505",
    "page" : "408",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3506",
    "ayah_text" : "وَمَآ ءَاتَيۡتُم مِّن رِّبٗا لِّيَرۡبُوَاْ فِيٓ أَمۡوَٰلِ ٱلنَّاسِ فَلَا يَرۡبُواْ عِندَ ٱللَّهِۖ وَمَآ ءَاتَيۡتُم مِّن زَكَوٰةٖ تُرِيدُونَ وَجۡهَ ٱللَّهِ فَأُوْلَٰٓئِكَ هُمُ ٱلۡمُضۡعِفُونَ",
    "ayah_text_no_diacratic" : "وما ءاتيتم من ربا ليربوا في اموٰل الناس فلا يربوا عند الله وما ءاتيتم من زكوٰة تريدون وجه الله فاولٰئك هم المضعفون",
    "ayahnumber" : "39",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3506",
    "page" : "408",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3507",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي خَلَقَكُمۡ ثُمَّ رَزَقَكُمۡ ثُمَّ يُمِيتُكُمۡ ثُمَّ يُحۡيِيكُمۡۖ هَلۡ مِن شُرَكَآئِكُم مَّن يَفۡعَلُ مِن ذَٰلِكُم مِّن شَيۡءٖۚ سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "الله الذي خلقكم ثم رزقكم ثم يميتكم ثم يحييكم هل من شركائكم من يفعل من ذٰلكم من شيء سبحٰنه وتعٰلىٰ عما يشركون",
    "ayahnumber" : "40",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3507",
    "page" : "408",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3508",
    "ayah_text" : "ظَهَرَ ٱلۡفَسَادُ فِي ٱلۡبَرِّ وَٱلۡبَحۡرِ بِمَا كَسَبَتۡ أَيۡدِي ٱلنَّاسِ لِيُذِيقَهُم بَعۡضَ ٱلَّذِي عَمِلُواْ لَعَلَّهُمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "ظهر الفساد في البر والبحر بما كسبت ايدي الناس ليذيقهم بعض الذي عملوا لعلهم يرجعون",
    "ayahnumber" : "41",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3508",
    "page" : "408",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3509",
    "ayah_text" : "قُلۡ سِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبۡلُۚ كَانَ أَكۡثَرُهُم مُّشۡرِكِينَ",
    "ayah_text_no_diacratic" : "قل سيروا في الارض فانظروا كيف كان عٰقبة الذين من قبل كان اكثرهم مشركين",
    "ayahnumber" : "42",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3509",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:351",
    "ayah_text" : "رَبَّنَآ ءَامَنَّا بِمَآ أَنزَلۡتَ وَٱتَّبَعۡنَا ٱلرَّسُولَ فَٱكۡتُبۡنَا مَعَ ٱلشَّٰهِدِينَ",
    "ayah_text_no_diacratic" : "ربنا ءامنا بما انزلت واتبعنا الرسول فاكتبنا مع الشٰهدين",
    "ayahnumber" : "53",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "351",
    "page" : "57",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3510",
    "ayah_text" : "فَأَقِمۡ وَجۡهَكَ لِلدِّينِ ٱلۡقَيِّمِ مِن قَبۡلِ أَن يَأۡتِيَ يَوۡمٞ لَّا مَرَدَّ لَهُۥ مِنَ ٱللَّهِۖ يَوۡمَئِذٖ يَصَّدَّعُونَ",
    "ayah_text_no_diacratic" : "فاقم وجهك للدين القيم من قبل ان ياتي يوم لا مرد له من الله يومئذ يصدعون",
    "ayahnumber" : "43",
