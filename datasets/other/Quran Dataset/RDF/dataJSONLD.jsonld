    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2584",
    "ayah_text" : "قَالُواْ فَأۡتُواْ بِهِۦ عَلَىٰٓ أَعۡيُنِ ٱلنَّاسِ لَعَلَّهُمۡ يَشۡهَدُونَ",
    "ayah_text_no_diacratic" : "قالوا فاتوا به علىٰ اعين الناس لعلهم يشهدون",
