    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4879",
    "ayah_text" : "أَمۡ يُرِيدُونَ كَيۡدٗاۖ فَٱلَّذِينَ كَفَرُواْ هُمُ ٱلۡمَكِيدُونَ",
    "ayah_text_no_diacratic" : "ام يريدون كيدا فالذين كفروا هم المكيدون",
