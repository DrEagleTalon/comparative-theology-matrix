  }, {
    "@id" : "quran:3309",
    "ayah_text" : "نَتۡلُواْ عَلَيۡكَ مِن نَّبَإِ مُوسَىٰ وَفِرۡعَوۡنَ بِٱلۡحَقِّ لِقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "نتلوا عليك من نبا موسىٰ وفرعون بالحق لقوم يؤمنون",
    "ayahnumber" : "3",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3309",
    "page" : "385",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:331",
    "ayah_text" : "۞إِنَّ ٱللَّهَ ٱصۡطَفَىٰٓ ءَادَمَ وَنُوحٗا وَءَالَ إِبۡرَٰهِيمَ وَءَالَ عِمۡرَٰنَ عَلَى ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ان الله اصطفىٰ ءادم ونوحا وءال ابرٰهيم وءال عمرٰن على العٰلمين",
    "ayahnumber" : "33",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "331",
