    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5373",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5373",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5374",
    "ayah_text" : "تَبَٰرَكَ ٱلَّذِي بِيَدِهِ ٱلۡمُلۡكُ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "ayah_text_no_diacratic" : "تبٰرك الذي بيده الملك وهو علىٰ كل شيء قدير",
    "ayahnumber" : "1",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5374",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5375",
    "ayah_text" : "ٱلَّذِي خَلَقَ ٱلۡمَوۡتَ وَٱلۡحَيَوٰةَ لِيَبۡلُوَكُمۡ أَيُّكُمۡ أَحۡسَنُ عَمَلٗاۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡغَفُورُ",
    "ayah_text_no_diacratic" : "الذي خلق الموت والحيوٰة ليبلوكم ايكم احسن عملا وهو العزيز الغفور",
    "ayahnumber" : "2",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5375",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5376",
    "ayah_text" : "ٱلَّذِي خَلَقَ سَبۡعَ سَمَٰوَٰتٖ طِبَاقٗاۖ مَّا تَرَىٰ فِي خَلۡقِ ٱلرَّحۡمَٰنِ مِن تَفَٰوُتٖۖ فَٱرۡجِعِ ٱلۡبَصَرَ هَلۡ تَرَىٰ مِن فُطُورٖ",
    "ayah_text_no_diacratic" : "الذي خلق سبع سمٰوٰت طباقا ما ترىٰ في خلق الرحمٰن من تفٰوت فارجع البصر هل ترىٰ من فطور",
    "ayahnumber" : "3",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5376",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5377",
    "ayah_text" : "ثُمَّ ٱرۡجِعِ ٱلۡبَصَرَ كَرَّتَيۡنِ يَنقَلِبۡ إِلَيۡكَ ٱلۡبَصَرُ خَاسِئٗا وَهُوَ حَسِيرٞ",
    "ayah_text_no_diacratic" : "ثم ارجع البصر كرتين ينقلب اليك البصر خاسئا وهو حسير",
    "ayahnumber" : "4",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5377",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5378",
    "ayah_text" : "وَلَقَدۡ زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِمَصَٰبِيحَ وَجَعَلۡنَٰهَا رُجُومٗا لِّلشَّيَٰطِينِۖ وَأَعۡتَدۡنَا لَهُمۡ عَذَابَ ٱلسَّعِيرِ",
    "ayah_text_no_diacratic" : "ولقد زينا السماء الدنيا بمصٰبيح وجعلنٰها رجوما للشيٰطين واعتدنا لهم عذاب السعير",
    "ayahnumber" : "5",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5378",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5379",
    "ayah_text" : "وَلِلَّذِينَ كَفَرُواْ بِرَبِّهِمۡ عَذَابُ جَهَنَّمَۖ وَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "وللذين كفروا بربهم عذاب جهنم وبئس المصير",
    "ayahnumber" : "6",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5379",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:538",
    "ayah_text" : "وَٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُمۡ رِئَآءَ ٱلنَّاسِ وَلَا يُؤۡمِنُونَ بِٱللَّهِ وَلَا بِٱلۡيَوۡمِ ٱلۡأٓخِرِۗ وَمَن يَكُنِ ٱلشَّيۡطَٰنُ لَهُۥ قَرِينٗا فَسَآءَ قَرِينٗا",
    "ayah_text_no_diacratic" : "والذين ينفقون اموٰلهم رئاء الناس ولا يؤمنون بالله ولا باليوم الاخر ومن يكن الشيطٰن له قرينا فساء قرينا",
    "ayahnumber" : "38",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "538",
    "page" : "85",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5380",
    "ayah_text" : "إِذَآ أُلۡقُواْ فِيهَا سَمِعُواْ لَهَا شَهِيقٗا وَهِيَ تَفُورُ",
    "ayah_text_no_diacratic" : "اذا القوا فيها سمعوا لها شهيقا وهي تفور",
    "ayahnumber" : "7",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5380",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5381",
    "ayah_text" : "تَكَادُ تَمَيَّزُ مِنَ ٱلۡغَيۡظِۖ كُلَّمَآ أُلۡقِيَ فِيهَا فَوۡجٞ سَأَلَهُمۡ خَزَنَتُهَآ أَلَمۡ يَأۡتِكُمۡ نَذِيرٞ",
    "ayah_text_no_diacratic" : "تكاد تميز من الغيظ كلما القي فيها فوج سالهم خزنتها الم ياتكم نذير",
    "ayahnumber" : "8",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5381",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5382",
    "ayah_text" : "قَالُواْ بَلَىٰ قَدۡ جَآءَنَا نَذِيرٞ فَكَذَّبۡنَا وَقُلۡنَا مَا نَزَّلَ ٱللَّهُ مِن شَيۡءٍ إِنۡ أَنتُمۡ إِلَّا فِي ضَلَٰلٖ كَبِيرٖ",
    "ayah_text_no_diacratic" : "قالوا بلىٰ قد جاءنا نذير فكذبنا وقلنا ما نزل الله من شيء ان انتم الا في ضلٰل كبير",
    "ayahnumber" : "9",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5382",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5383",
    "ayah_text" : "وَقَالُواْ لَوۡ كُنَّا نَسۡمَعُ أَوۡ نَعۡقِلُ مَا كُنَّا فِيٓ أَصۡحَٰبِ ٱلسَّعِيرِ",
    "ayah_text_no_diacratic" : "وقالوا لو كنا نسمع او نعقل ما كنا في اصحٰب السعير",
    "ayahnumber" : "10",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5383",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5384",
    "ayah_text" : "فَٱعۡتَرَفُواْ بِذَنۢبِهِمۡ فَسُحۡقٗا لِّأَصۡحَٰبِ ٱلسَّعِيرِ",
    "ayah_text_no_diacratic" : "فاعترفوا بذنبهم فسحقا لاصحٰب السعير",
    "ayahnumber" : "11",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5384",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5385",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَخۡشَوۡنَ رَبَّهُم بِٱلۡغَيۡبِ لَهُم مَّغۡفِرَةٞ وَأَجۡرٞ كَبِيرٞ",
    "ayah_text_no_diacratic" : "ان الذين يخشون ربهم بالغيب لهم مغفرة واجر كبير",
    "ayahnumber" : "12",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5385",
    "page" : "562",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5386",
    "ayah_text" : "وَأَسِرُّواْ قَوۡلَكُمۡ أَوِ ٱجۡهَرُواْ بِهِۦٓۖ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "واسروا قولكم او اجهروا به انه عليم بذات الصدور",
    "ayahnumber" : "13",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5386",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5387",
    "ayah_text" : "أَلَا يَعۡلَمُ مَنۡ خَلَقَ وَهُوَ ٱللَّطِيفُ ٱلۡخَبِيرُ",
    "ayah_text_no_diacratic" : "الا يعلم من خلق وهو اللطيف الخبير",
    "ayahnumber" : "14",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5387",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5388",
    "ayah_text" : "هُوَ ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ ذَلُولٗا فَٱمۡشُواْ فِي مَنَاكِبِهَا وَكُلُواْ مِن رِّزۡقِهِۦۖ وَإِلَيۡهِ ٱلنُّشُورُ",
    "ayah_text_no_diacratic" : "هو الذي جعل لكم الارض ذلولا فامشوا في مناكبها وكلوا من رزقه واليه النشور",
    "ayahnumber" : "15",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5388",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5389",
    "ayah_text" : "ءَأَمِنتُم مَّن فِي ٱلسَّمَآءِ أَن يَخۡسِفَ بِكُمُ ٱلۡأَرۡضَ فَإِذَا هِيَ تَمُورُ",
    "ayah_text_no_diacratic" : "ءامنتم من في السماء ان يخسف بكم الارض فاذا هي تمور",
    "ayahnumber" : "16",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5389",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:539",
    "ayah_text" : "وَمَاذَا عَلَيۡهِمۡ لَوۡ ءَامَنُواْ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَأَنفَقُواْ مِمَّا رَزَقَهُمُ ٱللَّهُۚ وَكَانَ ٱللَّهُ بِهِمۡ عَلِيمًا",
    "ayah_text_no_diacratic" : "وماذا عليهم لو ءامنوا بالله واليوم الاخر وانفقوا مما رزقهم الله وكان الله بهم عليما",
    "ayahnumber" : "39",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "539",
    "page" : "85",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5390",
    "ayah_text" : "أَمۡ أَمِنتُم مَّن فِي ٱلسَّمَآءِ أَن يُرۡسِلَ عَلَيۡكُمۡ حَاصِبٗاۖ فَسَتَعۡلَمُونَ كَيۡفَ نَذِيرِ",
    "ayah_text_no_diacratic" : "ام امنتم من في السماء ان يرسل عليكم حاصبا فستعلمون كيف نذير",
    "ayahnumber" : "17",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5390",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5391",
    "ayah_text" : "وَلَقَدۡ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَكَيۡفَ كَانَ نَكِيرِ",
    "ayah_text_no_diacratic" : "ولقد كذب الذين من قبلهم فكيف كان نكير",
    "ayahnumber" : "18",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5391",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5392",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ إِلَى ٱلطَّيۡرِ فَوۡقَهُمۡ صَٰٓفَّٰتٖ وَيَقۡبِضۡنَۚ مَا يُمۡسِكُهُنَّ إِلَّا ٱلرَّحۡمَٰنُۚ إِنَّهُۥ بِكُلِّ شَيۡءِۭ بَصِيرٌ",
    "ayah_text_no_diacratic" : "اولم يروا الى الطير فوقهم صٰفٰت ويقبضن ما يمسكهن الا الرحمٰن انه بكل شيء بصير",
    "ayahnumber" : "19",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5392",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5393",
    "ayah_text" : "أَمَّنۡ هَٰذَا ٱلَّذِي هُوَ جُندٞ لَّكُمۡ يَنصُرُكُم مِّن دُونِ ٱلرَّحۡمَٰنِۚ إِنِ ٱلۡكَٰفِرُونَ إِلَّا فِي غُرُورٍ",
    "ayah_text_no_diacratic" : "امن هٰذا الذي هو جند لكم ينصركم من دون الرحمٰن ان الكٰفرون الا في غرور",
    "ayahnumber" : "20",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5393",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5394",
    "ayah_text" : "أَمَّنۡ هَٰذَا ٱلَّذِي يَرۡزُقُكُمۡ إِنۡ أَمۡسَكَ رِزۡقَهُۥۚ بَل لَّجُّواْ فِي عُتُوّٖ وَنُفُورٍ",
    "ayah_text_no_diacratic" : "امن هٰذا الذي يرزقكم ان امسك رزقه بل لجوا في عتو ونفور",
    "ayahnumber" : "21",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5394",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5395",
    "ayah_text" : "أَفَمَن يَمۡشِي مُكِبًّا عَلَىٰ وَجۡهِهِۦٓ أَهۡدَىٰٓ أَمَّن يَمۡشِي سَوِيًّا عَلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "افمن يمشي مكبا علىٰ وجهه اهدىٰ امن يمشي سويا علىٰ صرٰط مستقيم",
    "ayahnumber" : "22",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5395",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5396",
    "ayah_text" : "قُلۡ هُوَ ٱلَّذِيٓ أَنشَأَكُمۡ وَجَعَلَ لَكُمُ ٱلسَّمۡعَ وَٱلۡأَبۡصَٰرَ وَٱلۡأَفۡـِٔدَةَۚ قَلِيلٗا مَّا تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "قل هو الذي انشاكم وجعل لكم السمع والابصٰر والافدة قليلا ما تشكرون",
    "ayahnumber" : "23",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5396",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5397",
    "ayah_text" : "قُلۡ هُوَ ٱلَّذِي ذَرَأَكُمۡ فِي ٱلۡأَرۡضِ وَإِلَيۡهِ تُحۡشَرُونَ",
    "ayah_text_no_diacratic" : "قل هو الذي ذراكم في الارض واليه تحشرون",
    "ayahnumber" : "24",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5397",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5398",
    "ayah_text" : "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ويقولون متىٰ هٰذا الوعد ان كنتم صٰدقين",
    "ayahnumber" : "25",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5398",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5399",
    "ayah_text" : "قُلۡ إِنَّمَا ٱلۡعِلۡمُ عِندَ ٱللَّهِ وَإِنَّمَآ أَنَا۠ نَذِيرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "قل انما العلم عند الله وانما انا نذير مبين",
    "ayahnumber" : "26",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5399",
    "page" : "563",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:54",
    "ayah_text" : "۞أَتَأۡمُرُونَ ٱلنَّاسَ بِٱلۡبِرِّ وَتَنسَوۡنَ أَنفُسَكُمۡ وَأَنتُمۡ تَتۡلُونَ ٱلۡكِتَٰبَۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "اتامرون الناس بالبر وتنسون انفسكم وانتم تتلون الكتٰب افلا تعقلون",
    "ayahnumber" : "44",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "54",
    "page" : "7",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:540",
    "ayah_text" : "إِنَّ ٱللَّهَ لَا يَظۡلِمُ مِثۡقَالَ ذَرَّةٖۖ وَإِن تَكُ حَسَنَةٗ يُضَٰعِفۡهَا وَيُؤۡتِ مِن لَّدُنۡهُ أَجۡرًا عَظِيمٗا",
    "ayah_text_no_diacratic" : "ان الله لا يظلم مثقال ذرة وان تك حسنة يضٰعفها ويؤت من لدنه اجرا عظيما",
    "ayahnumber" : "40",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "540",
    "page" : "85",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5400",
    "ayah_text" : "فَلَمَّا رَأَوۡهُ زُلۡفَةٗ سِيٓـَٔتۡ وُجُوهُ ٱلَّذِينَ كَفَرُواْ وَقِيلَ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تَدَّعُونَ",
    "ayah_text_no_diacratic" : "فلما راوه زلفة سيت وجوه الذين كفروا وقيل هٰذا الذي كنتم به تدعون",
    "ayahnumber" : "27",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5400",
    "page" : "564",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5401",
    "ayah_text" : "قُلۡ أَرَءَيۡتُمۡ إِنۡ أَهۡلَكَنِيَ ٱللَّهُ وَمَن مَّعِيَ أَوۡ رَحِمَنَا فَمَن يُجِيرُ ٱلۡكَٰفِرِينَ مِنۡ عَذَابٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "قل ارءيتم ان اهلكني الله ومن معي او رحمنا فمن يجير الكٰفرين من عذاب اليم",
    "ayahnumber" : "28",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5401",
    "page" : "564",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5402",
    "ayah_text" : "قُلۡ هُوَ ٱلرَّحۡمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيۡهِ تَوَكَّلۡنَاۖ فَسَتَعۡلَمُونَ مَنۡ هُوَ فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "قل هو الرحمٰن ءامنا به وعليه توكلنا فستعلمون من هو في ضلٰل مبين",
    "ayahnumber" : "29",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5402",
    "page" : "564",
    "surahname" : "سُورَةُ المُلۡكِ",
    "surahnumber" : "67",
    "surrahname_no_diacratic" : "سورة الملك"
  }, {
    "@id" : "quran:5403",
    "ayah_text" : "قُلۡ أَرَءَيۡتُمۡ إِنۡ أَصۡبَحَ مَآؤُكُمۡ غَوۡرٗا فَمَن يَأۡتِيكُم بِمَآءٖ مَّعِينِۭ",
    "ayah_text_no_diacratic" : "قل ارءيتم ان اصبح ماؤكم غورا فمن ياتيكم بماء معين",
