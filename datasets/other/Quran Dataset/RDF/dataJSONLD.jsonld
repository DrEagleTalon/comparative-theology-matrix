    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2041",
    "ayah_text" : "ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُواْ مِنۢ بَعۡدِ مَا فُتِنُواْ ثُمَّ جَٰهَدُواْ وَصَبَرُوٓاْ إِنَّ رَبَّكَ مِنۢ بَعۡدِهَا لَغَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "ثم ان ربك للذين هاجروا من بعد ما فتنوا ثم جٰهدوا وصبروا ان ربك من بعدها لغفور رحيم",
    "ayahnumber" : "110",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2041",
    "page" : "279",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2042",
    "ayah_text" : "۞يَوۡمَ تَأۡتِي كُلُّ نَفۡسٖ تُجَٰدِلُ عَن نَّفۡسِهَا وَتُوَفَّىٰ كُلُّ نَفۡسٖ مَّا عَمِلَتۡ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "يوم تاتي كل نفس تجٰدل عن نفسها وتوفىٰ كل نفس ما عملت وهم لا يظلمون",
    "ayahnumber" : "111",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2042",
    "page" : "280",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2043",
    "ayah_text" : "وَضَرَبَ ٱللَّهُ مَثَلٗا قَرۡيَةٗ كَانَتۡ ءَامِنَةٗ مُّطۡمَئِنَّةٗ يَأۡتِيهَا رِزۡقُهَا رَغَدٗا مِّن كُلِّ مَكَانٖ فَكَفَرَتۡ بِأَنۡعُمِ ٱللَّهِ فَأَذَٰقَهَا ٱللَّهُ لِبَاسَ ٱلۡجُوعِ وَٱلۡخَوۡفِ بِمَا كَانُواْ يَصۡنَعُونَ",
    "ayah_text_no_diacratic" : "وضرب الله مثلا قرية كانت ءامنة مطمئنة ياتيها رزقها رغدا من كل مكان فكفرت بانعم الله فاذٰقها الله لباس الجوع والخوف بما كانوا يصنعون",
    "ayahnumber" : "112",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2043",
    "page" : "280",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2044",
    "ayah_text" : "وَلَقَدۡ جَآءَهُمۡ رَسُولٞ مِّنۡهُمۡ فَكَذَّبُوهُ فَأَخَذَهُمُ ٱلۡعَذَابُ وَهُمۡ ظَٰلِمُونَ",
    "ayah_text_no_diacratic" : "ولقد جاءهم رسول منهم فكذبوه فاخذهم العذاب وهم ظٰلمون",
    "ayahnumber" : "113",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2044",
    "page" : "280",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2045",
    "ayah_text" : "فَكُلُواْ مِمَّا رَزَقَكُمُ ٱللَّهُ حَلَٰلٗا طَيِّبٗا وَٱشۡكُرُواْ نِعۡمَتَ ٱللَّهِ إِن كُنتُمۡ إِيَّاهُ تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "فكلوا مما رزقكم الله حلٰلا طيبا واشكروا نعمت الله ان كنتم اياه تعبدون",
    "ayahnumber" : "114",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2045",
    "page" : "280",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2046",
    "ayah_text" : "إِنَّمَا حَرَّمَ عَلَيۡكُمُ ٱلۡمَيۡتَةَ وَٱلدَّمَ وَلَحۡمَ ٱلۡخِنزِيرِ وَمَآ أُهِلَّ لِغَيۡرِ ٱللَّهِ بِهِۦۖ فَمَنِ ٱضۡطُرَّ غَيۡرَ بَاغٖ وَلَا عَادٖ فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "انما حرم عليكم الميتة والدم ولحم الخنزير وما اهل لغير الله به فمن اضطر غير باغ ولا عاد فان الله غفور رحيم",
    "ayahnumber" : "115",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2046",
    "page" : "280",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2047",
    "ayah_text" : "وَلَا تَقُولُواْ لِمَا تَصِفُ أَلۡسِنَتُكُمُ ٱلۡكَذِبَ هَٰذَا حَلَٰلٞ وَهَٰذَا حَرَامٞ لِّتَفۡتَرُواْ عَلَى ٱللَّهِ ٱلۡكَذِبَۚ إِنَّ ٱلَّذِينَ يَفۡتَرُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ لَا يُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "ولا تقولوا لما تصف السنتكم الكذب هٰذا حلٰل وهٰذا حرام لتفتروا على الله الكذب ان الذين يفترون على الله الكذب لا يفلحون",
    "ayahnumber" : "116",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2047",
    "page" : "280",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2048",
    "ayah_text" : "مَتَٰعٞ قَلِيلٞ وَلَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "متٰع قليل ولهم عذاب اليم",
    "ayahnumber" : "117",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2048",
    "page" : "280",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2049",
    "ayah_text" : "وَعَلَى ٱلَّذِينَ هَادُواْ حَرَّمۡنَا مَا قَصَصۡنَا عَلَيۡكَ مِن قَبۡلُۖ وَمَا ظَلَمۡنَٰهُمۡ وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ",
    "ayah_text_no_diacratic" : "وعلى الذين هادوا حرمنا ما قصصنا عليك من قبل وما ظلمنٰهم ولٰكن كانوا انفسهم يظلمون",
    "ayahnumber" : "118",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2049",
    "page" : "280",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:205",
    "ayah_text" : "وَأَنفِقُواْ فِي سَبِيلِ ٱللَّهِ وَلَا تُلۡقُواْ بِأَيۡدِيكُمۡ إِلَى ٱلتَّهۡلُكَةِ وَأَحۡسِنُوٓاْۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "وانفقوا في سبيل الله ولا تلقوا بايديكم الى التهلكة واحسنوا ان الله يحب المحسنين",
    "ayahnumber" : "195",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "205",
    "page" : "30",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2050",
    "ayah_text" : "ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُواْ ٱلسُّوٓءَ بِجَهَٰلَةٖ ثُمَّ تَابُواْ مِنۢ بَعۡدِ ذَٰلِكَ وَأَصۡلَحُوٓاْ إِنَّ رَبَّكَ مِنۢ بَعۡدِهَا لَغَفُورٞ رَّحِيمٌ",
    "ayah_text_no_diacratic" : "ثم ان ربك للذين عملوا السوء بجهٰلة ثم تابوا من بعد ذٰلك واصلحوا ان ربك من بعدها لغفور رحيم",
    "ayahnumber" : "119",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2050",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2051",
    "ayah_text" : "إِنَّ إِبۡرَٰهِيمَ كَانَ أُمَّةٗ قَانِتٗا لِّلَّهِ حَنِيفٗا وَلَمۡ يَكُ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "ان ابرٰهيم كان امة قانتا لله حنيفا ولم يك من المشركين",
    "ayahnumber" : "120",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2051",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2052",
    "ayah_text" : "شَاكِرٗا لِّأَنۡعُمِهِۚ ٱجۡتَبَىٰهُ وَهَدَىٰهُ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "شاكرا لانعمه اجتبىٰه وهدىٰه الىٰ صرٰط مستقيم",
    "ayahnumber" : "121",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2052",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2053",
    "ayah_text" : "وَءَاتَيۡنَٰهُ فِي ٱلدُّنۡيَا حَسَنَةٗۖ وَإِنَّهُۥ فِي ٱلۡأٓخِرَةِ لَمِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "وءاتينٰه في الدنيا حسنة وانه في الاخرة لمن الصٰلحين",
    "ayahnumber" : "122",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2053",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2054",
    "ayah_text" : "ثُمَّ أَوۡحَيۡنَآ إِلَيۡكَ أَنِ ٱتَّبِعۡ مِلَّةَ إِبۡرَٰهِيمَ حَنِيفٗاۖ وَمَا كَانَ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "ثم اوحينا اليك ان اتبع ملة ابرٰهيم حنيفا وما كان من المشركين",
    "ayahnumber" : "123",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2054",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2055",
    "ayah_text" : "إِنَّمَا جُعِلَ ٱلسَّبۡتُ عَلَى ٱلَّذِينَ ٱخۡتَلَفُواْ فِيهِۚ وَإِنَّ رَبَّكَ لَيَحۡكُمُ بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "انما جعل السبت على الذين اختلفوا فيه وان ربك ليحكم بينهم يوم القيٰمة فيما كانوا فيه يختلفون",
    "ayahnumber" : "124",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2055",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2056",
    "ayah_text" : "ٱدۡعُ إِلَىٰ سَبِيلِ رَبِّكَ بِٱلۡحِكۡمَةِ وَٱلۡمَوۡعِظَةِ ٱلۡحَسَنَةِۖ وَجَٰدِلۡهُم بِٱلَّتِي هِيَ أَحۡسَنُۚ إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ",
    "ayah_text_no_diacratic" : "ادع الىٰ سبيل ربك بالحكمة والموعظة الحسنة وجٰدلهم بالتي هي احسن ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بالمهتدين",
    "ayahnumber" : "125",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2056",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2057",
    "ayah_text" : "وَإِنۡ عَاقَبۡتُمۡ فَعَاقِبُواْ بِمِثۡلِ مَا عُوقِبۡتُم بِهِۦۖ وَلَئِن صَبَرۡتُمۡ لَهُوَ خَيۡرٞ لِّلصَّٰبِرِينَ",
    "ayah_text_no_diacratic" : "وان عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو خير للصٰبرين",
    "ayahnumber" : "126",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2057",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2058",
    "ayah_text" : "وَٱصۡبِرۡ وَمَا صَبۡرُكَ إِلَّا بِٱللَّهِۚ وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَلَا تَكُ فِي ضَيۡقٖ مِّمَّا يَمۡكُرُونَ",
    "ayah_text_no_diacratic" : "واصبر وما صبرك الا بالله ولا تحزن عليهم ولا تك في ضيق مما يمكرون",
    "ayahnumber" : "127",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2058",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2059",
    "ayah_text" : "إِنَّ ٱللَّهَ مَعَ ٱلَّذِينَ ٱتَّقَواْ وَّٱلَّذِينَ هُم مُّحۡسِنُونَ",
    "ayah_text_no_diacratic" : "ان الله مع الذين اتقوا والذين هم محسنون",
    "ayahnumber" : "128",
    "chapter" : "14",
    "hizb" : "28",
    "index" : "2059",
    "page" : "281",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:206",
    "ayah_text" : "وَأَتِمُّواْ ٱلۡحَجَّ وَٱلۡعُمۡرَةَ لِلَّهِۚ فَإِنۡ أُحۡصِرۡتُمۡ فَمَا ٱسۡتَيۡسَرَ مِنَ ٱلۡهَدۡيِۖ وَلَا تَحۡلِقُواْ رُءُوسَكُمۡ حَتَّىٰ يَبۡلُغَ ٱلۡهَدۡيُ مَحِلَّهُۥۚ فَمَن كَانَ مِنكُم مَّرِيضًا أَوۡ بِهِۦٓ أَذٗى مِّن رَّأۡسِهِۦ فَفِدۡيَةٞ مِّن صِيَامٍ أَوۡ صَدَقَةٍ أَوۡ نُسُكٖۚ فَإِذَآ أَمِنتُمۡ فَمَن تَمَتَّعَ بِٱلۡعُمۡرَةِ إِلَى ٱلۡحَجِّ فَمَا ٱسۡتَيۡسَرَ مِنَ ٱلۡهَدۡيِۚ فَمَن لَّمۡ يَجِدۡ فَصِيَامُ ثَلَٰثَةِ أَيَّامٖ فِي ٱلۡحَجِّ وَسَبۡعَةٍ إِذَا رَجَعۡتُمۡۗ تِلۡكَ عَشَرَةٞ كَامِلَةٞۗ ذَٰلِكَ لِمَن لَّمۡ يَكُنۡ أَهۡلُهُۥ حَاضِرِي ٱلۡمَسۡجِدِ ٱلۡحَرَامِۚ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ",
    "ayah_text_no_diacratic" : "واتموا الحج والعمرة لله فان احصرتم فما استيسر من الهدي ولا تحلقوا رءوسكم حتىٰ يبلغ الهدي محله فمن كان منكم مريضا او به اذى من راسه ففدية من صيام او صدقة او نسك فاذا امنتم فمن تمتع بالعمرة الى الحج فما استيسر من الهدي فمن لم يجد فصيام ثلٰثة ايام في الحج وسبعة اذا رجعتم تلك عشرة كاملة ذٰلك لمن لم يكن اهله حاضري المسجد الحرام واتقوا الله واعلموا ان الله شديد العقاب",
    "ayahnumber" : "196",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "206",
    "page" : "30",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
