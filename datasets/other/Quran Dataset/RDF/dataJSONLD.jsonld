  }, {
    "@id" : "quran:2409",
    "ayah_text" : "لِنُرِيَكَ مِنۡ ءَايَٰتِنَا ٱلۡكُبۡرَى",
    "ayah_text_no_diacratic" : "لنريك من ءايٰتنا الكبرى",
    "ayahnumber" : "23",
