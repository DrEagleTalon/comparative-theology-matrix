  }, {
    "@id" : "quran:2637",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2637",
    "page" : "332",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2638",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُواْ رَبَّكُمۡۚ إِنَّ زَلۡزَلَةَ ٱلسَّاعَةِ شَيۡءٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الناس اتقوا ربكم ان زلزلة الساعة شيء عظيم",
    "ayahnumber" : "1",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2638",
    "page" : "332",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2639",
    "ayah_text" : "يَوۡمَ تَرَوۡنَهَا تَذۡهَلُ كُلُّ مُرۡضِعَةٍ عَمَّآ أَرۡضَعَتۡ وَتَضَعُ كُلُّ ذَاتِ حَمۡلٍ حَمۡلَهَا وَتَرَى ٱلنَّاسَ سُكَٰرَىٰ وَمَا هُم بِسُكَٰرَىٰ وَلَٰكِنَّ عَذَابَ ٱللَّهِ شَدِيدٞ",
    "ayah_text_no_diacratic" : "يوم ترونها تذهل كل مرضعة عما ارضعت وتضع كل ذات حمل حملها وترى الناس سكٰرىٰ وما هم بسكٰرىٰ ولٰكن عذاب الله شديد",
    "ayahnumber" : "2",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2639",
    "page" : "332",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:264",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَنفِقُواْ مِمَّا رَزَقۡنَٰكُم مِّن قَبۡلِ أَن يَأۡتِيَ يَوۡمٞ لَّا بَيۡعٞ فِيهِ وَلَا خُلَّةٞ وَلَا شَفَٰعَةٞۗ وَٱلۡكَٰفِرُونَ هُمُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا انفقوا مما رزقنٰكم من قبل ان ياتي يوم لا بيع فيه ولا خلة ولا شفٰعة والكٰفرون هم الظٰلمون",
    "ayahnumber" : "254",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "264",
    "page" : "42",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2640",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَيَتَّبِعُ كُلَّ شَيۡطَٰنٖ مَّرِيدٖ",
    "ayah_text_no_diacratic" : "ومن الناس من يجٰدل في الله بغير علم ويتبع كل شيطٰن مريد",
    "ayahnumber" : "3",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2640",
    "page" : "332",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2641",
    "ayah_text" : "كُتِبَ عَلَيۡهِ أَنَّهُۥ مَن تَوَلَّاهُ فَأَنَّهُۥ يُضِلُّهُۥ وَيَهۡدِيهِ إِلَىٰ عَذَابِ ٱلسَّعِيرِ",
    "ayah_text_no_diacratic" : "كتب عليه انه من تولاه فانه يضله ويهديه الىٰ عذاب السعير",
    "ayahnumber" : "4",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2641",
    "page" : "332",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2642",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ إِن كُنتُمۡ فِي رَيۡبٖ مِّنَ ٱلۡبَعۡثِ فَإِنَّا خَلَقۡنَٰكُم مِّن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ مِنۡ عَلَقَةٖ ثُمَّ مِن مُّضۡغَةٖ مُّخَلَّقَةٖ وَغَيۡرِ مُخَلَّقَةٖ لِّنُبَيِّنَ لَكُمۡۚ وَنُقِرُّ فِي ٱلۡأَرۡحَامِ مَا نَشَآءُ إِلَىٰٓ أَجَلٖ مُّسَمّٗى ثُمَّ نُخۡرِجُكُمۡ طِفۡلٗا ثُمَّ لِتَبۡلُغُوٓاْ أَشُدَّكُمۡۖ وَمِنكُم مَّن يُتَوَفَّىٰ وَمِنكُم مَّن يُرَدُّ إِلَىٰٓ أَرۡذَلِ ٱلۡعُمُرِ لِكَيۡلَا يَعۡلَمَ مِنۢ بَعۡدِ عِلۡمٖ شَيۡـٔٗاۚ وَتَرَى ٱلۡأَرۡضَ هَامِدَةٗ فَإِذَآ أَنزَلۡنَا عَلَيۡهَا ٱلۡمَآءَ ٱهۡتَزَّتۡ وَرَبَتۡ وَأَنۢبَتَتۡ مِن كُلِّ زَوۡجِۭ بَهِيجٖ",
    "ayah_text_no_diacratic" : "يٰايها الناس ان كنتم في ريب من البعث فانا خلقنٰكم من تراب ثم من نطفة ثم من علقة ثم من مضغة مخلقة وغير مخلقة لنبين لكم ونقر في الارحام ما نشاء الىٰ اجل مسمى ثم نخرجكم طفلا ثم لتبلغوا اشدكم ومنكم من يتوفىٰ ومنكم من يرد الىٰ ارذل العمر لكيلا يعلم من بعد علم شيا وترى الارض هامدة فاذا انزلنا عليها الماء اهتزت وربت وانبتت من كل زوج بهيج",
    "ayahnumber" : "5",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2642",
    "page" : "332",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2643",
    "ayah_text" : "ذَٰلِكَ بِأَنَّ ٱللَّهَ هُوَ ٱلۡحَقُّ وَأَنَّهُۥ يُحۡيِ ٱلۡمَوۡتَىٰ وَأَنَّهُۥ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "ذٰلك بان الله هو الحق وانه يحي الموتىٰ وانه علىٰ كل شيء قدير",
    "ayahnumber" : "6",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2643",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2644",
    "ayah_text" : "وَأَنَّ ٱلسَّاعَةَ ءَاتِيَةٞ لَّا رَيۡبَ فِيهَا وَأَنَّ ٱللَّهَ يَبۡعَثُ مَن فِي ٱلۡقُبُورِ",
    "ayah_text_no_diacratic" : "وان الساعة ءاتية لا ريب فيها وان الله يبعث من في القبور",
    "ayahnumber" : "7",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2644",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2645",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَلَا هُدٗى وَلَا كِتَٰبٖ مُّنِيرٖ",
    "ayah_text_no_diacratic" : "ومن الناس من يجٰدل في الله بغير علم ولا هدى ولا كتٰب منير",
    "ayahnumber" : "8",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2645",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2646",
    "ayah_text" : "ثَانِيَ عِطۡفِهِۦ لِيُضِلَّ عَن سَبِيلِ ٱللَّهِۖ لَهُۥ فِي ٱلدُّنۡيَا خِزۡيٞۖ وَنُذِيقُهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ عَذَابَ ٱلۡحَرِيقِ",
    "ayah_text_no_diacratic" : "ثاني عطفه ليضل عن سبيل الله له في الدنيا خزي ونذيقه يوم القيٰمة عذاب الحريق",
    "ayahnumber" : "9",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2646",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2647",
    "ayah_text" : "ذَٰلِكَ بِمَا قَدَّمَتۡ يَدَاكَ وَأَنَّ ٱللَّهَ لَيۡسَ بِظَلَّٰمٖ لِّلۡعَبِيدِ",
    "ayah_text_no_diacratic" : "ذٰلك بما قدمت يداك وان الله ليس بظلٰم للعبيد",
    "ayahnumber" : "10",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2647",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2648",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يَعۡبُدُ ٱللَّهَ عَلَىٰ حَرۡفٖۖ فَإِنۡ أَصَابَهُۥ خَيۡرٌ ٱطۡمَأَنَّ بِهِۦۖ وَإِنۡ أَصَابَتۡهُ فِتۡنَةٌ ٱنقَلَبَ عَلَىٰ وَجۡهِهِۦ خَسِرَ ٱلدُّنۡيَا وَٱلۡأٓخِرَةَۚ ذَٰلِكَ هُوَ ٱلۡخُسۡرَانُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "ومن الناس من يعبد الله علىٰ حرف فان اصابه خير اطمان به وان اصابته فتنة انقلب علىٰ وجهه خسر الدنيا والاخرة ذٰلك هو الخسران المبين",
    "ayahnumber" : "11",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2648",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2649",
    "ayah_text" : "يَدۡعُواْ مِن دُونِ ٱللَّهِ مَا لَا يَضُرُّهُۥ وَمَا لَا يَنفَعُهُۥۚ ذَٰلِكَ هُوَ ٱلضَّلَٰلُ ٱلۡبَعِيدُ",
    "ayah_text_no_diacratic" : "يدعوا من دون الله ما لا يضره وما لا ينفعه ذٰلك هو الضلٰل البعيد",
    "ayahnumber" : "12",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2649",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:265",
    "ayah_text" : "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ٱلۡحَيُّ ٱلۡقَيُّومُۚ لَا تَأۡخُذُهُۥ سِنَةٞ وَلَا نَوۡمٞۚ لَّهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ مَن ذَا ٱلَّذِي يَشۡفَعُ عِندَهُۥٓ إِلَّا بِإِذۡنِهِۦۚ يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡۖ وَلَا يُحِيطُونَ بِشَيۡءٖ مِّنۡ عِلۡمِهِۦٓ إِلَّا بِمَا شَآءَۚ وَسِعَ كُرۡسِيُّهُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَۖ وَلَا يَـُٔودُهُۥ حِفۡظُهُمَاۚ وَهُوَ ٱلۡعَلِيُّ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "الله لا الٰه الا هو الحي القيوم لا تاخذه سنة ولا نوم له ما في السمٰوٰت وما في الارض من ذا الذي يشفع عنده الا باذنه يعلم ما بين ايديهم وما خلفهم ولا يحيطون بشيء من علمه الا بما شاء وسع كرسيه السمٰوٰت والارض ولا يوده حفظهما وهو العلي العظيم",
    "ayahnumber" : "255",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "265",
    "page" : "42",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2650",
    "ayah_text" : "يَدۡعُواْ لَمَن ضَرُّهُۥٓ أَقۡرَبُ مِن نَّفۡعِهِۦۚ لَبِئۡسَ ٱلۡمَوۡلَىٰ وَلَبِئۡسَ ٱلۡعَشِيرُ",
    "ayah_text_no_diacratic" : "يدعوا لمن ضره اقرب من نفعه لبئس المولىٰ ولبئس العشير",
    "ayahnumber" : "13",
    "chapter" : "17",
