    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4805",
    "ayah_text" : "قَالُواْ كَذَٰلِكِ قَالَ رَبُّكِۖ إِنَّهُۥ هُوَ ٱلۡحَكِيمُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "قالوا كذٰلك قال ربك انه هو الحكيم العليم",
