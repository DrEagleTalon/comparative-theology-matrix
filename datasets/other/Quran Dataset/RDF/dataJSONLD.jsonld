    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1875",
    "ayah_text" : "إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّٰتٖ وَعُيُونٍ",
