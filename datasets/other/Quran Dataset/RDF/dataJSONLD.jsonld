  }, {
    "@id" : "quran:4529",
    "ayah_text" : "فَمَا بَكَتۡ عَلَيۡهِمُ ٱلسَّمَآءُ وَٱلۡأَرۡضُ وَمَا كَانُواْ مُنظَرِينَ",
    "ayah_text_no_diacratic" : "فما بكت عليهم السماء والارض وما كانوا منظرين",
