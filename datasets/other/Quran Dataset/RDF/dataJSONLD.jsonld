    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3782",
    "ayah_text" : "لَقَدۡ حَقَّ ٱلۡقَوۡلُ عَلَىٰٓ أَكۡثَرِهِمۡ فَهُمۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "لقد حق القول علىٰ اكثرهم فهم لا يؤمنون",
    "ayahnumber" : "7",
    "chapter" : "22",
    "hizb" : "44",
