    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:765",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تُحَرِّمُواْ طَيِّبَٰتِ مَآ أَحَلَّ ٱللَّهُ لَكُمۡ وَلَا تَعۡتَدُوٓاْۚ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلۡمُعۡتَدِينَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تحرموا طيبٰت ما احل الله لكم ولا تعتدوا ان الله لا يحب المعتدين",
    "ayahnumber" : "87",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "765",
    "page" : "122",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:766",
    "ayah_text" : "وَكُلُواْ مِمَّا رَزَقَكُمُ ٱللَّهُ حَلَٰلٗا طَيِّبٗاۚ وَٱتَّقُواْ ٱللَّهَ ٱلَّذِيٓ أَنتُم بِهِۦ مُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "وكلوا مما رزقكم الله حلٰلا طيبا واتقوا الله الذي انتم به مؤمنون",
    "ayahnumber" : "88",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "766",
    "page" : "122",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:767",
    "ayah_text" : "لَا يُؤَاخِذُكُمُ ٱللَّهُ بِٱللَّغۡوِ فِيٓ أَيۡمَٰنِكُمۡ وَلَٰكِن يُؤَاخِذُكُم بِمَا عَقَّدتُّمُ ٱلۡأَيۡمَٰنَۖ فَكَفَّٰرَتُهُۥٓ إِطۡعَامُ عَشَرَةِ مَسَٰكِينَ مِنۡ أَوۡسَطِ مَا تُطۡعِمُونَ أَهۡلِيكُمۡ أَوۡ كِسۡوَتُهُمۡ أَوۡ تَحۡرِيرُ رَقَبَةٖۖ فَمَن لَّمۡ يَجِدۡ فَصِيَامُ ثَلَٰثَةِ أَيَّامٖۚ ذَٰلِكَ كَفَّٰرَةُ أَيۡمَٰنِكُمۡ إِذَا حَلَفۡتُمۡۚ وَٱحۡفَظُوٓاْ أَيۡمَٰنَكُمۡۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمۡ ءَايَٰتِهِۦ لَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "لا يؤاخذكم الله باللغو في ايمٰنكم ولٰكن يؤاخذكم بما عقدتم الايمٰن فكفٰرته اطعام عشرة مسٰكين من اوسط ما تطعمون اهليكم او كسوتهم او تحرير رقبة فمن لم يجد فصيام ثلٰثة ايام ذٰلك كفٰرة ايمٰنكم اذا حلفتم واحفظوا ايمٰنكم كذٰلك يبين الله لكم ءايٰته لعلكم تشكرون",
    "ayahnumber" : "89",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "767",
    "page" : "122",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:768",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِنَّمَا ٱلۡخَمۡرُ وَٱلۡمَيۡسِرُ وَٱلۡأَنصَابُ وَٱلۡأَزۡلَٰمُ رِجۡسٞ مِّنۡ عَمَلِ ٱلشَّيۡطَٰنِ فَٱجۡتَنِبُوهُ لَعَلَّكُمۡ تُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا انما الخمر والميسر والانصاب والازلٰم رجس من عمل الشيطٰن فاجتنبوه لعلكم تفلحون",
    "ayahnumber" : "90",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "768",
    "page" : "122",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:769",
    "ayah_text" : "إِنَّمَا يُرِيدُ ٱلشَّيۡطَٰنُ أَن يُوقِعَ بَيۡنَكُمُ ٱلۡعَدَٰوَةَ وَٱلۡبَغۡضَآءَ فِي ٱلۡخَمۡرِ وَٱلۡمَيۡسِرِ وَيَصُدَّكُمۡ عَن ذِكۡرِ ٱللَّهِ وَعَنِ ٱلصَّلَوٰةِۖ فَهَلۡ أَنتُم مُّنتَهُونَ",
    "ayah_text_no_diacratic" : "انما يريد الشيطٰن ان يوقع بينكم العدٰوة والبغضاء في الخمر والميسر ويصدكم عن ذكر الله وعن الصلوٰة فهل انتم منتهون",
    "ayahnumber" : "91",
