    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3410",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦ فَلَبِثَ فِيهِمۡ أَلۡفَ سَنَةٍ إِلَّا خَمۡسِينَ عَامٗا فَأَخَذَهُمُ ٱلطُّوفَانُ وَهُمۡ ظَٰلِمُونَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا نوحا الىٰ قومه فلبث فيهم الف سنة الا خمسين عاما فاخذهم الطوفان وهم ظٰلمون",
    "ayahnumber" : "14",
    "chapter" : "20",
    "hizb" : "39",
