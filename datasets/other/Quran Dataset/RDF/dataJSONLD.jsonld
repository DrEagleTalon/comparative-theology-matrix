    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4439",
    "ayah_text" : "وَلَمَّا جَآءَهُمُ ٱلۡحَقُّ قَالُواْ هَٰذَا سِحۡرٞ وَإِنَّا بِهِۦ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "ولما جاءهم الحق قالوا هٰذا سحر وانا به كٰفرون",
    "ayahnumber" : "30",
    "chapter" : "25",
    "hizb" : "49",
