    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:2992",
    "ayah_text" : "وَإِذۡ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئۡتِ ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "واذ نادىٰ ربك موسىٰ ان ائت القوم الظٰلمين",
    "ayahnumber" : "10",
    "chapter" : "19",
    "hizb" : "36",
