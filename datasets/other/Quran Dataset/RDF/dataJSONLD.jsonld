  }, {
    "@id" : "quran:4606",
    "ayah_text" : "وَإِذَا حُشِرَ ٱلنَّاسُ كَانُواْ لَهُمۡ أَعۡدَآءٗ وَكَانُواْ بِعِبَادَتِهِمۡ كَٰفِرِينَ",
    "ayah_text_no_diacratic" : "واذا حشر الناس كانوا لهم اعداء وكانوا بعبادتهم كٰفرين",
    "ayahnumber" : "6",
    "chapter" : "26",
    "hizb" : "50",
