    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1808",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجَ بِهِۦ مِنَ ٱلثَّمَرَٰتِ رِزۡقٗا لَّكُمۡۖ وَسَخَّرَ لَكُمُ ٱلۡفُلۡكَ لِتَجۡرِيَ فِي ٱلۡبَحۡرِ بِأَمۡرِهِۦۖ وَسَخَّرَ لَكُمُ ٱلۡأَنۡهَٰرَ",
    "ayah_text_no_diacratic" : "الله الذي خلق السمٰوٰت والارض وانزل من السماء ماء فاخرج به من الثمرٰت رزقا لكم وسخر لكم الفلك لتجري في البحر بامره وسخر لكم الانهٰر",
    "ayahnumber" : "32",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1808",
