    "page" : "71",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4610",
    "ayah_text" : "قُلۡ أَرَءَيۡتُمۡ إِن كَانَ مِنۡ عِندِ ٱللَّهِ وَكَفَرۡتُم بِهِۦ وَشَهِدَ شَاهِدٞ مِّنۢ بَنِيٓ إِسۡرَٰٓءِيلَ عَلَىٰ مِثۡلِهِۦ فَـَٔامَنَ وَٱسۡتَكۡبَرۡتُمۡۚ إِنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "قل ارءيتم ان كان من عند الله وكفرتم به وشهد شاهد من بني اسرٰءيل علىٰ مثله فامن واستكبرتم ان الله لا يهدي القوم الظٰلمين",
    "ayahnumber" : "10",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4610",
    "page" : "503",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4611",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُواْ لِلَّذِينَ ءَامَنُواْ لَوۡ كَانَ خَيۡرٗا مَّا سَبَقُونَآ إِلَيۡهِۚ وَإِذۡ لَمۡ يَهۡتَدُواْ بِهِۦ فَسَيَقُولُونَ هَٰذَآ إِفۡكٞ قَدِيمٞ",
    "ayah_text_no_diacratic" : "وقال الذين كفروا للذين ءامنوا لو كان خيرا ما سبقونا اليه واذ لم يهتدوا به فسيقولون هٰذا افك قديم",
    "ayahnumber" : "11",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4611",
    "page" : "503",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4612",
    "ayah_text" : "وَمِن قَبۡلِهِۦ كِتَٰبُ مُوسَىٰٓ إِمَامٗا وَرَحۡمَةٗۚ وَهَٰذَا كِتَٰبٞ مُّصَدِّقٞ لِّسَانًا عَرَبِيّٗا لِّيُنذِرَ ٱلَّذِينَ ظَلَمُواْ وَبُشۡرَىٰ لِلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "ومن قبله كتٰب موسىٰ اماما ورحمة وهٰذا كتٰب مصدق لسانا عربيا لينذر الذين ظلموا وبشرىٰ للمحسنين",
    "ayahnumber" : "12",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4612",
    "page" : "503",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4613",
    "ayah_text" : "إِنَّ ٱلَّذِينَ قَالُواْ رَبُّنَا ٱللَّهُ ثُمَّ ٱسۡتَقَٰمُواْ فَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "ان الذين قالوا ربنا الله ثم استقٰموا فلا خوف عليهم ولا هم يحزنون",
    "ayahnumber" : "13",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4613",
    "page" : "503",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4614",
    "ayah_text" : "أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡجَنَّةِ خَٰلِدِينَ فِيهَا جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "اولٰئك اصحٰب الجنة خٰلدين فيها جزاء بما كانوا يعملون",
    "ayahnumber" : "14",
    "chapter" : "26",
    "hizb" : "50",
