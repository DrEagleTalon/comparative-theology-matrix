    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3941",
    "ayah_text" : "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "انه من عبادنا المؤمنين",
