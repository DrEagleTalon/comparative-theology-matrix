    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2588",
    "ayah_text" : "ثُمَّ نُكِسُواْ عَلَىٰ رُءُوسِهِمۡ لَقَدۡ عَلِمۡتَ مَا هَٰٓؤُلَآءِ يَنطِقُونَ",
    "ayah_text_no_diacratic" : "ثم نكسوا علىٰ رءوسهم لقد علمت ما هٰؤلاء ينطقون",
    "ayahnumber" : "65",
