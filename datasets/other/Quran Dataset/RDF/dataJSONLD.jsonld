    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5470",
    "ayah_text" : "إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي ٱلۡجَارِيَةِ",
    "ayah_text_no_diacratic" : "انا لما طغا الماء حملنٰكم في الجارية",
    "ayahnumber" : "11",
