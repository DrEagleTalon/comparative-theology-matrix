    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4244",
    "ayah_text" : "يَوۡمَ تُوَلُّونَ مُدۡبِرِينَ مَا لَكُم مِّنَ ٱللَّهِ مِنۡ عَاصِمٖۗ وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِنۡ هَادٖ",
    "ayah_text_no_diacratic" : "يوم تولون مدبرين ما لكم من الله من عاصم ومن يضلل الله فما له من هاد",
    "ayahnumber" : "33",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4244",
    "page" : "470",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4245",
    "ayah_text" : "وَلَقَدۡ جَآءَكُمۡ يُوسُفُ مِن قَبۡلُ بِٱلۡبَيِّنَٰتِ فَمَا زِلۡتُمۡ فِي شَكّٖ مِّمَّا جَآءَكُم بِهِۦۖ حَتَّىٰٓ إِذَا هَلَكَ قُلۡتُمۡ لَن يَبۡعَثَ ٱللَّهُ مِنۢ بَعۡدِهِۦ رَسُولٗاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَنۡ هُوَ مُسۡرِفٞ مُّرۡتَابٌ",
    "ayah_text_no_diacratic" : "ولقد جاءكم يوسف من قبل بالبينٰت فما زلتم في شك مما جاءكم به حتىٰ اذا هلك قلتم لن يبعث الله من بعده رسولا كذٰلك يضل الله من هو مسرف مرتاب",
    "ayahnumber" : "34",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4245",
    "page" : "471",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4246",
    "ayah_text" : "ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِ ٱللَّهِ بِغَيۡرِ سُلۡطَٰنٍ أَتَىٰهُمۡۖ كَبُرَ مَقۡتًا عِندَ ٱللَّهِ وَعِندَ ٱلَّذِينَ ءَامَنُواْۚ كَذَٰلِكَ يَطۡبَعُ ٱللَّهُ عَلَىٰ كُلِّ قَلۡبِ مُتَكَبِّرٖ جَبَّارٖ",
    "ayah_text_no_diacratic" : "الذين يجٰدلون في ءايٰت الله بغير سلطٰن اتىٰهم كبر مقتا عند الله وعند الذين ءامنوا كذٰلك يطبع الله علىٰ كل قلب متكبر جبار",
    "ayahnumber" : "35",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4246",
    "page" : "471",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4247",
    "ayah_text" : "وَقَالَ فِرۡعَوۡنُ يَٰهَٰمَٰنُ ٱبۡنِ لِي صَرۡحٗا لَّعَلِّيٓ أَبۡلُغُ ٱلۡأَسۡبَٰبَ",
    "ayah_text_no_diacratic" : "وقال فرعون يٰهٰمٰن ابن لي صرحا لعلي ابلغ الاسبٰب",
    "ayahnumber" : "36",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4247",
    "page" : "471",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4248",
    "ayah_text" : "أَسۡبَٰبَ ٱلسَّمَٰوَٰتِ فَأَطَّلِعَ إِلَىٰٓ إِلَٰهِ مُوسَىٰ وَإِنِّي لَأَظُنُّهُۥ كَٰذِبٗاۚ وَكَذَٰلِكَ زُيِّنَ لِفِرۡعَوۡنَ سُوٓءُ عَمَلِهِۦ وَصُدَّ عَنِ ٱلسَّبِيلِۚ وَمَا كَيۡدُ فِرۡعَوۡنَ إِلَّا فِي تَبَابٖ",
    "ayah_text_no_diacratic" : "اسبٰب السمٰوٰت فاطلع الىٰ الٰه موسىٰ واني لاظنه كٰذبا وكذٰلك زين لفرعون سوء عمله وصد عن السبيل وما كيد فرعون الا في تباب",
    "ayahnumber" : "37",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4248",
    "page" : "471",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4249",
    "ayah_text" : "وَقَالَ ٱلَّذِيٓ ءَامَنَ يَٰقَوۡمِ ٱتَّبِعُونِ أَهۡدِكُمۡ سَبِيلَ ٱلرَّشَادِ",
    "ayah_text_no_diacratic" : "وقال الذي ءامن يٰقوم اتبعون اهدكم سبيل الرشاد",
    "ayahnumber" : "38",
    "chapter" : "24",
    "hizb" : "47",
