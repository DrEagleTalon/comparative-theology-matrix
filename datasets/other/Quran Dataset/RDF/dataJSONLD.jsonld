    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3167",
    "ayah_text" : "قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ",
    "ayah_text_no_diacratic" : "قالوا انما انت من المسحرين",
    "ayahnumber" : "185",
    "chapter" : "19",
    "hizb" : "37",
