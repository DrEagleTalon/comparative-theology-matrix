  }, {
    "@id" : "quran:2309",
    "ayah_text" : "فَأَجَآءَهَا ٱلۡمَخَاضُ إِلَىٰ جِذۡعِ ٱلنَّخۡلَةِ قَالَتۡ يَٰلَيۡتَنِي مِتُّ قَبۡلَ هَٰذَا وَكُنتُ نَسۡيٗا مَّنسِيّٗا",
    "ayah_text_no_diacratic" : "فاجاءها المخاض الىٰ جذع النخلة قالت يٰليتني مت قبل هٰذا وكنت نسيا منسيا",
    "ayahnumber" : "23",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2309",
    "page" : "306",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:231",
    "ayah_text" : "وَلَا تَنكِحُواْ ٱلۡمُشۡرِكَٰتِ حَتَّىٰ يُؤۡمِنَّۚ وَلَأَمَةٞ مُّؤۡمِنَةٌ خَيۡرٞ مِّن مُّشۡرِكَةٖ وَلَوۡ أَعۡجَبَتۡكُمۡۗ وَلَا تُنكِحُواْ ٱلۡمُشۡرِكِينَ حَتَّىٰ يُؤۡمِنُواْۚ وَلَعَبۡدٞ مُّؤۡمِنٌ خَيۡرٞ مِّن مُّشۡرِكٖ وَلَوۡ أَعۡجَبَكُمۡۗ أُوْلَٰٓئِكَ يَدۡعُونَ إِلَى ٱلنَّارِۖ وَٱللَّهُ يَدۡعُوٓاْ إِلَى ٱلۡجَنَّةِ وَٱلۡمَغۡفِرَةِ بِإِذۡنِهِۦۖ وَيُبَيِّنُ ءَايَٰتِهِۦ لِلنَّاسِ لَعَلَّهُمۡ يَتَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "ولا تنكحوا المشركٰت حتىٰ يؤمن ولامة مؤمنة خير من مشركة ولو اعجبتكم ولا تنكحوا المشركين حتىٰ يؤمنوا ولعبد مؤمن خير من مشرك ولو اعجبكم اولٰئك يدعون الى النار والله يدعوا الى الجنة والمغفرة باذنه ويبين ءايٰته للناس لعلهم يتذكرون",
    "ayahnumber" : "221",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "231",
    "page" : "35",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2310",
    "ayah_text" : "فَنَادَىٰهَا مِن تَحۡتِهَآ أَلَّا تَحۡزَنِي قَدۡ جَعَلَ رَبُّكِ تَحۡتَكِ سَرِيّٗا",
    "ayah_text_no_diacratic" : "فنادىٰها من تحتها الا تحزني قد جعل ربك تحتك سريا",
    "ayahnumber" : "24",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2310",
    "page" : "306",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2311",
    "ayah_text" : "وَهُزِّيٓ إِلَيۡكِ بِجِذۡعِ ٱلنَّخۡلَةِ تُسَٰقِطۡ عَلَيۡكِ رُطَبٗا جَنِيّٗا",
    "ayah_text_no_diacratic" : "وهزي اليك بجذع النخلة تسٰقط عليك رطبا جنيا",
    "ayahnumber" : "25",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2311",
    "page" : "306",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2312",
    "ayah_text" : "فَكُلِي وَٱشۡرَبِي وَقَرِّي عَيۡنٗاۖ فَإِمَّا تَرَيِنَّ مِنَ ٱلۡبَشَرِ أَحَدٗا فَقُولِيٓ إِنِّي نَذَرۡتُ لِلرَّحۡمَٰنِ صَوۡمٗا فَلَنۡ أُكَلِّمَ ٱلۡيَوۡمَ إِنسِيّٗا",
    "ayah_text_no_diacratic" : "فكلي واشربي وقري عينا فاما ترين من البشر احدا فقولي اني نذرت للرحمٰن صوما فلن اكلم اليوم انسيا",
    "ayahnumber" : "26",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2312",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2313",
    "ayah_text" : "فَأَتَتۡ بِهِۦ قَوۡمَهَا تَحۡمِلُهُۥۖ قَالُواْ يَٰمَرۡيَمُ لَقَدۡ جِئۡتِ شَيۡـٔٗا فَرِيّٗا",
    "ayah_text_no_diacratic" : "فاتت به قومها تحمله قالوا يٰمريم لقد جئت شيا فريا",
    "ayahnumber" : "27",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2313",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2314",
    "ayah_text" : "يَٰٓأُخۡتَ هَٰرُونَ مَا كَانَ أَبُوكِ ٱمۡرَأَ سَوۡءٖ وَمَا كَانَتۡ أُمُّكِ بَغِيّٗا",
    "ayah_text_no_diacratic" : "يٰاخت هٰرون ما كان ابوك امرا سوء وما كانت امك بغيا",
    "ayahnumber" : "28",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2314",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2315",
    "ayah_text" : "فَأَشَارَتۡ إِلَيۡهِۖ قَالُواْ كَيۡفَ نُكَلِّمُ مَن كَانَ فِي ٱلۡمَهۡدِ صَبِيّٗا",
    "ayah_text_no_diacratic" : "فاشارت اليه قالوا كيف نكلم من كان في المهد صبيا",
    "ayahnumber" : "29",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2315",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2316",
    "ayah_text" : "قَالَ إِنِّي عَبۡدُ ٱللَّهِ ءَاتَىٰنِيَ ٱلۡكِتَٰبَ وَجَعَلَنِي نَبِيّٗا",
    "ayah_text_no_diacratic" : "قال اني عبد الله ءاتىٰني الكتٰب وجعلني نبيا",
    "ayahnumber" : "30",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2316",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2317",
    "ayah_text" : "وَجَعَلَنِي مُبَارَكًا أَيۡنَ مَا كُنتُ وَأَوۡصَٰنِي بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ مَا دُمۡتُ حَيّٗا",
    "ayah_text_no_diacratic" : "وجعلني مباركا اين ما كنت واوصٰني بالصلوٰة والزكوٰة ما دمت حيا",
    "ayahnumber" : "31",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2317",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2318",
    "ayah_text" : "وَبَرَّۢا بِوَٰلِدَتِي وَلَمۡ يَجۡعَلۡنِي جَبَّارٗا شَقِيّٗا",
    "ayah_text_no_diacratic" : "وبرا بوٰلدتي ولم يجعلني جبارا شقيا",
    "ayahnumber" : "32",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2318",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2319",
    "ayah_text" : "وَٱلسَّلَٰمُ عَلَيَّ يَوۡمَ وُلِدتُّ وَيَوۡمَ أَمُوتُ وَيَوۡمَ أُبۡعَثُ حَيّٗا",
    "ayah_text_no_diacratic" : "والسلٰم علي يوم ولدت ويوم اموت ويوم ابعث حيا",
    "ayahnumber" : "33",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2319",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:232",
    "ayah_text" : "وَيَسۡـَٔلُونَكَ عَنِ ٱلۡمَحِيضِۖ قُلۡ هُوَ أَذٗى فَٱعۡتَزِلُواْ ٱلنِّسَآءَ فِي ٱلۡمَحِيضِ وَلَا تَقۡرَبُوهُنَّ حَتَّىٰ يَطۡهُرۡنَۖ فَإِذَا تَطَهَّرۡنَ فَأۡتُوهُنَّ مِنۡ حَيۡثُ أَمَرَكُمُ ٱللَّهُۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلتَّوَّٰبِينَ وَيُحِبُّ ٱلۡمُتَطَهِّرِينَ",
    "ayah_text_no_diacratic" : "ويسلونك عن المحيض قل هو اذى فاعتزلوا النساء في المحيض ولا تقربوهن حتىٰ يطهرن فاذا تطهرن فاتوهن من حيث امركم الله ان الله يحب التوٰبين ويحب المتطهرين",
    "ayahnumber" : "222",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "232",
    "page" : "35",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2320",
    "ayah_text" : "ذَٰلِكَ عِيسَى ٱبۡنُ مَرۡيَمَۖ قَوۡلَ ٱلۡحَقِّ ٱلَّذِي فِيهِ يَمۡتَرُونَ",
    "ayah_text_no_diacratic" : "ذٰلك عيسى ابن مريم قول الحق الذي فيه يمترون",
    "ayahnumber" : "34",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2320",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2321",
    "ayah_text" : "مَا كَانَ لِلَّهِ أَن يَتَّخِذَ مِن وَلَدٖۖ سُبۡحَٰنَهُۥٓۚ إِذَا قَضَىٰٓ أَمۡرٗا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ",
    "ayah_text_no_diacratic" : "ما كان لله ان يتخذ من ولد سبحٰنه اذا قضىٰ امرا فانما يقول له كن فيكون",
    "ayahnumber" : "35",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2321",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2322",
    "ayah_text" : "وَإِنَّ ٱللَّهَ رَبِّي وَرَبُّكُمۡ فَٱعۡبُدُوهُۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ",
    "ayah_text_no_diacratic" : "وان الله ربي وربكم فاعبدوه هٰذا صرٰط مستقيم",
    "ayahnumber" : "36",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2322",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2323",
    "ayah_text" : "فَٱخۡتَلَفَ ٱلۡأَحۡزَابُ مِنۢ بَيۡنِهِمۡۖ فَوَيۡلٞ لِّلَّذِينَ كَفَرُواْ مِن مَّشۡهَدِ يَوۡمٍ عَظِيمٍ",
    "ayah_text_no_diacratic" : "فاختلف الاحزاب من بينهم فويل للذين كفروا من مشهد يوم عظيم",
    "ayahnumber" : "37",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2323",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2324",
    "ayah_text" : "أَسۡمِعۡ بِهِمۡ وَأَبۡصِرۡ يَوۡمَ يَأۡتُونَنَا لَٰكِنِ ٱلظَّٰلِمُونَ ٱلۡيَوۡمَ فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "اسمع بهم وابصر يوم ياتوننا لٰكن الظٰلمون اليوم في ضلٰل مبين",
    "ayahnumber" : "38",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2324",
    "page" : "307",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2325",
    "ayah_text" : "وَأَنذِرۡهُمۡ يَوۡمَ ٱلۡحَسۡرَةِ إِذۡ قُضِيَ ٱلۡأَمۡرُ وَهُمۡ فِي غَفۡلَةٖ وَهُمۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "وانذرهم يوم الحسرة اذ قضي الامر وهم في غفلة وهم لا يؤمنون",
    "ayahnumber" : "39",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2325",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2326",
    "ayah_text" : "إِنَّا نَحۡنُ نَرِثُ ٱلۡأَرۡضَ وَمَنۡ عَلَيۡهَا وَإِلَيۡنَا يُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "انا نحن نرث الارض ومن عليها والينا يرجعون",
    "ayahnumber" : "40",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2326",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2327",
    "ayah_text" : "وَٱذۡكُرۡ فِي ٱلۡكِتَٰبِ إِبۡرَٰهِيمَۚ إِنَّهُۥ كَانَ صِدِّيقٗا نَّبِيًّا",
    "ayah_text_no_diacratic" : "واذكر في الكتٰب ابرٰهيم انه كان صديقا نبيا",
    "ayahnumber" : "41",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2327",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2328",
    "ayah_text" : "إِذۡ قَالَ لِأَبِيهِ يَٰٓأَبَتِ لِمَ تَعۡبُدُ مَا لَا يَسۡمَعُ وَلَا يُبۡصِرُ وَلَا يُغۡنِي عَنكَ شَيۡـٔٗا",
    "ayah_text_no_diacratic" : "اذ قال لابيه يٰابت لم تعبد ما لا يسمع ولا يبصر ولا يغني عنك شيا",
    "ayahnumber" : "42",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2328",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2329",
    "ayah_text" : "يَٰٓأَبَتِ إِنِّي قَدۡ جَآءَنِي مِنَ ٱلۡعِلۡمِ مَا لَمۡ يَأۡتِكَ فَٱتَّبِعۡنِيٓ أَهۡدِكَ صِرَٰطٗا سَوِيّٗا",
    "ayah_text_no_diacratic" : "يٰابت اني قد جاءني من العلم ما لم ياتك فاتبعني اهدك صرٰطا سويا",
    "ayahnumber" : "43",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2329",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:233",
    "ayah_text" : "نِسَآؤُكُمۡ حَرۡثٞ لَّكُمۡ فَأۡتُواْ حَرۡثَكُمۡ أَنَّىٰ شِئۡتُمۡۖ وَقَدِّمُواْ لِأَنفُسِكُمۡۚ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّكُم مُّلَٰقُوهُۗ وَبَشِّرِ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "نساؤكم حرث لكم فاتوا حرثكم انىٰ شئتم وقدموا لانفسكم واتقوا الله واعلموا انكم ملٰقوه وبشر المؤمنين",
    "ayahnumber" : "223",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "233",
    "page" : "35",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2330",
    "ayah_text" : "يَٰٓأَبَتِ لَا تَعۡبُدِ ٱلشَّيۡطَٰنَۖ إِنَّ ٱلشَّيۡطَٰنَ كَانَ لِلرَّحۡمَٰنِ عَصِيّٗا",
    "ayah_text_no_diacratic" : "يٰابت لا تعبد الشيطٰن ان الشيطٰن كان للرحمٰن عصيا",
    "ayahnumber" : "44",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2330",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2331",
    "ayah_text" : "يَٰٓأَبَتِ إِنِّيٓ أَخَافُ أَن يَمَسَّكَ عَذَابٞ مِّنَ ٱلرَّحۡمَٰنِ فَتَكُونَ لِلشَّيۡطَٰنِ وَلِيّٗا",
    "ayah_text_no_diacratic" : "يٰابت اني اخاف ان يمسك عذاب من الرحمٰن فتكون للشيطٰن وليا",
    "ayahnumber" : "45",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2331",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2332",
    "ayah_text" : "قَالَ أَرَاغِبٌ أَنتَ عَنۡ ءَالِهَتِي يَٰٓإِبۡرَٰهِيمُۖ لَئِن لَّمۡ تَنتَهِ لَأَرۡجُمَنَّكَۖ وَٱهۡجُرۡنِي مَلِيّٗا",
    "ayah_text_no_diacratic" : "قال اراغب انت عن ءالهتي يٰابرٰهيم لئن لم تنته لارجمنك واهجرني مليا",
    "ayahnumber" : "46",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2332",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2333",
    "ayah_text" : "قَالَ سَلَٰمٌ عَلَيۡكَۖ سَأَسۡتَغۡفِرُ لَكَ رَبِّيٓۖ إِنَّهُۥ كَانَ بِي حَفِيّٗا",
    "ayah_text_no_diacratic" : "قال سلٰم عليك ساستغفر لك ربي انه كان بي حفيا",
    "ayahnumber" : "47",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2333",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2334",
    "ayah_text" : "وَأَعۡتَزِلُكُمۡ وَمَا تَدۡعُونَ مِن دُونِ ٱللَّهِ وَأَدۡعُواْ رَبِّي عَسَىٰٓ أَلَّآ أَكُونَ بِدُعَآءِ رَبِّي شَقِيّٗا",
    "ayah_text_no_diacratic" : "واعتزلكم وما تدعون من دون الله وادعوا ربي عسىٰ الا اكون بدعاء ربي شقيا",
    "ayahnumber" : "48",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2334",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2335",
    "ayah_text" : "فَلَمَّا ٱعۡتَزَلَهُمۡ وَمَا يَعۡبُدُونَ مِن دُونِ ٱللَّهِ وَهَبۡنَا لَهُۥٓ إِسۡحَٰقَ وَيَعۡقُوبَۖ وَكُلّٗا جَعَلۡنَا نَبِيّٗا",
    "ayah_text_no_diacratic" : "فلما اعتزلهم وما يعبدون من دون الله وهبنا له اسحٰق ويعقوب وكلا جعلنا نبيا",
    "ayahnumber" : "49",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2335",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2336",
    "ayah_text" : "وَوَهَبۡنَا لَهُم مِّن رَّحۡمَتِنَا وَجَعَلۡنَا لَهُمۡ لِسَانَ صِدۡقٍ عَلِيّٗا",
    "ayah_text_no_diacratic" : "ووهبنا لهم من رحمتنا وجعلنا لهم لسان صدق عليا",
    "ayahnumber" : "50",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2336",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2337",
    "ayah_text" : "وَٱذۡكُرۡ فِي ٱلۡكِتَٰبِ مُوسَىٰٓۚ إِنَّهُۥ كَانَ مُخۡلَصٗا وَكَانَ رَسُولٗا نَّبِيّٗا",
    "ayah_text_no_diacratic" : "واذكر في الكتٰب موسىٰ انه كان مخلصا وكان رسولا نبيا",
    "ayahnumber" : "51",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2337",
    "page" : "308",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2338",
    "ayah_text" : "وَنَٰدَيۡنَٰهُ مِن جَانِبِ ٱلطُّورِ ٱلۡأَيۡمَنِ وَقَرَّبۡنَٰهُ نَجِيّٗا",
    "ayah_text_no_diacratic" : "ونٰدينٰه من جانب الطور الايمن وقربنٰه نجيا",
    "ayahnumber" : "52",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2338",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2339",
    "ayah_text" : "وَوَهَبۡنَا لَهُۥ مِن رَّحۡمَتِنَآ أَخَاهُ هَٰرُونَ نَبِيّٗا",
    "ayah_text_no_diacratic" : "ووهبنا له من رحمتنا اخاه هٰرون نبيا",
    "ayahnumber" : "53",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2339",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:234",
    "ayah_text" : "وَلَا تَجۡعَلُواْ ٱللَّهَ عُرۡضَةٗ لِّأَيۡمَٰنِكُمۡ أَن تَبَرُّواْ وَتَتَّقُواْ وَتُصۡلِحُواْ بَيۡنَ ٱلنَّاسِۚ وَٱللَّهُ سَمِيعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "ولا تجعلوا الله عرضة لايمٰنكم ان تبروا وتتقوا وتصلحوا بين الناس والله سميع عليم",
    "ayahnumber" : "224",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "234",
    "page" : "35",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2340",
    "ayah_text" : "وَٱذۡكُرۡ فِي ٱلۡكِتَٰبِ إِسۡمَٰعِيلَۚ إِنَّهُۥ كَانَ صَادِقَ ٱلۡوَعۡدِ وَكَانَ رَسُولٗا نَّبِيّٗا",
    "ayah_text_no_diacratic" : "واذكر في الكتٰب اسمٰعيل انه كان صادق الوعد وكان رسولا نبيا",
    "ayahnumber" : "54",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2340",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2341",
    "ayah_text" : "وَكَانَ يَأۡمُرُ أَهۡلَهُۥ بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ وَكَانَ عِندَ رَبِّهِۦ مَرۡضِيّٗا",
    "ayah_text_no_diacratic" : "وكان يامر اهله بالصلوٰة والزكوٰة وكان عند ربه مرضيا",
    "ayahnumber" : "55",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2341",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2342",
    "ayah_text" : "وَٱذۡكُرۡ فِي ٱلۡكِتَٰبِ إِدۡرِيسَۚ إِنَّهُۥ كَانَ صِدِّيقٗا نَّبِيّٗا",
    "ayah_text_no_diacratic" : "واذكر في الكتٰب ادريس انه كان صديقا نبيا",
    "ayahnumber" : "56",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2342",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2343",
    "ayah_text" : "وَرَفَعۡنَٰهُ مَكَانًا عَلِيًّا",
    "ayah_text_no_diacratic" : "ورفعنٰه مكانا عليا",
    "ayahnumber" : "57",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2343",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2344",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ أَنۡعَمَ ٱللَّهُ عَلَيۡهِم مِّنَ ٱلنَّبِيِّـۧنَ مِن ذُرِّيَّةِ ءَادَمَ وَمِمَّنۡ حَمَلۡنَا مَعَ نُوحٖ وَمِن ذُرِّيَّةِ إِبۡرَٰهِيمَ وَإِسۡرَٰٓءِيلَ وَمِمَّنۡ هَدَيۡنَا وَٱجۡتَبَيۡنَآۚ إِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُ ٱلرَّحۡمَٰنِ خَرُّواْۤ سُجَّدٗاۤ وَبُكِيّٗا۩",
    "ayah_text_no_diacratic" : "اولٰئك الذين انعم الله عليهم من النبين من ذرية ءادم وممن حملنا مع نوح ومن ذرية ابرٰهيم واسرٰءيل وممن هدينا واجتبينا اذا تتلىٰ عليهم ءايٰت الرحمٰن خروا سجدا وبكيا",
    "ayahnumber" : "58",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2344",
    "page" : "309",
    "sajdah" : "1",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2345",
    "ayah_text" : "۞فَخَلَفَ مِنۢ بَعۡدِهِمۡ خَلۡفٌ أَضَاعُواْ ٱلصَّلَوٰةَ وَٱتَّبَعُواْ ٱلشَّهَوَٰتِۖ فَسَوۡفَ يَلۡقَوۡنَ غَيًّا",
    "ayah_text_no_diacratic" : "فخلف من بعدهم خلف اضاعوا الصلوٰة واتبعوا الشهوٰت فسوف يلقون غيا",
    "ayahnumber" : "59",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2345",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2346",
    "ayah_text" : "إِلَّا مَن تَابَ وَءَامَنَ وَعَمِلَ صَٰلِحٗا فَأُوْلَٰٓئِكَ يَدۡخُلُونَ ٱلۡجَنَّةَ وَلَا يُظۡلَمُونَ شَيۡـٔٗا",
    "ayah_text_no_diacratic" : "الا من تاب وءامن وعمل صٰلحا فاولٰئك يدخلون الجنة ولا يظلمون شيا",
    "ayahnumber" : "60",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2346",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2347",
    "ayah_text" : "جَنَّٰتِ عَدۡنٍ ٱلَّتِي وَعَدَ ٱلرَّحۡمَٰنُ عِبَادَهُۥ بِٱلۡغَيۡبِۚ إِنَّهُۥ كَانَ وَعۡدُهُۥ مَأۡتِيّٗا",
    "ayah_text_no_diacratic" : "جنٰت عدن التي وعد الرحمٰن عباده بالغيب انه كان وعده ماتيا",
    "ayahnumber" : "61",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2347",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2348",
    "ayah_text" : "لَّا يَسۡمَعُونَ فِيهَا لَغۡوًا إِلَّا سَلَٰمٗاۖ وَلَهُمۡ رِزۡقُهُمۡ فِيهَا بُكۡرَةٗ وَعَشِيّٗا",
    "ayah_text_no_diacratic" : "لا يسمعون فيها لغوا الا سلٰما ولهم رزقهم فيها بكرة وعشيا",
    "ayahnumber" : "62",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2348",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2349",
    "ayah_text" : "تِلۡكَ ٱلۡجَنَّةُ ٱلَّتِي نُورِثُ مِنۡ عِبَادِنَا مَن كَانَ تَقِيّٗا",
    "ayah_text_no_diacratic" : "تلك الجنة التي نورث من عبادنا من كان تقيا",
    "ayahnumber" : "63",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2349",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:235",
    "ayah_text" : "لَّا يُؤَاخِذُكُمُ ٱللَّهُ بِٱللَّغۡوِ فِيٓ أَيۡمَٰنِكُمۡ وَلَٰكِن يُؤَاخِذُكُم بِمَا كَسَبَتۡ قُلُوبُكُمۡۗ وَٱللَّهُ غَفُورٌ حَلِيمٞ",
    "ayah_text_no_diacratic" : "لا يؤاخذكم الله باللغو في ايمٰنكم ولٰكن يؤاخذكم بما كسبت قلوبكم والله غفور حليم",
    "ayahnumber" : "225",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "235",
    "page" : "36",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2350",
    "ayah_text" : "وَمَا نَتَنَزَّلُ إِلَّا بِأَمۡرِ رَبِّكَۖ لَهُۥ مَا بَيۡنَ أَيۡدِينَا وَمَا خَلۡفَنَا وَمَا بَيۡنَ ذَٰلِكَۚ وَمَا كَانَ رَبُّكَ نَسِيّٗا",
    "ayah_text_no_diacratic" : "وما نتنزل الا بامر ربك له ما بين ايدينا وما خلفنا وما بين ذٰلك وما كان ربك نسيا",
    "ayahnumber" : "64",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2350",
    "page" : "309",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2351",
    "ayah_text" : "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا فَٱعۡبُدۡهُ وَٱصۡطَبِرۡ لِعِبَٰدَتِهِۦۚ هَلۡ تَعۡلَمُ لَهُۥ سَمِيّٗا",
    "ayah_text_no_diacratic" : "رب السمٰوٰت والارض وما بينهما فاعبده واصطبر لعبٰدته هل تعلم له سميا",
    "ayahnumber" : "65",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2351",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2352",
    "ayah_text" : "وَيَقُولُ ٱلۡإِنسَٰنُ أَءِذَا مَا مِتُّ لَسَوۡفَ أُخۡرَجُ حَيًّا",
    "ayah_text_no_diacratic" : "ويقول الانسٰن اءذا ما مت لسوف اخرج حيا",
    "ayahnumber" : "66",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2352",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2353",
    "ayah_text" : "أَوَلَا يَذۡكُرُ ٱلۡإِنسَٰنُ أَنَّا خَلَقۡنَٰهُ مِن قَبۡلُ وَلَمۡ يَكُ شَيۡـٔٗا",
    "ayah_text_no_diacratic" : "اولا يذكر الانسٰن انا خلقنٰه من قبل ولم يك شيا",
    "ayahnumber" : "67",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2353",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2354",
    "ayah_text" : "فَوَرَبِّكَ لَنَحۡشُرَنَّهُمۡ وَٱلشَّيَٰطِينَ ثُمَّ لَنُحۡضِرَنَّهُمۡ حَوۡلَ جَهَنَّمَ جِثِيّٗا",
    "ayah_text_no_diacratic" : "فوربك لنحشرنهم والشيٰطين ثم لنحضرنهم حول جهنم جثيا",
    "ayahnumber" : "68",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2354",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2355",
    "ayah_text" : "ثُمَّ لَنَنزِعَنَّ مِن كُلِّ شِيعَةٍ أَيُّهُمۡ أَشَدُّ عَلَى ٱلرَّحۡمَٰنِ عِتِيّٗا",
    "ayah_text_no_diacratic" : "ثم لننزعن من كل شيعة ايهم اشد على الرحمٰن عتيا",
    "ayahnumber" : "69",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2355",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2356",
    "ayah_text" : "ثُمَّ لَنَحۡنُ أَعۡلَمُ بِٱلَّذِينَ هُمۡ أَوۡلَىٰ بِهَا صِلِيّٗا",
    "ayah_text_no_diacratic" : "ثم لنحن اعلم بالذين هم اولىٰ بها صليا",
    "ayahnumber" : "70",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2356",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2357",
    "ayah_text" : "وَإِن مِّنكُمۡ إِلَّا وَارِدُهَاۚ كَانَ عَلَىٰ رَبِّكَ حَتۡمٗا مَّقۡضِيّٗا",
    "ayah_text_no_diacratic" : "وان منكم الا واردها كان علىٰ ربك حتما مقضيا",
    "ayahnumber" : "71",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2357",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2358",
    "ayah_text" : "ثُمَّ نُنَجِّي ٱلَّذِينَ ٱتَّقَواْ وَّنَذَرُ ٱلظَّٰلِمِينَ فِيهَا جِثِيّٗا",
    "ayah_text_no_diacratic" : "ثم ننجي الذين اتقوا ونذر الظٰلمين فيها جثيا",
    "ayahnumber" : "72",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2358",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2359",
    "ayah_text" : "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُنَا بَيِّنَٰتٖ قَالَ ٱلَّذِينَ كَفَرُواْ لِلَّذِينَ ءَامَنُوٓاْ أَيُّ ٱلۡفَرِيقَيۡنِ خَيۡرٞ مَّقَامٗا وَأَحۡسَنُ نَدِيّٗا",
    "ayah_text_no_diacratic" : "واذا تتلىٰ عليهم ءايٰتنا بينٰت قال الذين كفروا للذين ءامنوا اي الفريقين خير مقاما واحسن نديا",
    "ayahnumber" : "73",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2359",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:236",
    "ayah_text" : "لِّلَّذِينَ يُؤۡلُونَ مِن نِّسَآئِهِمۡ تَرَبُّصُ أَرۡبَعَةِ أَشۡهُرٖۖ فَإِن فَآءُو فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "للذين يؤلون من نسائهم تربص اربعة اشهر فان فاءو فان الله غفور رحيم",
    "ayahnumber" : "226",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "236",
    "page" : "36",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2360",
    "ayah_text" : "وَكَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّن قَرۡنٍ هُمۡ أَحۡسَنُ أَثَٰثٗا وَرِءۡيٗا",
    "ayah_text_no_diacratic" : "وكم اهلكنا قبلهم من قرن هم احسن اثٰثا ورءيا",
    "ayahnumber" : "74",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2360",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2361",
    "ayah_text" : "قُلۡ مَن كَانَ فِي ٱلضَّلَٰلَةِ فَلۡيَمۡدُدۡ لَهُ ٱلرَّحۡمَٰنُ مَدًّاۚ حَتَّىٰٓ إِذَا رَأَوۡاْ مَا يُوعَدُونَ إِمَّا ٱلۡعَذَابَ وَإِمَّا ٱلسَّاعَةَ فَسَيَعۡلَمُونَ مَنۡ هُوَ شَرّٞ مَّكَانٗا وَأَضۡعَفُ جُندٗا",
    "ayah_text_no_diacratic" : "قل من كان في الضلٰلة فليمدد له الرحمٰن مدا حتىٰ اذا راوا ما يوعدون اما العذاب واما الساعة فسيعلمون من هو شر مكانا واضعف جندا",
    "ayahnumber" : "75",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2361",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2362",
    "ayah_text" : "وَيَزِيدُ ٱللَّهُ ٱلَّذِينَ ٱهۡتَدَوۡاْ هُدٗىۗ وَٱلۡبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ خَيۡرٌ عِندَ رَبِّكَ ثَوَابٗا وَخَيۡرٞ مَّرَدًّا",
    "ayah_text_no_diacratic" : "ويزيد الله الذين اهتدوا هدى والبٰقيٰت الصٰلحٰت خير عند ربك ثوابا وخير مردا",
    "ayahnumber" : "76",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2362",
    "page" : "310",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2363",
    "ayah_text" : "أَفَرَءَيۡتَ ٱلَّذِي كَفَرَ بِـَٔايَٰتِنَا وَقَالَ لَأُوتَيَنَّ مَالٗا وَوَلَدًا",
    "ayah_text_no_diacratic" : "افرءيت الذي كفر بايٰتنا وقال لاوتين مالا وولدا",
    "ayahnumber" : "77",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2363",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2364",
    "ayah_text" : "أَطَّلَعَ ٱلۡغَيۡبَ أَمِ ٱتَّخَذَ عِندَ ٱلرَّحۡمَٰنِ عَهۡدٗا",
    "ayah_text_no_diacratic" : "اطلع الغيب ام اتخذ عند الرحمٰن عهدا",
    "ayahnumber" : "78",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2364",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2365",
    "ayah_text" : "كَلَّاۚ سَنَكۡتُبُ مَا يَقُولُ وَنَمُدُّ لَهُۥ مِنَ ٱلۡعَذَابِ مَدّٗا",
    "ayah_text_no_diacratic" : "كلا سنكتب ما يقول ونمد له من العذاب مدا",
    "ayahnumber" : "79",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2365",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2366",
    "ayah_text" : "وَنَرِثُهُۥ مَا يَقُولُ وَيَأۡتِينَا فَرۡدٗا",
    "ayah_text_no_diacratic" : "ونرثه ما يقول وياتينا فردا",
    "ayahnumber" : "80",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2366",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2367",
    "ayah_text" : "وَٱتَّخَذُواْ مِن دُونِ ٱللَّهِ ءَالِهَةٗ لِّيَكُونُواْ لَهُمۡ عِزّٗا",
    "ayah_text_no_diacratic" : "واتخذوا من دون الله ءالهة ليكونوا لهم عزا",
    "ayahnumber" : "81",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2367",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2368",
    "ayah_text" : "كَلَّاۚ سَيَكۡفُرُونَ بِعِبَادَتِهِمۡ وَيَكُونُونَ عَلَيۡهِمۡ ضِدًّا",
    "ayah_text_no_diacratic" : "كلا سيكفرون بعبادتهم ويكونون عليهم ضدا",
    "ayahnumber" : "82",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2368",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2369",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّآ أَرۡسَلۡنَا ٱلشَّيَٰطِينَ عَلَى ٱلۡكَٰفِرِينَ تَؤُزُّهُمۡ أَزّٗا",
    "ayah_text_no_diacratic" : "الم تر انا ارسلنا الشيٰطين على الكٰفرين تؤزهم ازا",
    "ayahnumber" : "83",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2369",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:237",
    "ayah_text" : "وَإِنۡ عَزَمُواْ ٱلطَّلَٰقَ فَإِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "وان عزموا الطلٰق فان الله سميع عليم",
    "ayahnumber" : "227",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "237",
    "page" : "36",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2370",
    "ayah_text" : "فَلَا تَعۡجَلۡ عَلَيۡهِمۡۖ إِنَّمَا نَعُدُّ لَهُمۡ عَدّٗا",
    "ayah_text_no_diacratic" : "فلا تعجل عليهم انما نعد لهم عدا",
    "ayahnumber" : "84",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2370",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2371",
    "ayah_text" : "يَوۡمَ نَحۡشُرُ ٱلۡمُتَّقِينَ إِلَى ٱلرَّحۡمَٰنِ وَفۡدٗا",
    "ayah_text_no_diacratic" : "يوم نحشر المتقين الى الرحمٰن وفدا",
    "ayahnumber" : "85",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2371",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2372",
    "ayah_text" : "وَنَسُوقُ ٱلۡمُجۡرِمِينَ إِلَىٰ جَهَنَّمَ وِرۡدٗا",
    "ayah_text_no_diacratic" : "ونسوق المجرمين الىٰ جهنم وردا",
    "ayahnumber" : "86",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2372",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2373",
    "ayah_text" : "لَّا يَمۡلِكُونَ ٱلشَّفَٰعَةَ إِلَّا مَنِ ٱتَّخَذَ عِندَ ٱلرَّحۡمَٰنِ عَهۡدٗا",
    "ayah_text_no_diacratic" : "لا يملكون الشفٰعة الا من اتخذ عند الرحمٰن عهدا",
    "ayahnumber" : "87",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2373",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2374",
    "ayah_text" : "وَقَالُواْ ٱتَّخَذَ ٱلرَّحۡمَٰنُ وَلَدٗا",
    "ayah_text_no_diacratic" : "وقالوا اتخذ الرحمٰن ولدا",
    "ayahnumber" : "88",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2374",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2375",
    "ayah_text" : "لَّقَدۡ جِئۡتُمۡ شَيۡـًٔا إِدّٗا",
    "ayah_text_no_diacratic" : "لقد جئتم شيا ادا",
    "ayahnumber" : "89",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2375",
    "page" : "311",
