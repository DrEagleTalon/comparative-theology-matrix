  }, {
    "@id" : "quran:5018",
    "ayah_text" : "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ",
    "ayah_text_no_diacratic" : "واقيموا الوزن بالقسط ولا تخسروا الميزان",
