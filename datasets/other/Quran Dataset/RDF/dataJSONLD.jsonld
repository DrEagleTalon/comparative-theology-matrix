    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:295",
    "ayah_text" : "ءَامَنَ ٱلرَّسُولُ بِمَآ أُنزِلَ إِلَيۡهِ مِن رَّبِّهِۦ وَٱلۡمُؤۡمِنُونَۚ كُلٌّ ءَامَنَ بِٱللَّهِ وَمَلَٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ لَا نُفَرِّقُ بَيۡنَ أَحَدٖ مِّن رُّسُلِهِۦۚ وَقَالُواْ سَمِعۡنَا وَأَطَعۡنَاۖ غُفۡرَانَكَ رَبَّنَا وَإِلَيۡكَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "ءامن الرسول بما انزل اليه من ربه والمؤمنون كل ءامن بالله وملٰئكته وكتبه ورسله لا نفرق بين احد من رسله وقالوا سمعنا واطعنا غفرانك ربنا واليك المصير",
    "ayahnumber" : "285",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "295",
    "page" : "49",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2950",
    "ayah_text" : "وَهُوَ ٱلَّذِي جَعَلَ لَكُمُ ٱلَّيۡلَ لِبَاسٗا وَٱلنَّوۡمَ سُبَاتٗا وَجَعَلَ ٱلنَّهَارَ نُشُورٗا",
    "ayah_text_no_diacratic" : "وهو الذي جعل لكم اليل لباسا والنوم سباتا وجعل النهار نشورا",
    "ayahnumber" : "47",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2950",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2951",
    "ayah_text" : "وَهُوَ ٱلَّذِيٓ أَرۡسَلَ ٱلرِّيَٰحَ بُشۡرَۢا بَيۡنَ يَدَيۡ رَحۡمَتِهِۦۚ وَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ طَهُورٗا",
    "ayah_text_no_diacratic" : "وهو الذي ارسل الريٰح بشرا بين يدي رحمته وانزلنا من السماء ماء طهورا",
    "ayahnumber" : "48",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2951",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2952",
    "ayah_text" : "لِّنُحۡـِۧيَ بِهِۦ بَلۡدَةٗ مَّيۡتٗا وَنُسۡقِيَهُۥ مِمَّا خَلَقۡنَآ أَنۡعَٰمٗا وَأَنَاسِيَّ كَثِيرٗا",
    "ayah_text_no_diacratic" : "لنحي به بلدة ميتا ونسقيه مما خلقنا انعٰما واناسي كثيرا",
    "ayahnumber" : "49",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2952",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2953",
    "ayah_text" : "وَلَقَدۡ صَرَّفۡنَٰهُ بَيۡنَهُمۡ لِيَذَّكَّرُواْ فَأَبَىٰٓ أَكۡثَرُ ٱلنَّاسِ إِلَّا كُفُورٗا",
    "ayah_text_no_diacratic" : "ولقد صرفنٰه بينهم ليذكروا فابىٰ اكثر الناس الا كفورا",
    "ayahnumber" : "50",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2953",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2954",
    "ayah_text" : "وَلَوۡ شِئۡنَا لَبَعَثۡنَا فِي كُلِّ قَرۡيَةٖ نَّذِيرٗا",
    "ayah_text_no_diacratic" : "ولو شئنا لبعثنا في كل قرية نذيرا",
    "ayahnumber" : "51",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2954",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2955",
    "ayah_text" : "فَلَا تُطِعِ ٱلۡكَٰفِرِينَ وَجَٰهِدۡهُم بِهِۦ جِهَادٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "فلا تطع الكٰفرين وجٰهدهم به جهادا كبيرا",
    "ayahnumber" : "52",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2955",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2956",
    "ayah_text" : "۞وَهُوَ ٱلَّذِي مَرَجَ ٱلۡبَحۡرَيۡنِ هَٰذَا عَذۡبٞ فُرَاتٞ وَهَٰذَا مِلۡحٌ أُجَاجٞ وَجَعَلَ بَيۡنَهُمَا بَرۡزَخٗا وَحِجۡرٗا مَّحۡجُورٗا",
    "ayah_text_no_diacratic" : "وهو الذي مرج البحرين هٰذا عذب فرات وهٰذا ملح اجاج وجعل بينهما برزخا وحجرا محجورا",
    "ayahnumber" : "53",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2956",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2957",
    "ayah_text" : "وَهُوَ ٱلَّذِي خَلَقَ مِنَ ٱلۡمَآءِ بَشَرٗا فَجَعَلَهُۥ نَسَبٗا وَصِهۡرٗاۗ وَكَانَ رَبُّكَ قَدِيرٗا",
    "ayah_text_no_diacratic" : "وهو الذي خلق من الماء بشرا فجعله نسبا وصهرا وكان ربك قديرا",
    "ayahnumber" : "54",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2957",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2958",
    "ayah_text" : "وَيَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُهُمۡ وَلَا يَضُرُّهُمۡۗ وَكَانَ ٱلۡكَافِرُ عَلَىٰ رَبِّهِۦ ظَهِيرٗا",
    "ayah_text_no_diacratic" : "ويعبدون من دون الله ما لا ينفعهم ولا يضرهم وكان الكافر علىٰ ربه ظهيرا",
    "ayahnumber" : "55",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2958",
    "page" : "364",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2959",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَٰكَ إِلَّا مُبَشِّرٗا وَنَذِيرٗا",
    "ayah_text_no_diacratic" : "وما ارسلنٰك الا مبشرا ونذيرا",
    "ayahnumber" : "56",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2959",
    "page" : "365",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:296",
    "ayah_text" : "لَا يُكَلِّفُ ٱللَّهُ نَفۡسًا إِلَّا وُسۡعَهَاۚ لَهَا مَا كَسَبَتۡ وَعَلَيۡهَا مَا ٱكۡتَسَبَتۡۗ رَبَّنَا لَا تُؤَاخِذۡنَآ إِن نَّسِينَآ أَوۡ أَخۡطَأۡنَاۚ رَبَّنَا وَلَا تَحۡمِلۡ عَلَيۡنَآ إِصۡرٗا كَمَا حَمَلۡتَهُۥ عَلَى ٱلَّذِينَ مِن قَبۡلِنَاۚ رَبَّنَا وَلَا تُحَمِّلۡنَا مَا لَا طَاقَةَ لَنَا بِهِۦۖ وَٱعۡفُ عَنَّا وَٱغۡفِرۡ لَنَا وَٱرۡحَمۡنَآۚ أَنتَ مَوۡلَىٰنَا فَٱنصُرۡنَا عَلَى ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "لا يكلف الله نفسا الا وسعها لها ما كسبت وعليها ما اكتسبت ربنا لا تؤاخذنا ان نسينا او اخطانا ربنا ولا تحمل علينا اصرا كما حملته على الذين من قبلنا ربنا ولا تحملنا ما لا طاقة لنا به واعف عنا واغفر لنا وارحمنا انت مولىٰنا فانصرنا على القوم الكٰفرين",
    "ayahnumber" : "286",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "296",
    "page" : "49",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2960",
    "ayah_text" : "قُلۡ مَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍ إِلَّا مَن شَآءَ أَن يَتَّخِذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا",
    "ayah_text_no_diacratic" : "قل ما اسلكم عليه من اجر الا من شاء ان يتخذ الىٰ ربه سبيلا",
    "ayahnumber" : "57",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2960",
    "page" : "365",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2961",
    "ayah_text" : "وَتَوَكَّلۡ عَلَى ٱلۡحَيِّ ٱلَّذِي لَا يَمُوتُ وَسَبِّحۡ بِحَمۡدِهِۦۚ وَكَفَىٰ بِهِۦ بِذُنُوبِ عِبَادِهِۦ خَبِيرًا",
    "ayah_text_no_diacratic" : "وتوكل على الحي الذي لا يموت وسبح بحمده وكفىٰ به بذنوب عباده خبيرا",
    "ayahnumber" : "58",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2961",
    "page" : "365",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2962",
    "ayah_text" : "ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ ٱلرَّحۡمَٰنُ فَسۡـَٔلۡ بِهِۦ خَبِيرٗا",
    "ayah_text_no_diacratic" : "الذي خلق السمٰوٰت والارض وما بينهما في ستة ايام ثم استوىٰ على العرش الرحمٰن فسل به خبيرا",
    "ayahnumber" : "59",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2962",
    "page" : "365",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2963",
    "ayah_text" : "وَإِذَا قِيلَ لَهُمُ ٱسۡجُدُواْۤ لِلرَّحۡمَٰنِ قَالُواْ وَمَا ٱلرَّحۡمَٰنُ أَنَسۡجُدُ لِمَا تَأۡمُرُنَا وَزَادَهُمۡ نُفُورٗا۩",
    "ayah_text_no_diacratic" : "واذا قيل لهم اسجدوا للرحمٰن قالوا وما الرحمٰن انسجد لما تامرنا وزادهم نفورا",
    "ayahnumber" : "60",
