  }, {
    "@id" : "quran:6041",
    "ayah_text" : "إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ",
    "ayah_text_no_diacratic" : "ان الذين اجرموا كانوا من الذين ءامنوا يضحكون",
    "ayahnumber" : "29",
