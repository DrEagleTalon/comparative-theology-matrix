    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4824",
    "ayah_text" : "وَمِن كُلِّ شَيۡءٍ خَلَقۡنَا زَوۡجَيۡنِ لَعَلَّكُمۡ تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "ومن كل شيء خلقنا زوجين لعلكم تذكرون",
