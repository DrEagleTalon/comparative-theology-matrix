    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:941",
    "ayah_text" : "۞وَهُوَ ٱلَّذِيٓ أَنشَأَ جَنَّٰتٖ مَّعۡرُوشَٰتٖ وَغَيۡرَ مَعۡرُوشَٰتٖ وَٱلنَّخۡلَ وَٱلزَّرۡعَ مُخۡتَلِفًا أُكُلُهُۥ وَٱلزَّيۡتُونَ وَٱلرُّمَّانَ مُتَشَٰبِهٗا وَغَيۡرَ مُتَشَٰبِهٖۚ كُلُواْ مِن ثَمَرِهِۦٓ إِذَآ أَثۡمَرَ وَءَاتُواْ حَقَّهُۥ يَوۡمَ حَصَادِهِۦۖ وَلَا تُسۡرِفُوٓاْۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡمُسۡرِفِينَ",
    "ayah_text_no_diacratic" : "وهو الذي انشا جنٰت معروشٰت وغير معروشٰت والنخل والزرع مختلفا اكله والزيتون والرمان متشٰبها وغير متشٰبه كلوا من ثمره اذا اثمر وءاتوا حقه يوم حصاده ولا تسرفوا انه لا يحب المسرفين",
    "ayahnumber" : "141",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "941",
    "page" : "146",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:942",
    "ayah_text" : "وَمِنَ ٱلۡأَنۡعَٰمِ حَمُولَةٗ وَفَرۡشٗاۚ كُلُواْ مِمَّا رَزَقَكُمُ ٱللَّهُ وَلَا تَتَّبِعُواْ خُطُوَٰتِ ٱلشَّيۡطَٰنِۚ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "ومن الانعٰم حمولة وفرشا كلوا مما رزقكم الله ولا تتبعوا خطوٰت الشيطٰن انه لكم عدو مبين",
    "ayahnumber" : "142",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "942",
    "page" : "146",
