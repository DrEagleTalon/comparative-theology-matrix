    "surahname" : "سُورَةُ الحَاقَّةِ",
    "surahnumber" : "69",
    "surrahname_no_diacratic" : "سورة الحاقة"
  }, {
    "@id" : "quran:547",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ ءَامِنُواْ بِمَا نَزَّلۡنَا مُصَدِّقٗا لِّمَا مَعَكُم مِّن قَبۡلِ أَن نَّطۡمِسَ وُجُوهٗا فَنَرُدَّهَا عَلَىٰٓ أَدۡبَارِهَآ أَوۡ نَلۡعَنَهُمۡ كَمَا لَعَنَّآ أَصۡحَٰبَ ٱلسَّبۡتِۚ وَكَانَ أَمۡرُ ٱللَّهِ مَفۡعُولًا",
    "ayah_text_no_diacratic" : "يٰايها الذين اوتوا الكتٰب ءامنوا بما نزلنا مصدقا لما معكم من قبل ان نطمس وجوها فنردها علىٰ ادبارها او نلعنهم كما لعنا اصحٰب السبت وكان امر الله مفعولا",
    "ayahnumber" : "47",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "547",
