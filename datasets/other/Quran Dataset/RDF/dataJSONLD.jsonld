    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3891",
    "ayah_text" : "فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ",
    "ayah_text_no_diacratic" : "فحق علينا قول ربنا انا لذائقون",
