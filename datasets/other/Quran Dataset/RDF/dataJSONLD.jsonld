  }, {
    "@id" : "quran:4638",
    "ayah_text" : "ٱلَّذِينَ كَفَرُواْ وَصَدُّواْ عَن سَبِيلِ ٱللَّهِ أَضَلَّ أَعۡمَٰلَهُمۡ",
    "ayah_text_no_diacratic" : "الذين كفروا وصدوا عن سبيل الله اضل اعمٰلهم",
    "ayahnumber" : "1",
    "chapter" : "26",
