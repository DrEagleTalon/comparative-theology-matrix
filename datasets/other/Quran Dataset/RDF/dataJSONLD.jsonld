    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:731",
    "ayah_text" : "وَيَقُولُ ٱلَّذِينَ ءَامَنُوٓاْ أَهَٰٓؤُلَآءِ ٱلَّذِينَ أَقۡسَمُواْ بِٱللَّهِ جَهۡدَ أَيۡمَٰنِهِمۡ إِنَّهُمۡ لَمَعَكُمۡۚ حَبِطَتۡ أَعۡمَٰلُهُمۡ فَأَصۡبَحُواْ خَٰسِرِينَ",
    "ayah_text_no_diacratic" : "ويقول الذين ءامنوا اهٰؤلاء الذين اقسموا بالله جهد ايمٰنهم انهم لمعكم حبطت اعمٰلهم فاصبحوا خٰسرين",
    "ayahnumber" : "53",
    "chapter" : "6",
    "hizb" : "11",
