    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3879",
    "ayah_text" : "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ",
