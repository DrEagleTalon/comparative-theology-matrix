  }, {
    "@id" : "quran:4541",
    "ayah_text" : "يَوۡمَ لَا يُغۡنِي مَوۡلًى عَن مَّوۡلٗى شَيۡـٔٗا وَلَا هُمۡ يُنصَرُونَ",
    "ayah_text_no_diacratic" : "يوم لا يغني مولى عن مولى شيا ولا هم ينصرون",
