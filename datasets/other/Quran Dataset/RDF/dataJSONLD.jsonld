  }, {
    "@id" : "quran:347",
    "ayah_text" : "وَرَسُولًا إِلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ أَنِّي قَدۡ جِئۡتُكُم بِـَٔايَةٖ مِّن رَّبِّكُمۡ أَنِّيٓ أَخۡلُقُ لَكُم مِّنَ ٱلطِّينِ كَهَيۡـَٔةِ ٱلطَّيۡرِ فَأَنفُخُ فِيهِ فَيَكُونُ طَيۡرَۢا بِإِذۡنِ ٱللَّهِۖ وَأُبۡرِئُ ٱلۡأَكۡمَهَ وَٱلۡأَبۡرَصَ وَأُحۡيِ ٱلۡمَوۡتَىٰ بِإِذۡنِ ٱللَّهِۖ وَأُنَبِّئُكُم بِمَا تَأۡكُلُونَ وَمَا تَدَّخِرُونَ فِي بُيُوتِكُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ورسولا الىٰ بني اسرٰءيل اني قد جئتكم باية من ربكم اني اخلق لكم من الطين كهية الطير فانفخ فيه فيكون طيرا باذن الله وابرئ الاكمه والابرص واحي الموتىٰ باذن الله وانبئكم بما تاكلون وما تدخرون في بيوتكم ان في ذٰلك لاية لكم ان كنتم مؤمنين",
    "ayahnumber" : "49",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "347",
    "page" : "56",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3470",
    "ayah_text" : "فِيٓ أَدۡنَى ٱلۡأَرۡضِ وَهُم مِّنۢ بَعۡدِ غَلَبِهِمۡ سَيَغۡلِبُونَ",
    "ayah_text_no_diacratic" : "في ادنى الارض وهم من بعد غلبهم سيغلبون",
    "ayahnumber" : "3",
    "chapter" : "21",
