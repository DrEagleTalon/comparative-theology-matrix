    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:741",
    "ayah_text" : "لَوۡلَا يَنۡهَىٰهُمُ ٱلرَّبَّٰنِيُّونَ وَٱلۡأَحۡبَارُ عَن قَوۡلِهِمُ ٱلۡإِثۡمَ وَأَكۡلِهِمُ ٱلسُّحۡتَۚ لَبِئۡسَ مَا كَانُواْ يَصۡنَعُونَ",
    "ayah_text_no_diacratic" : "لولا ينهىٰهم الربٰنيون والاحبار عن قولهم الاثم واكلهم السحت لبئس ما كانوا يصنعون",
    "ayahnumber" : "63",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "741",
