    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2913",
    "ayah_text" : "تَبَارَكَ ٱلَّذِيٓ إِن شَآءَ جَعَلَ لَكَ خَيۡرٗا مِّن ذَٰلِكَ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ وَيَجۡعَل لَّكَ قُصُورَۢا",
    "ayah_text_no_diacratic" : "تبارك الذي ان شاء جعل لك خيرا من ذٰلك جنٰت تجري من تحتها الانهٰر ويجعل لك قصورا",
    "ayahnumber" : "10",
    "chapter" : "18",
    "hizb" : "36",
