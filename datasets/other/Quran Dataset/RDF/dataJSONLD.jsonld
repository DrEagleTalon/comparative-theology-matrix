  }, {
    "@id" : "quran:2388",
    "ayah_text" : "مَآ أَنزَلۡنَا عَلَيۡكَ ٱلۡقُرۡءَانَ لِتَشۡقَىٰٓ",
    "ayah_text_no_diacratic" : "ما انزلنا عليك القرءان لتشقىٰ",
    "ayahnumber" : "2",
