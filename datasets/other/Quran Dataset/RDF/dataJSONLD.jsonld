    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:150",
    "ayah_text" : "أَمۡ تَقُولُونَ إِنَّ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ وَيَعۡقُوبَ وَٱلۡأَسۡبَاطَ كَانُواْ هُودًا أَوۡ نَصَٰرَىٰۗ قُلۡ ءَأَنتُمۡ أَعۡلَمُ أَمِ ٱللَّهُۗ وَمَنۡ أَظۡلَمُ مِمَّن كَتَمَ شَهَٰدَةً عِندَهُۥ مِنَ ٱللَّهِۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ام تقولون ان ابرٰهم واسمٰعيل واسحٰق ويعقوب والاسباط كانوا هودا او نصٰرىٰ قل ءانتم اعلم ام الله ومن اظلم ممن كتم شهٰدة عنده من الله وما الله بغٰفل عما تعملون",
    "ayahnumber" : "140",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "150",
    "page" : "21",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1500",
    "ayah_text" : "وَهُوَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامٖ وَكَانَ عَرۡشُهُۥ عَلَى ٱلۡمَآءِ لِيَبۡلُوَكُمۡ أَيُّكُمۡ أَحۡسَنُ عَمَلٗاۗ وَلَئِن قُلۡتَ إِنَّكُم مَّبۡعُوثُونَ مِنۢ بَعۡدِ ٱلۡمَوۡتِ لَيَقُولَنَّ ٱلَّذِينَ كَفَرُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "وهو الذي خلق السمٰوٰت والارض في ستة ايام وكان عرشه على الماء ليبلوكم ايكم احسن عملا ولئن قلت انكم مبعوثون من بعد الموت ليقولن الذين كفروا ان هٰذا الا سحر مبين",
    "ayahnumber" : "7",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1500",
    "page" : "222",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1501",
    "ayah_text" : "وَلَئِنۡ أَخَّرۡنَا عَنۡهُمُ ٱلۡعَذَابَ إِلَىٰٓ أُمَّةٖ مَّعۡدُودَةٖ لَّيَقُولُنَّ مَا يَحۡبِسُهُۥٓۗ أَلَا يَوۡمَ يَأۡتِيهِمۡ لَيۡسَ مَصۡرُوفًا عَنۡهُمۡ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "ولئن اخرنا عنهم العذاب الىٰ امة معدودة ليقولن ما يحبسه الا يوم ياتيهم ليس مصروفا عنهم وحاق بهم ما كانوا به يستهزءون",
    "ayahnumber" : "8",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1501",
    "page" : "222",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1502",
    "ayah_text" : "وَلَئِنۡ أَذَقۡنَا ٱلۡإِنسَٰنَ مِنَّا رَحۡمَةٗ ثُمَّ نَزَعۡنَٰهَا مِنۡهُ إِنَّهُۥ لَيَـُٔوسٞ كَفُورٞ",
    "ayah_text_no_diacratic" : "ولئن اذقنا الانسٰن منا رحمة ثم نزعنٰها منه انه ليوس كفور",
    "ayahnumber" : "9",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1502",
    "page" : "222",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1503",
    "ayah_text" : "وَلَئِنۡ أَذَقۡنَٰهُ نَعۡمَآءَ بَعۡدَ ضَرَّآءَ مَسَّتۡهُ لَيَقُولَنَّ ذَهَبَ ٱلسَّيِّـَٔاتُ عَنِّيٓۚ إِنَّهُۥ لَفَرِحٞ فَخُورٌ",
    "ayah_text_no_diacratic" : "ولئن اذقنٰه نعماء بعد ضراء مسته ليقولن ذهب السيات عني انه لفرح فخور",
    "ayahnumber" : "10",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1503",
    "page" : "222",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1504",
    "ayah_text" : "إِلَّا ٱلَّذِينَ صَبَرُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ أُوْلَٰٓئِكَ لَهُم مَّغۡفِرَةٞ وَأَجۡرٞ كَبِيرٞ",
    "ayah_text_no_diacratic" : "الا الذين صبروا وعملوا الصٰلحٰت اولٰئك لهم مغفرة واجر كبير",
    "ayahnumber" : "11",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1504",
    "page" : "222",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1505",
    "ayah_text" : "فَلَعَلَّكَ تَارِكُۢ بَعۡضَ مَا يُوحَىٰٓ إِلَيۡكَ وَضَآئِقُۢ بِهِۦ صَدۡرُكَ أَن يَقُولُواْ لَوۡلَآ أُنزِلَ عَلَيۡهِ كَنزٌ أَوۡ جَآءَ مَعَهُۥ مَلَكٌۚ إِنَّمَآ أَنتَ نَذِيرٞۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ وَكِيلٌ",
    "ayah_text_no_diacratic" : "فلعلك تارك بعض ما يوحىٰ اليك وضائق به صدرك ان يقولوا لولا انزل عليه كنز او جاء معه ملك انما انت نذير والله علىٰ كل شيء وكيل",
    "ayahnumber" : "12",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1505",
    "page" : "222",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1506",
    "ayah_text" : "أَمۡ يَقُولُونَ ٱفۡتَرَىٰهُۖ قُلۡ فَأۡتُواْ بِعَشۡرِ سُوَرٖ مِّثۡلِهِۦ مُفۡتَرَيَٰتٖ وَٱدۡعُواْ مَنِ ٱسۡتَطَعۡتُم مِّن دُونِ ٱللَّهِ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ام يقولون افترىٰه قل فاتوا بعشر سور مثله مفتريٰت وادعوا من استطعتم من دون الله ان كنتم صٰدقين",
    "ayahnumber" : "13",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1506",
    "page" : "223",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1507",
    "ayah_text" : "فَإِلَّمۡ يَسۡتَجِيبُواْ لَكُمۡ فَٱعۡلَمُوٓاْ أَنَّمَآ أُنزِلَ بِعِلۡمِ ٱللَّهِ وَأَن لَّآ إِلَٰهَ إِلَّا هُوَۖ فَهَلۡ أَنتُم مُّسۡلِمُونَ",
    "ayah_text_no_diacratic" : "فالم يستجيبوا لكم فاعلموا انما انزل بعلم الله وان لا الٰه الا هو فهل انتم مسلمون",
    "ayahnumber" : "14",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1507",
    "page" : "223",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1508",
    "ayah_text" : "مَن كَانَ يُرِيدُ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا وَزِينَتَهَا نُوَفِّ إِلَيۡهِمۡ أَعۡمَٰلَهُمۡ فِيهَا وَهُمۡ فِيهَا لَا يُبۡخَسُونَ",
    "ayah_text_no_diacratic" : "من كان يريد الحيوٰة الدنيا وزينتها نوف اليهم اعمٰلهم فيها وهم فيها لا يبخسون",
    "ayahnumber" : "15",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1508",
    "page" : "223",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1509",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ لَيۡسَ لَهُمۡ فِي ٱلۡأٓخِرَةِ إِلَّا ٱلنَّارُۖ وَحَبِطَ مَا صَنَعُواْ فِيهَا وَبَٰطِلٞ مَّا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "اولٰئك الذين ليس لهم في الاخرة الا النار وحبط ما صنعوا فيها وبٰطل ما كانوا يعملون",
    "ayahnumber" : "16",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1509",
    "page" : "223",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:151",
    "ayah_text" : "تِلۡكَ أُمَّةٞ قَدۡ خَلَتۡۖ لَهَا مَا كَسَبَتۡ وَلَكُم مَّا كَسَبۡتُمۡۖ وَلَا تُسۡـَٔلُونَ عَمَّا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "تلك امة قد خلت لها ما كسبت ولكم ما كسبتم ولا تسلون عما كانوا يعملون",
    "ayahnumber" : "141",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "151",
    "page" : "21",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1510",
    "ayah_text" : "أَفَمَن كَانَ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّهِۦ وَيَتۡلُوهُ شَاهِدٞ مِّنۡهُ وَمِن قَبۡلِهِۦ كِتَٰبُ مُوسَىٰٓ إِمَامٗا وَرَحۡمَةًۚ أُوْلَٰٓئِكَ يُؤۡمِنُونَ بِهِۦۚ وَمَن يَكۡفُرۡ بِهِۦ مِنَ ٱلۡأَحۡزَابِ فَٱلنَّارُ مَوۡعِدُهُۥۚ فَلَا تَكُ فِي مِرۡيَةٖ مِّنۡهُۚ إِنَّهُ ٱلۡحَقُّ مِن رَّبِّكَ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "افمن كان علىٰ بينة من ربه ويتلوه شاهد منه ومن قبله كتٰب موسىٰ اماما ورحمة اولٰئك يؤمنون به ومن يكفر به من الاحزاب فالنار موعده فلا تك في مرية منه انه الحق من ربك ولٰكن اكثر الناس لا يؤمنون",
    "ayahnumber" : "17",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1510",
    "page" : "223",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1511",
    "ayah_text" : "وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًاۚ أُوْلَٰٓئِكَ يُعۡرَضُونَ عَلَىٰ رَبِّهِمۡ وَيَقُولُ ٱلۡأَشۡهَٰدُ هَٰٓؤُلَآءِ ٱلَّذِينَ كَذَبُواْ عَلَىٰ رَبِّهِمۡۚ أَلَا لَعۡنَةُ ٱللَّهِ عَلَى ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ومن اظلم ممن افترىٰ على الله كذبا اولٰئك يعرضون علىٰ ربهم ويقول الاشهٰد هٰؤلاء الذين كذبوا علىٰ ربهم الا لعنة الله على الظٰلمين",
    "ayahnumber" : "18",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1511",
    "page" : "223",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1512",
    "ayah_text" : "ٱلَّذِينَ يَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَيَبۡغُونَهَا عِوَجٗا وَهُم بِٱلۡأٓخِرَةِ هُمۡ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "الذين يصدون عن سبيل الله ويبغونها عوجا وهم بالاخرة هم كٰفرون",
    "ayahnumber" : "19",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1512",
    "page" : "223",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1513",
    "ayah_text" : "أُوْلَٰٓئِكَ لَمۡ يَكُونُواْ مُعۡجِزِينَ فِي ٱلۡأَرۡضِ وَمَا كَانَ لَهُم مِّن دُونِ ٱللَّهِ مِنۡ أَوۡلِيَآءَۘ يُضَٰعَفُ لَهُمُ ٱلۡعَذَابُۚ مَا كَانُواْ يَسۡتَطِيعُونَ ٱلسَّمۡعَ وَمَا كَانُواْ يُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "اولٰئك لم يكونوا معجزين في الارض وما كان لهم من دون الله من اولياء يضٰعف لهم العذاب ما كانوا يستطيعون السمع وما كانوا يبصرون",
    "ayahnumber" : "20",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1513",
    "page" : "224",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1514",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ وَضَلَّ عَنۡهُم مَّا كَانُواْ يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "اولٰئك الذين خسروا انفسهم وضل عنهم ما كانوا يفترون",
    "ayahnumber" : "21",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1514",
    "page" : "224",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1515",
    "ayah_text" : "لَا جَرَمَ أَنَّهُمۡ فِي ٱلۡأٓخِرَةِ هُمُ ٱلۡأَخۡسَرُونَ",
    "ayah_text_no_diacratic" : "لا جرم انهم في الاخرة هم الاخسرون",
    "ayahnumber" : "22",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1515",
