    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2035",
    "ayah_text" : "إِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِـَٔايَٰتِ ٱللَّهِ لَا يَهۡدِيهِمُ ٱللَّهُ وَلَهُمۡ عَذَابٌ أَلِيمٌ",
    "ayah_text_no_diacratic" : "ان الذين لا يؤمنون بايٰت الله لا يهديهم الله ولهم عذاب اليم",
