    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3935",
    "ayah_text" : "وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ",
    "ayah_text_no_diacratic" : "ولقد نادىٰنا نوح فلنعم المجيبون",
