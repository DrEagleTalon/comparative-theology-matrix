    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1986",
    "ayah_text" : "لِيَكۡفُرُواْ بِمَآ ءَاتَيۡنَٰهُمۡۚ فَتَمَتَّعُواْ فَسَوۡفَ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ليكفروا بما ءاتينٰهم فتمتعوا فسوف تعلمون",
    "ayahnumber" : "55",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1986",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1987",
    "ayah_text" : "وَيَجۡعَلُونَ لِمَا لَا يَعۡلَمُونَ نَصِيبٗا مِّمَّا رَزَقۡنَٰهُمۡۗ تَٱللَّهِ لَتُسۡـَٔلُنَّ عَمَّا كُنتُمۡ تَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "ويجعلون لما لا يعلمون نصيبا مما رزقنٰهم تالله لتسلن عما كنتم تفترون",
    "ayahnumber" : "56",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1987",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1988",
    "ayah_text" : "وَيَجۡعَلُونَ لِلَّهِ ٱلۡبَنَٰتِ سُبۡحَٰنَهُۥ وَلَهُم مَّا يَشۡتَهُونَ",
    "ayah_text_no_diacratic" : "ويجعلون لله البنٰت سبحٰنه ولهم ما يشتهون",
    "ayahnumber" : "57",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1988",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1989",
    "ayah_text" : "وَإِذَا بُشِّرَ أَحَدُهُم بِٱلۡأُنثَىٰ ظَلَّ وَجۡهُهُۥ مُسۡوَدّٗا وَهُوَ كَظِيمٞ",
    "ayah_text_no_diacratic" : "واذا بشر احدهم بالانثىٰ ظل وجهه مسودا وهو كظيم",
    "ayahnumber" : "58",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1989",
