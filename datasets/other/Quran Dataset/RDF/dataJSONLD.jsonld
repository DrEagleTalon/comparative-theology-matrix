    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5442",
    "ayah_text" : "أَمۡ لَكُمۡ كِتَٰبٞ فِيهِ تَدۡرُسُونَ",
    "ayah_text_no_diacratic" : "ام لكم كتٰب فيه تدرسون",
