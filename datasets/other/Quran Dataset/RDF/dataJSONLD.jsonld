    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2761",
    "ayah_text" : "ثُمَّ أَرۡسَلۡنَا رُسُلَنَا تَتۡرَاۖ كُلَّ مَا جَآءَ أُمَّةٗ رَّسُولُهَا كَذَّبُوهُۖ فَأَتۡبَعۡنَا بَعۡضَهُم بَعۡضٗا وَجَعَلۡنَٰهُمۡ أَحَادِيثَۚ فَبُعۡدٗا لِّقَوۡمٖ لَّا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "ثم ارسلنا رسلنا تترا كل ما جاء امة رسولها كذبوه فاتبعنا بعضهم بعضا وجعلنٰهم احاديث فبعدا لقوم لا يؤمنون",
    "ayahnumber" : "44",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2761",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2762",
    "ayah_text" : "ثُمَّ أَرۡسَلۡنَا مُوسَىٰ وَأَخَاهُ هَٰرُونَ بِـَٔايَٰتِنَا وَسُلۡطَٰنٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "ثم ارسلنا موسىٰ واخاه هٰرون بايٰتنا وسلطٰن مبين",
    "ayahnumber" : "45",
    "chapter" : "18",
    "hizb" : "34",
