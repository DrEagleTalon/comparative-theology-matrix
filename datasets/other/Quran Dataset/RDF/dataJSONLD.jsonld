    "surrahname_no_diacratic" : "سورة النازعات"
  }, {
    "@id" : "quran:59",
    "ayah_text" : "وَإِذۡ نَجَّيۡنَٰكُم مِّنۡ ءَالِ فِرۡعَوۡنَ يَسُومُونَكُمۡ سُوٓءَ ٱلۡعَذَابِ يُذَبِّحُونَ أَبۡنَآءَكُمۡ وَيَسۡتَحۡيُونَ نِسَآءَكُمۡۚ وَفِي ذَٰلِكُم بَلَآءٞ مِّن رَّبِّكُمۡ عَظِيمٞ",
    "ayah_text_no_diacratic" : "واذ نجينٰكم من ءال فرعون يسومونكم سوء العذاب يذبحون ابناءكم ويستحيون نساءكم وفي ذٰلكم بلاء من ربكم عظيم",
    "ayahnumber" : "49",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "59",
    "page" : "8",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:590",
    "ayah_text" : "إِلَّا ٱلَّذِينَ يَصِلُونَ إِلَىٰ قَوۡمِۭ بَيۡنَكُمۡ وَبَيۡنَهُم مِّيثَٰقٌ أَوۡ جَآءُوكُمۡ حَصِرَتۡ صُدُورُهُمۡ أَن يُقَٰتِلُوكُمۡ أَوۡ يُقَٰتِلُواْ قَوۡمَهُمۡۚ وَلَوۡ شَآءَ ٱللَّهُ لَسَلَّطَهُمۡ عَلَيۡكُمۡ فَلَقَٰتَلُوكُمۡۚ فَإِنِ ٱعۡتَزَلُوكُمۡ فَلَمۡ يُقَٰتِلُوكُمۡ وَأَلۡقَوۡاْ إِلَيۡكُمُ ٱلسَّلَمَ فَمَا جَعَلَ ٱللَّهُ لَكُمۡ عَلَيۡهِمۡ سَبِيلٗا",
    "ayah_text_no_diacratic" : "الا الذين يصلون الىٰ قوم بينكم وبينهم ميثٰق او جاءوكم حصرت صدورهم ان يقٰتلوكم او يقٰتلوا قومهم ولو شاء الله لسلطهم عليكم فلقٰتلوكم فان اعتزلوكم فلم يقٰتلوكم والقوا اليكم السلم فما جعل الله لكم عليهم سبيلا",
    "ayahnumber" : "90",
    "chapter" : "5",
    "hizb" : "9",
    "index" : "590",
    "page" : "92",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
