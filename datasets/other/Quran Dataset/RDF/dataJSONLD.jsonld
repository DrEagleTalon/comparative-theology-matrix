  }, {
    "@id" : "quran:2806",
    "ayah_text" : "سَيَقُولُونَ لِلَّهِۚ قُلۡ فَأَنَّىٰ تُسۡحَرُونَ",
    "ayah_text_no_diacratic" : "سيقولون لله قل فانىٰ تسحرون",
