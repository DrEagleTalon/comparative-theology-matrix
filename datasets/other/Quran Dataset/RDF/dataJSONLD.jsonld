  }, {
    "@id" : "quran:1792",
    "ayah_text" : "مِّن وَرَآئِهِۦ جَهَنَّمُ وَيُسۡقَىٰ مِن مَّآءٖ صَدِيدٖ",
    "ayah_text_no_diacratic" : "من ورائه جهنم ويسقىٰ من ماء صديد",
