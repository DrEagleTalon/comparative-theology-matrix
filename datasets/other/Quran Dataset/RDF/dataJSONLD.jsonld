    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:402",
    "ayah_text" : "وَلۡتَكُن مِّنكُمۡ أُمَّةٞ يَدۡعُونَ إِلَى ٱلۡخَيۡرِ وَيَأۡمُرُونَ بِٱلۡمَعۡرُوفِ وَيَنۡهَوۡنَ عَنِ ٱلۡمُنكَرِۚ وَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "ولتكن منكم امة يدعون الى الخير ويامرون بالمعروف وينهون عن المنكر واولٰئك هم المفلحون",
    "ayahnumber" : "104",
    "chapter" : "4",
    "hizb" : "6",
