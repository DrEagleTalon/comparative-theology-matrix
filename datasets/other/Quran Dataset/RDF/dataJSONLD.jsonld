    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4154",
    "ayah_text" : "لَٰكِنِ ٱلَّذِينَ ٱتَّقَوۡاْ رَبَّهُمۡ لَهُمۡ غُرَفٞ مِّن فَوۡقِهَا غُرَفٞ مَّبۡنِيَّةٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ وَعۡدَ ٱللَّهِ لَا يُخۡلِفُ ٱللَّهُ ٱلۡمِيعَادَ",
    "ayah_text_no_diacratic" : "لٰكن الذين اتقوا ربهم لهم غرف من فوقها غرف مبنية تجري من تحتها الانهٰر وعد الله لا يخلف الله الميعاد",
    "ayahnumber" : "20",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4154",
    "page" : "460",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4155",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱللَّهَ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَسَلَكَهُۥ يَنَٰبِيعَ فِي ٱلۡأَرۡضِ ثُمَّ يُخۡرِجُ بِهِۦ زَرۡعٗا مُّخۡتَلِفًا أَلۡوَٰنُهُۥ ثُمَّ يَهِيجُ فَتَرَىٰهُ مُصۡفَرّٗا ثُمَّ يَجۡعَلُهُۥ حُطَٰمًاۚ إِنَّ فِي ذَٰلِكَ لَذِكۡرَىٰ لِأُوْلِي ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "الم تر ان الله انزل من السماء ماء فسلكه ينٰبيع في الارض ثم يخرج به زرعا مختلفا الوٰنه ثم يهيج فترىٰه مصفرا ثم يجعله حطٰما ان في ذٰلك لذكرىٰ لاولي الالبٰب",
    "ayahnumber" : "21",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4155",
    "page" : "460",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4156",
    "ayah_text" : "أَفَمَن شَرَحَ ٱللَّهُ صَدۡرَهُۥ لِلۡإِسۡلَٰمِ فَهُوَ عَلَىٰ نُورٖ مِّن رَّبِّهِۦۚ فَوَيۡلٞ لِّلۡقَٰسِيَةِ قُلُوبُهُم مِّن ذِكۡرِ ٱللَّهِۚ أُوْلَٰٓئِكَ فِي ضَلَٰلٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "افمن شرح الله صدره للاسلٰم فهو علىٰ نور من ربه فويل للقٰسية قلوبهم من ذكر الله اولٰئك في ضلٰل مبين",
    "ayahnumber" : "22",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4156",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4157",
    "ayah_text" : "ٱللَّهُ نَزَّلَ أَحۡسَنَ ٱلۡحَدِيثِ كِتَٰبٗا مُّتَشَٰبِهٗا مَّثَانِيَ تَقۡشَعِرُّ مِنۡهُ جُلُودُ ٱلَّذِينَ يَخۡشَوۡنَ رَبَّهُمۡ ثُمَّ تَلِينُ جُلُودُهُمۡ وَقُلُوبُهُمۡ إِلَىٰ ذِكۡرِ ٱللَّهِۚ ذَٰلِكَ هُدَى ٱللَّهِ يَهۡدِي بِهِۦ مَن يَشَآءُۚ وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِنۡ هَادٍ",
    "ayah_text_no_diacratic" : "الله نزل احسن الحديث كتٰبا متشٰبها مثاني تقشعر منه جلود الذين يخشون ربهم ثم تلين جلودهم وقلوبهم الىٰ ذكر الله ذٰلك هدى الله يهدي به من يشاء ومن يضلل الله فما له من هاد",
    "ayahnumber" : "23",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4157",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4158",
    "ayah_text" : "أَفَمَن يَتَّقِي بِوَجۡهِهِۦ سُوٓءَ ٱلۡعَذَابِ يَوۡمَ ٱلۡقِيَٰمَةِۚ وَقِيلَ لِلظَّٰلِمِينَ ذُوقُواْ مَا كُنتُمۡ تَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "افمن يتقي بوجهه سوء العذاب يوم القيٰمة وقيل للظٰلمين ذوقوا ما كنتم تكسبون",
    "ayahnumber" : "24",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4158",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4159",
    "ayah_text" : "كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَأَتَىٰهُمُ ٱلۡعَذَابُ مِنۡ حَيۡثُ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "كذب الذين من قبلهم فاتىٰهم العذاب من حيث لا يشعرون",
    "ayahnumber" : "25",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4159",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:416",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّخِذُواْ بِطَانَةٗ مِّن دُونِكُمۡ لَا يَأۡلُونَكُمۡ خَبَالٗا وَدُّواْ مَا عَنِتُّمۡ قَدۡ بَدَتِ ٱلۡبَغۡضَآءُ مِنۡ أَفۡوَٰهِهِمۡ وَمَا تُخۡفِي صُدُورُهُمۡ أَكۡبَرُۚ قَدۡ بَيَّنَّا لَكُمُ ٱلۡأٓيَٰتِۖ إِن كُنتُمۡ تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تتخذوا بطانة من دونكم لا يالونكم خبالا ودوا ما عنتم قد بدت البغضاء من افوٰههم وما تخفي صدورهم اكبر قد بينا لكم الايٰت ان كنتم تعقلون",
    "ayahnumber" : "118",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "416",
    "page" : "65",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4160",
    "ayah_text" : "فَأَذَاقَهُمُ ٱللَّهُ ٱلۡخِزۡيَ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَكۡبَرُۚ لَوۡ كَانُواْ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فاذاقهم الله الخزي في الحيوٰة الدنيا ولعذاب الاخرة اكبر لو كانوا يعلمون",
    "ayahnumber" : "26",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4160",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4161",
    "ayah_text" : "وَلَقَدۡ ضَرَبۡنَا لِلنَّاسِ فِي هَٰذَا ٱلۡقُرۡءَانِ مِن كُلِّ مَثَلٖ لَّعَلَّهُمۡ يَتَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "ولقد ضربنا للناس في هٰذا القرءان من كل مثل لعلهم يتذكرون",
    "ayahnumber" : "27",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4161",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4162",
    "ayah_text" : "قُرۡءَانًا عَرَبِيًّا غَيۡرَ ذِي عِوَجٖ لَّعَلَّهُمۡ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "قرءانا عربيا غير ذي عوج لعلهم يتقون",
    "ayahnumber" : "28",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4162",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4163",
    "ayah_text" : "ضَرَبَ ٱللَّهُ مَثَلٗا رَّجُلٗا فِيهِ شُرَكَآءُ مُتَشَٰكِسُونَ وَرَجُلٗا سَلَمٗا لِّرَجُلٍ هَلۡ يَسۡتَوِيَانِ مَثَلًاۚ ٱلۡحَمۡدُ لِلَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ضرب الله مثلا رجلا فيه شركاء متشٰكسون ورجلا سلما لرجل هل يستويان مثلا الحمد لله بل اكثرهم لا يعلمون",
    "ayahnumber" : "29",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4163",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4164",
    "ayah_text" : "إِنَّكَ مَيِّتٞ وَإِنَّهُم مَّيِّتُونَ",
    "ayah_text_no_diacratic" : "انك ميت وانهم ميتون",
    "ayahnumber" : "30",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4164",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4165",
    "ayah_text" : "ثُمَّ إِنَّكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ عِندَ رَبِّكُمۡ تَخۡتَصِمُونَ",
    "ayah_text_no_diacratic" : "ثم انكم يوم القيٰمة عند ربكم تختصمون",
    "ayahnumber" : "31",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4165",
    "page" : "461",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4166",
    "ayah_text" : "۞فَمَنۡ أَظۡلَمُ مِمَّن كَذَبَ عَلَى ٱللَّهِ وَكَذَّبَ بِٱلصِّدۡقِ إِذۡ جَآءَهُۥٓۚ أَلَيۡسَ فِي جَهَنَّمَ مَثۡوٗى لِّلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "فمن اظلم ممن كذب على الله وكذب بالصدق اذ جاءه اليس في جهنم مثوى للكٰفرين",
    "ayahnumber" : "32",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4166",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4167",
    "ayah_text" : "وَٱلَّذِي جَآءَ بِٱلصِّدۡقِ وَصَدَّقَ بِهِۦٓ أُوْلَٰٓئِكَ هُمُ ٱلۡمُتَّقُونَ",
    "ayah_text_no_diacratic" : "والذي جاء بالصدق وصدق به اولٰئك هم المتقون",
    "ayahnumber" : "33",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4167",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4168",
    "ayah_text" : "لَهُم مَّا يَشَآءُونَ عِندَ رَبِّهِمۡۚ ذَٰلِكَ جَزَآءُ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "لهم ما يشاءون عند ربهم ذٰلك جزاء المحسنين",
    "ayahnumber" : "34",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4168",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4169",
    "ayah_text" : "لِيُكَفِّرَ ٱللَّهُ عَنۡهُمۡ أَسۡوَأَ ٱلَّذِي عَمِلُواْ وَيَجۡزِيَهُمۡ أَجۡرَهُم بِأَحۡسَنِ ٱلَّذِي كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ليكفر الله عنهم اسوا الذي عملوا ويجزيهم اجرهم باحسن الذي كانوا يعملون",
    "ayahnumber" : "35",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4169",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:417",
    "ayah_text" : "هَٰٓأَنتُمۡ أُوْلَآءِ تُحِبُّونَهُمۡ وَلَا يُحِبُّونَكُمۡ وَتُؤۡمِنُونَ بِٱلۡكِتَٰبِ كُلِّهِۦ وَإِذَا لَقُوكُمۡ قَالُوٓاْ ءَامَنَّا وَإِذَا خَلَوۡاْ عَضُّواْ عَلَيۡكُمُ ٱلۡأَنَامِلَ مِنَ ٱلۡغَيۡظِۚ قُلۡ مُوتُواْ بِغَيۡظِكُمۡۗ إِنَّ ٱللَّهَ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "هٰانتم اولاء تحبونهم ولا يحبونكم وتؤمنون بالكتٰب كله واذا لقوكم قالوا ءامنا واذا خلوا عضوا عليكم الانامل من الغيظ قل موتوا بغيظكم ان الله عليم بذات الصدور",
    "ayahnumber" : "119",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "417",
    "page" : "65",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4170",
    "ayah_text" : "أَلَيۡسَ ٱللَّهُ بِكَافٍ عَبۡدَهُۥۖ وَيُخَوِّفُونَكَ بِٱلَّذِينَ مِن دُونِهِۦۚ وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِنۡ هَادٖ",
    "ayah_text_no_diacratic" : "اليس الله بكاف عبده ويخوفونك بالذين من دونه ومن يضلل الله فما له من هاد",
    "ayahnumber" : "36",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4170",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4171",
    "ayah_text" : "وَمَن يَهۡدِ ٱللَّهُ فَمَا لَهُۥ مِن مُّضِلٍّۗ أَلَيۡسَ ٱللَّهُ بِعَزِيزٖ ذِي ٱنتِقَامٖ",
    "ayah_text_no_diacratic" : "ومن يهد الله فما له من مضل اليس الله بعزيز ذي انتقام",
    "ayahnumber" : "37",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4171",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4172",
    "ayah_text" : "وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ لَيَقُولُنَّ ٱللَّهُۚ قُلۡ أَفَرَءَيۡتُم مَّا تَدۡعُونَ مِن دُونِ ٱللَّهِ إِنۡ أَرَادَنِيَ ٱللَّهُ بِضُرٍّ هَلۡ هُنَّ كَٰشِفَٰتُ ضُرِّهِۦٓ أَوۡ أَرَادَنِي بِرَحۡمَةٍ هَلۡ هُنَّ مُمۡسِكَٰتُ رَحۡمَتِهِۦۚ قُلۡ حَسۡبِيَ ٱللَّهُۖ عَلَيۡهِ يَتَوَكَّلُ ٱلۡمُتَوَكِّلُونَ",
    "ayah_text_no_diacratic" : "ولئن سالتهم من خلق السمٰوٰت والارض ليقولن الله قل افرءيتم ما تدعون من دون الله ان ارادني الله بضر هل هن كٰشفٰت ضره او ارادني برحمة هل هن ممسكٰت رحمته قل حسبي الله عليه يتوكل المتوكلون",
    "ayahnumber" : "38",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4172",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4173",
    "ayah_text" : "قُلۡ يَٰقَوۡمِ ٱعۡمَلُواْ عَلَىٰ مَكَانَتِكُمۡ إِنِّي عَٰمِلٞۖ فَسَوۡفَ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قل يٰقوم اعملوا علىٰ مكانتكم اني عٰمل فسوف تعلمون",
    "ayahnumber" : "39",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4173",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4174",
    "ayah_text" : "مَن يَأۡتِيهِ عَذَابٞ يُخۡزِيهِ وَيَحِلُّ عَلَيۡهِ عَذَابٞ مُّقِيمٌ",
    "ayah_text_no_diacratic" : "من ياتيه عذاب يخزيه ويحل عليه عذاب مقيم",
    "ayahnumber" : "40",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4174",
    "page" : "462",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4175",
    "ayah_text" : "إِنَّآ أَنزَلۡنَا عَلَيۡكَ ٱلۡكِتَٰبَ لِلنَّاسِ بِٱلۡحَقِّۖ فَمَنِ ٱهۡتَدَىٰ فَلِنَفۡسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيۡهَاۖ وَمَآ أَنتَ عَلَيۡهِم بِوَكِيلٍ",
    "ayah_text_no_diacratic" : "انا انزلنا عليك الكتٰب للناس بالحق فمن اهتدىٰ فلنفسه ومن ضل فانما يضل عليها وما انت عليهم بوكيل",
    "ayahnumber" : "41",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4175",
    "page" : "463",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4176",
    "ayah_text" : "ٱللَّهُ يَتَوَفَّى ٱلۡأَنفُسَ حِينَ مَوۡتِهَا وَٱلَّتِي لَمۡ تَمُتۡ فِي مَنَامِهَاۖ فَيُمۡسِكُ ٱلَّتِي قَضَىٰ عَلَيۡهَا ٱلۡمَوۡتَ وَيُرۡسِلُ ٱلۡأُخۡرَىٰٓ إِلَىٰٓ أَجَلٖ مُّسَمًّىۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "الله يتوفى الانفس حين موتها والتي لم تمت في منامها فيمسك التي قضىٰ عليها الموت ويرسل الاخرىٰ الىٰ اجل مسمى ان في ذٰلك لايٰت لقوم يتفكرون",
    "ayahnumber" : "42",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4176",
    "page" : "463",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4177",
    "ayah_text" : "أَمِ ٱتَّخَذُواْ مِن دُونِ ٱللَّهِ شُفَعَآءَۚ قُلۡ أَوَلَوۡ كَانُواْ لَا يَمۡلِكُونَ شَيۡـٔٗا وَلَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ام اتخذوا من دون الله شفعاء قل اولو كانوا لا يملكون شيا ولا يعقلون",
    "ayahnumber" : "43",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4177",
    "page" : "463",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4178",
    "ayah_text" : "قُل لِّلَّهِ ٱلشَّفَٰعَةُ جَمِيعٗاۖ لَّهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ ثُمَّ إِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "قل لله الشفٰعة جميعا له ملك السمٰوٰت والارض ثم اليه ترجعون",
    "ayahnumber" : "44",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4178",
    "page" : "463",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4179",
    "ayah_text" : "وَإِذَا ذُكِرَ ٱللَّهُ وَحۡدَهُ ٱشۡمَأَزَّتۡ قُلُوبُ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِۖ وَإِذَا ذُكِرَ ٱلَّذِينَ مِن دُونِهِۦٓ إِذَا هُمۡ يَسۡتَبۡشِرُونَ",
    "ayah_text_no_diacratic" : "واذا ذكر الله وحده اشمازت قلوب الذين لا يؤمنون بالاخرة واذا ذكر الذين من دونه اذا هم يستبشرون",
    "ayahnumber" : "45",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4179",
    "page" : "463",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:418",
    "ayah_text" : "إِن تَمۡسَسۡكُمۡ حَسَنَةٞ تَسُؤۡهُمۡ وَإِن تُصِبۡكُمۡ سَيِّئَةٞ يَفۡرَحُواْ بِهَاۖ وَإِن تَصۡبِرُواْ وَتَتَّقُواْ لَا يَضُرُّكُمۡ كَيۡدُهُمۡ شَيۡـًٔاۗ إِنَّ ٱللَّهَ بِمَا يَعۡمَلُونَ مُحِيطٞ",
    "ayah_text_no_diacratic" : "ان تمسسكم حسنة تسؤهم وان تصبكم سيئة يفرحوا بها وان تصبروا وتتقوا لا يضركم كيدهم شيا ان الله بما يعملون محيط",
    "ayahnumber" : "120",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "418",
    "page" : "65",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4180",
    "ayah_text" : "قُلِ ٱللَّهُمَّ فَاطِرَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ عَٰلِمَ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ أَنتَ تَحۡكُمُ بَيۡنَ عِبَادِكَ فِي مَا كَانُواْ فِيهِ يَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "قل اللهم فاطر السمٰوٰت والارض عٰلم الغيب والشهٰدة انت تحكم بين عبادك في ما كانوا فيه يختلفون",
    "ayahnumber" : "46",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4180",
    "page" : "463",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4181",
    "ayah_text" : "وَلَوۡ أَنَّ لِلَّذِينَ ظَلَمُواْ مَا فِي ٱلۡأَرۡضِ جَمِيعٗا وَمِثۡلَهُۥ مَعَهُۥ لَٱفۡتَدَوۡاْ بِهِۦ مِن سُوٓءِ ٱلۡعَذَابِ يَوۡمَ ٱلۡقِيَٰمَةِۚ وَبَدَا لَهُم مِّنَ ٱللَّهِ مَا لَمۡ يَكُونُواْ يَحۡتَسِبُونَ",
    "ayah_text_no_diacratic" : "ولو ان للذين ظلموا ما في الارض جميعا ومثله معه لافتدوا به من سوء العذاب يوم القيٰمة وبدا لهم من الله ما لم يكونوا يحتسبون",
    "ayahnumber" : "47",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4181",
    "page" : "463",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4182",
    "ayah_text" : "وَبَدَا لَهُمۡ سَيِّـَٔاتُ مَا كَسَبُواْ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "وبدا لهم سيات ما كسبوا وحاق بهم ما كانوا به يستهزءون",
    "ayahnumber" : "48",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4182",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4183",
    "ayah_text" : "فَإِذَا مَسَّ ٱلۡإِنسَٰنَ ضُرّٞ دَعَانَا ثُمَّ إِذَا خَوَّلۡنَٰهُ نِعۡمَةٗ مِّنَّا قَالَ إِنَّمَآ أُوتِيتُهُۥ عَلَىٰ عِلۡمِۭۚ بَلۡ هِيَ فِتۡنَةٞ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فاذا مس الانسٰن ضر دعانا ثم اذا خولنٰه نعمة منا قال انما اوتيته علىٰ علم بل هي فتنة ولٰكن اكثرهم لا يعلمون",
    "ayahnumber" : "49",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4183",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4184",
    "ayah_text" : "قَدۡ قَالَهَا ٱلَّذِينَ مِن قَبۡلِهِمۡ فَمَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "قد قالها الذين من قبلهم فما اغنىٰ عنهم ما كانوا يكسبون",
    "ayahnumber" : "50",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4184",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4185",
    "ayah_text" : "فَأَصَابَهُمۡ سَيِّـَٔاتُ مَا كَسَبُواْۚ وَٱلَّذِينَ ظَلَمُواْ مِنۡ هَٰٓؤُلَآءِ سَيُصِيبُهُمۡ سَيِّـَٔاتُ مَا كَسَبُواْ وَمَا هُم بِمُعۡجِزِينَ",
    "ayah_text_no_diacratic" : "فاصابهم سيات ما كسبوا والذين ظلموا من هٰؤلاء سيصيبهم سيات ما كسبوا وما هم بمعجزين",
    "ayahnumber" : "51",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4185",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4186",
    "ayah_text" : "أَوَلَمۡ يَعۡلَمُوٓاْ أَنَّ ٱللَّهَ يَبۡسُطُ ٱلرِّزۡقَ لِمَن يَشَآءُ وَيَقۡدِرُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "اولم يعلموا ان الله يبسط الرزق لمن يشاء ويقدر ان في ذٰلك لايٰت لقوم يؤمنون",
    "ayahnumber" : "52",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4186",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4187",
    "ayah_text" : "۞قُلۡ يَٰعِبَادِيَ ٱلَّذِينَ أَسۡرَفُواْ عَلَىٰٓ أَنفُسِهِمۡ لَا تَقۡنَطُواْ مِن رَّحۡمَةِ ٱللَّهِۚ إِنَّ ٱللَّهَ يَغۡفِرُ ٱلذُّنُوبَ جَمِيعًاۚ إِنَّهُۥ هُوَ ٱلۡغَفُورُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "قل يٰعبادي الذين اسرفوا علىٰ انفسهم لا تقنطوا من رحمة الله ان الله يغفر الذنوب جميعا انه هو الغفور الرحيم",
    "ayahnumber" : "53",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4187",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4188",
    "ayah_text" : "وَأَنِيبُوٓاْ إِلَىٰ رَبِّكُمۡ وَأَسۡلِمُواْ لَهُۥ مِن قَبۡلِ أَن يَأۡتِيَكُمُ ٱلۡعَذَابُ ثُمَّ لَا تُنصَرُونَ",
    "ayah_text_no_diacratic" : "وانيبوا الىٰ ربكم واسلموا له من قبل ان ياتيكم العذاب ثم لا تنصرون",
    "ayahnumber" : "54",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4188",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4189",
    "ayah_text" : "وَٱتَّبِعُوٓاْ أَحۡسَنَ مَآ أُنزِلَ إِلَيۡكُم مِّن رَّبِّكُم مِّن قَبۡلِ أَن يَأۡتِيَكُمُ ٱلۡعَذَابُ بَغۡتَةٗ وَأَنتُمۡ لَا تَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "واتبعوا احسن ما انزل اليكم من ربكم من قبل ان ياتيكم العذاب بغتة وانتم لا تشعرون",
    "ayahnumber" : "55",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4189",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:419",
    "ayah_text" : "وَإِذۡ غَدَوۡتَ مِنۡ أَهۡلِكَ تُبَوِّئُ ٱلۡمُؤۡمِنِينَ مَقَٰعِدَ لِلۡقِتَالِۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ",
    "ayah_text_no_diacratic" : "واذ غدوت من اهلك تبوئ المؤمنين مقٰعد للقتال والله سميع عليم",
    "ayahnumber" : "121",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "419",
    "page" : "65",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4190",
    "ayah_text" : "أَن تَقُولَ نَفۡسٞ يَٰحَسۡرَتَىٰ عَلَىٰ مَا فَرَّطتُ فِي جَنۢبِ ٱللَّهِ وَإِن كُنتُ لَمِنَ ٱلسَّٰخِرِينَ",
    "ayah_text_no_diacratic" : "ان تقول نفس يٰحسرتىٰ علىٰ ما فرطت في جنب الله وان كنت لمن السٰخرين",
    "ayahnumber" : "56",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4190",
    "page" : "464",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4191",
    "ayah_text" : "أَوۡ تَقُولَ لَوۡ أَنَّ ٱللَّهَ هَدَىٰنِي لَكُنتُ مِنَ ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "او تقول لو ان الله هدىٰني لكنت من المتقين",
    "ayahnumber" : "57",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4191",
    "page" : "465",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4192",
    "ayah_text" : "أَوۡ تَقُولَ حِينَ تَرَى ٱلۡعَذَابَ لَوۡ أَنَّ لِي كَرَّةٗ فَأَكُونَ مِنَ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "او تقول حين ترى العذاب لو ان لي كرة فاكون من المحسنين",
    "ayahnumber" : "58",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4192",
    "page" : "465",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4193",
    "ayah_text" : "بَلَىٰ قَدۡ جَآءَتۡكَ ءَايَٰتِي فَكَذَّبۡتَ بِهَا وَٱسۡتَكۡبَرۡتَ وَكُنتَ مِنَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "بلىٰ قد جاءتك ءايٰتي فكذبت بها واستكبرت وكنت من الكٰفرين",
    "ayahnumber" : "59",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4193",
    "page" : "465",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4194",
    "ayah_text" : "وَيَوۡمَ ٱلۡقِيَٰمَةِ تَرَى ٱلَّذِينَ كَذَبُواْ عَلَى ٱللَّهِ وُجُوهُهُم مُّسۡوَدَّةٌۚ أَلَيۡسَ فِي جَهَنَّمَ مَثۡوٗى لِّلۡمُتَكَبِّرِينَ",
    "ayah_text_no_diacratic" : "ويوم القيٰمة ترى الذين كذبوا على الله وجوههم مسودة اليس في جهنم مثوى للمتكبرين",
    "ayahnumber" : "60",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4194",
    "page" : "465",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4195",
    "ayah_text" : "وَيُنَجِّي ٱللَّهُ ٱلَّذِينَ ٱتَّقَوۡاْ بِمَفَازَتِهِمۡ لَا يَمَسُّهُمُ ٱلسُّوٓءُ وَلَا هُمۡ يَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "وينجي الله الذين اتقوا بمفازتهم لا يمسهم السوء ولا هم يحزنون",
    "ayahnumber" : "61",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4195",
    "page" : "465",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4196",
    "ayah_text" : "ٱللَّهُ خَٰلِقُ كُلِّ شَيۡءٖۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ وَكِيلٞ",
    "ayah_text_no_diacratic" : "الله خٰلق كل شيء وهو علىٰ كل شيء وكيل",
    "ayahnumber" : "62",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4196",
    "page" : "465",
    "surahname" : "سُورَةُ الزُّمَرِ",
