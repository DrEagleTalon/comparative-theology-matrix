    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3057",
    "ayah_text" : "قَالَ أَفَرَءَيۡتُم مَّا كُنتُمۡ تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "قال افرءيتم ما كنتم تعبدون",
    "ayahnumber" : "75",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3057",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3058",
    "ayah_text" : "أَنتُمۡ وَءَابَآؤُكُمُ ٱلۡأَقۡدَمُونَ",
    "ayah_text_no_diacratic" : "انتم وءاباؤكم الاقدمون",
    "ayahnumber" : "76",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3058",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3059",
    "ayah_text" : "فَإِنَّهُمۡ عَدُوّٞ لِّيٓ إِلَّا رَبَّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "فانهم عدو لي الا رب العٰلمين",
    "ayahnumber" : "77",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3059",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:306",
    "ayah_text" : "رَبَّنَا لَا تُزِغۡ قُلُوبَنَا بَعۡدَ إِذۡ هَدَيۡتَنَا وَهَبۡ لَنَا مِن لَّدُنكَ رَحۡمَةًۚ إِنَّكَ أَنتَ ٱلۡوَهَّابُ",
    "ayah_text_no_diacratic" : "ربنا لا تزغ قلوبنا بعد اذ هديتنا وهب لنا من لدنك رحمة انك انت الوهاب",
    "ayahnumber" : "8",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "306",
    "page" : "50",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3060",
    "ayah_text" : "ٱلَّذِي خَلَقَنِي فَهُوَ يَهۡدِينِ",
    "ayah_text_no_diacratic" : "الذي خلقني فهو يهدين",
