    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4150",
    "ayah_text" : "لَهُم مِّن فَوۡقِهِمۡ ظُلَلٞ مِّنَ ٱلنَّارِ وَمِن تَحۡتِهِمۡ ظُلَلٞۚ ذَٰلِكَ يُخَوِّفُ ٱللَّهُ بِهِۦ عِبَادَهُۥۚ يَٰعِبَادِ فَٱتَّقُونِ",
    "ayah_text_no_diacratic" : "لهم من فوقهم ظلل من النار ومن تحتهم ظلل ذٰلك يخوف الله به عباده يٰعباد فاتقون",
    "ayahnumber" : "16",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4150",
    "page" : "460",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4151",
    "ayah_text" : "وَٱلَّذِينَ ٱجۡتَنَبُواْ ٱلطَّٰغُوتَ أَن يَعۡبُدُوهَا وَأَنَابُوٓاْ إِلَى ٱللَّهِ لَهُمُ ٱلۡبُشۡرَىٰۚ فَبَشِّرۡ عِبَادِ",
    "ayah_text_no_diacratic" : "والذين اجتنبوا الطٰغوت ان يعبدوها وانابوا الى الله لهم البشرىٰ فبشر عباد",
    "ayahnumber" : "17",
    "chapter" : "23",
    "hizb" : "46",
