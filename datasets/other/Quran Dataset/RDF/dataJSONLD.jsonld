    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4359",
    "ayah_text" : "تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرۡنَ مِن فَوۡقِهِنَّۚ وَٱلۡمَلَٰٓئِكَةُ يُسَبِّحُونَ بِحَمۡدِ رَبِّهِمۡ وَيَسۡتَغۡفِرُونَ لِمَن فِي ٱلۡأَرۡضِۗ أَلَآ إِنَّ ٱللَّهَ هُوَ ٱلۡغَفُورُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "تكاد السمٰوٰت يتفطرن من فوقهن والملٰئكة يسبحون بحمد ربهم ويستغفرون لمن في الارض الا ان الله هو الغفور الرحيم",
    "ayahnumber" : "5",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4359",
    "page" : "483",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:436",
    "ayah_text" : "هَٰذَا بَيَانٞ لِّلنَّاسِ وَهُدٗى وَمَوۡعِظَةٞ لِّلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "هٰذا بيان للناس وهدى وموعظة للمتقين",
    "ayahnumber" : "138",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "436",
    "page" : "67",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4360",
    "ayah_text" : "وَٱلَّذِينَ ٱتَّخَذُواْ مِن دُونِهِۦٓ أَوۡلِيَآءَ ٱللَّهُ حَفِيظٌ عَلَيۡهِمۡ وَمَآ أَنتَ عَلَيۡهِم بِوَكِيلٖ",
    "ayah_text_no_diacratic" : "والذين اتخذوا من دونه اولياء الله حفيظ عليهم وما انت عليهم بوكيل",
    "ayahnumber" : "6",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4360",
    "page" : "483",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4361",
    "ayah_text" : "وَكَذَٰلِكَ أَوۡحَيۡنَآ إِلَيۡكَ قُرۡءَانًا عَرَبِيّٗا لِّتُنذِرَ أُمَّ ٱلۡقُرَىٰ وَمَنۡ حَوۡلَهَا وَتُنذِرَ يَوۡمَ ٱلۡجَمۡعِ لَا رَيۡبَ فِيهِۚ فَرِيقٞ فِي ٱلۡجَنَّةِ وَفَرِيقٞ فِي ٱلسَّعِيرِ",
    "ayah_text_no_diacratic" : "وكذٰلك اوحينا اليك قرءانا عربيا لتنذر ام القرىٰ ومن حولها وتنذر يوم الجمع لا ريب فيه فريق في الجنة وفريق في السعير",
    "ayahnumber" : "7",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4361",
    "page" : "483",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4362",
    "ayah_text" : "وَلَوۡ شَآءَ ٱللَّهُ لَجَعَلَهُمۡ أُمَّةٗ وَٰحِدَةٗ وَلَٰكِن يُدۡخِلُ مَن يَشَآءُ فِي رَحۡمَتِهِۦۚ وَٱلظَّٰلِمُونَ مَا لَهُم مِّن وَلِيّٖ وَلَا نَصِيرٍ",
    "ayah_text_no_diacratic" : "ولو شاء الله لجعلهم امة وٰحدة ولٰكن يدخل من يشاء في رحمته والظٰلمون ما لهم من ولي ولا نصير",
    "ayahnumber" : "8",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4362",
    "page" : "483",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4363",
    "ayah_text" : "أَمِ ٱتَّخَذُواْ مِن دُونِهِۦٓ أَوۡلِيَآءَۖ فَٱللَّهُ هُوَ ٱلۡوَلِيُّ وَهُوَ يُحۡيِ ٱلۡمَوۡتَىٰ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "ام اتخذوا من دونه اولياء فالله هو الولي وهو يحي الموتىٰ وهو علىٰ كل شيء قدير",
    "ayahnumber" : "9",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4363",
    "page" : "483",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4364",
    "ayah_text" : "وَمَا ٱخۡتَلَفۡتُمۡ فِيهِ مِن شَيۡءٖ فَحُكۡمُهُۥٓ إِلَى ٱللَّهِۚ ذَٰلِكُمُ ٱللَّهُ رَبِّي عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ أُنِيبُ",
    "ayah_text_no_diacratic" : "وما اختلفتم فيه من شيء فحكمه الى الله ذٰلكم الله ربي عليه توكلت واليه انيب",
    "ayahnumber" : "10",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4364",
    "page" : "483",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4365",
    "ayah_text" : "فَاطِرُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ جَعَلَ لَكُم مِّنۡ أَنفُسِكُمۡ أَزۡوَٰجٗا وَمِنَ ٱلۡأَنۡعَٰمِ أَزۡوَٰجٗا يَذۡرَؤُكُمۡ فِيهِۚ لَيۡسَ كَمِثۡلِهِۦ شَيۡءٞۖ وَهُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ",
    "ayah_text_no_diacratic" : "فاطر السمٰوٰت والارض جعل لكم من انفسكم ازوٰجا ومن الانعٰم ازوٰجا يذرؤكم فيه ليس كمثله شيء وهو السميع البصير",
    "ayahnumber" : "11",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4365",
    "page" : "484",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4366",
    "ayah_text" : "لَهُۥ مَقَالِيدُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ يَبۡسُطُ ٱلرِّزۡقَ لِمَن يَشَآءُ وَيَقۡدِرُۚ إِنَّهُۥ بِكُلِّ شَيۡءٍ عَلِيمٞ",
    "ayah_text_no_diacratic" : "له مقاليد السمٰوٰت والارض يبسط الرزق لمن يشاء ويقدر انه بكل شيء عليم",
    "ayahnumber" : "12",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4366",
    "page" : "484",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4367",
    "ayah_text" : "۞شَرَعَ لَكُم مِّنَ ٱلدِّينِ مَا وَصَّىٰ بِهِۦ نُوحٗا وَٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ وَمَا وَصَّيۡنَا بِهِۦٓ إِبۡرَٰهِيمَ وَمُوسَىٰ وَعِيسَىٰٓۖ أَنۡ أَقِيمُواْ ٱلدِّينَ وَلَا تَتَفَرَّقُواْ فِيهِۚ كَبُرَ عَلَى ٱلۡمُشۡرِكِينَ مَا تَدۡعُوهُمۡ إِلَيۡهِۚ ٱللَّهُ يَجۡتَبِيٓ إِلَيۡهِ مَن يَشَآءُ وَيَهۡدِيٓ إِلَيۡهِ مَن يُنِيبُ",
    "ayah_text_no_diacratic" : "شرع لكم من الدين ما وصىٰ به نوحا والذي اوحينا اليك وما وصينا به ابرٰهيم وموسىٰ وعيسىٰ ان اقيموا الدين ولا تتفرقوا فيه كبر على المشركين ما تدعوهم اليه الله يجتبي اليه من يشاء ويهدي اليه من ينيب",
    "ayahnumber" : "13",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4367",
    "page" : "484",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4368",
    "ayah_text" : "وَمَا تَفَرَّقُوٓاْ إِلَّا مِنۢ بَعۡدِ مَا جَآءَهُمُ ٱلۡعِلۡمُ بَغۡيَۢا بَيۡنَهُمۡۚ وَلَوۡلَا كَلِمَةٞ سَبَقَتۡ مِن رَّبِّكَ إِلَىٰٓ أَجَلٖ مُّسَمّٗى لَّقُضِيَ بَيۡنَهُمۡۚ وَإِنَّ ٱلَّذِينَ أُورِثُواْ ٱلۡكِتَٰبَ مِنۢ بَعۡدِهِمۡ لَفِي شَكّٖ مِّنۡهُ مُرِيبٖ",
    "ayah_text_no_diacratic" : "وما تفرقوا الا من بعد ما جاءهم العلم بغيا بينهم ولولا كلمة سبقت من ربك الىٰ اجل مسمى لقضي بينهم وان الذين اورثوا الكتٰب من بعدهم لفي شك منه مريب",
    "ayahnumber" : "14",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4368",
    "page" : "484",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4369",
    "ayah_text" : "فَلِذَٰلِكَ فَٱدۡعُۖ وَٱسۡتَقِمۡ كَمَآ أُمِرۡتَۖ وَلَا تَتَّبِعۡ أَهۡوَآءَهُمۡۖ وَقُلۡ ءَامَنتُ بِمَآ أَنزَلَ ٱللَّهُ مِن كِتَٰبٖۖ وَأُمِرۡتُ لِأَعۡدِلَ بَيۡنَكُمُۖ ٱللَّهُ رَبُّنَا وَرَبُّكُمۡۖ لَنَآ أَعۡمَٰلُنَا وَلَكُمۡ أَعۡمَٰلُكُمۡۖ لَا حُجَّةَ بَيۡنَنَا وَبَيۡنَكُمُۖ ٱللَّهُ يَجۡمَعُ بَيۡنَنَاۖ وَإِلَيۡهِ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "فلذٰلك فادع واستقم كما امرت ولا تتبع اهواءهم وقل ءامنت بما انزل الله من كتٰب وامرت لاعدل بينكم الله ربنا وربكم لنا اعمٰلنا ولكم اعمٰلكم لا حجة بيننا وبينكم الله يجمع بيننا واليه المصير",
    "ayahnumber" : "15",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4369",
    "page" : "484",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:437",
    "ayah_text" : "وَلَا تَهِنُواْ وَلَا تَحۡزَنُواْ وَأَنتُمُ ٱلۡأَعۡلَوۡنَ إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ولا تهنوا ولا تحزنوا وانتم الاعلون ان كنتم مؤمنين",
