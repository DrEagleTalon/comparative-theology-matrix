  }, {
    "@id" : "quran:4619",
    "ayah_text" : "وَلِكُلّٖ دَرَجَٰتٞ مِّمَّا عَمِلُواْۖ وَلِيُوَفِّيَهُمۡ أَعۡمَٰلَهُمۡ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولكل درجٰت مما عملوا وليوفيهم اعمٰلهم وهم لا يظلمون",
    "ayahnumber" : "19",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4619",
    "page" : "504",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:462",
    "ayah_text" : "لَقَدۡ مَنَّ ٱللَّهُ عَلَى ٱلۡمُؤۡمِنِينَ إِذۡ بَعَثَ فِيهِمۡ رَسُولٗا مِّنۡ أَنفُسِهِمۡ يَتۡلُواْ عَلَيۡهِمۡ ءَايَٰتِهِۦ وَيُزَكِّيهِمۡ وَيُعَلِّمُهُمُ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَإِن كَانُواْ مِن قَبۡلُ لَفِي ضَلَٰلٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "لقد من الله على المؤمنين اذ بعث فيهم رسولا من انفسهم يتلوا عليهم ءايٰته ويزكيهم ويعلمهم الكتٰب والحكمة وان كانوا من قبل لفي ضلٰل مبين",
    "ayahnumber" : "164",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "462",
    "page" : "71",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4620",
    "ayah_text" : "وَيَوۡمَ يُعۡرَضُ ٱلَّذِينَ كَفَرُواْ عَلَى ٱلنَّارِ أَذۡهَبۡتُمۡ طَيِّبَٰتِكُمۡ فِي حَيَاتِكُمُ ٱلدُّنۡيَا وَٱسۡتَمۡتَعۡتُم بِهَا فَٱلۡيَوۡمَ تُجۡزَوۡنَ عَذَابَ ٱلۡهُونِ بِمَا كُنتُمۡ تَسۡتَكۡبِرُونَ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّ وَبِمَا كُنتُمۡ تَفۡسُقُونَ",
    "ayah_text_no_diacratic" : "ويوم يعرض الذين كفروا على النار اذهبتم طيبٰتكم في حياتكم الدنيا واستمتعتم بها فاليوم تجزون عذاب الهون بما كنتم تستكبرون في الارض بغير الحق وبما كنتم تفسقون",
    "ayahnumber" : "20",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4620",
    "page" : "504",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4621",
    "ayah_text" : "۞وَٱذۡكُرۡ أَخَا عَادٍ إِذۡ أَنذَرَ قَوۡمَهُۥ بِٱلۡأَحۡقَافِ وَقَدۡ خَلَتِ ٱلنُّذُرُ مِنۢ بَيۡنِ يَدَيۡهِ وَمِنۡ خَلۡفِهِۦٓ أَلَّا تَعۡبُدُوٓاْ إِلَّا ٱللَّهَ إِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ عَظِيمٖ",
    "ayah_text_no_diacratic" : "واذكر اخا عاد اذ انذر قومه بالاحقاف وقد خلت النذر من بين يديه ومن خلفه الا تعبدوا الا الله اني اخاف عليكم عذاب يوم عظيم",
    "ayahnumber" : "21",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4621",
    "page" : "505",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4622",
    "ayah_text" : "قَالُوٓاْ أَجِئۡتَنَا لِتَأۡفِكَنَا عَنۡ ءَالِهَتِنَا فَأۡتِنَا بِمَا تَعِدُنَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "قالوا اجئتنا لتافكنا عن ءالهتنا فاتنا بما تعدنا ان كنت من الصٰدقين",
    "ayahnumber" : "22",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4622",
    "page" : "505",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4623",
    "ayah_text" : "قَالَ إِنَّمَا ٱلۡعِلۡمُ عِندَ ٱللَّهِ وَأُبَلِّغُكُم مَّآ أُرۡسِلۡتُ بِهِۦ وَلَٰكِنِّيٓ أَرَىٰكُمۡ قَوۡمٗا تَجۡهَلُونَ",
    "ayah_text_no_diacratic" : "قال انما العلم عند الله وابلغكم ما ارسلت به ولٰكني ارىٰكم قوما تجهلون",
    "ayahnumber" : "23",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4623",
    "page" : "505",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4624",
    "ayah_text" : "فَلَمَّا رَأَوۡهُ عَارِضٗا مُّسۡتَقۡبِلَ أَوۡدِيَتِهِمۡ قَالُواْ هَٰذَا عَارِضٞ مُّمۡطِرُنَاۚ بَلۡ هُوَ مَا ٱسۡتَعۡجَلۡتُم بِهِۦۖ رِيحٞ فِيهَا عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "فلما راوه عارضا مستقبل اوديتهم قالوا هٰذا عارض ممطرنا بل هو ما استعجلتم به ريح فيها عذاب اليم",
    "ayahnumber" : "24",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4624",
    "page" : "505",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4625",
    "ayah_text" : "تُدَمِّرُ كُلَّ شَيۡءِۭ بِأَمۡرِ رَبِّهَا فَأَصۡبَحُواْ لَا يُرَىٰٓ إِلَّا مَسَٰكِنُهُمۡۚ كَذَٰلِكَ نَجۡزِي ٱلۡقَوۡمَ ٱلۡمُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "تدمر كل شيء بامر ربها فاصبحوا لا يرىٰ الا مسٰكنهم كذٰلك نجزي القوم المجرمين",
    "ayahnumber" : "25",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4625",
    "page" : "505",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4626",
    "ayah_text" : "وَلَقَدۡ مَكَّنَّٰهُمۡ فِيمَآ إِن مَّكَّنَّٰكُمۡ فِيهِ وَجَعَلۡنَا لَهُمۡ سَمۡعٗا وَأَبۡصَٰرٗا وَأَفۡـِٔدَةٗ فَمَآ أَغۡنَىٰ عَنۡهُمۡ سَمۡعُهُمۡ وَلَآ أَبۡصَٰرُهُمۡ وَلَآ أَفۡـِٔدَتُهُم مِّن شَيۡءٍ إِذۡ كَانُواْ يَجۡحَدُونَ بِـَٔايَٰتِ ٱللَّهِ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "ولقد مكنٰهم فيما ان مكنٰكم فيه وجعلنا لهم سمعا وابصٰرا وافدة فما اغنىٰ عنهم سمعهم ولا ابصٰرهم ولا افدتهم من شيء اذ كانوا يجحدون بايٰت الله وحاق بهم ما كانوا به يستهزءون",
    "ayahnumber" : "26",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4626",
    "page" : "505",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4627",
    "ayah_text" : "وَلَقَدۡ أَهۡلَكۡنَا مَا حَوۡلَكُم مِّنَ ٱلۡقُرَىٰ وَصَرَّفۡنَا ٱلۡأٓيَٰتِ لَعَلَّهُمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "ولقد اهلكنا ما حولكم من القرىٰ وصرفنا الايٰت لعلهم يرجعون",
    "ayahnumber" : "27",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4627",
    "page" : "505",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4628",
    "ayah_text" : "فَلَوۡلَا نَصَرَهُمُ ٱلَّذِينَ ٱتَّخَذُواْ مِن دُونِ ٱللَّهِ قُرۡبَانًا ءَالِهَةَۢۖ بَلۡ ضَلُّواْ عَنۡهُمۡۚ وَذَٰلِكَ إِفۡكُهُمۡ وَمَا كَانُواْ يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "فلولا نصرهم الذين اتخذوا من دون الله قربانا ءالهة بل ضلوا عنهم وذٰلك افكهم وما كانوا يفترون",
    "ayahnumber" : "28",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4628",
    "page" : "505",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4629",
    "ayah_text" : "وَإِذۡ صَرَفۡنَآ إِلَيۡكَ نَفَرٗا مِّنَ ٱلۡجِنِّ يَسۡتَمِعُونَ ٱلۡقُرۡءَانَ فَلَمَّا حَضَرُوهُ قَالُوٓاْ أَنصِتُواْۖ فَلَمَّا قُضِيَ وَلَّوۡاْ إِلَىٰ قَوۡمِهِم مُّنذِرِينَ",
    "ayah_text_no_diacratic" : "واذ صرفنا اليك نفرا من الجن يستمعون القرءان فلما حضروه قالوا انصتوا فلما قضي ولوا الىٰ قومهم منذرين",
    "ayahnumber" : "29",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4629",
    "page" : "506",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:463",
    "ayah_text" : "أَوَلَمَّآ أَصَٰبَتۡكُم مُّصِيبَةٞ قَدۡ أَصَبۡتُم مِّثۡلَيۡهَا قُلۡتُمۡ أَنَّىٰ هَٰذَاۖ قُلۡ هُوَ مِنۡ عِندِ أَنفُسِكُمۡۗ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "اولما اصٰبتكم مصيبة قد اصبتم مثليها قلتم انىٰ هٰذا قل هو من عند انفسكم ان الله علىٰ كل شيء قدير",
    "ayahnumber" : "165",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "463",
    "page" : "71",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4630",
    "ayah_text" : "قَالُواْ يَٰقَوۡمَنَآ إِنَّا سَمِعۡنَا كِتَٰبًا أُنزِلَ مِنۢ بَعۡدِ مُوسَىٰ مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ يَهۡدِيٓ إِلَى ٱلۡحَقِّ وَإِلَىٰ طَرِيقٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "قالوا يٰقومنا انا سمعنا كتٰبا انزل من بعد موسىٰ مصدقا لما بين يديه يهدي الى الحق والىٰ طريق مستقيم",
    "ayahnumber" : "30",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4630",
    "page" : "506",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4631",
    "ayah_text" : "يَٰقَوۡمَنَآ أَجِيبُواْ دَاعِيَ ٱللَّهِ وَءَامِنُواْ بِهِۦ يَغۡفِرۡ لَكُم مِّن ذُنُوبِكُمۡ وَيُجِرۡكُم مِّنۡ عَذَابٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "يٰقومنا اجيبوا داعي الله وءامنوا به يغفر لكم من ذنوبكم ويجركم من عذاب اليم",
    "ayahnumber" : "31",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4631",
    "page" : "506",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4632",
    "ayah_text" : "وَمَن لَّا يُجِبۡ دَاعِيَ ٱللَّهِ فَلَيۡسَ بِمُعۡجِزٖ فِي ٱلۡأَرۡضِ وَلَيۡسَ لَهُۥ مِن دُونِهِۦٓ أَوۡلِيَآءُۚ أُوْلَٰٓئِكَ فِي ضَلَٰلٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "ومن لا يجب داعي الله فليس بمعجز في الارض وليس له من دونه اولياء اولٰئك في ضلٰل مبين",
    "ayahnumber" : "32",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4632",
    "page" : "506",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4633",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ أَنَّ ٱللَّهَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَلَمۡ يَعۡيَ بِخَلۡقِهِنَّ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰۚ بَلَىٰٓۚ إِنَّهُۥ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "اولم يروا ان الله الذي خلق السمٰوٰت والارض ولم يعي بخلقهن بقٰدر علىٰ ان يحي الموتىٰ بلىٰ انه علىٰ كل شيء قدير",
    "ayahnumber" : "33",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4633",
    "page" : "506",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4634",
    "ayah_text" : "وَيَوۡمَ يُعۡرَضُ ٱلَّذِينَ كَفَرُواْ عَلَى ٱلنَّارِ أَلَيۡسَ هَٰذَا بِٱلۡحَقِّۖ قَالُواْ بَلَىٰ وَرَبِّنَاۚ قَالَ فَذُوقُواْ ٱلۡعَذَابَ بِمَا كُنتُمۡ تَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "ويوم يعرض الذين كفروا على النار اليس هٰذا بالحق قالوا بلىٰ وربنا قال فذوقوا العذاب بما كنتم تكفرون",
    "ayahnumber" : "34",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4634",
    "page" : "506",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4635",
    "ayah_text" : "فَٱصۡبِرۡ كَمَا صَبَرَ أُوْلُواْ ٱلۡعَزۡمِ مِنَ ٱلرُّسُلِ وَلَا تَسۡتَعۡجِل لَّهُمۡۚ كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَ مَا يُوعَدُونَ لَمۡ يَلۡبَثُوٓاْ إِلَّا سَاعَةٗ مِّن نَّهَارِۭۚ بَلَٰغٞۚ فَهَلۡ يُهۡلَكُ إِلَّا ٱلۡقَوۡمُ ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "فاصبر كما صبر اولوا العزم من الرسل ولا تستعجل لهم كانهم يوم يرون ما يوعدون لم يلبثوا الا ساعة من نهار بلٰغ فهل يهلك الا القوم الفٰسقون",
    "ayahnumber" : "35",
    "chapter" : "26",
    "hizb" : "50",
