    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4873",
    "ayah_text" : "أَمۡ خَلَقُواْ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَۚ بَل لَّا يُوقِنُونَ",
    "ayah_text_no_diacratic" : "ام خلقوا السمٰوٰت والارض بل لا يوقنون",
