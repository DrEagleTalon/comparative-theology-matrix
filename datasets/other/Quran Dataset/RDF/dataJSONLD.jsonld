    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2032",
    "ayah_text" : "وَإِذَا بَدَّلۡنَآ ءَايَةٗ مَّكَانَ ءَايَةٖ وَٱللَّهُ أَعۡلَمُ بِمَا يُنَزِّلُ قَالُوٓاْ إِنَّمَآ أَنتَ مُفۡتَرِۭۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "واذا بدلنا ءاية مكان ءاية والله اعلم بما ينزل قالوا انما انت مفتر بل اكثرهم لا يعلمون",
    "ayahnumber" : "101",
