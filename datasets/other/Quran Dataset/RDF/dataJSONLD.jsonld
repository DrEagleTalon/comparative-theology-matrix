    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4302",
    "ayah_text" : "بَشِيرٗا وَنَذِيرٗا فَأَعۡرَضَ أَكۡثَرُهُمۡ فَهُمۡ لَا يَسۡمَعُونَ",
    "ayah_text_no_diacratic" : "بشيرا ونذيرا فاعرض اكثرهم فهم لا يسمعون",
    "ayahnumber" : "4",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4302",
