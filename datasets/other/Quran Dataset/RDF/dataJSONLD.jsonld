    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3030",
    "ayah_text" : "رَبِّ مُوسَىٰ وَهَٰرُونَ",
    "ayah_text_no_diacratic" : "رب موسىٰ وهٰرون",
    "ayahnumber" : "48",
