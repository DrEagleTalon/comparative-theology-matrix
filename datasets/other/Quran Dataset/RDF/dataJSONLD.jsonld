    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4822",
    "ayah_text" : "وَٱلسَّمَآءَ بَنَيۡنَٰهَا بِأَيۡيْدٖ وَإِنَّا لَمُوسِعُونَ",
