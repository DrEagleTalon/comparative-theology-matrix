    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:42",
    "ayah_text" : "قَالُواْ سُبۡحَٰنَكَ لَا عِلۡمَ لَنَآ إِلَّا مَا عَلَّمۡتَنَآۖ إِنَّكَ أَنتَ ٱلۡعَلِيمُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "قالوا سبحٰنك لا علم لنا الا ما علمتنا انك انت العليم الحكيم",
    "ayahnumber" : "32",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "42",
    "page" : "6",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:420",
    "ayah_text" : "إِذۡ هَمَّت طَّآئِفَتَانِ مِنكُمۡ أَن تَفۡشَلَا وَٱللَّهُ وَلِيُّهُمَاۗ وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ ٱلۡمُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "اذ همت طائفتان منكم ان تفشلا والله وليهما وعلى الله فليتوكل المؤمنون",
    "ayahnumber" : "122",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "420",
    "page" : "66",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4200",
    "ayah_text" : "بَلِ ٱللَّهَ فَٱعۡبُدۡ وَكُن مِّنَ ٱلشَّٰكِرِينَ",
    "ayah_text_no_diacratic" : "بل الله فاعبد وكن من الشٰكرين",
    "ayahnumber" : "66",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4200",
    "page" : "465",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4201",
    "ayah_text" : "وَمَا قَدَرُواْ ٱللَّهَ حَقَّ قَدۡرِهِۦ وَٱلۡأَرۡضُ جَمِيعٗا قَبۡضَتُهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ وَٱلسَّمَٰوَٰتُ مَطۡوِيَّٰتُۢ بِيَمِينِهِۦۚ سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "وما قدروا الله حق قدره والارض جميعا قبضته يوم القيٰمة والسمٰوٰت مطويٰت بيمينه سبحٰنه وتعٰلىٰ عما يشركون",
    "ayahnumber" : "67",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4201",
    "page" : "465",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4202",
    "ayah_text" : "وَنُفِخَ فِي ٱلصُّورِ فَصَعِقَ مَن فِي ٱلسَّمَٰوَٰتِ وَمَن فِي ٱلۡأَرۡضِ إِلَّا مَن شَآءَ ٱللَّهُۖ ثُمَّ نُفِخَ فِيهِ أُخۡرَىٰ فَإِذَا هُمۡ قِيَامٞ يَنظُرُونَ",
    "ayah_text_no_diacratic" : "ونفخ في الصور فصعق من في السمٰوٰت ومن في الارض الا من شاء الله ثم نفخ فيه اخرىٰ فاذا هم قيام ينظرون",
    "ayahnumber" : "68",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4202",
    "page" : "466",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4203",
    "ayah_text" : "وَأَشۡرَقَتِ ٱلۡأَرۡضُ بِنُورِ رَبِّهَا وَوُضِعَ ٱلۡكِتَٰبُ وَجِاْيٓءَ بِٱلنَّبِيِّـۧنَ وَٱلشُّهَدَآءِ وَقُضِيَ بَيۡنَهُم بِٱلۡحَقِّ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "واشرقت الارض بنور ربها ووضع الكتٰب وجايء بالنبين والشهداء وقضي بينهم بالحق وهم لا يظلمون",
    "ayahnumber" : "69",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4203",
    "page" : "466",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4204",
    "ayah_text" : "وَوُفِّيَتۡ كُلُّ نَفۡسٖ مَّا عَمِلَتۡ وَهُوَ أَعۡلَمُ بِمَا يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "ووفيت كل نفس ما عملت وهو اعلم بما يفعلون",
    "ayahnumber" : "70",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4204",
    "page" : "466",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4205",
    "ayah_text" : "وَسِيقَ ٱلَّذِينَ كَفَرُوٓاْ إِلَىٰ جَهَنَّمَ زُمَرًاۖ حَتَّىٰٓ إِذَا جَآءُوهَا فُتِحَتۡ أَبۡوَٰبُهَا وَقَالَ لَهُمۡ خَزَنَتُهَآ أَلَمۡ يَأۡتِكُمۡ رُسُلٞ مِّنكُمۡ يَتۡلُونَ عَلَيۡكُمۡ ءَايَٰتِ رَبِّكُمۡ وَيُنذِرُونَكُمۡ لِقَآءَ يَوۡمِكُمۡ هَٰذَاۚ قَالُواْ بَلَىٰ وَلَٰكِنۡ حَقَّتۡ كَلِمَةُ ٱلۡعَذَابِ عَلَى ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "وسيق الذين كفروا الىٰ جهنم زمرا حتىٰ اذا جاءوها فتحت ابوٰبها وقال لهم خزنتها الم ياتكم رسل منكم يتلون عليكم ءايٰت ربكم وينذرونكم لقاء يومكم هٰذا قالوا بلىٰ ولٰكن حقت كلمة العذاب على الكٰفرين",
    "ayahnumber" : "71",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4205",
    "page" : "466",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4206",
    "ayah_text" : "قِيلَ ٱدۡخُلُوٓاْ أَبۡوَٰبَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۖ فَبِئۡسَ مَثۡوَى ٱلۡمُتَكَبِّرِينَ",
    "ayah_text_no_diacratic" : "قيل ادخلوا ابوٰب جهنم خٰلدين فيها فبئس مثوى المتكبرين",
    "ayahnumber" : "72",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4206",
    "page" : "466",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4207",
    "ayah_text" : "وَسِيقَ ٱلَّذِينَ ٱتَّقَوۡاْ رَبَّهُمۡ إِلَى ٱلۡجَنَّةِ زُمَرًاۖ حَتَّىٰٓ إِذَا جَآءُوهَا وَفُتِحَتۡ أَبۡوَٰبُهَا وَقَالَ لَهُمۡ خَزَنَتُهَا سَلَٰمٌ عَلَيۡكُمۡ طِبۡتُمۡ فَٱدۡخُلُوهَا خَٰلِدِينَ",
    "ayah_text_no_diacratic" : "وسيق الذين اتقوا ربهم الى الجنة زمرا حتىٰ اذا جاءوها وفتحت ابوٰبها وقال لهم خزنتها سلٰم عليكم طبتم فادخلوها خٰلدين",
    "ayahnumber" : "73",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4207",
    "page" : "466",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4208",
    "ayah_text" : "وَقَالُواْ ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي صَدَقَنَا وَعۡدَهُۥ وَأَوۡرَثَنَا ٱلۡأَرۡضَ نَتَبَوَّأُ مِنَ ٱلۡجَنَّةِ حَيۡثُ نَشَآءُۖ فَنِعۡمَ أَجۡرُ ٱلۡعَٰمِلِينَ",
    "ayah_text_no_diacratic" : "وقالوا الحمد لله الذي صدقنا وعده واورثنا الارض نتبوا من الجنة حيث نشاء فنعم اجر العٰملين",
    "ayahnumber" : "74",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4208",
    "page" : "466",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4209",
    "ayah_text" : "وَتَرَى ٱلۡمَلَٰٓئِكَةَ حَآفِّينَ مِنۡ حَوۡلِ ٱلۡعَرۡشِ يُسَبِّحُونَ بِحَمۡدِ رَبِّهِمۡۚ وَقُضِيَ بَيۡنَهُم بِٱلۡحَقِّۚ وَقِيلَ ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "وترى الملٰئكة حافين من حول العرش يسبحون بحمد ربهم وقضي بينهم بالحق وقيل الحمد لله رب العٰلمين",
    "ayahnumber" : "75",
    "chapter" : "24",
    "hizb" : "46",
