    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3933",
    "ayah_text" : "فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ",
    "ayah_text_no_diacratic" : "فانظر كيف كان عٰقبة المنذرين",
