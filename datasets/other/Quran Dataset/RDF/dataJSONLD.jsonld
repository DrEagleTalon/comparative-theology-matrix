    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:413",
    "ayah_text" : "وَمَا يَفۡعَلُواْ مِنۡ خَيۡرٖ فَلَن يُكۡفَرُوهُۗ وَٱللَّهُ عَلِيمُۢ بِٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "وما يفعلوا من خير فلن يكفروه والله عليم بالمتقين",
    "ayahnumber" : "115",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "413",
    "page" : "64",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4130",
    "ayah_text" : "قُلۡ مَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٖ وَمَآ أَنَا۠ مِنَ ٱلۡمُتَكَلِّفِينَ",
    "ayah_text_no_diacratic" : "قل ما اسلكم عليه من اجر وما انا من المتكلفين",
    "ayahnumber" : "86",
    "chapter" : "23",
    "hizb" : "45",
