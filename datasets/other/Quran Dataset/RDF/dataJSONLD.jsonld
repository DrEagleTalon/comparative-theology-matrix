    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1080",
    "ayah_text" : "وَجَآءَ ٱلسَّحَرَةُ فِرۡعَوۡنَ قَالُوٓاْ إِنَّ لَنَا لَأَجۡرًا إِن كُنَّا نَحۡنُ ٱلۡغَٰلِبِينَ",
    "ayah_text_no_diacratic" : "وجاء السحرة فرعون قالوا ان لنا لاجرا ان كنا نحن الغٰلبين",
    "ayahnumber" : "113",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1080",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1081",
    "ayah_text" : "قَالَ نَعَمۡ وَإِنَّكُمۡ لَمِنَ ٱلۡمُقَرَّبِينَ",
    "ayah_text_no_diacratic" : "قال نعم وانكم لمن المقربين",
    "ayahnumber" : "114",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1081",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1082",
    "ayah_text" : "قَالُواْ يَٰمُوسَىٰٓ إِمَّآ أَن تُلۡقِيَ وَإِمَّآ أَن نَّكُونَ نَحۡنُ ٱلۡمُلۡقِينَ",
    "ayah_text_no_diacratic" : "قالوا يٰموسىٰ اما ان تلقي واما ان نكون نحن الملقين",
    "ayahnumber" : "115",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1082",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1083",
    "ayah_text" : "قَالَ أَلۡقُواْۖ فَلَمَّآ أَلۡقَوۡاْ سَحَرُوٓاْ أَعۡيُنَ ٱلنَّاسِ وَٱسۡتَرۡهَبُوهُمۡ وَجَآءُو بِسِحۡرٍ عَظِيمٖ",
    "ayah_text_no_diacratic" : "قال القوا فلما القوا سحروا اعين الناس واسترهبوهم وجاءو بسحر عظيم",
    "ayahnumber" : "116",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1083",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1084",
    "ayah_text" : "۞وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنۡ أَلۡقِ عَصَاكَۖ فَإِذَا هِيَ تَلۡقَفُ مَا يَأۡفِكُونَ",
    "ayah_text_no_diacratic" : "واوحينا الىٰ موسىٰ ان الق عصاك فاذا هي تلقف ما يافكون",
    "ayahnumber" : "117",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1084",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1085",
    "ayah_text" : "فَوَقَعَ ٱلۡحَقُّ وَبَطَلَ مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "فوقع الحق وبطل ما كانوا يعملون",
    "ayahnumber" : "118",
    "chapter" : "9",
    "hizb" : "16",
