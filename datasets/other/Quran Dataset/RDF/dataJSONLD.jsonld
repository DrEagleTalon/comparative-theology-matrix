    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:108",
    "ayah_text" : "مَن كَانَ عَدُوّٗا لِّلَّهِ وَمَلَٰٓئِكَتِهِۦ وَرُسُلِهِۦ وَجِبۡرِيلَ وَمِيكَىٰلَ فَإِنَّ ٱللَّهَ عَدُوّٞ لِّلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "من كان عدوا لله وملٰئكته ورسله وجبريل وميكىٰل فان الله عدو للكٰفرين",
    "ayahnumber" : "98",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "108",
