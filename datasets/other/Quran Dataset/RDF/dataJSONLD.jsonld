    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4639",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَءَامَنُواْ بِمَا نُزِّلَ عَلَىٰ مُحَمَّدٖ وَهُوَ ٱلۡحَقُّ مِن رَّبِّهِمۡ كَفَّرَ عَنۡهُمۡ سَيِّـَٔاتِهِمۡ وَأَصۡلَحَ بَالَهُمۡ",
    "ayah_text_no_diacratic" : "والذين ءامنوا وعملوا الصٰلحٰت وءامنوا بما نزل علىٰ محمد وهو الحق من ربهم كفر عنهم سياتهم واصلح بالهم",
    "ayahnumber" : "2",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4639",
    "page" : "507",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:464",
    "ayah_text" : "وَمَآ أَصَٰبَكُمۡ يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِ فَبِإِذۡنِ ٱللَّهِ وَلِيَعۡلَمَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وما اصٰبكم يوم التقى الجمعان فباذن الله وليعلم المؤمنين",
