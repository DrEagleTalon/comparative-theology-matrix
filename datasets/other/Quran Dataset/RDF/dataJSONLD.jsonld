    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1231",
    "ayah_text" : "ٱلَّذِينَ عَٰهَدتَّ مِنۡهُمۡ ثُمَّ يَنقُضُونَ عَهۡدَهُمۡ فِي كُلِّ مَرَّةٖ وَهُمۡ لَا يَتَّقُونَ",
    "ayah_text_no_diacratic" : "الذين عٰهدت منهم ثم ينقضون عهدهم في كل مرة وهم لا يتقون",
    "ayahnumber" : "56",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1231",
    "page" : "184",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1232",
    "ayah_text" : "فَإِمَّا تَثۡقَفَنَّهُمۡ فِي ٱلۡحَرۡبِ فَشَرِّدۡ بِهِم مَّنۡ خَلۡفَهُمۡ لَعَلَّهُمۡ يَذَّكَّرُونَ",
    "ayah_text_no_diacratic" : "فاما تثقفنهم في الحرب فشرد بهم من خلفهم لعلهم يذكرون",
    "ayahnumber" : "57",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1232",
    "page" : "184",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1233",
    "ayah_text" : "وَإِمَّا تَخَافَنَّ مِن قَوۡمٍ خِيَانَةٗ فَٱنۢبِذۡ إِلَيۡهِمۡ عَلَىٰ سَوَآءٍۚ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلۡخَآئِنِينَ",
    "ayah_text_no_diacratic" : "واما تخافن من قوم خيانة فانبذ اليهم علىٰ سواء ان الله لا يحب الخائنين",
    "ayahnumber" : "58",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1233",
    "page" : "184",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1234",
    "ayah_text" : "وَلَا يَحۡسَبَنَّ ٱلَّذِينَ كَفَرُواْ سَبَقُوٓاْۚ إِنَّهُمۡ لَا يُعۡجِزُونَ",
    "ayah_text_no_diacratic" : "ولا يحسبن الذين كفروا سبقوا انهم لا يعجزون",
    "ayahnumber" : "59",
    "chapter" : "10",
