  }, {
    "@id" : "quran:2267",
    "ayah_text" : "حَتَّىٰٓ إِذَا بَلَغَ بَيۡنَ ٱلسَّدَّيۡنِ وَجَدَ مِن دُونِهِمَا قَوۡمٗا لَّا يَكَادُونَ يَفۡقَهُونَ قَوۡلٗا",
    "ayah_text_no_diacratic" : "حتىٰ اذا بلغ بين السدين وجد من دونهما قوما لا يكادون يفقهون قولا",
    "ayahnumber" : "93",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2267",
    "page" : "303",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2268",
    "ayah_text" : "قَالُواْ يَٰذَا ٱلۡقَرۡنَيۡنِ إِنَّ يَأۡجُوجَ وَمَأۡجُوجَ مُفۡسِدُونَ فِي ٱلۡأَرۡضِ فَهَلۡ نَجۡعَلُ لَكَ خَرۡجًا عَلَىٰٓ أَن تَجۡعَلَ بَيۡنَنَا وَبَيۡنَهُمۡ سَدّٗا",
    "ayah_text_no_diacratic" : "قالوا يٰذا القرنين ان ياجوج وماجوج مفسدون في الارض فهل نجعل لك خرجا علىٰ ان تجعل بيننا وبينهم سدا",
    "ayahnumber" : "94",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2268",
    "page" : "303",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2269",
    "ayah_text" : "قَالَ مَا مَكَّنِّي فِيهِ رَبِّي خَيۡرٞ فَأَعِينُونِي بِقُوَّةٍ أَجۡعَلۡ بَيۡنَكُمۡ وَبَيۡنَهُمۡ رَدۡمًا",
    "ayah_text_no_diacratic" : "قال ما مكني فيه ربي خير فاعينوني بقوة اجعل بينكم وبينهم ردما",
    "ayahnumber" : "95",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2269",
    "page" : "303",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:227",
    "ayah_text" : "يَسۡـَٔلُونَكَ عَنِ ٱلشَّهۡرِ ٱلۡحَرَامِ قِتَالٖ فِيهِۖ قُلۡ قِتَالٞ فِيهِ كَبِيرٞۚ وَصَدٌّ عَن سَبِيلِ ٱللَّهِ وَكُفۡرُۢ بِهِۦ وَٱلۡمَسۡجِدِ ٱلۡحَرَامِ وَإِخۡرَاجُ أَهۡلِهِۦ مِنۡهُ أَكۡبَرُ عِندَ ٱللَّهِۚ وَٱلۡفِتۡنَةُ أَكۡبَرُ مِنَ ٱلۡقَتۡلِۗ وَلَا يَزَالُونَ يُقَٰتِلُونَكُمۡ حَتَّىٰ يَرُدُّوكُمۡ عَن دِينِكُمۡ إِنِ ٱسۡتَطَٰعُواْۚ وَمَن يَرۡتَدِدۡ مِنكُمۡ عَن دِينِهِۦ فَيَمُتۡ وَهُوَ كَافِرٞ فَأُوْلَٰٓئِكَ حَبِطَتۡ أَعۡمَٰلُهُمۡ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۖ وَأُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "يسلونك عن الشهر الحرام قتال فيه قل قتال فيه كبير وصد عن سبيل الله وكفر به والمسجد الحرام واخراج اهله منه اكبر عند الله والفتنة اكبر من القتل ولا يزالون يقٰتلونكم حتىٰ يردوكم عن دينكم ان استطٰعوا ومن يرتدد منكم عن دينه فيمت وهو كافر فاولٰئك حبطت اعمٰلهم في الدنيا والاخرة واولٰئك اصحٰب النار هم فيها خٰلدون",
    "ayahnumber" : "217",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "227",
    "page" : "34",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2270",
    "ayah_text" : "ءَاتُونِي زُبَرَ ٱلۡحَدِيدِۖ حَتَّىٰٓ إِذَا سَاوَىٰ بَيۡنَ ٱلصَّدَفَيۡنِ قَالَ ٱنفُخُواْۖ حَتَّىٰٓ إِذَا جَعَلَهُۥ نَارٗا قَالَ ءَاتُونِيٓ أُفۡرِغۡ عَلَيۡهِ قِطۡرٗا",
    "ayah_text_no_diacratic" : "ءاتوني زبر الحديد حتىٰ اذا ساوىٰ بين الصدفين قال انفخوا حتىٰ اذا جعله نارا قال ءاتوني افرغ عليه قطرا",
    "ayahnumber" : "96",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2270",
    "page" : "303",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2271",
    "ayah_text" : "فَمَا ٱسۡطَٰعُوٓاْ أَن يَظۡهَرُوهُ وَمَا ٱسۡتَطَٰعُواْ لَهُۥ نَقۡبٗا",
    "ayah_text_no_diacratic" : "فما اسطٰعوا ان يظهروه وما استطٰعوا له نقبا",
    "ayahnumber" : "97",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2271",
    "page" : "303",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2272",
    "ayah_text" : "قَالَ هَٰذَا رَحۡمَةٞ مِّن رَّبِّيۖ فَإِذَا جَآءَ وَعۡدُ رَبِّي جَعَلَهُۥ دَكَّآءَۖ وَكَانَ وَعۡدُ رَبِّي حَقّٗا",
    "ayah_text_no_diacratic" : "قال هٰذا رحمة من ربي فاذا جاء وعد ربي جعله دكاء وكان وعد ربي حقا",
    "ayahnumber" : "98",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2272",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2273",
    "ayah_text" : "۞وَتَرَكۡنَا بَعۡضَهُمۡ يَوۡمَئِذٖ يَمُوجُ فِي بَعۡضٖۖ وَنُفِخَ فِي ٱلصُّورِ فَجَمَعۡنَٰهُمۡ جَمۡعٗا",
    "ayah_text_no_diacratic" : "وتركنا بعضهم يومئذ يموج في بعض ونفخ في الصور فجمعنٰهم جمعا",
    "ayahnumber" : "99",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2273",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2274",
    "ayah_text" : "وَعَرَضۡنَا جَهَنَّمَ يَوۡمَئِذٖ لِّلۡكَٰفِرِينَ عَرۡضًا",
    "ayah_text_no_diacratic" : "وعرضنا جهنم يومئذ للكٰفرين عرضا",
    "ayahnumber" : "100",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2274",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2275",
    "ayah_text" : "ٱلَّذِينَ كَانَتۡ أَعۡيُنُهُمۡ فِي غِطَآءٍ عَن ذِكۡرِي وَكَانُواْ لَا يَسۡتَطِيعُونَ سَمۡعًا",
    "ayah_text_no_diacratic" : "الذين كانت اعينهم في غطاء عن ذكري وكانوا لا يستطيعون سمعا",
    "ayahnumber" : "101",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2275",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2276",
    "ayah_text" : "أَفَحَسِبَ ٱلَّذِينَ كَفَرُوٓاْ أَن يَتَّخِذُواْ عِبَادِي مِن دُونِيٓ أَوۡلِيَآءَۚ إِنَّآ أَعۡتَدۡنَا جَهَنَّمَ لِلۡكَٰفِرِينَ نُزُلٗا",
    "ayah_text_no_diacratic" : "افحسب الذين كفروا ان يتخذوا عبادي من دوني اولياء انا اعتدنا جهنم للكٰفرين نزلا",
    "ayahnumber" : "102",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2276",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2277",
    "ayah_text" : "قُلۡ هَلۡ نُنَبِّئُكُم بِٱلۡأَخۡسَرِينَ أَعۡمَٰلًا",
    "ayah_text_no_diacratic" : "قل هل ننبئكم بالاخسرين اعمٰلا",
    "ayahnumber" : "103",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2277",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2278",
    "ayah_text" : "ٱلَّذِينَ ضَلَّ سَعۡيُهُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَهُمۡ يَحۡسَبُونَ أَنَّهُمۡ يُحۡسِنُونَ صُنۡعًا",
    "ayah_text_no_diacratic" : "الذين ضل سعيهم في الحيوٰة الدنيا وهم يحسبون انهم يحسنون صنعا",
    "ayahnumber" : "104",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2278",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2279",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِ رَبِّهِمۡ وَلِقَآئِهِۦ فَحَبِطَتۡ أَعۡمَٰلُهُمۡ فَلَا نُقِيمُ لَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ وَزۡنٗا",
    "ayah_text_no_diacratic" : "اولٰئك الذين كفروا بايٰت ربهم ولقائه فحبطت اعمٰلهم فلا نقيم لهم يوم القيٰمة وزنا",
    "ayahnumber" : "105",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2279",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:228",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَٱلَّذِينَ هَاجَرُواْ وَجَٰهَدُواْ فِي سَبِيلِ ٱللَّهِ أُوْلَٰٓئِكَ يَرۡجُونَ رَحۡمَتَ ٱللَّهِۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا والذين هاجروا وجٰهدوا في سبيل الله اولٰئك يرجون رحمت الله والله غفور رحيم",
    "ayahnumber" : "218",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "228",
    "page" : "34",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2280",
    "ayah_text" : "ذَٰلِكَ جَزَآؤُهُمۡ جَهَنَّمُ بِمَا كَفَرُواْ وَٱتَّخَذُوٓاْ ءَايَٰتِي وَرُسُلِي هُزُوًا",
    "ayah_text_no_diacratic" : "ذٰلك جزاؤهم جهنم بما كفروا واتخذوا ءايٰتي ورسلي هزوا",
    "ayahnumber" : "106",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2280",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2281",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ كَانَتۡ لَهُمۡ جَنَّٰتُ ٱلۡفِرۡدَوۡسِ نُزُلًا",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت كانت لهم جنٰت الفردوس نزلا",
    "ayahnumber" : "107",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2281",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2282",
    "ayah_text" : "خَٰلِدِينَ فِيهَا لَا يَبۡغُونَ عَنۡهَا حِوَلٗا",
    "ayah_text_no_diacratic" : "خٰلدين فيها لا يبغون عنها حولا",
    "ayahnumber" : "108",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2282",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2283",
    "ayah_text" : "قُل لَّوۡ كَانَ ٱلۡبَحۡرُ مِدَادٗا لِّكَلِمَٰتِ رَبِّي لَنَفِدَ ٱلۡبَحۡرُ قَبۡلَ أَن تَنفَدَ كَلِمَٰتُ رَبِّي وَلَوۡ جِئۡنَا بِمِثۡلِهِۦ مَدَدٗا",
    "ayah_text_no_diacratic" : "قل لو كان البحر مدادا لكلمٰت ربي لنفد البحر قبل ان تنفد كلمٰت ربي ولو جئنا بمثله مددا",
    "ayahnumber" : "109",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2283",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2284",
    "ayah_text" : "قُلۡ إِنَّمَآ أَنَا۠ بَشَرٞ مِّثۡلُكُمۡ يُوحَىٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۖ فَمَن كَانَ يَرۡجُواْ لِقَآءَ رَبِّهِۦ فَلۡيَعۡمَلۡ عَمَلٗا صَٰلِحٗا وَلَا يُشۡرِكۡ بِعِبَادَةِ رَبِّهِۦٓ أَحَدَۢا",
    "ayah_text_no_diacratic" : "قل انما انا بشر مثلكم يوحىٰ الي انما الٰهكم الٰه وٰحد فمن كان يرجوا لقاء ربه فليعمل عملا صٰلحا ولا يشرك بعبادة ربه احدا",
    "ayahnumber" : "110",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2284",
    "page" : "304",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2285",
    "ayah_text" : "سُورَةُ مَرۡيَمَ",
