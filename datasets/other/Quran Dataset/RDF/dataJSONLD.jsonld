    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1688",
    "ayah_text" : "فَلَمَّا جَهَّزَهُم بِجَهَازِهِمۡ جَعَلَ ٱلسِّقَايَةَ فِي رَحۡلِ أَخِيهِ ثُمَّ أَذَّنَ مُؤَذِّنٌ أَيَّتُهَا ٱلۡعِيرُ إِنَّكُمۡ لَسَٰرِقُونَ",
    "ayah_text_no_diacratic" : "فلما جهزهم بجهازهم جعل السقاية في رحل اخيه ثم اذن مؤذن ايتها العير انكم لسٰرقون",
    "ayahnumber" : "70",
    "chapter" : "13",
