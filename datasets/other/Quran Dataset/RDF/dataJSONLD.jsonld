    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4649",
    "ayah_text" : "إِنَّ ٱللَّهَ يُدۡخِلُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ وَٱلَّذِينَ كَفَرُواْ يَتَمَتَّعُونَ وَيَأۡكُلُونَ كَمَا تَأۡكُلُ ٱلۡأَنۡعَٰمُ وَٱلنَّارُ مَثۡوٗى لَّهُمۡ",
    "ayah_text_no_diacratic" : "ان الله يدخل الذين ءامنوا وعملوا الصٰلحٰت جنٰت تجري من تحتها الانهٰر والذين كفروا يتمتعون وياكلون كما تاكل الانعٰم والنار مثوى لهم",
    "ayahnumber" : "12",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4649",
    "page" : "508",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:465",
    "ayah_text" : "وَلِيَعۡلَمَ ٱلَّذِينَ نَافَقُواْۚ وَقِيلَ لَهُمۡ تَعَالَوۡاْ قَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ أَوِ ٱدۡفَعُواْۖ قَالُواْ لَوۡ نَعۡلَمُ قِتَالٗا لَّٱتَّبَعۡنَٰكُمۡۗ هُمۡ لِلۡكُفۡرِ يَوۡمَئِذٍ أَقۡرَبُ مِنۡهُمۡ لِلۡإِيمَٰنِۚ يَقُولُونَ بِأَفۡوَٰهِهِم مَّا لَيۡسَ فِي قُلُوبِهِمۡۚ وَٱللَّهُ أَعۡلَمُ بِمَا يَكۡتُمُونَ",
    "ayah_text_no_diacratic" : "وليعلم الذين نافقوا وقيل لهم تعالوا قٰتلوا في سبيل الله او ادفعوا قالوا لو نعلم قتالا لاتبعنٰكم هم للكفر يومئذ اقرب منهم للايمٰن يقولون بافوٰههم ما ليس في قلوبهم والله اعلم بما يكتمون",
    "ayahnumber" : "167",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "465",
    "page" : "72",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4650",
    "ayah_text" : "وَكَأَيِّن مِّن قَرۡيَةٍ هِيَ أَشَدُّ قُوَّةٗ مِّن قَرۡيَتِكَ ٱلَّتِيٓ أَخۡرَجَتۡكَ أَهۡلَكۡنَٰهُمۡ فَلَا نَاصِرَ لَهُمۡ",
    "ayah_text_no_diacratic" : "وكاين من قرية هي اشد قوة من قريتك التي اخرجتك اهلكنٰهم فلا ناصر لهم",
    "ayahnumber" : "13",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4650",
    "page" : "508",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4651",
    "ayah_text" : "أَفَمَن كَانَ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّهِۦ كَمَن زُيِّنَ لَهُۥ سُوٓءُ عَمَلِهِۦ وَٱتَّبَعُوٓاْ أَهۡوَآءَهُم",
    "ayah_text_no_diacratic" : "افمن كان علىٰ بينة من ربه كمن زين له سوء عمله واتبعوا اهواءهم",
