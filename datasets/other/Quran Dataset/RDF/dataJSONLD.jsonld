    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1873",
    "ayah_text" : "وَإِنَّ جَهَنَّمَ لَمَوۡعِدُهُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "وان جهنم لموعدهم اجمعين",
