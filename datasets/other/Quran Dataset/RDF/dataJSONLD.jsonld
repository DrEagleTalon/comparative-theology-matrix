  }, {
    "@id" : "quran:4821",
    "ayah_text" : "وَقَوۡمَ نُوحٖ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُواْ قَوۡمٗا فَٰسِقِينَ",
    "ayah_text_no_diacratic" : "وقوم نوح من قبل انهم كانوا قوما فٰسقين",
