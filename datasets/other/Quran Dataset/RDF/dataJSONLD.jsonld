    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4911",
    "ayah_text" : "إِنۡ هِيَ إِلَّآ أَسۡمَآءٞ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَآءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىٰٓ",
    "ayah_text_no_diacratic" : "ان هي الا اسماء سميتموها انتم وءاباؤكم ما انزل الله بها من سلطٰن ان يتبعون الا الظن وما تهوى الانفس ولقد جاءهم من ربهم الهدىٰ",
    "ayahnumber" : "23",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4911",
    "page" : "526",
    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4912",
    "ayah_text" : "أَمۡ لِلۡإِنسَٰنِ مَا تَمَنَّىٰ",
    "ayah_text_no_diacratic" : "ام للانسٰن ما تمنىٰ",
    "ayahnumber" : "24",
