    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2651",
    "ayah_text" : "إِنَّ ٱللَّهَ يُدۡخِلُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ إِنَّ ٱللَّهَ يَفۡعَلُ مَا يُرِيدُ",
    "ayah_text_no_diacratic" : "ان الله يدخل الذين ءامنوا وعملوا الصٰلحٰت جنٰت تجري من تحتها الانهٰر ان الله يفعل ما يريد",
    "ayahnumber" : "14",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2651",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2652",
    "ayah_text" : "مَن كَانَ يَظُنُّ أَن لَّن يَنصُرَهُ ٱللَّهُ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ فَلۡيَمۡدُدۡ بِسَبَبٍ إِلَى ٱلسَّمَآءِ ثُمَّ لۡيَقۡطَعۡ فَلۡيَنظُرۡ هَلۡ يُذۡهِبَنَّ كَيۡدُهُۥ مَا يَغِيظُ",
    "ayah_text_no_diacratic" : "من كان يظن ان لن ينصره الله في الدنيا والاخرة فليمدد بسبب الى السماء ثم ليقطع فلينظر هل يذهبن كيده ما يغيظ",
    "ayahnumber" : "15",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2652",
    "page" : "333",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2653",
    "ayah_text" : "وَكَذَٰلِكَ أَنزَلۡنَٰهُ ءَايَٰتِۭ بَيِّنَٰتٖ وَأَنَّ ٱللَّهَ يَهۡدِي مَن يُرِيدُ",
    "ayah_text_no_diacratic" : "وكذٰلك انزلنٰه ءايٰت بينٰت وان الله يهدي من يريد",
    "ayahnumber" : "16",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2653",
    "page" : "334",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2654",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَٱلَّذِينَ هَادُواْ وَٱلصَّٰبِـِٔينَ وَٱلنَّصَٰرَىٰ وَٱلۡمَجُوسَ وَٱلَّذِينَ أَشۡرَكُوٓاْ إِنَّ ٱللَّهَ يَفۡصِلُ بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا والذين هادوا والصٰبين والنصٰرىٰ والمجوس والذين اشركوا ان الله يفصل بينهم يوم القيٰمة ان الله علىٰ كل شيء شهيد",
    "ayahnumber" : "17",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2654",
    "page" : "334",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2655",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱللَّهَ يَسۡجُدُۤ لَهُۥۤ مَن فِي ٱلسَّمَٰوَٰتِ وَمَن فِي ٱلۡأَرۡضِ وَٱلشَّمۡسُ وَٱلۡقَمَرُ وَٱلنُّجُومُ وَٱلۡجِبَالُ وَٱلشَّجَرُ وَٱلدَّوَآبُّ وَكَثِيرٞ مِّنَ ٱلنَّاسِۖ وَكَثِيرٌ حَقَّ عَلَيۡهِ ٱلۡعَذَابُۗ وَمَن يُهِنِ ٱللَّهُ فَمَا لَهُۥ مِن مُّكۡرِمٍۚ إِنَّ ٱللَّهَ يَفۡعَلُ مَا يَشَآءُ۩",
    "ayah_text_no_diacratic" : "الم تر ان الله يسجد له من في السمٰوٰت ومن في الارض والشمس والقمر والنجوم والجبال والشجر والدواب وكثير من الناس وكثير حق عليه العذاب ومن يهن الله فما له من مكرم ان الله يفعل ما يشاء",
    "ayahnumber" : "18",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2655",
    "page" : "334",
    "sajdah" : "1",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2656",
    "ayah_text" : "۞هَٰذَانِ خَصۡمَانِ ٱخۡتَصَمُواْ فِي رَبِّهِمۡۖ فَٱلَّذِينَ كَفَرُواْ قُطِّعَتۡ لَهُمۡ ثِيَابٞ مِّن نَّارٖ يُصَبُّ مِن فَوۡقِ رُءُوسِهِمُ ٱلۡحَمِيمُ",
    "ayah_text_no_diacratic" : "هٰذان خصمان اختصموا في ربهم فالذين كفروا قطعت لهم ثياب من نار يصب من فوق رءوسهم الحميم",
    "ayahnumber" : "19",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2656",
    "page" : "334",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2657",
    "ayah_text" : "يُصۡهَرُ بِهِۦ مَا فِي بُطُونِهِمۡ وَٱلۡجُلُودُ",
    "ayah_text_no_diacratic" : "يصهر به ما في بطونهم والجلود",
    "ayahnumber" : "20",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2657",
    "page" : "334",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2658",
    "ayah_text" : "وَلَهُم مَّقَٰمِعُ مِنۡ حَدِيدٖ",
    "ayah_text_no_diacratic" : "ولهم مقٰمع من حديد",
    "ayahnumber" : "21",
