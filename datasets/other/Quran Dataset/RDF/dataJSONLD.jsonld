  }, {
    "@id" : "quran:2265",
    "ayah_text" : "كَذَٰلِكَۖ وَقَدۡ أَحَطۡنَا بِمَا لَدَيۡهِ خُبۡرٗا",
    "ayah_text_no_diacratic" : "كذٰلك وقد احطنا بما لديه خبرا",
