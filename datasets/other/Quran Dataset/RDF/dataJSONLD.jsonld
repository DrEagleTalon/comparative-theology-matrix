  }, {
    "@id" : "quran:2911",
    "ayah_text" : "أَوۡ يُلۡقَىٰٓ إِلَيۡهِ كَنزٌ أَوۡ تَكُونُ لَهُۥ جَنَّةٞ يَأۡكُلُ مِنۡهَاۚ وَقَالَ ٱلظَّٰلِمُونَ إِن تَتَّبِعُونَ إِلَّا رَجُلٗا مَّسۡحُورًا",
    "ayah_text_no_diacratic" : "او يلقىٰ اليه كنز او تكون له جنة ياكل منها وقال الظٰلمون ان تتبعون الا رجلا مسحورا",
    "ayahnumber" : "8",
    "chapter" : "18",
    "hizb" : "36",
