  }, {
    "@id" : "quran:679",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَوۡفُواْ بِٱلۡعُقُودِۚ أُحِلَّتۡ لَكُم بَهِيمَةُ ٱلۡأَنۡعَٰمِ إِلَّا مَا يُتۡلَىٰ عَلَيۡكُمۡ غَيۡرَ مُحِلِّي ٱلصَّيۡدِ وَأَنتُمۡ حُرُمٌۗ إِنَّ ٱللَّهَ يَحۡكُمُ مَا يُرِيدُ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اوفوا بالعقود احلت لكم بهيمة الانعٰم الا ما يتلىٰ عليكم غير محلي الصيد وانتم حرم ان الله يحكم ما يريد",
    "ayahnumber" : "1",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "679",
