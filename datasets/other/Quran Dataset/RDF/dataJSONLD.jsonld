    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1262",
    "ayah_text" : "فَإِن تَابُواْ وَأَقَامُواْ ٱلصَّلَوٰةَ وَءَاتَوُاْ ٱلزَّكَوٰةَ فَإِخۡوَٰنُكُمۡ فِي ٱلدِّينِۗ وَنُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فان تابوا واقاموا الصلوٰة وءاتوا الزكوٰة فاخوٰنكم في الدين ونفصل الايٰت لقوم يعلمون",
    "ayahnumber" : "11",
    "chapter" : "10",
    "hizb" : "18",
