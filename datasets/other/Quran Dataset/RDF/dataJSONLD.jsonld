    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1012",
    "ayah_text" : "ٱلَّذِينَ يَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَيَبۡغُونَهَا عِوَجٗا وَهُم بِٱلۡأٓخِرَةِ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "الذين يصدون عن سبيل الله ويبغونها عوجا وهم بالاخرة كٰفرون",
