    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3419",
    "ayah_text" : "وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِ ٱللَّهِ وَلِقَآئِهِۦٓ أُوْلَٰٓئِكَ يَئِسُواْ مِن رَّحۡمَتِي وَأُوْلَٰٓئِكَ لَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "والذين كفروا بايٰت الله ولقائه اولٰئك يئسوا من رحمتي واولٰئك لهم عذاب اليم",
    "ayahnumber" : "23",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3419",
    "page" : "398",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:342",
    "ayah_text" : "ذَٰلِكَ مِنۡ أَنۢبَآءِ ٱلۡغَيۡبِ نُوحِيهِ إِلَيۡكَۚ وَمَا كُنتَ لَدَيۡهِمۡ إِذۡ يُلۡقُونَ أَقۡلَٰمَهُمۡ أَيُّهُمۡ يَكۡفُلُ مَرۡيَمَ وَمَا كُنتَ لَدَيۡهِمۡ إِذۡ يَخۡتَصِمُونَ",
    "ayah_text_no_diacratic" : "ذٰلك من انباء الغيب نوحيه اليك وما كنت لديهم اذ يلقون اقلٰمهم ايهم يكفل مريم وما كنت لديهم اذ يختصمون",
    "ayahnumber" : "44",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "342",
    "page" : "55",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3420",
    "ayah_text" : "فَمَا كَانَ جَوَابَ قَوۡمِهِۦٓ إِلَّآ أَن قَالُواْ ٱقۡتُلُوهُ أَوۡ حَرِّقُوهُ فَأَنجَىٰهُ ٱللَّهُ مِنَ ٱلنَّارِۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "فما كان جواب قومه الا ان قالوا اقتلوه او حرقوه فانجىٰه الله من النار ان في ذٰلك لايٰت لقوم يؤمنون",
    "ayahnumber" : "24",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3420",
    "page" : "399",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3421",
    "ayah_text" : "وَقَالَ إِنَّمَا ٱتَّخَذۡتُم مِّن دُونِ ٱللَّهِ أَوۡثَٰنٗا مَّوَدَّةَ بَيۡنِكُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ ثُمَّ يَوۡمَ ٱلۡقِيَٰمَةِ يَكۡفُرُ بَعۡضُكُم بِبَعۡضٖ وَيَلۡعَنُ بَعۡضُكُم بَعۡضٗا وَمَأۡوَىٰكُمُ ٱلنَّارُ وَمَا لَكُم مِّن نَّٰصِرِينَ",
    "ayah_text_no_diacratic" : "وقال انما اتخذتم من دون الله اوثٰنا مودة بينكم في الحيوٰة الدنيا ثم يوم القيٰمة يكفر بعضكم ببعض ويلعن بعضكم بعضا وماوىٰكم النار وما لكم من نٰصرين",
    "ayahnumber" : "25",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3421",
    "page" : "399",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3422",
    "ayah_text" : "۞فَـَٔامَنَ لَهُۥ لُوطٞۘ وَقَالَ إِنِّي مُهَاجِرٌ إِلَىٰ رَبِّيٓۖ إِنَّهُۥ هُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "فامن له لوط وقال اني مهاجر الىٰ ربي انه هو العزيز الحكيم",
    "ayahnumber" : "26",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3422",
    "page" : "399",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3423",
    "ayah_text" : "وَوَهَبۡنَا لَهُۥٓ إِسۡحَٰقَ وَيَعۡقُوبَ وَجَعَلۡنَا فِي ذُرِّيَّتِهِ ٱلنُّبُوَّةَ وَٱلۡكِتَٰبَ وَءَاتَيۡنَٰهُ أَجۡرَهُۥ فِي ٱلدُّنۡيَاۖ وَإِنَّهُۥ فِي ٱلۡأٓخِرَةِ لَمِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "ووهبنا له اسحٰق ويعقوب وجعلنا في ذريته النبوة والكتٰب وءاتينٰه اجره في الدنيا وانه في الاخرة لمن الصٰلحين",
    "ayahnumber" : "27",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3423",
    "page" : "399",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3424",
    "ayah_text" : "وَلُوطًا إِذۡ قَالَ لِقَوۡمِهِۦٓ إِنَّكُمۡ لَتَأۡتُونَ ٱلۡفَٰحِشَةَ مَا سَبَقَكُم بِهَا مِنۡ أَحَدٖ مِّنَ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ولوطا اذ قال لقومه انكم لتاتون الفٰحشة ما سبقكم بها من احد من العٰلمين",
    "ayahnumber" : "28",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3424",
    "page" : "399",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3425",
    "ayah_text" : "أَئِنَّكُمۡ لَتَأۡتُونَ ٱلرِّجَالَ وَتَقۡطَعُونَ ٱلسَّبِيلَ وَتَأۡتُونَ فِي نَادِيكُمُ ٱلۡمُنكَرَۖ فَمَا كَانَ جَوَابَ قَوۡمِهِۦٓ إِلَّآ أَن قَالُواْ ٱئۡتِنَا بِعَذَابِ ٱللَّهِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "ائنكم لتاتون الرجال وتقطعون السبيل وتاتون في ناديكم المنكر فما كان جواب قومه الا ان قالوا ائتنا بعذاب الله ان كنت من الصٰدقين",
    "ayahnumber" : "29",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3425",
    "page" : "399",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3426",
    "ayah_text" : "قَالَ رَبِّ ٱنصُرۡنِي عَلَى ٱلۡقَوۡمِ ٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "قال رب انصرني على القوم المفسدين",
    "ayahnumber" : "30",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3426",
    "page" : "399",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3427",
    "ayah_text" : "وَلَمَّا جَآءَتۡ رُسُلُنَآ إِبۡرَٰهِيمَ بِٱلۡبُشۡرَىٰ قَالُوٓاْ إِنَّا مُهۡلِكُوٓاْ أَهۡلِ هَٰذِهِ ٱلۡقَرۡيَةِۖ إِنَّ أَهۡلَهَا كَانُواْ ظَٰلِمِينَ",
    "ayah_text_no_diacratic" : "ولما جاءت رسلنا ابرٰهيم بالبشرىٰ قالوا انا مهلكوا اهل هٰذه القرية ان اهلها كانوا ظٰلمين",
    "ayahnumber" : "31",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3427",
    "page" : "400",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3428",
    "ayah_text" : "قَالَ إِنَّ فِيهَا لُوطٗاۚ قَالُواْ نَحۡنُ أَعۡلَمُ بِمَن فِيهَاۖ لَنُنَجِّيَنَّهُۥ وَأَهۡلَهُۥٓ إِلَّا ٱمۡرَأَتَهُۥ كَانَتۡ مِنَ ٱلۡغَٰبِرِينَ",
    "ayah_text_no_diacratic" : "قال ان فيها لوطا قالوا نحن اعلم بمن فيها لننجينه واهله الا امراته كانت من الغٰبرين",
    "ayahnumber" : "32",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3428",
    "page" : "400",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3429",
    "ayah_text" : "وَلَمَّآ أَن جَآءَتۡ رُسُلُنَا لُوطٗا سِيٓءَ بِهِمۡ وَضَاقَ بِهِمۡ ذَرۡعٗاۖ وَقَالُواْ لَا تَخَفۡ وَلَا تَحۡزَنۡ إِنَّا مُنَجُّوكَ وَأَهۡلَكَ إِلَّا ٱمۡرَأَتَكَ كَانَتۡ مِنَ ٱلۡغَٰبِرِينَ",
    "ayah_text_no_diacratic" : "ولما ان جاءت رسلنا لوطا سيء بهم وضاق بهم ذرعا وقالوا لا تخف ولا تحزن انا منجوك واهلك الا امراتك كانت من الغٰبرين",
    "ayahnumber" : "33",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3429",
    "page" : "400",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:343",
    "ayah_text" : "إِذۡ قَالَتِ ٱلۡمَلَٰٓئِكَةُ يَٰمَرۡيَمُ إِنَّ ٱللَّهَ يُبَشِّرُكِ بِكَلِمَةٖ مِّنۡهُ ٱسۡمُهُ ٱلۡمَسِيحُ عِيسَى ٱبۡنُ مَرۡيَمَ وَجِيهٗا فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَمِنَ ٱلۡمُقَرَّبِينَ",
    "ayah_text_no_diacratic" : "اذ قالت الملٰئكة يٰمريم ان الله يبشرك بكلمة منه اسمه المسيح عيسى ابن مريم وجيها في الدنيا والاخرة ومن المقربين",
    "ayahnumber" : "45",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "343",
    "page" : "55",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3430",
    "ayah_text" : "إِنَّا مُنزِلُونَ عَلَىٰٓ أَهۡلِ هَٰذِهِ ٱلۡقَرۡيَةِ رِجۡزٗا مِّنَ ٱلسَّمَآءِ بِمَا كَانُواْ يَفۡسُقُونَ",
    "ayah_text_no_diacratic" : "انا منزلون علىٰ اهل هٰذه القرية رجزا من السماء بما كانوا يفسقون",
    "ayahnumber" : "34",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3430",
    "page" : "400",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3431",
    "ayah_text" : "وَلَقَد تَّرَكۡنَا مِنۡهَآ ءَايَةَۢ بَيِّنَةٗ لِّقَوۡمٖ يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ولقد تركنا منها ءاية بينة لقوم يعقلون",
    "ayahnumber" : "35",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3431",
    "page" : "400",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3432",
    "ayah_text" : "وَإِلَىٰ مَدۡيَنَ أَخَاهُمۡ شُعَيۡبٗا فَقَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ وَٱرۡجُواْ ٱلۡيَوۡمَ ٱلۡأٓخِرَ وَلَا تَعۡثَوۡاْ فِي ٱلۡأَرۡضِ مُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "والىٰ مدين اخاهم شعيبا فقال يٰقوم اعبدوا الله وارجوا اليوم الاخر ولا تعثوا في الارض مفسدين",
    "ayahnumber" : "36",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3432",
    "page" : "400",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3433",
    "ayah_text" : "فَكَذَّبُوهُ فَأَخَذَتۡهُمُ ٱلرَّجۡفَةُ فَأَصۡبَحُواْ فِي دَارِهِمۡ جَٰثِمِينَ",
    "ayah_text_no_diacratic" : "فكذبوه فاخذتهم الرجفة فاصبحوا في دارهم جٰثمين",
    "ayahnumber" : "37",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3433",
    "page" : "400",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3434",
    "ayah_text" : "وَعَادٗا وَثَمُودَاْ وَقَد تَّبَيَّنَ لَكُم مِّن مَّسَٰكِنِهِمۡۖ وَزَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ أَعۡمَٰلَهُمۡ فَصَدَّهُمۡ عَنِ ٱلسَّبِيلِ وَكَانُواْ مُسۡتَبۡصِرِينَ",
    "ayah_text_no_diacratic" : "وعادا وثمودا وقد تبين لكم من مسٰكنهم وزين لهم الشيطٰن اعمٰلهم فصدهم عن السبيل وكانوا مستبصرين",
    "ayahnumber" : "38",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3434",
    "page" : "400",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3435",
    "ayah_text" : "وَقَٰرُونَ وَفِرۡعَوۡنَ وَهَٰمَٰنَۖ وَلَقَدۡ جَآءَهُم مُّوسَىٰ بِٱلۡبَيِّنَٰتِ فَٱسۡتَكۡبَرُواْ فِي ٱلۡأَرۡضِ وَمَا كَانُواْ سَٰبِقِينَ",
    "ayah_text_no_diacratic" : "وقٰرون وفرعون وهٰمٰن ولقد جاءهم موسىٰ بالبينٰت فاستكبروا في الارض وما كانوا سٰبقين",
    "ayahnumber" : "39",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3435",
    "page" : "401",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3436",
    "ayah_text" : "فَكُلًّا أَخَذۡنَا بِذَنۢبِهِۦۖ فَمِنۡهُم مَّنۡ أَرۡسَلۡنَا عَلَيۡهِ حَاصِبٗا وَمِنۡهُم مَّنۡ أَخَذَتۡهُ ٱلصَّيۡحَةُ وَمِنۡهُم مَّنۡ خَسَفۡنَا بِهِ ٱلۡأَرۡضَ وَمِنۡهُم مَّنۡ أَغۡرَقۡنَاۚ وَمَا كَانَ ٱللَّهُ لِيَظۡلِمَهُمۡ وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ",
    "ayah_text_no_diacratic" : "فكلا اخذنا بذنبه فمنهم من ارسلنا عليه حاصبا ومنهم من اخذته الصيحة ومنهم من خسفنا به الارض ومنهم من اغرقنا وما كان الله ليظلمهم ولٰكن كانوا انفسهم يظلمون",
    "ayahnumber" : "40",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3436",
    "page" : "401",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3437",
    "ayah_text" : "مَثَلُ ٱلَّذِينَ ٱتَّخَذُواْ مِن دُونِ ٱللَّهِ أَوۡلِيَآءَ كَمَثَلِ ٱلۡعَنكَبُوتِ ٱتَّخَذَتۡ بَيۡتٗاۖ وَإِنَّ أَوۡهَنَ ٱلۡبُيُوتِ لَبَيۡتُ ٱلۡعَنكَبُوتِۚ لَوۡ كَانُواْ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "مثل الذين اتخذوا من دون الله اولياء كمثل العنكبوت اتخذت بيتا وان اوهن البيوت لبيت العنكبوت لو كانوا يعلمون",
    "ayahnumber" : "41",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3437",
    "page" : "401",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3438",
    "ayah_text" : "إِنَّ ٱللَّهَ يَعۡلَمُ مَا يَدۡعُونَ مِن دُونِهِۦ مِن شَيۡءٖۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "ان الله يعلم ما يدعون من دونه من شيء وهو العزيز الحكيم",
    "ayahnumber" : "42",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3438",
    "page" : "401",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3439",
    "ayah_text" : "وَتِلۡكَ ٱلۡأَمۡثَٰلُ نَضۡرِبُهَا لِلنَّاسِۖ وَمَا يَعۡقِلُهَآ إِلَّا ٱلۡعَٰلِمُونَ",
    "ayah_text_no_diacratic" : "وتلك الامثٰل نضربها للناس وما يعقلها الا العٰلمون",
    "ayahnumber" : "43",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3439",
    "page" : "401",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:344",
    "ayah_text" : "وَيُكَلِّمُ ٱلنَّاسَ فِي ٱلۡمَهۡدِ وَكَهۡلٗا وَمِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "ويكلم الناس في المهد وكهلا ومن الصٰلحين",
    "ayahnumber" : "46",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "344",
    "page" : "56",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3440",
    "ayah_text" : "خَلَقَ ٱللَّهُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "خلق الله السمٰوٰت والارض بالحق ان في ذٰلك لاية للمؤمنين",
    "ayahnumber" : "44",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3440",
    "page" : "401",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3441",
    "ayah_text" : "ٱتۡلُ مَآ أُوحِيَ إِلَيۡكَ مِنَ ٱلۡكِتَٰبِ وَأَقِمِ ٱلصَّلَوٰةَۖ إِنَّ ٱلصَّلَوٰةَ تَنۡهَىٰ عَنِ ٱلۡفَحۡشَآءِ وَٱلۡمُنكَرِۗ وَلَذِكۡرُ ٱللَّهِ أَكۡبَرُۗ وَٱللَّهُ يَعۡلَمُ مَا تَصۡنَعُونَ",
    "ayah_text_no_diacratic" : "اتل ما اوحي اليك من الكتٰب واقم الصلوٰة ان الصلوٰة تنهىٰ عن الفحشاء والمنكر ولذكر الله اكبر والله يعلم ما تصنعون",
    "ayahnumber" : "45",
    "chapter" : "20",
    "hizb" : "40",
    "index" : "3441",
    "page" : "401",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3442",
    "ayah_text" : "۞وَلَا تُجَٰدِلُوٓاْ أَهۡلَ ٱلۡكِتَٰبِ إِلَّا بِٱلَّتِي هِيَ أَحۡسَنُ إِلَّا ٱلَّذِينَ ظَلَمُواْ مِنۡهُمۡۖ وَقُولُوٓاْ ءَامَنَّا بِٱلَّذِيٓ أُنزِلَ إِلَيۡنَا وَأُنزِلَ إِلَيۡكُمۡ وَإِلَٰهُنَا وَإِلَٰهُكُمۡ وَٰحِدٞ وَنَحۡنُ لَهُۥ مُسۡلِمُونَ",
    "ayah_text_no_diacratic" : "ولا تجٰدلوا اهل الكتٰب الا بالتي هي احسن الا الذين ظلموا منهم وقولوا ءامنا بالذي انزل الينا وانزل اليكم والٰهنا والٰهكم وٰحد ونحن له مسلمون",
    "ayahnumber" : "46",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3442",
    "page" : "402",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3443",
    "ayah_text" : "وَكَذَٰلِكَ أَنزَلۡنَآ إِلَيۡكَ ٱلۡكِتَٰبَۚ فَٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يُؤۡمِنُونَ بِهِۦۖ وَمِنۡ هَٰٓؤُلَآءِ مَن يُؤۡمِنُ بِهِۦۚ وَمَا يَجۡحَدُ بِـَٔايَٰتِنَآ إِلَّا ٱلۡكَٰفِرُونَ",
    "ayah_text_no_diacratic" : "وكذٰلك انزلنا اليك الكتٰب فالذين ءاتينٰهم الكتٰب يؤمنون به ومن هٰؤلاء من يؤمن به وما يجحد بايٰتنا الا الكٰفرون",
    "ayahnumber" : "47",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3443",
    "page" : "402",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3444",
    "ayah_text" : "وَمَا كُنتَ تَتۡلُواْ مِن قَبۡلِهِۦ مِن كِتَٰبٖ وَلَا تَخُطُّهُۥ بِيَمِينِكَۖ إِذٗا لَّٱرۡتَابَ ٱلۡمُبۡطِلُونَ",
    "ayah_text_no_diacratic" : "وما كنت تتلوا من قبله من كتٰب ولا تخطه بيمينك اذا لارتاب المبطلون",
    "ayahnumber" : "48",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3444",
    "page" : "402",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3445",
    "ayah_text" : "بَلۡ هُوَ ءَايَٰتُۢ بَيِّنَٰتٞ فِي صُدُورِ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَۚ وَمَا يَجۡحَدُ بِـَٔايَٰتِنَآ إِلَّا ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "بل هو ءايٰت بينٰت في صدور الذين اوتوا العلم وما يجحد بايٰتنا الا الظٰلمون",
    "ayahnumber" : "49",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3445",
    "page" : "402",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3446",
    "ayah_text" : "وَقَالُواْ لَوۡلَآ أُنزِلَ عَلَيۡهِ ءَايَٰتٞ مِّن رَّبِّهِۦۚ قُلۡ إِنَّمَا ٱلۡأٓيَٰتُ عِندَ ٱللَّهِ وَإِنَّمَآ أَنَا۠ نَذِيرٞ مُّبِينٌ",
    "ayah_text_no_diacratic" : "وقالوا لولا انزل عليه ءايٰت من ربه قل انما الايٰت عند الله وانما انا نذير مبين",
    "ayahnumber" : "50",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3446",
    "page" : "402",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3447",
    "ayah_text" : "أَوَلَمۡ يَكۡفِهِمۡ أَنَّآ أَنزَلۡنَا عَلَيۡكَ ٱلۡكِتَٰبَ يُتۡلَىٰ عَلَيۡهِمۡۚ إِنَّ فِي ذَٰلِكَ لَرَحۡمَةٗ وَذِكۡرَىٰ لِقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "اولم يكفهم انا انزلنا عليك الكتٰب يتلىٰ عليهم ان في ذٰلك لرحمة وذكرىٰ لقوم يؤمنون",
    "ayahnumber" : "51",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3447",
    "page" : "402",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3448",
    "ayah_text" : "قُلۡ كَفَىٰ بِٱللَّهِ بَيۡنِي وَبَيۡنَكُمۡ شَهِيدٗاۖ يَعۡلَمُ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ وَٱلَّذِينَ ءَامَنُواْ بِٱلۡبَٰطِلِ وَكَفَرُواْ بِٱللَّهِ أُوْلَٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "قل كفىٰ بالله بيني وبينكم شهيدا يعلم ما في السمٰوٰت والارض والذين ءامنوا بالبٰطل وكفروا بالله اولٰئك هم الخٰسرون",
    "ayahnumber" : "52",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3448",
    "page" : "402",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3449",
    "ayah_text" : "وَيَسۡتَعۡجِلُونَكَ بِٱلۡعَذَابِ وَلَوۡلَآ أَجَلٞ مُّسَمّٗى لَّجَآءَهُمُ ٱلۡعَذَابُۚ وَلَيَأۡتِيَنَّهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "ويستعجلونك بالعذاب ولولا اجل مسمى لجاءهم العذاب ولياتينهم بغتة وهم لا يشعرون",
    "ayahnumber" : "53",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3449",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:345",
    "ayah_text" : "قَالَتۡ رَبِّ أَنَّىٰ يَكُونُ لِي وَلَدٞ وَلَمۡ يَمۡسَسۡنِي بَشَرٞۖ قَالَ كَذَٰلِكِ ٱللَّهُ يَخۡلُقُ مَا يَشَآءُۚ إِذَا قَضَىٰٓ أَمۡرٗا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ",
    "ayah_text_no_diacratic" : "قالت رب انىٰ يكون لي ولد ولم يمسسني بشر قال كذٰلك الله يخلق ما يشاء اذا قضىٰ امرا فانما يقول له كن فيكون",
    "ayahnumber" : "47",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "345",
    "page" : "56",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3450",
    "ayah_text" : "يَسۡتَعۡجِلُونَكَ بِٱلۡعَذَابِ وَإِنَّ جَهَنَّمَ لَمُحِيطَةُۢ بِٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "يستعجلونك بالعذاب وان جهنم لمحيطة بالكٰفرين",
    "ayahnumber" : "54",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3450",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3451",
    "ayah_text" : "يَوۡمَ يَغۡشَىٰهُمُ ٱلۡعَذَابُ مِن فَوۡقِهِمۡ وَمِن تَحۡتِ أَرۡجُلِهِمۡ وَيَقُولُ ذُوقُواْ مَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "يوم يغشىٰهم العذاب من فوقهم ومن تحت ارجلهم ويقول ذوقوا ما كنتم تعملون",
    "ayahnumber" : "55",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3451",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3452",
    "ayah_text" : "يَٰعِبَادِيَ ٱلَّذِينَ ءَامَنُوٓاْ إِنَّ أَرۡضِي وَٰسِعَةٞ فَإِيَّٰيَ فَٱعۡبُدُونِ",
    "ayah_text_no_diacratic" : "يٰعبادي الذين ءامنوا ان ارضي وٰسعة فايٰي فاعبدون",
    "ayahnumber" : "56",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3452",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3453",
    "ayah_text" : "كُلُّ نَفۡسٖ ذَآئِقَةُ ٱلۡمَوۡتِۖ ثُمَّ إِلَيۡنَا تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "كل نفس ذائقة الموت ثم الينا ترجعون",
    "ayahnumber" : "57",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3453",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3454",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَنُبَوِّئَنَّهُم مِّنَ ٱلۡجَنَّةِ غُرَفٗا تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ نِعۡمَ أَجۡرُ ٱلۡعَٰمِلِينَ",
    "ayah_text_no_diacratic" : "والذين ءامنوا وعملوا الصٰلحٰت لنبوئنهم من الجنة غرفا تجري من تحتها الانهٰر خٰلدين فيها نعم اجر العٰملين",
    "ayahnumber" : "58",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3454",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3455",
    "ayah_text" : "ٱلَّذِينَ صَبَرُواْ وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ",
    "ayah_text_no_diacratic" : "الذين صبروا وعلىٰ ربهم يتوكلون",
    "ayahnumber" : "59",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3455",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3456",
    "ayah_text" : "وَكَأَيِّن مِّن دَآبَّةٖ لَّا تَحۡمِلُ رِزۡقَهَا ٱللَّهُ يَرۡزُقُهَا وَإِيَّاكُمۡۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "وكاين من دابة لا تحمل رزقها الله يرزقها واياكم وهو السميع العليم",
    "ayahnumber" : "60",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3456",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3457",
    "ayah_text" : "وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَسَخَّرَ ٱلشَّمۡسَ وَٱلۡقَمَرَ لَيَقُولُنَّ ٱللَّهُۖ فَأَنَّىٰ يُؤۡفَكُونَ",
    "ayah_text_no_diacratic" : "ولئن سالتهم من خلق السمٰوٰت والارض وسخر الشمس والقمر ليقولن الله فانىٰ يؤفكون",
    "ayahnumber" : "61",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3457",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3458",
    "ayah_text" : "ٱللَّهُ يَبۡسُطُ ٱلرِّزۡقَ لِمَن يَشَآءُ مِنۡ عِبَادِهِۦ وَيَقۡدِرُ لَهُۥٓۚ إِنَّ ٱللَّهَ بِكُلِّ شَيۡءٍ عَلِيمٞ",
    "ayah_text_no_diacratic" : "الله يبسط الرزق لمن يشاء من عباده ويقدر له ان الله بكل شيء عليم",
    "ayahnumber" : "62",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3458",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3459",
    "ayah_text" : "وَلَئِن سَأَلۡتَهُم مَّن نَّزَّلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَحۡيَا بِهِ ٱلۡأَرۡضَ مِنۢ بَعۡدِ مَوۡتِهَا لَيَقُولُنَّ ٱللَّهُۚ قُلِ ٱلۡحَمۡدُ لِلَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ولئن سالتهم من نزل من السماء ماء فاحيا به الارض من بعد موتها ليقولن الله قل الحمد لله بل اكثرهم لا يعقلون",
    "ayahnumber" : "63",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3459",
    "page" : "403",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:346",
    "ayah_text" : "وَيُعَلِّمُهُ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَٱلتَّوۡرَىٰةَ وَٱلۡإِنجِيلَ",
    "ayah_text_no_diacratic" : "ويعلمه الكتٰب والحكمة والتورىٰة والانجيل",
    "ayahnumber" : "48",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "346",
    "page" : "56",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3460",
    "ayah_text" : "وَمَا هَٰذِهِ ٱلۡحَيَوٰةُ ٱلدُّنۡيَآ إِلَّا لَهۡوٞ وَلَعِبٞۚ وَإِنَّ ٱلدَّارَ ٱلۡأٓخِرَةَ لَهِيَ ٱلۡحَيَوَانُۚ لَوۡ كَانُواْ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وما هٰذه الحيوٰة الدنيا الا لهو ولعب وان الدار الاخرة لهي الحيوان لو كانوا يعلمون",
    "ayahnumber" : "64",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3460",
    "page" : "404",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3461",
    "ayah_text" : "فَإِذَا رَكِبُواْ فِي ٱلۡفُلۡكِ دَعَوُاْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ فَلَمَّا نَجَّىٰهُمۡ إِلَى ٱلۡبَرِّ إِذَا هُمۡ يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "فاذا ركبوا في الفلك دعوا الله مخلصين له الدين فلما نجىٰهم الى البر اذا هم يشركون",
    "ayahnumber" : "65",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3461",
    "page" : "404",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3462",
    "ayah_text" : "لِيَكۡفُرُواْ بِمَآ ءَاتَيۡنَٰهُمۡ وَلِيَتَمَتَّعُواْۚ فَسَوۡفَ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ليكفروا بما ءاتينٰهم وليتمتعوا فسوف يعلمون",
    "ayahnumber" : "66",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3462",
    "page" : "404",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3463",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ أَنَّا جَعَلۡنَا حَرَمًا ءَامِنٗا وَيُتَخَطَّفُ ٱلنَّاسُ مِنۡ حَوۡلِهِمۡۚ أَفَبِٱلۡبَٰطِلِ يُؤۡمِنُونَ وَبِنِعۡمَةِ ٱللَّهِ يَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "اولم يروا انا جعلنا حرما ءامنا ويتخطف الناس من حولهم افبالبٰطل يؤمنون وبنعمة الله يكفرون",
    "ayahnumber" : "67",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3463",
    "page" : "404",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3464",
    "ayah_text" : "وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوۡ كَذَّبَ بِٱلۡحَقِّ لَمَّا جَآءَهُۥٓۚ أَلَيۡسَ فِي جَهَنَّمَ مَثۡوٗى لِّلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ومن اظلم ممن افترىٰ على الله كذبا او كذب بالحق لما جاءه اليس في جهنم مثوى للكٰفرين",
    "ayahnumber" : "68",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3464",
    "page" : "404",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3465",
    "ayah_text" : "وَٱلَّذِينَ جَٰهَدُواْ فِينَا لَنَهۡدِيَنَّهُمۡ سُبُلَنَاۚ وَإِنَّ ٱللَّهَ لَمَعَ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "والذين جٰهدوا فينا لنهدينهم سبلنا وان الله لمع المحسنين",
