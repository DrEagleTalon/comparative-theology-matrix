    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1413",
    "ayah_text" : "قُلۡ مَن يَرۡزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِ أَمَّن يَمۡلِكُ ٱلسَّمۡعَ وَٱلۡأَبۡصَٰرَ وَمَن يُخۡرِجُ ٱلۡحَيَّ مِنَ ٱلۡمَيِّتِ وَيُخۡرِجُ ٱلۡمَيِّتَ مِنَ ٱلۡحَيِّ وَمَن يُدَبِّرُ ٱلۡأَمۡرَۚ فَسَيَقُولُونَ ٱللَّهُۚ فَقُلۡ أَفَلَا تَتَّقُونَ",
    "ayah_text_no_diacratic" : "قل من يرزقكم من السماء والارض امن يملك السمع والابصٰر ومن يخرج الحي من الميت ويخرج الميت من الحي ومن يدبر الامر فسيقولون الله فقل افلا تتقون",
    "ayahnumber" : "31",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1413",
    "page" : "212",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1414",
    "ayah_text" : "فَذَٰلِكُمُ ٱللَّهُ رَبُّكُمُ ٱلۡحَقُّۖ فَمَاذَا بَعۡدَ ٱلۡحَقِّ إِلَّا ٱلضَّلَٰلُۖ فَأَنَّىٰ تُصۡرَفُونَ",
    "ayah_text_no_diacratic" : "فذٰلكم الله ربكم الحق فماذا بعد الحق الا الضلٰل فانىٰ تصرفون",
    "ayahnumber" : "32",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1414",
    "page" : "212",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1415",
    "ayah_text" : "كَذَٰلِكَ حَقَّتۡ كَلِمَتُ رَبِّكَ عَلَى ٱلَّذِينَ فَسَقُوٓاْ أَنَّهُمۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "كذٰلك حقت كلمت ربك على الذين فسقوا انهم لا يؤمنون",
    "ayahnumber" : "33",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1415",
    "page" : "212",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1416",
    "ayah_text" : "قُلۡ هَلۡ مِن شُرَكَآئِكُم مَّن يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥۚ قُلِ ٱللَّهُ يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥۖ فَأَنَّىٰ تُؤۡفَكُونَ",
    "ayah_text_no_diacratic" : "قل هل من شركائكم من يبدؤا الخلق ثم يعيده قل الله يبدؤا الخلق ثم يعيده فانىٰ تؤفكون",
    "ayahnumber" : "34",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1416",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1417",
    "ayah_text" : "قُلۡ هَلۡ مِن شُرَكَآئِكُم مَّن يَهۡدِيٓ إِلَى ٱلۡحَقِّۚ قُلِ ٱللَّهُ يَهۡدِي لِلۡحَقِّۗ أَفَمَن يَهۡدِيٓ إِلَى ٱلۡحَقِّ أَحَقُّ أَن يُتَّبَعَ أَمَّن لَّا يَهِدِّيٓ إِلَّآ أَن يُهۡدَىٰۖ فَمَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ",
    "ayah_text_no_diacratic" : "قل هل من شركائكم من يهدي الى الحق قل الله يهدي للحق افمن يهدي الى الحق احق ان يتبع امن لا يهدي الا ان يهدىٰ فما لكم كيف تحكمون",
    "ayahnumber" : "35",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1417",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1418",
    "ayah_text" : "وَمَا يَتَّبِعُ أَكۡثَرُهُمۡ إِلَّا ظَنًّاۚ إِنَّ ٱلظَّنَّ لَا يُغۡنِي مِنَ ٱلۡحَقِّ شَيۡـًٔاۚ إِنَّ ٱللَّهَ عَلِيمُۢ بِمَا يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "وما يتبع اكثرهم الا ظنا ان الظن لا يغني من الحق شيا ان الله عليم بما يفعلون",
    "ayahnumber" : "36",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1418",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1419",
    "ayah_text" : "وَمَا كَانَ هَٰذَا ٱلۡقُرۡءَانُ أَن يُفۡتَرَىٰ مِن دُونِ ٱللَّهِ وَلَٰكِن تَصۡدِيقَ ٱلَّذِي بَيۡنَ يَدَيۡهِ وَتَفۡصِيلَ ٱلۡكِتَٰبِ لَا رَيۡبَ فِيهِ مِن رَّبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "وما كان هٰذا القرءان ان يفترىٰ من دون الله ولٰكن تصديق الذي بين يديه وتفصيل الكتٰب لا ريب فيه من رب العٰلمين",
    "ayahnumber" : "37",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1419",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:142",
    "ayah_text" : "وَوَصَّىٰ بِهَآ إِبۡرَٰهِـۧمُ بَنِيهِ وَيَعۡقُوبُ يَٰبَنِيَّ إِنَّ ٱللَّهَ ٱصۡطَفَىٰ لَكُمُ ٱلدِّينَ فَلَا تَمُوتُنَّ إِلَّا وَأَنتُم مُّسۡلِمُونَ",
    "ayah_text_no_diacratic" : "ووصىٰ بها ابرٰهم بنيه ويعقوب يٰبني ان الله اصطفىٰ لكم الدين فلا تموتن الا وانتم مسلمون",
    "ayahnumber" : "132",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "142",
    "page" : "20",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1420",
    "ayah_text" : "أَمۡ يَقُولُونَ ٱفۡتَرَىٰهُۖ قُلۡ فَأۡتُواْ بِسُورَةٖ مِّثۡلِهِۦ وَٱدۡعُواْ مَنِ ٱسۡتَطَعۡتُم مِّن دُونِ ٱللَّهِ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ام يقولون افترىٰه قل فاتوا بسورة مثله وادعوا من استطعتم من دون الله ان كنتم صٰدقين",
    "ayahnumber" : "38",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1420",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1421",
    "ayah_text" : "بَلۡ كَذَّبُواْ بِمَا لَمۡ يُحِيطُواْ بِعِلۡمِهِۦ وَلَمَّا يَأۡتِهِمۡ تَأۡوِيلُهُۥۚ كَذَٰلِكَ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡۖ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "بل كذبوا بما لم يحيطوا بعلمه ولما ياتهم تاويله كذٰلك كذب الذين من قبلهم فانظر كيف كان عٰقبة الظٰلمين",
    "ayahnumber" : "39",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1421",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1422",
    "ayah_text" : "وَمِنۡهُم مَّن يُؤۡمِنُ بِهِۦ وَمِنۡهُم مَّن لَّا يُؤۡمِنُ بِهِۦۚ وَرَبُّكَ أَعۡلَمُ بِٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "ومنهم من يؤمن به ومنهم من لا يؤمن به وربك اعلم بالمفسدين",
    "ayahnumber" : "40",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1422",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1423",
    "ayah_text" : "وَإِن كَذَّبُوكَ فَقُل لِّي عَمَلِي وَلَكُمۡ عَمَلُكُمۡۖ أَنتُم بَرِيٓـُٔونَ مِمَّآ أَعۡمَلُ وَأَنَا۠ بَرِيٓءٞ مِّمَّا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "وان كذبوك فقل لي عملي ولكم عملكم انتم بريون مما اعمل وانا بريء مما تعملون",
    "ayahnumber" : "41",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1423",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1424",
    "ayah_text" : "وَمِنۡهُم مَّن يَسۡتَمِعُونَ إِلَيۡكَۚ أَفَأَنتَ تُسۡمِعُ ٱلصُّمَّ وَلَوۡ كَانُواْ لَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ومنهم من يستمعون اليك افانت تسمع الصم ولو كانوا لا يعقلون",
    "ayahnumber" : "42",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1424",
    "page" : "213",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1425",
    "ayah_text" : "وَمِنۡهُم مَّن يَنظُرُ إِلَيۡكَۚ أَفَأَنتَ تَهۡدِي ٱلۡعُمۡيَ وَلَوۡ كَانُواْ لَا يُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "ومنهم من ينظر اليك افانت تهدي العمي ولو كانوا لا يبصرون",
    "ayahnumber" : "43",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1425",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1426",
    "ayah_text" : "إِنَّ ٱللَّهَ لَا يَظۡلِمُ ٱلنَّاسَ شَيۡـٔٗا وَلَٰكِنَّ ٱلنَّاسَ أَنفُسَهُمۡ يَظۡلِمُونَ",
    "ayah_text_no_diacratic" : "ان الله لا يظلم الناس شيا ولٰكن الناس انفسهم يظلمون",
    "ayahnumber" : "44",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1426",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1427",
    "ayah_text" : "وَيَوۡمَ يَحۡشُرُهُمۡ كَأَن لَّمۡ يَلۡبَثُوٓاْ إِلَّا سَاعَةٗ مِّنَ ٱلنَّهَارِ يَتَعَارَفُونَ بَيۡنَهُمۡۚ قَدۡ خَسِرَ ٱلَّذِينَ كَذَّبُواْ بِلِقَآءِ ٱللَّهِ وَمَا كَانُواْ مُهۡتَدِينَ",
    "ayah_text_no_diacratic" : "ويوم يحشرهم كان لم يلبثوا الا ساعة من النهار يتعارفون بينهم قد خسر الذين كذبوا بلقاء الله وما كانوا مهتدين",
    "ayahnumber" : "45",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1427",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1428",
    "ayah_text" : "وَإِمَّا نُرِيَنَّكَ بَعۡضَ ٱلَّذِي نَعِدُهُمۡ أَوۡ نَتَوَفَّيَنَّكَ فَإِلَيۡنَا مَرۡجِعُهُمۡ ثُمَّ ٱللَّهُ شَهِيدٌ عَلَىٰ مَا يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "واما نرينك بعض الذي نعدهم او نتوفينك فالينا مرجعهم ثم الله شهيد علىٰ ما يفعلون",
    "ayahnumber" : "46",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1428",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1429",
    "ayah_text" : "وَلِكُلِّ أُمَّةٖ رَّسُولٞۖ فَإِذَا جَآءَ رَسُولُهُمۡ قُضِيَ بَيۡنَهُم بِٱلۡقِسۡطِ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولكل امة رسول فاذا جاء رسولهم قضي بينهم بالقسط وهم لا يظلمون",
    "ayahnumber" : "47",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1429",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:143",
    "ayah_text" : "أَمۡ كُنتُمۡ شُهَدَآءَ إِذۡ حَضَرَ يَعۡقُوبَ ٱلۡمَوۡتُ إِذۡ قَالَ لِبَنِيهِ مَا تَعۡبُدُونَ مِنۢ بَعۡدِيۖ قَالُواْ نَعۡبُدُ إِلَٰهَكَ وَإِلَٰهَ ءَابَآئِكَ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ إِلَٰهٗا وَٰحِدٗا وَنَحۡنُ لَهُۥ مُسۡلِمُونَ",
    "ayah_text_no_diacratic" : "ام كنتم شهداء اذ حضر يعقوب الموت اذ قال لبنيه ما تعبدون من بعدي قالوا نعبد الٰهك والٰه ءابائك ابرٰهم واسمٰعيل واسحٰق الٰها وٰحدا ونحن له مسلمون",
    "ayahnumber" : "133",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "143",
    "page" : "20",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1430",
    "ayah_text" : "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ويقولون متىٰ هٰذا الوعد ان كنتم صٰدقين",
    "ayahnumber" : "48",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1430",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1431",
    "ayah_text" : "قُل لَّآ أَمۡلِكُ لِنَفۡسِي ضَرّٗا وَلَا نَفۡعًا إِلَّا مَا شَآءَ ٱللَّهُۗ لِكُلِّ أُمَّةٍ أَجَلٌۚ إِذَا جَآءَ أَجَلُهُمۡ فَلَا يَسۡتَـٔۡخِرُونَ سَاعَةٗ وَلَا يَسۡتَقۡدِمُونَ",
    "ayah_text_no_diacratic" : "قل لا املك لنفسي ضرا ولا نفعا الا ما شاء الله لكل امة اجل اذا جاء اجلهم فلا يستخرون ساعة ولا يستقدمون",
    "ayahnumber" : "49",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1431",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1432",
    "ayah_text" : "قُلۡ أَرَءَيۡتُمۡ إِنۡ أَتَىٰكُمۡ عَذَابُهُۥ بَيَٰتًا أَوۡ نَهَارٗا مَّاذَا يَسۡتَعۡجِلُ مِنۡهُ ٱلۡمُجۡرِمُونَ",
    "ayah_text_no_diacratic" : "قل ارءيتم ان اتىٰكم عذابه بيٰتا او نهارا ماذا يستعجل منه المجرمون",
    "ayahnumber" : "50",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1432",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1433",
    "ayah_text" : "أَثُمَّ إِذَا مَا وَقَعَ ءَامَنتُم بِهِۦٓۚ ءَآلۡـَٰٔنَ وَقَدۡ كُنتُم بِهِۦ تَسۡتَعۡجِلُونَ",
    "ayah_text_no_diacratic" : "اثم اذا ما وقع ءامنتم به ءالٰن وقد كنتم به تستعجلون",
    "ayahnumber" : "51",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1433",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1434",
    "ayah_text" : "ثُمَّ قِيلَ لِلَّذِينَ ظَلَمُواْ ذُوقُواْ عَذَابَ ٱلۡخُلۡدِ هَلۡ تُجۡزَوۡنَ إِلَّا بِمَا كُنتُمۡ تَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "ثم قيل للذين ظلموا ذوقوا عذاب الخلد هل تجزون الا بما كنتم تكسبون",
    "ayahnumber" : "52",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1434",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1435",
    "ayah_text" : "۞وَيَسۡتَنۢبِـُٔونَكَ أَحَقٌّ هُوَۖ قُلۡ إِي وَرَبِّيٓ إِنَّهُۥ لَحَقّٞۖ وَمَآ أَنتُم بِمُعۡجِزِينَ",
    "ayah_text_no_diacratic" : "ويستنبونك احق هو قل اي وربي انه لحق وما انتم بمعجزين",
    "ayahnumber" : "53",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1435",
    "page" : "214",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1436",
    "ayah_text" : "وَلَوۡ أَنَّ لِكُلِّ نَفۡسٖ ظَلَمَتۡ مَا فِي ٱلۡأَرۡضِ لَٱفۡتَدَتۡ بِهِۦۗ وَأَسَرُّواْ ٱلنَّدَامَةَ لَمَّا رَأَوُاْ ٱلۡعَذَابَۖ وَقُضِيَ بَيۡنَهُم بِٱلۡقِسۡطِ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولو ان لكل نفس ظلمت ما في الارض لافتدت به واسروا الندامة لما راوا العذاب وقضي بينهم بالقسط وهم لا يظلمون",
    "ayahnumber" : "54",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1436",
    "page" : "215",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1437",
    "ayah_text" : "أَلَآ إِنَّ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ أَلَآ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "الا ان لله ما في السمٰوٰت والارض الا ان وعد الله حق ولٰكن اكثرهم لا يعلمون",
    "ayahnumber" : "55",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1437",
    "page" : "215",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1438",
    "ayah_text" : "هُوَ يُحۡيِۦ وَيُمِيتُ وَإِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "هو يحي ويميت واليه ترجعون",
    "ayahnumber" : "56",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1438",
    "page" : "215",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1439",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ قَدۡ جَآءَتۡكُم مَّوۡعِظَةٞ مِّن رَّبِّكُمۡ وَشِفَآءٞ لِّمَا فِي ٱلصُّدُورِ وَهُدٗى وَرَحۡمَةٞ لِّلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "يٰايها الناس قد جاءتكم موعظة من ربكم وشفاء لما في الصدور وهدى ورحمة للمؤمنين",
    "ayahnumber" : "57",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1439",
    "page" : "215",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:144",
    "ayah_text" : "تِلۡكَ أُمَّةٞ قَدۡ خَلَتۡۖ لَهَا مَا كَسَبَتۡ وَلَكُم مَّا كَسَبۡتُمۡۖ وَلَا تُسۡـَٔلُونَ عَمَّا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "تلك امة قد خلت لها ما كسبت ولكم ما كسبتم ولا تسلون عما كانوا يعملون",
    "ayahnumber" : "134",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "144",
    "page" : "20",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1440",
    "ayah_text" : "قُلۡ بِفَضۡلِ ٱللَّهِ وَبِرَحۡمَتِهِۦ فَبِذَٰلِكَ فَلۡيَفۡرَحُواْ هُوَ خَيۡرٞ مِّمَّا يَجۡمَعُونَ",
    "ayah_text_no_diacratic" : "قل بفضل الله وبرحمته فبذٰلك فليفرحوا هو خير مما يجمعون",
    "ayahnumber" : "58",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1440",
    "page" : "215",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1441",
    "ayah_text" : "قُلۡ أَرَءَيۡتُم مَّآ أَنزَلَ ٱللَّهُ لَكُم مِّن رِّزۡقٖ فَجَعَلۡتُم مِّنۡهُ حَرَامٗا وَحَلَٰلٗا قُلۡ ءَآللَّهُ أَذِنَ لَكُمۡۖ أَمۡ عَلَى ٱللَّهِ تَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "قل ارءيتم ما انزل الله لكم من رزق فجعلتم منه حراما وحلٰلا قل ءالله اذن لكم ام على الله تفترون",
    "ayahnumber" : "59",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1441",
    "page" : "215",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1442",
    "ayah_text" : "وَمَا ظَنُّ ٱلَّذِينَ يَفۡتَرُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ يَوۡمَ ٱلۡقِيَٰمَةِۗ إِنَّ ٱللَّهَ لَذُو فَضۡلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "وما ظن الذين يفترون على الله الكذب يوم القيٰمة ان الله لذو فضل على الناس ولٰكن اكثرهم لا يشكرون",
    "ayahnumber" : "60",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1442",
    "page" : "215",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1443",
    "ayah_text" : "وَمَا تَكُونُ فِي شَأۡنٖ وَمَا تَتۡلُواْ مِنۡهُ مِن قُرۡءَانٖ وَلَا تَعۡمَلُونَ مِنۡ عَمَلٍ إِلَّا كُنَّا عَلَيۡكُمۡ شُهُودًا إِذۡ تُفِيضُونَ فِيهِۚ وَمَا يَعۡزُبُ عَن رَّبِّكَ مِن مِّثۡقَالِ ذَرَّةٖ فِي ٱلۡأَرۡضِ وَلَا فِي ٱلسَّمَآءِ وَلَآ أَصۡغَرَ مِن ذَٰلِكَ وَلَآ أَكۡبَرَ إِلَّا فِي كِتَٰبٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "وما تكون في شان وما تتلوا منه من قرءان ولا تعملون من عمل الا كنا عليكم شهودا اذ تفيضون فيه وما يعزب عن ربك من مثقال ذرة في الارض ولا في السماء ولا اصغر من ذٰلك ولا اكبر الا في كتٰب مبين",
    "ayahnumber" : "61",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1443",
    "page" : "215",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1444",
    "ayah_text" : "أَلَآ إِنَّ أَوۡلِيَآءَ ٱللَّهِ لَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "الا ان اولياء الله لا خوف عليهم ولا هم يحزنون",
    "ayahnumber" : "62",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1444",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1445",
    "ayah_text" : "ٱلَّذِينَ ءَامَنُواْ وَكَانُواْ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "الذين ءامنوا وكانوا يتقون",
    "ayahnumber" : "63",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1445",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1446",
    "ayah_text" : "لَهُمُ ٱلۡبُشۡرَىٰ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَفِي ٱلۡأٓخِرَةِۚ لَا تَبۡدِيلَ لِكَلِمَٰتِ ٱللَّهِۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "لهم البشرىٰ في الحيوٰة الدنيا وفي الاخرة لا تبديل لكلمٰت الله ذٰلك هو الفوز العظيم",
    "ayahnumber" : "64",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1446",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1447",
    "ayah_text" : "وَلَا يَحۡزُنكَ قَوۡلُهُمۡۘ إِنَّ ٱلۡعِزَّةَ لِلَّهِ جَمِيعًاۚ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "ولا يحزنك قولهم ان العزة لله جميعا هو السميع العليم",
    "ayahnumber" : "65",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1447",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1448",
    "ayah_text" : "أَلَآ إِنَّ لِلَّهِ مَن فِي ٱلسَّمَٰوَٰتِ وَمَن فِي ٱلۡأَرۡضِۗ وَمَا يَتَّبِعُ ٱلَّذِينَ يَدۡعُونَ مِن دُونِ ٱللَّهِ شُرَكَآءَۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنۡ هُمۡ إِلَّا يَخۡرُصُونَ",
    "ayah_text_no_diacratic" : "الا ان لله من في السمٰوٰت ومن في الارض وما يتبع الذين يدعون من دون الله شركاء ان يتبعون الا الظن وان هم الا يخرصون",
    "ayahnumber" : "66",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1448",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1449",
    "ayah_text" : "هُوَ ٱلَّذِي جَعَلَ لَكُمُ ٱلَّيۡلَ لِتَسۡكُنُواْ فِيهِ وَٱلنَّهَارَ مُبۡصِرًاۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَسۡمَعُونَ",
    "ayah_text_no_diacratic" : "هو الذي جعل لكم اليل لتسكنوا فيه والنهار مبصرا ان في ذٰلك لايٰت لقوم يسمعون",
    "ayahnumber" : "67",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1449",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:145",
    "ayah_text" : "وَقَالُواْ كُونُواْ هُودًا أَوۡ نَصَٰرَىٰ تَهۡتَدُواْۗ قُلۡ بَلۡ مِلَّةَ إِبۡرَٰهِـۧمَ حَنِيفٗاۖ وَمَا كَانَ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "وقالوا كونوا هودا او نصٰرىٰ تهتدوا قل بل ملة ابرٰهم حنيفا وما كان من المشركين",
    "ayahnumber" : "135",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "145",
    "page" : "21",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1450",
    "ayah_text" : "قَالُواْ ٱتَّخَذَ ٱللَّهُ وَلَدٗاۗ سُبۡحَٰنَهُۥۖ هُوَ ٱلۡغَنِيُّۖ لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ إِنۡ عِندَكُم مِّن سُلۡطَٰنِۭ بِهَٰذَآۚ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قالوا اتخذ الله ولدا سبحٰنه هو الغني له ما في السمٰوٰت وما في الارض ان عندكم من سلطٰن بهٰذا اتقولون على الله ما لا تعلمون",
    "ayahnumber" : "68",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1450",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1451",
    "ayah_text" : "قُلۡ إِنَّ ٱلَّذِينَ يَفۡتَرُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ لَا يُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "قل ان الذين يفترون على الله الكذب لا يفلحون",
    "ayahnumber" : "69",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1451",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1452",
    "ayah_text" : "مَتَٰعٞ فِي ٱلدُّنۡيَا ثُمَّ إِلَيۡنَا مَرۡجِعُهُمۡ ثُمَّ نُذِيقُهُمُ ٱلۡعَذَابَ ٱلشَّدِيدَ بِمَا كَانُواْ يَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "متٰع في الدنيا ثم الينا مرجعهم ثم نذيقهم العذاب الشديد بما كانوا يكفرون",
    "ayahnumber" : "70",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1452",
    "page" : "216",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1453",
    "ayah_text" : "۞وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ نُوحٍ إِذۡ قَالَ لِقَوۡمِهِۦ يَٰقَوۡمِ إِن كَانَ كَبُرَ عَلَيۡكُم مَّقَامِي وَتَذۡكِيرِي بِـَٔايَٰتِ ٱللَّهِ فَعَلَى ٱللَّهِ تَوَكَّلۡتُ فَأَجۡمِعُوٓاْ أَمۡرَكُمۡ وَشُرَكَآءَكُمۡ ثُمَّ لَا يَكُنۡ أَمۡرُكُمۡ عَلَيۡكُمۡ غُمَّةٗ ثُمَّ ٱقۡضُوٓاْ إِلَيَّ وَلَا تُنظِرُونِ",
    "ayah_text_no_diacratic" : "واتل عليهم نبا نوح اذ قال لقومه يٰقوم ان كان كبر عليكم مقامي وتذكيري بايٰت الله فعلى الله توكلت فاجمعوا امركم وشركاءكم ثم لا يكن امركم عليكم غمة ثم اقضوا الي ولا تنظرون",
    "ayahnumber" : "71",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1453",
    "page" : "217",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1454",
    "ayah_text" : "فَإِن تَوَلَّيۡتُمۡ فَمَا سَأَلۡتُكُم مِّنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَى ٱللَّهِۖ وَأُمِرۡتُ أَنۡ أَكُونَ مِنَ ٱلۡمُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "فان توليتم فما سالتكم من اجر ان اجري الا على الله وامرت ان اكون من المسلمين",
    "ayahnumber" : "72",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1454",
    "page" : "217",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1455",
    "ayah_text" : "فَكَذَّبُوهُ فَنَجَّيۡنَٰهُ وَمَن مَّعَهُۥ فِي ٱلۡفُلۡكِ وَجَعَلۡنَٰهُمۡ خَلَٰٓئِفَ وَأَغۡرَقۡنَا ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَاۖ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ",
    "ayah_text_no_diacratic" : "فكذبوه فنجينٰه ومن معه في الفلك وجعلنٰهم خلٰئف واغرقنا الذين كذبوا بايٰتنا فانظر كيف كان عٰقبة المنذرين",
    "ayahnumber" : "73",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1455",
    "page" : "217",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1456",
    "ayah_text" : "ثُمَّ بَعَثۡنَا مِنۢ بَعۡدِهِۦ رُسُلًا إِلَىٰ قَوۡمِهِمۡ فَجَآءُوهُم بِٱلۡبَيِّنَٰتِ فَمَا كَانُواْ لِيُؤۡمِنُواْ بِمَا كَذَّبُواْ بِهِۦ مِن قَبۡلُۚ كَذَٰلِكَ نَطۡبَعُ عَلَىٰ قُلُوبِ ٱلۡمُعۡتَدِينَ",
    "ayah_text_no_diacratic" : "ثم بعثنا من بعده رسلا الىٰ قومهم فجاءوهم بالبينٰت فما كانوا ليؤمنوا بما كذبوا به من قبل كذٰلك نطبع علىٰ قلوب المعتدين",
    "ayahnumber" : "74",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1456",
    "page" : "217",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1457",
    "ayah_text" : "ثُمَّ بَعَثۡنَا مِنۢ بَعۡدِهِم مُّوسَىٰ وَهَٰرُونَ إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦ بِـَٔايَٰتِنَا فَٱسۡتَكۡبَرُواْ وَكَانُواْ قَوۡمٗا مُّجۡرِمِينَ",
    "ayah_text_no_diacratic" : "ثم بعثنا من بعدهم موسىٰ وهٰرون الىٰ فرعون وملايه بايٰتنا فاستكبروا وكانوا قوما مجرمين",
    "ayahnumber" : "75",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1457",
    "page" : "217",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1458",
    "ayah_text" : "فَلَمَّا جَآءَهُمُ ٱلۡحَقُّ مِنۡ عِندِنَا قَالُوٓاْ إِنَّ هَٰذَا لَسِحۡرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "فلما جاءهم الحق من عندنا قالوا ان هٰذا لسحر مبين",
    "ayahnumber" : "76",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1458",
    "page" : "217",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1459",
    "ayah_text" : "قَالَ مُوسَىٰٓ أَتَقُولُونَ لِلۡحَقِّ لَمَّا جَآءَكُمۡۖ أَسِحۡرٌ هَٰذَا وَلَا يُفۡلِحُ ٱلسَّٰحِرُونَ",
    "ayah_text_no_diacratic" : "قال موسىٰ اتقولون للحق لما جاءكم اسحر هٰذا ولا يفلح السٰحرون",
    "ayahnumber" : "77",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1459",
    "page" : "217",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:146",
    "ayah_text" : "قُولُوٓاْ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ إِلَيۡنَا وَمَآ أُنزِلَ إِلَىٰٓ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ وَيَعۡقُوبَ وَٱلۡأَسۡبَاطِ وَمَآ أُوتِيَ مُوسَىٰ وَعِيسَىٰ وَمَآ أُوتِيَ ٱلنَّبِيُّونَ مِن رَّبِّهِمۡ لَا نُفَرِّقُ بَيۡنَ أَحَدٖ مِّنۡهُمۡ وَنَحۡنُ لَهُۥ مُسۡلِمُونَ",
    "ayah_text_no_diacratic" : "قولوا ءامنا بالله وما انزل الينا وما انزل الىٰ ابرٰهم واسمٰعيل واسحٰق ويعقوب والاسباط وما اوتي موسىٰ وعيسىٰ وما اوتي النبيون من ربهم لا نفرق بين احد منهم ونحن له مسلمون",
    "ayahnumber" : "136",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "146",
    "page" : "21",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1460",
    "ayah_text" : "قَالُوٓاْ أَجِئۡتَنَا لِتَلۡفِتَنَا عَمَّا وَجَدۡنَا عَلَيۡهِ ءَابَآءَنَا وَتَكُونَ لَكُمَا ٱلۡكِبۡرِيَآءُ فِي ٱلۡأَرۡضِ وَمَا نَحۡنُ لَكُمَا بِمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "قالوا اجئتنا لتلفتنا عما وجدنا عليه ءاباءنا وتكون لكما الكبرياء في الارض وما نحن لكما بمؤمنين",
    "ayahnumber" : "78",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1460",
    "page" : "217",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1461",
    "ayah_text" : "وَقَالَ فِرۡعَوۡنُ ٱئۡتُونِي بِكُلِّ سَٰحِرٍ عَلِيمٖ",
    "ayah_text_no_diacratic" : "وقال فرعون ائتوني بكل سٰحر عليم",
    "ayahnumber" : "79",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1461",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1462",
    "ayah_text" : "فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالَ لَهُم مُّوسَىٰٓ أَلۡقُواْ مَآ أَنتُم مُّلۡقُونَ",
    "ayah_text_no_diacratic" : "فلما جاء السحرة قال لهم موسىٰ القوا ما انتم ملقون",
    "ayahnumber" : "80",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1462",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1463",
    "ayah_text" : "فَلَمَّآ أَلۡقَوۡاْ قَالَ مُوسَىٰ مَا جِئۡتُم بِهِ ٱلسِّحۡرُۖ إِنَّ ٱللَّهَ سَيُبۡطِلُهُۥٓ إِنَّ ٱللَّهَ لَا يُصۡلِحُ عَمَلَ ٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "فلما القوا قال موسىٰ ما جئتم به السحر ان الله سيبطله ان الله لا يصلح عمل المفسدين",
    "ayahnumber" : "81",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1463",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1464",
    "ayah_text" : "وَيُحِقُّ ٱللَّهُ ٱلۡحَقَّ بِكَلِمَٰتِهِۦ وَلَوۡ كَرِهَ ٱلۡمُجۡرِمُونَ",
    "ayah_text_no_diacratic" : "ويحق الله الحق بكلمٰته ولو كره المجرمون",
    "ayahnumber" : "82",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1464",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1465",
    "ayah_text" : "فَمَآ ءَامَنَ لِمُوسَىٰٓ إِلَّا ذُرِّيَّةٞ مِّن قَوۡمِهِۦ عَلَىٰ خَوۡفٖ مِّن فِرۡعَوۡنَ وَمَلَإِيْهِمۡ أَن يَفۡتِنَهُمۡۚ وَإِنَّ فِرۡعَوۡنَ لَعَالٖ فِي ٱلۡأَرۡضِ وَإِنَّهُۥ لَمِنَ ٱلۡمُسۡرِفِينَ",
    "ayah_text_no_diacratic" : "فما ءامن لموسىٰ الا ذرية من قومه علىٰ خوف من فرعون وملايهم ان يفتنهم وان فرعون لعال في الارض وانه لمن المسرفين",
    "ayahnumber" : "83",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1465",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1466",
    "ayah_text" : "وَقَالَ مُوسَىٰ يَٰقَوۡمِ إِن كُنتُمۡ ءَامَنتُم بِٱللَّهِ فَعَلَيۡهِ تَوَكَّلُوٓاْ إِن كُنتُم مُّسۡلِمِينَ",
    "ayah_text_no_diacratic" : "وقال موسىٰ يٰقوم ان كنتم ءامنتم بالله فعليه توكلوا ان كنتم مسلمين",
    "ayahnumber" : "84",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1466",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1467",
    "ayah_text" : "فَقَالُواْ عَلَى ٱللَّهِ تَوَكَّلۡنَا رَبَّنَا لَا تَجۡعَلۡنَا فِتۡنَةٗ لِّلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "فقالوا على الله توكلنا ربنا لا تجعلنا فتنة للقوم الظٰلمين",
    "ayahnumber" : "85",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1467",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1468",
    "ayah_text" : "وَنَجِّنَا بِرَحۡمَتِكَ مِنَ ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ونجنا برحمتك من القوم الكٰفرين",
    "ayahnumber" : "86",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1468",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1469",
    "ayah_text" : "وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰ وَأَخِيهِ أَن تَبَوَّءَا لِقَوۡمِكُمَا بِمِصۡرَ بُيُوتٗا وَٱجۡعَلُواْ بُيُوتَكُمۡ قِبۡلَةٗ وَأَقِيمُواْ ٱلصَّلَوٰةَۗ وَبَشِّرِ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "واوحينا الىٰ موسىٰ واخيه ان تبوءا لقومكما بمصر بيوتا واجعلوا بيوتكم قبلة واقيموا الصلوٰة وبشر المؤمنين",
    "ayahnumber" : "87",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1469",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:147",
    "ayah_text" : "فَإِنۡ ءَامَنُواْ بِمِثۡلِ مَآ ءَامَنتُم بِهِۦ فَقَدِ ٱهۡتَدَواْۖ وَّإِن تَوَلَّوۡاْ فَإِنَّمَا هُمۡ فِي شِقَاقٖۖ فَسَيَكۡفِيكَهُمُ ٱللَّهُۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "فان ءامنوا بمثل ما ءامنتم به فقد اهتدوا وان تولوا فانما هم في شقاق فسيكفيكهم الله وهو السميع العليم",
    "ayahnumber" : "137",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "147",
    "page" : "21",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1470",
    "ayah_text" : "وَقَالَ مُوسَىٰ رَبَّنَآ إِنَّكَ ءَاتَيۡتَ فِرۡعَوۡنَ وَمَلَأَهُۥ زِينَةٗ وَأَمۡوَٰلٗا فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا رَبَّنَا لِيُضِلُّواْ عَن سَبِيلِكَۖ رَبَّنَا ٱطۡمِسۡ عَلَىٰٓ أَمۡوَٰلِهِمۡ وَٱشۡدُدۡ عَلَىٰ قُلُوبِهِمۡ فَلَا يُؤۡمِنُواْ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ",
    "ayah_text_no_diacratic" : "وقال موسىٰ ربنا انك ءاتيت فرعون وملاه زينة واموٰلا في الحيوٰة الدنيا ربنا ليضلوا عن سبيلك ربنا اطمس علىٰ اموٰلهم واشدد علىٰ قلوبهم فلا يؤمنوا حتىٰ يروا العذاب الاليم",
    "ayahnumber" : "88",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1470",
    "page" : "218",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1471",
    "ayah_text" : "قَالَ قَدۡ أُجِيبَت دَّعۡوَتُكُمَا فَٱسۡتَقِيمَا وَلَا تَتَّبِعَآنِّ سَبِيلَ ٱلَّذِينَ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قال قد اجيبت دعوتكما فاستقيما ولا تتبعان سبيل الذين لا يعلمون",
    "ayahnumber" : "89",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1471",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1472",
    "ayah_text" : "۞وَجَٰوَزۡنَا بِبَنِيٓ إِسۡرَٰٓءِيلَ ٱلۡبَحۡرَ فَأَتۡبَعَهُمۡ فِرۡعَوۡنُ وَجُنُودُهُۥ بَغۡيٗا وَعَدۡوًاۖ حَتَّىٰٓ إِذَآ أَدۡرَكَهُ ٱلۡغَرَقُ قَالَ ءَامَنتُ أَنَّهُۥ لَآ إِلَٰهَ إِلَّا ٱلَّذِيٓ ءَامَنَتۡ بِهِۦ بَنُوٓاْ إِسۡرَٰٓءِيلَ وَأَنَا۠ مِنَ ٱلۡمُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "وجٰوزنا ببني اسرٰءيل البحر فاتبعهم فرعون وجنوده بغيا وعدوا حتىٰ اذا ادركه الغرق قال ءامنت انه لا الٰه الا الذي ءامنت به بنوا اسرٰءيل وانا من المسلمين",
    "ayahnumber" : "90",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1472",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1473",
    "ayah_text" : "ءَآلۡـَٰٔنَ وَقَدۡ عَصَيۡتَ قَبۡلُ وَكُنتَ مِنَ ٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "ءالٰن وقد عصيت قبل وكنت من المفسدين",
    "ayahnumber" : "91",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1473",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1474",
    "ayah_text" : "فَٱلۡيَوۡمَ نُنَجِّيكَ بِبَدَنِكَ لِتَكُونَ لِمَنۡ خَلۡفَكَ ءَايَةٗۚ وَإِنَّ كَثِيرٗا مِّنَ ٱلنَّاسِ عَنۡ ءَايَٰتِنَا لَغَٰفِلُونَ",
    "ayah_text_no_diacratic" : "فاليوم ننجيك ببدنك لتكون لمن خلفك ءاية وان كثيرا من الناس عن ءايٰتنا لغٰفلون",
    "ayahnumber" : "92",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1474",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1475",
    "ayah_text" : "وَلَقَدۡ بَوَّأۡنَا بَنِيٓ إِسۡرَٰٓءِيلَ مُبَوَّأَ صِدۡقٖ وَرَزَقۡنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ فَمَا ٱخۡتَلَفُواْ حَتَّىٰ جَآءَهُمُ ٱلۡعِلۡمُۚ إِنَّ رَبَّكَ يَقۡضِي بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "ولقد بوانا بني اسرٰءيل مبوا صدق ورزقنٰهم من الطيبٰت فما اختلفوا حتىٰ جاءهم العلم ان ربك يقضي بينهم يوم القيٰمة فيما كانوا فيه يختلفون",
    "ayahnumber" : "93",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1475",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1476",
    "ayah_text" : "فَإِن كُنتَ فِي شَكّٖ مِّمَّآ أَنزَلۡنَآ إِلَيۡكَ فَسۡـَٔلِ ٱلَّذِينَ يَقۡرَءُونَ ٱلۡكِتَٰبَ مِن قَبۡلِكَۚ لَقَدۡ جَآءَكَ ٱلۡحَقُّ مِن رَّبِّكَ فَلَا تَكُونَنَّ مِنَ ٱلۡمُمۡتَرِينَ",
    "ayah_text_no_diacratic" : "فان كنت في شك مما انزلنا اليك فسل الذين يقرءون الكتٰب من قبلك لقد جاءك الحق من ربك فلا تكونن من الممترين",
    "ayahnumber" : "94",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1476",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1477",
    "ayah_text" : "وَلَا تَكُونَنَّ مِنَ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِ ٱللَّهِ فَتَكُونَ مِنَ ٱلۡخَٰسِرِينَ",
    "ayah_text_no_diacratic" : "ولا تكونن من الذين كذبوا بايٰت الله فتكون من الخٰسرين",
    "ayahnumber" : "95",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1477",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1478",
    "ayah_text" : "إِنَّ ٱلَّذِينَ حَقَّتۡ عَلَيۡهِمۡ كَلِمَتُ رَبِّكَ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "ان الذين حقت عليهم كلمت ربك لا يؤمنون",
    "ayahnumber" : "96",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1478",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1479",
    "ayah_text" : "وَلَوۡ جَآءَتۡهُمۡ كُلُّ ءَايَةٍ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ",
    "ayah_text_no_diacratic" : "ولو جاءتهم كل ءاية حتىٰ يروا العذاب الاليم",
    "ayahnumber" : "97",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1479",
    "page" : "219",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:148",
    "ayah_text" : "صِبۡغَةَ ٱللَّهِ وَمَنۡ أَحۡسَنُ مِنَ ٱللَّهِ صِبۡغَةٗۖ وَنَحۡنُ لَهُۥ عَٰبِدُونَ",
    "ayah_text_no_diacratic" : "صبغة الله ومن احسن من الله صبغة ونحن له عٰبدون",
    "ayahnumber" : "138",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "148",
    "page" : "21",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1480",
    "ayah_text" : "فَلَوۡلَا كَانَتۡ قَرۡيَةٌ ءَامَنَتۡ فَنَفَعَهَآ إِيمَٰنُهَآ إِلَّا قَوۡمَ يُونُسَ لَمَّآ ءَامَنُواْ كَشَفۡنَا عَنۡهُمۡ عَذَابَ ٱلۡخِزۡيِ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ",
    "ayah_text_no_diacratic" : "فلولا كانت قرية ءامنت فنفعها ايمٰنها الا قوم يونس لما ءامنوا كشفنا عنهم عذاب الخزي في الحيوٰة الدنيا ومتعنٰهم الىٰ حين",
    "ayahnumber" : "98",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1480",
    "page" : "220",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1481",
    "ayah_text" : "وَلَوۡ شَآءَ رَبُّكَ لَأٓمَنَ مَن فِي ٱلۡأَرۡضِ كُلُّهُمۡ جَمِيعًاۚ أَفَأَنتَ تُكۡرِهُ ٱلنَّاسَ حَتَّىٰ يَكُونُواْ مُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ولو شاء ربك لامن من في الارض كلهم جميعا افانت تكره الناس حتىٰ يكونوا مؤمنين",
    "ayahnumber" : "99",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1481",
    "page" : "220",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1482",
    "ayah_text" : "وَمَا كَانَ لِنَفۡسٍ أَن تُؤۡمِنَ إِلَّا بِإِذۡنِ ٱللَّهِۚ وَيَجۡعَلُ ٱلرِّجۡسَ عَلَى ٱلَّذِينَ لَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "وما كان لنفس ان تؤمن الا باذن الله ويجعل الرجس على الذين لا يعقلون",
    "ayahnumber" : "100",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1482",
    "page" : "220",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1483",
    "ayah_text" : "قُلِ ٱنظُرُواْ مَاذَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَمَا تُغۡنِي ٱلۡأٓيَٰتُ وَٱلنُّذُرُ عَن قَوۡمٖ لَّا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "قل انظروا ماذا في السمٰوٰت والارض وما تغني الايٰت والنذر عن قوم لا يؤمنون",
    "ayahnumber" : "101",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1483",
    "page" : "220",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1484",
    "ayah_text" : "فَهَلۡ يَنتَظِرُونَ إِلَّا مِثۡلَ أَيَّامِ ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلِهِمۡۚ قُلۡ فَٱنتَظِرُوٓاْ إِنِّي مَعَكُم مِّنَ ٱلۡمُنتَظِرِينَ",
    "ayah_text_no_diacratic" : "فهل ينتظرون الا مثل ايام الذين خلوا من قبلهم قل فانتظروا اني معكم من المنتظرين",
    "ayahnumber" : "102",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1484",
    "page" : "220",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1485",
    "ayah_text" : "ثُمَّ نُنَجِّي رُسُلَنَا وَٱلَّذِينَ ءَامَنُواْۚ كَذَٰلِكَ حَقًّا عَلَيۡنَا نُنجِ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ثم ننجي رسلنا والذين ءامنوا كذٰلك حقا علينا ننج المؤمنين",
    "ayahnumber" : "103",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1485",
    "page" : "220",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1486",
    "ayah_text" : "قُلۡ يَٰٓأَيُّهَا ٱلنَّاسُ إِن كُنتُمۡ فِي شَكّٖ مِّن دِينِي فَلَآ أَعۡبُدُ ٱلَّذِينَ تَعۡبُدُونَ مِن دُونِ ٱللَّهِ وَلَٰكِنۡ أَعۡبُدُ ٱللَّهَ ٱلَّذِي يَتَوَفَّىٰكُمۡۖ وَأُمِرۡتُ أَنۡ أَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "قل يٰايها الناس ان كنتم في شك من ديني فلا اعبد الذين تعبدون من دون الله ولٰكن اعبد الله الذي يتوفىٰكم وامرت ان اكون من المؤمنين",
    "ayahnumber" : "104",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1486",
    "page" : "220",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1487",
    "ayah_text" : "وَأَنۡ أَقِمۡ وَجۡهَكَ لِلدِّينِ حَنِيفٗا وَلَا تَكُونَنَّ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "وان اقم وجهك للدين حنيفا ولا تكونن من المشركين",
    "ayahnumber" : "105",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1487",
    "page" : "220",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1488",
    "ayah_text" : "وَلَا تَدۡعُ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكَ وَلَا يَضُرُّكَۖ فَإِن فَعَلۡتَ فَإِنَّكَ إِذٗا مِّنَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ولا تدع من دون الله ما لا ينفعك ولا يضرك فان فعلت فانك اذا من الظٰلمين",
    "ayahnumber" : "106",
