  }, {
    "@id" : "quran:2757",
    "ayah_text" : "قَالَ عَمَّا قَلِيلٖ لَّيُصۡبِحُنَّ نَٰدِمِينَ",
    "ayah_text_no_diacratic" : "قال عما قليل ليصبحن نٰدمين",
