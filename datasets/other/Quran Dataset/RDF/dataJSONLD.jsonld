    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:2985",
    "ayah_text" : "لَعَلَّكَ بَٰخِعٞ نَّفۡسَكَ أَلَّا يَكُونُواْ مُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "لعلك بٰخع نفسك الا يكونوا مؤمنين",
    "ayahnumber" : "3",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2985",
    "page" : "367",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:2986",
    "ayah_text" : "إِن نَّشَأۡ نُنَزِّلۡ عَلَيۡهِم مِّنَ ٱلسَّمَآءِ ءَايَةٗ فَظَلَّتۡ أَعۡنَٰقُهُمۡ لَهَا خَٰضِعِينَ",
    "ayah_text_no_diacratic" : "ان نشا ننزل عليهم من السماء ءاية فظلت اعنٰقهم لها خٰضعين",
    "ayahnumber" : "4",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2986",
    "page" : "367",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:2987",
    "ayah_text" : "وَمَا يَأۡتِيهِم مِّن ذِكۡرٖ مِّنَ ٱلرَّحۡمَٰنِ مُحۡدَثٍ إِلَّا كَانُواْ عَنۡهُ مُعۡرِضِينَ",
    "ayah_text_no_diacratic" : "وما ياتيهم من ذكر من الرحمٰن محدث الا كانوا عنه معرضين",
    "ayahnumber" : "5",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2987",
    "page" : "367",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:2988",
    "ayah_text" : "فَقَدۡ كَذَّبُواْ فَسَيَأۡتِيهِمۡ أَنۢبَٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "فقد كذبوا فسياتيهم انبٰؤا ما كانوا به يستهزءون",
    "ayahnumber" : "6",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2988",
    "page" : "367",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:2989",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ إِلَى ٱلۡأَرۡضِ كَمۡ أَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ",
    "ayah_text_no_diacratic" : "اولم يروا الى الارض كم انبتنا فيها من كل زوج كريم",
    "ayahnumber" : "7",
    "chapter" : "19",
    "hizb" : "36",
