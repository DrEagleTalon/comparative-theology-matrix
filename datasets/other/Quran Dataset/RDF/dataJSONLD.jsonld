    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:325",
    "ayah_text" : "تُولِجُ ٱلَّيۡلَ فِي ٱلنَّهَارِ وَتُولِجُ ٱلنَّهَارَ فِي ٱلَّيۡلِۖ وَتُخۡرِجُ ٱلۡحَيَّ مِنَ ٱلۡمَيِّتِ وَتُخۡرِجُ ٱلۡمَيِّتَ مِنَ ٱلۡحَيِّۖ وَتَرۡزُقُ مَن تَشَآءُ بِغَيۡرِ حِسَابٖ",
    "ayah_text_no_diacratic" : "تولج اليل في النهار وتولج النهار في اليل وتخرج الحي من الميت وتخرج الميت من الحي وترزق من تشاء بغير حساب",
    "ayahnumber" : "27",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "325",
    "page" : "53",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3250",
    "ayah_text" : "قَالَ عِفۡرِيتٞ مِّنَ ٱلۡجِنِّ أَنَا۠ ءَاتِيكَ بِهِۦ قَبۡلَ أَن تَقُومَ مِن مَّقَامِكَۖ وَإِنِّي عَلَيۡهِ لَقَوِيٌّ أَمِينٞ",
    "ayah_text_no_diacratic" : "قال عفريت من الجن انا ءاتيك به قبل ان تقوم من مقامك واني عليه لقوي امين",
    "ayahnumber" : "39",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3250",
    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3251",
    "ayah_text" : "قَالَ ٱلَّذِي عِندَهُۥ عِلۡمٞ مِّنَ ٱلۡكِتَٰبِ أَنَا۠ ءَاتِيكَ بِهِۦ قَبۡلَ أَن يَرۡتَدَّ إِلَيۡكَ طَرۡفُكَۚ فَلَمَّا رَءَاهُ مُسۡتَقِرًّا عِندَهُۥ قَالَ هَٰذَا مِن فَضۡلِ رَبِّي لِيَبۡلُوَنِيٓ ءَأَشۡكُرُ أَمۡ أَكۡفُرُۖ وَمَن شَكَرَ فَإِنَّمَا يَشۡكُرُ لِنَفۡسِهِۦۖ وَمَن كَفَرَ فَإِنَّ رَبِّي غَنِيّٞ كَرِيمٞ",
    "ayah_text_no_diacratic" : "قال الذي عنده علم من الكتٰب انا ءاتيك به قبل ان يرتد اليك طرفك فلما رءاه مستقرا عنده قال هٰذا من فضل ربي ليبلوني ءاشكر ام اكفر ومن شكر فانما يشكر لنفسه ومن كفر فان ربي غني كريم",
    "ayahnumber" : "40",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3251",
    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3252",
    "ayah_text" : "قَالَ نَكِّرُواْ لَهَا عَرۡشَهَا نَنظُرۡ أَتَهۡتَدِيٓ أَمۡ تَكُونُ مِنَ ٱلَّذِينَ لَا يَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "قال نكروا لها عرشها ننظر اتهتدي ام تكون من الذين لا يهتدون",
    "ayahnumber" : "41",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3252",
    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3253",
    "ayah_text" : "فَلَمَّا جَآءَتۡ قِيلَ أَهَٰكَذَا عَرۡشُكِۖ قَالَتۡ كَأَنَّهُۥ هُوَۚ وَأُوتِينَا ٱلۡعِلۡمَ مِن قَبۡلِهَا وَكُنَّا مُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "فلما جاءت قيل اهٰكذا عرشك قالت كانه هو واوتينا العلم من قبلها وكنا مسلمين",
    "ayahnumber" : "42",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3253",
    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3254",
    "ayah_text" : "وَصَدَّهَا مَا كَانَت تَّعۡبُدُ مِن دُونِ ٱللَّهِۖ إِنَّهَا كَانَتۡ مِن قَوۡمٖ كَٰفِرِينَ",
    "ayah_text_no_diacratic" : "وصدها ما كانت تعبد من دون الله انها كانت من قوم كٰفرين",
    "ayahnumber" : "43",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3254",
    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3255",
    "ayah_text" : "قِيلَ لَهَا ٱدۡخُلِي ٱلصَّرۡحَۖ فَلَمَّا رَأَتۡهُ حَسِبَتۡهُ لُجَّةٗ وَكَشَفَتۡ عَن سَاقَيۡهَاۚ قَالَ إِنَّهُۥ صَرۡحٞ مُّمَرَّدٞ مِّن قَوَارِيرَۗ قَالَتۡ رَبِّ إِنِّي ظَلَمۡتُ نَفۡسِي وَأَسۡلَمۡتُ مَعَ سُلَيۡمَٰنَ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "قيل لها ادخلي الصرح فلما راته حسبته لجة وكشفت عن ساقيها قال انه صرح ممرد من قوارير قالت رب اني ظلمت نفسي واسلمت مع سليمٰن لله رب العٰلمين",
    "ayahnumber" : "44",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3255",
    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3256",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَآ إِلَىٰ ثَمُودَ أَخَاهُمۡ صَٰلِحًا أَنِ ٱعۡبُدُواْ ٱللَّهَ فَإِذَا هُمۡ فَرِيقَانِ يَخۡتَصِمُونَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا الىٰ ثمود اخاهم صٰلحا ان اعبدوا الله فاذا هم فريقان يختصمون",
    "ayahnumber" : "45",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3256",
    "page" : "381",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3257",
    "ayah_text" : "قَالَ يَٰقَوۡمِ لِمَ تَسۡتَعۡجِلُونَ بِٱلسَّيِّئَةِ قَبۡلَ ٱلۡحَسَنَةِۖ لَوۡلَا تَسۡتَغۡفِرُونَ ٱللَّهَ لَعَلَّكُمۡ تُرۡحَمُونَ",
    "ayah_text_no_diacratic" : "قال يٰقوم لم تستعجلون بالسيئة قبل الحسنة لولا تستغفرون الله لعلكم ترحمون",
    "ayahnumber" : "46",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3257",
    "page" : "381",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3258",
    "ayah_text" : "قَالُواْ ٱطَّيَّرۡنَا بِكَ وَبِمَن مَّعَكَۚ قَالَ طَٰٓئِرُكُمۡ عِندَ ٱللَّهِۖ بَلۡ أَنتُمۡ قَوۡمٞ تُفۡتَنُونَ",
    "ayah_text_no_diacratic" : "قالوا اطيرنا بك وبمن معك قال طٰئركم عند الله بل انتم قوم تفتنون",
    "ayahnumber" : "47",
    "chapter" : "19",
    "hizb" : "38",
