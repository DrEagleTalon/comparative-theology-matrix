    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3934",
    "ayah_text" : "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
    "ayah_text_no_diacratic" : "الا عباد الله المخلصين",
