    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3081",
    "ayah_text" : "وَمَآ أَضَلَّنَآ إِلَّا ٱلۡمُجۡرِمُونَ",
    "ayah_text_no_diacratic" : "وما اضلنا الا المجرمون",
