  }, {
    "@id" : "quran:3858",
    "ayah_text" : "فَسُبۡحَٰنَ ٱلَّذِي بِيَدِهِۦ مَلَكُوتُ كُلِّ شَيۡءٖ وَإِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "فسبحٰن الذي بيده ملكوت كل شيء واليه ترجعون",
