    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3264",
    "ayah_text" : "وَأَنجَيۡنَا ٱلَّذِينَ ءَامَنُواْ وَكَانُواْ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "وانجينا الذين ءامنوا وكانوا يتقون",
