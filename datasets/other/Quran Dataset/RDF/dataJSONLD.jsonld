    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2395",
    "ayah_text" : "وَهَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
    "ayah_text_no_diacratic" : "وهل اتىٰك حديث موسىٰ",
