    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2596",
    "ayah_text" : "وَجَعَلۡنَٰهُمۡ أَئِمَّةٗ يَهۡدُونَ بِأَمۡرِنَا وَأَوۡحَيۡنَآ إِلَيۡهِمۡ فِعۡلَ ٱلۡخَيۡرَٰتِ وَإِقَامَ ٱلصَّلَوٰةِ وَإِيتَآءَ ٱلزَّكَوٰةِۖ وَكَانُواْ لَنَا عَٰبِدِينَ",
    "ayah_text_no_diacratic" : "وجعلنٰهم ائمة يهدون بامرنا واوحينا اليهم فعل الخيرٰت واقام الصلوٰة وايتاء الزكوٰة وكانوا لنا عٰبدين",
    "ayahnumber" : "73",
