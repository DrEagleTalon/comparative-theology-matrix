    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4874",
    "ayah_text" : "أَمۡ عِندَهُمۡ خَزَآئِنُ رَبِّكَ أَمۡ هُمُ ٱلۡمُصَۜيۡطِرُونَ",
    "ayah_text_no_diacratic" : "ام عندهم خزائن ربك ام هم المصيطرون",
