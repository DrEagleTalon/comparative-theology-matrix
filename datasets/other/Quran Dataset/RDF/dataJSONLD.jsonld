  }, {
    "@id" : "quran:964",
    "ayah_text" : "قُلۡ أَغَيۡرَ ٱللَّهِ أَبۡغِي رَبّٗا وَهُوَ رَبُّ كُلِّ شَيۡءٖۚ وَلَا تَكۡسِبُ كُلُّ نَفۡسٍ إِلَّا عَلَيۡهَاۚ وَلَا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰۚ ثُمَّ إِلَىٰ رَبِّكُم مَّرۡجِعُكُمۡ فَيُنَبِّئُكُم بِمَا كُنتُمۡ فِيهِ تَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "قل اغير الله ابغي ربا وهو رب كل شيء ولا تكسب كل نفس الا عليها ولا تزر وازرة وزر اخرىٰ ثم الىٰ ربكم مرجعكم فينبئكم بما كنتم فيه تختلفون",
    "ayahnumber" : "164",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "964",
    "page" : "150",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:965",
    "ayah_text" : "وَهُوَ ٱلَّذِي جَعَلَكُمۡ خَلَٰٓئِفَ ٱلۡأَرۡضِ وَرَفَعَ بَعۡضَكُمۡ فَوۡقَ بَعۡضٖ دَرَجَٰتٖ لِّيَبۡلُوَكُمۡ فِي مَآ ءَاتَىٰكُمۡۗ إِنَّ رَبَّكَ سَرِيعُ ٱلۡعِقَابِ وَإِنَّهُۥ لَغَفُورٞ رَّحِيمُۢ",
    "ayah_text_no_diacratic" : "وهو الذي جعلكم خلٰئف الارض ورفع بعضكم فوق بعض درجٰت ليبلوكم في ما ءاتىٰكم ان ربك سريع العقاب وانه لغفور رحيم",
    "ayahnumber" : "165",
    "chapter" : "8",
    "hizb" : "15",
