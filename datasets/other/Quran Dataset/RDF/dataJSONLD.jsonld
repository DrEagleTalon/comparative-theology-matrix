    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4913",
    "ayah_text" : "فَلِلَّهِ ٱلۡأٓخِرَةُ وَٱلۡأُولَىٰ",
    "ayah_text_no_diacratic" : "فلله الاخرة والاولىٰ",
    "ayahnumber" : "25",
    "chapter" : "27",
    "hizb" : "52",
