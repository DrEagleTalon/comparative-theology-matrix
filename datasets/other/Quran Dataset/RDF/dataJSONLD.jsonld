    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:725",
    "ayah_text" : "وَلۡيَحۡكُمۡ أَهۡلُ ٱلۡإِنجِيلِ بِمَآ أَنزَلَ ٱللَّهُ فِيهِۚ وَمَن لَّمۡ يَحۡكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُوْلَٰٓئِكَ هُمُ ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "وليحكم اهل الانجيل بما انزل الله فيه ومن لم يحكم بما انزل الله فاولٰئك هم الفٰسقون",
    "ayahnumber" : "47",
    "chapter" : "6",
    "hizb" : "11",
