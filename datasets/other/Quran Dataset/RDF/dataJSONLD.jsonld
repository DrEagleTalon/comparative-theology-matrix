    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4977",
    "ayah_text" : "أَءُلۡقِيَ ٱلذِّكۡرُ عَلَيۡهِ مِنۢ بَيۡنِنَا بَلۡ هُوَ كَذَّابٌ أَشِرٞ",
    "ayah_text_no_diacratic" : "اءلقي الذكر عليه من بيننا بل هو كذاب اشر",
