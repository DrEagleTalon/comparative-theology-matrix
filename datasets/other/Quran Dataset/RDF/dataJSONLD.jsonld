    "index" : "3510",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3511",
    "ayah_text" : "مَن كَفَرَ فَعَلَيۡهِ كُفۡرُهُۥۖ وَمَنۡ عَمِلَ صَٰلِحٗا فَلِأَنفُسِهِمۡ يَمۡهَدُونَ",
    "ayah_text_no_diacratic" : "من كفر فعليه كفره ومن عمل صٰلحا فلانفسهم يمهدون",
    "ayahnumber" : "44",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3511",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3512",
    "ayah_text" : "لِيَجۡزِيَ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ مِن فَضۡلِهِۦٓۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ليجزي الذين ءامنوا وعملوا الصٰلحٰت من فضله انه لا يحب الكٰفرين",
    "ayahnumber" : "45",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3512",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3513",
    "ayah_text" : "وَمِنۡ ءَايَٰتِهِۦٓ أَن يُرۡسِلَ ٱلرِّيَاحَ مُبَشِّرَٰتٖ وَلِيُذِيقَكُم مِّن رَّحۡمَتِهِۦ وَلِتَجۡرِيَ ٱلۡفُلۡكُ بِأَمۡرِهِۦ وَلِتَبۡتَغُواْ مِن فَضۡلِهِۦ وَلَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "ومن ءايٰته ان يرسل الرياح مبشرٰت وليذيقكم من رحمته ولتجري الفلك بامره ولتبتغوا من فضله ولعلكم تشكرون",
    "ayahnumber" : "46",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3513",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3514",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا مِن قَبۡلِكَ رُسُلًا إِلَىٰ قَوۡمِهِمۡ فَجَآءُوهُم بِٱلۡبَيِّنَٰتِ فَٱنتَقَمۡنَا مِنَ ٱلَّذِينَ أَجۡرَمُواْۖ وَكَانَ حَقًّا عَلَيۡنَا نَصۡرُ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا من قبلك رسلا الىٰ قومهم فجاءوهم بالبينٰت فانتقمنا من الذين اجرموا وكان حقا علينا نصر المؤمنين",
    "ayahnumber" : "47",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3514",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3515",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي يُرۡسِلُ ٱلرِّيَٰحَ فَتُثِيرُ سَحَابٗا فَيَبۡسُطُهُۥ فِي ٱلسَّمَآءِ كَيۡفَ يَشَآءُ وَيَجۡعَلُهُۥ كِسَفٗا فَتَرَى ٱلۡوَدۡقَ يَخۡرُجُ مِنۡ خِلَٰلِهِۦۖ فَإِذَآ أَصَابَ بِهِۦ مَن يَشَآءُ مِنۡ عِبَادِهِۦٓ إِذَا هُمۡ يَسۡتَبۡشِرُونَ",
    "ayah_text_no_diacratic" : "الله الذي يرسل الريٰح فتثير سحابا فيبسطه في السماء كيف يشاء ويجعله كسفا فترى الودق يخرج من خلٰله فاذا اصاب به من يشاء من عباده اذا هم يستبشرون",
    "ayahnumber" : "48",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3515",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3516",
    "ayah_text" : "وَإِن كَانُواْ مِن قَبۡلِ أَن يُنَزَّلَ عَلَيۡهِم مِّن قَبۡلِهِۦ لَمُبۡلِسِينَ",
    "ayah_text_no_diacratic" : "وان كانوا من قبل ان ينزل عليهم من قبله لمبلسين",
    "ayahnumber" : "49",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3516",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3517",
    "ayah_text" : "فَٱنظُرۡ إِلَىٰٓ ءَاثَٰرِ رَحۡمَتِ ٱللَّهِ كَيۡفَ يُحۡيِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَآۚ إِنَّ ذَٰلِكَ لَمُحۡيِ ٱلۡمَوۡتَىٰۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "فانظر الىٰ ءاثٰر رحمت الله كيف يحي الارض بعد موتها ان ذٰلك لمحي الموتىٰ وهو علىٰ كل شيء قدير",
    "ayahnumber" : "50",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3517",
    "page" : "409",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3518",
    "ayah_text" : "وَلَئِنۡ أَرۡسَلۡنَا رِيحٗا فَرَأَوۡهُ مُصۡفَرّٗا لَّظَلُّواْ مِنۢ بَعۡدِهِۦ يَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "ولئن ارسلنا ريحا فراوه مصفرا لظلوا من بعده يكفرون",
    "ayahnumber" : "51",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3518",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3519",
    "ayah_text" : "فَإِنَّكَ لَا تُسۡمِعُ ٱلۡمَوۡتَىٰ وَلَا تُسۡمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوۡاْ مُدۡبِرِينَ",
    "ayah_text_no_diacratic" : "فانك لا تسمع الموتىٰ ولا تسمع الصم الدعاء اذا ولوا مدبرين",
    "ayahnumber" : "52",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3519",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:352",
    "ayah_text" : "وَمَكَرُواْ وَمَكَرَ ٱللَّهُۖ وَٱللَّهُ خَيۡرُ ٱلۡمَٰكِرِينَ",
    "ayah_text_no_diacratic" : "ومكروا ومكر الله والله خير المٰكرين",
    "ayahnumber" : "54",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "352",
    "page" : "57",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3520",
    "ayah_text" : "وَمَآ أَنتَ بِهَٰدِ ٱلۡعُمۡيِ عَن ضَلَٰلَتِهِمۡۖ إِن تُسۡمِعُ إِلَّا مَن يُؤۡمِنُ بِـَٔايَٰتِنَا فَهُم مُّسۡلِمُونَ",
    "ayah_text_no_diacratic" : "وما انت بهٰد العمي عن ضلٰلتهم ان تسمع الا من يؤمن بايٰتنا فهم مسلمون",
    "ayahnumber" : "53",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3520",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3521",
    "ayah_text" : "۞ٱللَّهُ ٱلَّذِي خَلَقَكُم مِّن ضَعۡفٖ ثُمَّ جَعَلَ مِنۢ بَعۡدِ ضَعۡفٖ قُوَّةٗ ثُمَّ جَعَلَ مِنۢ بَعۡدِ قُوَّةٖ ضَعۡفٗا وَشَيۡبَةٗۚ يَخۡلُقُ مَا يَشَآءُۚ وَهُوَ ٱلۡعَلِيمُ ٱلۡقَدِيرُ",
    "ayah_text_no_diacratic" : "الله الذي خلقكم من ضعف ثم جعل من بعد ضعف قوة ثم جعل من بعد قوة ضعفا وشيبة يخلق ما يشاء وهو العليم القدير",
    "ayahnumber" : "54",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3521",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3522",
    "ayah_text" : "وَيَوۡمَ تَقُومُ ٱلسَّاعَةُ يُقۡسِمُ ٱلۡمُجۡرِمُونَ مَا لَبِثُواْ غَيۡرَ سَاعَةٖۚ كَذَٰلِكَ كَانُواْ يُؤۡفَكُونَ",
    "ayah_text_no_diacratic" : "ويوم تقوم الساعة يقسم المجرمون ما لبثوا غير ساعة كذٰلك كانوا يؤفكون",
    "ayahnumber" : "55",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3522",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3523",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ وَٱلۡإِيمَٰنَ لَقَدۡ لَبِثۡتُمۡ فِي كِتَٰبِ ٱللَّهِ إِلَىٰ يَوۡمِ ٱلۡبَعۡثِۖ فَهَٰذَا يَوۡمُ ٱلۡبَعۡثِ وَلَٰكِنَّكُمۡ كُنتُمۡ لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وقال الذين اوتوا العلم والايمٰن لقد لبثتم في كتٰب الله الىٰ يوم البعث فهٰذا يوم البعث ولٰكنكم كنتم لا تعلمون",
    "ayahnumber" : "56",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3523",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3524",
    "ayah_text" : "فَيَوۡمَئِذٖ لَّا يَنفَعُ ٱلَّذِينَ ظَلَمُواْ مَعۡذِرَتُهُمۡ وَلَا هُمۡ يُسۡتَعۡتَبُونَ",
    "ayah_text_no_diacratic" : "فيومئذ لا ينفع الذين ظلموا معذرتهم ولا هم يستعتبون",
    "ayahnumber" : "57",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3524",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3525",
    "ayah_text" : "وَلَقَدۡ ضَرَبۡنَا لِلنَّاسِ فِي هَٰذَا ٱلۡقُرۡءَانِ مِن كُلِّ مَثَلٖۚ وَلَئِن جِئۡتَهُم بِـَٔايَةٖ لَّيَقُولَنَّ ٱلَّذِينَ كَفَرُوٓاْ إِنۡ أَنتُمۡ إِلَّا مُبۡطِلُونَ",
    "ayah_text_no_diacratic" : "ولقد ضربنا للناس في هٰذا القرءان من كل مثل ولئن جئتهم باية ليقولن الذين كفروا ان انتم الا مبطلون",
    "ayahnumber" : "58",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3525",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3526",
    "ayah_text" : "كَذَٰلِكَ يَطۡبَعُ ٱللَّهُ عَلَىٰ قُلُوبِ ٱلَّذِينَ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "كذٰلك يطبع الله علىٰ قلوب الذين لا يعلمون",
    "ayahnumber" : "59",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3526",
    "page" : "410",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3527",
    "ayah_text" : "فَٱصۡبِرۡ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞۖ وَلَا يَسۡتَخِفَّنَّكَ ٱلَّذِينَ لَا يُوقِنُونَ",
    "ayah_text_no_diacratic" : "فاصبر ان وعد الله حق ولا يستخفنك الذين لا يوقنون",
    "ayahnumber" : "60",
    "chapter" : "21",
    "hizb" : "41",
