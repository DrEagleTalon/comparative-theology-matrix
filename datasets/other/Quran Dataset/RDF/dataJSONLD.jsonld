  }, {
    "@id" : "quran:2288",
    "ayah_text" : "ذِكۡرُ رَحۡمَتِ رَبِّكَ عَبۡدَهُۥ زَكَرِيَّآ",
    "ayah_text_no_diacratic" : "ذكر رحمت ربك عبده زكريا",
