    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2808",
    "ayah_text" : "مَا ٱتَّخَذَ ٱللَّهُ مِن وَلَدٖ وَمَا كَانَ مَعَهُۥ مِنۡ إِلَٰهٍۚ إِذٗا لَّذَهَبَ كُلُّ إِلَٰهِۭ بِمَا خَلَقَ وَلَعَلَا بَعۡضُهُمۡ عَلَىٰ بَعۡضٖۚ سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ",
    "ayah_text_no_diacratic" : "ما اتخذ الله من ولد وما كان معه من الٰه اذا لذهب كل الٰه بما خلق ولعلا بعضهم علىٰ بعض سبحٰن الله عما يصفون",
    "ayahnumber" : "91",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2808",
    "page" : "348",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2809",
    "ayah_text" : "عَٰلِمِ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ فَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "عٰلم الغيب والشهٰدة فتعٰلىٰ عما يشركون",
    "ayahnumber" : "92",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2809",
    "page" : "348",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:281",
    "ayah_text" : "إِن تُبۡدُواْ ٱلصَّدَقَٰتِ فَنِعِمَّا هِيَۖ وَإِن تُخۡفُوهَا وَتُؤۡتُوهَا ٱلۡفُقَرَآءَ فَهُوَ خَيۡرٞ لَّكُمۡۚ وَيُكَفِّرُ عَنكُم مِّن سَيِّـَٔاتِكُمۡۗ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ",
    "ayah_text_no_diacratic" : "ان تبدوا الصدقٰت فنعما هي وان تخفوها وتؤتوها الفقراء فهو خير لكم ويكفر عنكم من سياتكم والله بما تعملون خبير",
    "ayahnumber" : "271",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "281",
    "page" : "46",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2810",
    "ayah_text" : "قُل رَّبِّ إِمَّا تُرِيَنِّي مَا يُوعَدُونَ",
    "ayah_text_no_diacratic" : "قل رب اما تريني ما يوعدون",
    "ayahnumber" : "93",
