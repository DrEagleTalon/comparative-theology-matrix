    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3261",
    "ayah_text" : "وَمَكَرُواْ مَكۡرٗا وَمَكَرۡنَا مَكۡرٗا وَهُمۡ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "ومكروا مكرا ومكرنا مكرا وهم لا يشعرون",
    "ayahnumber" : "50",
    "chapter" : "19",
    "hizb" : "38",
