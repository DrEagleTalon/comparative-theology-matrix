    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:819",
    "ayah_text" : "قُلۡ أَيُّ شَيۡءٍ أَكۡبَرُ شَهَٰدَةٗۖ قُلِ ٱللَّهُۖ شَهِيدُۢ بَيۡنِي وَبَيۡنَكُمۡۚ وَأُوحِيَ إِلَيَّ هَٰذَا ٱلۡقُرۡءَانُ لِأُنذِرَكُم بِهِۦ وَمَنۢ بَلَغَۚ أَئِنَّكُمۡ لَتَشۡهَدُونَ أَنَّ مَعَ ٱللَّهِ ءَالِهَةً أُخۡرَىٰۚ قُل لَّآ أَشۡهَدُۚ قُلۡ إِنَّمَا هُوَ إِلَٰهٞ وَٰحِدٞ وَإِنَّنِي بَرِيٓءٞ مِّمَّا تُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "قل اي شيء اكبر شهٰدة قل الله شهيد بيني وبينكم واوحي الي هٰذا القرءان لانذركم به ومن بلغ ائنكم لتشهدون ان مع الله ءالهة اخرىٰ قل لا اشهد قل انما هو الٰه وٰحد وانني بريء مما تشركون",
    "ayahnumber" : "19",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "819",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:82",
    "ayah_text" : "وَإِذۡ قَتَلۡتُمۡ نَفۡسٗا فَٱدَّٰرَٰٔتُمۡ فِيهَاۖ وَٱللَّهُ مُخۡرِجٞ مَّا كُنتُمۡ تَكۡتُمُونَ",
    "ayah_text_no_diacratic" : "واذ قتلتم نفسا فادٰرٰتم فيها والله مخرج ما كنتم تكتمون",
    "ayahnumber" : "72",
