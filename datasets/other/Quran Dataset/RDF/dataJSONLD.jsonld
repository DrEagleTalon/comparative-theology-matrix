    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4946",
    "ayah_text" : "لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ",
    "ayah_text_no_diacratic" : "ليس لها من دون الله كاشفة",
