    "surahnumber" : "83",
    "surrahname_no_diacratic" : "سورة المطففين"
  }, {
    "@id" : "quran:6042",
    "ayah_text" : "وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ",
    "ayah_text_no_diacratic" : "واذا مروا بهم يتغامزون",
    "ayahnumber" : "30",
