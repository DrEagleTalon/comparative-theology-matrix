  }, {
    "@id" : "quran:830",
    "ayah_text" : "وَلَوۡ تَرَىٰٓ إِذۡ وُقِفُواْ عَلَىٰ رَبِّهِمۡۚ قَالَ أَلَيۡسَ هَٰذَا بِٱلۡحَقِّۚ قَالُواْ بَلَىٰ وَرَبِّنَاۚ قَالَ فَذُوقُواْ ٱلۡعَذَابَ بِمَا كُنتُمۡ تَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "ولو ترىٰ اذ وقفوا علىٰ ربهم قال اليس هٰذا بالحق قالوا بلىٰ وربنا قال فذوقوا العذاب بما كنتم تكفرون",
    "ayahnumber" : "30",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "830",
    "page" : "131",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:831",
    "ayah_text" : "قَدۡ خَسِرَ ٱلَّذِينَ كَذَّبُواْ بِلِقَآءِ ٱللَّهِۖ حَتَّىٰٓ إِذَا جَآءَتۡهُمُ ٱلسَّاعَةُ بَغۡتَةٗ قَالُواْ يَٰحَسۡرَتَنَا عَلَىٰ مَا فَرَّطۡنَا فِيهَا وَهُمۡ يَحۡمِلُونَ أَوۡزَارَهُمۡ عَلَىٰ ظُهُورِهِمۡۚ أَلَا سَآءَ مَا يَزِرُونَ",
    "ayah_text_no_diacratic" : "قد خسر الذين كذبوا بلقاء الله حتىٰ اذا جاءتهم الساعة بغتة قالوا يٰحسرتنا علىٰ ما فرطنا فيها وهم يحملون اوزارهم علىٰ ظهورهم الا ساء ما يزرون",
    "ayahnumber" : "31",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "831",
    "page" : "131",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:832",
    "ayah_text" : "وَمَا ٱلۡحَيَوٰةُ ٱلدُّنۡيَآ إِلَّا لَعِبٞ وَلَهۡوٞۖ وَلَلدَّارُ ٱلۡأٓخِرَةُ خَيۡرٞ لِّلَّذِينَ يَتَّقُونَۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "وما الحيوٰة الدنيا الا لعب ولهو وللدار الاخرة خير للذين يتقون افلا تعقلون",
    "ayahnumber" : "32",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "832",
