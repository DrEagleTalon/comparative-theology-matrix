    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4285",
    "ayah_text" : "مِن دُونِ ٱللَّهِۖ قَالُواْ ضَلُّواْ عَنَّا بَل لَّمۡ نَكُن نَّدۡعُواْ مِن قَبۡلُ شَيۡـٔٗاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "من دون الله قالوا ضلوا عنا بل لم نكن ندعوا من قبل شيا كذٰلك يضل الله الكٰفرين",
    "ayahnumber" : "74",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4285",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4286",
    "ayah_text" : "ذَٰلِكُم بِمَا كُنتُمۡ تَفۡرَحُونَ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّ وَبِمَا كُنتُمۡ تَمۡرَحُونَ",
    "ayah_text_no_diacratic" : "ذٰلكم بما كنتم تفرحون في الارض بغير الحق وبما كنتم تمرحون",
    "ayahnumber" : "75",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4286",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4287",
    "ayah_text" : "ٱدۡخُلُوٓاْ أَبۡوَٰبَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۖ فَبِئۡسَ مَثۡوَى ٱلۡمُتَكَبِّرِينَ",
    "ayah_text_no_diacratic" : "ادخلوا ابوٰب جهنم خٰلدين فيها فبئس مثوى المتكبرين",
    "ayahnumber" : "76",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4287",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4288",
    "ayah_text" : "فَٱصۡبِرۡ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞۚ فَإِمَّا نُرِيَنَّكَ بَعۡضَ ٱلَّذِي نَعِدُهُمۡ أَوۡ نَتَوَفَّيَنَّكَ فَإِلَيۡنَا يُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "فاصبر ان وعد الله حق فاما نرينك بعض الذي نعدهم او نتوفينك فالينا يرجعون",
    "ayahnumber" : "77",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4288",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4289",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا رُسُلٗا مِّن قَبۡلِكَ مِنۡهُم مَّن قَصَصۡنَا عَلَيۡكَ وَمِنۡهُم مَّن لَّمۡ نَقۡصُصۡ عَلَيۡكَۗ وَمَا كَانَ لِرَسُولٍ أَن يَأۡتِيَ بِـَٔايَةٍ إِلَّا بِإِذۡنِ ٱللَّهِۚ فَإِذَا جَآءَ أَمۡرُ ٱللَّهِ قُضِيَ بِٱلۡحَقِّ وَخَسِرَ هُنَالِكَ ٱلۡمُبۡطِلُونَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا رسلا من قبلك منهم من قصصنا عليك ومنهم من لم نقصص عليك وما كان لرسول ان ياتي باية الا باذن الله فاذا جاء امر الله قضي بالحق وخسر هنالك المبطلون",
    "ayahnumber" : "78",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4289",
    "page" : "476",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:429",
    "ayah_text" : "وَٱتَّقُواْ ٱلنَّارَ ٱلَّتِيٓ أُعِدَّتۡ لِلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "واتقوا النار التي اعدت للكٰفرين",
    "ayahnumber" : "131",
    "chapter" : "4",
    "hizb" : "6",
