    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3645",
    "ayah_text" : "وَلَا تُطِعِ ٱلۡكَٰفِرِينَ وَٱلۡمُنَٰفِقِينَ وَدَعۡ أَذَىٰهُمۡ وَتَوَكَّلۡ عَلَى ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلٗا",
    "ayah_text_no_diacratic" : "ولا تطع الكٰفرين والمنٰفقين ودع اذىٰهم وتوكل على الله وكفىٰ بالله وكيلا",
    "ayahnumber" : "48",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3645",
    "page" : "424",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3646",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا نَكَحۡتُمُ ٱلۡمُؤۡمِنَٰتِ ثُمَّ طَلَّقۡتُمُوهُنَّ مِن قَبۡلِ أَن تَمَسُّوهُنَّ فَمَا لَكُمۡ عَلَيۡهِنَّ مِنۡ عِدَّةٖ تَعۡتَدُّونَهَاۖ فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحٗا جَمِيلٗا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اذا نكحتم المؤمنٰت ثم طلقتموهن من قبل ان تمسوهن فما لكم عليهن من عدة تعتدونها فمتعوهن وسرحوهن سراحا جميلا",
    "ayahnumber" : "49",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3646",
    "page" : "424",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3647",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ إِنَّآ أَحۡلَلۡنَا لَكَ أَزۡوَٰجَكَ ٱلَّٰتِيٓ ءَاتَيۡتَ أُجُورَهُنَّ وَمَا مَلَكَتۡ يَمِينُكَ مِمَّآ أَفَآءَ ٱللَّهُ عَلَيۡكَ وَبَنَاتِ عَمِّكَ وَبَنَاتِ عَمَّٰتِكَ وَبَنَاتِ خَالِكَ وَبَنَاتِ خَٰلَٰتِكَ ٱلَّٰتِي هَاجَرۡنَ مَعَكَ وَٱمۡرَأَةٗ مُّؤۡمِنَةً إِن وَهَبَتۡ نَفۡسَهَا لِلنَّبِيِّ إِنۡ أَرَادَ ٱلنَّبِيُّ أَن يَسۡتَنكِحَهَا خَالِصَةٗ لَّكَ مِن دُونِ ٱلۡمُؤۡمِنِينَۗ قَدۡ عَلِمۡنَا مَا فَرَضۡنَا عَلَيۡهِمۡ فِيٓ أَزۡوَٰجِهِمۡ وَمَا مَلَكَتۡ أَيۡمَٰنُهُمۡ لِكَيۡلَا يَكُونَ عَلَيۡكَ حَرَجٞۗ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "يٰايها النبي انا احللنا لك ازوٰجك الٰتي ءاتيت اجورهن وما ملكت يمينك مما افاء الله عليك وبنات عمك وبنات عمٰتك وبنات خالك وبنات خٰلٰتك الٰتي هاجرن معك وامراة مؤمنة ان وهبت نفسها للنبي ان اراد النبي ان يستنكحها خالصة لك من دون المؤمنين قد علمنا ما فرضنا عليهم في ازوٰجهم وما ملكت ايمٰنهم لكيلا يكون عليك حرج وكان الله غفورا رحيما",
    "ayahnumber" : "50",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3647",
    "page" : "424",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3648",
    "ayah_text" : "۞تُرۡجِي مَن تَشَآءُ مِنۡهُنَّ وَتُـٔۡوِيٓ إِلَيۡكَ مَن تَشَآءُۖ وَمَنِ ٱبۡتَغَيۡتَ مِمَّنۡ عَزَلۡتَ فَلَا جُنَاحَ عَلَيۡكَۚ ذَٰلِكَ أَدۡنَىٰٓ أَن تَقَرَّ أَعۡيُنُهُنَّ وَلَا يَحۡزَنَّ وَيَرۡضَيۡنَ بِمَآ ءَاتَيۡتَهُنَّ كُلُّهُنَّۚ وَٱللَّهُ يَعۡلَمُ مَا فِي قُلُوبِكُمۡۚ وَكَانَ ٱللَّهُ عَلِيمًا حَلِيمٗا",
    "ayah_text_no_diacratic" : "ترجي من تشاء منهن وتوي اليك من تشاء ومن ابتغيت ممن عزلت فلا جناح عليك ذٰلك ادنىٰ ان تقر اعينهن ولا يحزن ويرضين بما ءاتيتهن كلهن والله يعلم ما في قلوبكم وكان الله عليما حليما",
    "ayahnumber" : "51",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3648",
    "page" : "425",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3649",
    "ayah_text" : "لَّا يَحِلُّ لَكَ ٱلنِّسَآءُ مِنۢ بَعۡدُ وَلَآ أَن تَبَدَّلَ بِهِنَّ مِنۡ أَزۡوَٰجٖ وَلَوۡ أَعۡجَبَكَ حُسۡنُهُنَّ إِلَّا مَا مَلَكَتۡ يَمِينُكَۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ رَّقِيبٗا",
    "ayah_text_no_diacratic" : "لا يحل لك النساء من بعد ولا ان تبدل بهن من ازوٰج ولو اعجبك حسنهن الا ما ملكت يمينك وكان الله علىٰ كل شيء رقيبا",
    "ayahnumber" : "52",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3649",
    "page" : "425",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:365",
    "ayah_text" : "مَا كَانَ إِبۡرَٰهِيمُ يَهُودِيّٗا وَلَا نَصۡرَانِيّٗا وَلَٰكِن كَانَ حَنِيفٗا مُّسۡلِمٗا وَمَا كَانَ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "ما كان ابرٰهيم يهوديا ولا نصرانيا ولٰكن كان حنيفا مسلما وما كان من المشركين",
    "ayahnumber" : "67",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "365",
    "page" : "58",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3650",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَدۡخُلُواْ بُيُوتَ ٱلنَّبِيِّ إِلَّآ أَن يُؤۡذَنَ لَكُمۡ إِلَىٰ طَعَامٍ غَيۡرَ نَٰظِرِينَ إِنَىٰهُ وَلَٰكِنۡ إِذَا دُعِيتُمۡ فَٱدۡخُلُواْ فَإِذَا طَعِمۡتُمۡ فَٱنتَشِرُواْ وَلَا مُسۡتَـٔۡنِسِينَ لِحَدِيثٍۚ إِنَّ ذَٰلِكُمۡ كَانَ يُؤۡذِي ٱلنَّبِيَّ فَيَسۡتَحۡيِۦ مِنكُمۡۖ وَٱللَّهُ لَا يَسۡتَحۡيِۦ مِنَ ٱلۡحَقِّۚ وَإِذَا سَأَلۡتُمُوهُنَّ مَتَٰعٗا فَسۡـَٔلُوهُنَّ مِن وَرَآءِ حِجَابٖۚ ذَٰلِكُمۡ أَطۡهَرُ لِقُلُوبِكُمۡ وَقُلُوبِهِنَّۚ وَمَا كَانَ لَكُمۡ أَن تُؤۡذُواْ رَسُولَ ٱللَّهِ وَلَآ أَن تَنكِحُوٓاْ أَزۡوَٰجَهُۥ مِنۢ بَعۡدِهِۦٓ أَبَدًاۚ إِنَّ ذَٰلِكُمۡ كَانَ عِندَ ٱللَّهِ عَظِيمًا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تدخلوا بيوت النبي الا ان يؤذن لكم الىٰ طعام غير نٰظرين انىٰه ولٰكن اذا دعيتم فادخلوا فاذا طعمتم فانتشروا ولا مستنسين لحديث ان ذٰلكم كان يؤذي النبي فيستحي منكم والله لا يستحي من الحق واذا سالتموهن متٰعا فسلوهن من وراء حجاب ذٰلكم اطهر لقلوبكم وقلوبهن وما كان لكم ان تؤذوا رسول الله ولا ان تنكحوا ازوٰجه من بعده ابدا ان ذٰلكم كان عند الله عظيما",
    "ayahnumber" : "53",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3650",
    "page" : "425",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3651",
    "ayah_text" : "إِن تُبۡدُواْ شَيۡـًٔا أَوۡ تُخۡفُوهُ فَإِنَّ ٱللَّهَ كَانَ بِكُلِّ شَيۡءٍ عَلِيمٗا",
    "ayah_text_no_diacratic" : "ان تبدوا شيا او تخفوه فان الله كان بكل شيء عليما",
    "ayahnumber" : "54",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3651",
    "page" : "425",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3652",
    "ayah_text" : "لَّا جُنَاحَ عَلَيۡهِنَّ فِيٓ ءَابَآئِهِنَّ وَلَآ أَبۡنَآئِهِنَّ وَلَآ إِخۡوَٰنِهِنَّ وَلَآ أَبۡنَآءِ إِخۡوَٰنِهِنَّ وَلَآ أَبۡنَآءِ أَخَوَٰتِهِنَّ وَلَا نِسَآئِهِنَّ وَلَا مَا مَلَكَتۡ أَيۡمَٰنُهُنَّۗ وَٱتَّقِينَ ٱللَّهَۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدًا",
    "ayah_text_no_diacratic" : "لا جناح عليهن في ءابائهن ولا ابنائهن ولا اخوٰنهن ولا ابناء اخوٰنهن ولا ابناء اخوٰتهن ولا نسائهن ولا ما ملكت ايمٰنهن واتقين الله ان الله كان علىٰ كل شيء شهيدا",
    "ayahnumber" : "55",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3652",
    "page" : "426",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3653",
    "ayah_text" : "إِنَّ ٱللَّهَ وَمَلَٰٓئِكَتَهُۥ يُصَلُّونَ عَلَى ٱلنَّبِيِّۚ يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ صَلُّواْ عَلَيۡهِ وَسَلِّمُواْ تَسۡلِيمًا",
    "ayah_text_no_diacratic" : "ان الله وملٰئكته يصلون على النبي يٰايها الذين ءامنوا صلوا عليه وسلموا تسليما",
    "ayahnumber" : "56",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3653",
    "page" : "426",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3654",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يُؤۡذُونَ ٱللَّهَ وَرَسُولَهُۥ لَعَنَهُمُ ٱللَّهُ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَأَعَدَّ لَهُمۡ عَذَابٗا مُّهِينٗا",
    "ayah_text_no_diacratic" : "ان الذين يؤذون الله ورسوله لعنهم الله في الدنيا والاخرة واعد لهم عذابا مهينا",
    "ayahnumber" : "57",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3654",
    "page" : "426",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3655",
    "ayah_text" : "وَٱلَّذِينَ يُؤۡذُونَ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ بِغَيۡرِ مَا ٱكۡتَسَبُواْ فَقَدِ ٱحۡتَمَلُواْ بُهۡتَٰنٗا وَإِثۡمٗا مُّبِينٗا",
    "ayah_text_no_diacratic" : "والذين يؤذون المؤمنين والمؤمنٰت بغير ما اكتسبوا فقد احتملوا بهتٰنا واثما مبينا",
    "ayahnumber" : "58",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3655",
    "page" : "426",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3656",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ قُل لِّأَزۡوَٰجِكَ وَبَنَاتِكَ وَنِسَآءِ ٱلۡمُؤۡمِنِينَ يُدۡنِينَ عَلَيۡهِنَّ مِن جَلَٰبِيبِهِنَّۚ ذَٰلِكَ أَدۡنَىٰٓ أَن يُعۡرَفۡنَ فَلَا يُؤۡذَيۡنَۗ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "يٰايها النبي قل لازوٰجك وبناتك ونساء المؤمنين يدنين عليهن من جلٰبيبهن ذٰلك ادنىٰ ان يعرفن فلا يؤذين وكان الله غفورا رحيما",
    "ayahnumber" : "59",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3656",
    "page" : "426",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3657",
    "ayah_text" : "۞لَّئِن لَّمۡ يَنتَهِ ٱلۡمُنَٰفِقُونَ وَٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ وَٱلۡمُرۡجِفُونَ فِي ٱلۡمَدِينَةِ لَنُغۡرِيَنَّكَ بِهِمۡ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَآ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "لئن لم ينته المنٰفقون والذين في قلوبهم مرض والمرجفون في المدينة لنغرينك بهم ثم لا يجاورونك فيها الا قليلا",
    "ayahnumber" : "60",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3657",
    "page" : "426",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3658",
    "ayah_text" : "مَّلۡعُونِينَۖ أَيۡنَمَا ثُقِفُوٓاْ أُخِذُواْ وَقُتِّلُواْ تَقۡتِيلٗا",
    "ayah_text_no_diacratic" : "ملعونين اينما ثقفوا اخذوا وقتلوا تقتيلا",
    "ayahnumber" : "61",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3658",
    "page" : "426",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3659",
    "ayah_text" : "سُنَّةَ ٱللَّهِ فِي ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلُۖ وَلَن تَجِدَ لِسُنَّةِ ٱللَّهِ تَبۡدِيلٗا",
    "ayah_text_no_diacratic" : "سنة الله في الذين خلوا من قبل ولن تجد لسنة الله تبديلا",
    "ayahnumber" : "62",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3659",
    "page" : "426",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:366",
    "ayah_text" : "إِنَّ أَوۡلَى ٱلنَّاسِ بِإِبۡرَٰهِيمَ لَلَّذِينَ ٱتَّبَعُوهُ وَهَٰذَا ٱلنَّبِيُّ وَٱلَّذِينَ ءَامَنُواْۗ وَٱللَّهُ وَلِيُّ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ان اولى الناس بابرٰهيم للذين اتبعوه وهٰذا النبي والذين ءامنوا والله ولي المؤمنين",
    "ayahnumber" : "68",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "366",
    "page" : "58",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3660",
    "ayah_text" : "يَسۡـَٔلُكَ ٱلنَّاسُ عَنِ ٱلسَّاعَةِۖ قُلۡ إِنَّمَا عِلۡمُهَا عِندَ ٱللَّهِۚ وَمَا يُدۡرِيكَ لَعَلَّ ٱلسَّاعَةَ تَكُونُ قَرِيبًا",
    "ayah_text_no_diacratic" : "يسلك الناس عن الساعة قل انما علمها عند الله وما يدريك لعل الساعة تكون قريبا",
    "ayahnumber" : "63",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3660",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3661",
    "ayah_text" : "إِنَّ ٱللَّهَ لَعَنَ ٱلۡكَٰفِرِينَ وَأَعَدَّ لَهُمۡ سَعِيرًا",
    "ayah_text_no_diacratic" : "ان الله لعن الكٰفرين واعد لهم سعيرا",
    "ayahnumber" : "64",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3661",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3662",
    "ayah_text" : "خَٰلِدِينَ فِيهَآ أَبَدٗاۖ لَّا يَجِدُونَ وَلِيّٗا وَلَا نَصِيرٗا",
    "ayah_text_no_diacratic" : "خٰلدين فيها ابدا لا يجدون وليا ولا نصيرا",
    "ayahnumber" : "65",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3662",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3663",
    "ayah_text" : "يَوۡمَ تُقَلَّبُ وُجُوهُهُمۡ فِي ٱلنَّارِ يَقُولُونَ يَٰلَيۡتَنَآ أَطَعۡنَا ٱللَّهَ وَأَطَعۡنَا ٱلرَّسُولَا۠",
    "ayah_text_no_diacratic" : "يوم تقلب وجوههم في النار يقولون يٰليتنا اطعنا الله واطعنا الرسولا",
    "ayahnumber" : "66",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3663",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3664",
    "ayah_text" : "وَقَالُواْ رَبَّنَآ إِنَّآ أَطَعۡنَا سَادَتَنَا وَكُبَرَآءَنَا فَأَضَلُّونَا ٱلسَّبِيلَا۠",
    "ayah_text_no_diacratic" : "وقالوا ربنا انا اطعنا سادتنا وكبراءنا فاضلونا السبيلا",
    "ayahnumber" : "67",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3664",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3665",
    "ayah_text" : "رَبَّنَآ ءَاتِهِمۡ ضِعۡفَيۡنِ مِنَ ٱلۡعَذَابِ وَٱلۡعَنۡهُمۡ لَعۡنٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "ربنا ءاتهم ضعفين من العذاب والعنهم لعنا كبيرا",
    "ayahnumber" : "68",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3665",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3666",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَكُونُواْ كَٱلَّذِينَ ءَاذَوۡاْ مُوسَىٰ فَبَرَّأَهُ ٱللَّهُ مِمَّا قَالُواْۚ وَكَانَ عِندَ ٱللَّهِ وَجِيهٗا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تكونوا كالذين ءاذوا موسىٰ فبراه الله مما قالوا وكان عند الله وجيها",
    "ayahnumber" : "69",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3666",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3667",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ وَقُولُواْ قَوۡلٗا سَدِيدٗا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اتقوا الله وقولوا قولا سديدا",
    "ayahnumber" : "70",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3667",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3668",
    "ayah_text" : "يُصۡلِحۡ لَكُمۡ أَعۡمَٰلَكُمۡ وَيَغۡفِرۡ لَكُمۡ ذُنُوبَكُمۡۗ وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ فَقَدۡ فَازَ فَوۡزًا عَظِيمًا",
    "ayah_text_no_diacratic" : "يصلح لكم اعمٰلكم ويغفر لكم ذنوبكم ومن يطع الله ورسوله فقد فاز فوزا عظيما",
    "ayahnumber" : "71",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3668",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3669",
    "ayah_text" : "إِنَّا عَرَضۡنَا ٱلۡأَمَانَةَ عَلَى ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَٱلۡجِبَالِ فَأَبَيۡنَ أَن يَحۡمِلۡنَهَا وَأَشۡفَقۡنَ مِنۡهَا وَحَمَلَهَا ٱلۡإِنسَٰنُۖ إِنَّهُۥ كَانَ ظَلُومٗا جَهُولٗا",
    "ayah_text_no_diacratic" : "انا عرضنا الامانة على السمٰوٰت والارض والجبال فابين ان يحملنها واشفقن منها وحملها الانسٰن انه كان ظلوما جهولا",
    "ayahnumber" : "72",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3669",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:367",
    "ayah_text" : "وَدَّت طَّآئِفَةٞ مِّنۡ أَهۡلِ ٱلۡكِتَٰبِ لَوۡ يُضِلُّونَكُمۡ وَمَا يُضِلُّونَ إِلَّآ أَنفُسَهُمۡ وَمَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "ودت طائفة من اهل الكتٰب لو يضلونكم وما يضلون الا انفسهم وما يشعرون",
    "ayahnumber" : "69",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "367",
    "page" : "58",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3670",
    "ayah_text" : "لِّيُعَذِّبَ ٱللَّهُ ٱلۡمُنَٰفِقِينَ وَٱلۡمُنَٰفِقَٰتِ وَٱلۡمُشۡرِكِينَ وَٱلۡمُشۡرِكَٰتِ وَيَتُوبَ ٱللَّهُ عَلَى ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِۗ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمَۢا",
    "ayah_text_no_diacratic" : "ليعذب الله المنٰفقين والمنٰفقٰت والمشركين والمشركٰت ويتوب الله على المؤمنين والمؤمنٰت وكان الله غفورا رحيما",
    "ayahnumber" : "73",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3670",
    "page" : "427",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3671",
    "ayah_text" : "سُورَةُ سَبَإٍ",
    "ayah_text_no_diacratic" : "سورة سبا",
    "ayahnumber" : "0",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3671",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3672",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3672",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3673",
    "ayah_text" : "ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ وَلَهُ ٱلۡحَمۡدُ فِي ٱلۡأٓخِرَةِۚ وَهُوَ ٱلۡحَكِيمُ ٱلۡخَبِيرُ",
    "ayah_text_no_diacratic" : "الحمد لله الذي له ما في السمٰوٰت وما في الارض وله الحمد في الاخرة وهو الحكيم الخبير",
    "ayahnumber" : "1",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3673",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3674",
    "ayah_text" : "يَعۡلَمُ مَا يَلِجُ فِي ٱلۡأَرۡضِ وَمَا يَخۡرُجُ مِنۡهَا وَمَا يَنزِلُ مِنَ ٱلسَّمَآءِ وَمَا يَعۡرُجُ فِيهَاۚ وَهُوَ ٱلرَّحِيمُ ٱلۡغَفُورُ",
    "ayah_text_no_diacratic" : "يعلم ما يلج في الارض وما يخرج منها وما ينزل من السماء وما يعرج فيها وهو الرحيم الغفور",
    "ayahnumber" : "2",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3674",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3675",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُواْ لَا تَأۡتِينَا ٱلسَّاعَةُۖ قُلۡ بَلَىٰ وَرَبِّي لَتَأۡتِيَنَّكُمۡ عَٰلِمِ ٱلۡغَيۡبِۖ لَا يَعۡزُبُ عَنۡهُ مِثۡقَالُ ذَرَّةٖ فِي ٱلسَّمَٰوَٰتِ وَلَا فِي ٱلۡأَرۡضِ وَلَآ أَصۡغَرُ مِن ذَٰلِكَ وَلَآ أَكۡبَرُ إِلَّا فِي كِتَٰبٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "وقال الذين كفروا لا تاتينا الساعة قل بلىٰ وربي لتاتينكم عٰلم الغيب لا يعزب عنه مثقال ذرة في السمٰوٰت ولا في الارض ولا اصغر من ذٰلك ولا اكبر الا في كتٰب مبين",
    "ayahnumber" : "3",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3675",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3676",
    "ayah_text" : "لِّيَجۡزِيَ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِۚ أُوْلَٰٓئِكَ لَهُم مَّغۡفِرَةٞ وَرِزۡقٞ كَرِيمٞ",
    "ayah_text_no_diacratic" : "ليجزي الذين ءامنوا وعملوا الصٰلحٰت اولٰئك لهم مغفرة ورزق كريم",
    "ayahnumber" : "4",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3676",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3677",
    "ayah_text" : "وَٱلَّذِينَ سَعَوۡ فِيٓ ءَايَٰتِنَا مُعَٰجِزِينَ أُوْلَٰٓئِكَ لَهُمۡ عَذَابٞ مِّن رِّجۡزٍ أَلِيمٞ",
    "ayah_text_no_diacratic" : "والذين سعو في ءايٰتنا معٰجزين اولٰئك لهم عذاب من رجز اليم",
    "ayahnumber" : "5",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3677",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3678",
    "ayah_text" : "وَيَرَى ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ ٱلَّذِيٓ أُنزِلَ إِلَيۡكَ مِن رَّبِّكَ هُوَ ٱلۡحَقَّ وَيَهۡدِيٓ إِلَىٰ صِرَٰطِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ",
    "ayah_text_no_diacratic" : "ويرى الذين اوتوا العلم الذي انزل اليك من ربك هو الحق ويهدي الىٰ صرٰط العزيز الحميد",
    "ayahnumber" : "6",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3678",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3679",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُواْ هَلۡ نَدُلُّكُمۡ عَلَىٰ رَجُلٖ يُنَبِّئُكُمۡ إِذَا مُزِّقۡتُمۡ كُلَّ مُمَزَّقٍ إِنَّكُمۡ لَفِي خَلۡقٖ جَدِيدٍ",
    "ayah_text_no_diacratic" : "وقال الذين كفروا هل ندلكم علىٰ رجل ينبئكم اذا مزقتم كل ممزق انكم لفي خلق جديد",
    "ayahnumber" : "7",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3679",
    "page" : "428",
    "surahname" : "سُورَةُ سَبَإٍ",
