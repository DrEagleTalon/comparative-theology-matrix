    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1242",
    "ayah_text" : "مَا كَانَ لِنَبِيٍّ أَن يَكُونَ لَهُۥٓ أَسۡرَىٰ حَتَّىٰ يُثۡخِنَ فِي ٱلۡأَرۡضِۚ تُرِيدُونَ عَرَضَ ٱلدُّنۡيَا وَٱللَّهُ يُرِيدُ ٱلۡأٓخِرَةَۗ وَٱللَّهُ عَزِيزٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "ما كان لنبي ان يكون له اسرىٰ حتىٰ يثخن في الارض تريدون عرض الدنيا والله يريد الاخرة والله عزيز حكيم",
    "ayahnumber" : "67",
    "chapter" : "10",
    "hizb" : "18",
