  }, {
    "@id" : "quran:2701",
    "ayah_text" : "لَّهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ وَإِنَّ ٱللَّهَ لَهُوَ ٱلۡغَنِيُّ ٱلۡحَمِيدُ",
    "ayah_text_no_diacratic" : "له ما في السمٰوٰت وما في الارض وان الله لهو الغني الحميد",
    "ayahnumber" : "64",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2701",
    "page" : "339",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2702",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱللَّهَ سَخَّرَ لَكُم مَّا فِي ٱلۡأَرۡضِ وَٱلۡفُلۡكَ تَجۡرِي فِي ٱلۡبَحۡرِ بِأَمۡرِهِۦ وَيُمۡسِكُ ٱلسَّمَآءَ أَن تَقَعَ عَلَى ٱلۡأَرۡضِ إِلَّا بِإِذۡنِهِۦٓۚ إِنَّ ٱللَّهَ بِٱلنَّاسِ لَرَءُوفٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "الم تر ان الله سخر لكم ما في الارض والفلك تجري في البحر بامره ويمسك السماء ان تقع على الارض الا باذنه ان الله بالناس لرءوف رحيم",
    "ayahnumber" : "65",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2702",
    "page" : "340",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2703",
    "ayah_text" : "وَهُوَ ٱلَّذِيٓ أَحۡيَاكُمۡ ثُمَّ يُمِيتُكُمۡ ثُمَّ يُحۡيِيكُمۡۗ إِنَّ ٱلۡإِنسَٰنَ لَكَفُورٞ",
    "ayah_text_no_diacratic" : "وهو الذي احياكم ثم يميتكم ثم يحييكم ان الانسٰن لكفور",
    "ayahnumber" : "66",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2703",
    "page" : "340",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2704",
    "ayah_text" : "لِّكُلِّ أُمَّةٖ جَعَلۡنَا مَنسَكًا هُمۡ نَاسِكُوهُۖ فَلَا يُنَٰزِعُنَّكَ فِي ٱلۡأَمۡرِۚ وَٱدۡعُ إِلَىٰ رَبِّكَۖ إِنَّكَ لَعَلَىٰ هُدٗى مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "لكل امة جعلنا منسكا هم ناسكوه فلا ينٰزعنك في الامر وادع الىٰ ربك انك لعلىٰ هدى مستقيم",
    "ayahnumber" : "67",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2704",
    "page" : "340",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2705",
    "ayah_text" : "وَإِن جَٰدَلُوكَ فَقُلِ ٱللَّهُ أَعۡلَمُ بِمَا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "وان جٰدلوك فقل الله اعلم بما تعملون",
    "ayahnumber" : "68",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2705",
    "page" : "340",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2706",
    "ayah_text" : "ٱللَّهُ يَحۡكُمُ بَيۡنَكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ فِيمَا كُنتُمۡ فِيهِ تَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "الله يحكم بينكم يوم القيٰمة فيما كنتم فيه تختلفون",
    "ayahnumber" : "69",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2706",
    "page" : "340",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2707",
    "ayah_text" : "أَلَمۡ تَعۡلَمۡ أَنَّ ٱللَّهَ يَعۡلَمُ مَا فِي ٱلسَّمَآءِ وَٱلۡأَرۡضِۚ إِنَّ ذَٰلِكَ فِي كِتَٰبٍۚ إِنَّ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٞ",
    "ayah_text_no_diacratic" : "الم تعلم ان الله يعلم ما في السماء والارض ان ذٰلك في كتٰب ان ذٰلك على الله يسير",
    "ayahnumber" : "70",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2707",
    "page" : "340",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2708",
    "ayah_text" : "وَيَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَمۡ يُنَزِّلۡ بِهِۦ سُلۡطَٰنٗا وَمَا لَيۡسَ لَهُم بِهِۦ عِلۡمٞۗ وَمَا لِلظَّٰلِمِينَ مِن نَّصِيرٖ",
    "ayah_text_no_diacratic" : "ويعبدون من دون الله ما لم ينزل به سلطٰنا وما ليس لهم به علم وما للظٰلمين من نصير",
    "ayahnumber" : "71",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2708",
    "page" : "340",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2709",
    "ayah_text" : "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُنَا بَيِّنَٰتٖ تَعۡرِفُ فِي وُجُوهِ ٱلَّذِينَ كَفَرُواْ ٱلۡمُنكَرَۖ يَكَادُونَ يَسۡطُونَ بِٱلَّذِينَ يَتۡلُونَ عَلَيۡهِمۡ ءَايَٰتِنَاۗ قُلۡ أَفَأُنَبِّئُكُم بِشَرّٖ مِّن ذَٰلِكُمُۚ ٱلنَّارُ وَعَدَهَا ٱللَّهُ ٱلَّذِينَ كَفَرُواْۖ وَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "واذا تتلىٰ عليهم ءايٰتنا بينٰت تعرف في وجوه الذين كفروا المنكر يكادون يسطون بالذين يتلون عليهم ءايٰتنا قل افانبئكم بشر من ذٰلكم النار وعدها الله الذين كفروا وبئس المصير",
    "ayahnumber" : "72",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2709",
    "page" : "340",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:271",
    "ayah_text" : "مَّثَلُ ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُمۡ فِي سَبِيلِ ٱللَّهِ كَمَثَلِ حَبَّةٍ أَنۢبَتَتۡ سَبۡعَ سَنَابِلَ فِي كُلِّ سُنۢبُلَةٖ مِّاْئَةُ حَبَّةٖۗ وَٱللَّهُ يُضَٰعِفُ لِمَن يَشَآءُۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ",
    "ayah_text_no_diacratic" : "مثل الذين ينفقون اموٰلهم في سبيل الله كمثل حبة انبتت سبع سنابل في كل سنبلة مائة حبة والله يضٰعف لمن يشاء والله وٰسع عليم",
    "ayahnumber" : "261",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "271",
    "page" : "44",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2710",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ ضُرِبَ مَثَلٞ فَٱسۡتَمِعُواْ لَهُۥٓۚ إِنَّ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِ لَن يَخۡلُقُواْ ذُبَابٗا وَلَوِ ٱجۡتَمَعُواْ لَهُۥۖ وَإِن يَسۡلُبۡهُمُ ٱلذُّبَابُ شَيۡـٔٗا لَّا يَسۡتَنقِذُوهُ مِنۡهُۚ ضَعُفَ ٱلطَّالِبُ وَٱلۡمَطۡلُوبُ",
    "ayah_text_no_diacratic" : "يٰايها الناس ضرب مثل فاستمعوا له ان الذين تدعون من دون الله لن يخلقوا ذبابا ولو اجتمعوا له وان يسلبهم الذباب شيا لا يستنقذوه منه ضعف الطالب والمطلوب",
    "ayahnumber" : "73",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2710",
    "page" : "341",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2711",
    "ayah_text" : "مَا قَدَرُواْ ٱللَّهَ حَقَّ قَدۡرِهِۦٓۚ إِنَّ ٱللَّهَ لَقَوِيٌّ عَزِيزٌ",
    "ayah_text_no_diacratic" : "ما قدروا الله حق قدره ان الله لقوي عزيز",
    "ayahnumber" : "74",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2711",
    "page" : "341",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2712",
    "ayah_text" : "ٱللَّهُ يَصۡطَفِي مِنَ ٱلۡمَلَٰٓئِكَةِ رُسُلٗا وَمِنَ ٱلنَّاسِۚ إِنَّ ٱللَّهَ سَمِيعُۢ بَصِيرٞ",
    "ayah_text_no_diacratic" : "الله يصطفي من الملٰئكة رسلا ومن الناس ان الله سميع بصير",
    "ayahnumber" : "75",
    "chapter" : "17",
    "hizb" : "34",
    "index" : "2712",
    "page" : "341",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2713",
    "ayah_text" : "يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡۚ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ",
    "ayah_text_no_diacratic" : "يعلم ما بين ايديهم وما خلفهم والى الله ترجع الامور",
    "ayahnumber" : "76",
    "chapter" : "17",
    "hizb" : "34",
