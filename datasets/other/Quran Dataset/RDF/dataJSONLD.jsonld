  }, {
    "@id" : "quran:5305",
    "ayah_text" : "قُلۡ يَٰٓأَيُّهَا ٱلَّذِينَ هَادُوٓاْ إِن زَعَمۡتُمۡ أَنَّكُمۡ أَوۡلِيَآءُ لِلَّهِ مِن دُونِ ٱلنَّاسِ فَتَمَنَّوُاْ ٱلۡمَوۡتَ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "قل يٰايها الذين هادوا ان زعمتم انكم اولياء لله من دون الناس فتمنوا الموت ان كنتم صٰدقين",
    "ayahnumber" : "6",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5305",
    "page" : "553",
    "surahname" : "سُورَةُ الجُمُعَةِ",
    "surahnumber" : "62",
    "surrahname_no_diacratic" : "سورة الجمعة"
  }, {
    "@id" : "quran:5306",
    "ayah_text" : "وَلَا يَتَمَنَّوۡنَهُۥٓ أَبَدَۢا بِمَا قَدَّمَتۡ أَيۡدِيهِمۡۚ وَٱللَّهُ عَلِيمُۢ بِٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ولا يتمنونه ابدا بما قدمت ايديهم والله عليم بالظٰلمين",
    "ayahnumber" : "7",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5306",
    "page" : "553",
    "surahname" : "سُورَةُ الجُمُعَةِ",
    "surahnumber" : "62",
    "surrahname_no_diacratic" : "سورة الجمعة"
  }, {
    "@id" : "quran:5307",
    "ayah_text" : "قُلۡ إِنَّ ٱلۡمَوۡتَ ٱلَّذِي تَفِرُّونَ مِنۡهُ فَإِنَّهُۥ مُلَٰقِيكُمۡۖ ثُمَّ تُرَدُّونَ إِلَىٰ عَٰلِمِ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ فَيُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "قل ان الموت الذي تفرون منه فانه ملٰقيكم ثم تردون الىٰ عٰلم الغيب والشهٰدة فينبئكم بما كنتم تعملون",
    "ayahnumber" : "8",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5307",
    "page" : "553",
    "surahname" : "سُورَةُ الجُمُعَةِ",
    "surahnumber" : "62",
    "surrahname_no_diacratic" : "سورة الجمعة"
  }, {
    "@id" : "quran:5308",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا نُودِيَ لِلصَّلَوٰةِ مِن يَوۡمِ ٱلۡجُمُعَةِ فَٱسۡعَوۡاْ إِلَىٰ ذِكۡرِ ٱللَّهِ وَذَرُواْ ٱلۡبَيۡعَۚ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اذا نودي للصلوٰة من يوم الجمعة فاسعوا الىٰ ذكر الله وذروا البيع ذٰلكم خير لكم ان كنتم تعلمون",
    "ayahnumber" : "9",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5308",
    "page" : "554",
    "surahname" : "سُورَةُ الجُمُعَةِ",
    "surahnumber" : "62",
    "surrahname_no_diacratic" : "سورة الجمعة"
  }, {
    "@id" : "quran:5309",
    "ayah_text" : "فَإِذَا قُضِيَتِ ٱلصَّلَوٰةُ فَٱنتَشِرُواْ فِي ٱلۡأَرۡضِ وَٱبۡتَغُواْ مِن فَضۡلِ ٱللَّهِ وَٱذۡكُرُواْ ٱللَّهَ كَثِيرٗا لَّعَلَّكُمۡ تُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "فاذا قضيت الصلوٰة فانتشروا في الارض وابتغوا من فضل الله واذكروا الله كثيرا لعلكم تفلحون",
    "ayahnumber" : "10",
    "chapter" : "28",
    "hizb" : "55",
