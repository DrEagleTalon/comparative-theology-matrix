  }, {
    "@id" : "quran:6325",
    "ayah_text" : "فِيهَا كُتُبٞ قَيِّمَةٞ",
    "ayah_text_no_diacratic" : "فيها كتب قيمة",
    "ayahnumber" : "3",
    "chapter" : "30",
    "hizb" : "59",
    "index" : "6325",
    "page" : "598",
    "surahname" : "سُورَةُ البَيِّنَةِ",
    "surahnumber" : "98",
    "surrahname_no_diacratic" : "سورة البينة"
  }, {
    "@id" : "quran:6326",
    "ayah_text" : "وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ إِلَّا مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَةُ",
    "ayah_text_no_diacratic" : "وما تفرق الذين اوتوا الكتٰب الا من بعد ما جاءتهم البينة",
    "ayahnumber" : "4",
    "chapter" : "30",
    "hizb" : "59",
    "index" : "6326",
    "page" : "598",
    "surahname" : "سُورَةُ البَيِّنَةِ",
    "surahnumber" : "98",
    "surrahname_no_diacratic" : "سورة البينة"
  }, {
    "@id" : "quran:6327",
    "ayah_text" : "وَمَآ أُمِرُوٓاْ إِلَّا لِيَعۡبُدُواْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُواْ ٱلصَّلَوٰةَ وَيُؤۡتُواْ ٱلزَّكَوٰةَۚ وَذَٰلِكَ دِينُ ٱلۡقَيِّمَةِ",
    "ayah_text_no_diacratic" : "وما امروا الا ليعبدوا الله مخلصين له الدين حنفاء ويقيموا الصلوٰة ويؤتوا الزكوٰة وذٰلك دين القيمة",
    "ayahnumber" : "5",
    "chapter" : "30",
    "hizb" : "59",
    "index" : "6327",
    "page" : "598",
    "surahname" : "سُورَةُ البَيِّنَةِ",
    "surahnumber" : "98",
    "surrahname_no_diacratic" : "سورة البينة"
  }, {
    "@id" : "quran:6328",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ فِي نَارِ جَهَنَّمَ خَٰلِدِينَ فِيهَآۚ أُوْلَٰٓئِكَ هُمۡ شَرُّ ٱلۡبَرِيَّةِ",
    "ayah_text_no_diacratic" : "ان الذين كفروا من اهل الكتٰب والمشركين في نار جهنم خٰلدين فيها اولٰئك هم شر البرية",
    "ayahnumber" : "6",
    "chapter" : "30",
    "hizb" : "59",
    "index" : "6328",
    "page" : "599",
    "surahname" : "سُورَةُ البَيِّنَةِ",
    "surahnumber" : "98",
    "surrahname_no_diacratic" : "سورة البينة"
  }, {
    "@id" : "quran:6329",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ أُوْلَٰٓئِكَ هُمۡ خَيۡرُ ٱلۡبَرِيَّةِ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت اولٰئك هم خير البرية",
    "ayahnumber" : "7",
    "chapter" : "30",
    "hizb" : "59",
    "index" : "6329",
    "page" : "599",
    "surahname" : "سُورَةُ البَيِّنَةِ",
    "surahnumber" : "98",
    "surrahname_no_diacratic" : "سورة البينة"
  }, {
    "@id" : "quran:633",
    "ayah_text" : "إِن يَشَأۡ يُذۡهِبۡكُمۡ أَيُّهَا ٱلنَّاسُ وَيَأۡتِ بِـَٔاخَرِينَۚ وَكَانَ ٱللَّهُ عَلَىٰ ذَٰلِكَ قَدِيرٗا",
    "ayah_text_no_diacratic" : "ان يشا يذهبكم ايها الناس ويات باخرين وكان الله علىٰ ذٰلك قديرا",
    "ayahnumber" : "133",
    "chapter" : "5",
    "hizb" : "9",
