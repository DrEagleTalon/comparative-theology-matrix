    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4129",
    "ayah_text" : "لَأَمۡلَأَنَّ جَهَنَّمَ مِنكَ وَمِمَّن تَبِعَكَ مِنۡهُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "لاملان جهنم منك وممن تبعك منهم اجمعين",
    "ayahnumber" : "85",
    "chapter" : "23",
