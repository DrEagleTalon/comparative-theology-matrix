    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4678",
    "ayah_text" : "إِنَّا فَتَحۡنَا لَكَ فَتۡحٗا مُّبِينٗا",
    "ayah_text_no_diacratic" : "انا فتحنا لك فتحا مبينا",
