  }, {
    "@id" : "quran:656",
    "ayah_text" : "وَبِكُفۡرِهِمۡ وَقَوۡلِهِمۡ عَلَىٰ مَرۡيَمَ بُهۡتَٰنًا عَظِيمٗا",
    "ayah_text_no_diacratic" : "وبكفرهم وقولهم علىٰ مريم بهتٰنا عظيما",
    "ayahnumber" : "156",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "656",
    "page" : "103",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:657",
    "ayah_text" : "وَقَوۡلِهِمۡ إِنَّا قَتَلۡنَا ٱلۡمَسِيحَ عِيسَى ٱبۡنَ مَرۡيَمَ رَسُولَ ٱللَّهِ وَمَا قَتَلُوهُ وَمَا صَلَبُوهُ وَلَٰكِن شُبِّهَ لَهُمۡۚ وَإِنَّ ٱلَّذِينَ ٱخۡتَلَفُواْ فِيهِ لَفِي شَكّٖ مِّنۡهُۚ مَا لَهُم بِهِۦ مِنۡ عِلۡمٍ إِلَّا ٱتِّبَاعَ ٱلظَّنِّۚ وَمَا قَتَلُوهُ يَقِينَۢا",
    "ayah_text_no_diacratic" : "وقولهم انا قتلنا المسيح عيسى ابن مريم رسول الله وما قتلوه وما صلبوه ولٰكن شبه لهم وان الذين اختلفوا فيه لفي شك منه ما لهم به من علم الا اتباع الظن وما قتلوه يقينا",
    "ayahnumber" : "157",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "657",
    "page" : "103",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:658",
    "ayah_text" : "بَل رَّفَعَهُ ٱللَّهُ إِلَيۡهِۚ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمٗا",
    "ayah_text_no_diacratic" : "بل رفعه الله اليه وكان الله عزيزا حكيما",
    "ayahnumber" : "158",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "658",
    "page" : "103",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:659",
    "ayah_text" : "وَإِن مِّنۡ أَهۡلِ ٱلۡكِتَٰبِ إِلَّا لَيُؤۡمِنَنَّ بِهِۦ قَبۡلَ مَوۡتِهِۦۖ وَيَوۡمَ ٱلۡقِيَٰمَةِ يَكُونُ عَلَيۡهِمۡ شَهِيدٗا",
    "ayah_text_no_diacratic" : "وان من اهل الكتٰب الا ليؤمنن به قبل موته ويوم القيٰمة يكون عليهم شهيدا",
    "ayahnumber" : "159",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "659",
    "page" : "103",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:66",
    "ayah_text" : "ثُمَّ بَعَثۡنَٰكُم مِّنۢ بَعۡدِ مَوۡتِكُمۡ لَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "ثم بعثنٰكم من بعد موتكم لعلكم تشكرون",
    "ayahnumber" : "56",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "66",
    "page" : "8",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:660",
    "ayah_text" : "فَبِظُلۡمٖ مِّنَ ٱلَّذِينَ هَادُواْ حَرَّمۡنَا عَلَيۡهِمۡ طَيِّبَٰتٍ أُحِلَّتۡ لَهُمۡ وَبِصَدِّهِمۡ عَن سَبِيلِ ٱللَّهِ كَثِيرٗا",
    "ayah_text_no_diacratic" : "فبظلم من الذين هادوا حرمنا عليهم طيبٰت احلت لهم وبصدهم عن سبيل الله كثيرا",
    "ayahnumber" : "160",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "660",
    "page" : "103",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:661",
    "ayah_text" : "وَأَخۡذِهِمُ ٱلرِّبَوٰاْ وَقَدۡ نُهُواْ عَنۡهُ وَأَكۡلِهِمۡ أَمۡوَٰلَ ٱلنَّاسِ بِٱلۡبَٰطِلِۚ وَأَعۡتَدۡنَا لِلۡكَٰفِرِينَ مِنۡهُمۡ عَذَابًا أَلِيمٗا",
    "ayah_text_no_diacratic" : "واخذهم الربوٰا وقد نهوا عنه واكلهم اموٰل الناس بالبٰطل واعتدنا للكٰفرين منهم عذابا اليما",
    "ayahnumber" : "161",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "661",
    "page" : "103",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:662",
    "ayah_text" : "لَّٰكِنِ ٱلرَّٰسِخُونَ فِي ٱلۡعِلۡمِ مِنۡهُمۡ وَٱلۡمُؤۡمِنُونَ يُؤۡمِنُونَ بِمَآ أُنزِلَ إِلَيۡكَ وَمَآ أُنزِلَ مِن قَبۡلِكَۚ وَٱلۡمُقِيمِينَ ٱلصَّلَوٰةَۚ وَٱلۡمُؤۡتُونَ ٱلزَّكَوٰةَ وَٱلۡمُؤۡمِنُونَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ أُوْلَٰٓئِكَ سَنُؤۡتِيهِمۡ أَجۡرًا عَظِيمًا",
    "ayah_text_no_diacratic" : "لٰكن الرٰسخون في العلم منهم والمؤمنون يؤمنون بما انزل اليك وما انزل من قبلك والمقيمين الصلوٰة والمؤتون الزكوٰة والمؤمنون بالله واليوم الاخر اولٰئك سنؤتيهم اجرا عظيما",
    "ayahnumber" : "162",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "662",
    "page" : "103",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:663",
    "ayah_text" : "۞إِنَّآ أَوۡحَيۡنَآ إِلَيۡكَ كَمَآ أَوۡحَيۡنَآ إِلَىٰ نُوحٖ وَٱلنَّبِيِّـۧنَ مِنۢ بَعۡدِهِۦۚ وَأَوۡحَيۡنَآ إِلَىٰٓ إِبۡرَٰهِيمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ وَيَعۡقُوبَ وَٱلۡأَسۡبَاطِ وَعِيسَىٰ وَأَيُّوبَ وَيُونُسَ وَهَٰرُونَ وَسُلَيۡمَٰنَۚ وَءَاتَيۡنَا دَاوُۥدَ زَبُورٗا",
    "ayah_text_no_diacratic" : "انا اوحينا اليك كما اوحينا الىٰ نوح والنبين من بعده واوحينا الىٰ ابرٰهيم واسمٰعيل واسحٰق ويعقوب والاسباط وعيسىٰ وايوب ويونس وهٰرون وسليمٰن وءاتينا داود زبورا",
    "ayahnumber" : "163",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "663",
    "page" : "104",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:664",
    "ayah_text" : "وَرُسُلٗا قَدۡ قَصَصۡنَٰهُمۡ عَلَيۡكَ مِن قَبۡلُ وَرُسُلٗا لَّمۡ نَقۡصُصۡهُمۡ عَلَيۡكَۚ وَكَلَّمَ ٱللَّهُ مُوسَىٰ تَكۡلِيمٗا",
    "ayah_text_no_diacratic" : "ورسلا قد قصصنٰهم عليك من قبل ورسلا لم نقصصهم عليك وكلم الله موسىٰ تكليما",
    "ayahnumber" : "164",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "664",
    "page" : "104",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:665",
    "ayah_text" : "رُّسُلٗا مُّبَشِّرِينَ وَمُنذِرِينَ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَى ٱللَّهِ حُجَّةُۢ بَعۡدَ ٱلرُّسُلِۚ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمٗا",
    "ayah_text_no_diacratic" : "رسلا مبشرين ومنذرين لئلا يكون للناس على الله حجة بعد الرسل وكان الله عزيزا حكيما",
    "ayahnumber" : "165",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "665",
    "page" : "104",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:666",
    "ayah_text" : "لَّٰكِنِ ٱللَّهُ يَشۡهَدُ بِمَآ أَنزَلَ إِلَيۡكَۖ أَنزَلَهُۥ بِعِلۡمِهِۦۖ وَٱلۡمَلَٰٓئِكَةُ يَشۡهَدُونَۚ وَكَفَىٰ بِٱللَّهِ شَهِيدًا",
    "ayah_text_no_diacratic" : "لٰكن الله يشهد بما انزل اليك انزله بعلمه والملٰئكة يشهدون وكفىٰ بالله شهيدا",
    "ayahnumber" : "166",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "666",
    "page" : "104",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:667",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ وَصَدُّواْ عَن سَبِيلِ ٱللَّهِ قَدۡ ضَلُّواْ ضَلَٰلَۢا بَعِيدًا",
    "ayah_text_no_diacratic" : "ان الذين كفروا وصدوا عن سبيل الله قد ضلوا ضلٰلا بعيدا",
    "ayahnumber" : "167",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "667",
    "page" : "104",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:668",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ وَظَلَمُواْ لَمۡ يَكُنِ ٱللَّهُ لِيَغۡفِرَ لَهُمۡ وَلَا لِيَهۡدِيَهُمۡ طَرِيقًا",
    "ayah_text_no_diacratic" : "ان الذين كفروا وظلموا لم يكن الله ليغفر لهم ولا ليهديهم طريقا",
    "ayahnumber" : "168",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "668",
    "page" : "104",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:669",
    "ayah_text" : "إِلَّا طَرِيقَ جَهَنَّمَ خَٰلِدِينَ فِيهَآ أَبَدٗاۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٗا",
    "ayah_text_no_diacratic" : "الا طريق جهنم خٰلدين فيها ابدا وكان ذٰلك على الله يسيرا",
    "ayahnumber" : "169",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "669",
    "page" : "104",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:67",
    "ayah_text" : "وَظَلَّلۡنَا عَلَيۡكُمُ ٱلۡغَمَامَ وَأَنزَلۡنَا عَلَيۡكُمُ ٱلۡمَنَّ وَٱلسَّلۡوَىٰۖ كُلُواْ مِن طَيِّبَٰتِ مَا رَزَقۡنَٰكُمۡۚ وَمَا ظَلَمُونَا وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ",
    "ayah_text_no_diacratic" : "وظللنا عليكم الغمام وانزلنا عليكم المن والسلوىٰ كلوا من طيبٰت ما رزقنٰكم وما ظلمونا ولٰكن كانوا انفسهم يظلمون",
    "ayahnumber" : "57",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "67",
    "page" : "8",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:670",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ قَدۡ جَآءَكُمُ ٱلرَّسُولُ بِٱلۡحَقِّ مِن رَّبِّكُمۡ فَـَٔامِنُواْ خَيۡرٗا لَّكُمۡۚ وَإِن تَكۡفُرُواْ فَإِنَّ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمٗا",
    "ayah_text_no_diacratic" : "يٰايها الناس قد جاءكم الرسول بالحق من ربكم فامنوا خيرا لكم وان تكفروا فان لله ما في السمٰوٰت والارض وكان الله عليما حكيما",
    "ayahnumber" : "170",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "670",
    "page" : "104",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:671",
    "ayah_text" : "يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لَا تَغۡلُواْ فِي دِينِكُمۡ وَلَا تَقُولُواْ عَلَى ٱللَّهِ إِلَّا ٱلۡحَقَّۚ إِنَّمَا ٱلۡمَسِيحُ عِيسَى ٱبۡنُ مَرۡيَمَ رَسُولُ ٱللَّهِ وَكَلِمَتُهُۥٓ أَلۡقَىٰهَآ إِلَىٰ مَرۡيَمَ وَرُوحٞ مِّنۡهُۖ فَـَٔامِنُواْ بِٱللَّهِ وَرُسُلِهِۦۖ وَلَا تَقُولُواْ ثَلَٰثَةٌۚ ٱنتَهُواْ خَيۡرٗا لَّكُمۡۚ إِنَّمَا ٱللَّهُ إِلَٰهٞ وَٰحِدٞۖ سُبۡحَٰنَهُۥٓ أَن يَكُونَ لَهُۥ وَلَدٞۘ لَّهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ وَكَفَىٰ بِٱللَّهِ وَكِيلٗا",
    "ayah_text_no_diacratic" : "يٰاهل الكتٰب لا تغلوا في دينكم ولا تقولوا على الله الا الحق انما المسيح عيسى ابن مريم رسول الله وكلمته القىٰها الىٰ مريم وروح منه فامنوا بالله ورسله ولا تقولوا ثلٰثة انتهوا خيرا لكم انما الله الٰه وٰحد سبحٰنه ان يكون له ولد له ما في السمٰوٰت وما في الارض وكفىٰ بالله وكيلا",
    "ayahnumber" : "171",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "671",
    "page" : "105",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:672",
    "ayah_text" : "لَّن يَسۡتَنكِفَ ٱلۡمَسِيحُ أَن يَكُونَ عَبۡدٗا لِّلَّهِ وَلَا ٱلۡمَلَٰٓئِكَةُ ٱلۡمُقَرَّبُونَۚ وَمَن يَسۡتَنكِفۡ عَنۡ عِبَادَتِهِۦ وَيَسۡتَكۡبِرۡ فَسَيَحۡشُرُهُمۡ إِلَيۡهِ جَمِيعٗا",
    "ayah_text_no_diacratic" : "لن يستنكف المسيح ان يكون عبدا لله ولا الملٰئكة المقربون ومن يستنكف عن عبادته ويستكبر فسيحشرهم اليه جميعا",
    "ayahnumber" : "172",
