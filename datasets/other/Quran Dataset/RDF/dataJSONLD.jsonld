    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4951",
    "ayah_text" : "سُورَةُ القَمَرِ",
    "ayah_text_no_diacratic" : "سورة القمر",
    "ayahnumber" : "0",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4951",
    "page" : "528",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4952",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4952",
    "page" : "528",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4953",
    "ayah_text" : "ٱقۡتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلۡقَمَرُ",
    "ayah_text_no_diacratic" : "اقتربت الساعة وانشق القمر",
    "ayahnumber" : "1",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4953",
    "page" : "528",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4954",
    "ayah_text" : "وَإِن يَرَوۡاْ ءَايَةٗ يُعۡرِضُواْ وَيَقُولُواْ سِحۡرٞ مُّسۡتَمِرّٞ",
    "ayah_text_no_diacratic" : "وان يروا ءاية يعرضوا ويقولوا سحر مستمر",
    "ayahnumber" : "2",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4954",
    "page" : "528",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4955",
    "ayah_text" : "وَكَذَّبُواْ وَٱتَّبَعُوٓاْ أَهۡوَآءَهُمۡۚ وَكُلُّ أَمۡرٖ مُّسۡتَقِرّٞ",
    "ayah_text_no_diacratic" : "وكذبوا واتبعوا اهواءهم وكل امر مستقر",
    "ayahnumber" : "3",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4955",
    "page" : "528",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4956",
    "ayah_text" : "وَلَقَدۡ جَآءَهُم مِّنَ ٱلۡأَنۢبَآءِ مَا فِيهِ مُزۡدَجَرٌ",
    "ayah_text_no_diacratic" : "ولقد جاءهم من الانباء ما فيه مزدجر",
    "ayahnumber" : "4",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4956",
    "page" : "528",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4957",
    "ayah_text" : "حِكۡمَةُۢ بَٰلِغَةٞۖ فَمَا تُغۡنِ ٱلنُّذُرُ",
    "ayah_text_no_diacratic" : "حكمة بٰلغة فما تغن النذر",
    "ayahnumber" : "5",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4957",
    "page" : "528",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4958",
    "ayah_text" : "فَتَوَلَّ عَنۡهُمۡۘ يَوۡمَ يَدۡعُ ٱلدَّاعِ إِلَىٰ شَيۡءٖ نُّكُرٍ",
    "ayah_text_no_diacratic" : "فتول عنهم يوم يدع الداع الىٰ شيء نكر",
    "ayahnumber" : "6",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4958",
    "page" : "528",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4959",
    "ayah_text" : "خُشَّعًا أَبۡصَٰرُهُمۡ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ كَأَنَّهُمۡ جَرَادٞ مُّنتَشِرٞ",
    "ayah_text_no_diacratic" : "خشعا ابصٰرهم يخرجون من الاجداث كانهم جراد منتشر",
    "ayahnumber" : "7",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4959",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:496",
    "ayah_text" : "لَٰكِنِ ٱلَّذِينَ ٱتَّقَوۡاْ رَبَّهُمۡ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا نُزُلٗا مِّنۡ عِندِ ٱللَّهِۗ وَمَا عِندَ ٱللَّهِ خَيۡرٞ لِّلۡأَبۡرَارِ",
    "ayah_text_no_diacratic" : "لٰكن الذين اتقوا ربهم لهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها نزلا من عند الله وما عند الله خير للابرار",
    "ayahnumber" : "198",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "496",
    "page" : "76",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4960",
    "ayah_text" : "مُّهۡطِعِينَ إِلَى ٱلدَّاعِۖ يَقُولُ ٱلۡكَٰفِرُونَ هَٰذَا يَوۡمٌ عَسِرٞ",
    "ayah_text_no_diacratic" : "مهطعين الى الداع يقول الكٰفرون هٰذا يوم عسر",
    "ayahnumber" : "8",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4960",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4961",
    "ayah_text" : "۞كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحٖ فَكَذَّبُواْ عَبۡدَنَا وَقَالُواْ مَجۡنُونٞ وَٱزۡدُجِرَ",
    "ayah_text_no_diacratic" : "كذبت قبلهم قوم نوح فكذبوا عبدنا وقالوا مجنون وازدجر",
    "ayahnumber" : "9",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "4961",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4962",
    "ayah_text" : "فَدَعَا رَبَّهُۥٓ أَنِّي مَغۡلُوبٞ فَٱنتَصِرۡ",
    "ayah_text_no_diacratic" : "فدعا ربه اني مغلوب فانتصر",
    "ayahnumber" : "10",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "4962",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4963",
    "ayah_text" : "فَفَتَحۡنَآ أَبۡوَٰبَ ٱلسَّمَآءِ بِمَآءٖ مُّنۡهَمِرٖ",
    "ayah_text_no_diacratic" : "ففتحنا ابوٰب السماء بماء منهمر",
    "ayahnumber" : "11",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "4963",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4964",
    "ayah_text" : "وَفَجَّرۡنَا ٱلۡأَرۡضَ عُيُونٗا فَٱلۡتَقَى ٱلۡمَآءُ عَلَىٰٓ أَمۡرٖ قَدۡ قُدِرَ",
    "ayah_text_no_diacratic" : "وفجرنا الارض عيونا فالتقى الماء علىٰ امر قد قدر",
    "ayahnumber" : "12",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "4964",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4965",
    "ayah_text" : "وَحَمَلۡنَٰهُ عَلَىٰ ذَاتِ أَلۡوَٰحٖ وَدُسُرٖ",
    "ayah_text_no_diacratic" : "وحملنٰه علىٰ ذات الوٰح ودسر",
    "ayahnumber" : "13",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "4965",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4966",
    "ayah_text" : "تَجۡرِي بِأَعۡيُنِنَا جَزَآءٗ لِّمَن كَانَ كُفِرَ",
    "ayah_text_no_diacratic" : "تجري باعيننا جزاء لمن كان كفر",
    "ayahnumber" : "14",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "4966",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4967",
    "ayah_text" : "وَلَقَد تَّرَكۡنَٰهَآ ءَايَةٗ فَهَلۡ مِن مُّدَّكِرٖ",
    "ayah_text_no_diacratic" : "ولقد تركنٰها ءاية فهل من مدكر",
