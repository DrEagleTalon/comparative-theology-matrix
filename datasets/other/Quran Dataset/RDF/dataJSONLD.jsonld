    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4128",
    "ayah_text" : "قَالَ فَٱلۡحَقُّ وَٱلۡحَقَّ أَقُولُ",
    "ayah_text_no_diacratic" : "قال فالحق والحق اقول",
