    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4425",
    "ayah_text" : "أَمِ ٱتَّخَذَ مِمَّا يَخۡلُقُ بَنَاتٖ وَأَصۡفَىٰكُم بِٱلۡبَنِينَ",
    "ayah_text_no_diacratic" : "ام اتخذ مما يخلق بنات واصفىٰكم بالبنين",
    "ayahnumber" : "16",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4425",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4426",
    "ayah_text" : "وَإِذَا بُشِّرَ أَحَدُهُم بِمَا ضَرَبَ لِلرَّحۡمَٰنِ مَثَلٗا ظَلَّ وَجۡهُهُۥ مُسۡوَدّٗا وَهُوَ كَظِيمٌ",
    "ayah_text_no_diacratic" : "واذا بشر احدهم بما ضرب للرحمٰن مثلا ظل وجهه مسودا وهو كظيم",
    "ayahnumber" : "17",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4426",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4427",
    "ayah_text" : "أَوَمَن يُنَشَّؤُاْ فِي ٱلۡحِلۡيَةِ وَهُوَ فِي ٱلۡخِصَامِ غَيۡرُ مُبِينٖ",
    "ayah_text_no_diacratic" : "اومن ينشؤا في الحلية وهو في الخصام غير مبين",
    "ayahnumber" : "18",
