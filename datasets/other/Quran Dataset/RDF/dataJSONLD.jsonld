    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3961",
    "ayah_text" : "فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ",
    "ayah_text_no_diacratic" : "فبشرنٰه بغلٰم حليم",
    "ayahnumber" : "101",
