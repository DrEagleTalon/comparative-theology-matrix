  }, {
    "@id" : "quran:5437",
    "ayah_text" : "عَسَىٰ رَبُّنَآ أَن يُبۡدِلَنَا خَيۡرٗا مِّنۡهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ",
    "ayah_text_no_diacratic" : "عسىٰ ربنا ان يبدلنا خيرا منها انا الىٰ ربنا رٰغبون",
