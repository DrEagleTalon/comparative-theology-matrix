  }, {
    "@id" : "quran:4803",
    "ayah_text" : "فَأَوۡجَسَ مِنۡهُمۡ خِيفَةٗۖ قَالُواْ لَا تَخَفۡۖ وَبَشَّرُوهُ بِغُلَٰمٍ عَلِيمٖ",
    "ayah_text_no_diacratic" : "فاوجس منهم خيفة قالوا لا تخف وبشروه بغلٰم عليم",
