    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3289",
    "ayah_text" : "إِنَّ رَبَّكَ يَقۡضِي بَيۡنَهُم بِحُكۡمِهِۦۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "ان ربك يقضي بينهم بحكمه وهو العزيز العليم",
    "ayahnumber" : "78",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3289",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:329",
    "ayah_text" : "قُلۡ إِن كُنتُمۡ تُحِبُّونَ ٱللَّهَ فَٱتَّبِعُونِي يُحۡبِبۡكُمُ ٱللَّهُ وَيَغۡفِرۡ لَكُمۡ ذُنُوبَكُمۡۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "قل ان كنتم تحبون الله فاتبعوني يحببكم الله ويغفر لكم ذنوبكم والله غفور رحيم",
    "ayahnumber" : "31",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "329",
    "page" : "54",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3290",
    "ayah_text" : "فَتَوَكَّلۡ عَلَى ٱللَّهِۖ إِنَّكَ عَلَى ٱلۡحَقِّ ٱلۡمُبِينِ",
    "ayah_text_no_diacratic" : "فتوكل على الله انك على الحق المبين",
    "ayahnumber" : "79",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3290",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3291",
    "ayah_text" : "إِنَّكَ لَا تُسۡمِعُ ٱلۡمَوۡتَىٰ وَلَا تُسۡمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوۡاْ مُدۡبِرِينَ",
    "ayah_text_no_diacratic" : "انك لا تسمع الموتىٰ ولا تسمع الصم الدعاء اذا ولوا مدبرين",
    "ayahnumber" : "80",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3291",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3292",
    "ayah_text" : "وَمَآ أَنتَ بِهَٰدِي ٱلۡعُمۡيِ عَن ضَلَٰلَتِهِمۡۖ إِن تُسۡمِعُ إِلَّا مَن يُؤۡمِنُ بِـَٔايَٰتِنَا فَهُم مُّسۡلِمُونَ",
    "ayah_text_no_diacratic" : "وما انت بهٰدي العمي عن ضلٰلتهم ان تسمع الا من يؤمن بايٰتنا فهم مسلمون",
    "ayahnumber" : "81",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3292",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3293",
    "ayah_text" : "۞وَإِذَا وَقَعَ ٱلۡقَوۡلُ عَلَيۡهِمۡ أَخۡرَجۡنَا لَهُمۡ دَآبَّةٗ مِّنَ ٱلۡأَرۡضِ تُكَلِّمُهُمۡ أَنَّ ٱلنَّاسَ كَانُواْ بِـَٔايَٰتِنَا لَا يُوقِنُونَ",
    "ayah_text_no_diacratic" : "واذا وقع القول عليهم اخرجنا لهم دابة من الارض تكلمهم ان الناس كانوا بايٰتنا لا يوقنون",
    "ayahnumber" : "82",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3293",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3294",
    "ayah_text" : "وَيَوۡمَ نَحۡشُرُ مِن كُلِّ أُمَّةٖ فَوۡجٗا مِّمَّن يُكَذِّبُ بِـَٔايَٰتِنَا فَهُمۡ يُوزَعُونَ",
    "ayah_text_no_diacratic" : "ويوم نحشر من كل امة فوجا ممن يكذب بايٰتنا فهم يوزعون",
    "ayahnumber" : "83",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3294",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3295",
    "ayah_text" : "حَتَّىٰٓ إِذَا جَآءُو قَالَ أَكَذَّبۡتُم بِـَٔايَٰتِي وَلَمۡ تُحِيطُواْ بِهَا عِلۡمًا أَمَّاذَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "حتىٰ اذا جاءو قال اكذبتم بايٰتي ولم تحيطوا بها علما اماذا كنتم تعملون",
    "ayahnumber" : "84",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3295",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3296",
    "ayah_text" : "وَوَقَعَ ٱلۡقَوۡلُ عَلَيۡهِم بِمَا ظَلَمُواْ فَهُمۡ لَا يَنطِقُونَ",
    "ayah_text_no_diacratic" : "ووقع القول عليهم بما ظلموا فهم لا ينطقون",
    "ayahnumber" : "85",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3296",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3297",
    "ayah_text" : "أَلَمۡ يَرَوۡاْ أَنَّا جَعَلۡنَا ٱلَّيۡلَ لِيَسۡكُنُواْ فِيهِ وَٱلنَّهَارَ مُبۡصِرًاۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "الم يروا انا جعلنا اليل ليسكنوا فيه والنهار مبصرا ان في ذٰلك لايٰت لقوم يؤمنون",
    "ayahnumber" : "86",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3297",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3298",
    "ayah_text" : "وَيَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَفَزِعَ مَن فِي ٱلسَّمَٰوَٰتِ وَمَن فِي ٱلۡأَرۡضِ إِلَّا مَن شَآءَ ٱللَّهُۚ وَكُلٌّ أَتَوۡهُ دَٰخِرِينَ",
    "ayah_text_no_diacratic" : "ويوم ينفخ في الصور ففزع من في السمٰوٰت ومن في الارض الا من شاء الله وكل اتوه دٰخرين",
    "ayahnumber" : "87",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3298",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3299",
    "ayah_text" : "وَتَرَى ٱلۡجِبَالَ تَحۡسَبُهَا جَامِدَةٗ وَهِيَ تَمُرُّ مَرَّ ٱلسَّحَابِۚ صُنۡعَ ٱللَّهِ ٱلَّذِيٓ أَتۡقَنَ كُلَّ شَيۡءٍۚ إِنَّهُۥ خَبِيرُۢ بِمَا تَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "وترى الجبال تحسبها جامدة وهي تمر مر السحاب صنع الله الذي اتقن كل شيء انه خبير بما تفعلون",
    "ayahnumber" : "88",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3299",
    "page" : "384",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:33",
    "ayah_text" : "وَإِن كُنتُمۡ فِي رَيۡبٖ مِّمَّا نَزَّلۡنَا عَلَىٰ عَبۡدِنَا فَأۡتُواْ بِسُورَةٖ مِّن مِّثۡلِهِۦ وَٱدۡعُواْ شُهَدَآءَكُم مِّن دُونِ ٱللَّهِ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "وان كنتم في ريب مما نزلنا علىٰ عبدنا فاتوا بسورة من مثله وادعوا شهداءكم من دون الله ان كنتم صٰدقين",
    "ayahnumber" : "23",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "33",
    "page" : "4",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:330",
    "ayah_text" : "قُلۡ أَطِيعُواْ ٱللَّهَ وَٱلرَّسُولَۖ فَإِن تَوَلَّوۡاْ فَإِنَّ ٱللَّهَ لَا يُحِبُّ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "قل اطيعوا الله والرسول فان تولوا فان الله لا يحب الكٰفرين",
    "ayahnumber" : "32",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "330",
    "page" : "54",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3300",
    "ayah_text" : "مَن جَآءَ بِٱلۡحَسَنَةِ فَلَهُۥ خَيۡرٞ مِّنۡهَا وَهُم مِّن فَزَعٖ يَوۡمَئِذٍ ءَامِنُونَ",
    "ayah_text_no_diacratic" : "من جاء بالحسنة فله خير منها وهم من فزع يومئذ ءامنون",
    "ayahnumber" : "89",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3300",
    "page" : "385",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3301",
    "ayah_text" : "وَمَن جَآءَ بِٱلسَّيِّئَةِ فَكُبَّتۡ وُجُوهُهُمۡ فِي ٱلنَّارِ هَلۡ تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ومن جاء بالسيئة فكبت وجوههم في النار هل تجزون الا ما كنتم تعملون",
    "ayahnumber" : "90",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3301",
    "page" : "385",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3302",
    "ayah_text" : "إِنَّمَآ أُمِرۡتُ أَنۡ أَعۡبُدَ رَبَّ هَٰذِهِ ٱلۡبَلۡدَةِ ٱلَّذِي حَرَّمَهَا وَلَهُۥ كُلُّ شَيۡءٖۖ وَأُمِرۡتُ أَنۡ أَكُونَ مِنَ ٱلۡمُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "انما امرت ان اعبد رب هٰذه البلدة الذي حرمها وله كل شيء وامرت ان اكون من المسلمين",
    "ayahnumber" : "91",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3302",
    "page" : "385",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3303",
    "ayah_text" : "وَأَنۡ أَتۡلُوَاْ ٱلۡقُرۡءَانَۖ فَمَنِ ٱهۡتَدَىٰ فَإِنَّمَا يَهۡتَدِي لِنَفۡسِهِۦۖ وَمَن ضَلَّ فَقُلۡ إِنَّمَآ أَنَا۠ مِنَ ٱلۡمُنذِرِينَ",
    "ayah_text_no_diacratic" : "وان اتلوا القرءان فمن اهتدىٰ فانما يهتدي لنفسه ومن ضل فقل انما انا من المنذرين",
    "ayahnumber" : "92",
    "chapter" : "20",
    "hizb" : "38",
