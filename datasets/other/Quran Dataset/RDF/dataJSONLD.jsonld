    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2031",
    "ayah_text" : "إِنَّمَا سُلۡطَٰنُهُۥ عَلَى ٱلَّذِينَ يَتَوَلَّوۡنَهُۥ وَٱلَّذِينَ هُم بِهِۦ مُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "انما سلطٰنه على الذين يتولونه والذين هم به مشركون",
