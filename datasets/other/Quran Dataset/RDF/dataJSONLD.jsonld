    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3061",
    "ayah_text" : "وَٱلَّذِي هُوَ يُطۡعِمُنِي وَيَسۡقِينِ",
    "ayah_text_no_diacratic" : "والذي هو يطعمني ويسقين",
    "ayahnumber" : "79",
    "chapter" : "19",
    "hizb" : "37",
