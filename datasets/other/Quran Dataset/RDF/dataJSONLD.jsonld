  }, {
    "@id" : "quran:1274",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّخِذُوٓاْ ءَابَآءَكُمۡ وَإِخۡوَٰنَكُمۡ أَوۡلِيَآءَ إِنِ ٱسۡتَحَبُّواْ ٱلۡكُفۡرَ عَلَى ٱلۡإِيمَٰنِۚ وَمَن يَتَوَلَّهُم مِّنكُمۡ فَأُوْلَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تتخذوا ءاباءكم واخوٰنكم اولياء ان استحبوا الكفر على الايمٰن ومن يتولهم منكم فاولٰئك هم الظٰلمون",
    "ayahnumber" : "23",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1274",
    "page" : "190",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1275",
    "ayah_text" : "قُلۡ إِن كَانَ ءَابَآؤُكُمۡ وَأَبۡنَآؤُكُمۡ وَإِخۡوَٰنُكُمۡ وَأَزۡوَٰجُكُمۡ وَعَشِيرَتُكُمۡ وَأَمۡوَٰلٌ ٱقۡتَرَفۡتُمُوهَا وَتِجَٰرَةٞ تَخۡشَوۡنَ كَسَادَهَا وَمَسَٰكِنُ تَرۡضَوۡنَهَآ أَحَبَّ إِلَيۡكُم مِّنَ ٱللَّهِ وَرَسُولِهِۦ وَجِهَادٖ فِي سَبِيلِهِۦ فَتَرَبَّصُواْ حَتَّىٰ يَأۡتِيَ ٱللَّهُ بِأَمۡرِهِۦۗ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلۡفَٰسِقِينَ",
    "ayah_text_no_diacratic" : "قل ان كان ءاباؤكم وابناؤكم واخوٰنكم وازوٰجكم وعشيرتكم واموٰل اقترفتموها وتجٰرة تخشون كسادها ومسٰكن ترضونها احب اليكم من الله ورسوله وجهاد في سبيله فتربصوا حتىٰ ياتي الله بامره والله لا يهدي القوم الفٰسقين",
    "ayahnumber" : "24",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1275",
    "page" : "190",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1276",
    "ayah_text" : "لَقَدۡ نَصَرَكُمُ ٱللَّهُ فِي مَوَاطِنَ كَثِيرَةٖ وَيَوۡمَ حُنَيۡنٍ إِذۡ أَعۡجَبَتۡكُمۡ كَثۡرَتُكُمۡ فَلَمۡ تُغۡنِ عَنكُمۡ شَيۡـٔٗا وَضَاقَتۡ عَلَيۡكُمُ ٱلۡأَرۡضُ بِمَا رَحُبَتۡ ثُمَّ وَلَّيۡتُم مُّدۡبِرِينَ",
    "ayah_text_no_diacratic" : "لقد نصركم الله في مواطن كثيرة ويوم حنين اذ اعجبتكم كثرتكم فلم تغن عنكم شيا وضاقت عليكم الارض بما رحبت ثم وليتم مدبرين",
    "ayahnumber" : "25",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1276",
    "page" : "190",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1277",
    "ayah_text" : "ثُمَّ أَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلۡمُؤۡمِنِينَ وَأَنزَلَ جُنُودٗا لَّمۡ تَرَوۡهَا وَعَذَّبَ ٱلَّذِينَ كَفَرُواْۚ وَذَٰلِكَ جَزَآءُ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ثم انزل الله سكينته علىٰ رسوله وعلى المؤمنين وانزل جنودا لم تروها وعذب الذين كفروا وذٰلك جزاء الكٰفرين",
    "ayahnumber" : "26",
    "chapter" : "10",
    "hizb" : "19",
