    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5445",
    "ayah_text" : "سَلۡهُمۡ أَيُّهُم بِذَٰلِكَ زَعِيمٌ",
    "ayah_text_no_diacratic" : "سلهم ايهم بذٰلك زعيم",
