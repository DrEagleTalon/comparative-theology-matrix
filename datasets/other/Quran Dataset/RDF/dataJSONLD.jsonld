    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4728",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4728",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4729",
    "ayah_text" : "قٓۚ وَٱلۡقُرۡءَانِ ٱلۡمَجِيدِ",
    "ayah_text_no_diacratic" : "ق والقرءان المجيد",
    "ayahnumber" : "1",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4729",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:473",
    "ayah_text" : "إِنَّمَا ذَٰلِكُمُ ٱلشَّيۡطَٰنُ يُخَوِّفُ أَوۡلِيَآءَهُۥ فَلَا تَخَافُوهُمۡ وَخَافُونِ إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "انما ذٰلكم الشيطٰن يخوف اولياءه فلا تخافوهم وخافون ان كنتم مؤمنين",
    "ayahnumber" : "175",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "473",
    "page" : "73",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4730",
    "ayah_text" : "بَلۡ عَجِبُوٓاْ أَن جَآءَهُم مُّنذِرٞ مِّنۡهُمۡ فَقَالَ ٱلۡكَٰفِرُونَ هَٰذَا شَيۡءٌ عَجِيبٌ",
    "ayah_text_no_diacratic" : "بل عجبوا ان جاءهم منذر منهم فقال الكٰفرون هٰذا شيء عجيب",
    "ayahnumber" : "2",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4730",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4731",
    "ayah_text" : "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗاۖ ذَٰلِكَ رَجۡعُۢ بَعِيدٞ",
    "ayah_text_no_diacratic" : "اءذا متنا وكنا ترابا ذٰلك رجع بعيد",
    "ayahnumber" : "3",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4731",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4732",
    "ayah_text" : "قَدۡ عَلِمۡنَا مَا تَنقُصُ ٱلۡأَرۡضُ مِنۡهُمۡۖ وَعِندَنَا كِتَٰبٌ حَفِيظُۢ",
    "ayah_text_no_diacratic" : "قد علمنا ما تنقص الارض منهم وعندنا كتٰب حفيظ",
    "ayahnumber" : "4",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4732",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4733",
    "ayah_text" : "بَلۡ كَذَّبُواْ بِٱلۡحَقِّ لَمَّا جَآءَهُمۡ فَهُمۡ فِيٓ أَمۡرٖ مَّرِيجٍ",
    "ayah_text_no_diacratic" : "بل كذبوا بالحق لما جاءهم فهم في امر مريج",
    "ayahnumber" : "5",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4733",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4734",
    "ayah_text" : "أَفَلَمۡ يَنظُرُوٓاْ إِلَى ٱلسَّمَآءِ فَوۡقَهُمۡ كَيۡفَ بَنَيۡنَٰهَا وَزَيَّنَّٰهَا وَمَا لَهَا مِن فُرُوجٖ",
    "ayah_text_no_diacratic" : "افلم ينظروا الى السماء فوقهم كيف بنينٰها وزينٰها وما لها من فروج",
    "ayahnumber" : "6",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4734",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4735",
    "ayah_text" : "وَٱلۡأَرۡضَ مَدَدۡنَٰهَا وَأَلۡقَيۡنَا فِيهَا رَوَٰسِيَ وَأَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجِۭ بَهِيجٖ",
    "ayah_text_no_diacratic" : "والارض مددنٰها والقينا فيها روٰسي وانبتنا فيها من كل زوج بهيج",
    "ayahnumber" : "7",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4735",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4736",
    "ayah_text" : "تَبۡصِرَةٗ وَذِكۡرَىٰ لِكُلِّ عَبۡدٖ مُّنِيبٖ",
    "ayah_text_no_diacratic" : "تبصرة وذكرىٰ لكل عبد منيب",
    "ayahnumber" : "8",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4736",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4737",
    "ayah_text" : "وَنَزَّلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ مُّبَٰرَكٗا فَأَنۢبَتۡنَا بِهِۦ جَنَّٰتٖ وَحَبَّ ٱلۡحَصِيدِ",
    "ayah_text_no_diacratic" : "ونزلنا من السماء ماء مبٰركا فانبتنا به جنٰت وحب الحصيد",
    "ayahnumber" : "9",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4737",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4738",
    "ayah_text" : "وَٱلنَّخۡلَ بَاسِقَٰتٖ لَّهَا طَلۡعٞ نَّضِيدٞ",
    "ayah_text_no_diacratic" : "والنخل باسقٰت لها طلع نضيد",
    "ayahnumber" : "10",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4738",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4739",
    "ayah_text" : "رِّزۡقٗا لِّلۡعِبَادِۖ وَأَحۡيَيۡنَا بِهِۦ بَلۡدَةٗ مَّيۡتٗاۚ كَذَٰلِكَ ٱلۡخُرُوجُ",
    "ayah_text_no_diacratic" : "رزقا للعباد واحيينا به بلدة ميتا كذٰلك الخروج",
    "ayahnumber" : "11",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4739",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:474",
    "ayah_text" : "وَلَا يَحۡزُنكَ ٱلَّذِينَ يُسَٰرِعُونَ فِي ٱلۡكُفۡرِۚ إِنَّهُمۡ لَن يَضُرُّواْ ٱللَّهَ شَيۡـٔٗاۚ يُرِيدُ ٱللَّهُ أَلَّا يَجۡعَلَ لَهُمۡ حَظّٗا فِي ٱلۡأٓخِرَةِۖ وَلَهُمۡ عَذَابٌ عَظِيمٌ",
    "ayah_text_no_diacratic" : "ولا يحزنك الذين يسٰرعون في الكفر انهم لن يضروا الله شيا يريد الله الا يجعل لهم حظا في الاخرة ولهم عذاب عظيم",
    "ayahnumber" : "176",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "474",
    "page" : "73",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4740",
    "ayah_text" : "كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحٖ وَأَصۡحَٰبُ ٱلرَّسِّ وَثَمُودُ",
    "ayah_text_no_diacratic" : "كذبت قبلهم قوم نوح واصحٰب الرس وثمود",
    "ayahnumber" : "12",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4740",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4741",
    "ayah_text" : "وَعَادٞ وَفِرۡعَوۡنُ وَإِخۡوَٰنُ لُوطٖ",
    "ayah_text_no_diacratic" : "وعاد وفرعون واخوٰن لوط",
    "ayahnumber" : "13",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4741",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4742",
    "ayah_text" : "وَأَصۡحَٰبُ ٱلۡأَيۡكَةِ وَقَوۡمُ تُبَّعٖۚ كُلّٞ كَذَّبَ ٱلرُّسُلَ فَحَقَّ وَعِيدِ",
    "ayah_text_no_diacratic" : "واصحٰب الايكة وقوم تبع كل كذب الرسل فحق وعيد",
    "ayahnumber" : "14",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4742",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4743",
    "ayah_text" : "أَفَعَيِينَا بِٱلۡخَلۡقِ ٱلۡأَوَّلِۚ بَلۡ هُمۡ فِي لَبۡسٖ مِّنۡ خَلۡقٖ جَدِيدٖ",
    "ayah_text_no_diacratic" : "افعيينا بالخلق الاول بل هم في لبس من خلق جديد",
    "ayahnumber" : "15",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4743",
    "page" : "518",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4744",
    "ayah_text" : "وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ وَنَعۡلَمُ مَا تُوَسۡوِسُ بِهِۦ نَفۡسُهُۥۖ وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنۡ حَبۡلِ ٱلۡوَرِيدِ",
    "ayah_text_no_diacratic" : "ولقد خلقنا الانسٰن ونعلم ما توسوس به نفسه ونحن اقرب اليه من حبل الوريد",
    "ayahnumber" : "16",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4744",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4745",
    "ayah_text" : "إِذۡ يَتَلَقَّى ٱلۡمُتَلَقِّيَانِ عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ قَعِيدٞ",
    "ayah_text_no_diacratic" : "اذ يتلقى المتلقيان عن اليمين وعن الشمال قعيد",
    "ayahnumber" : "17",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4745",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4746",
    "ayah_text" : "مَّا يَلۡفِظُ مِن قَوۡلٍ إِلَّا لَدَيۡهِ رَقِيبٌ عَتِيدٞ",
    "ayah_text_no_diacratic" : "ما يلفظ من قول الا لديه رقيب عتيد",
    "ayahnumber" : "18",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4746",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4747",
    "ayah_text" : "وَجَآءَتۡ سَكۡرَةُ ٱلۡمَوۡتِ بِٱلۡحَقِّۖ ذَٰلِكَ مَا كُنتَ مِنۡهُ تَحِيدُ",
    "ayah_text_no_diacratic" : "وجاءت سكرة الموت بالحق ذٰلك ما كنت منه تحيد",
    "ayahnumber" : "19",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4747",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4748",
    "ayah_text" : "وَنُفِخَ فِي ٱلصُّورِۚ ذَٰلِكَ يَوۡمُ ٱلۡوَعِيدِ",
    "ayah_text_no_diacratic" : "ونفخ في الصور ذٰلك يوم الوعيد",
    "ayahnumber" : "20",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4748",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4749",
    "ayah_text" : "وَجَآءَتۡ كُلُّ نَفۡسٖ مَّعَهَا سَآئِقٞ وَشَهِيدٞ",
    "ayah_text_no_diacratic" : "وجاءت كل نفس معها سائق وشهيد",
    "ayahnumber" : "21",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4749",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:475",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ٱشۡتَرَوُاْ ٱلۡكُفۡرَ بِٱلۡإِيمَٰنِ لَن يَضُرُّواْ ٱللَّهَ شَيۡـٔٗاۖ وَلَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "ان الذين اشتروا الكفر بالايمٰن لن يضروا الله شيا ولهم عذاب اليم",
    "ayahnumber" : "177",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "475",
    "page" : "73",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4750",
    "ayah_text" : "لَّقَدۡ كُنتَ فِي غَفۡلَةٖ مِّنۡ هَٰذَا فَكَشَفۡنَا عَنكَ غِطَآءَكَ فَبَصَرُكَ ٱلۡيَوۡمَ حَدِيدٞ",
    "ayah_text_no_diacratic" : "لقد كنت في غفلة من هٰذا فكشفنا عنك غطاءك فبصرك اليوم حديد",
    "ayahnumber" : "22",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4750",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4751",
    "ayah_text" : "وَقَالَ قَرِينُهُۥ هَٰذَا مَا لَدَيَّ عَتِيدٌ",
    "ayah_text_no_diacratic" : "وقال قرينه هٰذا ما لدي عتيد",
    "ayahnumber" : "23",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4751",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4752",
    "ayah_text" : "أَلۡقِيَا فِي جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيدٖ",
    "ayah_text_no_diacratic" : "القيا في جهنم كل كفار عنيد",
    "ayahnumber" : "24",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4752",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4753",
    "ayah_text" : "مَّنَّاعٖ لِّلۡخَيۡرِ مُعۡتَدٖ مُّرِيبٍ",
    "ayah_text_no_diacratic" : "مناع للخير معتد مريب",
    "ayahnumber" : "25",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4753",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4754",
    "ayah_text" : "ٱلَّذِي جَعَلَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَأَلۡقِيَاهُ فِي ٱلۡعَذَابِ ٱلشَّدِيدِ",
    "ayah_text_no_diacratic" : "الذي جعل مع الله الٰها ءاخر فالقياه في العذاب الشديد",
    "ayahnumber" : "26",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4754",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4755",
    "ayah_text" : "۞قَالَ قَرِينُهُۥ رَبَّنَا مَآ أَطۡغَيۡتُهُۥ وَلَٰكِن كَانَ فِي ضَلَٰلِۭ بَعِيدٖ",
    "ayah_text_no_diacratic" : "قال قرينه ربنا ما اطغيته ولٰكن كان في ضلٰل بعيد",
    "ayahnumber" : "27",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4755",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4756",
    "ayah_text" : "قَالَ لَا تَخۡتَصِمُواْ لَدَيَّ وَقَدۡ قَدَّمۡتُ إِلَيۡكُم بِٱلۡوَعِيدِ",
    "ayah_text_no_diacratic" : "قال لا تختصموا لدي وقد قدمت اليكم بالوعيد",
    "ayahnumber" : "28",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4756",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4757",
    "ayah_text" : "مَا يُبَدَّلُ ٱلۡقَوۡلُ لَدَيَّ وَمَآ أَنَا۠ بِظَلَّٰمٖ لِّلۡعَبِيدِ",
    "ayah_text_no_diacratic" : "ما يبدل القول لدي وما انا بظلٰم للعبيد",
    "ayahnumber" : "29",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4757",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4758",
    "ayah_text" : "يَوۡمَ نَقُولُ لِجَهَنَّمَ هَلِ ٱمۡتَلَأۡتِ وَتَقُولُ هَلۡ مِن مَّزِيدٖ",
    "ayah_text_no_diacratic" : "يوم نقول لجهنم هل امتلات وتقول هل من مزيد",
    "ayahnumber" : "30",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4758",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4759",
    "ayah_text" : "وَأُزۡلِفَتِ ٱلۡجَنَّةُ لِلۡمُتَّقِينَ غَيۡرَ بَعِيدٍ",
    "ayah_text_no_diacratic" : "وازلفت الجنة للمتقين غير بعيد",
    "ayahnumber" : "31",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4759",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:476",
    "ayah_text" : "وَلَا يَحۡسَبَنَّ ٱلَّذِينَ كَفَرُوٓاْ أَنَّمَا نُمۡلِي لَهُمۡ خَيۡرٞ لِّأَنفُسِهِمۡۚ إِنَّمَا نُمۡلِي لَهُمۡ لِيَزۡدَادُوٓاْ إِثۡمٗاۖ وَلَهُمۡ عَذَابٞ مُّهِينٞ",
    "ayah_text_no_diacratic" : "ولا يحسبن الذين كفروا انما نملي لهم خير لانفسهم انما نملي لهم ليزدادوا اثما ولهم عذاب مهين",
    "ayahnumber" : "178",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "476",
    "page" : "73",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4760",
    "ayah_text" : "هَٰذَا مَا تُوعَدُونَ لِكُلِّ أَوَّابٍ حَفِيظٖ",
    "ayah_text_no_diacratic" : "هٰذا ما توعدون لكل اواب حفيظ",
    "ayahnumber" : "32",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4760",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4761",
    "ayah_text" : "مَّنۡ خَشِيَ ٱلرَّحۡمَٰنَ بِٱلۡغَيۡبِ وَجَآءَ بِقَلۡبٖ مُّنِيبٍ",
    "ayah_text_no_diacratic" : "من خشي الرحمٰن بالغيب وجاء بقلب منيب",
    "ayahnumber" : "33",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4761",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4762",
    "ayah_text" : "ٱدۡخُلُوهَا بِسَلَٰمٖۖ ذَٰلِكَ يَوۡمُ ٱلۡخُلُودِ",
    "ayah_text_no_diacratic" : "ادخلوها بسلٰم ذٰلك يوم الخلود",
    "ayahnumber" : "34",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4762",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4763",
    "ayah_text" : "لَهُم مَّا يَشَآءُونَ فِيهَا وَلَدَيۡنَا مَزِيدٞ",
    "ayah_text_no_diacratic" : "لهم ما يشاءون فيها ولدينا مزيد",
    "ayahnumber" : "35",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4763",
    "page" : "519",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4764",
    "ayah_text" : "وَكَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّن قَرۡنٍ هُمۡ أَشَدُّ مِنۡهُم بَطۡشٗا فَنَقَّبُواْ فِي ٱلۡبِلَٰدِ هَلۡ مِن مَّحِيصٍ",
    "ayah_text_no_diacratic" : "وكم اهلكنا قبلهم من قرن هم اشد منهم بطشا فنقبوا في البلٰد هل من محيص",
    "ayahnumber" : "36",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4764",
    "page" : "520",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4765",
    "ayah_text" : "إِنَّ فِي ذَٰلِكَ لَذِكۡرَىٰ لِمَن كَانَ لَهُۥ قَلۡبٌ أَوۡ أَلۡقَى ٱلسَّمۡعَ وَهُوَ شَهِيدٞ",
    "ayah_text_no_diacratic" : "ان في ذٰلك لذكرىٰ لمن كان له قلب او القى السمع وهو شهيد",
    "ayahnumber" : "37",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4765",
    "page" : "520",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4766",
    "ayah_text" : "وَلَقَدۡ خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا فِي سِتَّةِ أَيَّامٖ وَمَا مَسَّنَا مِن لُّغُوبٖ",
    "ayah_text_no_diacratic" : "ولقد خلقنا السمٰوٰت والارض وما بينهما في ستة ايام وما مسنا من لغوب",
    "ayahnumber" : "38",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4766",
    "page" : "520",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4767",
    "ayah_text" : "فَٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ قَبۡلَ طُلُوعِ ٱلشَّمۡسِ وَقَبۡلَ ٱلۡغُرُوبِ",
    "ayah_text_no_diacratic" : "فاصبر علىٰ ما يقولون وسبح بحمد ربك قبل طلوع الشمس وقبل الغروب",
    "ayahnumber" : "39",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4767",
    "page" : "520",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4768",
    "ayah_text" : "وَمِنَ ٱلَّيۡلِ فَسَبِّحۡهُ وَأَدۡبَٰرَ ٱلسُّجُودِ",
    "ayah_text_no_diacratic" : "ومن اليل فسبحه وادبٰر السجود",
    "ayahnumber" : "40",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4768",
    "page" : "520",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4769",
    "ayah_text" : "وَٱسۡتَمِعۡ يَوۡمَ يُنَادِ ٱلۡمُنَادِ مِن مَّكَانٖ قَرِيبٖ",
    "ayah_text_no_diacratic" : "واستمع يوم يناد المناد من مكان قريب",
    "ayahnumber" : "41",
    "chapter" : "26",
    "hizb" : "52",
    "index" : "4769",
    "page" : "520",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:477",
    "ayah_text" : "مَّا كَانَ ٱللَّهُ لِيَذَرَ ٱلۡمُؤۡمِنِينَ عَلَىٰ مَآ أَنتُمۡ عَلَيۡهِ حَتَّىٰ يَمِيزَ ٱلۡخَبِيثَ مِنَ ٱلطَّيِّبِۗ وَمَا كَانَ ٱللَّهُ لِيُطۡلِعَكُمۡ عَلَى ٱلۡغَيۡبِ وَلَٰكِنَّ ٱللَّهَ يَجۡتَبِي مِن رُّسُلِهِۦ مَن يَشَآءُۖ فَـَٔامِنُواْ بِٱللَّهِ وَرُسُلِهِۦۚ وَإِن تُؤۡمِنُواْ وَتَتَّقُواْ فَلَكُمۡ أَجۡرٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "ما كان الله ليذر المؤمنين علىٰ ما انتم عليه حتىٰ يميز الخبيث من الطيب وما كان الله ليطلعكم على الغيب ولٰكن الله يجتبي من رسله من يشاء فامنوا بالله ورسله وان تؤمنوا وتتقوا فلكم اجر عظيم",
    "ayahnumber" : "179",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "477",
    "page" : "73",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4770",
    "ayah_text" : "يَوۡمَ يَسۡمَعُونَ ٱلصَّيۡحَةَ بِٱلۡحَقِّۚ ذَٰلِكَ يَوۡمُ ٱلۡخُرُوجِ",
    "ayah_text_no_diacratic" : "يوم يسمعون الصيحة بالحق ذٰلك يوم الخروج",
