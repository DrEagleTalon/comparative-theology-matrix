  }, {
    "@id" : "quran:3641",
    "ayah_text" : "تَحِيَّتُهُمۡ يَوۡمَ يَلۡقَوۡنَهُۥ سَلَٰمٞۚ وَأَعَدَّ لَهُمۡ أَجۡرٗا كَرِيمٗا",
    "ayah_text_no_diacratic" : "تحيتهم يوم يلقونه سلٰم واعد لهم اجرا كريما",
