  }, {
    "@id" : "quran:1050",
    "ayah_text" : "فَأَنجَيۡنَٰهُ وَأَهۡلَهُۥٓ إِلَّا ٱمۡرَأَتَهُۥ كَانَتۡ مِنَ ٱلۡغَٰبِرِينَ",
    "ayah_text_no_diacratic" : "فانجينٰه واهله الا امراته كانت من الغٰبرين",
