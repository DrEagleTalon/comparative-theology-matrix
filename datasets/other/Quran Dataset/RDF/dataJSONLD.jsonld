    "hizb" : "37",
    "index" : "3138",
    "page" : "373",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3139",
    "ayah_text" : "فَعَقَرُوهَا فَأَصۡبَحُواْ نَٰدِمِينَ",
    "ayah_text_no_diacratic" : "فعقروها فاصبحوا نٰدمين",
    "ayahnumber" : "157",
    "chapter" : "19",
