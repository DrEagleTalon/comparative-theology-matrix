    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:714",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ لَوۡ أَنَّ لَهُم مَّا فِي ٱلۡأَرۡضِ جَمِيعٗا وَمِثۡلَهُۥ مَعَهُۥ لِيَفۡتَدُواْ بِهِۦ مِنۡ عَذَابِ يَوۡمِ ٱلۡقِيَٰمَةِ مَا تُقُبِّلَ مِنۡهُمۡۖ وَلَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "ان الذين كفروا لو ان لهم ما في الارض جميعا ومثله معه ليفتدوا به من عذاب يوم القيٰمة ما تقبل منهم ولهم عذاب اليم",
    "ayahnumber" : "36",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "714",
    "page" : "113",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:715",
    "ayah_text" : "يُرِيدُونَ أَن يَخۡرُجُواْ مِنَ ٱلنَّارِ وَمَا هُم بِخَٰرِجِينَ مِنۡهَاۖ وَلَهُمۡ عَذَابٞ مُّقِيمٞ",
    "ayah_text_no_diacratic" : "يريدون ان يخرجوا من النار وما هم بخٰرجين منها ولهم عذاب مقيم",
    "ayahnumber" : "37",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "715",
    "page" : "114",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:716",
    "ayah_text" : "وَٱلسَّارِقُ وَٱلسَّارِقَةُ فَٱقۡطَعُوٓاْ أَيۡدِيَهُمَا جَزَآءَۢ بِمَا كَسَبَا نَكَٰلٗا مِّنَ ٱللَّهِۗ وَٱللَّهُ عَزِيزٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "والسارق والسارقة فاقطعوا ايديهما جزاء بما كسبا نكٰلا من الله والله عزيز حكيم",
    "ayahnumber" : "38",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "716",
    "page" : "114",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:717",
    "ayah_text" : "فَمَن تَابَ مِنۢ بَعۡدِ ظُلۡمِهِۦ وَأَصۡلَحَ فَإِنَّ ٱللَّهَ يَتُوبُ عَلَيۡهِۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ",
    "ayah_text_no_diacratic" : "فمن تاب من بعد ظلمه واصلح فان الله يتوب عليه ان الله غفور رحيم",
    "ayahnumber" : "39",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "717",
    "page" : "114",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:718",
    "ayah_text" : "أَلَمۡ تَعۡلَمۡ أَنَّ ٱللَّهَ لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ يُعَذِّبُ مَن يَشَآءُ وَيَغۡفِرُ لِمَن يَشَآءُۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "الم تعلم ان الله له ملك السمٰوٰت والارض يعذب من يشاء ويغفر لمن يشاء والله علىٰ كل شيء قدير",
    "ayahnumber" : "40",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "718",
    "page" : "114",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:719",
    "ayah_text" : "۞يَٰٓأَيُّهَا ٱلرَّسُولُ لَا يَحۡزُنكَ ٱلَّذِينَ يُسَٰرِعُونَ فِي ٱلۡكُفۡرِ مِنَ ٱلَّذِينَ قَالُوٓاْ ءَامَنَّا بِأَفۡوَٰهِهِمۡ وَلَمۡ تُؤۡمِن قُلُوبُهُمۡۛ وَمِنَ ٱلَّذِينَ هَادُواْۛ سَمَّٰعُونَ لِلۡكَذِبِ سَمَّٰعُونَ لِقَوۡمٍ ءَاخَرِينَ لَمۡ يَأۡتُوكَۖ يُحَرِّفُونَ ٱلۡكَلِمَ مِنۢ بَعۡدِ مَوَاضِعِهِۦۖ يَقُولُونَ إِنۡ أُوتِيتُمۡ هَٰذَا فَخُذُوهُ وَإِن لَّمۡ تُؤۡتَوۡهُ فَٱحۡذَرُواْۚ وَمَن يُرِدِ ٱللَّهُ فِتۡنَتَهُۥ فَلَن تَمۡلِكَ لَهُۥ مِنَ ٱللَّهِ شَيۡـًٔاۚ أُوْلَٰٓئِكَ ٱلَّذِينَ لَمۡ يُرِدِ ٱللَّهُ أَن يُطَهِّرَ قُلُوبَهُمۡۚ لَهُمۡ فِي ٱلدُّنۡيَا خِزۡيٞۖ وَلَهُمۡ فِي ٱلۡأٓخِرَةِ عَذَابٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الرسول لا يحزنك الذين يسٰرعون في الكفر من الذين قالوا ءامنا بافوٰههم ولم تؤمن قلوبهم ومن الذين هادوا سمٰعون للكذب سمٰعون لقوم ءاخرين لم ياتوك يحرفون الكلم من بعد مواضعه يقولون ان اوتيتم هٰذا فخذوه وان لم تؤتوه فاحذروا ومن يرد الله فتنته فلن تملك له من الله شيا اولٰئك الذين لم يرد الله ان يطهر قلوبهم لهم في الدنيا خزي ولهم في الاخرة عذاب عظيم",
    "ayahnumber" : "41",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "719",
    "page" : "114",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:72",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَٱلَّذِينَ هَادُواْ وَٱلنَّصَٰرَىٰ وَٱلصَّٰبِـِٔينَ مَنۡ ءَامَنَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَعَمِلَ صَٰلِحٗا فَلَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا والذين هادوا والنصٰرىٰ والصٰبين من ءامن بالله واليوم الاخر وعمل صٰلحا فلهم اجرهم عند ربهم ولا خوف عليهم ولا هم يحزنون",
    "ayahnumber" : "62",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "72",
    "page" : "10",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:720",
    "ayah_text" : "سَمَّٰعُونَ لِلۡكَذِبِ أَكَّٰلُونَ لِلسُّحۡتِۚ فَإِن جَآءُوكَ فَٱحۡكُم بَيۡنَهُمۡ أَوۡ أَعۡرِضۡ عَنۡهُمۡۖ وَإِن تُعۡرِضۡ عَنۡهُمۡ فَلَن يَضُرُّوكَ شَيۡـٔٗاۖ وَإِنۡ حَكَمۡتَ فَٱحۡكُم بَيۡنَهُم بِٱلۡقِسۡطِۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُقۡسِطِينَ",
    "ayah_text_no_diacratic" : "سمٰعون للكذب اكٰلون للسحت فان جاءوك فاحكم بينهم او اعرض عنهم وان تعرض عنهم فلن يضروك شيا وان حكمت فاحكم بينهم بالقسط ان الله يحب المقسطين",
    "ayahnumber" : "42",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "720",
    "page" : "115",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:721",
    "ayah_text" : "وَكَيۡفَ يُحَكِّمُونَكَ وَعِندَهُمُ ٱلتَّوۡرَىٰةُ فِيهَا حُكۡمُ ٱللَّهِ ثُمَّ يَتَوَلَّوۡنَ مِنۢ بَعۡدِ ذَٰلِكَۚ وَمَآ أُوْلَٰٓئِكَ بِٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وكيف يحكمونك وعندهم التورىٰة فيها حكم الله ثم يتولون من بعد ذٰلك وما اولٰئك بالمؤمنين",
    "ayahnumber" : "43",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "721",
    "page" : "115",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:722",
    "ayah_text" : "إِنَّآ أَنزَلۡنَا ٱلتَّوۡرَىٰةَ فِيهَا هُدٗى وَنُورٞۚ يَحۡكُمُ بِهَا ٱلنَّبِيُّونَ ٱلَّذِينَ أَسۡلَمُواْ لِلَّذِينَ هَادُواْ وَٱلرَّبَّٰنِيُّونَ وَٱلۡأَحۡبَارُ بِمَا ٱسۡتُحۡفِظُواْ مِن كِتَٰبِ ٱللَّهِ وَكَانُواْ عَلَيۡهِ شُهَدَآءَۚ فَلَا تَخۡشَوُاْ ٱلنَّاسَ وَٱخۡشَوۡنِ وَلَا تَشۡتَرُواْ بِـَٔايَٰتِي ثَمَنٗا قَلِيلٗاۚ وَمَن لَّمۡ يَحۡكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُوْلَٰٓئِكَ هُمُ ٱلۡكَٰفِرُونَ",
    "ayah_text_no_diacratic" : "انا انزلنا التورىٰة فيها هدى ونور يحكم بها النبيون الذين اسلموا للذين هادوا والربٰنيون والاحبار بما استحفظوا من كتٰب الله وكانوا عليه شهداء فلا تخشوا الناس واخشون ولا تشتروا بايٰتي ثمنا قليلا ومن لم يحكم بما انزل الله فاولٰئك هم الكٰفرون",
    "ayahnumber" : "44",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "722",
    "page" : "115",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:723",
    "ayah_text" : "وَكَتَبۡنَا عَلَيۡهِمۡ فِيهَآ أَنَّ ٱلنَّفۡسَ بِٱلنَّفۡسِ وَٱلۡعَيۡنَ بِٱلۡعَيۡنِ وَٱلۡأَنفَ بِٱلۡأَنفِ وَٱلۡأُذُنَ بِٱلۡأُذُنِ وَٱلسِّنَّ بِٱلسِّنِّ وَٱلۡجُرُوحَ قِصَاصٞۚ فَمَن تَصَدَّقَ بِهِۦ فَهُوَ كَفَّارَةٞ لَّهُۥۚ وَمَن لَّمۡ يَحۡكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُوْلَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "وكتبنا عليهم فيها ان النفس بالنفس والعين بالعين والانف بالانف والاذن بالاذن والسن بالسن والجروح قصاص فمن تصدق به فهو كفارة له ومن لم يحكم بما انزل الله فاولٰئك هم الظٰلمون",
    "ayahnumber" : "45",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "723",
    "page" : "115",
