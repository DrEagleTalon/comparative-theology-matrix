    "surrahname_no_diacratic" : "سورة البينة"
  }, {
    "@id" : "quran:6323",
    "ayah_text" : "لَمۡ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأۡتِيَهُمُ ٱلۡبَيِّنَةُ",
    "ayah_text_no_diacratic" : "لم يكن الذين كفروا من اهل الكتٰب والمشركين منفكين حتىٰ تاتيهم البينة",
    "ayahnumber" : "1",
    "chapter" : "30",
