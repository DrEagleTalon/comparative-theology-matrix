  }, {
    "@id" : "quran:635",
    "ayah_text" : "۞يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُونُواْ قَوَّٰمِينَ بِٱلۡقِسۡطِ شُهَدَآءَ لِلَّهِ وَلَوۡ عَلَىٰٓ أَنفُسِكُمۡ أَوِ ٱلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَۚ إِن يَكُنۡ غَنِيًّا أَوۡ فَقِيرٗا فَٱللَّهُ أَوۡلَىٰ بِهِمَاۖ فَلَا تَتَّبِعُواْ ٱلۡهَوَىٰٓ أَن تَعۡدِلُواْۚ وَإِن تَلۡوُۥٓاْ أَوۡ تُعۡرِضُواْ فَإِنَّ ٱللَّهَ كَانَ بِمَا تَعۡمَلُونَ خَبِيرٗا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا كونوا قوٰمين بالقسط شهداء لله ولو علىٰ انفسكم او الوٰلدين والاقربين ان يكن غنيا او فقيرا فالله اولىٰ بهما فلا تتبعوا الهوىٰ ان تعدلوا وان تلوا او تعرضوا فان الله كان بما تعملون خبيرا",
    "ayahnumber" : "135",
    "chapter" : "5",
    "hizb" : "10",
    "index" : "635",
    "page" : "100",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
