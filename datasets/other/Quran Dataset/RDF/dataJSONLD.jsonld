    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3065",
    "ayah_text" : "رَبِّ هَبۡ لِي حُكۡمٗا وَأَلۡحِقۡنِي بِٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "رب هب لي حكما والحقني بالصٰلحين",
