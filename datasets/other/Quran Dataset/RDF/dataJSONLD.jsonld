    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:394",
    "ayah_text" : "إِنَّ أَوَّلَ بَيۡتٖ وُضِعَ لِلنَّاسِ لَلَّذِي بِبَكَّةَ مُبَارَكٗا وَهُدٗى لِّلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ان اول بيت وضع للناس للذي ببكة مباركا وهدى للعٰلمين",
