    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4722",
    "ayah_text" : "۞قَالَتِ ٱلۡأَعۡرَابُ ءَامَنَّاۖ قُل لَّمۡ تُؤۡمِنُواْ وَلَٰكِن قُولُوٓاْ أَسۡلَمۡنَا وَلَمَّا يَدۡخُلِ ٱلۡإِيمَٰنُ فِي قُلُوبِكُمۡۖ وَإِن تُطِيعُواْ ٱللَّهَ وَرَسُولَهُۥ لَا يَلِتۡكُم مِّنۡ أَعۡمَٰلِكُمۡ شَيۡـًٔاۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ",
    "ayah_text_no_diacratic" : "قالت الاعراب ءامنا قل لم تؤمنوا ولٰكن قولوا اسلمنا ولما يدخل الايمٰن في قلوبكم وان تطيعوا الله ورسوله لا يلتكم من اعمٰلكم شيا ان الله غفور رحيم",
    "ayahnumber" : "14",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4722",
    "page" : "517",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4723",
    "ayah_text" : "إِنَّمَا ٱلۡمُؤۡمِنُونَ ٱلَّذِينَ ءَامَنُواْ بِٱللَّهِ وَرَسُولِهِۦ ثُمَّ لَمۡ يَرۡتَابُواْ وَجَٰهَدُواْ بِأَمۡوَٰلِهِمۡ وَأَنفُسِهِمۡ فِي سَبِيلِ ٱللَّهِۚ أُوْلَٰٓئِكَ هُمُ ٱلصَّٰدِقُونَ",
    "ayah_text_no_diacratic" : "انما المؤمنون الذين ءامنوا بالله ورسوله ثم لم يرتابوا وجٰهدوا باموٰلهم وانفسهم في سبيل الله اولٰئك هم الصٰدقون",
    "ayahnumber" : "15",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4723",
    "page" : "517",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4724",
    "ayah_text" : "قُلۡ أَتُعَلِّمُونَ ٱللَّهَ بِدِينِكُمۡ وَٱللَّهُ يَعۡلَمُ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ وَٱللَّهُ بِكُلِّ شَيۡءٍ عَلِيمٞ",
    "ayah_text_no_diacratic" : "قل اتعلمون الله بدينكم والله يعلم ما في السمٰوٰت وما في الارض والله بكل شيء عليم",
    "ayahnumber" : "16",
    "chapter" : "26",
