  }, {
    "@id" : "quran:3398",
    "ayah_text" : "أَحَسِبَ ٱلنَّاسُ أَن يُتۡرَكُوٓاْ أَن يَقُولُوٓاْ ءَامَنَّا وَهُمۡ لَا يُفۡتَنُونَ",
    "ayah_text_no_diacratic" : "احسب الناس ان يتركوا ان يقولوا ءامنا وهم لا يفتنون",
