    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:737",
    "ayah_text" : "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ هَلۡ تَنقِمُونَ مِنَّآ إِلَّآ أَنۡ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ إِلَيۡنَا وَمَآ أُنزِلَ مِن قَبۡلُ وَأَنَّ أَكۡثَرَكُمۡ فَٰسِقُونَ",
    "ayah_text_no_diacratic" : "قل يٰاهل الكتٰب هل تنقمون منا الا ان ءامنا بالله وما انزل الينا وما انزل من قبل وان اكثركم فٰسقون",
    "ayahnumber" : "59",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "737",
