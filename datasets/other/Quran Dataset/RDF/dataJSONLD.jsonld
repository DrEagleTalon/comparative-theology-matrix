  }, {
    "@id" : "quran:4557",
    "ayah_text" : "فَضۡلٗا مِّن رَّبِّكَۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "فضلا من ربك ذٰلك هو الفوز العظيم",
