  }, {
    "@id" : "quran:4645",
    "ayah_text" : "وَٱلَّذِينَ كَفَرُواْ فَتَعۡسٗا لَّهُمۡ وَأَضَلَّ أَعۡمَٰلَهُمۡ",
    "ayah_text_no_diacratic" : "والذين كفروا فتعسا لهم واضل اعمٰلهم",
