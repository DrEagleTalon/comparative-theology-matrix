    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2758",
    "ayah_text" : "فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ بِٱلۡحَقِّ فَجَعَلۡنَٰهُمۡ غُثَآءٗۚ فَبُعۡدٗا لِّلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "فاخذتهم الصيحة بالحق فجعلنٰهم غثاء فبعدا للقوم الظٰلمين",
