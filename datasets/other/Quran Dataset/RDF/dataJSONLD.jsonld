    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2611",
    "ayah_text" : "فَٱسۡتَجَبۡنَا لَهُۥ وَنَجَّيۡنَٰهُ مِنَ ٱلۡغَمِّۚ وَكَذَٰلِكَ نُـۨجِي ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "فاستجبنا له ونجينٰه من الغم وكذٰلك نجي المؤمنين",
    "ayahnumber" : "88",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2611",
    "page" : "329",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2612",
    "ayah_text" : "وَزَكَرِيَّآ إِذۡ نَادَىٰ رَبَّهُۥ رَبِّ لَا تَذَرۡنِي فَرۡدٗا وَأَنتَ خَيۡرُ ٱلۡوَٰرِثِينَ",
    "ayah_text_no_diacratic" : "وزكريا اذ نادىٰ ربه رب لا تذرني فردا وانت خير الوٰرثين",
    "ayahnumber" : "89",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2612",
    "page" : "329",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2613",
    "ayah_text" : "فَٱسۡتَجَبۡنَا لَهُۥ وَوَهَبۡنَا لَهُۥ يَحۡيَىٰ وَأَصۡلَحۡنَا لَهُۥ زَوۡجَهُۥٓۚ إِنَّهُمۡ كَانُواْ يُسَٰرِعُونَ فِي ٱلۡخَيۡرَٰتِ وَيَدۡعُونَنَا رَغَبٗا وَرَهَبٗاۖ وَكَانُواْ لَنَا خَٰشِعِينَ",
    "ayah_text_no_diacratic" : "فاستجبنا له ووهبنا له يحيىٰ واصلحنا له زوجه انهم كانوا يسٰرعون في الخيرٰت ويدعوننا رغبا ورهبا وكانوا لنا خٰشعين",
    "ayahnumber" : "90",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2613",
    "page" : "329",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2614",
    "ayah_text" : "وَٱلَّتِيٓ أَحۡصَنَتۡ فَرۡجَهَا فَنَفَخۡنَا فِيهَا مِن رُّوحِنَا وَجَعَلۡنَٰهَا وَٱبۡنَهَآ ءَايَةٗ لِّلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "والتي احصنت فرجها فنفخنا فيها من روحنا وجعلنٰها وابنها ءاية للعٰلمين",
    "ayahnumber" : "91",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2614",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2615",
    "ayah_text" : "إِنَّ هَٰذِهِۦٓ أُمَّتُكُمۡ أُمَّةٗ وَٰحِدَةٗ وَأَنَا۠ رَبُّكُمۡ فَٱعۡبُدُونِ",
    "ayah_text_no_diacratic" : "ان هٰذه امتكم امة وٰحدة وانا ربكم فاعبدون",
    "ayahnumber" : "92",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2615",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2616",
    "ayah_text" : "وَتَقَطَّعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡۖ كُلٌّ إِلَيۡنَا رَٰجِعُونَ",
    "ayah_text_no_diacratic" : "وتقطعوا امرهم بينهم كل الينا رٰجعون",
    "ayahnumber" : "93",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2616",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2617",
    "ayah_text" : "فَمَن يَعۡمَلۡ مِنَ ٱلصَّٰلِحَٰتِ وَهُوَ مُؤۡمِنٞ فَلَا كُفۡرَانَ لِسَعۡيِهِۦ وَإِنَّا لَهُۥ كَٰتِبُونَ",
    "ayah_text_no_diacratic" : "فمن يعمل من الصٰلحٰت وهو مؤمن فلا كفران لسعيه وانا له كٰتبون",
    "ayahnumber" : "94",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2617",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2618",
    "ayah_text" : "وَحَرَٰمٌ عَلَىٰ قَرۡيَةٍ أَهۡلَكۡنَٰهَآ أَنَّهُمۡ لَا يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "وحرٰم علىٰ قرية اهلكنٰها انهم لا يرجعون",
    "ayahnumber" : "95",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2618",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2619",
    "ayah_text" : "حَتَّىٰٓ إِذَا فُتِحَتۡ يَأۡجُوجُ وَمَأۡجُوجُ وَهُم مِّن كُلِّ حَدَبٖ يَنسِلُونَ",
    "ayah_text_no_diacratic" : "حتىٰ اذا فتحت ياجوج وماجوج وهم من كل حدب ينسلون",
    "ayahnumber" : "96",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2619",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:262",
    "ayah_text" : "تِلۡكَ ءَايَٰتُ ٱللَّهِ نَتۡلُوهَا عَلَيۡكَ بِٱلۡحَقِّۚ وَإِنَّكَ لَمِنَ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "تلك ءايٰت الله نتلوها عليك بالحق وانك لمن المرسلين",
    "ayahnumber" : "252",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "262",
    "page" : "41",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2620",
    "ayah_text" : "وَٱقۡتَرَبَ ٱلۡوَعۡدُ ٱلۡحَقُّ فَإِذَا هِيَ شَٰخِصَةٌ أَبۡصَٰرُ ٱلَّذِينَ كَفَرُواْ يَٰوَيۡلَنَا قَدۡ كُنَّا فِي غَفۡلَةٖ مِّنۡ هَٰذَا بَلۡ كُنَّا ظَٰلِمِينَ",
    "ayah_text_no_diacratic" : "واقترب الوعد الحق فاذا هي شٰخصة ابصٰر الذين كفروا يٰويلنا قد كنا في غفلة من هٰذا بل كنا ظٰلمين",
    "ayahnumber" : "97",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2620",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2621",
    "ayah_text" : "إِنَّكُمۡ وَمَا تَعۡبُدُونَ مِن دُونِ ٱللَّهِ حَصَبُ جَهَنَّمَ أَنتُمۡ لَهَا وَٰرِدُونَ",
    "ayah_text_no_diacratic" : "انكم وما تعبدون من دون الله حصب جهنم انتم لها وٰردون",
    "ayahnumber" : "98",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2621",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2622",
    "ayah_text" : "لَوۡ كَانَ هَٰٓؤُلَآءِ ءَالِهَةٗ مَّا وَرَدُوهَاۖ وَكُلّٞ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "لو كان هٰؤلاء ءالهة ما وردوها وكل فيها خٰلدون",
    "ayahnumber" : "99",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2622",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2623",
    "ayah_text" : "لَهُمۡ فِيهَا زَفِيرٞ وَهُمۡ فِيهَا لَا يَسۡمَعُونَ",
    "ayah_text_no_diacratic" : "لهم فيها زفير وهم فيها لا يسمعون",
    "ayahnumber" : "100",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2623",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2624",
    "ayah_text" : "إِنَّ ٱلَّذِينَ سَبَقَتۡ لَهُم مِّنَّا ٱلۡحُسۡنَىٰٓ أُوْلَٰٓئِكَ عَنۡهَا مُبۡعَدُونَ",
    "ayah_text_no_diacratic" : "ان الذين سبقت لهم منا الحسنىٰ اولٰئك عنها مبعدون",
    "ayahnumber" : "101",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2624",
    "page" : "330",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2625",
    "ayah_text" : "لَا يَسۡمَعُونَ حَسِيسَهَاۖ وَهُمۡ فِي مَا ٱشۡتَهَتۡ أَنفُسُهُمۡ خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "لا يسمعون حسيسها وهم في ما اشتهت انفسهم خٰلدون",
    "ayahnumber" : "102",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2625",
    "page" : "331",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2626",
    "ayah_text" : "لَا يَحۡزُنُهُمُ ٱلۡفَزَعُ ٱلۡأَكۡبَرُ وَتَتَلَقَّىٰهُمُ ٱلۡمَلَٰٓئِكَةُ هَٰذَا يَوۡمُكُمُ ٱلَّذِي كُنتُمۡ تُوعَدُونَ",
    "ayah_text_no_diacratic" : "لا يحزنهم الفزع الاكبر وتتلقىٰهم الملٰئكة هٰذا يومكم الذي كنتم توعدون",
    "ayahnumber" : "103",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2626",
    "page" : "331",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2627",
    "ayah_text" : "يَوۡمَ نَطۡوِي ٱلسَّمَآءَ كَطَيِّ ٱلسِّجِلِّ لِلۡكُتُبِۚ كَمَا بَدَأۡنَآ أَوَّلَ خَلۡقٖ نُّعِيدُهُۥۚ وَعۡدًا عَلَيۡنَآۚ إِنَّا كُنَّا فَٰعِلِينَ",
    "ayah_text_no_diacratic" : "يوم نطوي السماء كطي السجل للكتب كما بدانا اول خلق نعيده وعدا علينا انا كنا فٰعلين",
    "ayahnumber" : "104",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2627",
    "page" : "331",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2628",
    "ayah_text" : "وَلَقَدۡ كَتَبۡنَا فِي ٱلزَّبُورِ مِنۢ بَعۡدِ ٱلذِّكۡرِ أَنَّ ٱلۡأَرۡضَ يَرِثُهَا عِبَادِيَ ٱلصَّٰلِحُونَ",
    "ayah_text_no_diacratic" : "ولقد كتبنا في الزبور من بعد الذكر ان الارض يرثها عبادي الصٰلحون",
    "ayahnumber" : "105",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2628",
    "page" : "331",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2629",
    "ayah_text" : "إِنَّ فِي هَٰذَا لَبَلَٰغٗا لِّقَوۡمٍ عَٰبِدِينَ",
    "ayah_text_no_diacratic" : "ان في هٰذا لبلٰغا لقوم عٰبدين",
    "ayahnumber" : "106",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2629",
    "page" : "331",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:263",
    "ayah_text" : "۞تِلۡكَ ٱلرُّسُلُ فَضَّلۡنَا بَعۡضَهُمۡ عَلَىٰ بَعۡضٖۘ مِّنۡهُم مَّن كَلَّمَ ٱللَّهُۖ وَرَفَعَ بَعۡضَهُمۡ دَرَجَٰتٖۚ وَءَاتَيۡنَا عِيسَى ٱبۡنَ مَرۡيَمَ ٱلۡبَيِّنَٰتِ وَأَيَّدۡنَٰهُ بِرُوحِ ٱلۡقُدُسِۗ وَلَوۡ شَآءَ ٱللَّهُ مَا ٱقۡتَتَلَ ٱلَّذِينَ مِنۢ بَعۡدِهِم مِّنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَٰتُ وَلَٰكِنِ ٱخۡتَلَفُواْ فَمِنۡهُم مَّنۡ ءَامَنَ وَمِنۡهُم مَّن كَفَرَۚ وَلَوۡ شَآءَ ٱللَّهُ مَا ٱقۡتَتَلُواْ وَلَٰكِنَّ ٱللَّهَ يَفۡعَلُ مَا يُرِيدُ",
    "ayah_text_no_diacratic" : "تلك الرسل فضلنا بعضهم علىٰ بعض منهم من كلم الله ورفع بعضهم درجٰت وءاتينا عيسى ابن مريم البينٰت وايدنٰه بروح القدس ولو شاء الله ما اقتتل الذين من بعدهم من بعد ما جاءتهم البينٰت ولٰكن اختلفوا فمنهم من ءامن ومنهم من كفر ولو شاء الله ما اقتتلوا ولٰكن الله يفعل ما يريد",
    "ayahnumber" : "253",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "263",
    "page" : "42",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2630",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَٰكَ إِلَّا رَحۡمَةٗ لِّلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "وما ارسلنٰك الا رحمة للعٰلمين",
    "ayahnumber" : "107",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2630",
    "page" : "331",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2631",
    "ayah_text" : "قُلۡ إِنَّمَا يُوحَىٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۖ فَهَلۡ أَنتُم مُّسۡلِمُونَ",
    "ayah_text_no_diacratic" : "قل انما يوحىٰ الي انما الٰهكم الٰه وٰحد فهل انتم مسلمون",
    "ayahnumber" : "108",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2631",
    "page" : "331",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2632",
    "ayah_text" : "فَإِن تَوَلَّوۡاْ فَقُلۡ ءَاذَنتُكُمۡ عَلَىٰ سَوَآءٖۖ وَإِنۡ أَدۡرِيٓ أَقَرِيبٌ أَم بَعِيدٞ مَّا تُوعَدُونَ",
    "ayah_text_no_diacratic" : "فان تولوا فقل ءاذنتكم علىٰ سواء وان ادري اقريب ام بعيد ما توعدون",
    "ayahnumber" : "109",
