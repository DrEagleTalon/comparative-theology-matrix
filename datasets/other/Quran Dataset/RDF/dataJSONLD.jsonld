  }, {
    "@id" : "quran:199",
    "ayah_text" : "۞يَسۡـَٔلُونَكَ عَنِ ٱلۡأَهِلَّةِۖ قُلۡ هِيَ مَوَٰقِيتُ لِلنَّاسِ وَٱلۡحَجِّۗ وَلَيۡسَ ٱلۡبِرُّ بِأَن تَأۡتُواْ ٱلۡبُيُوتَ مِن ظُهُورِهَا وَلَٰكِنَّ ٱلۡبِرَّ مَنِ ٱتَّقَىٰۗ وَأۡتُواْ ٱلۡبُيُوتَ مِنۡ أَبۡوَٰبِهَاۚ وَٱتَّقُواْ ٱللَّهَ لَعَلَّكُمۡ تُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "يسلونك عن الاهلة قل هي موٰقيت للناس والحج وليس البر بان تاتوا البيوت من ظهورها ولٰكن البر من اتقىٰ واتوا البيوت من ابوٰبها واتقوا الله لعلكم تفلحون",
    "ayahnumber" : "189",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "199",
    "page" : "29",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1990",
    "ayah_text" : "يَتَوَٰرَىٰ مِنَ ٱلۡقَوۡمِ مِن سُوٓءِ مَا بُشِّرَ بِهِۦٓۚ أَيُمۡسِكُهُۥ عَلَىٰ هُونٍ أَمۡ يَدُسُّهُۥ فِي ٱلتُّرَابِۗ أَلَا سَآءَ مَا يَحۡكُمُونَ",
    "ayah_text_no_diacratic" : "يتوٰرىٰ من القوم من سوء ما بشر به ايمسكه علىٰ هون ام يدسه في التراب الا ساء ما يحكمون",
    "ayahnumber" : "59",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1990",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1991",
    "ayah_text" : "لِلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ مَثَلُ ٱلسَّوۡءِۖ وَلِلَّهِ ٱلۡمَثَلُ ٱلۡأَعۡلَىٰۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "للذين لا يؤمنون بالاخرة مثل السوء ولله المثل الاعلىٰ وهو العزيز الحكيم",
    "ayahnumber" : "60",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1991",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1992",
    "ayah_text" : "وَلَوۡ يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ بِظُلۡمِهِم مَّا تَرَكَ عَلَيۡهَا مِن دَآبَّةٖ وَلَٰكِن يُؤَخِّرُهُمۡ إِلَىٰٓ أَجَلٖ مُّسَمّٗىۖ فَإِذَا جَآءَ أَجَلُهُمۡ لَا يَسۡتَـٔۡخِرُونَ سَاعَةٗ وَلَا يَسۡتَقۡدِمُونَ",
    "ayah_text_no_diacratic" : "ولو يؤاخذ الله الناس بظلمهم ما ترك عليها من دابة ولٰكن يؤخرهم الىٰ اجل مسمى فاذا جاء اجلهم لا يستخرون ساعة ولا يستقدمون",
    "ayahnumber" : "61",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1992",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1993",
    "ayah_text" : "وَيَجۡعَلُونَ لِلَّهِ مَا يَكۡرَهُونَۚ وَتَصِفُ أَلۡسِنَتُهُمُ ٱلۡكَذِبَ أَنَّ لَهُمُ ٱلۡحُسۡنَىٰۚ لَا جَرَمَ أَنَّ لَهُمُ ٱلنَّارَ وَأَنَّهُم مُّفۡرَطُونَ",
    "ayah_text_no_diacratic" : "ويجعلون لله ما يكرهون وتصف السنتهم الكذب ان لهم الحسنىٰ لا جرم ان لهم النار وانهم مفرطون",
    "ayahnumber" : "62",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1993",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1994",
    "ayah_text" : "تَٱللَّهِ لَقَدۡ أَرۡسَلۡنَآ إِلَىٰٓ أُمَمٖ مِّن قَبۡلِكَ فَزَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ أَعۡمَٰلَهُمۡ فَهُوَ وَلِيُّهُمُ ٱلۡيَوۡمَ وَلَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "تالله لقد ارسلنا الىٰ امم من قبلك فزين لهم الشيطٰن اعمٰلهم فهو وليهم اليوم ولهم عذاب اليم",
    "ayahnumber" : "63",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1994",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1995",
    "ayah_text" : "وَمَآ أَنزَلۡنَا عَلَيۡكَ ٱلۡكِتَٰبَ إِلَّا لِتُبَيِّنَ لَهُمُ ٱلَّذِي ٱخۡتَلَفُواْ فِيهِ وَهُدٗى وَرَحۡمَةٗ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "وما انزلنا عليك الكتٰب الا لتبين لهم الذي اختلفوا فيه وهدى ورحمة لقوم يؤمنون",
    "ayahnumber" : "64",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1995",
    "page" : "273",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1996",
    "ayah_text" : "وَٱللَّهُ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَحۡيَا بِهِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَآۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَسۡمَعُونَ",
    "ayah_text_no_diacratic" : "والله انزل من السماء ماء فاحيا به الارض بعد موتها ان في ذٰلك لاية لقوم يسمعون",
    "ayahnumber" : "65",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1996",
    "page" : "274",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1997",
    "ayah_text" : "وَإِنَّ لَكُمۡ فِي ٱلۡأَنۡعَٰمِ لَعِبۡرَةٗۖ نُّسۡقِيكُم مِّمَّا فِي بُطُونِهِۦ مِنۢ بَيۡنِ فَرۡثٖ وَدَمٖ لَّبَنًا خَالِصٗا سَآئِغٗا لِّلشَّٰرِبِينَ",
    "ayah_text_no_diacratic" : "وان لكم في الانعٰم لعبرة نسقيكم مما في بطونه من بين فرث ودم لبنا خالصا سائغا للشٰربين",
    "ayahnumber" : "66",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1997",
    "page" : "274",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1998",
    "ayah_text" : "وَمِن ثَمَرَٰتِ ٱلنَّخِيلِ وَٱلۡأَعۡنَٰبِ تَتَّخِذُونَ مِنۡهُ سَكَرٗا وَرِزۡقًا حَسَنًاۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ومن ثمرٰت النخيل والاعنٰب تتخذون منه سكرا ورزقا حسنا ان في ذٰلك لاية لقوم يعقلون",
    "ayahnumber" : "67",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1998",
