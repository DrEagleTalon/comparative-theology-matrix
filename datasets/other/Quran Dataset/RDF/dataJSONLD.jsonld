    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:313",
    "ayah_text" : "۞قُلۡ أَؤُنَبِّئُكُم بِخَيۡرٖ مِّن ذَٰلِكُمۡۖ لِلَّذِينَ ٱتَّقَوۡاْ عِندَ رَبِّهِمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا وَأَزۡوَٰجٞ مُّطَهَّرَةٞ وَرِضۡوَٰنٞ مِّنَ ٱللَّهِۗ وَٱللَّهُ بَصِيرُۢ بِٱلۡعِبَادِ",
    "ayah_text_no_diacratic" : "قل اؤنبئكم بخير من ذٰلكم للذين اتقوا عند ربهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها وازوٰج مطهرة ورضوٰن من الله والله بصير بالعباد",
    "ayahnumber" : "15",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "313",
    "page" : "51",
