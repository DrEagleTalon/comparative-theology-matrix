    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1321",
    "ayah_text" : "أَلَمۡ يَأۡتِهِمۡ نَبَأُ ٱلَّذِينَ مِن قَبۡلِهِمۡ قَوۡمِ نُوحٖ وَعَادٖ وَثَمُودَ وَقَوۡمِ إِبۡرَٰهِيمَ وَأَصۡحَٰبِ مَدۡيَنَ وَٱلۡمُؤۡتَفِكَٰتِۚ أَتَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِۖ فَمَا كَانَ ٱللَّهُ لِيَظۡلِمَهُمۡ وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ",
    "ayah_text_no_diacratic" : "الم ياتهم نبا الذين من قبلهم قوم نوح وعاد وثمود وقوم ابرٰهيم واصحٰب مدين والمؤتفكٰت اتتهم رسلهم بالبينٰت فما كان الله ليظلمهم ولٰكن كانوا انفسهم يظلمون",
    "ayahnumber" : "70",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1321",
    "page" : "198",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1322",
    "ayah_text" : "وَٱلۡمُؤۡمِنُونَ وَٱلۡمُؤۡمِنَٰتُ بَعۡضُهُمۡ أَوۡلِيَآءُ بَعۡضٖۚ يَأۡمُرُونَ بِٱلۡمَعۡرُوفِ وَيَنۡهَوۡنَ عَنِ ٱلۡمُنكَرِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤۡتُونَ ٱلزَّكَوٰةَ وَيُطِيعُونَ ٱللَّهَ وَرَسُولَهُۥٓۚ أُوْلَٰٓئِكَ سَيَرۡحَمُهُمُ ٱللَّهُۗ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "والمؤمنون والمؤمنٰت بعضهم اولياء بعض يامرون بالمعروف وينهون عن المنكر ويقيمون الصلوٰة ويؤتون الزكوٰة ويطيعون الله ورسوله اولٰئك سيرحمهم الله ان الله عزيز حكيم",
    "ayahnumber" : "71",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1322",
    "page" : "198",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1323",
    "ayah_text" : "وَعَدَ ٱللَّهُ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا وَمَسَٰكِنَ طَيِّبَةٗ فِي جَنَّٰتِ عَدۡنٖۚ وَرِضۡوَٰنٞ مِّنَ ٱللَّهِ أَكۡبَرُۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "وعد الله المؤمنين والمؤمنٰت جنٰت تجري من تحتها الانهٰر خٰلدين فيها ومسٰكن طيبة في جنٰت عدن ورضوٰن من الله اكبر ذٰلك هو الفوز العظيم",
    "ayahnumber" : "72",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1323",
    "page" : "198",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1324",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ جَٰهِدِ ٱلۡكُفَّارَ وَٱلۡمُنَٰفِقِينَ وَٱغۡلُظۡ عَلَيۡهِمۡۚ وَمَأۡوَىٰهُمۡ جَهَنَّمُۖ وَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "يٰايها النبي جٰهد الكفار والمنٰفقين واغلظ عليهم وماوىٰهم جهنم وبئس المصير",
    "ayahnumber" : "73",
    "chapter" : "10",
    "hizb" : "19",
