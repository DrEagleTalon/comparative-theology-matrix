    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2816",
    "ayah_text" : "حَتَّىٰٓ إِذَا جَآءَ أَحَدَهُمُ ٱلۡمَوۡتُ قَالَ رَبِّ ٱرۡجِعُونِ",
    "ayah_text_no_diacratic" : "حتىٰ اذا جاء احدهم الموت قال رب ارجعون",
    "ayahnumber" : "99",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2816",
    "page" : "348",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2817",
    "ayah_text" : "لَعَلِّيٓ أَعۡمَلُ صَٰلِحٗا فِيمَا تَرَكۡتُۚ كَلَّآۚ إِنَّهَا كَلِمَةٌ هُوَ قَآئِلُهَاۖ وَمِن وَرَآئِهِم بَرۡزَخٌ إِلَىٰ يَوۡمِ يُبۡعَثُونَ",
    "ayah_text_no_diacratic" : "لعلي اعمل صٰلحا فيما تركت كلا انها كلمة هو قائلها ومن ورائهم برزخ الىٰ يوم يبعثون",
    "ayahnumber" : "100",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2817",
    "page" : "348",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2818",
    "ayah_text" : "فَإِذَا نُفِخَ فِي ٱلصُّورِ فَلَآ أَنسَابَ بَيۡنَهُمۡ يَوۡمَئِذٖ وَلَا يَتَسَآءَلُونَ",
    "ayah_text_no_diacratic" : "فاذا نفخ في الصور فلا انساب بينهم يومئذ ولا يتساءلون",
    "ayahnumber" : "101",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2818",
    "page" : "348",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2819",
    "ayah_text" : "فَمَن ثَقُلَتۡ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "فمن ثقلت موٰزينه فاولٰئك هم المفلحون",
    "ayahnumber" : "102",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2819",
    "page" : "348",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:282",
    "ayah_text" : "۞لَّيۡسَ عَلَيۡكَ هُدَىٰهُمۡ وَلَٰكِنَّ ٱللَّهَ يَهۡدِي مَن يَشَآءُۗ وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ فَلِأَنفُسِكُمۡۚ وَمَا تُنفِقُونَ إِلَّا ٱبۡتِغَآءَ وَجۡهِ ٱللَّهِۚ وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ يُوَفَّ إِلَيۡكُمۡ وَأَنتُمۡ لَا تُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "ليس عليك هدىٰهم ولٰكن الله يهدي من يشاء وما تنفقوا من خير فلانفسكم وما تنفقون الا ابتغاء وجه الله وما تنفقوا من خير يوف اليكم وانتم لا تظلمون",
    "ayahnumber" : "272",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "282",
    "page" : "46",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2820",
    "ayah_text" : "وَمَنۡ خَفَّتۡ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ فِي جَهَنَّمَ خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "ومن خفت موٰزينه فاولٰئك الذين خسروا انفسهم في جهنم خٰلدون",
    "ayahnumber" : "103",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2820",
    "page" : "348",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2821",
    "ayah_text" : "تَلۡفَحُ وُجُوهَهُمُ ٱلنَّارُ وَهُمۡ فِيهَا كَٰلِحُونَ",
    "ayah_text_no_diacratic" : "تلفح وجوههم النار وهم فيها كٰلحون",
    "ayahnumber" : "104",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2821",
    "page" : "348",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2822",
    "ayah_text" : "أَلَمۡ تَكُنۡ ءَايَٰتِي تُتۡلَىٰ عَلَيۡكُمۡ فَكُنتُم بِهَا تُكَذِّبُونَ",
    "ayah_text_no_diacratic" : "الم تكن ءايٰتي تتلىٰ عليكم فكنتم بها تكذبون",
    "ayahnumber" : "105",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2822",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2823",
    "ayah_text" : "قَالُواْ رَبَّنَا غَلَبَتۡ عَلَيۡنَا شِقۡوَتُنَا وَكُنَّا قَوۡمٗا ضَآلِّينَ",
    "ayah_text_no_diacratic" : "قالوا ربنا غلبت علينا شقوتنا وكنا قوما ضالين",
    "ayahnumber" : "106",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2823",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2824",
    "ayah_text" : "رَبَّنَآ أَخۡرِجۡنَا مِنۡهَا فَإِنۡ عُدۡنَا فَإِنَّا ظَٰلِمُونَ",
    "ayah_text_no_diacratic" : "ربنا اخرجنا منها فان عدنا فانا ظٰلمون",
    "ayahnumber" : "107",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2824",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2825",
    "ayah_text" : "قَالَ ٱخۡسَـُٔواْ فِيهَا وَلَا تُكَلِّمُونِ",
    "ayah_text_no_diacratic" : "قال اخسوا فيها ولا تكلمون",
    "ayahnumber" : "108",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2825",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2826",
    "ayah_text" : "إِنَّهُۥ كَانَ فَرِيقٞ مِّنۡ عِبَادِي يَقُولُونَ رَبَّنَآ ءَامَنَّا فَٱغۡفِرۡ لَنَا وَٱرۡحَمۡنَا وَأَنتَ خَيۡرُ ٱلرَّٰحِمِينَ",
    "ayah_text_no_diacratic" : "انه كان فريق من عبادي يقولون ربنا ءامنا فاغفر لنا وارحمنا وانت خير الرٰحمين",
    "ayahnumber" : "109",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2826",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2827",
    "ayah_text" : "فَٱتَّخَذۡتُمُوهُمۡ سِخۡرِيًّا حَتَّىٰٓ أَنسَوۡكُمۡ ذِكۡرِي وَكُنتُم مِّنۡهُمۡ تَضۡحَكُونَ",
    "ayah_text_no_diacratic" : "فاتخذتموهم سخريا حتىٰ انسوكم ذكري وكنتم منهم تضحكون",
    "ayahnumber" : "110",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2827",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2828",
    "ayah_text" : "إِنِّي جَزَيۡتُهُمُ ٱلۡيَوۡمَ بِمَا صَبَرُوٓاْ أَنَّهُمۡ هُمُ ٱلۡفَآئِزُونَ",
    "ayah_text_no_diacratic" : "اني جزيتهم اليوم بما صبروا انهم هم الفائزون",
    "ayahnumber" : "111",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2828",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2829",
    "ayah_text" : "قَٰلَ كَمۡ لَبِثۡتُمۡ فِي ٱلۡأَرۡضِ عَدَدَ سِنِينَ",
    "ayah_text_no_diacratic" : "قٰل كم لبثتم في الارض عدد سنين",
    "ayahnumber" : "112",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2829",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:283",
    "ayah_text" : "لِلۡفُقَرَآءِ ٱلَّذِينَ أُحۡصِرُواْ فِي سَبِيلِ ٱللَّهِ لَا يَسۡتَطِيعُونَ ضَرۡبٗا فِي ٱلۡأَرۡضِ يَحۡسَبُهُمُ ٱلۡجَاهِلُ أَغۡنِيَآءَ مِنَ ٱلتَّعَفُّفِ تَعۡرِفُهُم بِسِيمَٰهُمۡ لَا يَسۡـَٔلُونَ ٱلنَّاسَ إِلۡحَافٗاۗ وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌ",
    "ayah_text_no_diacratic" : "للفقراء الذين احصروا في سبيل الله لا يستطيعون ضربا في الارض يحسبهم الجاهل اغنياء من التعفف تعرفهم بسيمٰهم لا يسلون الناس الحافا وما تنفقوا من خير فان الله به عليم",
    "ayahnumber" : "273",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "283",
    "page" : "46",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2830",
    "ayah_text" : "قَالُواْ لَبِثۡنَا يَوۡمًا أَوۡ بَعۡضَ يَوۡمٖ فَسۡـَٔلِ ٱلۡعَآدِّينَ",
    "ayah_text_no_diacratic" : "قالوا لبثنا يوما او بعض يوم فسل العادين",
    "ayahnumber" : "113",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2830",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2831",
    "ayah_text" : "قَٰلَ إِن لَّبِثۡتُمۡ إِلَّا قَلِيلٗاۖ لَّوۡ أَنَّكُمۡ كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قٰل ان لبثتم الا قليلا لو انكم كنتم تعلمون",
    "ayahnumber" : "114",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2831",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2832",
    "ayah_text" : "أَفَحَسِبۡتُمۡ أَنَّمَا خَلَقۡنَٰكُمۡ عَبَثٗا وَأَنَّكُمۡ إِلَيۡنَا لَا تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "افحسبتم انما خلقنٰكم عبثا وانكم الينا لا ترجعون",
    "ayahnumber" : "115",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2832",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2833",
    "ayah_text" : "فَتَعَٰلَى ٱللَّهُ ٱلۡمَلِكُ ٱلۡحَقُّۖ لَآ إِلَٰهَ إِلَّا هُوَ رَبُّ ٱلۡعَرۡشِ ٱلۡكَرِيمِ",
    "ayah_text_no_diacratic" : "فتعٰلى الله الملك الحق لا الٰه الا هو رب العرش الكريم",
    "ayahnumber" : "116",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2833",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2834",
    "ayah_text" : "وَمَن يَدۡعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ لَا بُرۡهَٰنَ لَهُۥ بِهِۦ فَإِنَّمَا حِسَابُهُۥ عِندَ رَبِّهِۦٓۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلۡكَٰفِرُونَ",
    "ayah_text_no_diacratic" : "ومن يدع مع الله الٰها ءاخر لا برهٰن له به فانما حسابه عند ربه انه لا يفلح الكٰفرون",
    "ayahnumber" : "117",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2834",
    "page" : "349",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2835",
    "ayah_text" : "وَقُل رَّبِّ ٱغۡفِرۡ وَٱرۡحَمۡ وَأَنتَ خَيۡرُ ٱلرَّٰحِمِينَ",
    "ayah_text_no_diacratic" : "وقل رب اغفر وارحم وانت خير الرٰحمين",
    "ayahnumber" : "118",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2835",
