    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:734",
    "ayah_text" : "وَمَن يَتَوَلَّ ٱللَّهَ وَرَسُولَهُۥ وَٱلَّذِينَ ءَامَنُواْ فَإِنَّ حِزۡبَ ٱللَّهِ هُمُ ٱلۡغَٰلِبُونَ",
    "ayah_text_no_diacratic" : "ومن يتول الله ورسوله والذين ءامنوا فان حزب الله هم الغٰلبون",
