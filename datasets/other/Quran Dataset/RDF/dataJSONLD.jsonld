    "page" : "371",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:308",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ لَن تُغۡنِيَ عَنۡهُمۡ أَمۡوَٰلُهُمۡ وَلَآ أَوۡلَٰدُهُم مِّنَ ٱللَّهِ شَيۡـٔٗاۖ وَأُوْلَٰٓئِكَ هُمۡ وَقُودُ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "ان الذين كفروا لن تغني عنهم اموٰلهم ولا اولٰدهم من الله شيا واولٰئك هم وقود النار",
    "ayahnumber" : "10",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "308",
