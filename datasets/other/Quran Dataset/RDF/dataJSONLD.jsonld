    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2397",
    "ayah_text" : "فَلَمَّآ أَتَىٰهَا نُودِيَ يَٰمُوسَىٰٓ",
    "ayah_text_no_diacratic" : "فلما اتىٰها نودي يٰموسىٰ",
