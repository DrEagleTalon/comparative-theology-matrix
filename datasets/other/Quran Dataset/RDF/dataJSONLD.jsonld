  }, {
    "@id" : "quran:12",
    "ayah_text" : "ذَٰلِكَ ٱلۡكِتَٰبُ لَا رَيۡبَۛ فِيهِۛ هُدٗى لِّلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "ذٰلك الكتٰب لا ريب فيه هدى للمتقين",
