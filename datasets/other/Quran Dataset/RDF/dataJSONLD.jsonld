    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:983",
    "ayah_text" : "قَالَ فَبِمَآ أَغۡوَيۡتَنِي لَأَقۡعُدَنَّ لَهُمۡ صِرَٰطَكَ ٱلۡمُسۡتَقِيمَ",
    "ayah_text_no_diacratic" : "قال فبما اغويتني لاقعدن لهم صرٰطك المستقيم",
    "ayahnumber" : "16",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "983",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:984",
    "ayah_text" : "ثُمَّ لَأٓتِيَنَّهُم مِّنۢ بَيۡنِ أَيۡدِيهِمۡ وَمِنۡ خَلۡفِهِمۡ وَعَنۡ أَيۡمَٰنِهِمۡ وَعَن شَمَآئِلِهِمۡۖ وَلَا تَجِدُ أَكۡثَرَهُمۡ شَٰكِرِينَ",
    "ayah_text_no_diacratic" : "ثم لاتينهم من بين ايديهم ومن خلفهم وعن ايمٰنهم وعن شمائلهم ولا تجد اكثرهم شٰكرين",
    "ayahnumber" : "17",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "984",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:985",
    "ayah_text" : "قَالَ ٱخۡرُجۡ مِنۡهَا مَذۡءُومٗا مَّدۡحُورٗاۖ لَّمَن تَبِعَكَ مِنۡهُمۡ لَأَمۡلَأَنَّ جَهَنَّمَ مِنكُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "قال اخرج منها مذءوما مدحورا لمن تبعك منهم لاملان جهنم منكم اجمعين",
    "ayahnumber" : "18",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "985",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:986",
    "ayah_text" : "وَيَٰٓـَٔادَمُ ٱسۡكُنۡ أَنتَ وَزَوۡجُكَ ٱلۡجَنَّةَ فَكُلَا مِنۡ حَيۡثُ شِئۡتُمَا وَلَا تَقۡرَبَا هَٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا مِنَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ويٰادم اسكن انت وزوجك الجنة فكلا من حيث شئتما ولا تقربا هٰذه الشجرة فتكونا من الظٰلمين",
    "ayahnumber" : "19",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "986",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:987",
    "ayah_text" : "فَوَسۡوَسَ لَهُمَا ٱلشَّيۡطَٰنُ لِيُبۡدِيَ لَهُمَا مَا وُۥرِيَ عَنۡهُمَا مِن سَوۡءَٰتِهِمَا وَقَالَ مَا نَهَىٰكُمَا رَبُّكُمَا عَنۡ هَٰذِهِ ٱلشَّجَرَةِ إِلَّآ أَن تَكُونَا مَلَكَيۡنِ أَوۡ تَكُونَا مِنَ ٱلۡخَٰلِدِينَ",
    "ayah_text_no_diacratic" : "فوسوس لهما الشيطٰن ليبدي لهما ما وري عنهما من سوءٰتهما وقال ما نهىٰكما ربكما عن هٰذه الشجرة الا ان تكونا ملكين او تكونا من الخٰلدين",
    "ayahnumber" : "20",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "987",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:988",
    "ayah_text" : "وَقَاسَمَهُمَآ إِنِّي لَكُمَا لَمِنَ ٱلنَّٰصِحِينَ",
    "ayah_text_no_diacratic" : "وقاسمهما اني لكما لمن النٰصحين",
    "ayahnumber" : "21",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "988",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:989",
    "ayah_text" : "فَدَلَّىٰهُمَا بِغُرُورٖۚ فَلَمَّا ذَاقَا ٱلشَّجَرَةَ بَدَتۡ لَهُمَا سَوۡءَٰتُهُمَا وَطَفِقَا يَخۡصِفَانِ عَلَيۡهِمَا مِن وَرَقِ ٱلۡجَنَّةِۖ وَنَادَىٰهُمَا رَبُّهُمَآ أَلَمۡ أَنۡهَكُمَا عَن تِلۡكُمَا ٱلشَّجَرَةِ وَأَقُل لَّكُمَآ إِنَّ ٱلشَّيۡطَٰنَ لَكُمَا عَدُوّٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "فدلىٰهما بغرور فلما ذاقا الشجرة بدت لهما سوءٰتهما وطفقا يخصفان عليهما من ورق الجنة ونادىٰهما ربهما الم انهكما عن تلكما الشجرة واقل لكما ان الشيطٰن لكما عدو مبين",
    "ayahnumber" : "22",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "989",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:99",
    "ayah_text" : "وَلَمَّا جَآءَهُمۡ كِتَٰبٞ مِّنۡ عِندِ ٱللَّهِ مُصَدِّقٞ لِّمَا مَعَهُمۡ وَكَانُواْ مِن قَبۡلُ يَسۡتَفۡتِحُونَ عَلَى ٱلَّذِينَ كَفَرُواْ فَلَمَّا جَآءَهُم مَّا عَرَفُواْ كَفَرُواْ بِهِۦۚ فَلَعۡنَةُ ٱللَّهِ عَلَى ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ولما جاءهم كتٰب من عند الله مصدق لما معهم وكانوا من قبل يستفتحون على الذين كفروا فلما جاءهم ما عرفوا كفروا به فلعنة الله على الكٰفرين",
    "ayahnumber" : "89",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "99",
    "page" : "14",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:990",
    "ayah_text" : "قَالَا رَبَّنَا ظَلَمۡنَآ أَنفُسَنَا وَإِن لَّمۡ تَغۡفِرۡ لَنَا وَتَرۡحَمۡنَا لَنَكُونَنَّ مِنَ ٱلۡخَٰسِرِينَ",
    "ayah_text_no_diacratic" : "قالا ربنا ظلمنا انفسنا وان لم تغفر لنا وترحمنا لنكونن من الخٰسرين",
    "ayahnumber" : "23",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "990",
    "page" : "153",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:991",
    "ayah_text" : "قَالَ ٱهۡبِطُواْ بَعۡضُكُمۡ لِبَعۡضٍ عَدُوّٞۖ وَلَكُمۡ فِي ٱلۡأَرۡضِ مُسۡتَقَرّٞ وَمَتَٰعٌ إِلَىٰ حِينٖ",
    "ayah_text_no_diacratic" : "قال اهبطوا بعضكم لبعض عدو ولكم في الارض مستقر ومتٰع الىٰ حين",
    "ayahnumber" : "24",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "991",
    "page" : "153",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:992",
    "ayah_text" : "قَالَ فِيهَا تَحۡيَوۡنَ وَفِيهَا تَمُوتُونَ وَمِنۡهَا تُخۡرَجُونَ",
    "ayah_text_no_diacratic" : "قال فيها تحيون وفيها تموتون ومنها تخرجون",
    "ayahnumber" : "25",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "992",
    "page" : "153",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:993",
    "ayah_text" : "يَٰبَنِيٓ ءَادَمَ قَدۡ أَنزَلۡنَا عَلَيۡكُمۡ لِبَاسٗا يُوَٰرِي سَوۡءَٰتِكُمۡ وَرِيشٗاۖ وَلِبَاسُ ٱلتَّقۡوَىٰ ذَٰلِكَ خَيۡرٞۚ ذَٰلِكَ مِنۡ ءَايَٰتِ ٱللَّهِ لَعَلَّهُمۡ يَذَّكَّرُونَ",
    "ayah_text_no_diacratic" : "يٰبني ءادم قد انزلنا عليكم لباسا يوٰري سوءٰتكم وريشا ولباس التقوىٰ ذٰلك خير ذٰلك من ءايٰت الله لعلهم يذكرون",
    "ayahnumber" : "26",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "993",
    "page" : "153",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:994",
    "ayah_text" : "يَٰبَنِيٓ ءَادَمَ لَا يَفۡتِنَنَّكُمُ ٱلشَّيۡطَٰنُ كَمَآ أَخۡرَجَ أَبَوَيۡكُم مِّنَ ٱلۡجَنَّةِ يَنزِعُ عَنۡهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا سَوۡءَٰتِهِمَآۚ إِنَّهُۥ يَرَىٰكُمۡ هُوَ وَقَبِيلُهُۥ مِنۡ حَيۡثُ لَا تَرَوۡنَهُمۡۗ إِنَّا جَعَلۡنَا ٱلشَّيَٰطِينَ أَوۡلِيَآءَ لِلَّذِينَ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "يٰبني ءادم لا يفتننكم الشيطٰن كما اخرج ابويكم من الجنة ينزع عنهما لباسهما ليريهما سوءٰتهما انه يرىٰكم هو وقبيله من حيث لا ترونهم انا جعلنا الشيٰطين اولياء للذين لا يؤمنون",
    "ayahnumber" : "27",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "994",
    "page" : "153",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:995",
    "ayah_text" : "وَإِذَا فَعَلُواْ فَٰحِشَةٗ قَالُواْ وَجَدۡنَا عَلَيۡهَآ ءَابَآءَنَا وَٱللَّهُ أَمَرَنَا بِهَاۗ قُلۡ إِنَّ ٱللَّهَ لَا يَأۡمُرُ بِٱلۡفَحۡشَآءِۖ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "واذا فعلوا فٰحشة قالوا وجدنا عليها ءاباءنا والله امرنا بها قل ان الله لا يامر بالفحشاء اتقولون على الله ما لا تعلمون",
    "ayahnumber" : "28",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "995",
    "page" : "153",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:996",
    "ayah_text" : "قُلۡ أَمَرَ رَبِّي بِٱلۡقِسۡطِۖ وَأَقِيمُواْ وُجُوهَكُمۡ عِندَ كُلِّ مَسۡجِدٖ وَٱدۡعُوهُ مُخۡلِصِينَ لَهُ ٱلدِّينَۚ كَمَا بَدَأَكُمۡ تَعُودُونَ",
    "ayah_text_no_diacratic" : "قل امر ربي بالقسط واقيموا وجوهكم عند كل مسجد وادعوه مخلصين له الدين كما بداكم تعودون",
    "ayahnumber" : "29",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "996",
    "page" : "153",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:997",
    "ayah_text" : "فَرِيقًا هَدَىٰ وَفَرِيقًا حَقَّ عَلَيۡهِمُ ٱلضَّلَٰلَةُۚ إِنَّهُمُ ٱتَّخَذُواْ ٱلشَّيَٰطِينَ أَوۡلِيَآءَ مِن دُونِ ٱللَّهِ وَيَحۡسَبُونَ أَنَّهُم مُّهۡتَدُونَ",
    "ayah_text_no_diacratic" : "فريقا هدىٰ وفريقا حق عليهم الضلٰلة انهم اتخذوا الشيٰطين اولياء من دون الله ويحسبون انهم مهتدون",
    "ayahnumber" : "30",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "997",
    "page" : "153",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:998",
    "ayah_text" : "۞يَٰبَنِيٓ ءَادَمَ خُذُواْ زِينَتَكُمۡ عِندَ كُلِّ مَسۡجِدٖ وَكُلُواْ وَٱشۡرَبُواْ وَلَا تُسۡرِفُوٓاْۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡمُسۡرِفِينَ",
    "ayah_text_no_diacratic" : "يٰبني ءادم خذوا زينتكم عند كل مسجد وكلوا واشربوا ولا تسرفوا انه لا يحب المسرفين",
    "ayahnumber" : "31",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "998",
    "page" : "154",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:999",
    "ayah_text" : "قُلۡ مَنۡ حَرَّمَ زِينَةَ ٱللَّهِ ٱلَّتِيٓ أَخۡرَجَ لِعِبَادِهِۦ وَٱلطَّيِّبَٰتِ مِنَ ٱلرِّزۡقِۚ قُلۡ هِيَ لِلَّذِينَ ءَامَنُواْ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا خَالِصَةٗ يَوۡمَ ٱلۡقِيَٰمَةِۗ كَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قل من حرم زينة الله التي اخرج لعباده والطيبٰت من الرزق قل هي للذين ءامنوا في الحيوٰة الدنيا خالصة يوم القيٰمة كذٰلك نفصل الايٰت لقوم يعلمون",
    "ayahnumber" : "32",
    "chapter" : "8",
    "hizb" : "15",
