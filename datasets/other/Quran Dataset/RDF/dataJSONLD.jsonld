    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2581",
    "ayah_text" : "فَجَعَلَهُمۡ جُذَٰذًا إِلَّا كَبِيرٗا لَّهُمۡ لَعَلَّهُمۡ إِلَيۡهِ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "فجعلهم جذٰذا الا كبيرا لهم لعلهم اليه يرجعون",
