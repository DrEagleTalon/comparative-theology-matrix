  }, {
    "@id" : "quran:3895",
    "ayah_text" : "إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ",
    "ayah_text_no_diacratic" : "انهم كانوا اذا قيل لهم لا الٰه الا الله يستكبرون",
