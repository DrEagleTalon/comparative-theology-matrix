    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1692",
    "ayah_text" : "قَالُواْ فَمَا جَزَٰٓؤُهُۥٓ إِن كُنتُمۡ كَٰذِبِينَ",
    "ayah_text_no_diacratic" : "قالوا فما جزٰؤه ان كنتم كٰذبين",
