    "surrahname_no_diacratic" : "سورة المطففين"
  }, {
    "@id" : "quran:6044",
    "ayah_text" : "وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ",
    "ayah_text_no_diacratic" : "واذا راوهم قالوا ان هٰؤلاء لضالون",
