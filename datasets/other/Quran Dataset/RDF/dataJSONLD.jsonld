    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2586",
    "ayah_text" : "قَالَ بَلۡ فَعَلَهُۥ كَبِيرُهُمۡ هَٰذَا فَسۡـَٔلُوهُمۡ إِن كَانُواْ يَنطِقُونَ",
    "ayah_text_no_diacratic" : "قال بل فعله كبيرهم هٰذا فسلوهم ان كانوا ينطقون",
