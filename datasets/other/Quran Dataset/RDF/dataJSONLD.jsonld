    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1152",
    "ayah_text" : "أَوَلَمۡ يَنظُرُواْ فِي مَلَكُوتِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا خَلَقَ ٱللَّهُ مِن شَيۡءٖ وَأَنۡ عَسَىٰٓ أَن يَكُونَ قَدِ ٱقۡتَرَبَ أَجَلُهُمۡۖ فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "اولم ينظروا في ملكوت السمٰوٰت والارض وما خلق الله من شيء وان عسىٰ ان يكون قد اقترب اجلهم فباي حديث بعده يؤمنون",
    "ayahnumber" : "185",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1152",
    "page" : "174",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1153",
    "ayah_text" : "مَن يُضۡلِلِ ٱللَّهُ فَلَا هَادِيَ لَهُۥۚ وَيَذَرُهُمۡ فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ",
    "ayah_text_no_diacratic" : "من يضلل الله فلا هادي له ويذرهم في طغيٰنهم يعمهون",
    "ayahnumber" : "186",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1153",
    "page" : "174",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1154",
    "ayah_text" : "يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَاۖ قُلۡ إِنَّمَا عِلۡمُهَا عِندَ رَبِّيۖ لَا يُجَلِّيهَا لِوَقۡتِهَآ إِلَّا هُوَۚ ثَقُلَتۡ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ لَا تَأۡتِيكُمۡ إِلَّا بَغۡتَةٗۗ يَسۡـَٔلُونَكَ كَأَنَّكَ حَفِيٌّ عَنۡهَاۖ قُلۡ إِنَّمَا عِلۡمُهَا عِندَ ٱللَّهِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "يسلونك عن الساعة ايان مرسىٰها قل انما علمها عند ربي لا يجليها لوقتها الا هو ثقلت في السمٰوٰت والارض لا تاتيكم الا بغتة يسلونك كانك حفي عنها قل انما علمها عند الله ولٰكن اكثر الناس لا يعلمون",
    "ayahnumber" : "187",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1154",
    "page" : "174",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1155",
    "ayah_text" : "قُل لَّآ أَمۡلِكُ لِنَفۡسِي نَفۡعٗا وَلَا ضَرًّا إِلَّا مَا شَآءَ ٱللَّهُۚ وَلَوۡ كُنتُ أَعۡلَمُ ٱلۡغَيۡبَ لَٱسۡتَكۡثَرۡتُ مِنَ ٱلۡخَيۡرِ وَمَا مَسَّنِيَ ٱلسُّوٓءُۚ إِنۡ أَنَا۠ إِلَّا نَذِيرٞ وَبَشِيرٞ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "قل لا املك لنفسي نفعا ولا ضرا الا ما شاء الله ولو كنت اعلم الغيب لاستكثرت من الخير وما مسني السوء ان انا الا نذير وبشير لقوم يؤمنون",
    "ayahnumber" : "188",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1155",
    "page" : "175",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1156",
    "ayah_text" : "۞هُوَ ٱلَّذِي خَلَقَكُم مِّن نَّفۡسٖ وَٰحِدَةٖ وَجَعَلَ مِنۡهَا زَوۡجَهَا لِيَسۡكُنَ إِلَيۡهَاۖ فَلَمَّا تَغَشَّىٰهَا حَمَلَتۡ حَمۡلًا خَفِيفٗا فَمَرَّتۡ بِهِۦۖ فَلَمَّآ أَثۡقَلَت دَّعَوَا ٱللَّهَ رَبَّهُمَا لَئِنۡ ءَاتَيۡتَنَا صَٰلِحٗا لَّنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ",
    "ayah_text_no_diacratic" : "هو الذي خلقكم من نفس وٰحدة وجعل منها زوجها ليسكن اليها فلما تغشىٰها حملت حملا خفيفا فمرت به فلما اثقلت دعوا الله ربهما لئن ءاتيتنا صٰلحا لنكونن من الشٰكرين",
    "ayahnumber" : "189",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1156",
    "page" : "175",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1157",
    "ayah_text" : "فَلَمَّآ ءَاتَىٰهُمَا صَٰلِحٗا جَعَلَا لَهُۥ شُرَكَآءَ فِيمَآ ءَاتَىٰهُمَاۚ فَتَعَٰلَى ٱللَّهُ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "فلما ءاتىٰهما صٰلحا جعلا له شركاء فيما ءاتىٰهما فتعٰلى الله عما يشركون",
    "ayahnumber" : "190",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1157",
    "page" : "175",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1158",
    "ayah_text" : "أَيُشۡرِكُونَ مَا لَا يَخۡلُقُ شَيۡـٔٗا وَهُمۡ يُخۡلَقُونَ",
    "ayah_text_no_diacratic" : "ايشركون ما لا يخلق شيا وهم يخلقون",
    "ayahnumber" : "191",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1158",
    "page" : "175",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1159",
    "ayah_text" : "وَلَا يَسۡتَطِيعُونَ لَهُمۡ نَصۡرٗا وَلَآ أَنفُسَهُمۡ يَنصُرُونَ",
    "ayah_text_no_diacratic" : "ولا يستطيعون لهم نصرا ولا انفسهم ينصرون",
