    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2062",
    "ayah_text" : "سُبۡحَٰنَ ٱلَّذِيٓ أَسۡرَىٰ بِعَبۡدِهِۦ لَيۡلٗا مِّنَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ إِلَى ٱلۡمَسۡجِدِ ٱلۡأَقۡصَا ٱلَّذِي بَٰرَكۡنَا حَوۡلَهُۥ لِنُرِيَهُۥ مِنۡ ءَايَٰتِنَآۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ",
    "ayah_text_no_diacratic" : "سبحٰن الذي اسرىٰ بعبده ليلا من المسجد الحرام الى المسجد الاقصا الذي بٰركنا حوله لنريه من ءايٰتنا انه هو السميع البصير",
    "ayahnumber" : "1",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2062",
    "page" : "282",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2063",
    "ayah_text" : "وَءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ وَجَعَلۡنَٰهُ هُدٗى لِّبَنِيٓ إِسۡرَٰٓءِيلَ أَلَّا تَتَّخِذُواْ مِن دُونِي وَكِيلٗا",
    "ayah_text_no_diacratic" : "وءاتينا موسى الكتٰب وجعلنٰه هدى لبني اسرٰءيل الا تتخذوا من دوني وكيلا",
    "ayahnumber" : "2",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2063",
    "page" : "282",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2064",
    "ayah_text" : "ذُرِّيَّةَ مَنۡ حَمَلۡنَا مَعَ نُوحٍۚ إِنَّهُۥ كَانَ عَبۡدٗا شَكُورٗا",
    "ayah_text_no_diacratic" : "ذرية من حملنا مع نوح انه كان عبدا شكورا",
    "ayahnumber" : "3",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2064",
    "page" : "282",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2065",
    "ayah_text" : "وَقَضَيۡنَآ إِلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ فِي ٱلۡكِتَٰبِ لَتُفۡسِدُنَّ فِي ٱلۡأَرۡضِ مَرَّتَيۡنِ وَلَتَعۡلُنَّ عُلُوّٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "وقضينا الىٰ بني اسرٰءيل في الكتٰب لتفسدن في الارض مرتين ولتعلن علوا كبيرا",
    "ayahnumber" : "4",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2065",
    "page" : "282",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2066",
    "ayah_text" : "فَإِذَا جَآءَ وَعۡدُ أُولَىٰهُمَا بَعَثۡنَا عَلَيۡكُمۡ عِبَادٗا لَّنَآ أُوْلِي بَأۡسٖ شَدِيدٖ فَجَاسُواْ خِلَٰلَ ٱلدِّيَارِۚ وَكَانَ وَعۡدٗا مَّفۡعُولٗا",
    "ayah_text_no_diacratic" : "فاذا جاء وعد اولىٰهما بعثنا عليكم عبادا لنا اولي باس شديد فجاسوا خلٰل الديار وكان وعدا مفعولا",
    "ayahnumber" : "5",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2066",
    "page" : "282",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2067",
    "ayah_text" : "ثُمَّ رَدَدۡنَا لَكُمُ ٱلۡكَرَّةَ عَلَيۡهِمۡ وَأَمۡدَدۡنَٰكُم بِأَمۡوَٰلٖ وَبَنِينَ وَجَعَلۡنَٰكُمۡ أَكۡثَرَ نَفِيرًا",
    "ayah_text_no_diacratic" : "ثم رددنا لكم الكرة عليهم وامددنٰكم باموٰل وبنين وجعلنٰكم اكثر نفيرا",
    "ayahnumber" : "6",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2067",
    "page" : "282",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2068",
    "ayah_text" : "إِنۡ أَحۡسَنتُمۡ أَحۡسَنتُمۡ لِأَنفُسِكُمۡۖ وَإِنۡ أَسَأۡتُمۡ فَلَهَاۚ فَإِذَا جَآءَ وَعۡدُ ٱلۡأٓخِرَةِ لِيَسُـُٔواْ وُجُوهَكُمۡ وَلِيَدۡخُلُواْ ٱلۡمَسۡجِدَ كَمَا دَخَلُوهُ أَوَّلَ مَرَّةٖ وَلِيُتَبِّرُواْ مَا عَلَوۡاْ تَتۡبِيرًا",
    "ayah_text_no_diacratic" : "ان احسنتم احسنتم لانفسكم وان اساتم فلها فاذا جاء وعد الاخرة ليسوا وجوهكم وليدخلوا المسجد كما دخلوه اول مرة وليتبروا ما علوا تتبيرا",
    "ayahnumber" : "7",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2068",
    "page" : "282",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2069",
    "ayah_text" : "عَسَىٰ رَبُّكُمۡ أَن يَرۡحَمَكُمۡۚ وَإِنۡ عُدتُّمۡ عُدۡنَاۚ وَجَعَلۡنَا جَهَنَّمَ لِلۡكَٰفِرِينَ حَصِيرًا",
    "ayah_text_no_diacratic" : "عسىٰ ربكم ان يرحمكم وان عدتم عدنا وجعلنا جهنم للكٰفرين حصيرا",
    "ayahnumber" : "8",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2069",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:207",
    "ayah_text" : "ٱلۡحَجُّ أَشۡهُرٞ مَّعۡلُومَٰتٞۚ فَمَن فَرَضَ فِيهِنَّ ٱلۡحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِي ٱلۡحَجِّۗ وَمَا تَفۡعَلُواْ مِنۡ خَيۡرٖ يَعۡلَمۡهُ ٱللَّهُۗ وَتَزَوَّدُواْ فَإِنَّ خَيۡرَ ٱلزَّادِ ٱلتَّقۡوَىٰۖ وَٱتَّقُونِ يَٰٓأُوْلِي ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "الحج اشهر معلومٰت فمن فرض فيهن الحج فلا رفث ولا فسوق ولا جدال في الحج وما تفعلوا من خير يعلمه الله وتزودوا فان خير الزاد التقوىٰ واتقون يٰاولي الالبٰب",
    "ayahnumber" : "197",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "207",
    "page" : "31",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2070",
    "ayah_text" : "إِنَّ هَٰذَا ٱلۡقُرۡءَانَ يَهۡدِي لِلَّتِي هِيَ أَقۡوَمُ وَيُبَشِّرُ ٱلۡمُؤۡمِنِينَ ٱلَّذِينَ يَعۡمَلُونَ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمۡ أَجۡرٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "ان هٰذا القرءان يهدي للتي هي اقوم ويبشر المؤمنين الذين يعملون الصٰلحٰت ان لهم اجرا كبيرا",
    "ayahnumber" : "9",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2070",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2071",
    "ayah_text" : "وَأَنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ أَعۡتَدۡنَا لَهُمۡ عَذَابًا أَلِيمٗا",
    "ayah_text_no_diacratic" : "وان الذين لا يؤمنون بالاخرة اعتدنا لهم عذابا اليما",
    "ayahnumber" : "10",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2071",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2072",
    "ayah_text" : "وَيَدۡعُ ٱلۡإِنسَٰنُ بِٱلشَّرِّ دُعَآءَهُۥ بِٱلۡخَيۡرِۖ وَكَانَ ٱلۡإِنسَٰنُ عَجُولٗا",
    "ayah_text_no_diacratic" : "ويدع الانسٰن بالشر دعاءه بالخير وكان الانسٰن عجولا",
    "ayahnumber" : "11",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2072",
