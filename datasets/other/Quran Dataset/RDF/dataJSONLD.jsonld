    "page" : "356",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2886",
    "ayah_text" : "وَإِن يَكُن لَّهُمُ ٱلۡحَقُّ يَأۡتُوٓاْ إِلَيۡهِ مُذۡعِنِينَ",
    "ayah_text_no_diacratic" : "وان يكن لهم الحق ياتوا اليه مذعنين",
    "ayahnumber" : "49",
    "chapter" : "18",
