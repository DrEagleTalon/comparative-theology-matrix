    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3473",
    "ayah_text" : "وَعۡدَ ٱللَّهِۖ لَا يُخۡلِفُ ٱللَّهُ وَعۡدَهُۥ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وعد الله لا يخلف الله وعده ولٰكن اكثر الناس لا يعلمون",
