  }, {
    "@id" : "quran:3074",
    "ayah_text" : "وَقِيلَ لَهُمۡ أَيۡنَ مَا كُنتُمۡ تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "وقيل لهم اين ما كنتم تعبدون",
