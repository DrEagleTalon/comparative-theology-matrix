    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2878",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱللَّهَ يُسَبِّحُ لَهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَٱلطَّيۡرُ صَٰٓفَّٰتٖۖ كُلّٞ قَدۡ عَلِمَ صَلَاتَهُۥ وَتَسۡبِيحَهُۥۗ وَٱللَّهُ عَلِيمُۢ بِمَا يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "الم تر ان الله يسبح له من في السمٰوٰت والارض والطير صٰفٰت كل قد علم صلاته وتسبيحه والله عليم بما يفعلون",
    "ayahnumber" : "41",
