    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5577",
    "ayah_text" : "ثُمَّ يُعِيدُكُمۡ فِيهَا وَيُخۡرِجُكُمۡ إِخۡرَاجٗا",
    "ayah_text_no_diacratic" : "ثم يعيدكم فيها ويخرجكم اخراجا",
    "ayahnumber" : "18",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5577",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5578",
    "ayah_text" : "وَٱللَّهُ جَعَلَ لَكُمُ ٱلۡأَرۡضَ بِسَاطٗا",
    "ayah_text_no_diacratic" : "والله جعل لكم الارض بساطا",
    "ayahnumber" : "19",
    "chapter" : "29",
    "hizb" : "57",
