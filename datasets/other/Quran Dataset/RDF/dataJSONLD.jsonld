    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3206",
    "ayah_text" : "وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلۡغَاوُۥنَ",
