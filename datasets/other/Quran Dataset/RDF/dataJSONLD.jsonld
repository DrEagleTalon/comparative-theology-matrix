    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2814",
    "ayah_text" : "وَقُل رَّبِّ أَعُوذُ بِكَ مِنۡ هَمَزَٰتِ ٱلشَّيَٰطِينِ",
    "ayah_text_no_diacratic" : "وقل رب اعوذ بك من همزٰت الشيٰطين",
    "ayahnumber" : "97",
