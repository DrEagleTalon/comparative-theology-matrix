  }, {
    "@id" : "quran:1051",
    "ayah_text" : "وَأَمۡطَرۡنَا عَلَيۡهِم مَّطَرٗاۖ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "وامطرنا عليهم مطرا فانظر كيف كان عٰقبة المجرمين",
    "ayahnumber" : "84",
