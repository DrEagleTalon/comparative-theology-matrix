    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4819",
    "ayah_text" : "فَعَتَوۡاْ عَنۡ أَمۡرِ رَبِّهِمۡ فَأَخَذَتۡهُمُ ٱلصَّٰعِقَةُ وَهُمۡ يَنظُرُونَ",
    "ayah_text_no_diacratic" : "فعتوا عن امر ربهم فاخذتهم الصٰعقة وهم ينظرون",
