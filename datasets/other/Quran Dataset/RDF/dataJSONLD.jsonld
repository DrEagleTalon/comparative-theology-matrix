    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4114",
    "ayah_text" : "إِن يُوحَىٰٓ إِلَيَّ إِلَّآ أَنَّمَآ أَنَا۠ نَذِيرٞ مُّبِينٌ",
    "ayah_text_no_diacratic" : "ان يوحىٰ الي الا انما انا نذير مبين",
    "ayahnumber" : "70",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4114",
