    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3185",
    "ayah_text" : "فَيَقُولُواْ هَلۡ نَحۡنُ مُنظَرُونَ",
