  }, {
    "@id" : "quran:504",
    "ayah_text" : "وَءَاتُواْ ٱلنِّسَآءَ صَدُقَٰتِهِنَّ نِحۡلَةٗۚ فَإِن طِبۡنَ لَكُمۡ عَن شَيۡءٖ مِّنۡهُ نَفۡسٗا فَكُلُوهُ هَنِيٓـٔٗا مَّرِيٓـٔٗا",
    "ayah_text_no_diacratic" : "وءاتوا النساء صدقٰتهن نحلة فان طبن لكم عن شيء منه نفسا فكلوه هنيا مريا",
