    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3942",
    "ayah_text" : "ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ",
    "ayah_text_no_diacratic" : "ثم اغرقنا الاخرين",
