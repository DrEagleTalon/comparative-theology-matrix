    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2241",
    "ayah_text" : "قَالَ إِنَّكَ لَن تَسۡتَطِيعَ مَعِيَ صَبۡرٗا",
    "ayah_text_no_diacratic" : "قال انك لن تستطيع معي صبرا",
    "ayahnumber" : "67",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2241",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2242",
    "ayah_text" : "وَكَيۡفَ تَصۡبِرُ عَلَىٰ مَا لَمۡ تُحِطۡ بِهِۦ خُبۡرٗا",
    "ayah_text_no_diacratic" : "وكيف تصبر علىٰ ما لم تحط به خبرا",
    "ayahnumber" : "68",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2242",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2243",
    "ayah_text" : "قَالَ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ صَابِرٗا وَلَآ أَعۡصِي لَكَ أَمۡرٗا",
    "ayah_text_no_diacratic" : "قال ستجدني ان شاء الله صابرا ولا اعصي لك امرا",
    "ayahnumber" : "69",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2243",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2244",
    "ayah_text" : "قَالَ فَإِنِ ٱتَّبَعۡتَنِي فَلَا تَسۡـَٔلۡنِي عَن شَيۡءٍ حَتَّىٰٓ أُحۡدِثَ لَكَ مِنۡهُ ذِكۡرٗا",
    "ayah_text_no_diacratic" : "قال فان اتبعتني فلا تسلني عن شيء حتىٰ احدث لك منه ذكرا",
    "ayahnumber" : "70",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2244",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2245",
    "ayah_text" : "فَٱنطَلَقَا حَتَّىٰٓ إِذَا رَكِبَا فِي ٱلسَّفِينَةِ خَرَقَهَاۖ قَالَ أَخَرَقۡتَهَا لِتُغۡرِقَ أَهۡلَهَا لَقَدۡ جِئۡتَ شَيۡـًٔا إِمۡرٗا",
    "ayah_text_no_diacratic" : "فانطلقا حتىٰ اذا ركبا في السفينة خرقها قال اخرقتها لتغرق اهلها لقد جئت شيا امرا",
    "ayahnumber" : "71",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2245",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2246",
    "ayah_text" : "قَالَ أَلَمۡ أَقُلۡ إِنَّكَ لَن تَسۡتَطِيعَ مَعِيَ صَبۡرٗا",
    "ayah_text_no_diacratic" : "قال الم اقل انك لن تستطيع معي صبرا",
    "ayahnumber" : "72",
