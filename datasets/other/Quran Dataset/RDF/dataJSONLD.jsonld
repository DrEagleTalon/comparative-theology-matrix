    "page" : "81",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5200",
    "ayah_text" : "يَوۡمَ يَقُولُ ٱلۡمُنَٰفِقُونَ وَٱلۡمُنَٰفِقَٰتُ لِلَّذِينَ ءَامَنُواْ ٱنظُرُونَا نَقۡتَبِسۡ مِن نُّورِكُمۡ قِيلَ ٱرۡجِعُواْ وَرَآءَكُمۡ فَٱلۡتَمِسُواْ نُورٗاۖ فَضُرِبَ بَيۡنَهُم بِسُورٖ لَّهُۥ بَابُۢ بَاطِنُهُۥ فِيهِ ٱلرَّحۡمَةُ وَظَٰهِرُهُۥ مِن قِبَلِهِ ٱلۡعَذَابُ",
    "ayah_text_no_diacratic" : "يوم يقول المنٰفقون والمنٰفقٰت للذين ءامنوا انظرونا نقتبس من نوركم قيل ارجعوا وراءكم فالتمسوا نورا فضرب بينهم بسور له باب باطنه فيه الرحمة وظٰهره من قبله العذاب",
    "ayahnumber" : "13",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5200",
    "page" : "539",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5201",
    "ayah_text" : "يُنَادُونَهُمۡ أَلَمۡ نَكُن مَّعَكُمۡۖ قَالُواْ بَلَىٰ وَلَٰكِنَّكُمۡ فَتَنتُمۡ أَنفُسَكُمۡ وَتَرَبَّصۡتُمۡ وَٱرۡتَبۡتُمۡ وَغَرَّتۡكُمُ ٱلۡأَمَانِيُّ حَتَّىٰ جَآءَ أَمۡرُ ٱللَّهِ وَغَرَّكُم بِٱللَّهِ ٱلۡغَرُورُ",
    "ayah_text_no_diacratic" : "ينادونهم الم نكن معكم قالوا بلىٰ ولٰكنكم فتنتم انفسكم وتربصتم وارتبتم وغرتكم الاماني حتىٰ جاء امر الله وغركم بالله الغرور",
    "ayahnumber" : "14",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5201",
    "page" : "539",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5202",
    "ayah_text" : "فَٱلۡيَوۡمَ لَا يُؤۡخَذُ مِنكُمۡ فِدۡيَةٞ وَلَا مِنَ ٱلَّذِينَ كَفَرُواْۚ مَأۡوَىٰكُمُ ٱلنَّارُۖ هِيَ مَوۡلَىٰكُمۡۖ وَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "فاليوم لا يؤخذ منكم فدية ولا من الذين كفروا ماوىٰكم النار هي مولىٰكم وبئس المصير",
    "ayahnumber" : "15",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5202",
    "page" : "539",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5203",
    "ayah_text" : "۞أَلَمۡ يَأۡنِ لِلَّذِينَ ءَامَنُوٓاْ أَن تَخۡشَعَ قُلُوبُهُمۡ لِذِكۡرِ ٱللَّهِ وَمَا نَزَلَ مِنَ ٱلۡحَقِّ وَلَا يَكُونُواْ كَٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ مِن قَبۡلُ فَطَالَ عَلَيۡهِمُ ٱلۡأَمَدُ فَقَسَتۡ قُلُوبُهُمۡۖ وَكَثِيرٞ مِّنۡهُمۡ فَٰسِقُونَ",
    "ayah_text_no_diacratic" : "الم يان للذين ءامنوا ان تخشع قلوبهم لذكر الله وما نزل من الحق ولا يكونوا كالذين اوتوا الكتٰب من قبل فطال عليهم الامد فقست قلوبهم وكثير منهم فٰسقون",
    "ayahnumber" : "16",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5203",
    "page" : "539",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5204",
    "ayah_text" : "ٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ يُحۡيِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَاۚ قَدۡ بَيَّنَّا لَكُمُ ٱلۡأٓيَٰتِ لَعَلَّكُمۡ تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "اعلموا ان الله يحي الارض بعد موتها قد بينا لكم الايٰت لعلكم تعقلون",
    "ayahnumber" : "17",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5204",
    "page" : "539",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5205",
    "ayah_text" : "إِنَّ ٱلۡمُصَّدِّقِينَ وَٱلۡمُصَّدِّقَٰتِ وَأَقۡرَضُواْ ٱللَّهَ قَرۡضًا حَسَنٗا يُضَٰعَفُ لَهُمۡ وَلَهُمۡ أَجۡرٞ كَرِيمٞ",
    "ayah_text_no_diacratic" : "ان المصدقين والمصدقٰت واقرضوا الله قرضا حسنا يضٰعف لهم ولهم اجر كريم",
    "ayahnumber" : "18",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5205",
    "page" : "539",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5206",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ بِٱللَّهِ وَرُسُلِهِۦٓ أُوْلَٰٓئِكَ هُمُ ٱلصِّدِّيقُونَۖ وَٱلشُّهَدَآءُ عِندَ رَبِّهِمۡ لَهُمۡ أَجۡرُهُمۡ وَنُورُهُمۡۖ وَٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِـَٔايَٰتِنَآ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "والذين ءامنوا بالله ورسله اولٰئك هم الصديقون والشهداء عند ربهم لهم اجرهم ونورهم والذين كفروا وكذبوا بايٰتنا اولٰئك اصحٰب الجحيم",
    "ayahnumber" : "19",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5206",
    "page" : "540",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5207",
    "ayah_text" : "ٱعۡلَمُوٓاْ أَنَّمَا ٱلۡحَيَوٰةُ ٱلدُّنۡيَا لَعِبٞ وَلَهۡوٞ وَزِينَةٞ وَتَفَاخُرُۢ بَيۡنَكُمۡ وَتَكَاثُرٞ فِي ٱلۡأَمۡوَٰلِ وَٱلۡأَوۡلَٰدِۖ كَمَثَلِ غَيۡثٍ أَعۡجَبَ ٱلۡكُفَّارَ نَبَاتُهُۥ ثُمَّ يَهِيجُ فَتَرَىٰهُ مُصۡفَرّٗا ثُمَّ يَكُونُ حُطَٰمٗاۖ وَفِي ٱلۡأٓخِرَةِ عَذَابٞ شَدِيدٞ وَمَغۡفِرَةٞ مِّنَ ٱللَّهِ وَرِضۡوَٰنٞۚ وَمَا ٱلۡحَيَوٰةُ ٱلدُّنۡيَآ إِلَّا مَتَٰعُ ٱلۡغُرُورِ",
    "ayah_text_no_diacratic" : "اعلموا انما الحيوٰة الدنيا لعب ولهو وزينة وتفاخر بينكم وتكاثر في الاموٰل والاولٰد كمثل غيث اعجب الكفار نباته ثم يهيج فترىٰه مصفرا ثم يكون حطٰما وفي الاخرة عذاب شديد ومغفرة من الله ورضوٰن وما الحيوٰة الدنيا الا متٰع الغرور",
    "ayahnumber" : "20",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5207",
    "page" : "540",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5208",
    "ayah_text" : "سَابِقُوٓاْ إِلَىٰ مَغۡفِرَةٖ مِّن رَّبِّكُمۡ وَجَنَّةٍ عَرۡضُهَا كَعَرۡضِ ٱلسَّمَآءِ وَٱلۡأَرۡضِ أُعِدَّتۡ لِلَّذِينَ ءَامَنُواْ بِٱللَّهِ وَرُسُلِهِۦۚ ذَٰلِكَ فَضۡلُ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۚ وَٱللَّهُ ذُو ٱلۡفَضۡلِ ٱلۡعَظِيمِ",
    "ayah_text_no_diacratic" : "سابقوا الىٰ مغفرة من ربكم وجنة عرضها كعرض السماء والارض اعدت للذين ءامنوا بالله ورسله ذٰلك فضل الله يؤتيه من يشاء والله ذو الفضل العظيم",
    "ayahnumber" : "21",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5208",
    "page" : "540",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5209",
    "ayah_text" : "مَآ أَصَابَ مِن مُّصِيبَةٖ فِي ٱلۡأَرۡضِ وَلَا فِيٓ أَنفُسِكُمۡ إِلَّا فِي كِتَٰبٖ مِّن قَبۡلِ أَن نَّبۡرَأَهَآۚ إِنَّ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٞ",
    "ayah_text_no_diacratic" : "ما اصاب من مصيبة في الارض ولا في انفسكم الا في كتٰب من قبل ان نبراها ان ذٰلك على الله يسير",
    "ayahnumber" : "22",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5209",
    "page" : "540",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:521",
    "ayah_text" : "وَكَيۡفَ تَأۡخُذُونَهُۥ وَقَدۡ أَفۡضَىٰ بَعۡضُكُمۡ إِلَىٰ بَعۡضٖ وَأَخَذۡنَ مِنكُم مِّيثَٰقًا غَلِيظٗا",
    "ayah_text_no_diacratic" : "وكيف تاخذونه وقد افضىٰ بعضكم الىٰ بعض واخذن منكم ميثٰقا غليظا",
    "ayahnumber" : "21",
    "chapter" : "4",
    "hizb" : "8",
    "index" : "521",
    "page" : "81",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5210",
    "ayah_text" : "لِّكَيۡلَا تَأۡسَوۡاْ عَلَىٰ مَا فَاتَكُمۡ وَلَا تَفۡرَحُواْ بِمَآ ءَاتَىٰكُمۡۗ وَٱللَّهُ لَا يُحِبُّ كُلَّ مُخۡتَالٖ فَخُورٍ",
    "ayah_text_no_diacratic" : "لكيلا تاسوا علىٰ ما فاتكم ولا تفرحوا بما ءاتىٰكم والله لا يحب كل مختال فخور",
    "ayahnumber" : "23",
    "chapter" : "27",
    "hizb" : "54",
