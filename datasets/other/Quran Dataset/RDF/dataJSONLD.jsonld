    "page" : "20",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1390",
    "ayah_text" : "أُوْلَٰٓئِكَ مَأۡوَىٰهُمُ ٱلنَّارُ بِمَا كَانُواْ يَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "اولٰئك ماوىٰهم النار بما كانوا يكسبون",
