    "surrahname_no_diacratic" : "سورة الانشقاق"
  }, {
    "@id" : "quran:6052",
    "ayah_text" : "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",
    "ayah_text_no_diacratic" : "واذنت لربها وحقت",
