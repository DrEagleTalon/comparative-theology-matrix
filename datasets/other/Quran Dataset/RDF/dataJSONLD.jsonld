    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4864",
    "ayah_text" : "فَمَنَّ ٱللَّهُ عَلَيۡنَا وَوَقَىٰنَا عَذَابَ ٱلسَّمُومِ",
    "ayah_text_no_diacratic" : "فمن الله علينا ووقىٰنا عذاب السموم",
    "ayahnumber" : "27",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4864",
    "page" : "524",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4865",
    "ayah_text" : "إِنَّا كُنَّا مِن قَبۡلُ نَدۡعُوهُۖ إِنَّهُۥ هُوَ ٱلۡبَرُّ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "انا كنا من قبل ندعوه انه هو البر الرحيم",
    "ayahnumber" : "28",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4865",
    "page" : "524",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4866",
    "ayah_text" : "فَذَكِّرۡ فَمَآ أَنتَ بِنِعۡمَتِ رَبِّكَ بِكَاهِنٖ وَلَا مَجۡنُونٍ",
    "ayah_text_no_diacratic" : "فذكر فما انت بنعمت ربك بكاهن ولا مجنون",
    "ayahnumber" : "29",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4866",
    "page" : "524",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4867",
    "ayah_text" : "أَمۡ يَقُولُونَ شَاعِرٞ نَّتَرَبَّصُ بِهِۦ رَيۡبَ ٱلۡمَنُونِ",
    "ayah_text_no_diacratic" : "ام يقولون شاعر نتربص به ريب المنون",
    "ayahnumber" : "30",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4867",
