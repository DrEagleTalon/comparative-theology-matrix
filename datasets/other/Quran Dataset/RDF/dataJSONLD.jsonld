    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5771",
    "ayah_text" : "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا",
    "ayah_text_no_diacratic" : "وما تشاءون الا ان يشاء الله ان الله كان عليما حكيما",
    "ayahnumber" : "30",
    "chapter" : "29",
    "hizb" : "58",
