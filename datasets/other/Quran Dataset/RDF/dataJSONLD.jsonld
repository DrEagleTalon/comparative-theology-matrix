    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:494",
    "ayah_text" : "لَا يَغُرَّنَّكَ تَقَلُّبُ ٱلَّذِينَ كَفَرُواْ فِي ٱلۡبِلَٰدِ",
    "ayah_text_no_diacratic" : "لا يغرنك تقلب الذين كفروا في البلٰد",
