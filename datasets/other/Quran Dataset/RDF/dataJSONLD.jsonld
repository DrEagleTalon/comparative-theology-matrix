    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:280",
    "ayah_text" : "وَمَآ أَنفَقۡتُم مِّن نَّفَقَةٍ أَوۡ نَذَرۡتُم مِّن نَّذۡرٖ فَإِنَّ ٱللَّهَ يَعۡلَمُهُۥۗ وَمَا لِلظَّٰلِمِينَ مِنۡ أَنصَارٍ",
    "ayah_text_no_diacratic" : "وما انفقتم من نفقة او نذرتم من نذر فان الله يعلمه وما للظٰلمين من انصار",
    "ayahnumber" : "270",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "280",
    "page" : "46",
    "surahname" : "سُورَةُ البَقَرَةِ",
