    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1768",
    "ayah_text" : "وَكَذَٰلِكَ أَنزَلۡنَٰهُ حُكۡمًا عَرَبِيّٗاۚ وَلَئِنِ ٱتَّبَعۡتَ أَهۡوَآءَهُم بَعۡدَ مَا جَآءَكَ مِنَ ٱلۡعِلۡمِ مَا لَكَ مِنَ ٱللَّهِ مِن وَلِيّٖ وَلَا وَاقٖ",
    "ayah_text_no_diacratic" : "وكذٰلك انزلنٰه حكما عربيا ولئن اتبعت اهواءهم بعد ما جاءك من العلم ما لك من الله من ولي ولا واق",
    "ayahnumber" : "37",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1768",
    "page" : "254",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1769",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا رُسُلٗا مِّن قَبۡلِكَ وَجَعَلۡنَا لَهُمۡ أَزۡوَٰجٗا وَذُرِّيَّةٗۚ وَمَا كَانَ لِرَسُولٍ أَن يَأۡتِيَ بِـَٔايَةٍ إِلَّا بِإِذۡنِ ٱللَّهِۗ لِكُلِّ أَجَلٖ كِتَابٞ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا رسلا من قبلك وجعلنا لهم ازوٰجا وذرية وما كان لرسول ان ياتي باية الا باذن الله لكل اجل كتاب",
    "ayahnumber" : "38",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1769",
    "page" : "254",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:177",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ ٱتَّبَعُواْ لَوۡ أَنَّ لَنَا كَرَّةٗ فَنَتَبَرَّأَ مِنۡهُمۡ كَمَا تَبَرَّءُواْ مِنَّاۗ كَذَٰلِكَ يُرِيهِمُ ٱللَّهُ أَعۡمَٰلَهُمۡ حَسَرَٰتٍ عَلَيۡهِمۡۖ وَمَا هُم بِخَٰرِجِينَ مِنَ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "وقال الذين اتبعوا لو ان لنا كرة فنتبرا منهم كما تبرءوا منا كذٰلك يريهم الله اعمٰلهم حسرٰت عليهم وما هم بخٰرجين من النار",
    "ayahnumber" : "167",
    "chapter" : "2",
    "hizb" : "2",
