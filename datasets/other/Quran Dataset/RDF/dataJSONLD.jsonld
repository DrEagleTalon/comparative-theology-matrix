    "surahnumber" : "69",
    "surrahname_no_diacratic" : "سورة الحاقة"
  }, {
    "@id" : "quran:5472",
    "ayah_text" : "فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةٞ وَٰحِدَةٞ",
    "ayah_text_no_diacratic" : "فاذا نفخ في الصور نفخة وٰحدة",
    "ayahnumber" : "13",
