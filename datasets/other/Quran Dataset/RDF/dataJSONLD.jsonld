    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3881",
    "ayah_text" : "هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ",
    "ayah_text_no_diacratic" : "هٰذا يوم الفصل الذي كنتم به تكذبون",
    "ayahnumber" : "21",
