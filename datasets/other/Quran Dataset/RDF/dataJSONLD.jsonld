    "page" : "436",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3744",
    "ayah_text" : "إِن يَشَأۡ يُذۡهِبۡكُمۡ وَيَأۡتِ بِخَلۡقٖ جَدِيدٖ",
    "ayah_text_no_diacratic" : "ان يشا يذهبكم ويات بخلق جديد",
    "ayahnumber" : "16",
    "chapter" : "22",
    "hizb" : "43",
