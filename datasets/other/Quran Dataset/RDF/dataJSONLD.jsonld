    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4687",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ ٱللَّهَ يَدُ ٱللَّهِ فَوۡقَ أَيۡدِيهِمۡۚ فَمَن نَّكَثَ فَإِنَّمَا يَنكُثُ عَلَىٰ نَفۡسِهِۦۖ وَمَنۡ أَوۡفَىٰ بِمَا عَٰهَدَ عَلَيۡهُ ٱللَّهَ فَسَيُؤۡتِيهِ أَجۡرًا عَظِيمٗا",
    "ayah_text_no_diacratic" : "ان الذين يبايعونك انما يبايعون الله يد الله فوق ايديهم فمن نكث فانما ينكث علىٰ نفسه ومن اوفىٰ بما عٰهد عليه الله فسيؤتيه اجرا عظيما",
    "ayahnumber" : "10",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4687",
    "page" : "512",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4688",
    "ayah_text" : "سَيَقُولُ لَكَ ٱلۡمُخَلَّفُونَ مِنَ ٱلۡأَعۡرَابِ شَغَلَتۡنَآ أَمۡوَٰلُنَا وَأَهۡلُونَا فَٱسۡتَغۡفِرۡ لَنَاۚ يَقُولُونَ بِأَلۡسِنَتِهِم مَّا لَيۡسَ فِي قُلُوبِهِمۡۚ قُلۡ فَمَن يَمۡلِكُ لَكُم مِّنَ ٱللَّهِ شَيۡـًٔا إِنۡ أَرَادَ بِكُمۡ ضَرًّا أَوۡ أَرَادَ بِكُمۡ نَفۡعَۢاۚ بَلۡ كَانَ ٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرَۢا",
    "ayah_text_no_diacratic" : "سيقول لك المخلفون من الاعراب شغلتنا اموٰلنا واهلونا فاستغفر لنا يقولون بالسنتهم ما ليس في قلوبهم قل فمن يملك لكم من الله شيا ان اراد بكم ضرا او اراد بكم نفعا بل كان الله بما تعملون خبيرا",
    "ayahnumber" : "11",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4688",
    "page" : "512",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4689",
    "ayah_text" : "بَلۡ ظَنَنتُمۡ أَن لَّن يَنقَلِبَ ٱلرَّسُولُ وَٱلۡمُؤۡمِنُونَ إِلَىٰٓ أَهۡلِيهِمۡ أَبَدٗا وَزُيِّنَ ذَٰلِكَ فِي قُلُوبِكُمۡ وَظَنَنتُمۡ ظَنَّ ٱلسَّوۡءِ وَكُنتُمۡ قَوۡمَۢا بُورٗا",
    "ayah_text_no_diacratic" : "بل ظننتم ان لن ينقلب الرسول والمؤمنون الىٰ اهليهم ابدا وزين ذٰلك في قلوبكم وظننتم ظن السوء وكنتم قوما بورا",
    "ayahnumber" : "12",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4689",
    "page" : "512",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:469",
    "ayah_text" : "۞يَسۡتَبۡشِرُونَ بِنِعۡمَةٖ مِّنَ ٱللَّهِ وَفَضۡلٖ وَأَنَّ ٱللَّهَ لَا يُضِيعُ أَجۡرَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "يستبشرون بنعمة من الله وفضل وان الله لا يضيع اجر المؤمنين",
    "ayahnumber" : "171",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "469",
    "page" : "72",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4690",
    "ayah_text" : "وَمَن لَّمۡ يُؤۡمِنۢ بِٱللَّهِ وَرَسُولِهِۦ فَإِنَّآ أَعۡتَدۡنَا لِلۡكَٰفِرِينَ سَعِيرٗا",
    "ayah_text_no_diacratic" : "ومن لم يؤمن بالله ورسوله فانا اعتدنا للكٰفرين سعيرا",
    "ayahnumber" : "13",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4690",
    "page" : "512",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4691",
    "ayah_text" : "وَلِلَّهِ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ يَغۡفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۚ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "ولله ملك السمٰوٰت والارض يغفر لمن يشاء ويعذب من يشاء وكان الله غفورا رحيما",
    "ayahnumber" : "14",
    "chapter" : "26",
    "hizb" : "51",
