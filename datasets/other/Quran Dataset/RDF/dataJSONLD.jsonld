  }, {
    "@id" : "quran:2061",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
