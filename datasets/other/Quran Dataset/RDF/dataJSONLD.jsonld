    "chapter" : "25",
    "hizb" : "49",
    "index" : "4434",
    "page" : "491",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4435",
    "ayah_text" : "وَإِذۡ قَالَ إِبۡرَٰهِيمُ لِأَبِيهِ وَقَوۡمِهِۦٓ إِنَّنِي بَرَآءٞ مِّمَّا تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "واذ قال ابرٰهيم لابيه وقومه انني براء مما تعبدون",
    "ayahnumber" : "26",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4435",
    "page" : "491",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4436",
    "ayah_text" : "إِلَّا ٱلَّذِي فَطَرَنِي فَإِنَّهُۥ سَيَهۡدِينِ",
    "ayah_text_no_diacratic" : "الا الذي فطرني فانه سيهدين",
    "ayahnumber" : "27",
    "chapter" : "25",
    "hizb" : "49",
