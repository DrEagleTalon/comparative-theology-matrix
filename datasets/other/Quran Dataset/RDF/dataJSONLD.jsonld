    "page" : "235",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1619",
    "ayah_text" : "الٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ",
    "ayah_text_no_diacratic" : "الر تلك ءايٰت الكتٰب المبين",
    "ayahnumber" : "1",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1619",
    "page" : "235",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:162",
    "ayah_text" : "فَٱذۡكُرُونِيٓ أَذۡكُرۡكُمۡ وَٱشۡكُرُواْ لِي وَلَا تَكۡفُرُونِ",
    "ayah_text_no_diacratic" : "فاذكروني اذكركم واشكروا لي ولا تكفرون",
    "ayahnumber" : "152",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "162",
    "page" : "23",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1620",
    "ayah_text" : "إِنَّآ أَنزَلۡنَٰهُ قُرۡءَٰنًا عَرَبِيّٗا لَّعَلَّكُمۡ تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "انا انزلنٰه قرءٰنا عربيا لعلكم تعقلون",
    "ayahnumber" : "2",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1620",
    "page" : "235",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1621",
    "ayah_text" : "نَحۡنُ نَقُصُّ عَلَيۡكَ أَحۡسَنَ ٱلۡقَصَصِ بِمَآ أَوۡحَيۡنَآ إِلَيۡكَ هَٰذَا ٱلۡقُرۡءَانَ وَإِن كُنتَ مِن قَبۡلِهِۦ لَمِنَ ٱلۡغَٰفِلِينَ",
    "ayah_text_no_diacratic" : "نحن نقص عليك احسن القصص بما اوحينا اليك هٰذا القرءان وان كنت من قبله لمن الغٰفلين",
    "ayahnumber" : "3",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1621",
    "page" : "235",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1622",
    "ayah_text" : "إِذۡ قَالَ يُوسُفُ لِأَبِيهِ يَٰٓأَبَتِ إِنِّي رَأَيۡتُ أَحَدَ عَشَرَ كَوۡكَبٗا وَٱلشَّمۡسَ وَٱلۡقَمَرَ رَأَيۡتُهُمۡ لِي سَٰجِدِينَ",
    "ayah_text_no_diacratic" : "اذ قال يوسف لابيه يٰابت اني رايت احد عشر كوكبا والشمس والقمر رايتهم لي سٰجدين",
    "ayahnumber" : "4",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1622",
    "page" : "235",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1623",
    "ayah_text" : "قَالَ يَٰبُنَيَّ لَا تَقۡصُصۡ رُءۡيَاكَ عَلَىٰٓ إِخۡوَتِكَ فَيَكِيدُواْ لَكَ كَيۡدًاۖ إِنَّ ٱلشَّيۡطَٰنَ لِلۡإِنسَٰنِ عَدُوّٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "قال يٰبني لا تقصص رءياك علىٰ اخوتك فيكيدوا لك كيدا ان الشيطٰن للانسٰن عدو مبين",
    "ayahnumber" : "5",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1623",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1624",
    "ayah_text" : "وَكَذَٰلِكَ يَجۡتَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِن تَأۡوِيلِ ٱلۡأَحَادِيثِ وَيُتِمُّ نِعۡمَتَهُۥ عَلَيۡكَ وَعَلَىٰٓ ءَالِ يَعۡقُوبَ كَمَآ أَتَمَّهَا عَلَىٰٓ أَبَوَيۡكَ مِن قَبۡلُ إِبۡرَٰهِيمَ وَإِسۡحَٰقَۚ إِنَّ رَبَّكَ عَلِيمٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "وكذٰلك يجتبيك ربك ويعلمك من تاويل الاحاديث ويتم نعمته عليك وعلىٰ ءال يعقوب كما اتمها علىٰ ابويك من قبل ابرٰهيم واسحٰق ان ربك عليم حكيم",
    "ayahnumber" : "6",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1624",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1625",
    "ayah_text" : "۞لَّقَدۡ كَانَ فِي يُوسُفَ وَإِخۡوَتِهِۦٓ ءَايَٰتٞ لِّلسَّآئِلِينَ",
    "ayah_text_no_diacratic" : "لقد كان في يوسف واخوته ءايٰت للسائلين",
    "ayahnumber" : "7",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1625",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1626",
    "ayah_text" : "إِذۡ قَالُواْ لَيُوسُفُ وَأَخُوهُ أَحَبُّ إِلَىٰٓ أَبِينَا مِنَّا وَنَحۡنُ عُصۡبَةٌ إِنَّ أَبَانَا لَفِي ضَلَٰلٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "اذ قالوا ليوسف واخوه احب الىٰ ابينا منا ونحن عصبة ان ابانا لفي ضلٰل مبين",
    "ayahnumber" : "8",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1626",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1627",
    "ayah_text" : "ٱقۡتُلُواْ يُوسُفَ أَوِ ٱطۡرَحُوهُ أَرۡضٗا يَخۡلُ لَكُمۡ وَجۡهُ أَبِيكُمۡ وَتَكُونُواْ مِنۢ بَعۡدِهِۦ قَوۡمٗا صَٰلِحِينَ",
    "ayah_text_no_diacratic" : "اقتلوا يوسف او اطرحوه ارضا يخل لكم وجه ابيكم وتكونوا من بعده قوما صٰلحين",
    "ayahnumber" : "9",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1627",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1628",
    "ayah_text" : "قَالَ قَآئِلٞ مِّنۡهُمۡ لَا تَقۡتُلُواْ يُوسُفَ وَأَلۡقُوهُ فِي غَيَٰبَتِ ٱلۡجُبِّ يَلۡتَقِطۡهُ بَعۡضُ ٱلسَّيَّارَةِ إِن كُنتُمۡ فَٰعِلِينَ",
    "ayah_text_no_diacratic" : "قال قائل منهم لا تقتلوا يوسف والقوه في غيٰبت الجب يلتقطه بعض السيارة ان كنتم فٰعلين",
    "ayahnumber" : "10",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1628",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1629",
    "ayah_text" : "قَالُواْ يَٰٓأَبَانَا مَا لَكَ لَا تَأۡمَ۬نَّا عَلَىٰ يُوسُفَ وَإِنَّا لَهُۥ لَنَٰصِحُونَ",
    "ayah_text_no_diacratic" : "قالوا يٰابانا ما لك لا تامنا علىٰ يوسف وانا له لنٰصحون",
    "ayahnumber" : "11",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1629",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:163",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱسۡتَعِينُواْ بِٱلصَّبۡرِ وَٱلصَّلَوٰةِۚ إِنَّ ٱللَّهَ مَعَ ٱلصَّٰبِرِينَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا استعينوا بالصبر والصلوٰة ان الله مع الصٰبرين",
    "ayahnumber" : "153",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "163",
    "page" : "23",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1630",
    "ayah_text" : "أَرۡسِلۡهُ مَعَنَا غَدٗا يَرۡتَعۡ وَيَلۡعَبۡ وَإِنَّا لَهُۥ لَحَٰفِظُونَ",
    "ayah_text_no_diacratic" : "ارسله معنا غدا يرتع ويلعب وانا له لحٰفظون",
    "ayahnumber" : "12",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1630",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1631",
    "ayah_text" : "قَالَ إِنِّي لَيَحۡزُنُنِيٓ أَن تَذۡهَبُواْ بِهِۦ وَأَخَافُ أَن يَأۡكُلَهُ ٱلذِّئۡبُ وَأَنتُمۡ عَنۡهُ غَٰفِلُونَ",
    "ayah_text_no_diacratic" : "قال اني ليحزنني ان تذهبوا به واخاف ان ياكله الذئب وانتم عنه غٰفلون",
    "ayahnumber" : "13",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1631",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1632",
    "ayah_text" : "قَالُواْ لَئِنۡ أَكَلَهُ ٱلذِّئۡبُ وَنَحۡنُ عُصۡبَةٌ إِنَّآ إِذٗا لَّخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "قالوا لئن اكله الذئب ونحن عصبة انا اذا لخٰسرون",
    "ayahnumber" : "14",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1632",
    "page" : "236",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1633",
    "ayah_text" : "فَلَمَّا ذَهَبُواْ بِهِۦ وَأَجۡمَعُوٓاْ أَن يَجۡعَلُوهُ فِي غَيَٰبَتِ ٱلۡجُبِّۚ وَأَوۡحَيۡنَآ إِلَيۡهِ لَتُنَبِّئَنَّهُم بِأَمۡرِهِمۡ هَٰذَا وَهُمۡ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "فلما ذهبوا به واجمعوا ان يجعلوه في غيٰبت الجب واوحينا اليه لتنبئنهم بامرهم هٰذا وهم لا يشعرون",
    "ayahnumber" : "15",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1633",
    "page" : "237",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1634",
    "ayah_text" : "وَجَآءُوٓ أَبَاهُمۡ عِشَآءٗ يَبۡكُونَ",
    "ayah_text_no_diacratic" : "وجاءو اباهم عشاء يبكون",
    "ayahnumber" : "16",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1634",
    "page" : "237",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1635",
    "ayah_text" : "قَالُواْ يَٰٓأَبَانَآ إِنَّا ذَهَبۡنَا نَسۡتَبِقُ وَتَرَكۡنَا يُوسُفَ عِندَ مَتَٰعِنَا فَأَكَلَهُ ٱلذِّئۡبُۖ وَمَآ أَنتَ بِمُؤۡمِنٖ لَّنَا وَلَوۡ كُنَّا صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "قالوا يٰابانا انا ذهبنا نستبق وتركنا يوسف عند متٰعنا فاكله الذئب وما انت بمؤمن لنا ولو كنا صٰدقين",
    "ayahnumber" : "17",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1635",
    "page" : "237",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1636",
    "ayah_text" : "وَجَآءُو عَلَىٰ قَمِيصِهِۦ بِدَمٖ كَذِبٖۚ قَالَ بَلۡ سَوَّلَتۡ لَكُمۡ أَنفُسُكُمۡ أَمۡرٗاۖ فَصَبۡرٞ جَمِيلٞۖ وَٱللَّهُ ٱلۡمُسۡتَعَانُ عَلَىٰ مَا تَصِفُونَ",
    "ayah_text_no_diacratic" : "وجاءو علىٰ قميصه بدم كذب قال بل سولت لكم انفسكم امرا فصبر جميل والله المستعان علىٰ ما تصفون",
    "ayahnumber" : "18",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1636",
    "page" : "237",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1637",
    "ayah_text" : "وَجَآءَتۡ سَيَّارَةٞ فَأَرۡسَلُواْ وَارِدَهُمۡ فَأَدۡلَىٰ دَلۡوَهُۥۖ قَالَ يَٰبُشۡرَىٰ هَٰذَا غُلَٰمٞۚ وَأَسَرُّوهُ بِضَٰعَةٗۚ وَٱللَّهُ عَلِيمُۢ بِمَا يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "وجاءت سيارة فارسلوا واردهم فادلىٰ دلوه قال يٰبشرىٰ هٰذا غلٰم واسروه بضٰعة والله عليم بما يعملون",
    "ayahnumber" : "19",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1637",
    "page" : "237",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1638",
    "ayah_text" : "وَشَرَوۡهُ بِثَمَنِۭ بَخۡسٖ دَرَٰهِمَ مَعۡدُودَةٖ وَكَانُواْ فِيهِ مِنَ ٱلزَّٰهِدِينَ",
    "ayah_text_no_diacratic" : "وشروه بثمن بخس درٰهم معدودة وكانوا فيه من الزٰهدين",
    "ayahnumber" : "20",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1638",
    "page" : "237",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1639",
    "ayah_text" : "وَقَالَ ٱلَّذِي ٱشۡتَرَىٰهُ مِن مِّصۡرَ لِٱمۡرَأَتِهِۦٓ أَكۡرِمِي مَثۡوَىٰهُ عَسَىٰٓ أَن يَنفَعَنَآ أَوۡ نَتَّخِذَهُۥ وَلَدٗاۚ وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِي ٱلۡأَرۡضِ وَلِنُعَلِّمَهُۥ مِن تَأۡوِيلِ ٱلۡأَحَادِيثِۚ وَٱللَّهُ غَالِبٌ عَلَىٰٓ أَمۡرِهِۦ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وقال الذي اشترىٰه من مصر لامراته اكرمي مثوىٰه عسىٰ ان ينفعنا او نتخذه ولدا وكذٰلك مكنا ليوسف في الارض ولنعلمه من تاويل الاحاديث والله غالب علىٰ امره ولٰكن اكثر الناس لا يعلمون",
    "ayahnumber" : "21",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1639",
    "page" : "237",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:164",
    "ayah_text" : "وَلَا تَقُولُواْ لِمَن يُقۡتَلُ فِي سَبِيلِ ٱللَّهِ أَمۡوَٰتُۢۚ بَلۡ أَحۡيَآءٞ وَلَٰكِن لَّا تَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "ولا تقولوا لمن يقتل في سبيل الله اموٰت بل احياء ولٰكن لا تشعرون",
    "ayahnumber" : "154",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "164",
    "page" : "24",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1640",
    "ayah_text" : "وَلَمَّا بَلَغَ أَشُدَّهُۥٓ ءَاتَيۡنَٰهُ حُكۡمٗا وَعِلۡمٗاۚ وَكَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "ولما بلغ اشده ءاتينٰه حكما وعلما وكذٰلك نجزي المحسنين",
    "ayahnumber" : "22",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1640",
    "page" : "237",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1641",
    "ayah_text" : "وَرَٰوَدَتۡهُ ٱلَّتِي هُوَ فِي بَيۡتِهَا عَن نَّفۡسِهِۦ وَغَلَّقَتِ ٱلۡأَبۡوَٰبَ وَقَالَتۡ هَيۡتَ لَكَۚ قَالَ مَعَاذَ ٱللَّهِۖ إِنَّهُۥ رَبِّيٓ أَحۡسَنَ مَثۡوَايَۖ إِنَّهُۥ لَا يُفۡلِحُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "ورٰودته التي هو في بيتها عن نفسه وغلقت الابوٰب وقالت هيت لك قال معاذ الله انه ربي احسن مثواي انه لا يفلح الظٰلمون",
    "ayahnumber" : "23",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1641",
    "page" : "238",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1642",
    "ayah_text" : "وَلَقَدۡ هَمَّتۡ بِهِۦۖ وَهَمَّ بِهَا لَوۡلَآ أَن رَّءَا بُرۡهَٰنَ رَبِّهِۦۚ كَذَٰلِكَ لِنَصۡرِفَ عَنۡهُ ٱلسُّوٓءَ وَٱلۡفَحۡشَآءَۚ إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُخۡلَصِينَ",
    "ayah_text_no_diacratic" : "ولقد همت به وهم بها لولا ان رءا برهٰن ربه كذٰلك لنصرف عنه السوء والفحشاء انه من عبادنا المخلصين",
    "ayahnumber" : "24",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1642",
    "page" : "238",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1643",
    "ayah_text" : "وَٱسۡتَبَقَا ٱلۡبَابَ وَقَدَّتۡ قَمِيصَهُۥ مِن دُبُرٖ وَأَلۡفَيَا سَيِّدَهَا لَدَا ٱلۡبَابِۚ قَالَتۡ مَا جَزَآءُ مَنۡ أَرَادَ بِأَهۡلِكَ سُوٓءًا إِلَّآ أَن يُسۡجَنَ أَوۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "واستبقا الباب وقدت قميصه من دبر والفيا سيدها لدا الباب قالت ما جزاء من اراد باهلك سوءا الا ان يسجن او عذاب اليم",
    "ayahnumber" : "25",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1643",
    "page" : "238",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1644",
    "ayah_text" : "قَالَ هِيَ رَٰوَدَتۡنِي عَن نَّفۡسِيۚ وَشَهِدَ شَاهِدٞ مِّنۡ أَهۡلِهَآ إِن كَانَ قَمِيصُهُۥ قُدَّ مِن قُبُلٖ فَصَدَقَتۡ وَهُوَ مِنَ ٱلۡكَٰذِبِينَ",
    "ayah_text_no_diacratic" : "قال هي رٰودتني عن نفسي وشهد شاهد من اهلها ان كان قميصه قد من قبل فصدقت وهو من الكٰذبين",
    "ayahnumber" : "26",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1644",
    "page" : "238",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1645",
    "ayah_text" : "وَإِن كَانَ قَمِيصُهُۥ قُدَّ مِن دُبُرٖ فَكَذَبَتۡ وَهُوَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "وان كان قميصه قد من دبر فكذبت وهو من الصٰدقين",
    "ayahnumber" : "27",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1645",
    "page" : "238",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1646",
    "ayah_text" : "فَلَمَّا رَءَا قَمِيصَهُۥ قُدَّ مِن دُبُرٖ قَالَ إِنَّهُۥ مِن كَيۡدِكُنَّۖ إِنَّ كَيۡدَكُنَّ عَظِيمٞ",
    "ayah_text_no_diacratic" : "فلما رءا قميصه قد من دبر قال انه من كيدكن ان كيدكن عظيم",
    "ayahnumber" : "28",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1646",
    "page" : "238",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1647",
    "ayah_text" : "يُوسُفُ أَعۡرِضۡ عَنۡ هَٰذَاۚ وَٱسۡتَغۡفِرِي لِذَنۢبِكِۖ إِنَّكِ كُنتِ مِنَ ٱلۡخَاطِـِٔينَ",
    "ayah_text_no_diacratic" : "يوسف اعرض عن هٰذا واستغفري لذنبك انك كنت من الخاطين",
    "ayahnumber" : "29",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1647",
    "page" : "238",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1648",
    "ayah_text" : "۞وَقَالَ نِسۡوَةٞ فِي ٱلۡمَدِينَةِ ٱمۡرَأَتُ ٱلۡعَزِيزِ تُرَٰوِدُ فَتَىٰهَا عَن نَّفۡسِهِۦۖ قَدۡ شَغَفَهَا حُبًّاۖ إِنَّا لَنَرَىٰهَا فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "وقال نسوة في المدينة امرات العزيز ترٰود فتىٰها عن نفسه قد شغفها حبا انا لنرىٰها في ضلٰل مبين",
    "ayahnumber" : "30",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1648",
    "page" : "238",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1649",
    "ayah_text" : "فَلَمَّا سَمِعَتۡ بِمَكۡرِهِنَّ أَرۡسَلَتۡ إِلَيۡهِنَّ وَأَعۡتَدَتۡ لَهُنَّ مُتَّكَـٔٗا وَءَاتَتۡ كُلَّ وَٰحِدَةٖ مِّنۡهُنَّ سِكِّينٗا وَقَالَتِ ٱخۡرُجۡ عَلَيۡهِنَّۖ فَلَمَّا رَأَيۡنَهُۥٓ أَكۡبَرۡنَهُۥ وَقَطَّعۡنَ أَيۡدِيَهُنَّ وَقُلۡنَ حَٰشَ لِلَّهِ مَا هَٰذَا بَشَرًا إِنۡ هَٰذَآ إِلَّا مَلَكٞ كَرِيمٞ",
    "ayah_text_no_diacratic" : "فلما سمعت بمكرهن ارسلت اليهن واعتدت لهن متكا وءاتت كل وٰحدة منهن سكينا وقالت اخرج عليهن فلما راينه اكبرنه وقطعن ايديهن وقلن حٰش لله ما هٰذا بشرا ان هٰذا الا ملك كريم",
    "ayahnumber" : "31",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1649",
    "page" : "239",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:165",
    "ayah_text" : "وَلَنَبۡلُوَنَّكُم بِشَيۡءٖ مِّنَ ٱلۡخَوۡفِ وَٱلۡجُوعِ وَنَقۡصٖ مِّنَ ٱلۡأَمۡوَٰلِ وَٱلۡأَنفُسِ وَٱلثَّمَرَٰتِۗ وَبَشِّرِ ٱلصَّٰبِرِينَ",
    "ayah_text_no_diacratic" : "ولنبلونكم بشيء من الخوف والجوع ونقص من الاموٰل والانفس والثمرٰت وبشر الصٰبرين",
    "ayahnumber" : "155",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "165",
    "page" : "24",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1650",
    "ayah_text" : "قَالَتۡ فَذَٰلِكُنَّ ٱلَّذِي لُمۡتُنَّنِي فِيهِۖ وَلَقَدۡ رَٰوَدتُّهُۥ عَن نَّفۡسِهِۦ فَٱسۡتَعۡصَمَۖ وَلَئِن لَّمۡ يَفۡعَلۡ مَآ ءَامُرُهُۥ لَيُسۡجَنَنَّ وَلَيَكُونٗا مِّنَ ٱلصَّٰغِرِينَ",
    "ayah_text_no_diacratic" : "قالت فذٰلكن الذي لمتنني فيه ولقد رٰودته عن نفسه فاستعصم ولئن لم يفعل ما ءامره ليسجنن وليكونا من الصٰغرين",
    "ayahnumber" : "32",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1650",
    "page" : "239",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1651",
    "ayah_text" : "قَالَ رَبِّ ٱلسِّجۡنُ أَحَبُّ إِلَيَّ مِمَّا يَدۡعُونَنِيٓ إِلَيۡهِۖ وَإِلَّا تَصۡرِفۡ عَنِّي كَيۡدَهُنَّ أَصۡبُ إِلَيۡهِنَّ وَأَكُن مِّنَ ٱلۡجَٰهِلِينَ",
    "ayah_text_no_diacratic" : "قال رب السجن احب الي مما يدعونني اليه والا تصرف عني كيدهن اصب اليهن واكن من الجٰهلين",
    "ayahnumber" : "33",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1651",
    "page" : "239",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1652",
    "ayah_text" : "فَٱسۡتَجَابَ لَهُۥ رَبُّهُۥ فَصَرَفَ عَنۡهُ كَيۡدَهُنَّۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "فاستجاب له ربه فصرف عنه كيدهن انه هو السميع العليم",
    "ayahnumber" : "34",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1652",
    "page" : "239",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1653",
    "ayah_text" : "ثُمَّ بَدَا لَهُم مِّنۢ بَعۡدِ مَا رَأَوُاْ ٱلۡأٓيَٰتِ لَيَسۡجُنُنَّهُۥ حَتَّىٰ حِينٖ",
    "ayah_text_no_diacratic" : "ثم بدا لهم من بعد ما راوا الايٰت ليسجننه حتىٰ حين",
    "ayahnumber" : "35",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1653",
    "page" : "239",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1654",
    "ayah_text" : "وَدَخَلَ مَعَهُ ٱلسِّجۡنَ فَتَيَانِۖ قَالَ أَحَدُهُمَآ إِنِّيٓ أَرَىٰنِيٓ أَعۡصِرُ خَمۡرٗاۖ وَقَالَ ٱلۡأٓخَرُ إِنِّيٓ أَرَىٰنِيٓ أَحۡمِلُ فَوۡقَ رَأۡسِي خُبۡزٗا تَأۡكُلُ ٱلطَّيۡرُ مِنۡهُۖ نَبِّئۡنَا بِتَأۡوِيلِهِۦٓۖ إِنَّا نَرَىٰكَ مِنَ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "ودخل معه السجن فتيان قال احدهما اني ارىٰني اعصر خمرا وقال الاخر اني ارىٰني احمل فوق راسي خبزا تاكل الطير منه نبئنا بتاويله انا نرىٰك من المحسنين",
    "ayahnumber" : "36",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1654",
    "page" : "239",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1655",
    "ayah_text" : "قَالَ لَا يَأۡتِيكُمَا طَعَامٞ تُرۡزَقَانِهِۦٓ إِلَّا نَبَّأۡتُكُمَا بِتَأۡوِيلِهِۦ قَبۡلَ أَن يَأۡتِيَكُمَاۚ ذَٰلِكُمَا مِمَّا عَلَّمَنِي رَبِّيٓۚ إِنِّي تَرَكۡتُ مِلَّةَ قَوۡمٖ لَّا يُؤۡمِنُونَ بِٱللَّهِ وَهُم بِٱلۡأٓخِرَةِ هُمۡ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "قال لا ياتيكما طعام ترزقانه الا نباتكما بتاويله قبل ان ياتيكما ذٰلكما مما علمني ربي اني تركت ملة قوم لا يؤمنون بالله وهم بالاخرة هم كٰفرون",
    "ayahnumber" : "37",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1655",
    "page" : "239",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1656",
    "ayah_text" : "وَٱتَّبَعۡتُ مِلَّةَ ءَابَآءِيٓ إِبۡرَٰهِيمَ وَإِسۡحَٰقَ وَيَعۡقُوبَۚ مَا كَانَ لَنَآ أَن نُّشۡرِكَ بِٱللَّهِ مِن شَيۡءٖۚ ذَٰلِكَ مِن فَضۡلِ ٱللَّهِ عَلَيۡنَا وَعَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "واتبعت ملة ءاباءي ابرٰهيم واسحٰق ويعقوب ما كان لنا ان نشرك بالله من شيء ذٰلك من فضل الله علينا وعلى الناس ولٰكن اكثر الناس لا يشكرون",
    "ayahnumber" : "38",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1656",
    "page" : "240",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1657",
    "ayah_text" : "يَٰصَٰحِبَيِ ٱلسِّجۡنِ ءَأَرۡبَابٞ مُّتَفَرِّقُونَ خَيۡرٌ أَمِ ٱللَّهُ ٱلۡوَٰحِدُ ٱلۡقَهَّارُ",
    "ayah_text_no_diacratic" : "يٰصٰحبي السجن ءارباب متفرقون خير ام الله الوٰحد القهار",
    "ayahnumber" : "39",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1657",
    "page" : "240",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1658",
    "ayah_text" : "مَا تَعۡبُدُونَ مِن دُونِهِۦٓ إِلَّآ أَسۡمَآءٗ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِنِ ٱلۡحُكۡمُ إِلَّا لِلَّهِ أَمَرَ أَلَّا تَعۡبُدُوٓاْ إِلَّآ إِيَّاهُۚ ذَٰلِكَ ٱلدِّينُ ٱلۡقَيِّمُ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ما تعبدون من دونه الا اسماء سميتموها انتم وءاباؤكم ما انزل الله بها من سلطٰن ان الحكم الا لله امر الا تعبدوا الا اياه ذٰلك الدين القيم ولٰكن اكثر الناس لا يعلمون",
    "ayahnumber" : "40",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1658",
    "page" : "240",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1659",
    "ayah_text" : "يَٰصَٰحِبَيِ ٱلسِّجۡنِ أَمَّآ أَحَدُكُمَا فَيَسۡقِي رَبَّهُۥ خَمۡرٗاۖ وَأَمَّا ٱلۡأٓخَرُ فَيُصۡلَبُ فَتَأۡكُلُ ٱلطَّيۡرُ مِن رَّأۡسِهِۦۚ قُضِيَ ٱلۡأَمۡرُ ٱلَّذِي فِيهِ تَسۡتَفۡتِيَانِ",
    "ayah_text_no_diacratic" : "يٰصٰحبي السجن اما احدكما فيسقي ربه خمرا واما الاخر فيصلب فتاكل الطير من راسه قضي الامر الذي فيه تستفتيان",
    "ayahnumber" : "41",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1659",
    "page" : "240",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:166",
    "ayah_text" : "ٱلَّذِينَ إِذَآ أَصَٰبَتۡهُم مُّصِيبَةٞ قَالُوٓاْ إِنَّا لِلَّهِ وَإِنَّآ إِلَيۡهِ رَٰجِعُونَ",
    "ayah_text_no_diacratic" : "الذين اذا اصٰبتهم مصيبة قالوا انا لله وانا اليه رٰجعون",
    "ayahnumber" : "156",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "166",
    "page" : "24",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1660",
    "ayah_text" : "وَقَالَ لِلَّذِي ظَنَّ أَنَّهُۥ نَاجٖ مِّنۡهُمَا ٱذۡكُرۡنِي عِندَ رَبِّكَ فَأَنسَىٰهُ ٱلشَّيۡطَٰنُ ذِكۡرَ رَبِّهِۦ فَلَبِثَ فِي ٱلسِّجۡنِ بِضۡعَ سِنِينَ",
    "ayah_text_no_diacratic" : "وقال للذي ظن انه ناج منهما اذكرني عند ربك فانسىٰه الشيطٰن ذكر ربه فلبث في السجن بضع سنين",
    "ayahnumber" : "42",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1660",
    "page" : "240",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1661",
    "ayah_text" : "وَقَالَ ٱلۡمَلِكُ إِنِّيٓ أَرَىٰ سَبۡعَ بَقَرَٰتٖ سِمَانٖ يَأۡكُلُهُنَّ سَبۡعٌ عِجَافٞ وَسَبۡعَ سُنۢبُلَٰتٍ خُضۡرٖ وَأُخَرَ يَابِسَٰتٖۖ يَٰٓأَيُّهَا ٱلۡمَلَأُ أَفۡتُونِي فِي رُءۡيَٰيَ إِن كُنتُمۡ لِلرُّءۡيَا تَعۡبُرُونَ",
    "ayah_text_no_diacratic" : "وقال الملك اني ارىٰ سبع بقرٰت سمان ياكلهن سبع عجاف وسبع سنبلٰت خضر واخر يابسٰت يٰايها الملا افتوني في رءيٰي ان كنتم للرءيا تعبرون",
    "ayahnumber" : "43",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1661",
    "page" : "240",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1662",
    "ayah_text" : "قَالُوٓاْ أَضۡغَٰثُ أَحۡلَٰمٖۖ وَمَا نَحۡنُ بِتَأۡوِيلِ ٱلۡأَحۡلَٰمِ بِعَٰلِمِينَ",
    "ayah_text_no_diacratic" : "قالوا اضغٰث احلٰم وما نحن بتاويل الاحلٰم بعٰلمين",
    "ayahnumber" : "44",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1662",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1663",
    "ayah_text" : "وَقَالَ ٱلَّذِي نَجَا مِنۡهُمَا وَٱدَّكَرَ بَعۡدَ أُمَّةٍ أَنَا۠ أُنَبِّئُكُم بِتَأۡوِيلِهِۦ فَأَرۡسِلُونِ",
    "ayah_text_no_diacratic" : "وقال الذي نجا منهما وادكر بعد امة انا انبئكم بتاويله فارسلون",
    "ayahnumber" : "45",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1663",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1664",
    "ayah_text" : "يُوسُفُ أَيُّهَا ٱلصِّدِّيقُ أَفۡتِنَا فِي سَبۡعِ بَقَرَٰتٖ سِمَانٖ يَأۡكُلُهُنَّ سَبۡعٌ عِجَافٞ وَسَبۡعِ سُنۢبُلَٰتٍ خُضۡرٖ وَأُخَرَ يَابِسَٰتٖ لَّعَلِّيٓ أَرۡجِعُ إِلَى ٱلنَّاسِ لَعَلَّهُمۡ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "يوسف ايها الصديق افتنا في سبع بقرٰت سمان ياكلهن سبع عجاف وسبع سنبلٰت خضر واخر يابسٰت لعلي ارجع الى الناس لعلهم يعلمون",
    "ayahnumber" : "46",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1664",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1665",
    "ayah_text" : "قَالَ تَزۡرَعُونَ سَبۡعَ سِنِينَ دَأَبٗا فَمَا حَصَدتُّمۡ فَذَرُوهُ فِي سُنۢبُلِهِۦٓ إِلَّا قَلِيلٗا مِّمَّا تَأۡكُلُونَ",
    "ayah_text_no_diacratic" : "قال تزرعون سبع سنين دابا فما حصدتم فذروه في سنبله الا قليلا مما تاكلون",
    "ayahnumber" : "47",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1665",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1666",
    "ayah_text" : "ثُمَّ يَأۡتِي مِنۢ بَعۡدِ ذَٰلِكَ سَبۡعٞ شِدَادٞ يَأۡكُلۡنَ مَا قَدَّمۡتُمۡ لَهُنَّ إِلَّا قَلِيلٗا مِّمَّا تُحۡصِنُونَ",
    "ayah_text_no_diacratic" : "ثم ياتي من بعد ذٰلك سبع شداد ياكلن ما قدمتم لهن الا قليلا مما تحصنون",
    "ayahnumber" : "48",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1666",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1667",
    "ayah_text" : "ثُمَّ يَأۡتِي مِنۢ بَعۡدِ ذَٰلِكَ عَامٞ فِيهِ يُغَاثُ ٱلنَّاسُ وَفِيهِ يَعۡصِرُونَ",
    "ayah_text_no_diacratic" : "ثم ياتي من بعد ذٰلك عام فيه يغاث الناس وفيه يعصرون",
    "ayahnumber" : "49",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1667",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1668",
    "ayah_text" : "وَقَالَ ٱلۡمَلِكُ ٱئۡتُونِي بِهِۦۖ فَلَمَّا جَآءَهُ ٱلرَّسُولُ قَالَ ٱرۡجِعۡ إِلَىٰ رَبِّكَ فَسۡـَٔلۡهُ مَا بَالُ ٱلنِّسۡوَةِ ٱلَّٰتِي قَطَّعۡنَ أَيۡدِيَهُنَّۚ إِنَّ رَبِّي بِكَيۡدِهِنَّ عَلِيمٞ",
    "ayah_text_no_diacratic" : "وقال الملك ائتوني به فلما جاءه الرسول قال ارجع الىٰ ربك فسله ما بال النسوة الٰتي قطعن ايديهن ان ربي بكيدهن عليم",
    "ayahnumber" : "50",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1668",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1669",
    "ayah_text" : "قَالَ مَا خَطۡبُكُنَّ إِذۡ رَٰوَدتُّنَّ يُوسُفَ عَن نَّفۡسِهِۦۚ قُلۡنَ حَٰشَ لِلَّهِ مَا عَلِمۡنَا عَلَيۡهِ مِن سُوٓءٖۚ قَالَتِ ٱمۡرَأَتُ ٱلۡعَزِيزِ ٱلۡـَٰٔنَ حَصۡحَصَ ٱلۡحَقُّ أَنَا۠ رَٰوَدتُّهُۥ عَن نَّفۡسِهِۦ وَإِنَّهُۥ لَمِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "قال ما خطبكن اذ رٰودتن يوسف عن نفسه قلن حٰش لله ما علمنا عليه من سوء قالت امرات العزيز الٰن حصحص الحق انا رٰودته عن نفسه وانه لمن الصٰدقين",
    "ayahnumber" : "51",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1669",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:167",
    "ayah_text" : "أُوْلَٰٓئِكَ عَلَيۡهِمۡ صَلَوَٰتٞ مِّن رَّبِّهِمۡ وَرَحۡمَةٞۖ وَأُوْلَٰٓئِكَ هُمُ ٱلۡمُهۡتَدُونَ",
    "ayah_text_no_diacratic" : "اولٰئك عليهم صلوٰت من ربهم ورحمة واولٰئك هم المهتدون",
    "ayahnumber" : "157",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "167",
    "page" : "24",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1670",
    "ayah_text" : "ذَٰلِكَ لِيَعۡلَمَ أَنِّي لَمۡ أَخُنۡهُ بِٱلۡغَيۡبِ وَأَنَّ ٱللَّهَ لَا يَهۡدِي كَيۡدَ ٱلۡخَآئِنِينَ",
    "ayah_text_no_diacratic" : "ذٰلك ليعلم اني لم اخنه بالغيب وان الله لا يهدي كيد الخائنين",
    "ayahnumber" : "52",
    "chapter" : "12",
    "hizb" : "24",
    "index" : "1670",
    "page" : "241",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1671",
    "ayah_text" : "۞وَمَآ أُبَرِّئُ نَفۡسِيٓۚ إِنَّ ٱلنَّفۡسَ لَأَمَّارَةُۢ بِٱلسُّوٓءِ إِلَّا مَا رَحِمَ رَبِّيٓۚ إِنَّ رَبِّي غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "وما ابرئ نفسي ان النفس لامارة بالسوء الا ما رحم ربي ان ربي غفور رحيم",
    "ayahnumber" : "53",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1671",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1672",
    "ayah_text" : "وَقَالَ ٱلۡمَلِكُ ٱئۡتُونِي بِهِۦٓ أَسۡتَخۡلِصۡهُ لِنَفۡسِيۖ فَلَمَّا كَلَّمَهُۥ قَالَ إِنَّكَ ٱلۡيَوۡمَ لَدَيۡنَا مَكِينٌ أَمِينٞ",
    "ayah_text_no_diacratic" : "وقال الملك ائتوني به استخلصه لنفسي فلما كلمه قال انك اليوم لدينا مكين امين",
    "ayahnumber" : "54",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1672",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
