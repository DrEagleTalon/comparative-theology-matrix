    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3958",
    "ayah_text" : "فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ",
    "ayah_text_no_diacratic" : "فارادوا به كيدا فجعلنٰهم الاسفلين",
