    "index" : "435",
    "page" : "67",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4350",
    "ayah_text" : "قُلۡ أَرَءَيۡتُمۡ إِن كَانَ مِنۡ عِندِ ٱللَّهِ ثُمَّ كَفَرۡتُم بِهِۦ مَنۡ أَضَلُّ مِمَّنۡ هُوَ فِي شِقَاقِۭ بَعِيدٖ",
    "ayah_text_no_diacratic" : "قل ارءيتم ان كان من عند الله ثم كفرتم به من اضل ممن هو في شقاق بعيد",
    "ayahnumber" : "52",
