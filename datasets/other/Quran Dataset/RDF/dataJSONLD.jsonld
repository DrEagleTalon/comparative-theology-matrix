    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:703",
    "ayah_text" : "قَالَ رَبِّ إِنِّي لَآ أَمۡلِكُ إِلَّا نَفۡسِي وَأَخِيۖ فَٱفۡرُقۡ بَيۡنَنَا وَبَيۡنَ ٱلۡقَوۡمِ ٱلۡفَٰسِقِينَ",
    "ayah_text_no_diacratic" : "قال رب اني لا املك الا نفسي واخي فافرق بيننا وبين القوم الفٰسقين",
    "ayahnumber" : "25",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "703",
    "page" : "112",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:704",
    "ayah_text" : "قَالَ فَإِنَّهَا مُحَرَّمَةٌ عَلَيۡهِمۡۛ أَرۡبَعِينَ سَنَةٗۛ يَتِيهُونَ فِي ٱلۡأَرۡضِۚ فَلَا تَأۡسَ عَلَى ٱلۡقَوۡمِ ٱلۡفَٰسِقِينَ",
    "ayah_text_no_diacratic" : "قال فانها محرمة عليهم اربعين سنة يتيهون في الارض فلا تاس على القوم الفٰسقين",
    "ayahnumber" : "26",
    "chapter" : "6",
    "hizb" : "11",
