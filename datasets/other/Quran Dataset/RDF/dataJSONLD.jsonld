  }, {
    "@id" : "quran:2728",
    "ayah_text" : "ٱلَّذِينَ يَرِثُونَ ٱلۡفِرۡدَوۡسَ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "الذين يرثون الفردوس هم فيها خٰلدون",
