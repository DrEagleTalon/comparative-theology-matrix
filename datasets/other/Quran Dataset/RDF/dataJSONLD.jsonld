    "index" : "4588",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4589",
    "ayah_text" : "وَتَرَىٰ كُلَّ أُمَّةٖ جَاثِيَةٗۚ كُلُّ أُمَّةٖ تُدۡعَىٰٓ إِلَىٰ كِتَٰبِهَا ٱلۡيَوۡمَ تُجۡزَوۡنَ مَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "وترىٰ كل امة جاثية كل امة تدعىٰ الىٰ كتٰبها اليوم تجزون ما كنتم تعملون",
    "ayahnumber" : "28",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4589",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:459",
    "ayah_text" : "وَمَا كَانَ لِنَبِيٍّ أَن يَغُلَّۚ وَمَن يَغۡلُلۡ يَأۡتِ بِمَا غَلَّ يَوۡمَ ٱلۡقِيَٰمَةِۚ ثُمَّ تُوَفَّىٰ كُلُّ نَفۡسٖ مَّا كَسَبَتۡ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "وما كان لنبي ان يغل ومن يغلل يات بما غل يوم القيٰمة ثم توفىٰ كل نفس ما كسبت وهم لا يظلمون",
    "ayahnumber" : "161",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "459",
