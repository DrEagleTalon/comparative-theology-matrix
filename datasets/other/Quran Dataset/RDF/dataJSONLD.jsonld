  }, {
    "@id" : "quran:60",
    "ayah_text" : "وَإِذۡ فَرَقۡنَا بِكُمُ ٱلۡبَحۡرَ فَأَنجَيۡنَٰكُمۡ وَأَغۡرَقۡنَآ ءَالَ فِرۡعَوۡنَ وَأَنتُمۡ تَنظُرُونَ",
    "ayah_text_no_diacratic" : "واذ فرقنا بكم البحر فانجينٰكم واغرقنا ءال فرعون وانتم تنظرون",
    "ayahnumber" : "50",
