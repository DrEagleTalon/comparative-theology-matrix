    "surrahname_no_diacratic" : "سورة الحاقة"
  }, {
    "@id" : "quran:5468",
    "ayah_text" : "وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ",
    "ayah_text_no_diacratic" : "وجاء فرعون ومن قبله والمؤتفكٰت بالخاطئة",
