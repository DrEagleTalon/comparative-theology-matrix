  }, {
    "@id" : "quran:340",
    "ayah_text" : "وَإِذۡ قَالَتِ ٱلۡمَلَٰٓئِكَةُ يَٰمَرۡيَمُ إِنَّ ٱللَّهَ ٱصۡطَفَىٰكِ وَطَهَّرَكِ وَٱصۡطَفَىٰكِ عَلَىٰ نِسَآءِ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "واذ قالت الملٰئكة يٰمريم ان الله اصطفىٰك وطهرك واصطفىٰك علىٰ نساء العٰلمين",
    "ayahnumber" : "42",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "340",
