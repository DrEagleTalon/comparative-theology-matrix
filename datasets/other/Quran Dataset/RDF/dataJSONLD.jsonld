    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2731",
    "ayah_text" : "ثُمَّ خَلَقۡنَا ٱلنُّطۡفَةَ عَلَقَةٗ فَخَلَقۡنَا ٱلۡعَلَقَةَ مُضۡغَةٗ فَخَلَقۡنَا ٱلۡمُضۡغَةَ عِظَٰمٗا فَكَسَوۡنَا ٱلۡعِظَٰمَ لَحۡمٗا ثُمَّ أَنشَأۡنَٰهُ خَلۡقًا ءَاخَرَۚ فَتَبَارَكَ ٱللَّهُ أَحۡسَنُ ٱلۡخَٰلِقِينَ",
    "ayah_text_no_diacratic" : "ثم خلقنا النطفة علقة فخلقنا العلقة مضغة فخلقنا المضغة عظٰما فكسونا العظٰم لحما ثم انشانٰه خلقا ءاخر فتبارك الله احسن الخٰلقين",
    "ayahnumber" : "14",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2731",
    "page" : "342",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2732",
    "ayah_text" : "ثُمَّ إِنَّكُم بَعۡدَ ذَٰلِكَ لَمَيِّتُونَ",
    "ayah_text_no_diacratic" : "ثم انكم بعد ذٰلك لميتون",
