    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1122",
    "ayah_text" : "وَٱخۡتَارَ مُوسَىٰ قَوۡمَهُۥ سَبۡعِينَ رَجُلٗا لِّمِيقَٰتِنَاۖ فَلَمَّآ أَخَذَتۡهُمُ ٱلرَّجۡفَةُ قَالَ رَبِّ لَوۡ شِئۡتَ أَهۡلَكۡتَهُم مِّن قَبۡلُ وَإِيَّٰيَۖ أَتُهۡلِكُنَا بِمَا فَعَلَ ٱلسُّفَهَآءُ مِنَّآۖ إِنۡ هِيَ إِلَّا فِتۡنَتُكَ تُضِلُّ بِهَا مَن تَشَآءُ وَتَهۡدِي مَن تَشَآءُۖ أَنتَ وَلِيُّنَا فَٱغۡفِرۡ لَنَا وَٱرۡحَمۡنَاۖ وَأَنتَ خَيۡرُ ٱلۡغَٰفِرِينَ",
    "ayah_text_no_diacratic" : "واختار موسىٰ قومه سبعين رجلا لميقٰتنا فلما اخذتهم الرجفة قال رب لو شئت اهلكتهم من قبل وايٰي اتهلكنا بما فعل السفهاء منا ان هي الا فتنتك تضل بها من تشاء وتهدي من تشاء انت ولينا فاغفر لنا وارحمنا وانت خير الغٰفرين",
    "ayahnumber" : "155",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1122",
    "page" : "169",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1123",
    "ayah_text" : "۞وَٱكۡتُبۡ لَنَا فِي هَٰذِهِ ٱلدُّنۡيَا حَسَنَةٗ وَفِي ٱلۡأٓخِرَةِ إِنَّا هُدۡنَآ إِلَيۡكَۚ قَالَ عَذَابِيٓ أُصِيبُ بِهِۦ مَنۡ أَشَآءُۖ وَرَحۡمَتِي وَسِعَتۡ كُلَّ شَيۡءٖۚ فَسَأَكۡتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤۡتُونَ ٱلزَّكَوٰةَ وَٱلَّذِينَ هُم بِـَٔايَٰتِنَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "واكتب لنا في هٰذه الدنيا حسنة وفي الاخرة انا هدنا اليك قال عذابي اصيب به من اشاء ورحمتي وسعت كل شيء فساكتبها للذين يتقون ويؤتون الزكوٰة والذين هم بايٰتنا يؤمنون",
    "ayahnumber" : "156",
    "chapter" : "9",
    "hizb" : "17",
