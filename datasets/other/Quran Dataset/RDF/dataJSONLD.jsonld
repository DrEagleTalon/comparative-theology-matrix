    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2389",
    "ayah_text" : "إِلَّا تَذۡكِرَةٗ لِّمَن يَخۡشَىٰ",
    "ayah_text_no_diacratic" : "الا تذكرة لمن يخشىٰ",
    "ayahnumber" : "3",
