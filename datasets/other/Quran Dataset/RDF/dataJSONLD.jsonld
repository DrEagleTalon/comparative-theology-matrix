    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4716",
    "ayah_text" : "فَضۡلٗا مِّنَ ٱللَّهِ وَنِعۡمَةٗۚ وَٱللَّهُ عَلِيمٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "فضلا من الله ونعمة والله عليم حكيم",
    "ayahnumber" : "8",
    "chapter" : "26",
    "hizb" : "51",
