  }, {
    "@id" : "quran:6046",
    "ayah_text" : "فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ",
    "ayah_text_no_diacratic" : "فاليوم الذين ءامنوا من الكفار يضحكون",
