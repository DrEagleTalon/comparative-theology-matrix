    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3925",
    "ayah_text" : "طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ",
    "ayah_text_no_diacratic" : "طلعها كانه رءوس الشيٰطين",
