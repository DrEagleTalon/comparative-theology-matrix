    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:4037",
    "ayah_text" : "فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ",
