  }, {
    "@id" : "quran:3205",
    "ayah_text" : "يُلۡقُونَ ٱلسَّمۡعَ وَأَكۡثَرُهُمۡ كَٰذِبُونَ",
    "ayah_text_no_diacratic" : "يلقون السمع واكثرهم كٰذبون",
