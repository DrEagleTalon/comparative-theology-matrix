    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5346",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ إِذَا طَلَّقۡتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحۡصُواْ ٱلۡعِدَّةَۖ وَٱتَّقُواْ ٱللَّهَ رَبَّكُمۡۖ لَا تُخۡرِجُوهُنَّ مِنۢ بُيُوتِهِنَّ وَلَا يَخۡرُجۡنَ إِلَّآ أَن يَأۡتِينَ بِفَٰحِشَةٖ مُّبَيِّنَةٖۚ وَتِلۡكَ حُدُودُ ٱللَّهِۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَقَدۡ ظَلَمَ نَفۡسَهُۥۚ لَا تَدۡرِي لَعَلَّ ٱللَّهَ يُحۡدِثُ بَعۡدَ ذَٰلِكَ أَمۡرٗا",
    "ayah_text_no_diacratic" : "يٰايها النبي اذا طلقتم النساء فطلقوهن لعدتهن واحصوا العدة واتقوا الله ربكم لا تخرجوهن من بيوتهن ولا يخرجن الا ان ياتين بفٰحشة مبينة وتلك حدود الله ومن يتعد حدود الله فقد ظلم نفسه لا تدري لعل الله يحدث بعد ذٰلك امرا",
    "ayahnumber" : "1",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5346",
    "page" : "558",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5347",
    "ayah_text" : "فَإِذَا بَلَغۡنَ أَجَلَهُنَّ فَأَمۡسِكُوهُنَّ بِمَعۡرُوفٍ أَوۡ فَارِقُوهُنَّ بِمَعۡرُوفٖ وَأَشۡهِدُواْ ذَوَيۡ عَدۡلٖ مِّنكُمۡ وَأَقِيمُواْ ٱلشَّهَٰدَةَ لِلَّهِۚ ذَٰلِكُمۡ يُوعَظُ بِهِۦ مَن كَانَ يُؤۡمِنُ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۚ وَمَن يَتَّقِ ٱللَّهَ يَجۡعَل لَّهُۥ مَخۡرَجٗا",
    "ayah_text_no_diacratic" : "فاذا بلغن اجلهن فامسكوهن بمعروف او فارقوهن بمعروف واشهدوا ذوي عدل منكم واقيموا الشهٰدة لله ذٰلكم يوعظ به من كان يؤمن بالله واليوم الاخر ومن يتق الله يجعل له مخرجا",
    "ayahnumber" : "2",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5347",
    "page" : "558",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5348",
    "ayah_text" : "وَيَرۡزُقۡهُ مِنۡ حَيۡثُ لَا يَحۡتَسِبُۚ وَمَن يَتَوَكَّلۡ عَلَى ٱللَّهِ فَهُوَ حَسۡبُهُۥٓۚ إِنَّ ٱللَّهَ بَٰلِغُ أَمۡرِهِۦۚ قَدۡ جَعَلَ ٱللَّهُ لِكُلِّ شَيۡءٖ قَدۡرٗا",
    "ayah_text_no_diacratic" : "ويرزقه من حيث لا يحتسب ومن يتوكل على الله فهو حسبه ان الله بٰلغ امره قد جعل الله لكل شيء قدرا",
    "ayahnumber" : "3",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5348",
    "page" : "558",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5349",
    "ayah_text" : "وَٱلَّٰٓـِٔي يَئِسۡنَ مِنَ ٱلۡمَحِيضِ مِن نِّسَآئِكُمۡ إِنِ ٱرۡتَبۡتُمۡ فَعِدَّتُهُنَّ ثَلَٰثَةُ أَشۡهُرٖ وَٱلَّٰٓـِٔي لَمۡ يَحِضۡنَۚ وَأُوْلَٰتُ ٱلۡأَحۡمَالِ أَجَلُهُنَّ أَن يَضَعۡنَ حَمۡلَهُنَّۚ وَمَن يَتَّقِ ٱللَّهَ يَجۡعَل لَّهُۥ مِنۡ أَمۡرِهِۦ يُسۡرٗا",
    "ayah_text_no_diacratic" : "والٰي يئسن من المحيض من نسائكم ان ارتبتم فعدتهن ثلٰثة اشهر والٰي لم يحضن واولٰت الاحمال اجلهن ان يضعن حملهن ومن يتق الله يجعل له من امره يسرا",
    "ayahnumber" : "4",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5349",
    "page" : "558",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:535",
    "ayah_text" : "وَإِنۡ خِفۡتُمۡ شِقَاقَ بَيۡنِهِمَا فَٱبۡعَثُواْ حَكَمٗا مِّنۡ أَهۡلِهِۦ وَحَكَمٗا مِّنۡ أَهۡلِهَآ إِن يُرِيدَآ إِصۡلَٰحٗا يُوَفِّقِ ٱللَّهُ بَيۡنَهُمَآۗ إِنَّ ٱللَّهَ كَانَ عَلِيمًا خَبِيرٗا",
    "ayah_text_no_diacratic" : "وان خفتم شقاق بينهما فابعثوا حكما من اهله وحكما من اهلها ان يريدا اصلٰحا يوفق الله بينهما ان الله كان عليما خبيرا",
    "ayahnumber" : "35",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "535",
    "page" : "84",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5350",
    "ayah_text" : "ذَٰلِكَ أَمۡرُ ٱللَّهِ أَنزَلَهُۥٓ إِلَيۡكُمۡۚ وَمَن يَتَّقِ ٱللَّهَ يُكَفِّرۡ عَنۡهُ سَيِّـَٔاتِهِۦ وَيُعۡظِمۡ لَهُۥٓ أَجۡرًا",
    "ayah_text_no_diacratic" : "ذٰلك امر الله انزله اليكم ومن يتق الله يكفر عنه سياته ويعظم له اجرا",
    "ayahnumber" : "5",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5350",
    "page" : "558",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5351",
    "ayah_text" : "أَسۡكِنُوهُنَّ مِنۡ حَيۡثُ سَكَنتُم مِّن وُجۡدِكُمۡ وَلَا تُضَآرُّوهُنَّ لِتُضَيِّقُواْ عَلَيۡهِنَّۚ وَإِن كُنَّ أُوْلَٰتِ حَمۡلٖ فَأَنفِقُواْ عَلَيۡهِنَّ حَتَّىٰ يَضَعۡنَ حَمۡلَهُنَّۚ فَإِنۡ أَرۡضَعۡنَ لَكُمۡ فَـَٔاتُوهُنَّ أُجُورَهُنَّ وَأۡتَمِرُواْ بَيۡنَكُم بِمَعۡرُوفٖۖ وَإِن تَعَاسَرۡتُمۡ فَسَتُرۡضِعُ لَهُۥٓ أُخۡرَىٰ",
    "ayah_text_no_diacratic" : "اسكنوهن من حيث سكنتم من وجدكم ولا تضاروهن لتضيقوا عليهن وان كن اولٰت حمل فانفقوا عليهن حتىٰ يضعن حملهن فان ارضعن لكم فاتوهن اجورهن واتمروا بينكم بمعروف وان تعاسرتم فسترضع له اخرىٰ",
    "ayahnumber" : "6",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5351",
    "page" : "559",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5352",
    "ayah_text" : "لِيُنفِقۡ ذُو سَعَةٖ مِّن سَعَتِهِۦۖ وَمَن قُدِرَ عَلَيۡهِ رِزۡقُهُۥ فَلۡيُنفِقۡ مِمَّآ ءَاتَىٰهُ ٱللَّهُۚ لَا يُكَلِّفُ ٱللَّهُ نَفۡسًا إِلَّا مَآ ءَاتَىٰهَاۚ سَيَجۡعَلُ ٱللَّهُ بَعۡدَ عُسۡرٖ يُسۡرٗا",
    "ayah_text_no_diacratic" : "لينفق ذو سعة من سعته ومن قدر عليه رزقه فلينفق مما ءاتىٰه الله لا يكلف الله نفسا الا ما ءاتىٰها سيجعل الله بعد عسر يسرا",
    "ayahnumber" : "7",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5352",
    "page" : "559",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5353",
    "ayah_text" : "وَكَأَيِّن مِّن قَرۡيَةٍ عَتَتۡ عَنۡ أَمۡرِ رَبِّهَا وَرُسُلِهِۦ فَحَاسَبۡنَٰهَا حِسَابٗا شَدِيدٗا وَعَذَّبۡنَٰهَا عَذَابٗا نُّكۡرٗا",
    "ayah_text_no_diacratic" : "وكاين من قرية عتت عن امر ربها ورسله فحاسبنٰها حسابا شديدا وعذبنٰها عذابا نكرا",
    "ayahnumber" : "8",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5353",
    "page" : "559",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5354",
    "ayah_text" : "فَذَاقَتۡ وَبَالَ أَمۡرِهَا وَكَانَ عَٰقِبَةُ أَمۡرِهَا خُسۡرًا",
    "ayah_text_no_diacratic" : "فذاقت وبال امرها وكان عٰقبة امرها خسرا",
    "ayahnumber" : "9",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5354",
    "page" : "559",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5355",
    "ayah_text" : "أَعَدَّ ٱللَّهُ لَهُمۡ عَذَابٗا شَدِيدٗاۖ فَٱتَّقُواْ ٱللَّهَ يَٰٓأُوْلِي ٱلۡأَلۡبَٰبِ ٱلَّذِينَ ءَامَنُواْۚ قَدۡ أَنزَلَ ٱللَّهُ إِلَيۡكُمۡ ذِكۡرٗا",
    "ayah_text_no_diacratic" : "اعد الله لهم عذابا شديدا فاتقوا الله يٰاولي الالبٰب الذين ءامنوا قد انزل الله اليكم ذكرا",
    "ayahnumber" : "10",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5355",
    "page" : "559",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5356",
    "ayah_text" : "رَّسُولٗا يَتۡلُواْ عَلَيۡكُمۡ ءَايَٰتِ ٱللَّهِ مُبَيِّنَٰتٖ لِّيُخۡرِجَ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ مِنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۚ وَمَن يُؤۡمِنۢ بِٱللَّهِ وَيَعۡمَلۡ صَٰلِحٗا يُدۡخِلۡهُ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ قَدۡ أَحۡسَنَ ٱللَّهُ لَهُۥ رِزۡقًا",
    "ayah_text_no_diacratic" : "رسولا يتلوا عليكم ءايٰت الله مبينٰت ليخرج الذين ءامنوا وعملوا الصٰلحٰت من الظلمٰت الى النور ومن يؤمن بالله ويعمل صٰلحا يدخله جنٰت تجري من تحتها الانهٰر خٰلدين فيها ابدا قد احسن الله له رزقا",
    "ayahnumber" : "11",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5356",
    "page" : "559",
    "surahname" : "سُورَةُ الطَّلَاقِ",
    "surahnumber" : "65",
    "surrahname_no_diacratic" : "سورة الطلاق"
  }, {
    "@id" : "quran:5357",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي خَلَقَ سَبۡعَ سَمَٰوَٰتٖ وَمِنَ ٱلۡأَرۡضِ مِثۡلَهُنَّۖ يَتَنَزَّلُ ٱلۡأَمۡرُ بَيۡنَهُنَّ لِتَعۡلَمُوٓاْ أَنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ وَأَنَّ ٱللَّهَ قَدۡ أَحَاطَ بِكُلِّ شَيۡءٍ عِلۡمَۢا",
    "ayah_text_no_diacratic" : "الله الذي خلق سبع سمٰوٰت ومن الارض مثلهن يتنزل الامر بينهن لتعلموا ان الله علىٰ كل شيء قدير وان الله قد احاط بكل شيء علما",
    "ayahnumber" : "12",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5357",
    "page" : "559",
    "surahname" : "سُورَةُ الطَّلَاقِ",
