    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5438",
    "ayah_text" : "كَذَٰلِكَ ٱلۡعَذَابُۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَكۡبَرُۚ لَوۡ كَانُواْ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "كذٰلك العذاب ولعذاب الاخرة اكبر لو كانوا يعلمون",
