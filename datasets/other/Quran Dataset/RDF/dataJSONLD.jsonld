    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4112",
    "ayah_text" : "أَنتُمۡ عَنۡهُ مُعۡرِضُونَ",
    "ayah_text_no_diacratic" : "انتم عنه معرضون",
    "ayahnumber" : "68",
    "chapter" : "23",
    "hizb" : "45",
