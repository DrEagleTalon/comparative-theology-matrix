  }, {
    "@id" : "quran:1809",
    "ayah_text" : "وَسَخَّرَ لَكُمُ ٱلشَّمۡسَ وَٱلۡقَمَرَ دَآئِبَيۡنِۖ وَسَخَّرَ لَكُمُ ٱلَّيۡلَ وَٱلنَّهَارَ",
    "ayah_text_no_diacratic" : "وسخر لكم الشمس والقمر دائبين وسخر لكم اليل والنهار",
