  }, {
    "@id" : "quran:4830",
    "ayah_text" : "وَذَكِّرۡ فَإِنَّ ٱلذِّكۡرَىٰ تَنفَعُ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وذكر فان الذكرىٰ تنفع المؤمنين",
