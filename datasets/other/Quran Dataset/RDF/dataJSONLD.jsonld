    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5619",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5619",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:562",
    "ayah_text" : "فَكَيۡفَ إِذَآ أَصَٰبَتۡهُم مُّصِيبَةُۢ بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ ثُمَّ جَآءُوكَ يَحۡلِفُونَ بِٱللَّهِ إِنۡ أَرَدۡنَآ إِلَّآ إِحۡسَٰنٗا وَتَوۡفِيقًا",
    "ayah_text_no_diacratic" : "فكيف اذا اصٰبتهم مصيبة بما قدمت ايديهم ثم جاءوك يحلفون بالله ان اردنا الا احسٰنا وتوفيقا",
    "ayahnumber" : "62",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "562",
    "page" : "88",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5620",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلۡمُزَّمِّلُ",
    "ayah_text_no_diacratic" : "يٰايها المزمل",
    "ayahnumber" : "1",
