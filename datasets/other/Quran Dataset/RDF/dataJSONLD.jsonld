    "page" : "191",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1282",
    "ayah_text" : "ٱتَّخَذُوٓاْ أَحۡبَارَهُمۡ وَرُهۡبَٰنَهُمۡ أَرۡبَابٗا مِّن دُونِ ٱللَّهِ وَٱلۡمَسِيحَ ٱبۡنَ مَرۡيَمَ وَمَآ أُمِرُوٓاْ إِلَّا لِيَعۡبُدُوٓاْ إِلَٰهٗا وَٰحِدٗاۖ لَّآ إِلَٰهَ إِلَّا هُوَۚ سُبۡحَٰنَهُۥ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "اتخذوا احبارهم ورهبٰنهم اربابا من دون الله والمسيح ابن مريم وما امروا الا ليعبدوا الٰها وٰحدا لا الٰه الا هو سبحٰنه عما يشركون",
    "ayahnumber" : "31",
    "chapter" : "10",
    "hizb" : "19",
