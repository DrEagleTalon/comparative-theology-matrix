    "surrahname_no_diacratic" : "سورة الجمعة"
  }, {
    "@id" : "quran:5302",
    "ayah_text" : "وَءَاخَرِينَ مِنۡهُمۡ لَمَّا يَلۡحَقُواْ بِهِمۡۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "وءاخرين منهم لما يلحقوا بهم وهو العزيز الحكيم",
