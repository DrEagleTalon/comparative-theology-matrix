    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1761",
    "ayah_text" : "كَذَٰلِكَ أَرۡسَلۡنَٰكَ فِيٓ أُمَّةٖ قَدۡ خَلَتۡ مِن قَبۡلِهَآ أُمَمٞ لِّتَتۡلُوَاْ عَلَيۡهِمُ ٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ وَهُمۡ يَكۡفُرُونَ بِٱلرَّحۡمَٰنِۚ قُلۡ هُوَ رَبِّي لَآ إِلَٰهَ إِلَّا هُوَ عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ مَتَابِ",
    "ayah_text_no_diacratic" : "كذٰلك ارسلنٰك في امة قد خلت من قبلها امم لتتلوا عليهم الذي اوحينا اليك وهم يكفرون بالرحمٰن قل هو ربي لا الٰه الا هو عليه توكلت واليه متاب",
    "ayahnumber" : "30",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1761",
    "page" : "253",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1762",
    "ayah_text" : "وَلَوۡ أَنَّ قُرۡءَانٗا سُيِّرَتۡ بِهِ ٱلۡجِبَالُ أَوۡ قُطِّعَتۡ بِهِ ٱلۡأَرۡضُ أَوۡ كُلِّمَ بِهِ ٱلۡمَوۡتَىٰۗ بَل لِّلَّهِ ٱلۡأَمۡرُ جَمِيعًاۗ أَفَلَمۡ يَاْيۡـَٔسِ ٱلَّذِينَ ءَامَنُوٓاْ أَن لَّوۡ يَشَآءُ ٱللَّهُ لَهَدَى ٱلنَّاسَ جَمِيعٗاۗ وَلَا يَزَالُ ٱلَّذِينَ كَفَرُواْ تُصِيبُهُم بِمَا صَنَعُواْ قَارِعَةٌ أَوۡ تَحُلُّ قَرِيبٗا مِّن دَارِهِمۡ حَتَّىٰ يَأۡتِيَ وَعۡدُ ٱللَّهِۚ إِنَّ ٱللَّهَ لَا يُخۡلِفُ ٱلۡمِيعَادَ",
    "ayah_text_no_diacratic" : "ولو ان قرءانا سيرت به الجبال او قطعت به الارض او كلم به الموتىٰ بل لله الامر جميعا افلم يايس الذين ءامنوا ان لو يشاء الله لهدى الناس جميعا ولا يزال الذين كفروا تصيبهم بما صنعوا قارعة او تحل قريبا من دارهم حتىٰ ياتي وعد الله ان الله لا يخلف الميعاد",
    "ayahnumber" : "31",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1762",
    "page" : "253",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1763",
    "ayah_text" : "وَلَقَدِ ٱسۡتُهۡزِئَ بِرُسُلٖ مِّن قَبۡلِكَ فَأَمۡلَيۡتُ لِلَّذِينَ كَفَرُواْ ثُمَّ أَخَذۡتُهُمۡۖ فَكَيۡفَ كَانَ عِقَابِ",
    "ayah_text_no_diacratic" : "ولقد استهزئ برسل من قبلك فامليت للذين كفروا ثم اخذتهم فكيف كان عقاب",
    "ayahnumber" : "32",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1763",
    "page" : "253",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1764",
    "ayah_text" : "أَفَمَنۡ هُوَ قَآئِمٌ عَلَىٰ كُلِّ نَفۡسِۭ بِمَا كَسَبَتۡۗ وَجَعَلُواْ لِلَّهِ شُرَكَآءَ قُلۡ سَمُّوهُمۡۚ أَمۡ تُنَبِّـُٔونَهُۥ بِمَا لَا يَعۡلَمُ فِي ٱلۡأَرۡضِ أَم بِظَٰهِرٖ مِّنَ ٱلۡقَوۡلِۗ بَلۡ زُيِّنَ لِلَّذِينَ كَفَرُواْ مَكۡرُهُمۡ وَصُدُّواْ عَنِ ٱلسَّبِيلِۗ وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِنۡ هَادٖ",
    "ayah_text_no_diacratic" : "افمن هو قائم علىٰ كل نفس بما كسبت وجعلوا لله شركاء قل سموهم ام تنبونه بما لا يعلم في الارض ام بظٰهر من القول بل زين للذين كفروا مكرهم وصدوا عن السبيل ومن يضلل الله فما له من هاد",
    "ayahnumber" : "33",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1764",
    "page" : "253",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1765",
    "ayah_text" : "لَّهُمۡ عَذَابٞ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَشَقُّۖ وَمَا لَهُم مِّنَ ٱللَّهِ مِن وَاقٖ",
    "ayah_text_no_diacratic" : "لهم عذاب في الحيوٰة الدنيا ولعذاب الاخرة اشق وما لهم من الله من واق",
    "ayahnumber" : "34",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1765",
    "page" : "253",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1766",
    "ayah_text" : "۞مَّثَلُ ٱلۡجَنَّةِ ٱلَّتِي وُعِدَ ٱلۡمُتَّقُونَۖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ أُكُلُهَا دَآئِمٞ وَظِلُّهَاۚ تِلۡكَ عُقۡبَى ٱلَّذِينَ ٱتَّقَواْۚ وَّعُقۡبَى ٱلۡكَٰفِرِينَ ٱلنَّارُ",
    "ayah_text_no_diacratic" : "مثل الجنة التي وعد المتقون تجري من تحتها الانهٰر اكلها دائم وظلها تلك عقبى الذين اتقوا وعقبى الكٰفرين النار",
    "ayahnumber" : "35",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1766",
    "page" : "254",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1767",
    "ayah_text" : "وَٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَفۡرَحُونَ بِمَآ أُنزِلَ إِلَيۡكَۖ وَمِنَ ٱلۡأَحۡزَابِ مَن يُنكِرُ بَعۡضَهُۥۚ قُلۡ إِنَّمَآ أُمِرۡتُ أَنۡ أَعۡبُدَ ٱللَّهَ وَلَآ أُشۡرِكَ بِهِۦٓۚ إِلَيۡهِ أَدۡعُواْ وَإِلَيۡهِ مَـَٔابِ",
    "ayah_text_no_diacratic" : "والذين ءاتينٰهم الكتٰب يفرحون بما انزل اليك ومن الاحزاب من ينكر بعضه قل انما امرت ان اعبد الله ولا اشرك به اليه ادعوا واليه ماب",
    "ayahnumber" : "36",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1767",
