    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2175",
    "ayah_text" : "ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِيٓ أَنزَلَ عَلَىٰ عَبۡدِهِ ٱلۡكِتَٰبَ وَلَمۡ يَجۡعَل لَّهُۥ عِوَجَاۜ",
    "ayah_text_no_diacratic" : "الحمد لله الذي انزل علىٰ عبده الكتٰب ولم يجعل له عوجا",
    "ayahnumber" : "1",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2175",
    "page" : "293",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2176",
    "ayah_text" : "قَيِّمٗا لِّيُنذِرَ بَأۡسٗا شَدِيدٗا مِّن لَّدُنۡهُ وَيُبَشِّرَ ٱلۡمُؤۡمِنِينَ ٱلَّذِينَ يَعۡمَلُونَ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمۡ أَجۡرًا حَسَنٗا",
    "ayah_text_no_diacratic" : "قيما لينذر باسا شديدا من لدنه ويبشر المؤمنين الذين يعملون الصٰلحٰت ان لهم اجرا حسنا",
    "ayahnumber" : "2",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2176",
    "page" : "293",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2177",
    "ayah_text" : "مَّٰكِثِينَ فِيهِ أَبَدٗا",
    "ayah_text_no_diacratic" : "مٰكثين فيه ابدا",
    "ayahnumber" : "3",
    "chapter" : "15",
    "hizb" : "29",
