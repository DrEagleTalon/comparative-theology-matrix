    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:314",
    "ayah_text" : "ٱلَّذِينَ يَقُولُونَ رَبَّنَآ إِنَّنَآ ءَامَنَّا فَٱغۡفِرۡ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "الذين يقولون ربنا اننا ءامنا فاغفر لنا ذنوبنا وقنا عذاب النار",
    "ayahnumber" : "16",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "314",
    "page" : "52",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3140",
    "ayah_text" : "فَأَخَذَهُمُ ٱلۡعَذَابُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "فاخذهم العذاب ان في ذٰلك لاية وما كان اكثرهم مؤمنين",
