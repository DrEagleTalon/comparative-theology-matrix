  }, {
    "@id" : "quran:5233",
    "ayah_text" : "أَعَدَّ ٱللَّهُ لَهُمۡ عَذَابٗا شَدِيدًاۖ إِنَّهُمۡ سَآءَ مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "اعد الله لهم عذابا شديدا انهم ساء ما كانوا يعملون",
