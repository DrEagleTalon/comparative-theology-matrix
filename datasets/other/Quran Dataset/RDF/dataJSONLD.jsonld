  }, {
    "@id" : "quran:1710",
    "ayah_text" : "قَالَ لَا تَثۡرِيبَ عَلَيۡكُمُ ٱلۡيَوۡمَۖ يَغۡفِرُ ٱللَّهُ لَكُمۡۖ وَهُوَ أَرۡحَمُ ٱلرَّٰحِمِينَ",
    "ayah_text_no_diacratic" : "قال لا تثريب عليكم اليوم يغفر الله لكم وهو ارحم الرٰحمين",
    "ayahnumber" : "92",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1710",
    "page" : "246",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1711",
    "ayah_text" : "ٱذۡهَبُواْ بِقَمِيصِي هَٰذَا فَأَلۡقُوهُ عَلَىٰ وَجۡهِ أَبِي يَأۡتِ بَصِيرٗا وَأۡتُونِي بِأَهۡلِكُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "اذهبوا بقميصي هٰذا فالقوه علىٰ وجه ابي يات بصيرا واتوني باهلكم اجمعين",
    "ayahnumber" : "93",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1711",
    "page" : "246",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1712",
    "ayah_text" : "وَلَمَّا فَصَلَتِ ٱلۡعِيرُ قَالَ أَبُوهُمۡ إِنِّي لَأَجِدُ رِيحَ يُوسُفَۖ لَوۡلَآ أَن تُفَنِّدُونِ",
    "ayah_text_no_diacratic" : "ولما فصلت العير قال ابوهم اني لاجد ريح يوسف لولا ان تفندون",
    "ayahnumber" : "94",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1712",
    "page" : "246",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1713",
    "ayah_text" : "قَالُواْ تَٱللَّهِ إِنَّكَ لَفِي ضَلَٰلِكَ ٱلۡقَدِيمِ",
    "ayah_text_no_diacratic" : "قالوا تالله انك لفي ضلٰلك القديم",
    "ayahnumber" : "95",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1713",
    "page" : "246",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1714",
    "ayah_text" : "فَلَمَّآ أَن جَآءَ ٱلۡبَشِيرُ أَلۡقَىٰهُ عَلَىٰ وَجۡهِهِۦ فَٱرۡتَدَّ بَصِيرٗاۖ قَالَ أَلَمۡ أَقُل لَّكُمۡ إِنِّيٓ أَعۡلَمُ مِنَ ٱللَّهِ مَا لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فلما ان جاء البشير القىٰه علىٰ وجهه فارتد بصيرا قال الم اقل لكم اني اعلم من الله ما لا تعلمون",
    "ayahnumber" : "96",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1714",
    "page" : "247",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1715",
    "ayah_text" : "قَالُواْ يَٰٓأَبَانَا ٱسۡتَغۡفِرۡ لَنَا ذُنُوبَنَآ إِنَّا كُنَّا خَٰطِـِٔينَ",
    "ayah_text_no_diacratic" : "قالوا يٰابانا استغفر لنا ذنوبنا انا كنا خٰطين",
    "ayahnumber" : "97",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1715",
    "page" : "247",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1716",
    "ayah_text" : "قَالَ سَوۡفَ أَسۡتَغۡفِرُ لَكُمۡ رَبِّيٓۖ إِنَّهُۥ هُوَ ٱلۡغَفُورُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "قال سوف استغفر لكم ربي انه هو الغفور الرحيم",
    "ayahnumber" : "98",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1716",
    "page" : "247",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1717",
    "ayah_text" : "فَلَمَّا دَخَلُواْ عَلَىٰ يُوسُفَ ءَاوَىٰٓ إِلَيۡهِ أَبَوَيۡهِ وَقَالَ ٱدۡخُلُواْ مِصۡرَ إِن شَآءَ ٱللَّهُ ءَامِنِينَ",
    "ayah_text_no_diacratic" : "فلما دخلوا علىٰ يوسف ءاوىٰ اليه ابويه وقال ادخلوا مصر ان شاء الله ءامنين",
    "ayahnumber" : "99",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1717",
    "page" : "247",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1718",
    "ayah_text" : "وَرَفَعَ أَبَوَيۡهِ عَلَى ٱلۡعَرۡشِ وَخَرُّواْ لَهُۥ سُجَّدٗاۖ وَقَالَ يَٰٓأَبَتِ هَٰذَا تَأۡوِيلُ رُءۡيَٰيَ مِن قَبۡلُ قَدۡ جَعَلَهَا رَبِّي حَقّٗاۖ وَقَدۡ أَحۡسَنَ بِيٓ إِذۡ أَخۡرَجَنِي مِنَ ٱلسِّجۡنِ وَجَآءَ بِكُم مِّنَ ٱلۡبَدۡوِ مِنۢ بَعۡدِ أَن نَّزَغَ ٱلشَّيۡطَٰنُ بَيۡنِي وَبَيۡنَ إِخۡوَتِيٓۚ إِنَّ رَبِّي لَطِيفٞ لِّمَا يَشَآءُۚ إِنَّهُۥ هُوَ ٱلۡعَلِيمُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "ورفع ابويه على العرش وخروا له سجدا وقال يٰابت هٰذا تاويل رءيٰي من قبل قد جعلها ربي حقا وقد احسن بي اذ اخرجني من السجن وجاء بكم من البدو من بعد ان نزغ الشيطٰن بيني وبين اخوتي ان ربي لطيف لما يشاء انه هو العليم الحكيم",
    "ayahnumber" : "100",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1718",
    "page" : "247",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1719",
    "ayah_text" : "۞رَبِّ قَدۡ ءَاتَيۡتَنِي مِنَ ٱلۡمُلۡكِ وَعَلَّمۡتَنِي مِن تَأۡوِيلِ ٱلۡأَحَادِيثِۚ فَاطِرَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ أَنتَ وَلِيِّۦ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۖ تَوَفَّنِي مُسۡلِمٗا وَأَلۡحِقۡنِي بِٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "رب قد ءاتيتني من الملك وعلمتني من تاويل الاحاديث فاطر السمٰوٰت والارض انت ولي في الدنيا والاخرة توفني مسلما والحقني بالصٰلحين",
    "ayahnumber" : "101",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1719",
    "page" : "247",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:172",
    "ayah_text" : "خَٰلِدِينَ فِيهَا لَا يُخَفَّفُ عَنۡهُمُ ٱلۡعَذَابُ وَلَا هُمۡ يُنظَرُونَ",
    "ayah_text_no_diacratic" : "خٰلدين فيها لا يخفف عنهم العذاب ولا هم ينظرون",
    "ayahnumber" : "162",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "172",
    "page" : "24",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1720",
    "ayah_text" : "ذَٰلِكَ مِنۡ أَنۢبَآءِ ٱلۡغَيۡبِ نُوحِيهِ إِلَيۡكَۖ وَمَا كُنتَ لَدَيۡهِمۡ إِذۡ أَجۡمَعُوٓاْ أَمۡرَهُمۡ وَهُمۡ يَمۡكُرُونَ",
    "ayah_text_no_diacratic" : "ذٰلك من انباء الغيب نوحيه اليك وما كنت لديهم اذ اجمعوا امرهم وهم يمكرون",
    "ayahnumber" : "102",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1720",
    "page" : "247",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1721",
    "ayah_text" : "وَمَآ أَكۡثَرُ ٱلنَّاسِ وَلَوۡ حَرَصۡتَ بِمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وما اكثر الناس ولو حرصت بمؤمنين",
    "ayahnumber" : "103",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1721",
    "page" : "247",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1722",
    "ayah_text" : "وَمَا تَسۡـَٔلُهُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۚ إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "وما تسلهم عليه من اجر ان هو الا ذكر للعٰلمين",
    "ayahnumber" : "104",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1722",
    "page" : "248",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1723",
    "ayah_text" : "وَكَأَيِّن مِّنۡ ءَايَةٖ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ يَمُرُّونَ عَلَيۡهَا وَهُمۡ عَنۡهَا مُعۡرِضُونَ",
    "ayah_text_no_diacratic" : "وكاين من ءاية في السمٰوٰت والارض يمرون عليها وهم عنها معرضون",
    "ayahnumber" : "105",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1723",
    "page" : "248",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1724",
    "ayah_text" : "وَمَا يُؤۡمِنُ أَكۡثَرُهُم بِٱللَّهِ إِلَّا وَهُم مُّشۡرِكُونَ",
    "ayah_text_no_diacratic" : "وما يؤمن اكثرهم بالله الا وهم مشركون",
    "ayahnumber" : "106",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1724",
    "page" : "248",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1725",
    "ayah_text" : "أَفَأَمِنُوٓاْ أَن تَأۡتِيَهُمۡ غَٰشِيَةٞ مِّنۡ عَذَابِ ٱللَّهِ أَوۡ تَأۡتِيَهُمُ ٱلسَّاعَةُ بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "افامنوا ان تاتيهم غٰشية من عذاب الله او تاتيهم الساعة بغتة وهم لا يشعرون",
    "ayahnumber" : "107",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1725",
    "page" : "248",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1726",
    "ayah_text" : "قُلۡ هَٰذِهِۦ سَبِيلِيٓ أَدۡعُوٓاْ إِلَى ٱللَّهِۚ عَلَىٰ بَصِيرَةٍ أَنَا۠ وَمَنِ ٱتَّبَعَنِيۖ وَسُبۡحَٰنَ ٱللَّهِ وَمَآ أَنَا۠ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "قل هٰذه سبيلي ادعوا الى الله علىٰ بصيرة انا ومن اتبعني وسبحٰن الله وما انا من المشركين",
    "ayahnumber" : "108",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1726",
    "page" : "248",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1727",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَا مِن قَبۡلِكَ إِلَّا رِجَالٗا نُّوحِيٓ إِلَيۡهِم مِّنۡ أَهۡلِ ٱلۡقُرَىٰٓۗ أَفَلَمۡ يَسِيرُواْ فِي ٱلۡأَرۡضِ فَيَنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبۡلِهِمۡۗ وَلَدَارُ ٱلۡأٓخِرَةِ خَيۡرٞ لِّلَّذِينَ ٱتَّقَوۡاْۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "وما ارسلنا من قبلك الا رجالا نوحي اليهم من اهل القرىٰ افلم يسيروا في الارض فينظروا كيف كان عٰقبة الذين من قبلهم ولدار الاخرة خير للذين اتقوا افلا تعقلون",
    "ayahnumber" : "109",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1727",
    "page" : "248",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1728",
    "ayah_text" : "حَتَّىٰٓ إِذَا ٱسۡتَيۡـَٔسَ ٱلرُّسُلُ وَظَنُّوٓاْ أَنَّهُمۡ قَدۡ كُذِبُواْ جَآءَهُمۡ نَصۡرُنَا فَنُجِّيَ مَن نَّشَآءُۖ وَلَا يُرَدُّ بَأۡسُنَا عَنِ ٱلۡقَوۡمِ ٱلۡمُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "حتىٰ اذا استيس الرسل وظنوا انهم قد كذبوا جاءهم نصرنا فنجي من نشاء ولا يرد باسنا عن القوم المجرمين",
    "ayahnumber" : "110",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1728",
    "page" : "248",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1729",
    "ayah_text" : "لَقَدۡ كَانَ فِي قَصَصِهِمۡ عِبۡرَةٞ لِّأُوْلِي ٱلۡأَلۡبَٰبِۗ مَا كَانَ حَدِيثٗا يُفۡتَرَىٰ وَلَٰكِن تَصۡدِيقَ ٱلَّذِي بَيۡنَ يَدَيۡهِ وَتَفۡصِيلَ كُلِّ شَيۡءٖ وَهُدٗى وَرَحۡمَةٗ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "لقد كان في قصصهم عبرة لاولي الالبٰب ما كان حديثا يفترىٰ ولٰكن تصديق الذي بين يديه وتفصيل كل شيء وهدى ورحمة لقوم يؤمنون",
    "ayahnumber" : "111",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1729",
    "page" : "248",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:173",
    "ayah_text" : "وَإِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۖ لَّآ إِلَٰهَ إِلَّا هُوَ ٱلرَّحۡمَٰنُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "والٰهكم الٰه وٰحد لا الٰه الا هو الرحمٰن الرحيم",
