  }, {
    "@id" : "quran:1273",
    "ayah_text" : "خَٰلِدِينَ فِيهَآ أَبَدًاۚ إِنَّ ٱللَّهَ عِندَهُۥٓ أَجۡرٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "خٰلدين فيها ابدا ان الله عنده اجر عظيم",
