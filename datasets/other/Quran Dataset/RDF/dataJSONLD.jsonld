    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5254",
    "ayah_text" : "لَئِنۡ أُخۡرِجُواْ لَا يَخۡرُجُونَ مَعَهُمۡ وَلَئِن قُوتِلُواْ لَا يَنصُرُونَهُمۡ وَلَئِن نَّصَرُوهُمۡ لَيُوَلُّنَّ ٱلۡأَدۡبَٰرَ ثُمَّ لَا يُنصَرُونَ",
    "ayah_text_no_diacratic" : "لئن اخرجوا لا يخرجون معهم ولئن قوتلوا لا ينصرونهم ولئن نصروهم ليولن الادبٰر ثم لا ينصرون",
    "ayahnumber" : "12",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5254",
    "page" : "547",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5255",
    "ayah_text" : "لَأَنتُمۡ أَشَدُّ رَهۡبَةٗ فِي صُدُورِهِم مِّنَ ٱللَّهِۚ ذَٰلِكَ بِأَنَّهُمۡ قَوۡمٞ لَّا يَفۡقَهُونَ",
    "ayah_text_no_diacratic" : "لانتم اشد رهبة في صدورهم من الله ذٰلك بانهم قوم لا يفقهون",
    "ayahnumber" : "13",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5255",
    "page" : "547",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5256",
    "ayah_text" : "لَا يُقَٰتِلُونَكُمۡ جَمِيعًا إِلَّا فِي قُرٗى مُّحَصَّنَةٍ أَوۡ مِن وَرَآءِ جُدُرِۭۚ بَأۡسُهُم بَيۡنَهُمۡ شَدِيدٞۚ تَحۡسَبُهُمۡ جَمِيعٗا وَقُلُوبُهُمۡ شَتَّىٰۚ ذَٰلِكَ بِأَنَّهُمۡ قَوۡمٞ لَّا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "لا يقٰتلونكم جميعا الا في قرى محصنة او من وراء جدر باسهم بينهم شديد تحسبهم جميعا وقلوبهم شتىٰ ذٰلك بانهم قوم لا يعقلون",
    "ayahnumber" : "14",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5256",
    "page" : "547",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5257",
    "ayah_text" : "كَمَثَلِ ٱلَّذِينَ مِن قَبۡلِهِمۡ قَرِيبٗاۖ ذَاقُواْ وَبَالَ أَمۡرِهِمۡ وَلَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "كمثل الذين من قبلهم قريبا ذاقوا وبال امرهم ولهم عذاب اليم",
    "ayahnumber" : "15",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5257",
    "page" : "547",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5258",
    "ayah_text" : "كَمَثَلِ ٱلشَّيۡطَٰنِ إِذۡ قَالَ لِلۡإِنسَٰنِ ٱكۡفُرۡ فَلَمَّا كَفَرَ قَالَ إِنِّي بَرِيٓءٞ مِّنكَ إِنِّيٓ أَخَافُ ٱللَّهَ رَبَّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "كمثل الشيطٰن اذ قال للانسٰن اكفر فلما كفر قال اني بريء منك اني اخاف الله رب العٰلمين",
    "ayahnumber" : "16",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5258",
    "page" : "547",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5259",
    "ayah_text" : "فَكَانَ عَٰقِبَتَهُمَآ أَنَّهُمَا فِي ٱلنَّارِ خَٰلِدَيۡنِ فِيهَاۚ وَذَٰلِكَ جَزَٰٓؤُاْ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "فكان عٰقبتهما انهما في النار خٰلدين فيها وذٰلك جزٰؤا الظٰلمين",
    "ayahnumber" : "17",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5259",
    "page" : "548",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:526",
    "ayah_text" : "يُرِيدُ ٱللَّهُ لِيُبَيِّنَ لَكُمۡ وَيَهۡدِيَكُمۡ سُنَنَ ٱلَّذِينَ مِن قَبۡلِكُمۡ وَيَتُوبَ عَلَيۡكُمۡۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "يريد الله ليبين لكم ويهديكم سنن الذين من قبلكم ويتوب عليكم والله عليم حكيم",
    "ayahnumber" : "26",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "526",
    "page" : "82",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5260",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ وَلۡتَنظُرۡ نَفۡسٞ مَّا قَدَّمَتۡ لِغَدٖۖ وَٱتَّقُواْ ٱللَّهَۚ إِنَّ ٱللَّهَ خَبِيرُۢ بِمَا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اتقوا الله ولتنظر نفس ما قدمت لغد واتقوا الله ان الله خبير بما تعملون",
    "ayahnumber" : "18",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5260",
    "page" : "548",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5261",
    "ayah_text" : "وَلَا تَكُونُواْ كَٱلَّذِينَ نَسُواْ ٱللَّهَ فَأَنسَىٰهُمۡ أَنفُسَهُمۡۚ أُوْلَٰٓئِكَ هُمُ ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "ولا تكونوا كالذين نسوا الله فانسىٰهم انفسهم اولٰئك هم الفٰسقون",
    "ayahnumber" : "19",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5261",
    "page" : "548",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5262",
    "ayah_text" : "لَا يَسۡتَوِيٓ أَصۡحَٰبُ ٱلنَّارِ وَأَصۡحَٰبُ ٱلۡجَنَّةِۚ أَصۡحَٰبُ ٱلۡجَنَّةِ هُمُ ٱلۡفَآئِزُونَ",
    "ayah_text_no_diacratic" : "لا يستوي اصحٰب النار واصحٰب الجنة اصحٰب الجنة هم الفائزون",
    "ayahnumber" : "20",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5262",
    "page" : "548",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5263",
    "ayah_text" : "لَوۡ أَنزَلۡنَا هَٰذَا ٱلۡقُرۡءَانَ عَلَىٰ جَبَلٖ لَّرَأَيۡتَهُۥ خَٰشِعٗا مُّتَصَدِّعٗا مِّنۡ خَشۡيَةِ ٱللَّهِۚ وَتِلۡكَ ٱلۡأَمۡثَٰلُ نَضۡرِبُهَا لِلنَّاسِ لَعَلَّهُمۡ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "لو انزلنا هٰذا القرءان علىٰ جبل لرايته خٰشعا متصدعا من خشية الله وتلك الامثٰل نضربها للناس لعلهم يتفكرون",
    "ayahnumber" : "21",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5263",
    "page" : "548",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5264",
    "ayah_text" : "هُوَ ٱللَّهُ ٱلَّذِي لَآ إِلَٰهَ إِلَّا هُوَۖ عَٰلِمُ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِۖ هُوَ ٱلرَّحۡمَٰنُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "هو الله الذي لا الٰه الا هو عٰلم الغيب والشهٰدة هو الرحمٰن الرحيم",
    "ayahnumber" : "22",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5264",
    "page" : "548",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5265",
    "ayah_text" : "هُوَ ٱللَّهُ ٱلَّذِي لَآ إِلَٰهَ إِلَّا هُوَ ٱلۡمَلِكُ ٱلۡقُدُّوسُ ٱلسَّلَٰمُ ٱلۡمُؤۡمِنُ ٱلۡمُهَيۡمِنُ ٱلۡعَزِيزُ ٱلۡجَبَّارُ ٱلۡمُتَكَبِّرُۚ سُبۡحَٰنَ ٱللَّهِ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "هو الله الذي لا الٰه الا هو الملك القدوس السلٰم المؤمن المهيمن العزيز الجبار المتكبر سبحٰن الله عما يشركون",
    "ayahnumber" : "23",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5265",
    "page" : "548",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5266",
    "ayah_text" : "هُوَ ٱللَّهُ ٱلۡخَٰلِقُ ٱلۡبَارِئُ ٱلۡمُصَوِّرُۖ لَهُ ٱلۡأَسۡمَآءُ ٱلۡحُسۡنَىٰۚ يُسَبِّحُ لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "هو الله الخٰلق البارئ المصور له الاسماء الحسنىٰ يسبح له ما في السمٰوٰت والارض وهو العزيز الحكيم",
    "ayahnumber" : "24",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5266",
    "page" : "548",
    "surahname" : "سُورَةُ الحَشۡرِ",
