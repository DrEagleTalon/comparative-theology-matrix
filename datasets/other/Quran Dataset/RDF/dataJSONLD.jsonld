    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4818",
    "ayah_text" : "وَفِي ثَمُودَ إِذۡ قِيلَ لَهُمۡ تَمَتَّعُواْ حَتَّىٰ حِينٖ",
    "ayah_text_no_diacratic" : "وفي ثمود اذ قيل لهم تمتعوا حتىٰ حين",
    "ayahnumber" : "43",
