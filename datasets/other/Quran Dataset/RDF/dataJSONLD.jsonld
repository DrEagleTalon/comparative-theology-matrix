    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2249",
    "ayah_text" : "۞قَالَ أَلَمۡ أَقُل لَّكَ إِنَّكَ لَن تَسۡتَطِيعَ مَعِيَ صَبۡرٗا",
    "ayah_text_no_diacratic" : "قال الم اقل لك انك لن تستطيع معي صبرا",
