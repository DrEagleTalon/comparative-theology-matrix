    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1927",
    "ayah_text" : "وَلَقَدۡ نَعۡلَمُ أَنَّكَ يَضِيقُ صَدۡرُكَ بِمَا يَقُولُونَ",
    "ayah_text_no_diacratic" : "ولقد نعلم انك يضيق صدرك بما يقولون",
    "ayahnumber" : "97",
    "chapter" : "14",
