    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:6330",
    "ayah_text" : "جَزَآؤُهُمۡ عِندَ رَبِّهِمۡ جَنَّٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ رَّضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُۚ ذَٰلِكَ لِمَنۡ خَشِيَ رَبَّهُۥ",
    "ayah_text_no_diacratic" : "جزاؤهم عند ربهم جنٰت عدن تجري من تحتها الانهٰر خٰلدين فيها ابدا رضي الله عنهم ورضوا عنه ذٰلك لمن خشي ربه",
    "ayahnumber" : "8",
    "chapter" : "30",
    "hizb" : "59",
