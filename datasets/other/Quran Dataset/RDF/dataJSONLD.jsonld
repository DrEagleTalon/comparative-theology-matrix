  }, {
    "@id" : "quran:4979",
    "ayah_text" : "إِنَّا مُرۡسِلُواْ ٱلنَّاقَةِ فِتۡنَةٗ لَّهُمۡ فَٱرۡتَقِبۡهُمۡ وَٱصۡطَبِرۡ",
    "ayah_text_no_diacratic" : "انا مرسلوا الناقة فتنة لهم فارتقبهم واصطبر",
