  }, {
    "@id" : "quran:2394",
    "ayah_text" : "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ لَهُ ٱلۡأَسۡمَآءُ ٱلۡحُسۡنَىٰ",
    "ayah_text_no_diacratic" : "الله لا الٰه الا هو له الاسماء الحسنىٰ",
