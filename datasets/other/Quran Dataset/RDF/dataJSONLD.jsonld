  }, {
    "@id" : "quran:5742",
    "ayah_text" : "هَلۡ أَتَىٰ عَلَى ٱلۡإِنسَٰنِ حِينٞ مِّنَ ٱلدَّهۡرِ لَمۡ يَكُن شَيۡـٔٗا مَّذۡكُورًا",
    "ayah_text_no_diacratic" : "هل اتىٰ على الانسٰن حين من الدهر لم يكن شيا مذكورا",
    "ayahnumber" : "1",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5742",
    "page" : "578",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5743",
    "ayah_text" : "إِنَّا خَلَقۡنَا ٱلۡإِنسَٰنَ مِن نُّطۡفَةٍ أَمۡشَاجٖ نَّبۡتَلِيهِ فَجَعَلۡنَٰهُ سَمِيعَۢا بَصِيرًا",
    "ayah_text_no_diacratic" : "انا خلقنا الانسٰن من نطفة امشاج نبتليه فجعلنٰه سميعا بصيرا",
    "ayahnumber" : "2",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5743",
    "page" : "578",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5744",
    "ayah_text" : "إِنَّا هَدَيۡنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرٗا وَإِمَّا كَفُورًا",
    "ayah_text_no_diacratic" : "انا هدينٰه السبيل اما شاكرا واما كفورا",
    "ayahnumber" : "3",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5744",
    "page" : "578",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5745",
    "ayah_text" : "إِنَّآ أَعۡتَدۡنَا لِلۡكَٰفِرِينَ سَلَٰسِلَاْ وَأَغۡلَٰلٗا وَسَعِيرًا",
    "ayah_text_no_diacratic" : "انا اعتدنا للكٰفرين سلٰسلا واغلٰلا وسعيرا",
    "ayahnumber" : "4",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5745",
    "page" : "578",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5746",
    "ayah_text" : "إِنَّ ٱلۡأَبۡرَارَ يَشۡرَبُونَ مِن كَأۡسٖ كَانَ مِزَاجُهَا كَافُورًا",
    "ayah_text_no_diacratic" : "ان الابرار يشربون من كاس كان مزاجها كافورا",
    "ayahnumber" : "5",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5746",
    "page" : "578",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5747",
    "ayah_text" : "عَيۡنٗا يَشۡرَبُ بِهَا عِبَادُ ٱللَّهِ يُفَجِّرُونَهَا تَفۡجِيرٗا",
    "ayah_text_no_diacratic" : "عينا يشرب بها عباد الله يفجرونها تفجيرا",
    "ayahnumber" : "6",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5747",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5748",
    "ayah_text" : "يُوفُونَ بِٱلنَّذۡرِ وَيَخَافُونَ يَوۡمٗا كَانَ شَرُّهُۥ مُسۡتَطِيرٗا",
    "ayah_text_no_diacratic" : "يوفون بالنذر ويخافون يوما كان شره مستطيرا",
    "ayahnumber" : "7",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5748",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5749",
    "ayah_text" : "وَيُطۡعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسۡكِينٗا وَيَتِيمٗا وَأَسِيرًا",
    "ayah_text_no_diacratic" : "ويطعمون الطعام علىٰ حبه مسكينا ويتيما واسيرا",
    "ayahnumber" : "8",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5749",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:575",
    "ayah_text" : "وَمَا لَكُمۡ لَا تُقَٰتِلُونَ فِي سَبِيلِ ٱللَّهِ وَٱلۡمُسۡتَضۡعَفِينَ مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ وَٱلۡوِلۡدَٰنِ ٱلَّذِينَ يَقُولُونَ رَبَّنَآ أَخۡرِجۡنَا مِنۡ هَٰذِهِ ٱلۡقَرۡيَةِ ٱلظَّالِمِ أَهۡلُهَا وَٱجۡعَل لَّنَا مِن لَّدُنكَ وَلِيّٗا وَٱجۡعَل لَّنَا مِن لَّدُنكَ نَصِيرًا",
    "ayah_text_no_diacratic" : "وما لكم لا تقٰتلون في سبيل الله والمستضعفين من الرجال والنساء والولدٰن الذين يقولون ربنا اخرجنا من هٰذه القرية الظالم اهلها واجعل لنا من لدنك وليا واجعل لنا من لدنك نصيرا",
    "ayahnumber" : "75",
    "chapter" : "5",
    "hizb" : "9",
    "index" : "575",
    "page" : "90",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5750",
    "ayah_text" : "إِنَّمَا نُطۡعِمُكُمۡ لِوَجۡهِ ٱللَّهِ لَا نُرِيدُ مِنكُمۡ جَزَآءٗ وَلَا شُكُورًا",
    "ayah_text_no_diacratic" : "انما نطعمكم لوجه الله لا نريد منكم جزاء ولا شكورا",
    "ayahnumber" : "9",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5750",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5751",
    "ayah_text" : "إِنَّا نَخَافُ مِن رَّبِّنَا يَوۡمًا عَبُوسٗا قَمۡطَرِيرٗا",
    "ayah_text_no_diacratic" : "انا نخاف من ربنا يوما عبوسا قمطريرا",
    "ayahnumber" : "10",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5751",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5752",
    "ayah_text" : "فَوَقَىٰهُمُ ٱللَّهُ شَرَّ ذَٰلِكَ ٱلۡيَوۡمِ وَلَقَّىٰهُمۡ نَضۡرَةٗ وَسُرُورٗا",
    "ayah_text_no_diacratic" : "فوقىٰهم الله شر ذٰلك اليوم ولقىٰهم نضرة وسرورا",
    "ayahnumber" : "11",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5752",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5753",
    "ayah_text" : "وَجَزَىٰهُم بِمَا صَبَرُواْ جَنَّةٗ وَحَرِيرٗا",
    "ayah_text_no_diacratic" : "وجزىٰهم بما صبروا جنة وحريرا",
    "ayahnumber" : "12",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5753",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5754",
    "ayah_text" : "مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلۡأَرَآئِكِۖ لَا يَرَوۡنَ فِيهَا شَمۡسٗا وَلَا زَمۡهَرِيرٗا",
    "ayah_text_no_diacratic" : "متكين فيها على الارائك لا يرون فيها شمسا ولا زمهريرا",
    "ayahnumber" : "13",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5754",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5755",
    "ayah_text" : "وَدَانِيَةً عَلَيۡهِمۡ ظِلَٰلُهَا وَذُلِّلَتۡ قُطُوفُهَا تَذۡلِيلٗا",
    "ayah_text_no_diacratic" : "ودانية عليهم ظلٰلها وذللت قطوفها تذليلا",
    "ayahnumber" : "14",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5755",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5756",
    "ayah_text" : "وَيُطَافُ عَلَيۡهِم بِـَٔانِيَةٖ مِّن فِضَّةٖ وَأَكۡوَابٖ كَانَتۡ قَوَارِيرَا۠",
    "ayah_text_no_diacratic" : "ويطاف عليهم بانية من فضة واكواب كانت قواريرا",
    "ayahnumber" : "15",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5756",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5757",
    "ayah_text" : "قَوَارِيرَاْ مِن فِضَّةٖ قَدَّرُوهَا تَقۡدِيرٗا",
    "ayah_text_no_diacratic" : "قواريرا من فضة قدروها تقديرا",
    "ayahnumber" : "16",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5757",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5758",
    "ayah_text" : "وَيُسۡقَوۡنَ فِيهَا كَأۡسٗا كَانَ مِزَاجُهَا زَنجَبِيلًا",
    "ayah_text_no_diacratic" : "ويسقون فيها كاسا كان مزاجها زنجبيلا",
    "ayahnumber" : "17",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5758",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5759",
    "ayah_text" : "عَيۡنٗا فِيهَا تُسَمَّىٰ سَلۡسَبِيلٗا",
    "ayah_text_no_diacratic" : "عينا فيها تسمىٰ سلسبيلا",
    "ayahnumber" : "18",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5759",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:576",
    "ayah_text" : "ٱلَّذِينَ ءَامَنُواْ يُقَٰتِلُونَ فِي سَبِيلِ ٱللَّهِۖ وَٱلَّذِينَ كَفَرُواْ يُقَٰتِلُونَ فِي سَبِيلِ ٱلطَّٰغُوتِ فَقَٰتِلُوٓاْ أَوۡلِيَآءَ ٱلشَّيۡطَٰنِۖ إِنَّ كَيۡدَ ٱلشَّيۡطَٰنِ كَانَ ضَعِيفًا",
    "ayah_text_no_diacratic" : "الذين ءامنوا يقٰتلون في سبيل الله والذين كفروا يقٰتلون في سبيل الطٰغوت فقٰتلوا اولياء الشيطٰن ان كيد الشيطٰن كان ضعيفا",
    "ayahnumber" : "76",
    "chapter" : "5",
    "hizb" : "9",
    "index" : "576",
    "page" : "90",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5760",
    "ayah_text" : "۞وَيَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ إِذَا رَأَيۡتَهُمۡ حَسِبۡتَهُمۡ لُؤۡلُؤٗا مَّنثُورٗا",
    "ayah_text_no_diacratic" : "ويطوف عليهم ولدٰن مخلدون اذا رايتهم حسبتهم لؤلؤا منثورا",
    "ayahnumber" : "19",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5760",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5761",
    "ayah_text" : "وَإِذَا رَأَيۡتَ ثَمَّ رَأَيۡتَ نَعِيمٗا وَمُلۡكٗا كَبِيرًا",
    "ayah_text_no_diacratic" : "واذا رايت ثم رايت نعيما وملكا كبيرا",
    "ayahnumber" : "20",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5761",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5762",
    "ayah_text" : "عَٰلِيَهُمۡ ثِيَابُ سُندُسٍ خُضۡرٞ وَإِسۡتَبۡرَقٞۖ وَحُلُّوٓاْ أَسَاوِرَ مِن فِضَّةٖ وَسَقَىٰهُمۡ رَبُّهُمۡ شَرَابٗا طَهُورًا",
    "ayah_text_no_diacratic" : "عٰليهم ثياب سندس خضر واستبرق وحلوا اساور من فضة وسقىٰهم ربهم شرابا طهورا",
    "ayahnumber" : "21",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5762",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5763",
    "ayah_text" : "إِنَّ هَٰذَا كَانَ لَكُمۡ جَزَآءٗ وَكَانَ سَعۡيُكُم مَّشۡكُورًا",
    "ayah_text_no_diacratic" : "ان هٰذا كان لكم جزاء وكان سعيكم مشكورا",
    "ayahnumber" : "22",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5763",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5764",
    "ayah_text" : "إِنَّا نَحۡنُ نَزَّلۡنَا عَلَيۡكَ ٱلۡقُرۡءَانَ تَنزِيلٗا",
    "ayah_text_no_diacratic" : "انا نحن نزلنا عليك القرءان تنزيلا",
    "ayahnumber" : "23",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5764",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5765",
    "ayah_text" : "فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تُطِعۡ مِنۡهُمۡ ءَاثِمًا أَوۡ كَفُورٗا",
    "ayah_text_no_diacratic" : "فاصبر لحكم ربك ولا تطع منهم ءاثما او كفورا",
    "ayahnumber" : "24",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5765",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5766",
    "ayah_text" : "وَٱذۡكُرِ ٱسۡمَ رَبِّكَ بُكۡرَةٗ وَأَصِيلٗا",
    "ayah_text_no_diacratic" : "واذكر اسم ربك بكرة واصيلا",
    "ayahnumber" : "25",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5766",
    "page" : "579",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
