    "surrahname_no_diacratic" : "سورة الحاقة"
  }, {
    "@id" : "quran:5467",
    "ayah_text" : "فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖ",
    "ayah_text_no_diacratic" : "فهل ترىٰ لهم من باقية",
