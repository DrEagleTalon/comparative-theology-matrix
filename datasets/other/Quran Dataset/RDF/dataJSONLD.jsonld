    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1168",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ٱتَّقَوۡاْ إِذَا مَسَّهُمۡ طَٰٓئِفٞ مِّنَ ٱلشَّيۡطَٰنِ تَذَكَّرُواْ فَإِذَا هُم مُّبۡصِرُونَ",
    "ayah_text_no_diacratic" : "ان الذين اتقوا اذا مسهم طٰئف من الشيطٰن تذكروا فاذا هم مبصرون",
    "ayahnumber" : "201",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1168",
    "page" : "176",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1169",
    "ayah_text" : "وَإِخۡوَٰنُهُمۡ يَمُدُّونَهُمۡ فِي ٱلۡغَيِّ ثُمَّ لَا يُقۡصِرُونَ",
    "ayah_text_no_diacratic" : "واخوٰنهم يمدونهم في الغي ثم لا يقصرون",
    "ayahnumber" : "202",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1169",
    "page" : "176",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:117",
    "ayah_text" : "أَلَمۡ تَعۡلَمۡ أَنَّ ٱللَّهَ لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِيّٖ وَلَا نَصِيرٍ",
    "ayah_text_no_diacratic" : "الم تعلم ان الله له ملك السمٰوٰت والارض وما لكم من دون الله من ولي ولا نصير",
    "ayahnumber" : "107",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "117",
    "page" : "17",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1170",
    "ayah_text" : "وَإِذَا لَمۡ تَأۡتِهِم بِـَٔايَةٖ قَالُواْ لَوۡلَا ٱجۡتَبَيۡتَهَاۚ قُلۡ إِنَّمَآ أَتَّبِعُ مَا يُوحَىٰٓ إِلَيَّ مِن رَّبِّيۚ هَٰذَا بَصَآئِرُ مِن رَّبِّكُمۡ وَهُدٗى وَرَحۡمَةٞ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "واذا لم تاتهم باية قالوا لولا اجتبيتها قل انما اتبع ما يوحىٰ الي من ربي هٰذا بصائر من ربكم وهدى ورحمة لقوم يؤمنون",
    "ayahnumber" : "203",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1170",
    "page" : "176",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1171",
    "ayah_text" : "وَإِذَا قُرِئَ ٱلۡقُرۡءَانُ فَٱسۡتَمِعُواْ لَهُۥ وَأَنصِتُواْ لَعَلَّكُمۡ تُرۡحَمُونَ",
    "ayah_text_no_diacratic" : "واذا قرئ القرءان فاستمعوا له وانصتوا لعلكم ترحمون",
    "ayahnumber" : "204",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1171",
    "page" : "176",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1172",
    "ayah_text" : "وَٱذۡكُر رَّبَّكَ فِي نَفۡسِكَ تَضَرُّعٗا وَخِيفَةٗ وَدُونَ ٱلۡجَهۡرِ مِنَ ٱلۡقَوۡلِ بِٱلۡغُدُوِّ وَٱلۡأٓصَالِ وَلَا تَكُن مِّنَ ٱلۡغَٰفِلِينَ",
    "ayah_text_no_diacratic" : "واذكر ربك في نفسك تضرعا وخيفة ودون الجهر من القول بالغدو والاصال ولا تكن من الغٰفلين",
    "ayahnumber" : "205",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1172",
    "page" : "176",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1173",
    "ayah_text" : "إِنَّ ٱلَّذِينَ عِندَ رَبِّكَ لَا يَسۡتَكۡبِرُونَ عَنۡ عِبَادَتِهِۦ وَيُسَبِّحُونَهُۥ وَلَهُۥ يَسۡجُدُونَۤ۩",
    "ayah_text_no_diacratic" : "ان الذين عند ربك لا يستكبرون عن عبادته ويسبحونه وله يسجدون",
    "ayahnumber" : "206",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1173",
    "page" : "176",
    "sajdah" : "1",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
