    "surahnumber" : "78",
    "surrahname_no_diacratic" : "سورة النبا"
  }, {
    "@id" : "quran:5863",
    "ayah_text" : "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا",
    "ayah_text_no_diacratic" : "رب السمٰوٰت والارض وما بينهما الرحمٰن لا يملكون منه خطابا",
    "ayahnumber" : "37",
    "chapter" : "30",
    "hizb" : "58",
    "index" : "5863",
    "page" : "583",
    "surahname" : "سُورَةُ النَّبَإِ",
    "surahnumber" : "78",
    "surrahname_no_diacratic" : "سورة النبا"
  }, {
    "@id" : "quran:5864",
    "ayah_text" : "يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا",
    "ayah_text_no_diacratic" : "يوم يقوم الروح والملٰئكة صفا لا يتكلمون الا من اذن له الرحمٰن وقال صوابا",
    "ayahnumber" : "38",
    "chapter" : "30",
    "hizb" : "58",
    "index" : "5864",
    "page" : "583",
    "surahname" : "سُورَةُ النَّبَإِ",
    "surahnumber" : "78",
    "surrahname_no_diacratic" : "سورة النبا"
  }, {
    "@id" : "quran:5865",
    "ayah_text" : "ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
    "ayah_text_no_diacratic" : "ذٰلك اليوم الحق فمن شاء اتخذ الىٰ ربه مابا",
    "ayahnumber" : "39",
    "chapter" : "30",
    "hizb" : "58",
