  }, {
    "@id" : "quran:1131",
    "ayah_text" : "وَإِذۡ قَالَتۡ أُمَّةٞ مِّنۡهُمۡ لِمَ تَعِظُونَ قَوۡمًا ٱللَّهُ مُهۡلِكُهُمۡ أَوۡ مُعَذِّبُهُمۡ عَذَابٗا شَدِيدٗاۖ قَالُواْ مَعۡذِرَةً إِلَىٰ رَبِّكُمۡ وَلَعَلَّهُمۡ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "واذ قالت امة منهم لم تعظون قوما الله مهلكهم او معذبهم عذابا شديدا قالوا معذرة الىٰ ربكم ولعلهم يتقون",
    "ayahnumber" : "164",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1131",
    "page" : "172",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1132",
    "ayah_text" : "فَلَمَّا نَسُواْ مَا ذُكِّرُواْ بِهِۦٓ أَنجَيۡنَا ٱلَّذِينَ يَنۡهَوۡنَ عَنِ ٱلسُّوٓءِ وَأَخَذۡنَا ٱلَّذِينَ ظَلَمُواْ بِعَذَابِۭ بَـِٔيسِۭ بِمَا كَانُواْ يَفۡسُقُونَ",
    "ayah_text_no_diacratic" : "فلما نسوا ما ذكروا به انجينا الذين ينهون عن السوء واخذنا الذين ظلموا بعذاب بيس بما كانوا يفسقون",
    "ayahnumber" : "165",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1132",
    "page" : "172",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1133",
    "ayah_text" : "فَلَمَّا عَتَوۡاْ عَن مَّا نُهُواْ عَنۡهُ قُلۡنَا لَهُمۡ كُونُواْ قِرَدَةً خَٰسِـِٔينَ",
    "ayah_text_no_diacratic" : "فلما عتوا عن ما نهوا عنه قلنا لهم كونوا قردة خٰسين",
    "ayahnumber" : "166",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1133",
    "page" : "172",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1134",
    "ayah_text" : "وَإِذۡ تَأَذَّنَ رَبُّكَ لَيَبۡعَثَنَّ عَلَيۡهِمۡ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ مَن يَسُومُهُمۡ سُوٓءَ ٱلۡعَذَابِۗ إِنَّ رَبَّكَ لَسَرِيعُ ٱلۡعِقَابِ وَإِنَّهُۥ لَغَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "واذ تاذن ربك ليبعثن عليهم الىٰ يوم القيٰمة من يسومهم سوء العذاب ان ربك لسريع العقاب وانه لغفور رحيم",
    "ayahnumber" : "167",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1134",
    "page" : "172",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1135",
    "ayah_text" : "وَقَطَّعۡنَٰهُمۡ فِي ٱلۡأَرۡضِ أُمَمٗاۖ مِّنۡهُمُ ٱلصَّٰلِحُونَ وَمِنۡهُمۡ دُونَ ذَٰلِكَۖ وَبَلَوۡنَٰهُم بِٱلۡحَسَنَٰتِ وَٱلسَّيِّـَٔاتِ لَعَلَّهُمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "وقطعنٰهم في الارض امما منهم الصٰلحون ومنهم دون ذٰلك وبلونٰهم بالحسنٰت والسيات لعلهم يرجعون",
    "ayahnumber" : "168",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1135",
    "page" : "172",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1136",
    "ayah_text" : "فَخَلَفَ مِنۢ بَعۡدِهِمۡ خَلۡفٞ وَرِثُواْ ٱلۡكِتَٰبَ يَأۡخُذُونَ عَرَضَ هَٰذَا ٱلۡأَدۡنَىٰ وَيَقُولُونَ سَيُغۡفَرُ لَنَا وَإِن يَأۡتِهِمۡ عَرَضٞ مِّثۡلُهُۥ يَأۡخُذُوهُۚ أَلَمۡ يُؤۡخَذۡ عَلَيۡهِم مِّيثَٰقُ ٱلۡكِتَٰبِ أَن لَّا يَقُولُواْ عَلَى ٱللَّهِ إِلَّا ٱلۡحَقَّ وَدَرَسُواْ مَا فِيهِۗ وَٱلدَّارُ ٱلۡأٓخِرَةُ خَيۡرٞ لِّلَّذِينَ يَتَّقُونَۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "فخلف من بعدهم خلف ورثوا الكتٰب ياخذون عرض هٰذا الادنىٰ ويقولون سيغفر لنا وان ياتهم عرض مثله ياخذوه الم يؤخذ عليهم ميثٰق الكتٰب ان لا يقولوا على الله الا الحق ودرسوا ما فيه والدار الاخرة خير للذين يتقون افلا تعقلون",
    "ayahnumber" : "169",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1136",
    "page" : "172",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1137",
    "ayah_text" : "وَٱلَّذِينَ يُمَسِّكُونَ بِٱلۡكِتَٰبِ وَأَقَامُواْ ٱلصَّلَوٰةَ إِنَّا لَا نُضِيعُ أَجۡرَ ٱلۡمُصۡلِحِينَ",
    "ayah_text_no_diacratic" : "والذين يمسكون بالكتٰب واقاموا الصلوٰة انا لا نضيع اجر المصلحين",
    "ayahnumber" : "170",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1137",
    "page" : "172",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1138",
    "ayah_text" : "۞وَإِذۡ نَتَقۡنَا ٱلۡجَبَلَ فَوۡقَهُمۡ كَأَنَّهُۥ ظُلَّةٞ وَظَنُّوٓاْ أَنَّهُۥ وَاقِعُۢ بِهِمۡ خُذُواْ مَآ ءَاتَيۡنَٰكُم بِقُوَّةٖ وَٱذۡكُرُواْ مَا فِيهِ لَعَلَّكُمۡ تَتَّقُونَ",
    "ayah_text_no_diacratic" : "واذ نتقنا الجبل فوقهم كانه ظلة وظنوا انه واقع بهم خذوا ما ءاتينٰكم بقوة واذكروا ما فيه لعلكم تتقون",
    "ayahnumber" : "171",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1138",
    "page" : "173",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1139",
    "ayah_text" : "وَإِذۡ أَخَذَ رَبُّكَ مِنۢ بَنِيٓ ءَادَمَ مِن ظُهُورِهِمۡ ذُرِّيَّتَهُمۡ وَأَشۡهَدَهُمۡ عَلَىٰٓ أَنفُسِهِمۡ أَلَسۡتُ بِرَبِّكُمۡۖ قَالُواْ بَلَىٰ شَهِدۡنَآۚ أَن تَقُولُواْ يَوۡمَ ٱلۡقِيَٰمَةِ إِنَّا كُنَّا عَنۡ هَٰذَا غَٰفِلِينَ",
    "ayah_text_no_diacratic" : "واذ اخذ ربك من بني ءادم من ظهورهم ذريتهم واشهدهم علىٰ انفسهم الست بربكم قالوا بلىٰ شهدنا ان تقولوا يوم القيٰمة انا كنا عن هٰذا غٰفلين",
    "ayahnumber" : "172",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1139",
    "page" : "173",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:114",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَقُولُواْ رَٰعِنَا وَقُولُواْ ٱنظُرۡنَا وَٱسۡمَعُواْۗ وَلِلۡكَٰفِرِينَ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تقولوا رٰعنا وقولوا انظرنا واسمعوا وللكٰفرين عذاب اليم",
    "ayahnumber" : "104",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "114",
    "page" : "16",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1140",
    "ayah_text" : "أَوۡ تَقُولُوٓاْ إِنَّمَآ أَشۡرَكَ ءَابَآؤُنَا مِن قَبۡلُ وَكُنَّا ذُرِّيَّةٗ مِّنۢ بَعۡدِهِمۡۖ أَفَتُهۡلِكُنَا بِمَا فَعَلَ ٱلۡمُبۡطِلُونَ",
    "ayah_text_no_diacratic" : "او تقولوا انما اشرك ءاباؤنا من قبل وكنا ذرية من بعدهم افتهلكنا بما فعل المبطلون",
    "ayahnumber" : "173",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1140",
    "page" : "173",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
