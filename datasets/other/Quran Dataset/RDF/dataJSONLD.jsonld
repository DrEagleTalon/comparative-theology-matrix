    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2248",
    "ayah_text" : "فَٱنطَلَقَا حَتَّىٰٓ إِذَا لَقِيَا غُلَٰمٗا فَقَتَلَهُۥ قَالَ أَقَتَلۡتَ نَفۡسٗا زَكِيَّةَۢ بِغَيۡرِ نَفۡسٖ لَّقَدۡ جِئۡتَ شَيۡـٔٗا نُّكۡرٗا",
    "ayah_text_no_diacratic" : "فانطلقا حتىٰ اذا لقيا غلٰما فقتله قال اقتلت نفسا زكية بغير نفس لقد جئت شيا نكرا",
    "ayahnumber" : "74",
    "chapter" : "15",
