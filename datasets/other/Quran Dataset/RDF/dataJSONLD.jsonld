    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3924",
    "ayah_text" : "إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "انها شجرة تخرج في اصل الجحيم",
