    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3957",
    "ayah_text" : "قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "قالوا ابنوا له بنيٰنا فالقوه في الجحيم",
