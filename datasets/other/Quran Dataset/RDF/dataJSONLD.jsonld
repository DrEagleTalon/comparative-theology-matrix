    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1391",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ يَهۡدِيهِمۡ رَبُّهُم بِإِيمَٰنِهِمۡۖ تَجۡرِي مِن تَحۡتِهِمُ ٱلۡأَنۡهَٰرُ فِي جَنَّٰتِ ٱلنَّعِيمِ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت يهديهم ربهم بايمٰنهم تجري من تحتهم الانهٰر في جنٰت النعيم",
    "ayahnumber" : "9",
    "chapter" : "11",
    "hizb" : "20",
