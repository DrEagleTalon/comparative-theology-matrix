    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1189",
    "ayah_text" : "ذَٰلِكُمۡ فَذُوقُوهُ وَأَنَّ لِلۡكَٰفِرِينَ عَذَابَ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "ذٰلكم فذوقوه وان للكٰفرين عذاب النار",
