    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4441",
    "ayah_text" : "أَهُمۡ يَقۡسِمُونَ رَحۡمَتَ رَبِّكَۚ نَحۡنُ قَسَمۡنَا بَيۡنَهُم مَّعِيشَتَهُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَرَفَعۡنَا بَعۡضَهُمۡ فَوۡقَ بَعۡضٖ دَرَجَٰتٖ لِّيَتَّخِذَ بَعۡضُهُم بَعۡضٗا سُخۡرِيّٗاۗ وَرَحۡمَتُ رَبِّكَ خَيۡرٞ مِّمَّا يَجۡمَعُونَ",
    "ayah_text_no_diacratic" : "اهم يقسمون رحمت ربك نحن قسمنا بينهم معيشتهم في الحيوٰة الدنيا ورفعنا بعضهم فوق بعض درجٰت ليتخذ بعضهم بعضا سخريا ورحمت ربك خير مما يجمعون",
    "ayahnumber" : "32",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4441",
    "page" : "491",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4442",
    "ayah_text" : "وَلَوۡلَآ أَن يَكُونَ ٱلنَّاسُ أُمَّةٗ وَٰحِدَةٗ لَّجَعَلۡنَا لِمَن يَكۡفُرُ بِٱلرَّحۡمَٰنِ لِبُيُوتِهِمۡ سُقُفٗا مِّن فِضَّةٖ وَمَعَارِجَ عَلَيۡهَا يَظۡهَرُونَ",
    "ayah_text_no_diacratic" : "ولولا ان يكون الناس امة وٰحدة لجعلنا لمن يكفر بالرحمٰن لبيوتهم سقفا من فضة ومعارج عليها يظهرون",
    "ayahnumber" : "33",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4442",
    "page" : "491",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4443",
    "ayah_text" : "وَلِبُيُوتِهِمۡ أَبۡوَٰبٗا وَسُرُرًا عَلَيۡهَا يَتَّكِـُٔونَ",
    "ayah_text_no_diacratic" : "ولبيوتهم ابوٰبا وسررا عليها يتكون",
    "ayahnumber" : "34",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4443",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4444",
    "ayah_text" : "وَزُخۡرُفٗاۚ وَإِن كُلُّ ذَٰلِكَ لَمَّا مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَٱلۡأٓخِرَةُ عِندَ رَبِّكَ لِلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "وزخرفا وان كل ذٰلك لما متٰع الحيوٰة الدنيا والاخرة عند ربك للمتقين",
    "ayahnumber" : "35",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4444",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4445",
    "ayah_text" : "وَمَن يَعۡشُ عَن ذِكۡرِ ٱلرَّحۡمَٰنِ نُقَيِّضۡ لَهُۥ شَيۡطَٰنٗا فَهُوَ لَهُۥ قَرِينٞ",
    "ayah_text_no_diacratic" : "ومن يعش عن ذكر الرحمٰن نقيض له شيطٰنا فهو له قرين",
    "ayahnumber" : "36",
    "chapter" : "25",
    "hizb" : "49",
