  }, {
    "@id" : "quran:1922",
    "ayah_text" : "فَوَرَبِّكَ لَنَسۡـَٔلَنَّهُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "فوربك لنسلنهم اجمعين",
