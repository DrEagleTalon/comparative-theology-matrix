    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5313",
    "ayah_text" : "إِذَا جَآءَكَ ٱلۡمُنَٰفِقُونَ قَالُواْ نَشۡهَدُ إِنَّكَ لَرَسُولُ ٱللَّهِۗ وَٱللَّهُ يَعۡلَمُ إِنَّكَ لَرَسُولُهُۥ وَٱللَّهُ يَشۡهَدُ إِنَّ ٱلۡمُنَٰفِقِينَ لَكَٰذِبُونَ",
    "ayah_text_no_diacratic" : "اذا جاءك المنٰفقون قالوا نشهد انك لرسول الله والله يعلم انك لرسوله والله يشهد ان المنٰفقين لكٰذبون",
    "ayahnumber" : "1",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5313",
    "page" : "554",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5314",
    "ayah_text" : "ٱتَّخَذُوٓاْ أَيۡمَٰنَهُمۡ جُنَّةٗ فَصَدُّواْ عَن سَبِيلِ ٱللَّهِۚ إِنَّهُمۡ سَآءَ مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "اتخذوا ايمٰنهم جنة فصدوا عن سبيل الله انهم ساء ما كانوا يعملون",
    "ayahnumber" : "2",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5314",
    "page" : "554",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5315",
    "ayah_text" : "ذَٰلِكَ بِأَنَّهُمۡ ءَامَنُواْ ثُمَّ كَفَرُواْ فَطُبِعَ عَلَىٰ قُلُوبِهِمۡ فَهُمۡ لَا يَفۡقَهُونَ",
    "ayah_text_no_diacratic" : "ذٰلك بانهم ءامنوا ثم كفروا فطبع علىٰ قلوبهم فهم لا يفقهون",
    "ayahnumber" : "3",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5315",
    "page" : "554",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5316",
    "ayah_text" : "۞وَإِذَا رَأَيۡتَهُمۡ تُعۡجِبُكَ أَجۡسَامُهُمۡۖ وَإِن يَقُولُواْ تَسۡمَعۡ لِقَوۡلِهِمۡۖ كَأَنَّهُمۡ خُشُبٞ مُّسَنَّدَةٞۖ يَحۡسَبُونَ كُلَّ صَيۡحَةٍ عَلَيۡهِمۡۚ هُمُ ٱلۡعَدُوُّ فَٱحۡذَرۡهُمۡۚ قَٰتَلَهُمُ ٱللَّهُۖ أَنَّىٰ يُؤۡفَكُونَ",
    "ayah_text_no_diacratic" : "واذا رايتهم تعجبك اجسامهم وان يقولوا تسمع لقولهم كانهم خشب مسندة يحسبون كل صيحة عليهم هم العدو فاحذرهم قٰتلهم الله انىٰ يؤفكون",
    "ayahnumber" : "4",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5316",
    "page" : "554",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5317",
    "ayah_text" : "وَإِذَا قِيلَ لَهُمۡ تَعَالَوۡاْ يَسۡتَغۡفِرۡ لَكُمۡ رَسُولُ ٱللَّهِ لَوَّوۡاْ رُءُوسَهُمۡ وَرَأَيۡتَهُمۡ يَصُدُّونَ وَهُم مُّسۡتَكۡبِرُونَ",
    "ayah_text_no_diacratic" : "واذا قيل لهم تعالوا يستغفر لكم رسول الله لووا رءوسهم ورايتهم يصدون وهم مستكبرون",
    "ayahnumber" : "5",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5317",
    "page" : "555",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5318",
    "ayah_text" : "سَوَآءٌ عَلَيۡهِمۡ أَسۡتَغۡفَرۡتَ لَهُمۡ أَمۡ لَمۡ تَسۡتَغۡفِرۡ لَهُمۡ لَن يَغۡفِرَ ٱللَّهُ لَهُمۡۚ إِنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلۡفَٰسِقِينَ",
    "ayah_text_no_diacratic" : "سواء عليهم استغفرت لهم ام لم تستغفر لهم لن يغفر الله لهم ان الله لا يهدي القوم الفٰسقين",
    "ayahnumber" : "6",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5318",
    "page" : "555",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5319",
    "ayah_text" : "هُمُ ٱلَّذِينَ يَقُولُونَ لَا تُنفِقُواْ عَلَىٰ مَنۡ عِندَ رَسُولِ ٱللَّهِ حَتَّىٰ يَنفَضُّواْۗ وَلِلَّهِ خَزَآئِنُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَلَٰكِنَّ ٱلۡمُنَٰفِقِينَ لَا يَفۡقَهُونَ",
    "ayah_text_no_diacratic" : "هم الذين يقولون لا تنفقوا علىٰ من عند رسول الله حتىٰ ينفضوا ولله خزائن السمٰوٰت والارض ولٰكن المنٰفقين لا يفقهون",
    "ayahnumber" : "7",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5319",
    "page" : "555",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:532",
    "ayah_text" : "وَلَا تَتَمَنَّوۡاْ مَا فَضَّلَ ٱللَّهُ بِهِۦ بَعۡضَكُمۡ عَلَىٰ بَعۡضٖۚ لِّلرِّجَالِ نَصِيبٞ مِّمَّا ٱكۡتَسَبُواْۖ وَلِلنِّسَآءِ نَصِيبٞ مِّمَّا ٱكۡتَسَبۡنَۚ وَسۡـَٔلُواْ ٱللَّهَ مِن فَضۡلِهِۦٓۚ إِنَّ ٱللَّهَ كَانَ بِكُلِّ شَيۡءٍ عَلِيمٗا",
    "ayah_text_no_diacratic" : "ولا تتمنوا ما فضل الله به بعضكم علىٰ بعض للرجال نصيب مما اكتسبوا وللنساء نصيب مما اكتسبن وسلوا الله من فضله ان الله كان بكل شيء عليما",
    "ayahnumber" : "32",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "532",
    "page" : "83",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5320",
    "ayah_text" : "يَقُولُونَ لَئِن رَّجَعۡنَآ إِلَى ٱلۡمَدِينَةِ لَيُخۡرِجَنَّ ٱلۡأَعَزُّ مِنۡهَا ٱلۡأَذَلَّۚ وَلِلَّهِ ٱلۡعِزَّةُ وَلِرَسُولِهِۦ وَلِلۡمُؤۡمِنِينَ وَلَٰكِنَّ ٱلۡمُنَٰفِقِينَ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "يقولون لئن رجعنا الى المدينة ليخرجن الاعز منها الاذل ولله العزة ولرسوله وللمؤمنين ولٰكن المنٰفقين لا يعلمون",
    "ayahnumber" : "8",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5320",
    "page" : "555",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5321",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تُلۡهِكُمۡ أَمۡوَٰلُكُمۡ وَلَآ أَوۡلَٰدُكُمۡ عَن ذِكۡرِ ٱللَّهِۚ وَمَن يَفۡعَلۡ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تلهكم اموٰلكم ولا اولٰدكم عن ذكر الله ومن يفعل ذٰلك فاولٰئك هم الخٰسرون",
    "ayahnumber" : "9",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5321",
    "page" : "555",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5322",
    "ayah_text" : "وَأَنفِقُواْ مِن مَّا رَزَقۡنَٰكُم مِّن قَبۡلِ أَن يَأۡتِيَ أَحَدَكُمُ ٱلۡمَوۡتُ فَيَقُولَ رَبِّ لَوۡلَآ أَخَّرۡتَنِيٓ إِلَىٰٓ أَجَلٖ قَرِيبٖ فَأَصَّدَّقَ وَأَكُن مِّنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "وانفقوا من ما رزقنٰكم من قبل ان ياتي احدكم الموت فيقول رب لولا اخرتني الىٰ اجل قريب فاصدق واكن من الصٰلحين",
    "ayahnumber" : "10",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5322",
    "page" : "555",
    "surahname" : "سُورَةُ المُنَافِقُونَ",
    "surahnumber" : "63",
    "surrahname_no_diacratic" : "سورة المنافقون"
  }, {
    "@id" : "quran:5323",
    "ayah_text" : "وَلَن يُؤَخِّرَ ٱللَّهُ نَفۡسًا إِذَا جَآءَ أَجَلُهَاۚ وَٱللَّهُ خَبِيرُۢ بِمَا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ولن يؤخر الله نفسا اذا جاء اجلها والله خبير بما تعملون",
    "ayahnumber" : "11",
    "chapter" : "28",
    "hizb" : "55",
