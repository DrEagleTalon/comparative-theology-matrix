    "surrahname_no_diacratic" : "سورة المطففين"
  }, {
    "@id" : "quran:6026",
    "ayah_text" : "كَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "كلا بل ران علىٰ قلوبهم ما كانوا يكسبون",
