    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3399",
    "ayah_text" : "وَلَقَدۡ فَتَنَّا ٱلَّذِينَ مِن قَبۡلِهِمۡۖ فَلَيَعۡلَمَنَّ ٱللَّهُ ٱلَّذِينَ صَدَقُواْ وَلَيَعۡلَمَنَّ ٱلۡكَٰذِبِينَ",
    "ayah_text_no_diacratic" : "ولقد فتنا الذين من قبلهم فليعلمن الله الذين صدقوا وليعلمن الكٰذبين",
    "ayahnumber" : "3",
    "chapter" : "20",
