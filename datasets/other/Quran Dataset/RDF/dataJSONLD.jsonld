    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2734",
    "ayah_text" : "وَلَقَدۡ خَلَقۡنَا فَوۡقَكُمۡ سَبۡعَ طَرَآئِقَ وَمَا كُنَّا عَنِ ٱلۡخَلۡقِ غَٰفِلِينَ",
    "ayah_text_no_diacratic" : "ولقد خلقنا فوقكم سبع طرائق وما كنا عن الخلق غٰفلين",
    "ayahnumber" : "17",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2734",
    "page" : "342",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2735",
    "ayah_text" : "وَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءَۢ بِقَدَرٖ فَأَسۡكَنَّٰهُ فِي ٱلۡأَرۡضِۖ وَإِنَّا عَلَىٰ ذَهَابِۭ بِهِۦ لَقَٰدِرُونَ",
    "ayah_text_no_diacratic" : "وانزلنا من السماء ماء بقدر فاسكنٰه في الارض وانا علىٰ ذهاب به لقٰدرون",
    "ayahnumber" : "18",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2735",
    "page" : "343",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2736",
    "ayah_text" : "فَأَنشَأۡنَا لَكُم بِهِۦ جَنَّٰتٖ مِّن نَّخِيلٖ وَأَعۡنَٰبٖ لَّكُمۡ فِيهَا فَوَٰكِهُ كَثِيرَةٞ وَمِنۡهَا تَأۡكُلُونَ",
    "ayah_text_no_diacratic" : "فانشانا لكم به جنٰت من نخيل واعنٰب لكم فيها فوٰكه كثيرة ومنها تاكلون",
    "ayahnumber" : "19",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2736",
    "page" : "343",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2737",
    "ayah_text" : "وَشَجَرَةٗ تَخۡرُجُ مِن طُورِ سَيۡنَآءَ تَنۢبُتُ بِٱلدُّهۡنِ وَصِبۡغٖ لِّلۡأٓكِلِينَ",
    "ayah_text_no_diacratic" : "وشجرة تخرج من طور سيناء تنبت بالدهن وصبغ للاكلين",
    "ayahnumber" : "20",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2737",
    "page" : "343",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2738",
    "ayah_text" : "وَإِنَّ لَكُمۡ فِي ٱلۡأَنۡعَٰمِ لَعِبۡرَةٗۖ نُّسۡقِيكُم مِّمَّا فِي بُطُونِهَا وَلَكُمۡ فِيهَا مَنَٰفِعُ كَثِيرَةٞ وَمِنۡهَا تَأۡكُلُونَ",
    "ayah_text_no_diacratic" : "وان لكم في الانعٰم لعبرة نسقيكم مما في بطونها ولكم فيها منٰفع كثيرة ومنها تاكلون",
    "ayahnumber" : "21",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2738",
    "page" : "343",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2739",
    "ayah_text" : "وَعَلَيۡهَا وَعَلَى ٱلۡفُلۡكِ تُحۡمَلُونَ",
    "ayah_text_no_diacratic" : "وعليها وعلى الفلك تحملون",
    "ayahnumber" : "22",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2739",
    "page" : "343",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:274",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تُبۡطِلُواْ صَدَقَٰتِكُم بِٱلۡمَنِّ وَٱلۡأَذَىٰ كَٱلَّذِي يُنفِقُ مَالَهُۥ رِئَآءَ ٱلنَّاسِ وَلَا يُؤۡمِنُ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۖ فَمَثَلُهُۥ كَمَثَلِ صَفۡوَانٍ عَلَيۡهِ تُرَابٞ فَأَصَابَهُۥ وَابِلٞ فَتَرَكَهُۥ صَلۡدٗاۖ لَّا يَقۡدِرُونَ عَلَىٰ شَيۡءٖ مِّمَّا كَسَبُواْۗ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تبطلوا صدقٰتكم بالمن والاذىٰ كالذي ينفق ماله رئاء الناس ولا يؤمن بالله واليوم الاخر فمثله كمثل صفوان عليه تراب فاصابه وابل فتركه صلدا لا يقدرون علىٰ شيء مما كسبوا والله لا يهدي القوم الكٰفرين",
    "ayahnumber" : "264",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "274",
    "page" : "44",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2740",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦ فَقَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓۚ أَفَلَا تَتَّقُونَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا نوحا الىٰ قومه فقال يٰقوم اعبدوا الله ما لكم من الٰه غيره افلا تتقون",
    "ayahnumber" : "23",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2740",
    "page" : "343",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2741",
    "ayah_text" : "فَقَالَ ٱلۡمَلَؤُاْ ٱلَّذِينَ كَفَرُواْ مِن قَوۡمِهِۦ مَا هَٰذَآ إِلَّا بَشَرٞ مِّثۡلُكُمۡ يُرِيدُ أَن يَتَفَضَّلَ عَلَيۡكُمۡ وَلَوۡ شَآءَ ٱللَّهُ لَأَنزَلَ مَلَٰٓئِكَةٗ مَّا سَمِعۡنَا بِهَٰذَا فِيٓ ءَابَآئِنَا ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "فقال الملؤا الذين كفروا من قومه ما هٰذا الا بشر مثلكم يريد ان يتفضل عليكم ولو شاء الله لانزل ملٰئكة ما سمعنا بهٰذا في ءابائنا الاولين",
    "ayahnumber" : "24",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2741",
    "page" : "343",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2742",
    "ayah_text" : "إِنۡ هُوَ إِلَّا رَجُلُۢ بِهِۦ جِنَّةٞ فَتَرَبَّصُواْ بِهِۦ حَتَّىٰ حِينٖ",
    "ayah_text_no_diacratic" : "ان هو الا رجل به جنة فتربصوا به حتىٰ حين",
    "ayahnumber" : "25",
