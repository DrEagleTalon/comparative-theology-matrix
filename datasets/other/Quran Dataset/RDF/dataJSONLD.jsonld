    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3923",
    "ayah_text" : "إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "انا جعلنٰها فتنة للظٰلمين",
