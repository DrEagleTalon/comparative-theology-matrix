    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:4022",
    "ayah_text" : "مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ",
    "ayah_text_no_diacratic" : "ما انتم عليه بفٰتنين",
