  }, {
    "@id" : "quran:2719",
    "ayah_text" : "ٱلَّذِينَ هُمۡ فِي صَلَاتِهِمۡ خَٰشِعُونَ",
    "ayah_text_no_diacratic" : "الذين هم في صلاتهم خٰشعون",
