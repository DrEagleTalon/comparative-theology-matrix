    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1877",
    "ayah_text" : "وَنَزَعۡنَا مَا فِي صُدُورِهِم مِّنۡ غِلٍّ إِخۡوَٰنًا عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ",
    "ayah_text_no_diacratic" : "ونزعنا ما في صدورهم من غل اخوٰنا علىٰ سرر متقٰبلين",
