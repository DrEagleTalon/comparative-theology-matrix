    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:742",
    "ayah_text" : "وَقَالَتِ ٱلۡيَهُودُ يَدُ ٱللَّهِ مَغۡلُولَةٌۚ غُلَّتۡ أَيۡدِيهِمۡ وَلُعِنُواْ بِمَا قَالُواْۘ بَلۡ يَدَاهُ مَبۡسُوطَتَانِ يُنفِقُ كَيۡفَ يَشَآءُۚ وَلَيَزِيدَنَّ كَثِيرٗا مِّنۡهُم مَّآ أُنزِلَ إِلَيۡكَ مِن رَّبِّكَ طُغۡيَٰنٗا وَكُفۡرٗاۚ وَأَلۡقَيۡنَا بَيۡنَهُمُ ٱلۡعَدَٰوَةَ وَٱلۡبَغۡضَآءَ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِۚ كُلَّمَآ أَوۡقَدُواْ نَارٗا لِّلۡحَرۡبِ أَطۡفَأَهَا ٱللَّهُۚ وَيَسۡعَوۡنَ فِي ٱلۡأَرۡضِ فَسَادٗاۚ وَٱللَّهُ لَا يُحِبُّ ٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "وقالت اليهود يد الله مغلولة غلت ايديهم ولعنوا بما قالوا بل يداه مبسوطتان ينفق كيف يشاء وليزيدن كثيرا منهم ما انزل اليك من ربك طغيٰنا وكفرا والقينا بينهم العدٰوة والبغضاء الىٰ يوم القيٰمة كلما اوقدوا نارا للحرب اطفاها الله ويسعون في الارض فسادا والله لا يحب المفسدين",
    "ayahnumber" : "64",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "742",
    "page" : "118",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:743",
    "ayah_text" : "وَلَوۡ أَنَّ أَهۡلَ ٱلۡكِتَٰبِ ءَامَنُواْ وَٱتَّقَوۡاْ لَكَفَّرۡنَا عَنۡهُمۡ سَيِّـَٔاتِهِمۡ وَلَأَدۡخَلۡنَٰهُمۡ جَنَّٰتِ ٱلنَّعِيمِ",
    "ayah_text_no_diacratic" : "ولو ان اهل الكتٰب ءامنوا واتقوا لكفرنا عنهم سياتهم ولادخلنٰهم جنٰت النعيم",
    "ayahnumber" : "65",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "743",
    "page" : "119",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:744",
    "ayah_text" : "وَلَوۡ أَنَّهُمۡ أَقَامُواْ ٱلتَّوۡرَىٰةَ وَٱلۡإِنجِيلَ وَمَآ أُنزِلَ إِلَيۡهِم مِّن رَّبِّهِمۡ لَأَكَلُواْ مِن فَوۡقِهِمۡ وَمِن تَحۡتِ أَرۡجُلِهِمۚ مِّنۡهُمۡ أُمَّةٞ مُّقۡتَصِدَةٞۖ وَكَثِيرٞ مِّنۡهُمۡ سَآءَ مَا يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ولو انهم اقاموا التورىٰة والانجيل وما انزل اليهم من ربهم لاكلوا من فوقهم ومن تحت ارجلهم منهم امة مقتصدة وكثير منهم ساء ما يعملون",
    "ayahnumber" : "66",
    "chapter" : "6",
    "hizb" : "11",
