    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:791",
    "ayah_text" : "قَالُواْ نُرِيدُ أَن نَّأۡكُلَ مِنۡهَا وَتَطۡمَئِنَّ قُلُوبُنَا وَنَعۡلَمَ أَن قَدۡ صَدَقۡتَنَا وَنَكُونَ عَلَيۡهَا مِنَ ٱلشَّٰهِدِينَ",
    "ayah_text_no_diacratic" : "قالوا نريد ان ناكل منها وتطمئن قلوبنا ونعلم ان قد صدقتنا ونكون عليها من الشٰهدين",
    "ayahnumber" : "113",
    "chapter" : "7",
