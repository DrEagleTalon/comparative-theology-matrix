    "surrahname_no_diacratic" : "سورة الرحمٰن"
  }, {
    "@id" : "quran:502",
    "ayah_text" : "وَءَاتُواْ ٱلۡيَتَٰمَىٰٓ أَمۡوَٰلَهُمۡۖ وَلَا تَتَبَدَّلُواْ ٱلۡخَبِيثَ بِٱلطَّيِّبِۖ وَلَا تَأۡكُلُوٓاْ أَمۡوَٰلَهُمۡ إِلَىٰٓ أَمۡوَٰلِكُمۡۚ إِنَّهُۥ كَانَ حُوبٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "وءاتوا اليتٰمىٰ اموٰلهم ولا تتبدلوا الخبيث بالطيب ولا تاكلوا اموٰلهم الىٰ اموٰلكم انه كان حوبا كبيرا",
    "ayahnumber" : "2",
    "chapter" : "4",
    "hizb" : "7",
