  }, {
    "@id" : "quran:4710",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَرۡفَعُوٓاْ أَصۡوَٰتَكُمۡ فَوۡقَ صَوۡتِ ٱلنَّبِيِّ وَلَا تَجۡهَرُواْ لَهُۥ بِٱلۡقَوۡلِ كَجَهۡرِ بَعۡضِكُمۡ لِبَعۡضٍ أَن تَحۡبَطَ أَعۡمَٰلُكُمۡ وَأَنتُمۡ لَا تَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا ترفعوا اصوٰتكم فوق صوت النبي ولا تجهروا له بالقول كجهر بعضكم لبعض ان تحبط اعمٰلكم وانتم لا تشعرون",
    "ayahnumber" : "2",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4710",
    "page" : "515",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4711",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَغُضُّونَ أَصۡوَٰتَهُمۡ عِندَ رَسُولِ ٱللَّهِ أُوْلَٰٓئِكَ ٱلَّذِينَ ٱمۡتَحَنَ ٱللَّهُ قُلُوبَهُمۡ لِلتَّقۡوَىٰۚ لَهُم مَّغۡفِرَةٞ وَأَجۡرٌ عَظِيمٌ",
    "ayah_text_no_diacratic" : "ان الذين يغضون اصوٰتهم عند رسول الله اولٰئك الذين امتحن الله قلوبهم للتقوىٰ لهم مغفرة واجر عظيم",
    "ayahnumber" : "3",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4711",
    "page" : "515",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4712",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يُنَادُونَكَ مِن وَرَآءِ ٱلۡحُجُرَٰتِ أَكۡثَرُهُمۡ لَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ان الذين ينادونك من وراء الحجرٰت اكثرهم لا يعقلون",
