  }, {
    "@id" : "quran:400",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ حَقَّ تُقَاتِهِۦ وَلَا تَمُوتُنَّ إِلَّا وَأَنتُم مُّسۡلِمُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اتقوا الله حق تقاته ولا تموتن الا وانتم مسلمون",
