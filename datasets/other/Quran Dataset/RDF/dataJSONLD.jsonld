  }, {
    "@id" : "quran:4699",
    "ayah_text" : "وَلَوۡ قَٰتَلَكُمُ ٱلَّذِينَ كَفَرُواْ لَوَلَّوُاْ ٱلۡأَدۡبَٰرَ ثُمَّ لَا يَجِدُونَ وَلِيّٗا وَلَا نَصِيرٗا",
    "ayah_text_no_diacratic" : "ولو قٰتلكم الذين كفروا لولوا الادبٰر ثم لا يجدون وليا ولا نصيرا",
