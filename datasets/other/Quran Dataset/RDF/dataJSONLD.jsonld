    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1263",
    "ayah_text" : "وَإِن نَّكَثُوٓاْ أَيۡمَٰنَهُم مِّنۢ بَعۡدِ عَهۡدِهِمۡ وَطَعَنُواْ فِي دِينِكُمۡ فَقَٰتِلُوٓاْ أَئِمَّةَ ٱلۡكُفۡرِ إِنَّهُمۡ لَآ أَيۡمَٰنَ لَهُمۡ لَعَلَّهُمۡ يَنتَهُونَ",
    "ayah_text_no_diacratic" : "وان نكثوا ايمٰنهم من بعد عهدهم وطعنوا في دينكم فقٰتلوا ائمة الكفر انهم لا ايمٰن لهم لعلهم ينتهون",
    "ayahnumber" : "12",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1263",
    "page" : "188",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1264",
    "ayah_text" : "أَلَا تُقَٰتِلُونَ قَوۡمٗا نَّكَثُوٓاْ أَيۡمَٰنَهُمۡ وَهَمُّواْ بِإِخۡرَاجِ ٱلرَّسُولِ وَهُم بَدَءُوكُمۡ أَوَّلَ مَرَّةٍۚ أَتَخۡشَوۡنَهُمۡۚ فَٱللَّهُ أَحَقُّ أَن تَخۡشَوۡهُ إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "الا تقٰتلون قوما نكثوا ايمٰنهم وهموا باخراج الرسول وهم بدءوكم اول مرة اتخشونهم فالله احق ان تخشوه ان كنتم مؤمنين",
    "ayahnumber" : "13",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1264",
    "page" : "188",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1265",
    "ayah_text" : "قَٰتِلُوهُمۡ يُعَذِّبۡهُمُ ٱللَّهُ بِأَيۡدِيكُمۡ وَيُخۡزِهِمۡ وَيَنصُرۡكُمۡ عَلَيۡهِمۡ وَيَشۡفِ صُدُورَ قَوۡمٖ مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "قٰتلوهم يعذبهم الله بايديكم ويخزهم وينصركم عليهم ويشف صدور قوم مؤمنين",
    "ayahnumber" : "14",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1265",
    "page" : "189",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1266",
    "ayah_text" : "وَيُذۡهِبۡ غَيۡظَ قُلُوبِهِمۡۗ وَيَتُوبُ ٱللَّهُ عَلَىٰ مَن يَشَآءُۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ",
    "ayah_text_no_diacratic" : "ويذهب غيظ قلوبهم ويتوب الله علىٰ من يشاء والله عليم حكيم",
    "ayahnumber" : "15",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1266",
    "page" : "189",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1267",
    "ayah_text" : "أَمۡ حَسِبۡتُمۡ أَن تُتۡرَكُواْ وَلَمَّا يَعۡلَمِ ٱللَّهُ ٱلَّذِينَ جَٰهَدُواْ مِنكُمۡ وَلَمۡ يَتَّخِذُواْ مِن دُونِ ٱللَّهِ وَلَا رَسُولِهِۦ وَلَا ٱلۡمُؤۡمِنِينَ وَلِيجَةٗۚ وَٱللَّهُ خَبِيرُۢ بِمَا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ام حسبتم ان تتركوا ولما يعلم الله الذين جٰهدوا منكم ولم يتخذوا من دون الله ولا رسوله ولا المؤمنين وليجة والله خبير بما تعملون",
    "ayahnumber" : "16",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1267",
    "page" : "189",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1268",
    "ayah_text" : "مَا كَانَ لِلۡمُشۡرِكِينَ أَن يَعۡمُرُواْ مَسَٰجِدَ ٱللَّهِ شَٰهِدِينَ عَلَىٰٓ أَنفُسِهِم بِٱلۡكُفۡرِۚ أُوْلَٰٓئِكَ حَبِطَتۡ أَعۡمَٰلُهُمۡ وَفِي ٱلنَّارِ هُمۡ خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "ما كان للمشركين ان يعمروا مسٰجد الله شٰهدين علىٰ انفسهم بالكفر اولٰئك حبطت اعمٰلهم وفي النار هم خٰلدون",
    "ayahnumber" : "17",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1268",
    "page" : "189",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1269",
    "ayah_text" : "إِنَّمَا يَعۡمُرُ مَسَٰجِدَ ٱللَّهِ مَنۡ ءَامَنَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ وَلَمۡ يَخۡشَ إِلَّا ٱللَّهَۖ فَعَسَىٰٓ أُوْلَٰٓئِكَ أَن يَكُونُواْ مِنَ ٱلۡمُهۡتَدِينَ",
    "ayah_text_no_diacratic" : "انما يعمر مسٰجد الله من ءامن بالله واليوم الاخر واقام الصلوٰة وءاتى الزكوٰة ولم يخش الا الله فعسىٰ اولٰئك ان يكونوا من المهتدين",
    "ayahnumber" : "18",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1269",
    "page" : "189",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:127",
    "ayah_text" : "بَدِيعُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَإِذَا قَضَىٰٓ أَمۡرٗا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ",
    "ayah_text_no_diacratic" : "بديع السمٰوٰت والارض واذا قضىٰ امرا فانما يقول له كن فيكون",
    "ayahnumber" : "117",
    "chapter" : "1",
    "hizb" : "1",
