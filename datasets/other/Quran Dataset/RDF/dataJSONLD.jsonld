    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1067",
    "ayah_text" : "أَوَلَمۡ يَهۡدِ لِلَّذِينَ يَرِثُونَ ٱلۡأَرۡضَ مِنۢ بَعۡدِ أَهۡلِهَآ أَن لَّوۡ نَشَآءُ أَصَبۡنَٰهُم بِذُنُوبِهِمۡۚ وَنَطۡبَعُ عَلَىٰ قُلُوبِهِمۡ فَهُمۡ لَا يَسۡمَعُونَ",
    "ayah_text_no_diacratic" : "اولم يهد للذين يرثون الارض من بعد اهلها ان لو نشاء اصبنٰهم بذنوبهم ونطبع علىٰ قلوبهم فهم لا يسمعون",
    "ayahnumber" : "100",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1067",
    "page" : "163",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1068",
    "ayah_text" : "تِلۡكَ ٱلۡقُرَىٰ نَقُصُّ عَلَيۡكَ مِنۡ أَنۢبَآئِهَاۚ وَلَقَدۡ جَآءَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ فَمَا كَانُواْ لِيُؤۡمِنُواْ بِمَا كَذَّبُواْ مِن قَبۡلُۚ كَذَٰلِكَ يَطۡبَعُ ٱللَّهُ عَلَىٰ قُلُوبِ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "تلك القرىٰ نقص عليك من انبائها ولقد جاءتهم رسلهم بالبينٰت فما كانوا ليؤمنوا بما كذبوا من قبل كذٰلك يطبع الله علىٰ قلوب الكٰفرين",
    "ayahnumber" : "101",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1068",
    "page" : "163",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1069",
    "ayah_text" : "وَمَا وَجَدۡنَا لِأَكۡثَرِهِم مِّنۡ عَهۡدٖۖ وَإِن وَجَدۡنَآ أَكۡثَرَهُمۡ لَفَٰسِقِينَ",
    "ayah_text_no_diacratic" : "وما وجدنا لاكثرهم من عهد وان وجدنا اكثرهم لفٰسقين",
    "ayahnumber" : "102",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1069",
    "page" : "163",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:107",
    "ayah_text" : "قُلۡ مَن كَانَ عَدُوّٗا لِّـجِبۡرِيلَ فَإِنَّهُۥ نَزَّلَهُۥ عَلَىٰ قَلۡبِكَ بِإِذۡنِ ٱللَّهِ مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ وَهُدٗى وَبُشۡرَىٰ لِلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "قل من كان عدوا لجبريل فانه نزله علىٰ قلبك باذن الله مصدقا لما بين يديه وهدى وبشرىٰ للمؤمنين",
    "ayahnumber" : "97",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "107",
    "page" : "15",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1070",
    "ayah_text" : "ثُمَّ بَعَثۡنَا مِنۢ بَعۡدِهِم مُّوسَىٰ بِـَٔايَٰتِنَآ إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦ فَظَلَمُواْ بِهَاۖ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "ثم بعثنا من بعدهم موسىٰ بايٰتنا الىٰ فرعون وملايه فظلموا بها فانظر كيف كان عٰقبة المفسدين",
    "ayahnumber" : "103",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1070",
    "page" : "163",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1071",
    "ayah_text" : "وَقَالَ مُوسَىٰ يَٰفِرۡعَوۡنُ إِنِّي رَسُولٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "وقال موسىٰ يٰفرعون اني رسول من رب العٰلمين",
    "ayahnumber" : "104",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1071",
    "page" : "163",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1072",
    "ayah_text" : "حَقِيقٌ عَلَىٰٓ أَن لَّآ أَقُولَ عَلَى ٱللَّهِ إِلَّا ٱلۡحَقَّۚ قَدۡ جِئۡتُكُم بِبَيِّنَةٖ مِّن رَّبِّكُمۡ فَأَرۡسِلۡ مَعِيَ بَنِيٓ إِسۡرَٰٓءِيلَ",
    "ayah_text_no_diacratic" : "حقيق علىٰ ان لا اقول على الله الا الحق قد جئتكم ببينة من ربكم فارسل معي بني اسرٰءيل",
    "ayahnumber" : "105",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1072",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1073",
    "ayah_text" : "قَالَ إِن كُنتَ جِئۡتَ بِـَٔايَةٖ فَأۡتِ بِهَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "قال ان كنت جئت باية فات بها ان كنت من الصٰدقين",
    "ayahnumber" : "106",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1073",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1074",
    "ayah_text" : "فَأَلۡقَىٰ عَصَاهُ فَإِذَا هِيَ ثُعۡبَانٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "فالقىٰ عصاه فاذا هي ثعبان مبين",
    "ayahnumber" : "107",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1074",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1075",
    "ayah_text" : "وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيۡضَآءُ لِلنَّٰظِرِينَ",
    "ayah_text_no_diacratic" : "ونزع يده فاذا هي بيضاء للنٰظرين",
    "ayahnumber" : "108",
    "chapter" : "9",
