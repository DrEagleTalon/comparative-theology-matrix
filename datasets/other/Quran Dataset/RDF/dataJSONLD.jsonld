    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:28",
    "ayah_text" : "صُمُّۢ بُكۡمٌ عُمۡيٞ فَهُمۡ لَا يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "صم بكم عمي فهم لا يرجعون",
    "ayahnumber" : "18",
    "chapter" : "1",
    "hizb" : "0",
