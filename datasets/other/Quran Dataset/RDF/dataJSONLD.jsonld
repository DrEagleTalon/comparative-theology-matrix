  }, {
    "@id" : "quran:1301",
    "ayah_text" : "إِن تُصِبۡكَ حَسَنَةٞ تَسُؤۡهُمۡۖ وَإِن تُصِبۡكَ مُصِيبَةٞ يَقُولُواْ قَدۡ أَخَذۡنَآ أَمۡرَنَا مِن قَبۡلُ وَيَتَوَلَّواْ وَّهُمۡ فَرِحُونَ",
    "ayah_text_no_diacratic" : "ان تصبك حسنة تسؤهم وان تصبك مصيبة يقولوا قد اخذنا امرنا من قبل ويتولوا وهم فرحون",
    "ayahnumber" : "50",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1301",
    "page" : "195",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1302",
    "ayah_text" : "قُل لَّن يُصِيبَنَآ إِلَّا مَا كَتَبَ ٱللَّهُ لَنَا هُوَ مَوۡلَىٰنَاۚ وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ ٱلۡمُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "قل لن يصيبنا الا ما كتب الله لنا هو مولىٰنا وعلى الله فليتوكل المؤمنون",
    "ayahnumber" : "51",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1302",
    "page" : "195",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1303",
    "ayah_text" : "قُلۡ هَلۡ تَرَبَّصُونَ بِنَآ إِلَّآ إِحۡدَى ٱلۡحُسۡنَيَيۡنِۖ وَنَحۡنُ نَتَرَبَّصُ بِكُمۡ أَن يُصِيبَكُمُ ٱللَّهُ بِعَذَابٖ مِّنۡ عِندِهِۦٓ أَوۡ بِأَيۡدِينَاۖ فَتَرَبَّصُوٓاْ إِنَّا مَعَكُم مُّتَرَبِّصُونَ",
    "ayah_text_no_diacratic" : "قل هل تربصون بنا الا احدى الحسنيين ونحن نتربص بكم ان يصيبكم الله بعذاب من عنده او بايدينا فتربصوا انا معكم متربصون",
    "ayahnumber" : "52",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1303",
    "page" : "195",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1304",
    "ayah_text" : "قُلۡ أَنفِقُواْ طَوۡعًا أَوۡ كَرۡهٗا لَّن يُتَقَبَّلَ مِنكُمۡ إِنَّكُمۡ كُنتُمۡ قَوۡمٗا فَٰسِقِينَ",
    "ayah_text_no_diacratic" : "قل انفقوا طوعا او كرها لن يتقبل منكم انكم كنتم قوما فٰسقين",
    "ayahnumber" : "53",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1304",
    "page" : "195",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1305",
    "ayah_text" : "وَمَا مَنَعَهُمۡ أَن تُقۡبَلَ مِنۡهُمۡ نَفَقَٰتُهُمۡ إِلَّآ أَنَّهُمۡ كَفَرُواْ بِٱللَّهِ وَبِرَسُولِهِۦ وَلَا يَأۡتُونَ ٱلصَّلَوٰةَ إِلَّا وَهُمۡ كُسَالَىٰ وَلَا يُنفِقُونَ إِلَّا وَهُمۡ كَٰرِهُونَ",
    "ayah_text_no_diacratic" : "وما منعهم ان تقبل منهم نفقٰتهم الا انهم كفروا بالله وبرسوله ولا ياتون الصلوٰة الا وهم كسالىٰ ولا ينفقون الا وهم كٰرهون",
    "ayahnumber" : "54",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1305",
    "page" : "195",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1306",
    "ayah_text" : "فَلَا تُعۡجِبۡكَ أَمۡوَٰلُهُمۡ وَلَآ أَوۡلَٰدُهُمۡۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُعَذِّبَهُم بِهَا فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَتَزۡهَقَ أَنفُسُهُمۡ وَهُمۡ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "فلا تعجبك اموٰلهم ولا اولٰدهم انما يريد الله ليعذبهم بها في الحيوٰة الدنيا وتزهق انفسهم وهم كٰفرون",
    "ayahnumber" : "55",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1306",
    "page" : "196",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1307",
    "ayah_text" : "وَيَحۡلِفُونَ بِٱللَّهِ إِنَّهُمۡ لَمِنكُمۡ وَمَا هُم مِّنكُمۡ وَلَٰكِنَّهُمۡ قَوۡمٞ يَفۡرَقُونَ",
    "ayah_text_no_diacratic" : "ويحلفون بالله انهم لمنكم وما هم منكم ولٰكنهم قوم يفرقون",
    "ayahnumber" : "56",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1307",
    "page" : "196",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1308",
    "ayah_text" : "لَوۡ يَجِدُونَ مَلۡجَـًٔا أَوۡ مَغَٰرَٰتٍ أَوۡ مُدَّخَلٗا لَّوَلَّوۡاْ إِلَيۡهِ وَهُمۡ يَجۡمَحُونَ",
    "ayah_text_no_diacratic" : "لو يجدون ملجا او مغٰرٰت او مدخلا لولوا اليه وهم يجمحون",
    "ayahnumber" : "57",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1308",
    "page" : "196",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1309",
    "ayah_text" : "وَمِنۡهُم مَّن يَلۡمِزُكَ فِي ٱلصَّدَقَٰتِ فَإِنۡ أُعۡطُواْ مِنۡهَا رَضُواْ وَإِن لَّمۡ يُعۡطَوۡاْ مِنۡهَآ إِذَا هُمۡ يَسۡخَطُونَ",
    "ayah_text_no_diacratic" : "ومنهم من يلمزك في الصدقٰت فان اعطوا منها رضوا وان لم يعطوا منها اذا هم يسخطون",
    "ayahnumber" : "58",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1309",
    "page" : "196",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:131",
    "ayah_text" : "ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَتۡلُونَهُۥ حَقَّ تِلَاوَتِهِۦٓ أُوْلَٰٓئِكَ يُؤۡمِنُونَ بِهِۦۗ وَمَن يَكۡفُرۡ بِهِۦ فَأُوْلَٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "الذين ءاتينٰهم الكتٰب يتلونه حق تلاوته اولٰئك يؤمنون به ومن يكفر به فاولٰئك هم الخٰسرون",
    "ayahnumber" : "121",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "131",
    "page" : "19",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1310",
    "ayah_text" : "وَلَوۡ أَنَّهُمۡ رَضُواْ مَآ ءَاتَىٰهُمُ ٱللَّهُ وَرَسُولُهُۥ وَقَالُواْ حَسۡبُنَا ٱللَّهُ سَيُؤۡتِينَا ٱللَّهُ مِن فَضۡلِهِۦ وَرَسُولُهُۥٓ إِنَّآ إِلَى ٱللَّهِ رَٰغِبُونَ",
    "ayah_text_no_diacratic" : "ولو انهم رضوا ما ءاتىٰهم الله ورسوله وقالوا حسبنا الله سيؤتينا الله من فضله ورسوله انا الى الله رٰغبون",
    "ayahnumber" : "59",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1310",
    "page" : "196",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1311",
    "ayah_text" : "۞إِنَّمَا ٱلصَّدَقَٰتُ لِلۡفُقَرَآءِ وَٱلۡمَسَٰكِينِ وَٱلۡعَٰمِلِينَ عَلَيۡهَا وَٱلۡمُؤَلَّفَةِ قُلُوبُهُمۡ وَفِي ٱلرِّقَابِ وَٱلۡغَٰرِمِينَ وَفِي سَبِيلِ ٱللَّهِ وَٱبۡنِ ٱلسَّبِيلِۖ فَرِيضَةٗ مِّنَ ٱللَّهِۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "انما الصدقٰت للفقراء والمسٰكين والعٰملين عليها والمؤلفة قلوبهم وفي الرقاب والغٰرمين وفي سبيل الله وابن السبيل فريضة من الله والله عليم حكيم",
    "ayahnumber" : "60",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1311",
    "page" : "196",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1312",
    "ayah_text" : "وَمِنۡهُمُ ٱلَّذِينَ يُؤۡذُونَ ٱلنَّبِيَّ وَيَقُولُونَ هُوَ أُذُنٞۚ قُلۡ أُذُنُ خَيۡرٖ لَّكُمۡ يُؤۡمِنُ بِٱللَّهِ وَيُؤۡمِنُ لِلۡمُؤۡمِنِينَ وَرَحۡمَةٞ لِّلَّذِينَ ءَامَنُواْ مِنكُمۡۚ وَٱلَّذِينَ يُؤۡذُونَ رَسُولَ ٱللَّهِ لَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "ومنهم الذين يؤذون النبي ويقولون هو اذن قل اذن خير لكم يؤمن بالله ويؤمن للمؤمنين ورحمة للذين ءامنوا منكم والذين يؤذون رسول الله لهم عذاب اليم",
    "ayahnumber" : "61",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1312",
    "page" : "196",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1313",
    "ayah_text" : "يَحۡلِفُونَ بِٱللَّهِ لَكُمۡ لِيُرۡضُوكُمۡ وَٱللَّهُ وَرَسُولُهُۥٓ أَحَقُّ أَن يُرۡضُوهُ إِن كَانُواْ مُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "يحلفون بالله لكم ليرضوكم والله ورسوله احق ان يرضوه ان كانوا مؤمنين",
    "ayahnumber" : "62",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1313",
    "page" : "197",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1314",
    "ayah_text" : "أَلَمۡ يَعۡلَمُوٓاْ أَنَّهُۥ مَن يُحَادِدِ ٱللَّهَ وَرَسُولَهُۥ فَأَنَّ لَهُۥ نَارَ جَهَنَّمَ خَٰلِدٗا فِيهَاۚ ذَٰلِكَ ٱلۡخِزۡيُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "الم يعلموا انه من يحادد الله ورسوله فان له نار جهنم خٰلدا فيها ذٰلك الخزي العظيم",
    "ayahnumber" : "63",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1314",
    "page" : "197",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1315",
    "ayah_text" : "يَحۡذَرُ ٱلۡمُنَٰفِقُونَ أَن تُنَزَّلَ عَلَيۡهِمۡ سُورَةٞ تُنَبِّئُهُم بِمَا فِي قُلُوبِهِمۡۚ قُلِ ٱسۡتَهۡزِءُوٓاْ إِنَّ ٱللَّهَ مُخۡرِجٞ مَّا تَحۡذَرُونَ",
    "ayah_text_no_diacratic" : "يحذر المنٰفقون ان تنزل عليهم سورة تنبئهم بما في قلوبهم قل استهزءوا ان الله مخرج ما تحذرون",
    "ayahnumber" : "64",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1315",
    "page" : "197",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1316",
    "ayah_text" : "وَلَئِن سَأَلۡتَهُمۡ لَيَقُولُنَّ إِنَّمَا كُنَّا نَخُوضُ وَنَلۡعَبُۚ قُلۡ أَبِٱللَّهِ وَءَايَٰتِهِۦ وَرَسُولِهِۦ كُنتُمۡ تَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "ولئن سالتهم ليقولن انما كنا نخوض ونلعب قل ابالله وءايٰته ورسوله كنتم تستهزءون",
    "ayahnumber" : "65",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1316",
    "page" : "197",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1317",
    "ayah_text" : "لَا تَعۡتَذِرُواْ قَدۡ كَفَرۡتُم بَعۡدَ إِيمَٰنِكُمۡۚ إِن نَّعۡفُ عَن طَآئِفَةٖ مِّنكُمۡ نُعَذِّبۡ طَآئِفَةَۢ بِأَنَّهُمۡ كَانُواْ مُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "لا تعتذروا قد كفرتم بعد ايمٰنكم ان نعف عن طائفة منكم نعذب طائفة بانهم كانوا مجرمين",
    "ayahnumber" : "66",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1317",
    "page" : "197",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1318",
    "ayah_text" : "ٱلۡمُنَٰفِقُونَ وَٱلۡمُنَٰفِقَٰتُ بَعۡضُهُم مِّنۢ بَعۡضٖۚ يَأۡمُرُونَ بِٱلۡمُنكَرِ وَيَنۡهَوۡنَ عَنِ ٱلۡمَعۡرُوفِ وَيَقۡبِضُونَ أَيۡدِيَهُمۡۚ نَسُواْ ٱللَّهَ فَنَسِيَهُمۡۚ إِنَّ ٱلۡمُنَٰفِقِينَ هُمُ ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "المنٰفقون والمنٰفقٰت بعضهم من بعض يامرون بالمنكر وينهون عن المعروف ويقبضون ايديهم نسوا الله فنسيهم ان المنٰفقين هم الفٰسقون",
    "ayahnumber" : "67",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1318",
    "page" : "197",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1319",
    "ayah_text" : "وَعَدَ ٱللَّهُ ٱلۡمُنَٰفِقِينَ وَٱلۡمُنَٰفِقَٰتِ وَٱلۡكُفَّارَ نَارَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۚ هِيَ حَسۡبُهُمۡۚ وَلَعَنَهُمُ ٱللَّهُۖ وَلَهُمۡ عَذَابٞ مُّقِيمٞ",
    "ayah_text_no_diacratic" : "وعد الله المنٰفقين والمنٰفقٰت والكفار نار جهنم خٰلدين فيها هي حسبهم ولعنهم الله ولهم عذاب مقيم",
