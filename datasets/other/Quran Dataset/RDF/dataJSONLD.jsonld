  }, {
    "@id" : "quran:4293",
    "ayah_text" : "أَفَلَمۡ يَسِيرُواْ فِي ٱلۡأَرۡضِ فَيَنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَانُوٓاْ أَكۡثَرَ مِنۡهُمۡ وَأَشَدَّ قُوَّةٗ وَءَاثَارٗا فِي ٱلۡأَرۡضِ فَمَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "افلم يسيروا في الارض فينظروا كيف كان عٰقبة الذين من قبلهم كانوا اكثر منهم واشد قوة وءاثارا في الارض فما اغنىٰ عنهم ما كانوا يكسبون",
    "ayahnumber" : "82",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4293",
    "page" : "476",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4294",
    "ayah_text" : "فَلَمَّا جَآءَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ فَرِحُواْ بِمَا عِندَهُم مِّنَ ٱلۡعِلۡمِ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "فلما جاءتهم رسلهم بالبينٰت فرحوا بما عندهم من العلم وحاق بهم ما كانوا به يستهزءون",
    "ayahnumber" : "83",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4294",
    "page" : "476",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4295",
    "ayah_text" : "فَلَمَّا رَأَوۡاْ بَأۡسَنَا قَالُوٓاْ ءَامَنَّا بِٱللَّهِ وَحۡدَهُۥ وَكَفَرۡنَا بِمَا كُنَّا بِهِۦ مُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "فلما راوا باسنا قالوا ءامنا بالله وحده وكفرنا بما كنا به مشركين",
    "ayahnumber" : "84",
    "chapter" : "24",
    "hizb" : "47",
