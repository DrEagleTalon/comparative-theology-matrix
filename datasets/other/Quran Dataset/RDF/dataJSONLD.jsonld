    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:444",
    "ayah_text" : "وَكَأَيِّن مِّن نَّبِيّٖ قَٰتَلَ مَعَهُۥ رِبِّيُّونَ كَثِيرٞ فَمَا وَهَنُواْ لِمَآ أَصَابَهُمۡ فِي سَبِيلِ ٱللَّهِ وَمَا ضَعُفُواْ وَمَا ٱسۡتَكَانُواْۗ وَٱللَّهُ يُحِبُّ ٱلصَّٰبِرِينَ",
    "ayah_text_no_diacratic" : "وكاين من نبي قٰتل معه ربيون كثير فما وهنوا لما اصابهم في سبيل الله وما ضعفوا وما استكانوا والله يحب الصٰبرين",
    "ayahnumber" : "146",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "444",
    "page" : "68",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4440",
    "ayah_text" : "وَقَالُواْ لَوۡلَا نُزِّلَ هَٰذَا ٱلۡقُرۡءَانُ عَلَىٰ رَجُلٖ مِّنَ ٱلۡقَرۡيَتَيۡنِ عَظِيمٍ",
    "ayah_text_no_diacratic" : "وقالوا لولا نزل هٰذا القرءان علىٰ رجل من القريتين عظيم",
    "ayahnumber" : "31",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4440",
