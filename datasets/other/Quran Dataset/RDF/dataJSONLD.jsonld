    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:158",
    "ayah_text" : "وَلِكُلّٖ وِجۡهَةٌ هُوَ مُوَلِّيهَاۖ فَٱسۡتَبِقُواْ ٱلۡخَيۡرَٰتِۚ أَيۡنَ مَا تَكُونُواْ يَأۡتِ بِكُمُ ٱللَّهُ جَمِيعًاۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "ولكل وجهة هو موليها فاستبقوا الخيرٰت اين ما تكونوا يات بكم الله جميعا ان الله علىٰ كل شيء قدير",
    "ayahnumber" : "148",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "158",
    "page" : "23",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1580",
    "ayah_text" : "قَالُواْ يَٰشُعَيۡبُ أَصَلَوٰتُكَ تَأۡمُرُكَ أَن نَّتۡرُكَ مَا يَعۡبُدُ ءَابَآؤُنَآ أَوۡ أَن نَّفۡعَلَ فِيٓ أَمۡوَٰلِنَا مَا نَشَٰٓؤُاْۖ إِنَّكَ لَأَنتَ ٱلۡحَلِيمُ ٱلرَّشِيدُ",
    "ayah_text_no_diacratic" : "قالوا يٰشعيب اصلوٰتك تامرك ان نترك ما يعبد ءاباؤنا او ان نفعل في اموٰلنا ما نشٰؤا انك لانت الحليم الرشيد",
    "ayahnumber" : "87",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1580",
    "page" : "231",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1581",
    "ayah_text" : "قَالَ يَٰقَوۡمِ أَرَءَيۡتُمۡ إِن كُنتُ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّي وَرَزَقَنِي مِنۡهُ رِزۡقًا حَسَنٗاۚ وَمَآ أُرِيدُ أَنۡ أُخَالِفَكُمۡ إِلَىٰ مَآ أَنۡهَىٰكُمۡ عَنۡهُۚ إِنۡ أُرِيدُ إِلَّا ٱلۡإِصۡلَٰحَ مَا ٱسۡتَطَعۡتُۚ وَمَا تَوۡفِيقِيٓ إِلَّا بِٱللَّهِۚ عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ أُنِيبُ",
    "ayah_text_no_diacratic" : "قال يٰقوم ارءيتم ان كنت علىٰ بينة من ربي ورزقني منه رزقا حسنا وما اريد ان اخالفكم الىٰ ما انهىٰكم عنه ان اريد الا الاصلٰح ما استطعت وما توفيقي الا بالله عليه توكلت واليه انيب",
    "ayahnumber" : "88",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1581",
    "page" : "231",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1582",
    "ayah_text" : "وَيَٰقَوۡمِ لَا يَجۡرِمَنَّكُمۡ شِقَاقِيٓ أَن يُصِيبَكُم مِّثۡلُ مَآ أَصَابَ قَوۡمَ نُوحٍ أَوۡ قَوۡمَ هُودٍ أَوۡ قَوۡمَ صَٰلِحٖۚ وَمَا قَوۡمُ لُوطٖ مِّنكُم بِبَعِيدٖ",
    "ayah_text_no_diacratic" : "ويٰقوم لا يجرمنكم شقاقي ان يصيبكم مثل ما اصاب قوم نوح او قوم هود او قوم صٰلح وما قوم لوط منكم ببعيد",
    "ayahnumber" : "89",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1582",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1583",
    "ayah_text" : "وَٱسۡتَغۡفِرُواْ رَبَّكُمۡ ثُمَّ تُوبُوٓاْ إِلَيۡهِۚ إِنَّ رَبِّي رَحِيمٞ وَدُودٞ",
    "ayah_text_no_diacratic" : "واستغفروا ربكم ثم توبوا اليه ان ربي رحيم ودود",
    "ayahnumber" : "90",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1583",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1584",
    "ayah_text" : "قَالُواْ يَٰشُعَيۡبُ مَا نَفۡقَهُ كَثِيرٗا مِّمَّا تَقُولُ وَإِنَّا لَنَرَىٰكَ فِينَا ضَعِيفٗاۖ وَلَوۡلَا رَهۡطُكَ لَرَجَمۡنَٰكَۖ وَمَآ أَنتَ عَلَيۡنَا بِعَزِيزٖ",
    "ayah_text_no_diacratic" : "قالوا يٰشعيب ما نفقه كثيرا مما تقول وانا لنرىٰك فينا ضعيفا ولولا رهطك لرجمنٰك وما انت علينا بعزيز",
    "ayahnumber" : "91",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1584",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1585",
    "ayah_text" : "قَالَ يَٰقَوۡمِ أَرَهۡطِيٓ أَعَزُّ عَلَيۡكُم مِّنَ ٱللَّهِ وَٱتَّخَذۡتُمُوهُ وَرَآءَكُمۡ ظِهۡرِيًّاۖ إِنَّ رَبِّي بِمَا تَعۡمَلُونَ مُحِيطٞ",
    "ayah_text_no_diacratic" : "قال يٰقوم ارهطي اعز عليكم من الله واتخذتموه وراءكم ظهريا ان ربي بما تعملون محيط",
    "ayahnumber" : "92",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1585",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1586",
    "ayah_text" : "وَيَٰقَوۡمِ ٱعۡمَلُواْ عَلَىٰ مَكَانَتِكُمۡ إِنِّي عَٰمِلٞۖ سَوۡفَ تَعۡلَمُونَ مَن يَأۡتِيهِ عَذَابٞ يُخۡزِيهِ وَمَنۡ هُوَ كَٰذِبٞۖ وَٱرۡتَقِبُوٓاْ إِنِّي مَعَكُمۡ رَقِيبٞ",
    "ayah_text_no_diacratic" : "ويٰقوم اعملوا علىٰ مكانتكم اني عٰمل سوف تعلمون من ياتيه عذاب يخزيه ومن هو كٰذب وارتقبوا اني معكم رقيب",
    "ayahnumber" : "93",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1586",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1587",
    "ayah_text" : "وَلَمَّا جَآءَ أَمۡرُنَا نَجَّيۡنَا شُعَيۡبٗا وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ بِرَحۡمَةٖ مِّنَّا وَأَخَذَتِ ٱلَّذِينَ ظَلَمُواْ ٱلصَّيۡحَةُ فَأَصۡبَحُواْ فِي دِيَٰرِهِمۡ جَٰثِمِينَ",
    "ayah_text_no_diacratic" : "ولما جاء امرنا نجينا شعيبا والذين ءامنوا معه برحمة منا واخذت الذين ظلموا الصيحة فاصبحوا في ديٰرهم جٰثمين",
    "ayahnumber" : "94",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1587",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1588",
    "ayah_text" : "كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَآۗ أَلَا بُعۡدٗا لِّمَدۡيَنَ كَمَا بَعِدَتۡ ثَمُودُ",
    "ayah_text_no_diacratic" : "كان لم يغنوا فيها الا بعدا لمدين كما بعدت ثمود",
    "ayahnumber" : "95",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1588",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1589",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا مُوسَىٰ بِـَٔايَٰتِنَا وَسُلۡطَٰنٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا موسىٰ بايٰتنا وسلطٰن مبين",
    "ayahnumber" : "96",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1589",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:159",
    "ayah_text" : "وَمِنۡ حَيۡثُ خَرَجۡتَ فَوَلِّ وَجۡهَكَ شَطۡرَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِۖ وَإِنَّهُۥ لَلۡحَقُّ مِن رَّبِّكَۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ومن حيث خرجت فول وجهك شطر المسجد الحرام وانه للحق من ربك وما الله بغٰفل عما تعملون",
    "ayahnumber" : "149",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "159",
    "page" : "23",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1590",
    "ayah_text" : "إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦ فَٱتَّبَعُوٓاْ أَمۡرَ فِرۡعَوۡنَۖ وَمَآ أَمۡرُ فِرۡعَوۡنَ بِرَشِيدٖ",
    "ayah_text_no_diacratic" : "الىٰ فرعون وملايه فاتبعوا امر فرعون وما امر فرعون برشيد",
    "ayahnumber" : "97",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1590",
    "page" : "232",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1591",
    "ayah_text" : "يَقۡدُمُ قَوۡمَهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ فَأَوۡرَدَهُمُ ٱلنَّارَۖ وَبِئۡسَ ٱلۡوِرۡدُ ٱلۡمَوۡرُودُ",
    "ayah_text_no_diacratic" : "يقدم قومه يوم القيٰمة فاوردهم النار وبئس الورد المورود",
    "ayahnumber" : "98",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1591",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1592",
    "ayah_text" : "وَأُتۡبِعُواْ فِي هَٰذِهِۦ لَعۡنَةٗ وَيَوۡمَ ٱلۡقِيَٰمَةِۚ بِئۡسَ ٱلرِّفۡدُ ٱلۡمَرۡفُودُ",
    "ayah_text_no_diacratic" : "واتبعوا في هٰذه لعنة ويوم القيٰمة بئس الرفد المرفود",
    "ayahnumber" : "99",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1592",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1593",
    "ayah_text" : "ذَٰلِكَ مِنۡ أَنۢبَآءِ ٱلۡقُرَىٰ نَقُصُّهُۥ عَلَيۡكَۖ مِنۡهَا قَآئِمٞ وَحَصِيدٞ",
    "ayah_text_no_diacratic" : "ذٰلك من انباء القرىٰ نقصه عليك منها قائم وحصيد",
    "ayahnumber" : "100",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1593",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1594",
    "ayah_text" : "وَمَا ظَلَمۡنَٰهُمۡ وَلَٰكِن ظَلَمُوٓاْ أَنفُسَهُمۡۖ فَمَآ أَغۡنَتۡ عَنۡهُمۡ ءَالِهَتُهُمُ ٱلَّتِي يَدۡعُونَ مِن دُونِ ٱللَّهِ مِن شَيۡءٖ لَّمَّا جَآءَ أَمۡرُ رَبِّكَۖ وَمَا زَادُوهُمۡ غَيۡرَ تَتۡبِيبٖ",
    "ayah_text_no_diacratic" : "وما ظلمنٰهم ولٰكن ظلموا انفسهم فما اغنت عنهم ءالهتهم التي يدعون من دون الله من شيء لما جاء امر ربك وما زادوهم غير تتبيب",
    "ayahnumber" : "101",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1594",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1595",
    "ayah_text" : "وَكَذَٰلِكَ أَخۡذُ رَبِّكَ إِذَآ أَخَذَ ٱلۡقُرَىٰ وَهِيَ ظَٰلِمَةٌۚ إِنَّ أَخۡذَهُۥٓ أَلِيمٞ شَدِيدٌ",
    "ayah_text_no_diacratic" : "وكذٰلك اخذ ربك اذا اخذ القرىٰ وهي ظٰلمة ان اخذه اليم شديد",
    "ayahnumber" : "102",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1595",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1596",
    "ayah_text" : "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّمَنۡ خَافَ عَذَابَ ٱلۡأٓخِرَةِۚ ذَٰلِكَ يَوۡمٞ مَّجۡمُوعٞ لَّهُ ٱلنَّاسُ وَذَٰلِكَ يَوۡمٞ مَّشۡهُودٞ",
    "ayah_text_no_diacratic" : "ان في ذٰلك لاية لمن خاف عذاب الاخرة ذٰلك يوم مجموع له الناس وذٰلك يوم مشهود",
    "ayahnumber" : "103",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1596",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1597",
    "ayah_text" : "وَمَا نُؤَخِّرُهُۥٓ إِلَّا لِأَجَلٖ مَّعۡدُودٖ",
    "ayah_text_no_diacratic" : "وما نؤخره الا لاجل معدود",
    "ayahnumber" : "104",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1597",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1598",
    "ayah_text" : "يَوۡمَ يَأۡتِ لَا تَكَلَّمُ نَفۡسٌ إِلَّا بِإِذۡنِهِۦۚ فَمِنۡهُمۡ شَقِيّٞ وَسَعِيدٞ",
    "ayah_text_no_diacratic" : "يوم يات لا تكلم نفس الا باذنه فمنهم شقي وسعيد",
    "ayahnumber" : "105",
    "chapter" : "12",
