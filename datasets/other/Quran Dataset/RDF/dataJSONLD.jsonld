  }, {
    "@id" : "quran:3487",
    "ayah_text" : "وَمِنۡ ءَايَٰتِهِۦٓ أَنۡ خَلَقَكُم مِّن تُرَابٖ ثُمَّ إِذَآ أَنتُم بَشَرٞ تَنتَشِرُونَ",
    "ayah_text_no_diacratic" : "ومن ءايٰته ان خلقكم من تراب ثم اذا انتم بشر تنتشرون",
