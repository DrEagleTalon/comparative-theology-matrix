  }, {
    "@id" : "quran:3494",
    "ayah_text" : "وَهُوَ ٱلَّذِي يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥ وَهُوَ أَهۡوَنُ عَلَيۡهِۚ وَلَهُ ٱلۡمَثَلُ ٱلۡأَعۡلَىٰ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "وهو الذي يبدؤا الخلق ثم يعيده وهو اهون عليه وله المثل الاعلىٰ في السمٰوٰت والارض وهو العزيز الحكيم",
    "ayahnumber" : "27",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3494",
    "page" : "407",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3495",
    "ayah_text" : "ضَرَبَ لَكُم مَّثَلٗا مِّنۡ أَنفُسِكُمۡۖ هَل لَّكُم مِّن مَّا مَلَكَتۡ أَيۡمَٰنُكُم مِّن شُرَكَآءَ فِي مَا رَزَقۡنَٰكُمۡ فَأَنتُمۡ فِيهِ سَوَآءٞ تَخَافُونَهُمۡ كَخِيفَتِكُمۡ أَنفُسَكُمۡۚ كَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ضرب لكم مثلا من انفسكم هل لكم من ما ملكت ايمٰنكم من شركاء في ما رزقنٰكم فانتم فيه سواء تخافونهم كخيفتكم انفسكم كذٰلك نفصل الايٰت لقوم يعقلون",
    "ayahnumber" : "28",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3495",
    "page" : "407",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3496",
    "ayah_text" : "بَلِ ٱتَّبَعَ ٱلَّذِينَ ظَلَمُوٓاْ أَهۡوَآءَهُم بِغَيۡرِ عِلۡمٖۖ فَمَن يَهۡدِي مَنۡ أَضَلَّ ٱللَّهُۖ وَمَا لَهُم مِّن نَّٰصِرِينَ",
    "ayah_text_no_diacratic" : "بل اتبع الذين ظلموا اهواءهم بغير علم فمن يهدي من اضل الله وما لهم من نٰصرين",
    "ayahnumber" : "29",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3496",
    "page" : "407",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3497",
    "ayah_text" : "فَأَقِمۡ وَجۡهَكَ لِلدِّينِ حَنِيفٗاۚ فِطۡرَتَ ٱللَّهِ ٱلَّتِي فَطَرَ ٱلنَّاسَ عَلَيۡهَاۚ لَا تَبۡدِيلَ لِخَلۡقِ ٱللَّهِۚ ذَٰلِكَ ٱلدِّينُ ٱلۡقَيِّمُ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فاقم وجهك للدين حنيفا فطرت الله التي فطر الناس عليها لا تبديل لخلق الله ذٰلك الدين القيم ولٰكن اكثر الناس لا يعلمون",
    "ayahnumber" : "30",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3497",
    "page" : "407",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3498",
    "ayah_text" : "۞مُنِيبِينَ إِلَيۡهِ وَٱتَّقُوهُ وَأَقِيمُواْ ٱلصَّلَوٰةَ وَلَا تَكُونُواْ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "منيبين اليه واتقوه واقيموا الصلوٰة ولا تكونوا من المشركين",
    "ayahnumber" : "31",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3498",
    "page" : "407",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3499",
    "ayah_text" : "مِنَ ٱلَّذِينَ فَرَّقُواْ دِينَهُمۡ وَكَانُواْ شِيَعٗاۖ كُلُّ حِزۡبِۭ بِمَا لَدَيۡهِمۡ فَرِحُونَ",
    "ayah_text_no_diacratic" : "من الذين فرقوا دينهم وكانوا شيعا كل حزب بما لديهم فرحون",
    "ayahnumber" : "32",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3499",
    "page" : "407",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:35",
    "ayah_text" : "وَبَشِّرِ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ كُلَّمَا رُزِقُواْ مِنۡهَا مِن ثَمَرَةٖ رِّزۡقٗا قَالُواْ هَٰذَا ٱلَّذِي رُزِقۡنَا مِن قَبۡلُۖ وَأُتُواْ بِهِۦ مُتَشَٰبِهٗاۖ وَلَهُمۡ فِيهَآ أَزۡوَٰجٞ مُّطَهَّرَةٞۖ وَهُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "وبشر الذين ءامنوا وعملوا الصٰلحٰت ان لهم جنٰت تجري من تحتها الانهٰر كلما رزقوا منها من ثمرة رزقا قالوا هٰذا الذي رزقنا من قبل واتوا به متشٰبها ولهم فيها ازوٰج مطهرة وهم فيها خٰلدون",
    "ayahnumber" : "25",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "35",
    "page" : "5",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:350",
    "ayah_text" : "۞فَلَمَّآ أَحَسَّ عِيسَىٰ مِنۡهُمُ ٱلۡكُفۡرَ قَالَ مَنۡ أَنصَارِيٓ إِلَى ٱللَّهِۖ قَالَ ٱلۡحَوَارِيُّونَ نَحۡنُ أَنصَارُ ٱللَّهِ ءَامَنَّا بِٱللَّهِ وَٱشۡهَدۡ بِأَنَّا مُسۡلِمُونَ",
    "ayah_text_no_diacratic" : "فلما احس عيسىٰ منهم الكفر قال من انصاري الى الله قال الحواريون نحن انصار الله ءامنا بالله واشهد بانا مسلمون",
    "ayahnumber" : "52",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "350",
    "page" : "56",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3500",
    "ayah_text" : "وَإِذَا مَسَّ ٱلنَّاسَ ضُرّٞ دَعَوۡاْ رَبَّهُم مُّنِيبِينَ إِلَيۡهِ ثُمَّ إِذَآ أَذَاقَهُم مِّنۡهُ رَحۡمَةً إِذَا فَرِيقٞ مِّنۡهُم بِرَبِّهِمۡ يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "واذا مس الناس ضر دعوا ربهم منيبين اليه ثم اذا اذاقهم منه رحمة اذا فريق منهم بربهم يشركون",
    "ayahnumber" : "33",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3500",
    "page" : "408",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3501",
    "ayah_text" : "لِيَكۡفُرُواْ بِمَآ ءَاتَيۡنَٰهُمۡۚ فَتَمَتَّعُواْ فَسَوۡفَ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ليكفروا بما ءاتينٰهم فتمتعوا فسوف تعلمون",
    "ayahnumber" : "34",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3501",
    "page" : "408",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3502",
    "ayah_text" : "أَمۡ أَنزَلۡنَا عَلَيۡهِمۡ سُلۡطَٰنٗا فَهُوَ يَتَكَلَّمُ بِمَا كَانُواْ بِهِۦ يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "ام انزلنا عليهم سلطٰنا فهو يتكلم بما كانوا به يشركون",
    "ayahnumber" : "35",
    "chapter" : "21",
    "hizb" : "40",
    "index" : "3502",
    "page" : "408",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3503",
    "ayah_text" : "وَإِذَآ أَذَقۡنَا ٱلنَّاسَ رَحۡمَةٗ فَرِحُواْ بِهَاۖ وَإِن تُصِبۡهُمۡ سَيِّئَةُۢ بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ إِذَا هُمۡ يَقۡنَطُونَ",
    "ayah_text_no_diacratic" : "واذا اذقنا الناس رحمة فرحوا بها وان تصبهم سيئة بما قدمت ايديهم اذا هم يقنطون",
    "ayahnumber" : "36",
    "chapter" : "21",
    "hizb" : "40",
