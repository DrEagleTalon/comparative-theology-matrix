    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3956",
    "ayah_text" : "وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "والله خلقكم وما تعملون",
