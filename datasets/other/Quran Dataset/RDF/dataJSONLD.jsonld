    "page" : "512",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4692",
    "ayah_text" : "سَيَقُولُ ٱلۡمُخَلَّفُونَ إِذَا ٱنطَلَقۡتُمۡ إِلَىٰ مَغَانِمَ لِتَأۡخُذُوهَا ذَرُونَا نَتَّبِعۡكُمۡۖ يُرِيدُونَ أَن يُبَدِّلُواْ كَلَٰمَ ٱللَّهِۚ قُل لَّن تَتَّبِعُونَا كَذَٰلِكُمۡ قَالَ ٱللَّهُ مِن قَبۡلُۖ فَسَيَقُولُونَ بَلۡ تَحۡسُدُونَنَاۚ بَلۡ كَانُواْ لَا يَفۡقَهُونَ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "سيقول المخلفون اذا انطلقتم الىٰ مغانم لتاخذوها ذرونا نتبعكم يريدون ان يبدلوا كلٰم الله قل لن تتبعونا كذٰلكم قال الله من قبل فسيقولون بل تحسدوننا بل كانوا لا يفقهون الا قليلا",
    "ayahnumber" : "15",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4692",
    "page" : "512",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4693",
    "ayah_text" : "قُل لِّلۡمُخَلَّفِينَ مِنَ ٱلۡأَعۡرَابِ سَتُدۡعَوۡنَ إِلَىٰ قَوۡمٍ أُوْلِي بَأۡسٖ شَدِيدٖ تُقَٰتِلُونَهُمۡ أَوۡ يُسۡلِمُونَۖ فَإِن تُطِيعُواْ يُؤۡتِكُمُ ٱللَّهُ أَجۡرًا حَسَنٗاۖ وَإِن تَتَوَلَّوۡاْ كَمَا تَوَلَّيۡتُم مِّن قَبۡلُ يُعَذِّبۡكُمۡ عَذَابًا أَلِيمٗا",
    "ayah_text_no_diacratic" : "قل للمخلفين من الاعراب ستدعون الىٰ قوم اولي باس شديد تقٰتلونهم او يسلمون فان تطيعوا يؤتكم الله اجرا حسنا وان تتولوا كما توليتم من قبل يعذبكم عذابا اليما",
    "ayahnumber" : "16",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4693",
    "page" : "513",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4694",
    "ayah_text" : "لَّيۡسَ عَلَى ٱلۡأَعۡمَىٰ حَرَجٞ وَلَا عَلَى ٱلۡأَعۡرَجِ حَرَجٞ وَلَا عَلَى ٱلۡمَرِيضِ حَرَجٞۗ وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ يُدۡخِلۡهُ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ وَمَن يَتَوَلَّ يُعَذِّبۡهُ عَذَابًا أَلِيمٗا",
    "ayah_text_no_diacratic" : "ليس على الاعمىٰ حرج ولا على الاعرج حرج ولا على المريض حرج ومن يطع الله ورسوله يدخله جنٰت تجري من تحتها الانهٰر ومن يتول يعذبه عذابا اليما",
    "ayahnumber" : "17",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4694",
    "page" : "513",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4695",
    "ayah_text" : "۞لَّقَدۡ رَضِيَ ٱللَّهُ عَنِ ٱلۡمُؤۡمِنِينَ إِذۡ يُبَايِعُونَكَ تَحۡتَ ٱلشَّجَرَةِ فَعَلِمَ مَا فِي قُلُوبِهِمۡ فَأَنزَلَ ٱلسَّكِينَةَ عَلَيۡهِمۡ وَأَثَٰبَهُمۡ فَتۡحٗا قَرِيبٗا",
    "ayah_text_no_diacratic" : "لقد رضي الله عن المؤمنين اذ يبايعونك تحت الشجرة فعلم ما في قلوبهم فانزل السكينة عليهم واثٰبهم فتحا قريبا",
    "ayahnumber" : "18",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4695",
    "page" : "513",
    "surahname" : "سُورَةُ الفَتۡحِ",
