    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4412",
    "ayah_text" : "إِنَّا جَعَلۡنَٰهُ قُرۡءَٰنًا عَرَبِيّٗا لَّعَلَّكُمۡ تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "انا جعلنٰه قرءٰنا عربيا لعلكم تعقلون",
    "ayahnumber" : "3",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4412",
    "page" : "489",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4413",
    "ayah_text" : "وَإِنَّهُۥ فِيٓ أُمِّ ٱلۡكِتَٰبِ لَدَيۡنَا لَعَلِيٌّ حَكِيمٌ",
    "ayah_text_no_diacratic" : "وانه في ام الكتٰب لدينا لعلي حكيم",
    "ayahnumber" : "4",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4413",
    "page" : "489",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4414",
    "ayah_text" : "أَفَنَضۡرِبُ عَنكُمُ ٱلذِّكۡرَ صَفۡحًا أَن كُنتُمۡ قَوۡمٗا مُّسۡرِفِينَ",
    "ayah_text_no_diacratic" : "افنضرب عنكم الذكر صفحا ان كنتم قوما مسرفين",
    "ayahnumber" : "5",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4414",
    "page" : "489",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4415",
    "ayah_text" : "وَكَمۡ أَرۡسَلۡنَا مِن نَّبِيّٖ فِي ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "وكم ارسلنا من نبي في الاولين",
    "ayahnumber" : "6",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4415",
    "page" : "489",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4416",
    "ayah_text" : "وَمَا يَأۡتِيهِم مِّن نَّبِيٍّ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "وما ياتيهم من نبي الا كانوا به يستهزءون",
    "ayahnumber" : "7",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4416",
    "page" : "489",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4417",
    "ayah_text" : "فَأَهۡلَكۡنَآ أَشَدَّ مِنۡهُم بَطۡشٗا وَمَضَىٰ مَثَلُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "فاهلكنا اشد منهم بطشا ومضىٰ مثل الاولين",
    "ayahnumber" : "8",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4417",
    "page" : "489",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4418",
    "ayah_text" : "وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ لَيَقُولُنَّ خَلَقَهُنَّ ٱلۡعَزِيزُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "ولئن سالتهم من خلق السمٰوٰت والارض ليقولن خلقهن العزيز العليم",
    "ayahnumber" : "9",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4418",
    "page" : "489",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4419",
    "ayah_text" : "ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ مَهۡدٗا وَجَعَلَ لَكُمۡ فِيهَا سُبُلٗا لَّعَلَّكُمۡ تَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "الذي جعل لكم الارض مهدا وجعل لكم فيها سبلا لعلكم تهتدون",
    "ayahnumber" : "10",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4419",
    "page" : "489",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:442",
    "ayah_text" : "وَمَا مُحَمَّدٌ إِلَّا رَسُولٞ قَدۡ خَلَتۡ مِن قَبۡلِهِ ٱلرُّسُلُۚ أَفَإِيْن مَّاتَ أَوۡ قُتِلَ ٱنقَلَبۡتُمۡ عَلَىٰٓ أَعۡقَٰبِكُمۡۚ وَمَن يَنقَلِبۡ عَلَىٰ عَقِبَيۡهِ فَلَن يَضُرَّ ٱللَّهَ شَيۡـٔٗاۚ وَسَيَجۡزِي ٱللَّهُ ٱلشَّٰكِرِينَ",
    "ayah_text_no_diacratic" : "وما محمد الا رسول قد خلت من قبله الرسل افاين مات او قتل انقلبتم علىٰ اعقٰبكم ومن ينقلب علىٰ عقبيه فلن يضر الله شيا وسيجزي الله الشٰكرين",
    "ayahnumber" : "144",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "442",
    "page" : "68",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4420",
    "ayah_text" : "وَٱلَّذِي نَزَّلَ مِنَ ٱلسَّمَآءِ مَآءَۢ بِقَدَرٖ فَأَنشَرۡنَا بِهِۦ بَلۡدَةٗ مَّيۡتٗاۚ كَذَٰلِكَ تُخۡرَجُونَ",
    "ayah_text_no_diacratic" : "والذي نزل من السماء ماء بقدر فانشرنا به بلدة ميتا كذٰلك تخرجون",
    "ayahnumber" : "11",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4420",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4421",
    "ayah_text" : "وَٱلَّذِي خَلَقَ ٱلۡأَزۡوَٰجَ كُلَّهَا وَجَعَلَ لَكُم مِّنَ ٱلۡفُلۡكِ وَٱلۡأَنۡعَٰمِ مَا تَرۡكَبُونَ",
    "ayah_text_no_diacratic" : "والذي خلق الازوٰج كلها وجعل لكم من الفلك والانعٰم ما تركبون",
    "ayahnumber" : "12",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4421",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4422",
    "ayah_text" : "لِتَسۡتَوُۥاْ عَلَىٰ ظُهُورِهِۦ ثُمَّ تَذۡكُرُواْ نِعۡمَةَ رَبِّكُمۡ إِذَا ٱسۡتَوَيۡتُمۡ عَلَيۡهِ وَتَقُولُواْ سُبۡحَٰنَ ٱلَّذِي سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُۥ مُقۡرِنِينَ",
    "ayah_text_no_diacratic" : "لتستوا علىٰ ظهوره ثم تذكروا نعمة ربكم اذا استويتم عليه وتقولوا سبحٰن الذي سخر لنا هٰذا وما كنا له مقرنين",
    "ayahnumber" : "13",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4422",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4423",
    "ayah_text" : "وَإِنَّآ إِلَىٰ رَبِّنَا لَمُنقَلِبُونَ",
    "ayah_text_no_diacratic" : "وانا الىٰ ربنا لمنقلبون",
    "ayahnumber" : "14",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4423",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4424",
    "ayah_text" : "وَجَعَلُواْ لَهُۥ مِنۡ عِبَادِهِۦ جُزۡءًاۚ إِنَّ ٱلۡإِنسَٰنَ لَكَفُورٞ مُّبِينٌ",
    "ayah_text_no_diacratic" : "وجعلوا له من عباده جزءا ان الانسٰن لكفور مبين",
    "ayahnumber" : "15",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4424",
