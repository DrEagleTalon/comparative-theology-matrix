    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3932",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا فيهم منذرين",
