  }, {
    "@id" : "quran:391",
    "ayah_text" : "۞كُلُّ ٱلطَّعَامِ كَانَ حِلّٗا لِّبَنِيٓ إِسۡرَٰٓءِيلَ إِلَّا مَا حَرَّمَ إِسۡرَٰٓءِيلُ عَلَىٰ نَفۡسِهِۦ مِن قَبۡلِ أَن تُنَزَّلَ ٱلتَّوۡرَىٰةُۚ قُلۡ فَأۡتُواْ بِٱلتَّوۡرَىٰةِ فَٱتۡلُوهَآ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "كل الطعام كان حلا لبني اسرٰءيل الا ما حرم اسرٰءيل علىٰ نفسه من قبل ان تنزل التورىٰة قل فاتوا بالتورىٰة فاتلوها ان كنتم صٰدقين",
    "ayahnumber" : "93",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "391",
    "page" : "62",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3910",
    "ayah_text" : "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ",
    "ayah_text_no_diacratic" : "فاقبل بعضهم علىٰ بعض يتساءلون",
    "ayahnumber" : "50",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3910",
