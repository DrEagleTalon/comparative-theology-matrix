    "hizb" : "37",
    "index" : "3081",
    "page" : "371",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3082",
    "ayah_text" : "فَمَا لَنَا مِن شَٰفِعِينَ",
    "ayah_text_no_diacratic" : "فما لنا من شٰفعين",
    "ayahnumber" : "100",
    "chapter" : "19",
