    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3043",
    "ayah_text" : "فَلَمَّا تَرَٰٓءَا ٱلۡجَمۡعَانِ قَالَ أَصۡحَٰبُ مُوسَىٰٓ إِنَّا لَمُدۡرَكُونَ",
    "ayah_text_no_diacratic" : "فلما ترٰءا الجمعان قال اصحٰب موسىٰ انا لمدركون",
