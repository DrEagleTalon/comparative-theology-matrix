    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4652",
    "ayah_text" : "مَّثَلُ ٱلۡجَنَّةِ ٱلَّتِي وُعِدَ ٱلۡمُتَّقُونَۖ فِيهَآ أَنۡهَٰرٞ مِّن مَّآءٍ غَيۡرِ ءَاسِنٖ وَأَنۡهَٰرٞ مِّن لَّبَنٖ لَّمۡ يَتَغَيَّرۡ طَعۡمُهُۥ وَأَنۡهَٰرٞ مِّنۡ خَمۡرٖ لَّذَّةٖ لِّلشَّٰرِبِينَ وَأَنۡهَٰرٞ مِّنۡ عَسَلٖ مُّصَفّٗىۖ وَلَهُمۡ فِيهَا مِن كُلِّ ٱلثَّمَرَٰتِ وَمَغۡفِرَةٞ مِّن رَّبِّهِمۡۖ كَمَنۡ هُوَ خَٰلِدٞ فِي ٱلنَّارِ وَسُقُواْ مَآءً حَمِيمٗا فَقَطَّعَ أَمۡعَآءَهُمۡ",
    "ayah_text_no_diacratic" : "مثل الجنة التي وعد المتقون فيها انهٰر من ماء غير ءاسن وانهٰر من لبن لم يتغير طعمه وانهٰر من خمر لذة للشٰربين وانهٰر من عسل مصفى ولهم فيها من كل الثمرٰت ومغفرة من ربهم كمن هو خٰلد في النار وسقوا ماء حميما فقطع امعاءهم",
    "ayahnumber" : "15",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4652",
    "page" : "508",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4653",
    "ayah_text" : "وَمِنۡهُم مَّن يَسۡتَمِعُ إِلَيۡكَ حَتَّىٰٓ إِذَا خَرَجُواْ مِنۡ عِندِكَ قَالُواْ لِلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ مَاذَا قَالَ ءَانِفًاۚ أُوْلَٰٓئِكَ ٱلَّذِينَ طَبَعَ ٱللَّهُ عَلَىٰ قُلُوبِهِمۡ وَٱتَّبَعُوٓاْ أَهۡوَآءَهُمۡ",
    "ayah_text_no_diacratic" : "ومنهم من يستمع اليك حتىٰ اذا خرجوا من عندك قالوا للذين اوتوا العلم ماذا قال ءانفا اولٰئك الذين طبع الله علىٰ قلوبهم واتبعوا اهواءهم",
    "ayahnumber" : "16",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4653",
    "page" : "508",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4654",
    "ayah_text" : "وَٱلَّذِينَ ٱهۡتَدَوۡاْ زَادَهُمۡ هُدٗى وَءَاتَىٰهُمۡ تَقۡوَىٰهُمۡ",
    "ayah_text_no_diacratic" : "والذين اهتدوا زادهم هدى وءاتىٰهم تقوىٰهم",
    "ayahnumber" : "17",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4654",
    "page" : "508",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4655",
    "ayah_text" : "فَهَلۡ يَنظُرُونَ إِلَّا ٱلسَّاعَةَ أَن تَأۡتِيَهُم بَغۡتَةٗۖ فَقَدۡ جَآءَ أَشۡرَاطُهَاۚ فَأَنَّىٰ لَهُمۡ إِذَا جَآءَتۡهُمۡ ذِكۡرَىٰهُمۡ",
    "ayah_text_no_diacratic" : "فهل ينظرون الا الساعة ان تاتيهم بغتة فقد جاء اشراطها فانىٰ لهم اذا جاءتهم ذكرىٰهم",
    "ayahnumber" : "18",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4655",
    "page" : "508",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4656",
    "ayah_text" : "فَٱعۡلَمۡ أَنَّهُۥ لَآ إِلَٰهَ إِلَّا ٱللَّهُ وَٱسۡتَغۡفِرۡ لِذَنۢبِكَ وَلِلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِۗ وَٱللَّهُ يَعۡلَمُ مُتَقَلَّبَكُمۡ وَمَثۡوَىٰكُمۡ",
    "ayah_text_no_diacratic" : "فاعلم انه لا الٰه الا الله واستغفر لذنبك وللمؤمنين والمؤمنٰت والله يعلم متقلبكم ومثوىٰكم",
    "ayahnumber" : "19",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4656",
    "page" : "508",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4657",
    "ayah_text" : "وَيَقُولُ ٱلَّذِينَ ءَامَنُواْ لَوۡلَا نُزِّلَتۡ سُورَةٞۖ فَإِذَآ أُنزِلَتۡ سُورَةٞ مُّحۡكَمَةٞ وَذُكِرَ فِيهَا ٱلۡقِتَالُ رَأَيۡتَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ يَنظُرُونَ إِلَيۡكَ نَظَرَ ٱلۡمَغۡشِيِّ عَلَيۡهِ مِنَ ٱلۡمَوۡتِۖ فَأَوۡلَىٰ لَهُمۡ",
    "ayah_text_no_diacratic" : "ويقول الذين ءامنوا لولا نزلت سورة فاذا انزلت سورة محكمة وذكر فيها القتال رايت الذين في قلوبهم مرض ينظرون اليك نظر المغشي عليه من الموت فاولىٰ لهم",
    "ayahnumber" : "20",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4657",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4658",
    "ayah_text" : "طَاعَةٞ وَقَوۡلٞ مَّعۡرُوفٞۚ فَإِذَا عَزَمَ ٱلۡأَمۡرُ فَلَوۡ صَدَقُواْ ٱللَّهَ لَكَانَ خَيۡرٗا لَّهُمۡ",
    "ayah_text_no_diacratic" : "طاعة وقول معروف فاذا عزم الامر فلو صدقوا الله لكان خيرا لهم",
    "ayahnumber" : "21",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4658",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4659",
    "ayah_text" : "فَهَلۡ عَسَيۡتُمۡ إِن تَوَلَّيۡتُمۡ أَن تُفۡسِدُواْ فِي ٱلۡأَرۡضِ وَتُقَطِّعُوٓاْ أَرۡحَامَكُمۡ",
    "ayah_text_no_diacratic" : "فهل عسيتم ان توليتم ان تفسدوا في الارض وتقطعوا ارحامكم",
    "ayahnumber" : "22",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4659",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:466",
    "ayah_text" : "ٱلَّذِينَ قَالُواْ لِإِخۡوَٰنِهِمۡ وَقَعَدُواْ لَوۡ أَطَاعُونَا مَا قُتِلُواْۗ قُلۡ فَٱدۡرَءُواْ عَنۡ أَنفُسِكُمُ ٱلۡمَوۡتَ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "الذين قالوا لاخوٰنهم وقعدوا لو اطاعونا ما قتلوا قل فادرءوا عن انفسكم الموت ان كنتم صٰدقين",
    "ayahnumber" : "168",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "466",
    "page" : "72",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4660",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ لَعَنَهُمُ ٱللَّهُ فَأَصَمَّهُمۡ وَأَعۡمَىٰٓ أَبۡصَٰرَهُمۡ",
    "ayah_text_no_diacratic" : "اولٰئك الذين لعنهم الله فاصمهم واعمىٰ ابصٰرهم",
    "ayahnumber" : "23",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4660",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4661",
    "ayah_text" : "أَفَلَا يَتَدَبَّرُونَ ٱلۡقُرۡءَانَ أَمۡ عَلَىٰ قُلُوبٍ أَقۡفَالُهَآ",
    "ayah_text_no_diacratic" : "افلا يتدبرون القرءان ام علىٰ قلوب اقفالها",
    "ayahnumber" : "24",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4661",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4662",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ٱرۡتَدُّواْ عَلَىٰٓ أَدۡبَٰرِهِم مِّنۢ بَعۡدِ مَا تَبَيَّنَ لَهُمُ ٱلۡهُدَى ٱلشَّيۡطَٰنُ سَوَّلَ لَهُمۡ وَأَمۡلَىٰ لَهُمۡ",
    "ayah_text_no_diacratic" : "ان الذين ارتدوا علىٰ ادبٰرهم من بعد ما تبين لهم الهدى الشيطٰن سول لهم واملىٰ لهم",
    "ayahnumber" : "25",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4662",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4663",
    "ayah_text" : "ذَٰلِكَ بِأَنَّهُمۡ قَالُواْ لِلَّذِينَ كَرِهُواْ مَا نَزَّلَ ٱللَّهُ سَنُطِيعُكُمۡ فِي بَعۡضِ ٱلۡأَمۡرِۖ وَٱللَّهُ يَعۡلَمُ إِسۡرَارَهُمۡ",
    "ayah_text_no_diacratic" : "ذٰلك بانهم قالوا للذين كرهوا ما نزل الله سنطيعكم في بعض الامر والله يعلم اسرارهم",
    "ayahnumber" : "26",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4663",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4664",
    "ayah_text" : "فَكَيۡفَ إِذَا تَوَفَّتۡهُمُ ٱلۡمَلَٰٓئِكَةُ يَضۡرِبُونَ وُجُوهَهُمۡ وَأَدۡبَٰرَهُمۡ",
    "ayah_text_no_diacratic" : "فكيف اذا توفتهم الملٰئكة يضربون وجوههم وادبٰرهم",
    "ayahnumber" : "27",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4664",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4665",
    "ayah_text" : "ذَٰلِكَ بِأَنَّهُمُ ٱتَّبَعُواْ مَآ أَسۡخَطَ ٱللَّهَ وَكَرِهُواْ رِضۡوَٰنَهُۥ فَأَحۡبَطَ أَعۡمَٰلَهُمۡ",
    "ayah_text_no_diacratic" : "ذٰلك بانهم اتبعوا ما اسخط الله وكرهوا رضوٰنه فاحبط اعمٰلهم",
    "ayahnumber" : "28",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4665",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4666",
    "ayah_text" : "أَمۡ حَسِبَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٌ أَن لَّن يُخۡرِجَ ٱللَّهُ أَضۡغَٰنَهُمۡ",
    "ayah_text_no_diacratic" : "ام حسب الذين في قلوبهم مرض ان لن يخرج الله اضغٰنهم",
    "ayahnumber" : "29",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4666",
    "page" : "509",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4667",
    "ayah_text" : "وَلَوۡ نَشَآءُ لَأَرَيۡنَٰكَهُمۡ فَلَعَرَفۡتَهُم بِسِيمَٰهُمۡۚ وَلَتَعۡرِفَنَّهُمۡ فِي لَحۡنِ ٱلۡقَوۡلِۚ وَٱللَّهُ يَعۡلَمُ أَعۡمَٰلَكُمۡ",
    "ayah_text_no_diacratic" : "ولو نشاء لارينٰكهم فلعرفتهم بسيمٰهم ولتعرفنهم في لحن القول والله يعلم اعمٰلكم",
    "ayahnumber" : "30",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4667",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4668",
    "ayah_text" : "وَلَنَبۡلُوَنَّكُمۡ حَتَّىٰ نَعۡلَمَ ٱلۡمُجَٰهِدِينَ مِنكُمۡ وَٱلصَّٰبِرِينَ وَنَبۡلُوَاْ أَخۡبَارَكُمۡ",
    "ayah_text_no_diacratic" : "ولنبلونكم حتىٰ نعلم المجٰهدين منكم والصٰبرين ونبلوا اخباركم",
    "ayahnumber" : "31",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4668",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4669",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ وَصَدُّواْ عَن سَبِيلِ ٱللَّهِ وَشَآقُّواْ ٱلرَّسُولَ مِنۢ بَعۡدِ مَا تَبَيَّنَ لَهُمُ ٱلۡهُدَىٰ لَن يَضُرُّواْ ٱللَّهَ شَيۡـٔٗا وَسَيُحۡبِطُ أَعۡمَٰلَهُمۡ",
    "ayah_text_no_diacratic" : "ان الذين كفروا وصدوا عن سبيل الله وشاقوا الرسول من بعد ما تبين لهم الهدىٰ لن يضروا الله شيا وسيحبط اعمٰلهم",
    "ayahnumber" : "32",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4669",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:467",
    "ayah_text" : "وَلَا تَحۡسَبَنَّ ٱلَّذِينَ قُتِلُواْ فِي سَبِيلِ ٱللَّهِ أَمۡوَٰتَۢاۚ بَلۡ أَحۡيَآءٌ عِندَ رَبِّهِمۡ يُرۡزَقُونَ",
    "ayah_text_no_diacratic" : "ولا تحسبن الذين قتلوا في سبيل الله اموٰتا بل احياء عند ربهم يرزقون",
    "ayahnumber" : "169",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "467",
    "page" : "72",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4670",
    "ayah_text" : "۞يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَطِيعُواْ ٱللَّهَ وَأَطِيعُواْ ٱلرَّسُولَ وَلَا تُبۡطِلُوٓاْ أَعۡمَٰلَكُمۡ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اطيعوا الله واطيعوا الرسول ولا تبطلوا اعمٰلكم",
    "ayahnumber" : "33",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4670",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4671",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ وَصَدُّواْ عَن سَبِيلِ ٱللَّهِ ثُمَّ مَاتُواْ وَهُمۡ كُفَّارٞ فَلَن يَغۡفِرَ ٱللَّهُ لَهُمۡ",
    "ayah_text_no_diacratic" : "ان الذين كفروا وصدوا عن سبيل الله ثم ماتوا وهم كفار فلن يغفر الله لهم",
    "ayahnumber" : "34",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4671",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4672",
    "ayah_text" : "فَلَا تَهِنُواْ وَتَدۡعُوٓاْ إِلَى ٱلسَّلۡمِ وَأَنتُمُ ٱلۡأَعۡلَوۡنَ وَٱللَّهُ مَعَكُمۡ وَلَن يَتِرَكُمۡ أَعۡمَٰلَكُمۡ",
    "ayah_text_no_diacratic" : "فلا تهنوا وتدعوا الى السلم وانتم الاعلون والله معكم ولن يتركم اعمٰلكم",
    "ayahnumber" : "35",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4672",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4673",
    "ayah_text" : "إِنَّمَا ٱلۡحَيَوٰةُ ٱلدُّنۡيَا لَعِبٞ وَلَهۡوٞۚ وَإِن تُؤۡمِنُواْ وَتَتَّقُواْ يُؤۡتِكُمۡ أُجُورَكُمۡ وَلَا يَسۡـَٔلۡكُمۡ أَمۡوَٰلَكُمۡ",
    "ayah_text_no_diacratic" : "انما الحيوٰة الدنيا لعب ولهو وان تؤمنوا وتتقوا يؤتكم اجوركم ولا يسلكم اموٰلكم",
    "ayahnumber" : "36",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4673",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4674",
    "ayah_text" : "إِن يَسۡـَٔلۡكُمُوهَا فَيُحۡفِكُمۡ تَبۡخَلُواْ وَيُخۡرِجۡ أَضۡغَٰنَكُمۡ",
    "ayah_text_no_diacratic" : "ان يسلكموها فيحفكم تبخلوا ويخرج اضغٰنكم",
    "ayahnumber" : "37",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4674",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4675",
    "ayah_text" : "هَٰٓأَنتُمۡ هَٰٓؤُلَآءِ تُدۡعَوۡنَ لِتُنفِقُواْ فِي سَبِيلِ ٱللَّهِ فَمِنكُم مَّن يَبۡخَلُۖ وَمَن يَبۡخَلۡ فَإِنَّمَا يَبۡخَلُ عَن نَّفۡسِهِۦۚ وَٱللَّهُ ٱلۡغَنِيُّ وَأَنتُمُ ٱلۡفُقَرَآءُۚ وَإِن تَتَوَلَّوۡاْ يَسۡتَبۡدِلۡ قَوۡمًا غَيۡرَكُمۡ ثُمَّ لَا يَكُونُوٓاْ أَمۡثَٰلَكُم",
    "ayah_text_no_diacratic" : "هٰانتم هٰؤلاء تدعون لتنفقوا في سبيل الله فمنكم من يبخل ومن يبخل فانما يبخل عن نفسه والله الغني وانتم الفقراء وان تتولوا يستبدل قوما غيركم ثم لا يكونوا امثٰلكم",
    "ayahnumber" : "38",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4675",
    "page" : "510",
    "surahname" : "سُورَةُ مُحَمَّدٍ",
    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4676",
    "ayah_text" : "سُورَةُ الفَتۡحِ",
