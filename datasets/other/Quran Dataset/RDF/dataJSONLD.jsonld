  }, {
    "@id" : "quran:2743",
    "ayah_text" : "قَالَ رَبِّ ٱنصُرۡنِي بِمَا كَذَّبُونِ",
    "ayah_text_no_diacratic" : "قال رب انصرني بما كذبون",
    "ayahnumber" : "26",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2743",
