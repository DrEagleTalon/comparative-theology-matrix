  }, {
    "@id" : "quran:2377",
    "ayah_text" : "أَن دَعَوۡاْ لِلرَّحۡمَٰنِ وَلَدٗا",
    "ayah_text_no_diacratic" : "ان دعوا للرحمٰن ولدا",
    "ayahnumber" : "91",
    "chapter" : "16",
