  }, {
    "@id" : "quran:2685",
    "ayah_text" : "وَكَأَيِّن مِّن قَرۡيَةٍ أَمۡلَيۡتُ لَهَا وَهِيَ ظَالِمَةٞ ثُمَّ أَخَذۡتُهَا وَإِلَيَّ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "وكاين من قرية امليت لها وهي ظالمة ثم اخذتها والي المصير",
    "ayahnumber" : "48",
