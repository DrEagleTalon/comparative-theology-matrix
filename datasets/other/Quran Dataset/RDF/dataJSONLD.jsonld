  }, {
    "@id" : "quran:4497",
    "ayah_text" : "وَقِيلِهِۦ يَٰرَبِّ إِنَّ هَٰٓؤُلَآءِ قَوۡمٞ لَّا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "وقيله يٰرب ان هٰؤلاء قوم لا يؤمنون",
