  }, {
    "@id" : "quran:4727",
    "ayah_text" : "سُورَةُ قٓ",
    "ayah_text_no_diacratic" : "سورة ق",
    "ayahnumber" : "0",
    "chapter" : "26",
    "hizb" : "51",
