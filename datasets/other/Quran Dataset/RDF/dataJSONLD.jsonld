    "page" : "432",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:371",
    "ayah_text" : "وَلَا تُؤۡمِنُوٓاْ إِلَّا لِمَن تَبِعَ دِينَكُمۡ قُلۡ إِنَّ ٱلۡهُدَىٰ هُدَى ٱللَّهِ أَن يُؤۡتَىٰٓ أَحَدٞ مِّثۡلَ مَآ أُوتِيتُمۡ أَوۡ يُحَآجُّوكُمۡ عِندَ رَبِّكُمۡۗ قُلۡ إِنَّ ٱلۡفَضۡلَ بِيَدِ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "ولا تؤمنوا الا لمن تبع دينكم قل ان الهدىٰ هدى الله ان يؤتىٰ احد مثل ما اوتيتم او يحاجوكم عند ربكم قل ان الفضل بيد الله يؤتيه من يشاء والله وٰسع عليم",
    "ayahnumber" : "73",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "371",
    "page" : "59",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3710",
    "ayah_text" : "وَٱلَّذِينَ يَسۡعَوۡنَ فِيٓ ءَايَٰتِنَا مُعَٰجِزِينَ أُوْلَٰٓئِكَ فِي ٱلۡعَذَابِ مُحۡضَرُونَ",
    "ayah_text_no_diacratic" : "والذين يسعون في ءايٰتنا معٰجزين اولٰئك في العذاب محضرون",
    "ayahnumber" : "38",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3710",
    "page" : "432",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3711",
    "ayah_text" : "قُلۡ إِنَّ رَبِّي يَبۡسُطُ ٱلرِّزۡقَ لِمَن يَشَآءُ مِنۡ عِبَادِهِۦ وَيَقۡدِرُ لَهُۥۚ وَمَآ أَنفَقۡتُم مِّن شَيۡءٖ فَهُوَ يُخۡلِفُهُۥۖ وَهُوَ خَيۡرُ ٱلرَّٰزِقِينَ",
    "ayah_text_no_diacratic" : "قل ان ربي يبسط الرزق لمن يشاء من عباده ويقدر له وما انفقتم من شيء فهو يخلفه وهو خير الرٰزقين",
    "ayahnumber" : "39",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3711",
    "page" : "432",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3712",
    "ayah_text" : "وَيَوۡمَ يَحۡشُرُهُمۡ جَمِيعٗا ثُمَّ يَقُولُ لِلۡمَلَٰٓئِكَةِ أَهَٰٓؤُلَآءِ إِيَّاكُمۡ كَانُواْ يَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "ويوم يحشرهم جميعا ثم يقول للملٰئكة اهٰؤلاء اياكم كانوا يعبدون",
    "ayahnumber" : "40",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3712",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3713",
    "ayah_text" : "قَالُواْ سُبۡحَٰنَكَ أَنتَ وَلِيُّنَا مِن دُونِهِمۖ بَلۡ كَانُواْ يَعۡبُدُونَ ٱلۡجِنَّۖ أَكۡثَرُهُم بِهِم مُّؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "قالوا سبحٰنك انت ولينا من دونهم بل كانوا يعبدون الجن اكثرهم بهم مؤمنون",
    "ayahnumber" : "41",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3713",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3714",
    "ayah_text" : "فَٱلۡيَوۡمَ لَا يَمۡلِكُ بَعۡضُكُمۡ لِبَعۡضٖ نَّفۡعٗا وَلَا ضَرّٗا وَنَقُولُ لِلَّذِينَ ظَلَمُواْ ذُوقُواْ عَذَابَ ٱلنَّارِ ٱلَّتِي كُنتُم بِهَا تُكَذِّبُونَ",
    "ayah_text_no_diacratic" : "فاليوم لا يملك بعضكم لبعض نفعا ولا ضرا ونقول للذين ظلموا ذوقوا عذاب النار التي كنتم بها تكذبون",
    "ayahnumber" : "42",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3714",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3715",
    "ayah_text" : "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُنَا بَيِّنَٰتٖ قَالُواْ مَا هَٰذَآ إِلَّا رَجُلٞ يُرِيدُ أَن يَصُدَّكُمۡ عَمَّا كَانَ يَعۡبُدُ ءَابَآؤُكُمۡ وَقَالُواْ مَا هَٰذَآ إِلَّآ إِفۡكٞ مُّفۡتَرٗىۚ وَقَالَ ٱلَّذِينَ كَفَرُواْ لِلۡحَقِّ لَمَّا جَآءَهُمۡ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "واذا تتلىٰ عليهم ءايٰتنا بينٰت قالوا ما هٰذا الا رجل يريد ان يصدكم عما كان يعبد ءاباؤكم وقالوا ما هٰذا الا افك مفترى وقال الذين كفروا للحق لما جاءهم ان هٰذا الا سحر مبين",
    "ayahnumber" : "43",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3715",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3716",
    "ayah_text" : "وَمَآ ءَاتَيۡنَٰهُم مِّن كُتُبٖ يَدۡرُسُونَهَاۖ وَمَآ أَرۡسَلۡنَآ إِلَيۡهِمۡ قَبۡلَكَ مِن نَّذِيرٖ",
    "ayah_text_no_diacratic" : "وما ءاتينٰهم من كتب يدرسونها وما ارسلنا اليهم قبلك من نذير",
    "ayahnumber" : "44",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3716",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3717",
    "ayah_text" : "وَكَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ وَمَا بَلَغُواْ مِعۡشَارَ مَآ ءَاتَيۡنَٰهُمۡ فَكَذَّبُواْ رُسُلِيۖ فَكَيۡفَ كَانَ نَكِيرِ",
    "ayah_text_no_diacratic" : "وكذب الذين من قبلهم وما بلغوا معشار ما ءاتينٰهم فكذبوا رسلي فكيف كان نكير",
    "ayahnumber" : "45",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3717",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3718",
    "ayah_text" : "۞قُلۡ إِنَّمَآ أَعِظُكُم بِوَٰحِدَةٍۖ أَن تَقُومُواْ لِلَّهِ مَثۡنَىٰ وَفُرَٰدَىٰ ثُمَّ تَتَفَكَّرُواْۚ مَا بِصَاحِبِكُم مِّن جِنَّةٍۚ إِنۡ هُوَ إِلَّا نَذِيرٞ لَّكُم بَيۡنَ يَدَيۡ عَذَابٖ شَدِيدٖ",
    "ayah_text_no_diacratic" : "قل انما اعظكم بوٰحدة ان تقوموا لله مثنىٰ وفرٰدىٰ ثم تتفكروا ما بصاحبكم من جنة ان هو الا نذير لكم بين يدي عذاب شديد",
    "ayahnumber" : "46",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3718",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3719",
    "ayah_text" : "قُلۡ مَا سَأَلۡتُكُم مِّنۡ أَجۡرٖ فَهُوَ لَكُمۡۖ إِنۡ أَجۡرِيَ إِلَّا عَلَى ٱللَّهِۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٞ",
    "ayah_text_no_diacratic" : "قل ما سالتكم من اجر فهو لكم ان اجري الا على الله وهو علىٰ كل شيء شهيد",
    "ayahnumber" : "47",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3719",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:372",
    "ayah_text" : "يَخۡتَصُّ بِرَحۡمَتِهِۦ مَن يَشَآءُۗ وَٱللَّهُ ذُو ٱلۡفَضۡلِ ٱلۡعَظِيمِ",
    "ayah_text_no_diacratic" : "يختص برحمته من يشاء والله ذو الفضل العظيم",
    "ayahnumber" : "74",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "372",
    "page" : "59",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3720",
    "ayah_text" : "قُلۡ إِنَّ رَبِّي يَقۡذِفُ بِٱلۡحَقِّ عَلَّٰمُ ٱلۡغُيُوبِ",
    "ayah_text_no_diacratic" : "قل ان ربي يقذف بالحق علٰم الغيوب",
    "ayahnumber" : "48",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3720",
    "page" : "433",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3721",
    "ayah_text" : "قُلۡ جَآءَ ٱلۡحَقُّ وَمَا يُبۡدِئُ ٱلۡبَٰطِلُ وَمَا يُعِيدُ",
    "ayah_text_no_diacratic" : "قل جاء الحق وما يبدئ البٰطل وما يعيد",
    "ayahnumber" : "49",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3721",
    "page" : "434",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3722",
    "ayah_text" : "قُلۡ إِن ضَلَلۡتُ فَإِنَّمَآ أَضِلُّ عَلَىٰ نَفۡسِيۖ وَإِنِ ٱهۡتَدَيۡتُ فَبِمَا يُوحِيٓ إِلَيَّ رَبِّيٓۚ إِنَّهُۥ سَمِيعٞ قَرِيبٞ",
    "ayah_text_no_diacratic" : "قل ان ضللت فانما اضل علىٰ نفسي وان اهتديت فبما يوحي الي ربي انه سميع قريب",
    "ayahnumber" : "50",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3722",
    "page" : "434",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3723",
    "ayah_text" : "وَلَوۡ تَرَىٰٓ إِذۡ فَزِعُواْ فَلَا فَوۡتَ وَأُخِذُواْ مِن مَّكَانٖ قَرِيبٖ",
    "ayah_text_no_diacratic" : "ولو ترىٰ اذ فزعوا فلا فوت واخذوا من مكان قريب",
    "ayahnumber" : "51",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3723",
    "page" : "434",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3724",
    "ayah_text" : "وَقَالُوٓاْ ءَامَنَّا بِهِۦ وَأَنَّىٰ لَهُمُ ٱلتَّنَاوُشُ مِن مَّكَانِۭ بَعِيدٖ",
    "ayah_text_no_diacratic" : "وقالوا ءامنا به وانىٰ لهم التناوش من مكان بعيد",
    "ayahnumber" : "52",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3724",
    "page" : "434",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3725",
    "ayah_text" : "وَقَدۡ كَفَرُواْ بِهِۦ مِن قَبۡلُۖ وَيَقۡذِفُونَ بِٱلۡغَيۡبِ مِن مَّكَانِۭ بَعِيدٖ",
    "ayah_text_no_diacratic" : "وقد كفروا به من قبل ويقذفون بالغيب من مكان بعيد",
    "ayahnumber" : "53",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3725",
    "page" : "434",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3726",
    "ayah_text" : "وَحِيلَ بَيۡنَهُمۡ وَبَيۡنَ مَا يَشۡتَهُونَ كَمَا فُعِلَ بِأَشۡيَاعِهِم مِّن قَبۡلُۚ إِنَّهُمۡ كَانُواْ فِي شَكّٖ مُّرِيبِۭ",
    "ayah_text_no_diacratic" : "وحيل بينهم وبين ما يشتهون كما فعل باشياعهم من قبل انهم كانوا في شك مريب",
    "ayahnumber" : "54",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3726",
    "page" : "434",
    "surahname" : "سُورَةُ سَبَإٍ",
