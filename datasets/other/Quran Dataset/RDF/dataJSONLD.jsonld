    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1863",
    "ayah_text" : "قَالَ لَمۡ أَكُن لِّأَسۡجُدَ لِبَشَرٍ خَلَقۡتَهُۥ مِن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ",
    "ayah_text_no_diacratic" : "قال لم اكن لاسجد لبشر خلقته من صلصٰل من حما مسنون",
    "ayahnumber" : "33",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1863",
    "page" : "264",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1864",
    "ayah_text" : "قَالَ فَٱخۡرُجۡ مِنۡهَا فَإِنَّكَ رَجِيمٞ",
    "ayah_text_no_diacratic" : "قال فاخرج منها فانك رجيم",
    "ayahnumber" : "34",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1864",
    "page" : "264",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1865",
    "ayah_text" : "وَإِنَّ عَلَيۡكَ ٱللَّعۡنَةَ إِلَىٰ يَوۡمِ ٱلدِّينِ",
    "ayah_text_no_diacratic" : "وان عليك اللعنة الىٰ يوم الدين",
    "ayahnumber" : "35",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1865",
    "page" : "264",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1866",
    "ayah_text" : "قَالَ رَبِّ فَأَنظِرۡنِيٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ",
    "ayah_text_no_diacratic" : "قال رب فانظرني الىٰ يوم يبعثون",
