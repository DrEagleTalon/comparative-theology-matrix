    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2754",
    "ayah_text" : "إِنۡ هِيَ إِلَّا حَيَاتُنَا ٱلدُّنۡيَا نَمُوتُ وَنَحۡيَا وَمَا نَحۡنُ بِمَبۡعُوثِينَ",
    "ayah_text_no_diacratic" : "ان هي الا حياتنا الدنيا نموت ونحيا وما نحن بمبعوثين",
