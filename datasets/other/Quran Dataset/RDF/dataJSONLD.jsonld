    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4686",
    "ayah_text" : "لِّتُؤۡمِنُواْ بِٱللَّهِ وَرَسُولِهِۦ وَتُعَزِّرُوهُ وَتُوَقِّرُوهُۚ وَتُسَبِّحُوهُ بُكۡرَةٗ وَأَصِيلًا",
    "ayah_text_no_diacratic" : "لتؤمنوا بالله ورسوله وتعزروه وتوقروه وتسبحوه بكرة واصيلا",
    "ayahnumber" : "9",
    "chapter" : "26",
    "hizb" : "51",
