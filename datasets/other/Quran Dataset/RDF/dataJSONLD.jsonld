    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3183",
    "ayah_text" : "لَا يُؤۡمِنُونَ بِهِۦ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ",
    "ayah_text_no_diacratic" : "لا يؤمنون به حتىٰ يروا العذاب الاليم",
