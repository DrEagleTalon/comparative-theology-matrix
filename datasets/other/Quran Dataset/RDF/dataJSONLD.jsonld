  }, {
    "@id" : "quran:109",
    "ayah_text" : "وَلَقَدۡ أَنزَلۡنَآ إِلَيۡكَ ءَايَٰتِۭ بَيِّنَٰتٖۖ وَمَا يَكۡفُرُ بِهَآ إِلَّا ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "ولقد انزلنا اليك ءايٰت بينٰت وما يكفر بها الا الفٰسقون",
    "ayahnumber" : "99",
    "chapter" : "1",
