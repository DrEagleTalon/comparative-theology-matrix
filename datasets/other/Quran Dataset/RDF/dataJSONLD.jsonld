  }, {
    "@id" : "quran:2592",
    "ayah_text" : "قُلۡنَا يَٰنَارُ كُونِي بَرۡدٗا وَسَلَٰمًا عَلَىٰٓ إِبۡرَٰهِيمَ",
    "ayah_text_no_diacratic" : "قلنا يٰنار كوني بردا وسلٰما علىٰ ابرٰهيم",
