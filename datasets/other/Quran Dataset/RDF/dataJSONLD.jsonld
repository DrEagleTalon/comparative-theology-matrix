    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4969",
    "ayah_text" : "وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ لِلذِّكۡرِ فَهَلۡ مِن مُّدَّكِرٖ",
    "ayah_text_no_diacratic" : "ولقد يسرنا القرءان للذكر فهل من مدكر",
    "ayahnumber" : "17",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "4969",
    "page" : "529",
    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:497",
    "ayah_text" : "وَإِنَّ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ لَمَن يُؤۡمِنُ بِٱللَّهِ وَمَآ أُنزِلَ إِلَيۡكُمۡ وَمَآ أُنزِلَ إِلَيۡهِمۡ خَٰشِعِينَ لِلَّهِ لَا يَشۡتَرُونَ بِـَٔايَٰتِ ٱللَّهِ ثَمَنٗا قَلِيلًاۚ أُوْلَٰٓئِكَ لَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡۗ إِنَّ ٱللَّهَ سَرِيعُ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "وان من اهل الكتٰب لمن يؤمن بالله وما انزل اليكم وما انزل اليهم خٰشعين لله لا يشترون بايٰت الله ثمنا قليلا اولٰئك لهم اجرهم عند ربهم ان الله سريع الحساب",
    "ayahnumber" : "199",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "497",
    "page" : "76",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4970",
    "ayah_text" : "كَذَّبَتۡ عَادٞ فَكَيۡفَ كَانَ عَذَابِي وَنُذُرِ",
    "ayah_text_no_diacratic" : "كذبت عاد فكيف كان عذابي ونذر",
    "ayahnumber" : "18",
