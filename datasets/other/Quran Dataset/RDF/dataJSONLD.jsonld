    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:699",
    "ayah_text" : "يَٰقَوۡمِ ٱدۡخُلُواْ ٱلۡأَرۡضَ ٱلۡمُقَدَّسَةَ ٱلَّتِي كَتَبَ ٱللَّهُ لَكُمۡ وَلَا تَرۡتَدُّواْ عَلَىٰٓ أَدۡبَارِكُمۡ فَتَنقَلِبُواْ خَٰسِرِينَ",
    "ayah_text_no_diacratic" : "يٰقوم ادخلوا الارض المقدسة التي كتب الله لكم ولا ترتدوا علىٰ ادباركم فتنقلبوا خٰسرين",
    "ayahnumber" : "21",
