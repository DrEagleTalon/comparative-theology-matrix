    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2296",
    "ayah_text" : "قَالَ رَبِّ ٱجۡعَل لِّيٓ ءَايَةٗۖ قَالَ ءَايَتُكَ أَلَّا تُكَلِّمَ ٱلنَّاسَ ثَلَٰثَ لَيَالٖ سَوِيّٗا",
    "ayah_text_no_diacratic" : "قال رب اجعل لي ءاية قال ءايتك الا تكلم الناس ثلٰث ليال سويا",
    "ayahnumber" : "10",
