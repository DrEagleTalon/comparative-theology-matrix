    "page" : "313",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2405",
    "ayah_text" : "قَالَ أَلۡقِهَا يَٰمُوسَىٰ",
    "ayah_text_no_diacratic" : "قال القها يٰموسىٰ",
    "ayahnumber" : "19",
