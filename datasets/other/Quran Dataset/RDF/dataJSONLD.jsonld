  }, {
    "@id" : "quran:2725",
    "ayah_text" : "وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ",
    "ayah_text_no_diacratic" : "والذين هم لامٰنٰتهم وعهدهم رٰعون",
