    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4111",
    "ayah_text" : "قُلۡ هُوَ نَبَؤٌاْ عَظِيمٌ",
    "ayah_text_no_diacratic" : "قل هو نبؤا عظيم",
    "ayahnumber" : "67",
    "chapter" : "23",
    "hizb" : "45",
