    "surahnumber" : "58",
    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:5228",
    "ayah_text" : "إِنَّمَا ٱلنَّجۡوَىٰ مِنَ ٱلشَّيۡطَٰنِ لِيَحۡزُنَ ٱلَّذِينَ ءَامَنُواْ وَلَيۡسَ بِضَآرِّهِمۡ شَيۡـًٔا إِلَّا بِإِذۡنِ ٱللَّهِۚ وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ ٱلۡمُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "انما النجوىٰ من الشيطٰن ليحزن الذين ءامنوا وليس بضارهم شيا الا باذن الله وعلى الله فليتوكل المؤمنون",
    "ayahnumber" : "10",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5228",
    "page" : "543",
    "surahname" : "سُورَةُ المُجَادلَةِ",
    "surahnumber" : "58",
    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:5229",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا قِيلَ لَكُمۡ تَفَسَّحُواْ فِي ٱلۡمَجَٰلِسِ فَٱفۡسَحُواْ يَفۡسَحِ ٱللَّهُ لَكُمۡۖ وَإِذَا قِيلَ ٱنشُزُواْ فَٱنشُزُواْ يَرۡفَعِ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ مِنكُمۡ وَٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ دَرَجَٰتٖۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اذا قيل لكم تفسحوا في المجٰلس فافسحوا يفسح الله لكم واذا قيل انشزوا فانشزوا يرفع الله الذين ءامنوا منكم والذين اوتوا العلم درجٰت والله بما تعملون خبير",
    "ayahnumber" : "11",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5229",
    "page" : "543",
    "surahname" : "سُورَةُ المُجَادلَةِ",
    "surahnumber" : "58",
    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:523",
    "ayah_text" : "حُرِّمَتۡ عَلَيۡكُمۡ أُمَّهَٰتُكُمۡ وَبَنَاتُكُمۡ وَأَخَوَٰتُكُمۡ وَعَمَّٰتُكُمۡ وَخَٰلَٰتُكُمۡ وَبَنَاتُ ٱلۡأَخِ وَبَنَاتُ ٱلۡأُخۡتِ وَأُمَّهَٰتُكُمُ ٱلَّٰتِيٓ أَرۡضَعۡنَكُمۡ وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَٰعَةِ وَأُمَّهَٰتُ نِسَآئِكُمۡ وَرَبَٰٓئِبُكُمُ ٱلَّٰتِي فِي حُجُورِكُم مِّن نِّسَآئِكُمُ ٱلَّٰتِي دَخَلۡتُم بِهِنَّ فَإِن لَّمۡ تَكُونُواْ دَخَلۡتُم بِهِنَّ فَلَا جُنَاحَ عَلَيۡكُمۡ وَحَلَٰٓئِلُ أَبۡنَآئِكُمُ ٱلَّذِينَ مِنۡ أَصۡلَٰبِكُمۡ وَأَن تَجۡمَعُواْ بَيۡنَ ٱلۡأُخۡتَيۡنِ إِلَّا مَا قَدۡ سَلَفَۗ إِنَّ ٱللَّهَ كَانَ غَفُورٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "حرمت عليكم امهٰتكم وبناتكم واخوٰتكم وعمٰتكم وخٰلٰتكم وبنات الاخ وبنات الاخت وامهٰتكم الٰتي ارضعنكم واخوٰتكم من الرضٰعة وامهٰت نسائكم وربٰئبكم الٰتي في حجوركم من نسائكم الٰتي دخلتم بهن فان لم تكونوا دخلتم بهن فلا جناح عليكم وحلٰئل ابنائكم الذين من اصلٰبكم وان تجمعوا بين الاختين الا ما قد سلف ان الله كان غفورا رحيما",
    "ayahnumber" : "23",
    "chapter" : "4",
    "hizb" : "8",
    "index" : "523",
    "page" : "81",
    "surahname" : "سُورَةُ النِّسَاءِ",
