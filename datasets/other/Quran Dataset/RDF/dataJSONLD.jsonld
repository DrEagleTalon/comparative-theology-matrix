  }, {
    "@id" : "quran:5325",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5325",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5326",
    "ayah_text" : "يُسَبِّحُ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۖ لَهُ ٱلۡمُلۡكُ وَلَهُ ٱلۡحَمۡدُۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "ayah_text_no_diacratic" : "يسبح لله ما في السمٰوٰت وما في الارض له الملك وله الحمد وهو علىٰ كل شيء قدير",
    "ayahnumber" : "1",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5326",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5327",
    "ayah_text" : "هُوَ ٱلَّذِي خَلَقَكُمۡ فَمِنكُمۡ كَافِرٞ وَمِنكُم مُّؤۡمِنٞۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرٌ",
    "ayah_text_no_diacratic" : "هو الذي خلقكم فمنكم كافر ومنكم مؤمن والله بما تعملون بصير",
    "ayahnumber" : "2",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5327",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5328",
    "ayah_text" : "خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّ وَصَوَّرَكُمۡ فَأَحۡسَنَ صُوَرَكُمۡۖ وَإِلَيۡهِ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "خلق السمٰوٰت والارض بالحق وصوركم فاحسن صوركم واليه المصير",
    "ayahnumber" : "3",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5328",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5329",
    "ayah_text" : "يَعۡلَمُ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَيَعۡلَمُ مَا تُسِرُّونَ وَمَا تُعۡلِنُونَۚ وَٱللَّهُ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "يعلم ما في السمٰوٰت والارض ويعلم ما تسرون وما تعلنون والله عليم بذات الصدور",
    "ayahnumber" : "4",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5329",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:533",
    "ayah_text" : "وَلِكُلّٖ جَعَلۡنَا مَوَٰلِيَ مِمَّا تَرَكَ ٱلۡوَٰلِدَانِ وَٱلۡأَقۡرَبُونَۚ وَٱلَّذِينَ عَقَدَتۡ أَيۡمَٰنُكُمۡ فَـَٔاتُوهُمۡ نَصِيبَهُمۡۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدًا",
    "ayah_text_no_diacratic" : "ولكل جعلنا موٰلي مما ترك الوٰلدان والاقربون والذين عقدت ايمٰنكم فاتوهم نصيبهم ان الله كان علىٰ كل شيء شهيدا",
    "ayahnumber" : "33",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "533",
    "page" : "83",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5330",
    "ayah_text" : "أَلَمۡ يَأۡتِكُمۡ نَبَؤُاْ ٱلَّذِينَ كَفَرُواْ مِن قَبۡلُ فَذَاقُواْ وَبَالَ أَمۡرِهِمۡ وَلَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "الم ياتكم نبؤا الذين كفروا من قبل فذاقوا وبال امرهم ولهم عذاب اليم",
    "ayahnumber" : "5",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5330",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5331",
    "ayah_text" : "ذَٰلِكَ بِأَنَّهُۥ كَانَت تَّأۡتِيهِمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ فَقَالُوٓاْ أَبَشَرٞ يَهۡدُونَنَا فَكَفَرُواْ وَتَوَلَّواْۖ وَّٱسۡتَغۡنَى ٱللَّهُۚ وَٱللَّهُ غَنِيٌّ حَمِيدٞ",
    "ayah_text_no_diacratic" : "ذٰلك بانه كانت تاتيهم رسلهم بالبينٰت فقالوا ابشر يهدوننا فكفروا وتولوا واستغنى الله والله غني حميد",
    "ayahnumber" : "6",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5331",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5332",
    "ayah_text" : "زَعَمَ ٱلَّذِينَ كَفَرُوٓاْ أَن لَّن يُبۡعَثُواْۚ قُلۡ بَلَىٰ وَرَبِّي لَتُبۡعَثُنَّ ثُمَّ لَتُنَبَّؤُنَّ بِمَا عَمِلۡتُمۡۚ وَذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٞ",
    "ayah_text_no_diacratic" : "زعم الذين كفروا ان لن يبعثوا قل بلىٰ وربي لتبعثن ثم لتنبؤن بما عملتم وذٰلك على الله يسير",
    "ayahnumber" : "7",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5332",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5333",
    "ayah_text" : "فَـَٔامِنُواْ بِٱللَّهِ وَرَسُولِهِۦ وَٱلنُّورِ ٱلَّذِيٓ أَنزَلۡنَاۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ",
    "ayah_text_no_diacratic" : "فامنوا بالله ورسوله والنور الذي انزلنا والله بما تعملون خبير",
    "ayahnumber" : "8",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5333",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5334",
    "ayah_text" : "يَوۡمَ يَجۡمَعُكُمۡ لِيَوۡمِ ٱلۡجَمۡعِۖ ذَٰلِكَ يَوۡمُ ٱلتَّغَابُنِۗ وَمَن يُؤۡمِنۢ بِٱللَّهِ وَيَعۡمَلۡ صَٰلِحٗا يُكَفِّرۡ عَنۡهُ سَيِّـَٔاتِهِۦ وَيُدۡخِلۡهُ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "يوم يجمعكم ليوم الجمع ذٰلك يوم التغابن ومن يؤمن بالله ويعمل صٰلحا يكفر عنه سياته ويدخله جنٰت تجري من تحتها الانهٰر خٰلدين فيها ابدا ذٰلك الفوز العظيم",
    "ayahnumber" : "9",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5334",
    "page" : "556",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5335",
    "ayah_text" : "وَٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِـَٔايَٰتِنَآ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِ خَٰلِدِينَ فِيهَاۖ وَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "والذين كفروا وكذبوا بايٰتنا اولٰئك اصحٰب النار خٰلدين فيها وبئس المصير",
    "ayahnumber" : "10",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5335",
    "page" : "557",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5336",
    "ayah_text" : "مَآ أَصَابَ مِن مُّصِيبَةٍ إِلَّا بِإِذۡنِ ٱللَّهِۗ وَمَن يُؤۡمِنۢ بِٱللَّهِ يَهۡدِ قَلۡبَهُۥۚ وَٱللَّهُ بِكُلِّ شَيۡءٍ عَلِيمٞ",
    "ayah_text_no_diacratic" : "ما اصاب من مصيبة الا باذن الله ومن يؤمن بالله يهد قلبه والله بكل شيء عليم",
    "ayahnumber" : "11",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5336",
    "page" : "557",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5337",
    "ayah_text" : "وَأَطِيعُواْ ٱللَّهَ وَأَطِيعُواْ ٱلرَّسُولَۚ فَإِن تَوَلَّيۡتُمۡ فَإِنَّمَا عَلَىٰ رَسُولِنَا ٱلۡبَلَٰغُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "واطيعوا الله واطيعوا الرسول فان توليتم فانما علىٰ رسولنا البلٰغ المبين",
    "ayahnumber" : "12",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5337",
    "page" : "557",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5338",
    "ayah_text" : "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۚ وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ ٱلۡمُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "الله لا الٰه الا هو وعلى الله فليتوكل المؤمنون",
    "ayahnumber" : "13",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5338",
    "page" : "557",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5339",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِنَّ مِنۡ أَزۡوَٰجِكُمۡ وَأَوۡلَٰدِكُمۡ عَدُوّٗا لَّكُمۡ فَٱحۡذَرُوهُمۡۚ وَإِن تَعۡفُواْ وَتَصۡفَحُواْ وَتَغۡفِرُواْ فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ان من ازوٰجكم واولٰدكم عدوا لكم فاحذروهم وان تعفوا وتصفحوا وتغفروا فان الله غفور رحيم",
    "ayahnumber" : "14",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5339",
    "page" : "557",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:534",
    "ayah_text" : "ٱلرِّجَالُ قَوَّٰمُونَ عَلَى ٱلنِّسَآءِ بِمَا فَضَّلَ ٱللَّهُ بَعۡضَهُمۡ عَلَىٰ بَعۡضٖ وَبِمَآ أَنفَقُواْ مِنۡ أَمۡوَٰلِهِمۡۚ فَٱلصَّٰلِحَٰتُ قَٰنِتَٰتٌ حَٰفِظَٰتٞ لِّلۡغَيۡبِ بِمَا حَفِظَ ٱللَّهُۚ وَٱلَّٰتِي تَخَافُونَ نُشُوزَهُنَّ فَعِظُوهُنَّ وَٱهۡجُرُوهُنَّ فِي ٱلۡمَضَاجِعِ وَٱضۡرِبُوهُنَّۖ فَإِنۡ أَطَعۡنَكُمۡ فَلَا تَبۡغُواْ عَلَيۡهِنَّ سَبِيلًاۗ إِنَّ ٱللَّهَ كَانَ عَلِيّٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "الرجال قوٰمون على النساء بما فضل الله بعضهم علىٰ بعض وبما انفقوا من اموٰلهم فالصٰلحٰت قٰنتٰت حٰفظٰت للغيب بما حفظ الله والٰتي تخافون نشوزهن فعظوهن واهجروهن في المضاجع واضربوهن فان اطعنكم فلا تبغوا عليهن سبيلا ان الله كان عليا كبيرا",
    "ayahnumber" : "34",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "534",
    "page" : "84",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5340",
    "ayah_text" : "إِنَّمَآ أَمۡوَٰلُكُمۡ وَأَوۡلَٰدُكُمۡ فِتۡنَةٞۚ وَٱللَّهُ عِندَهُۥٓ أَجۡرٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "انما اموٰلكم واولٰدكم فتنة والله عنده اجر عظيم",
    "ayahnumber" : "15",
    "chapter" : "28",
    "hizb" : "55",
