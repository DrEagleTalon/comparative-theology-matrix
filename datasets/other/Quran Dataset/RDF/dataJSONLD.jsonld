    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3598",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ ٱتَّقِ ٱللَّهَ وَلَا تُطِعِ ٱلۡكَٰفِرِينَ وَٱلۡمُنَٰفِقِينَۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا",
    "ayah_text_no_diacratic" : "يٰايها النبي اتق الله ولا تطع الكٰفرين والمنٰفقين ان الله كان عليما حكيما",
    "ayahnumber" : "1",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3598",
    "page" : "418",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3599",
    "ayah_text" : "وَٱتَّبِعۡ مَا يُوحَىٰٓ إِلَيۡكَ مِن رَّبِّكَۚ إِنَّ ٱللَّهَ كَانَ بِمَا تَعۡمَلُونَ خَبِيرٗا",
    "ayah_text_no_diacratic" : "واتبع ما يوحىٰ اليك من ربك ان الله كان بما تعملون خبيرا",
    "ayahnumber" : "2",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3599",
    "page" : "418",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:36",
    "ayah_text" : "۞إِنَّ ٱللَّهَ لَا يَسۡتَحۡيِۦٓ أَن يَضۡرِبَ مَثَلٗا مَّا بَعُوضَةٗ فَمَا فَوۡقَهَاۚ فَأَمَّا ٱلَّذِينَ ءَامَنُواْ فَيَعۡلَمُونَ أَنَّهُ ٱلۡحَقُّ مِن رَّبِّهِمۡۖ وَأَمَّا ٱلَّذِينَ كَفَرُواْ فَيَقُولُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗاۘ يُضِلُّ بِهِۦ كَثِيرٗا وَيَهۡدِي بِهِۦ كَثِيرٗاۚ وَمَا يُضِلُّ بِهِۦٓ إِلَّا ٱلۡفَٰسِقِينَ",
    "ayah_text_no_diacratic" : "ان الله لا يستحي ان يضرب مثلا ما بعوضة فما فوقها فاما الذين ءامنوا فيعلمون انه الحق من ربهم واما الذين كفروا فيقولون ماذا اراد الله بهٰذا مثلا يضل به كثيرا ويهدي به كثيرا وما يضل به الا الفٰسقين",
    "ayahnumber" : "26",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "36",
    "page" : "5",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:360",
    "ayah_text" : "إِنَّ هَٰذَا لَهُوَ ٱلۡقَصَصُ ٱلۡحَقُّۚ وَمَا مِنۡ إِلَٰهٍ إِلَّا ٱللَّهُۚ وَإِنَّ ٱللَّهَ لَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "ان هٰذا لهو القصص الحق وما من الٰه الا الله وان الله لهو العزيز الحكيم",
    "ayahnumber" : "62",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "360",
    "page" : "58",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3600",
    "ayah_text" : "وَتَوَكَّلۡ عَلَى ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلٗا",
    "ayah_text_no_diacratic" : "وتوكل على الله وكفىٰ بالله وكيلا",
    "ayahnumber" : "3",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3600",
    "page" : "418",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3601",
    "ayah_text" : "مَّا جَعَلَ ٱللَّهُ لِرَجُلٖ مِّن قَلۡبَيۡنِ فِي جَوۡفِهِۦۚ وَمَا جَعَلَ أَزۡوَٰجَكُمُ ٱلَّٰٓـِٔي تُظَٰهِرُونَ مِنۡهُنَّ أُمَّهَٰتِكُمۡۚ وَمَا جَعَلَ أَدۡعِيَآءَكُمۡ أَبۡنَآءَكُمۡۚ ذَٰلِكُمۡ قَوۡلُكُم بِأَفۡوَٰهِكُمۡۖ وَٱللَّهُ يَقُولُ ٱلۡحَقَّ وَهُوَ يَهۡدِي ٱلسَّبِيلَ",
    "ayah_text_no_diacratic" : "ما جعل الله لرجل من قلبين في جوفه وما جعل ازوٰجكم الٰي تظٰهرون منهن امهٰتكم وما جعل ادعياءكم ابناءكم ذٰلكم قولكم بافوٰهكم والله يقول الحق وهو يهدي السبيل",
    "ayahnumber" : "4",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3601",
    "page" : "418",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3602",
    "ayah_text" : "ٱدۡعُوهُمۡ لِأٓبَآئِهِمۡ هُوَ أَقۡسَطُ عِندَ ٱللَّهِۚ فَإِن لَّمۡ تَعۡلَمُوٓاْ ءَابَآءَهُمۡ فَإِخۡوَٰنُكُمۡ فِي ٱلدِّينِ وَمَوَٰلِيكُمۡۚ وَلَيۡسَ عَلَيۡكُمۡ جُنَاحٞ فِيمَآ أَخۡطَأۡتُم بِهِۦ وَلَٰكِن مَّا تَعَمَّدَتۡ قُلُوبُكُمۡۚ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمًا",
    "ayah_text_no_diacratic" : "ادعوهم لابائهم هو اقسط عند الله فان لم تعلموا ءاباءهم فاخوٰنكم في الدين وموٰليكم وليس عليكم جناح فيما اخطاتم به ولٰكن ما تعمدت قلوبكم وكان الله غفورا رحيما",
    "ayahnumber" : "5",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3602",
    "page" : "418",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3603",
    "ayah_text" : "ٱلنَّبِيُّ أَوۡلَىٰ بِٱلۡمُؤۡمِنِينَ مِنۡ أَنفُسِهِمۡۖ وَأَزۡوَٰجُهُۥٓ أُمَّهَٰتُهُمۡۗ وَأُوْلُواْ ٱلۡأَرۡحَامِ بَعۡضُهُمۡ أَوۡلَىٰ بِبَعۡضٖ فِي كِتَٰبِ ٱللَّهِ مِنَ ٱلۡمُؤۡمِنِينَ وَٱلۡمُهَٰجِرِينَ إِلَّآ أَن تَفۡعَلُوٓاْ إِلَىٰٓ أَوۡلِيَآئِكُم مَّعۡرُوفٗاۚ كَانَ ذَٰلِكَ فِي ٱلۡكِتَٰبِ مَسۡطُورٗا",
    "ayah_text_no_diacratic" : "النبي اولىٰ بالمؤمنين من انفسهم وازوٰجه امهٰتهم واولوا الارحام بعضهم اولىٰ ببعض في كتٰب الله من المؤمنين والمهٰجرين الا ان تفعلوا الىٰ اوليائكم معروفا كان ذٰلك في الكتٰب مسطورا",
    "ayahnumber" : "6",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3603",
    "page" : "418",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3604",
    "ayah_text" : "وَإِذۡ أَخَذۡنَا مِنَ ٱلنَّبِيِّـۧنَ مِيثَٰقَهُمۡ وَمِنكَ وَمِن نُّوحٖ وَإِبۡرَٰهِيمَ وَمُوسَىٰ وَعِيسَى ٱبۡنِ مَرۡيَمَۖ وَأَخَذۡنَا مِنۡهُم مِّيثَٰقًا غَلِيظٗا",
    "ayah_text_no_diacratic" : "واذ اخذنا من النبين ميثٰقهم ومنك ومن نوح وابرٰهيم وموسىٰ وعيسى ابن مريم واخذنا منهم ميثٰقا غليظا",
    "ayahnumber" : "7",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3604",
    "page" : "419",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3605",
    "ayah_text" : "لِّيَسۡـَٔلَ ٱلصَّٰدِقِينَ عَن صِدۡقِهِمۡۚ وَأَعَدَّ لِلۡكَٰفِرِينَ عَذَابًا أَلِيمٗا",
    "ayah_text_no_diacratic" : "ليسل الصٰدقين عن صدقهم واعد للكٰفرين عذابا اليما",
    "ayahnumber" : "8",
    "chapter" : "21",
    "hizb" : "41",
