    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1924",
    "ayah_text" : "فَٱصۡدَعۡ بِمَا تُؤۡمَرُ وَأَعۡرِضۡ عَنِ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "فاصدع بما تؤمر واعرض عن المشركين",
