  }, {
    "@id" : "quran:2289",
    "ayah_text" : "إِذۡ نَادَىٰ رَبَّهُۥ نِدَآءً خَفِيّٗا",
    "ayah_text_no_diacratic" : "اذ نادىٰ ربه نداء خفيا",
