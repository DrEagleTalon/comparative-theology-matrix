    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4122",
    "ayah_text" : "وَإِنَّ عَلَيۡكَ لَعۡنَتِيٓ إِلَىٰ يَوۡمِ ٱلدِّينِ",
    "ayah_text_no_diacratic" : "وان عليك لعنتي الىٰ يوم الدين",
    "ayahnumber" : "78",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4122",
