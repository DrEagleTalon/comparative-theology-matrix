    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3400",
    "ayah_text" : "أَمۡ حَسِبَ ٱلَّذِينَ يَعۡمَلُونَ ٱلسَّيِّـَٔاتِ أَن يَسۡبِقُونَاۚ سَآءَ مَا يَحۡكُمُونَ",
    "ayah_text_no_diacratic" : "ام حسب الذين يعملون السيات ان يسبقونا ساء ما يحكمون",
    "ayahnumber" : "4",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3400",
    "page" : "396",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3401",
    "ayah_text" : "مَن كَانَ يَرۡجُواْ لِقَآءَ ٱللَّهِ فَإِنَّ أَجَلَ ٱللَّهِ لَأٓتٖۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "من كان يرجوا لقاء الله فان اجل الله لات وهو السميع العليم",
    "ayahnumber" : "5",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3401",
    "page" : "396",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3402",
    "ayah_text" : "وَمَن جَٰهَدَ فَإِنَّمَا يُجَٰهِدُ لِنَفۡسِهِۦٓۚ إِنَّ ٱللَّهَ لَغَنِيٌّ عَنِ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ومن جٰهد فانما يجٰهد لنفسه ان الله لغني عن العٰلمين",
    "ayahnumber" : "6",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3402",
    "page" : "396",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3403",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَنُكَفِّرَنَّ عَنۡهُمۡ سَيِّـَٔاتِهِمۡ وَلَنَجۡزِيَنَّهُمۡ أَحۡسَنَ ٱلَّذِي كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "والذين ءامنوا وعملوا الصٰلحٰت لنكفرن عنهم سياتهم ولنجزينهم احسن الذي كانوا يعملون",
    "ayahnumber" : "7",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3403",
    "page" : "397",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3404",
    "ayah_text" : "وَوَصَّيۡنَا ٱلۡإِنسَٰنَ بِوَٰلِدَيۡهِ حُسۡنٗاۖ وَإِن جَٰهَدَاكَ لِتُشۡرِكَ بِي مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٞ فَلَا تُطِعۡهُمَآۚ إِلَيَّ مَرۡجِعُكُمۡ فَأُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ووصينا الانسٰن بوٰلديه حسنا وان جٰهداك لتشرك بي ما ليس لك به علم فلا تطعهما الي مرجعكم فانبئكم بما كنتم تعملون",
    "ayahnumber" : "8",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3404",
    "page" : "397",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3405",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَنُدۡخِلَنَّهُمۡ فِي ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "والذين ءامنوا وعملوا الصٰلحٰت لندخلنهم في الصٰلحين",
    "ayahnumber" : "9",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3405",
    "page" : "397",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3406",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ فَإِذَآ أُوذِيَ فِي ٱللَّهِ جَعَلَ فِتۡنَةَ ٱلنَّاسِ كَعَذَابِ ٱللَّهِۖ وَلَئِن جَآءَ نَصۡرٞ مِّن رَّبِّكَ لَيَقُولُنَّ إِنَّا كُنَّا مَعَكُمۡۚ أَوَلَيۡسَ ٱللَّهُ بِأَعۡلَمَ بِمَا فِي صُدُورِ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ومن الناس من يقول ءامنا بالله فاذا اوذي في الله جعل فتنة الناس كعذاب الله ولئن جاء نصر من ربك ليقولن انا كنا معكم اوليس الله باعلم بما في صدور العٰلمين",
    "ayahnumber" : "10",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3406",
    "page" : "397",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3407",
    "ayah_text" : "وَلَيَعۡلَمَنَّ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ وَلَيَعۡلَمَنَّ ٱلۡمُنَٰفِقِينَ",
    "ayah_text_no_diacratic" : "وليعلمن الله الذين ءامنوا وليعلمن المنٰفقين",
    "ayahnumber" : "11",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3407",
    "page" : "397",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3408",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُواْ لِلَّذِينَ ءَامَنُواْ ٱتَّبِعُواْ سَبِيلَنَا وَلۡنَحۡمِلۡ خَطَٰيَٰكُمۡ وَمَا هُم بِحَٰمِلِينَ مِنۡ خَطَٰيَٰهُم مِّن شَيۡءٍۖ إِنَّهُمۡ لَكَٰذِبُونَ",
    "ayah_text_no_diacratic" : "وقال الذين كفروا للذين ءامنوا اتبعوا سبيلنا ولنحمل خطٰيٰكم وما هم بحٰملين من خطٰيٰهم من شيء انهم لكٰذبون",
    "ayahnumber" : "12",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3408",
    "page" : "397",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3409",
    "ayah_text" : "وَلَيَحۡمِلُنَّ أَثۡقَالَهُمۡ وَأَثۡقَالٗا مَّعَ أَثۡقَالِهِمۡۖ وَلَيُسۡـَٔلُنَّ يَوۡمَ ٱلۡقِيَٰمَةِ عَمَّا كَانُواْ يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "وليحملن اثقالهم واثقالا مع اثقالهم وليسلن يوم القيٰمة عما كانوا يفترون",
    "ayahnumber" : "13",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3409",
    "page" : "397",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:341",
    "ayah_text" : "يَٰمَرۡيَمُ ٱقۡنُتِي لِرَبِّكِ وَٱسۡجُدِي وَٱرۡكَعِي مَعَ ٱلرَّٰكِعِينَ",
    "ayah_text_no_diacratic" : "يٰمريم اقنتي لربك واسجدي واركعي مع الرٰكعين",
    "ayahnumber" : "43",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "341",
