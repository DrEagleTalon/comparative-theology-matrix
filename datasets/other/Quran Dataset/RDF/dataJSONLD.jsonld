    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1693",
    "ayah_text" : "قَالُواْ جَزَٰٓؤُهُۥ مَن وُجِدَ فِي رَحۡلِهِۦ فَهُوَ جَزَٰٓؤُهُۥۚ كَذَٰلِكَ نَجۡزِي ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "قالوا جزٰؤه من وجد في رحله فهو جزٰؤه كذٰلك نجزي الظٰلمين",
    "ayahnumber" : "75",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1693",
    "page" : "244",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1694",
    "ayah_text" : "فَبَدَأَ بِأَوۡعِيَتِهِمۡ قَبۡلَ وِعَآءِ أَخِيهِ ثُمَّ ٱسۡتَخۡرَجَهَا مِن وِعَآءِ أَخِيهِۚ كَذَٰلِكَ كِدۡنَا لِيُوسُفَۖ مَا كَانَ لِيَأۡخُذَ أَخَاهُ فِي دِينِ ٱلۡمَلِكِ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ نَرۡفَعُ دَرَجَٰتٖ مَّن نَّشَآءُۗ وَفَوۡقَ كُلِّ ذِي عِلۡمٍ عَلِيمٞ",
    "ayah_text_no_diacratic" : "فبدا باوعيتهم قبل وعاء اخيه ثم استخرجها من وعاء اخيه كذٰلك كدنا ليوسف ما كان لياخذ اخاه في دين الملك الا ان يشاء الله نرفع درجٰت من نشاء وفوق كل ذي علم عليم",
    "ayahnumber" : "76",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1694",
    "page" : "244",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1695",
    "ayah_text" : "۞قَالُوٓاْ إِن يَسۡرِقۡ فَقَدۡ سَرَقَ أَخٞ لَّهُۥ مِن قَبۡلُۚ فَأَسَرَّهَا يُوسُفُ فِي نَفۡسِهِۦ وَلَمۡ يُبۡدِهَا لَهُمۡۚ قَالَ أَنتُمۡ شَرّٞ مَّكَانٗاۖ وَٱللَّهُ أَعۡلَمُ بِمَا تَصِفُونَ",
    "ayah_text_no_diacratic" : "قالوا ان يسرق فقد سرق اخ له من قبل فاسرها يوسف في نفسه ولم يبدها لهم قال انتم شر مكانا والله اعلم بما تصفون",
    "ayahnumber" : "77",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1695",
    "page" : "244",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1696",
    "ayah_text" : "قَالُواْ يَٰٓأَيُّهَا ٱلۡعَزِيزُ إِنَّ لَهُۥٓ أَبٗا شَيۡخٗا كَبِيرٗا فَخُذۡ أَحَدَنَا مَكَانَهُۥٓۖ إِنَّا نَرَىٰكَ مِنَ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "قالوا يٰايها العزيز ان له ابا شيخا كبيرا فخذ احدنا مكانه انا نرىٰك من المحسنين",
    "ayahnumber" : "78",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1696",
    "page" : "244",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1697",
    "ayah_text" : "قَالَ مَعَاذَ ٱللَّهِ أَن نَّأۡخُذَ إِلَّا مَن وَجَدۡنَا مَتَٰعَنَا عِندَهُۥٓ إِنَّآ إِذٗا لَّظَٰلِمُونَ",
    "ayah_text_no_diacratic" : "قال معاذ الله ان ناخذ الا من وجدنا متٰعنا عنده انا اذا لظٰلمون",
    "ayahnumber" : "79",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1697",
    "page" : "245",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1698",
    "ayah_text" : "فَلَمَّا ٱسۡتَيۡـَٔسُواْ مِنۡهُ خَلَصُواْ نَجِيّٗاۖ قَالَ كَبِيرُهُمۡ أَلَمۡ تَعۡلَمُوٓاْ أَنَّ أَبَاكُمۡ قَدۡ أَخَذَ عَلَيۡكُم مَّوۡثِقٗا مِّنَ ٱللَّهِ وَمِن قَبۡلُ مَا فَرَّطتُمۡ فِي يُوسُفَۖ فَلَنۡ أَبۡرَحَ ٱلۡأَرۡضَ حَتَّىٰ يَأۡذَنَ لِيٓ أَبِيٓ أَوۡ يَحۡكُمَ ٱللَّهُ لِيۖ وَهُوَ خَيۡرُ ٱلۡحَٰكِمِينَ",
    "ayah_text_no_diacratic" : "فلما استيسوا منه خلصوا نجيا قال كبيرهم الم تعلموا ان اباكم قد اخذ عليكم موثقا من الله ومن قبل ما فرطتم في يوسف فلن ابرح الارض حتىٰ ياذن لي ابي او يحكم الله لي وهو خير الحٰكمين",
    "ayahnumber" : "80",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1698",
    "page" : "245",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1699",
    "ayah_text" : "ٱرۡجِعُوٓاْ إِلَىٰٓ أَبِيكُمۡ فَقُولُواْ يَٰٓأَبَانَآ إِنَّ ٱبۡنَكَ سَرَقَ وَمَا شَهِدۡنَآ إِلَّا بِمَا عَلِمۡنَا وَمَا كُنَّا لِلۡغَيۡبِ حَٰفِظِينَ",
    "ayah_text_no_diacratic" : "ارجعوا الىٰ ابيكم فقولوا يٰابانا ان ابنك سرق وما شهدنا الا بما علمنا وما كنا للغيب حٰفظين",
    "ayahnumber" : "81",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1699",
