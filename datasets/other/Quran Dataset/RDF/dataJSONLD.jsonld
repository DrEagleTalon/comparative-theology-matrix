  }, {
    "@id" : "quran:140",
    "ayah_text" : "وَمَن يَرۡغَبُ عَن مِّلَّةِ إِبۡرَٰهِـۧمَ إِلَّا مَن سَفِهَ نَفۡسَهُۥۚ وَلَقَدِ ٱصۡطَفَيۡنَٰهُ فِي ٱلدُّنۡيَاۖ وَإِنَّهُۥ فِي ٱلۡأٓخِرَةِ لَمِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "ومن يرغب عن ملة ابرٰهم الا من سفه نفسه ولقد اصطفينٰه في الدنيا وانه في الاخرة لمن الصٰلحين",
    "ayahnumber" : "130",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "140",
    "page" : "20",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1400",
    "ayah_text" : "وَيَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَضُرُّهُمۡ وَلَا يَنفَعُهُمۡ وَيَقُولُونَ هَٰٓؤُلَآءِ شُفَعَٰٓؤُنَا عِندَ ٱللَّهِۚ قُلۡ أَتُنَبِّـُٔونَ ٱللَّهَ بِمَا لَا يَعۡلَمُ فِي ٱلسَّمَٰوَٰتِ وَلَا فِي ٱلۡأَرۡضِۚ سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "ويعبدون من دون الله ما لا يضرهم ولا ينفعهم ويقولون هٰؤلاء شفعٰؤنا عند الله قل اتنبون الله بما لا يعلم في السمٰوٰت ولا في الارض سبحٰنه وتعٰلىٰ عما يشركون",
    "ayahnumber" : "18",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1400",
    "page" : "210",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1401",
    "ayah_text" : "وَمَا كَانَ ٱلنَّاسُ إِلَّآ أُمَّةٗ وَٰحِدَةٗ فَٱخۡتَلَفُواْۚ وَلَوۡلَا كَلِمَةٞ سَبَقَتۡ مِن رَّبِّكَ لَقُضِيَ بَيۡنَهُمۡ فِيمَا فِيهِ يَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "وما كان الناس الا امة وٰحدة فاختلفوا ولولا كلمة سبقت من ربك لقضي بينهم فيما فيه يختلفون",
    "ayahnumber" : "19",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1401",
    "page" : "210",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1402",
    "ayah_text" : "وَيَقُولُونَ لَوۡلَآ أُنزِلَ عَلَيۡهِ ءَايَةٞ مِّن رَّبِّهِۦۖ فَقُلۡ إِنَّمَا ٱلۡغَيۡبُ لِلَّهِ فَٱنتَظِرُوٓاْ إِنِّي مَعَكُم مِّنَ ٱلۡمُنتَظِرِينَ",
    "ayah_text_no_diacratic" : "ويقولون لولا انزل عليه ءاية من ربه فقل انما الغيب لله فانتظروا اني معكم من المنتظرين",
    "ayahnumber" : "20",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1402",
    "page" : "210",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1403",
    "ayah_text" : "وَإِذَآ أَذَقۡنَا ٱلنَّاسَ رَحۡمَةٗ مِّنۢ بَعۡدِ ضَرَّآءَ مَسَّتۡهُمۡ إِذَا لَهُم مَّكۡرٞ فِيٓ ءَايَاتِنَاۚ قُلِ ٱللَّهُ أَسۡرَعُ مَكۡرًاۚ إِنَّ رُسُلَنَا يَكۡتُبُونَ مَا تَمۡكُرُونَ",
    "ayah_text_no_diacratic" : "واذا اذقنا الناس رحمة من بعد ضراء مستهم اذا لهم مكر في ءاياتنا قل الله اسرع مكرا ان رسلنا يكتبون ما تمكرون",
    "ayahnumber" : "21",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1403",
    "page" : "211",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1404",
    "ayah_text" : "هُوَ ٱلَّذِي يُسَيِّرُكُمۡ فِي ٱلۡبَرِّ وَٱلۡبَحۡرِۖ حَتَّىٰٓ إِذَا كُنتُمۡ فِي ٱلۡفُلۡكِ وَجَرَيۡنَ بِهِم بِرِيحٖ طَيِّبَةٖ وَفَرِحُواْ بِهَا جَآءَتۡهَا رِيحٌ عَاصِفٞ وَجَآءَهُمُ ٱلۡمَوۡجُ مِن كُلِّ مَكَانٖ وَظَنُّوٓاْ أَنَّهُمۡ أُحِيطَ بِهِمۡ دَعَوُاْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ لَئِنۡ أَنجَيۡتَنَا مِنۡ هَٰذِهِۦ لَنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ",
    "ayah_text_no_diacratic" : "هو الذي يسيركم في البر والبحر حتىٰ اذا كنتم في الفلك وجرين بهم بريح طيبة وفرحوا بها جاءتها ريح عاصف وجاءهم الموج من كل مكان وظنوا انهم احيط بهم دعوا الله مخلصين له الدين لئن انجيتنا من هٰذه لنكونن من الشٰكرين",
    "ayahnumber" : "22",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1404",
    "page" : "211",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1405",
    "ayah_text" : "فَلَمَّآ أَنجَىٰهُمۡ إِذَا هُمۡ يَبۡغُونَ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّۗ يَٰٓأَيُّهَا ٱلنَّاسُ إِنَّمَا بَغۡيُكُمۡ عَلَىٰٓ أَنفُسِكُمۖ مَّتَٰعَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ ثُمَّ إِلَيۡنَا مَرۡجِعُكُمۡ فَنُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "فلما انجىٰهم اذا هم يبغون في الارض بغير الحق يٰايها الناس انما بغيكم علىٰ انفسكم متٰع الحيوٰة الدنيا ثم الينا مرجعكم فننبئكم بما كنتم تعملون",
    "ayahnumber" : "23",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1405",
    "page" : "211",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1406",
    "ayah_text" : "إِنَّمَا مَثَلُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا كَمَآءٍ أَنزَلۡنَٰهُ مِنَ ٱلسَّمَآءِ فَٱخۡتَلَطَ بِهِۦ نَبَاتُ ٱلۡأَرۡضِ مِمَّا يَأۡكُلُ ٱلنَّاسُ وَٱلۡأَنۡعَٰمُ حَتَّىٰٓ إِذَآ أَخَذَتِ ٱلۡأَرۡضُ زُخۡرُفَهَا وَٱزَّيَّنَتۡ وَظَنَّ أَهۡلُهَآ أَنَّهُمۡ قَٰدِرُونَ عَلَيۡهَآ أَتَىٰهَآ أَمۡرُنَا لَيۡلًا أَوۡ نَهَارٗا فَجَعَلۡنَٰهَا حَصِيدٗا كَأَن لَّمۡ تَغۡنَ بِٱلۡأَمۡسِۚ كَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "انما مثل الحيوٰة الدنيا كماء انزلنٰه من السماء فاختلط به نبات الارض مما ياكل الناس والانعٰم حتىٰ اذا اخذت الارض زخرفها وازينت وظن اهلها انهم قٰدرون عليها اتىٰها امرنا ليلا او نهارا فجعلنٰها حصيدا كان لم تغن بالامس كذٰلك نفصل الايٰت لقوم يتفكرون",
    "ayahnumber" : "24",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1406",
    "page" : "211",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1407",
    "ayah_text" : "وَٱللَّهُ يَدۡعُوٓاْ إِلَىٰ دَارِ ٱلسَّلَٰمِ وَيَهۡدِي مَن يَشَآءُ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "والله يدعوا الىٰ دار السلٰم ويهدي من يشاء الىٰ صرٰط مستقيم",
    "ayahnumber" : "25",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1407",
    "page" : "211",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1408",
    "ayah_text" : "۞لِّلَّذِينَ أَحۡسَنُواْ ٱلۡحُسۡنَىٰ وَزِيَادَةٞۖ وَلَا يَرۡهَقُ وُجُوهَهُمۡ قَتَرٞ وَلَا ذِلَّةٌۚ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡجَنَّةِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "للذين احسنوا الحسنىٰ وزيادة ولا يرهق وجوههم قتر ولا ذلة اولٰئك اصحٰب الجنة هم فيها خٰلدون",
    "ayahnumber" : "26",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1408",
    "page" : "212",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1409",
    "ayah_text" : "وَٱلَّذِينَ كَسَبُواْ ٱلسَّيِّـَٔاتِ جَزَآءُ سَيِّئَةِۭ بِمِثۡلِهَا وَتَرۡهَقُهُمۡ ذِلَّةٞۖ مَّا لَهُم مِّنَ ٱللَّهِ مِنۡ عَاصِمٖۖ كَأَنَّمَآ أُغۡشِيَتۡ وُجُوهُهُمۡ قِطَعٗا مِّنَ ٱلَّيۡلِ مُظۡلِمًاۚ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "والذين كسبوا السيات جزاء سيئة بمثلها وترهقهم ذلة ما لهم من الله من عاصم كانما اغشيت وجوههم قطعا من اليل مظلما اولٰئك اصحٰب النار هم فيها خٰلدون",
    "ayahnumber" : "27",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1409",
    "page" : "212",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:141",
    "ayah_text" : "إِذۡ قَالَ لَهُۥ رَبُّهُۥٓ أَسۡلِمۡۖ قَالَ أَسۡلَمۡتُ لِرَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "اذ قال له ربه اسلم قال اسلمت لرب العٰلمين",
    "ayahnumber" : "131",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "141",
    "page" : "20",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1410",
    "ayah_text" : "وَيَوۡمَ نَحۡشُرُهُمۡ جَمِيعٗا ثُمَّ نَقُولُ لِلَّذِينَ أَشۡرَكُواْ مَكَانَكُمۡ أَنتُمۡ وَشُرَكَآؤُكُمۡۚ فَزَيَّلۡنَا بَيۡنَهُمۡۖ وَقَالَ شُرَكَآؤُهُم مَّا كُنتُمۡ إِيَّانَا تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "ويوم نحشرهم جميعا ثم نقول للذين اشركوا مكانكم انتم وشركاؤكم فزيلنا بينهم وقال شركاؤهم ما كنتم ايانا تعبدون",
    "ayahnumber" : "28",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1410",
    "page" : "212",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1411",
    "ayah_text" : "فَكَفَىٰ بِٱللَّهِ شَهِيدَۢا بَيۡنَنَا وَبَيۡنَكُمۡ إِن كُنَّا عَنۡ عِبَادَتِكُمۡ لَغَٰفِلِينَ",
    "ayah_text_no_diacratic" : "فكفىٰ بالله شهيدا بيننا وبينكم ان كنا عن عبادتكم لغٰفلين",
    "ayahnumber" : "29",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1411",
    "page" : "212",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1412",
    "ayah_text" : "هُنَالِكَ تَبۡلُواْ كُلُّ نَفۡسٖ مَّآ أَسۡلَفَتۡۚ وَرُدُّوٓاْ إِلَى ٱللَّهِ مَوۡلَىٰهُمُ ٱلۡحَقِّۖ وَضَلَّ عَنۡهُم مَّا كَانُواْ يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "هنالك تبلوا كل نفس ما اسلفت وردوا الى الله مولىٰهم الحق وضل عنهم ما كانوا يفترون",
    "ayahnumber" : "30",
    "chapter" : "11",
