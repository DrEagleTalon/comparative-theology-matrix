    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1191",
    "ayah_text" : "وَمَن يُوَلِّهِمۡ يَوۡمَئِذٖ دُبُرَهُۥٓ إِلَّا مُتَحَرِّفٗا لِّقِتَالٍ أَوۡ مُتَحَيِّزًا إِلَىٰ فِئَةٖ فَقَدۡ بَآءَ بِغَضَبٖ مِّنَ ٱللَّهِ وَمَأۡوَىٰهُ جَهَنَّمُۖ وَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "ومن يولهم يومئذ دبره الا متحرفا لقتال او متحيزا الىٰ فئة فقد باء بغضب من الله وماوىٰه جهنم وبئس المصير",
    "ayahnumber" : "16",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1191",
    "page" : "178",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1192",
    "ayah_text" : "فَلَمۡ تَقۡتُلُوهُمۡ وَلَٰكِنَّ ٱللَّهَ قَتَلَهُمۡۚ وَمَا رَمَيۡتَ إِذۡ رَمَيۡتَ وَلَٰكِنَّ ٱللَّهَ رَمَىٰ وَلِيُبۡلِيَ ٱلۡمُؤۡمِنِينَ مِنۡهُ بَلَآءً حَسَنًاۚ إِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "فلم تقتلوهم ولٰكن الله قتلهم وما رميت اذ رميت ولٰكن الله رمىٰ وليبلي المؤمنين منه بلاء حسنا ان الله سميع عليم",
    "ayahnumber" : "17",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1192",
    "page" : "179",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1193",
    "ayah_text" : "ذَٰلِكُمۡ وَأَنَّ ٱللَّهَ مُوهِنُ كَيۡدِ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ذٰلكم وان الله موهن كيد الكٰفرين",
    "ayahnumber" : "18",
