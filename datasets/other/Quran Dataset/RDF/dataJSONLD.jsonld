    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1079",
    "ayah_text" : "يَأۡتُوكَ بِكُلِّ سَٰحِرٍ عَلِيمٖ",
    "ayah_text_no_diacratic" : "ياتوك بكل سٰحر عليم",
