    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:840",
    "ayah_text" : "قُلۡ أَرَءَيۡتَكُمۡ إِنۡ أَتَىٰكُمۡ عَذَابُ ٱللَّهِ أَوۡ أَتَتۡكُمُ ٱلسَّاعَةُ أَغَيۡرَ ٱللَّهِ تَدۡعُونَ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "قل ارءيتكم ان اتىٰكم عذاب الله او اتتكم الساعة اغير الله تدعون ان كنتم صٰدقين",
    "ayahnumber" : "40",
    "chapter" : "7",
    "hizb" : "13",
