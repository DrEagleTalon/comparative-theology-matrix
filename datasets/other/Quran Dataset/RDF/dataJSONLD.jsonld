    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2589",
    "ayah_text" : "قَالَ أَفَتَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكُمۡ شَيۡـٔٗا وَلَا يَضُرُّكُمۡ",
    "ayah_text_no_diacratic" : "قال افتعبدون من دون الله ما لا ينفعكم شيا ولا يضركم",
    "ayahnumber" : "66",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2589",
    "page" : "327",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:259",
    "ayah_text" : "فَلَمَّا فَصَلَ طَالُوتُ بِٱلۡجُنُودِ قَالَ إِنَّ ٱللَّهَ مُبۡتَلِيكُم بِنَهَرٖ فَمَن شَرِبَ مِنۡهُ فَلَيۡسَ مِنِّي وَمَن لَّمۡ يَطۡعَمۡهُ فَإِنَّهُۥ مِنِّيٓ إِلَّا مَنِ ٱغۡتَرَفَ غُرۡفَةَۢ بِيَدِهِۦۚ فَشَرِبُواْ مِنۡهُ إِلَّا قَلِيلٗا مِّنۡهُمۡۚ فَلَمَّا جَاوَزَهُۥ هُوَ وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ قَالُواْ لَا طَاقَةَ لَنَا ٱلۡيَوۡمَ بِجَالُوتَ وَجُنُودِهِۦۚ قَالَ ٱلَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَٰقُواْ ٱللَّهِ كَم مِّن فِئَةٖ قَلِيلَةٍ غَلَبَتۡ فِئَةٗ كَثِيرَةَۢ بِإِذۡنِ ٱللَّهِۗ وَٱللَّهُ مَعَ ٱلصَّٰبِرِينَ",
    "ayah_text_no_diacratic" : "فلما فصل طالوت بالجنود قال ان الله مبتليكم بنهر فمن شرب منه فليس مني ومن لم يطعمه فانه مني الا من اغترف غرفة بيده فشربوا منه الا قليلا منهم فلما جاوزه هو والذين ءامنوا معه قالوا لا طاقة لنا اليوم بجالوت وجنوده قال الذين يظنون انهم ملٰقوا الله كم من فئة قليلة غلبت فئة كثيرة باذن الله والله مع الصٰبرين",
    "ayahnumber" : "249",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "259",
    "page" : "41",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2590",
    "ayah_text" : "أُفّٖ لَّكُمۡ وَلِمَا تَعۡبُدُونَ مِن دُونِ ٱللَّهِۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "اف لكم ولما تعبدون من دون الله افلا تعقلون",
    "ayahnumber" : "67",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2590",
    "page" : "327",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2591",
    "ayah_text" : "قَالُواْ حَرِّقُوهُ وَٱنصُرُوٓاْ ءَالِهَتَكُمۡ إِن كُنتُمۡ فَٰعِلِينَ",
    "ayah_text_no_diacratic" : "قالوا حرقوه وانصروا ءالهتكم ان كنتم فٰعلين",
    "ayahnumber" : "68",
    "chapter" : "17",
