    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5199",
    "ayah_text" : "يَوۡمَ تَرَى ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ يَسۡعَىٰ نُورُهُم بَيۡنَ أَيۡدِيهِمۡ وَبِأَيۡمَٰنِهِمۖ بُشۡرَىٰكُمُ ٱلۡيَوۡمَ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "يوم ترى المؤمنين والمؤمنٰت يسعىٰ نورهم بين ايديهم وبايمٰنهم بشرىٰكم اليوم جنٰت تجري من تحتها الانهٰر خٰلدين فيها ذٰلك هو الفوز العظيم",
    "ayahnumber" : "12",
    "chapter" : "27",
    "hizb" : "53",
