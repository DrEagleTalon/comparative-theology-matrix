  }, {
    "@id" : "quran:4856",
    "ayah_text" : "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "كلوا واشربوا هنيا بما كنتم تعملون",
    "ayahnumber" : "19",
    "chapter" : "27",
