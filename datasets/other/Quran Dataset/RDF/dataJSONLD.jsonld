  }, {
    "@id" : "quran:3192",
    "ayah_text" : "وَمَا تَنَزَّلَتۡ بِهِ ٱلشَّيَٰطِينُ",
    "ayah_text_no_diacratic" : "وما تنزلت به الشيٰطين",
    "ayahnumber" : "210",
