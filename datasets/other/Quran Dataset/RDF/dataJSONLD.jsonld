    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3700",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَٰكَ إِلَّا كَآفَّةٗ لِّلنَّاسِ بَشِيرٗا وَنَذِيرٗا وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وما ارسلنٰك الا كافة للناس بشيرا ونذيرا ولٰكن اكثر الناس لا يعلمون",
