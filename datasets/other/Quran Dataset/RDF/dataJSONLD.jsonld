    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2000",
    "ayah_text" : "ثُمَّ كُلِي مِن كُلِّ ٱلثَّمَرَٰتِ فَٱسۡلُكِي سُبُلَ رَبِّكِ ذُلُلٗاۚ يَخۡرُجُ مِنۢ بُطُونِهَا شَرَابٞ مُّخۡتَلِفٌ أَلۡوَٰنُهُۥ فِيهِ شِفَآءٞ لِّلنَّاسِۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "ثم كلي من كل الثمرٰت فاسلكي سبل ربك ذللا يخرج من بطونها شراب مختلف الوٰنه فيه شفاء للناس ان في ذٰلك لاية لقوم يتفكرون",
    "ayahnumber" : "69",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2000",
    "page" : "274",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2001",
    "ayah_text" : "وَٱللَّهُ خَلَقَكُمۡ ثُمَّ يَتَوَفَّىٰكُمۡۚ وَمِنكُم مَّن يُرَدُّ إِلَىٰٓ أَرۡذَلِ ٱلۡعُمُرِ لِكَيۡ لَا يَعۡلَمَ بَعۡدَ عِلۡمٖ شَيۡـًٔاۚ إِنَّ ٱللَّهَ عَلِيمٞ قَدِيرٞ",
    "ayah_text_no_diacratic" : "والله خلقكم ثم يتوفىٰكم ومنكم من يرد الىٰ ارذل العمر لكي لا يعلم بعد علم شيا ان الله عليم قدير",
    "ayahnumber" : "70",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2001",
    "page" : "274",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2002",
    "ayah_text" : "وَٱللَّهُ فَضَّلَ بَعۡضَكُمۡ عَلَىٰ بَعۡضٖ فِي ٱلرِّزۡقِۚ فَمَا ٱلَّذِينَ فُضِّلُواْ بِرَآدِّي رِزۡقِهِمۡ عَلَىٰ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَهُمۡ فِيهِ سَوَآءٌۚ أَفَبِنِعۡمَةِ ٱللَّهِ يَجۡحَدُونَ",
    "ayah_text_no_diacratic" : "والله فضل بعضكم علىٰ بعض في الرزق فما الذين فضلوا برادي رزقهم علىٰ ما ملكت ايمٰنهم فهم فيه سواء افبنعمة الله يجحدون",
    "ayahnumber" : "71",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2002",
    "page" : "274",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2003",
    "ayah_text" : "وَٱللَّهُ جَعَلَ لَكُم مِّنۡ أَنفُسِكُمۡ أَزۡوَٰجٗا وَجَعَلَ لَكُم مِّنۡ أَزۡوَٰجِكُم بَنِينَ وَحَفَدَةٗ وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِۚ أَفَبِٱلۡبَٰطِلِ يُؤۡمِنُونَ وَبِنِعۡمَتِ ٱللَّهِ هُمۡ يَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "والله جعل لكم من انفسكم ازوٰجا وجعل لكم من ازوٰجكم بنين وحفدة ورزقكم من الطيبٰت افبالبٰطل يؤمنون وبنعمت الله هم يكفرون",
    "ayahnumber" : "72",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2003",
    "page" : "274",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2004",
    "ayah_text" : "وَيَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَمۡلِكُ لَهُمۡ رِزۡقٗا مِّنَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ شَيۡـٔٗا وَلَا يَسۡتَطِيعُونَ",
    "ayah_text_no_diacratic" : "ويعبدون من دون الله ما لا يملك لهم رزقا من السمٰوٰت والارض شيا ولا يستطيعون",
    "ayahnumber" : "73",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2004",
    "page" : "275",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2005",
    "ayah_text" : "فَلَا تَضۡرِبُواْ لِلَّهِ ٱلۡأَمۡثَالَۚ إِنَّ ٱللَّهَ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فلا تضربوا لله الامثال ان الله يعلم وانتم لا تعلمون",
    "ayahnumber" : "74",
    "chapter" : "14",
