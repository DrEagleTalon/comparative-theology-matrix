    "page" : "381",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3267",
    "ayah_text" : "۞فَمَا كَانَ جَوَابَ قَوۡمِهِۦٓ إِلَّآ أَن قَالُوٓاْ أَخۡرِجُوٓاْ ءَالَ لُوطٖ مِّن قَرۡيَتِكُمۡۖ إِنَّهُمۡ أُنَاسٞ يَتَطَهَّرُونَ",
    "ayah_text_no_diacratic" : "فما كان جواب قومه الا ان قالوا اخرجوا ءال لوط من قريتكم انهم اناس يتطهرون",
    "ayahnumber" : "56",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3267",
    "page" : "382",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3268",
    "ayah_text" : "فَأَنجَيۡنَٰهُ وَأَهۡلَهُۥٓ إِلَّا ٱمۡرَأَتَهُۥ قَدَّرۡنَٰهَا مِنَ ٱلۡغَٰبِرِينَ",
    "ayah_text_no_diacratic" : "فانجينٰه واهله الا امراته قدرنٰها من الغٰبرين",
    "ayahnumber" : "57",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3268",
    "page" : "382",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3269",
    "ayah_text" : "وَأَمۡطَرۡنَا عَلَيۡهِم مَّطَرٗاۖ فَسَآءَ مَطَرُ ٱلۡمُنذَرِينَ",
    "ayah_text_no_diacratic" : "وامطرنا عليهم مطرا فساء مطر المنذرين",
    "ayahnumber" : "58",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3269",
    "page" : "382",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:327",
    "ayah_text" : "قُلۡ إِن تُخۡفُواْ مَا فِي صُدُورِكُمۡ أَوۡ تُبۡدُوهُ يَعۡلَمۡهُ ٱللَّهُۗ وَيَعۡلَمُ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "قل ان تخفوا ما في صدوركم او تبدوه يعلمه الله ويعلم ما في السمٰوٰت وما في الارض والله علىٰ كل شيء قدير",
    "ayahnumber" : "29",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "327",
    "page" : "53",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3270",
    "ayah_text" : "قُلِ ٱلۡحَمۡدُ لِلَّهِ وَسَلَٰمٌ عَلَىٰ عِبَادِهِ ٱلَّذِينَ ٱصۡطَفَىٰٓۗ ءَآللَّهُ خَيۡرٌ أَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "قل الحمد لله وسلٰم علىٰ عباده الذين اصطفىٰ ءالله خير اما يشركون",
    "ayahnumber" : "59",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3270",
    "page" : "382",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3271",
    "ayah_text" : "أَمَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَأَنزَلَ لَكُم مِّنَ ٱلسَّمَآءِ مَآءٗ فَأَنۢبَتۡنَا بِهِۦ حَدَآئِقَ ذَاتَ بَهۡجَةٖ مَّا كَانَ لَكُمۡ أَن تُنۢبِتُواْ شَجَرَهَآۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ بَلۡ هُمۡ قَوۡمٞ يَعۡدِلُونَ",
    "ayah_text_no_diacratic" : "امن خلق السمٰوٰت والارض وانزل لكم من السماء ماء فانبتنا به حدائق ذات بهجة ما كان لكم ان تنبتوا شجرها اءلٰه مع الله بل هم قوم يعدلون",
    "ayahnumber" : "60",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3271",
    "page" : "382",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3272",
    "ayah_text" : "أَمَّن جَعَلَ ٱلۡأَرۡضَ قَرَارٗا وَجَعَلَ خِلَٰلَهَآ أَنۡهَٰرٗا وَجَعَلَ لَهَا رَوَٰسِيَ وَجَعَلَ بَيۡنَ ٱلۡبَحۡرَيۡنِ حَاجِزًاۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "امن جعل الارض قرارا وجعل خلٰلها انهٰرا وجعل لها روٰسي وجعل بين البحرين حاجزا اءلٰه مع الله بل اكثرهم لا يعلمون",
    "ayahnumber" : "61",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3272",
    "page" : "382",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3273",
    "ayah_text" : "أَمَّن يُجِيبُ ٱلۡمُضۡطَرَّ إِذَا دَعَاهُ وَيَكۡشِفُ ٱلسُّوٓءَ وَيَجۡعَلُكُمۡ خُلَفَآءَ ٱلۡأَرۡضِۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ قَلِيلٗا مَّا تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "امن يجيب المضطر اذا دعاه ويكشف السوء ويجعلكم خلفاء الارض اءلٰه مع الله قليلا ما تذكرون",
    "ayahnumber" : "62",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3273",
    "page" : "382",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3274",
    "ayah_text" : "أَمَّن يَهۡدِيكُمۡ فِي ظُلُمَٰتِ ٱلۡبَرِّ وَٱلۡبَحۡرِ وَمَن يُرۡسِلُ ٱلرِّيَٰحَ بُشۡرَۢا بَيۡنَ يَدَيۡ رَحۡمَتِهِۦٓۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ تَعَٰلَى ٱللَّهُ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "امن يهديكم في ظلمٰت البر والبحر ومن يرسل الريٰح بشرا بين يدي رحمته اءلٰه مع الله تعٰلى الله عما يشركون",
    "ayahnumber" : "63",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3274",
    "page" : "382",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3275",
    "ayah_text" : "أَمَّن يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥ وَمَن يَرۡزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ قُلۡ هَاتُواْ بُرۡهَٰنَكُمۡ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "امن يبدؤا الخلق ثم يعيده ومن يرزقكم من السماء والارض اءلٰه مع الله قل هاتوا برهٰنكم ان كنتم صٰدقين",
    "ayahnumber" : "64",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3275",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3276",
    "ayah_text" : "قُل لَّا يَعۡلَمُ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ ٱلۡغَيۡبَ إِلَّا ٱللَّهُۚ وَمَا يَشۡعُرُونَ أَيَّانَ يُبۡعَثُونَ",
    "ayah_text_no_diacratic" : "قل لا يعلم من في السمٰوٰت والارض الغيب الا الله وما يشعرون ايان يبعثون",
    "ayahnumber" : "65",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3276",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3277",
    "ayah_text" : "بَلِ ٱدَّٰرَكَ عِلۡمُهُمۡ فِي ٱلۡأٓخِرَةِۚ بَلۡ هُمۡ فِي شَكّٖ مِّنۡهَاۖ بَلۡ هُم مِّنۡهَا عَمُونَ",
    "ayah_text_no_diacratic" : "بل ادٰرك علمهم في الاخرة بل هم في شك منها بل هم منها عمون",
    "ayahnumber" : "66",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3277",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3278",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُوٓاْ أَءِذَا كُنَّا تُرَٰبٗا وَءَابَآؤُنَآ أَئِنَّا لَمُخۡرَجُونَ",
    "ayah_text_no_diacratic" : "وقال الذين كفروا اءذا كنا ترٰبا وءاباؤنا ائنا لمخرجون",
    "ayahnumber" : "67",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3278",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3279",
    "ayah_text" : "لَقَدۡ وُعِدۡنَا هَٰذَا نَحۡنُ وَءَابَآؤُنَا مِن قَبۡلُ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "لقد وعدنا هٰذا نحن وءاباؤنا من قبل ان هٰذا الا اسٰطير الاولين",
    "ayahnumber" : "68",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3279",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:328",
    "ayah_text" : "يَوۡمَ تَجِدُ كُلُّ نَفۡسٖ مَّا عَمِلَتۡ مِنۡ خَيۡرٖ مُّحۡضَرٗا وَمَا عَمِلَتۡ مِن سُوٓءٖ تَوَدُّ لَوۡ أَنَّ بَيۡنَهَا وَبَيۡنَهُۥٓ أَمَدَۢا بَعِيدٗاۗ وَيُحَذِّرُكُمُ ٱللَّهُ نَفۡسَهُۥۗ وَٱللَّهُ رَءُوفُۢ بِٱلۡعِبَادِ",
    "ayah_text_no_diacratic" : "يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو ان بينها وبينه امدا بعيدا ويحذركم الله نفسه والله رءوف بالعباد",
    "ayahnumber" : "30",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "328",
    "page" : "54",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3280",
    "ayah_text" : "قُلۡ سِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "قل سيروا في الارض فانظروا كيف كان عٰقبة المجرمين",
    "ayahnumber" : "69",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3280",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3281",
    "ayah_text" : "وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَلَا تَكُن فِي ضَيۡقٖ مِّمَّا يَمۡكُرُونَ",
    "ayah_text_no_diacratic" : "ولا تحزن عليهم ولا تكن في ضيق مما يمكرون",
    "ayahnumber" : "70",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3281",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3282",
    "ayah_text" : "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ويقولون متىٰ هٰذا الوعد ان كنتم صٰدقين",
    "ayahnumber" : "71",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3282",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3283",
    "ayah_text" : "قُلۡ عَسَىٰٓ أَن يَكُونَ رَدِفَ لَكُم بَعۡضُ ٱلَّذِي تَسۡتَعۡجِلُونَ",
    "ayah_text_no_diacratic" : "قل عسىٰ ان يكون ردف لكم بعض الذي تستعجلون",
    "ayahnumber" : "72",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3283",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3284",
    "ayah_text" : "وَإِنَّ رَبَّكَ لَذُو فَضۡلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "وان ربك لذو فضل على الناس ولٰكن اكثرهم لا يشكرون",
    "ayahnumber" : "73",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3284",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3285",
    "ayah_text" : "وَإِنَّ رَبَّكَ لَيَعۡلَمُ مَا تُكِنُّ صُدُورُهُمۡ وَمَا يُعۡلِنُونَ",
    "ayah_text_no_diacratic" : "وان ربك ليعلم ما تكن صدورهم وما يعلنون",
    "ayahnumber" : "74",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3285",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3286",
    "ayah_text" : "وَمَا مِنۡ غَآئِبَةٖ فِي ٱلسَّمَآءِ وَٱلۡأَرۡضِ إِلَّا فِي كِتَٰبٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "وما من غائبة في السماء والارض الا في كتٰب مبين",
    "ayahnumber" : "75",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3286",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3287",
    "ayah_text" : "إِنَّ هَٰذَا ٱلۡقُرۡءَانَ يَقُصُّ عَلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ أَكۡثَرَ ٱلَّذِي هُمۡ فِيهِ يَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "ان هٰذا القرءان يقص علىٰ بني اسرٰءيل اكثر الذي هم فيه يختلفون",
    "ayahnumber" : "76",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3287",
    "page" : "383",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3288",
    "ayah_text" : "وَإِنَّهُۥ لَهُدٗى وَرَحۡمَةٞ لِّلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وانه لهدى ورحمة للمؤمنين",
    "ayahnumber" : "77",
    "chapter" : "20",
    "hizb" : "38",
