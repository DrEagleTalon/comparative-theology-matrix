    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4047",
    "ayah_text" : "كَمۡ أَهۡلَكۡنَا مِن قَبۡلِهِم مِّن قَرۡنٖ فَنَادَواْ وَّلَاتَ حِينَ مَنَاصٖ",
    "ayah_text_no_diacratic" : "كم اهلكنا من قبلهم من قرن فنادوا ولات حين مناص",
    "ayahnumber" : "3",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4047",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4048",
    "ayah_text" : "وَعَجِبُوٓاْ أَن جَآءَهُم مُّنذِرٞ مِّنۡهُمۡۖ وَقَالَ ٱلۡكَٰفِرُونَ هَٰذَا سَٰحِرٞ كَذَّابٌ",
    "ayah_text_no_diacratic" : "وعجبوا ان جاءهم منذر منهم وقال الكٰفرون هٰذا سٰحر كذاب",
    "ayahnumber" : "4",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4048",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4049",
    "ayah_text" : "أَجَعَلَ ٱلۡأٓلِهَةَ إِلَٰهٗا وَٰحِدًاۖ إِنَّ هَٰذَا لَشَيۡءٌ عُجَابٞ",
    "ayah_text_no_diacratic" : "اجعل الالهة الٰها وٰحدا ان هٰذا لشيء عجاب",
    "ayahnumber" : "5",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4049",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:405",
    "ayah_text" : "وَأَمَّا ٱلَّذِينَ ٱبۡيَضَّتۡ وُجُوهُهُمۡ فَفِي رَحۡمَةِ ٱللَّهِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "واما الذين ابيضت وجوههم ففي رحمة الله هم فيها خٰلدون",
    "ayahnumber" : "107",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "405",
    "page" : "63",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4050",
    "ayah_text" : "وَٱنطَلَقَ ٱلۡمَلَأُ مِنۡهُمۡ أَنِ ٱمۡشُواْ وَٱصۡبِرُواْ عَلَىٰٓ ءَالِهَتِكُمۡۖ إِنَّ هَٰذَا لَشَيۡءٞ يُرَادُ",
    "ayah_text_no_diacratic" : "وانطلق الملا منهم ان امشوا واصبروا علىٰ ءالهتكم ان هٰذا لشيء يراد",
    "ayahnumber" : "6",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4050",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4051",
    "ayah_text" : "مَا سَمِعۡنَا بِهَٰذَا فِي ٱلۡمِلَّةِ ٱلۡأٓخِرَةِ إِنۡ هَٰذَآ إِلَّا ٱخۡتِلَٰقٌ",
    "ayah_text_no_diacratic" : "ما سمعنا بهٰذا في الملة الاخرة ان هٰذا الا اختلٰق",
    "ayahnumber" : "7",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4051",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4052",
    "ayah_text" : "أَءُنزِلَ عَلَيۡهِ ٱلذِّكۡرُ مِنۢ بَيۡنِنَاۚ بَلۡ هُمۡ فِي شَكّٖ مِّن ذِكۡرِيۚ بَل لَّمَّا يَذُوقُواْ عَذَابِ",
    "ayah_text_no_diacratic" : "اءنزل عليه الذكر من بيننا بل هم في شك من ذكري بل لما يذوقوا عذاب",
    "ayahnumber" : "8",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4052",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4053",
    "ayah_text" : "أَمۡ عِندَهُمۡ خَزَآئِنُ رَحۡمَةِ رَبِّكَ ٱلۡعَزِيزِ ٱلۡوَهَّابِ",
    "ayah_text_no_diacratic" : "ام عندهم خزائن رحمة ربك العزيز الوهاب",
    "ayahnumber" : "9",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4053",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4054",
    "ayah_text" : "أَمۡ لَهُم مُّلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَاۖ فَلۡيَرۡتَقُواْ فِي ٱلۡأَسۡبَٰبِ",
    "ayah_text_no_diacratic" : "ام لهم ملك السمٰوٰت والارض وما بينهما فليرتقوا في الاسبٰب",
    "ayahnumber" : "10",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4054",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4055",
    "ayah_text" : "جُندٞ مَّا هُنَالِكَ مَهۡزُومٞ مِّنَ ٱلۡأَحۡزَابِ",
    "ayah_text_no_diacratic" : "جند ما هنالك مهزوم من الاحزاب",
    "ayahnumber" : "11",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4055",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4056",
    "ayah_text" : "كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحٖ وَعَادٞ وَفِرۡعَوۡنُ ذُو ٱلۡأَوۡتَادِ",
    "ayah_text_no_diacratic" : "كذبت قبلهم قوم نوح وعاد وفرعون ذو الاوتاد",
    "ayahnumber" : "12",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4056",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4057",
    "ayah_text" : "وَثَمُودُ وَقَوۡمُ لُوطٖ وَأَصۡحَٰبُ لۡـَٔيۡكَةِۚ أُوْلَٰٓئِكَ ٱلۡأَحۡزَابُ",
    "ayah_text_no_diacratic" : "وثمود وقوم لوط واصحٰب ليكة اولٰئك الاحزاب",
    "ayahnumber" : "13",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4057",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4058",
    "ayah_text" : "إِن كُلٌّ إِلَّا كَذَّبَ ٱلرُّسُلَ فَحَقَّ عِقَابِ",
    "ayah_text_no_diacratic" : "ان كل الا كذب الرسل فحق عقاب",
    "ayahnumber" : "14",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4058",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4059",
    "ayah_text" : "وَمَا يَنظُرُ هَٰٓؤُلَآءِ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ مَّا لَهَا مِن فَوَاقٖ",
    "ayah_text_no_diacratic" : "وما ينظر هٰؤلاء الا صيحة وٰحدة ما لها من فواق",
    "ayahnumber" : "15",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4059",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:406",
    "ayah_text" : "تِلۡكَ ءَايَٰتُ ٱللَّهِ نَتۡلُوهَا عَلَيۡكَ بِٱلۡحَقِّۗ وَمَا ٱللَّهُ يُرِيدُ ظُلۡمٗا لِّلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "تلك ءايٰت الله نتلوها عليك بالحق وما الله يريد ظلما للعٰلمين",
    "ayahnumber" : "108",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "406",
    "page" : "63",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4060",
    "ayah_text" : "وَقَالُواْ رَبَّنَا عَجِّل لَّنَا قِطَّنَا قَبۡلَ يَوۡمِ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "وقالوا ربنا عجل لنا قطنا قبل يوم الحساب",
    "ayahnumber" : "16",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4060",
    "page" : "453",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4061",
    "ayah_text" : "ٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَٱذۡكُرۡ عَبۡدَنَا دَاوُۥدَ ذَا ٱلۡأَيۡدِۖ إِنَّهُۥٓ أَوَّابٌ",
    "ayah_text_no_diacratic" : "اصبر علىٰ ما يقولون واذكر عبدنا داود ذا الايد انه اواب",
    "ayahnumber" : "17",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4061",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4062",
    "ayah_text" : "إِنَّا سَخَّرۡنَا ٱلۡجِبَالَ مَعَهُۥ يُسَبِّحۡنَ بِٱلۡعَشِيِّ وَٱلۡإِشۡرَاقِ",
    "ayah_text_no_diacratic" : "انا سخرنا الجبال معه يسبحن بالعشي والاشراق",
    "ayahnumber" : "18",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4062",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4063",
    "ayah_text" : "وَٱلطَّيۡرَ مَحۡشُورَةٗۖ كُلّٞ لَّهُۥٓ أَوَّابٞ",
    "ayah_text_no_diacratic" : "والطير محشورة كل له اواب",
    "ayahnumber" : "19",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4063",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4064",
    "ayah_text" : "وَشَدَدۡنَا مُلۡكَهُۥ وَءَاتَيۡنَٰهُ ٱلۡحِكۡمَةَ وَفَصۡلَ ٱلۡخِطَابِ",
    "ayah_text_no_diacratic" : "وشددنا ملكه وءاتينٰه الحكمة وفصل الخطاب",
    "ayahnumber" : "20",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4064",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4065",
    "ayah_text" : "۞وَهَلۡ أَتَىٰكَ نَبَؤُاْ ٱلۡخَصۡمِ إِذۡ تَسَوَّرُواْ ٱلۡمِحۡرَابَ",
    "ayah_text_no_diacratic" : "وهل اتىٰك نبؤا الخصم اذ تسوروا المحراب",
    "ayahnumber" : "21",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4065",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4066",
    "ayah_text" : "إِذۡ دَخَلُواْ عَلَىٰ دَاوُۥدَ فَفَزِعَ مِنۡهُمۡۖ قَالُواْ لَا تَخَفۡۖ خَصۡمَانِ بَغَىٰ بَعۡضُنَا عَلَىٰ بَعۡضٖ فَٱحۡكُم بَيۡنَنَا بِٱلۡحَقِّ وَلَا تُشۡطِطۡ وَٱهۡدِنَآ إِلَىٰ سَوَآءِ ٱلصِّرَٰطِ",
    "ayah_text_no_diacratic" : "اذ دخلوا علىٰ داود ففزع منهم قالوا لا تخف خصمان بغىٰ بعضنا علىٰ بعض فاحكم بيننا بالحق ولا تشطط واهدنا الىٰ سواء الصرٰط",
    "ayahnumber" : "22",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4066",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4067",
    "ayah_text" : "إِنَّ هَٰذَآ أَخِي لَهُۥ تِسۡعٞ وَتِسۡعُونَ نَعۡجَةٗ وَلِيَ نَعۡجَةٞ وَٰحِدَةٞ فَقَالَ أَكۡفِلۡنِيهَا وَعَزَّنِي فِي ٱلۡخِطَابِ",
    "ayah_text_no_diacratic" : "ان هٰذا اخي له تسع وتسعون نعجة ولي نعجة وٰحدة فقال اكفلنيها وعزني في الخطاب",
    "ayahnumber" : "23",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4067",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4068",
    "ayah_text" : "قَالَ لَقَدۡ ظَلَمَكَ بِسُؤَالِ نَعۡجَتِكَ إِلَىٰ نِعَاجِهِۦۖ وَإِنَّ كَثِيرٗا مِّنَ ٱلۡخُلَطَآءِ لَيَبۡغِي بَعۡضُهُمۡ عَلَىٰ بَعۡضٍ إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَقَلِيلٞ مَّا هُمۡۗ وَظَنَّ دَاوُۥدُ أَنَّمَا فَتَنَّٰهُ فَٱسۡتَغۡفَرَ رَبَّهُۥ وَخَرَّۤ رَاكِعٗاۤ وَأَنَابَ۩",
    "ayah_text_no_diacratic" : "قال لقد ظلمك بسؤال نعجتك الىٰ نعاجه وان كثيرا من الخلطاء ليبغي بعضهم علىٰ بعض الا الذين ءامنوا وعملوا الصٰلحٰت وقليل ما هم وظن داود انما فتنٰه فاستغفر ربه وخر راكعا واناب",
    "ayahnumber" : "24",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4068",
    "page" : "454",
    "sajdah" : "1",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4069",
    "ayah_text" : "فَغَفَرۡنَا لَهُۥ ذَٰلِكَۖ وَإِنَّ لَهُۥ عِندَنَا لَزُلۡفَىٰ وَحُسۡنَ مَـَٔابٖ",
    "ayah_text_no_diacratic" : "فغفرنا له ذٰلك وان له عندنا لزلفىٰ وحسن ماب",
    "ayahnumber" : "25",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4069",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:407",
    "ayah_text" : "وَلِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ",
    "ayah_text_no_diacratic" : "ولله ما في السمٰوٰت وما في الارض والى الله ترجع الامور",
    "ayahnumber" : "109",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "407",
    "page" : "64",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4070",
    "ayah_text" : "يَٰدَاوُۥدُ إِنَّا جَعَلۡنَٰكَ خَلِيفَةٗ فِي ٱلۡأَرۡضِ فَٱحۡكُم بَيۡنَ ٱلنَّاسِ بِٱلۡحَقِّ وَلَا تَتَّبِعِ ٱلۡهَوَىٰ فَيُضِلَّكَ عَن سَبِيلِ ٱللَّهِۚ إِنَّ ٱلَّذِينَ يَضِلُّونَ عَن سَبِيلِ ٱللَّهِ لَهُمۡ عَذَابٞ شَدِيدُۢ بِمَا نَسُواْ يَوۡمَ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "يٰداود انا جعلنٰك خليفة في الارض فاحكم بين الناس بالحق ولا تتبع الهوىٰ فيضلك عن سبيل الله ان الذين يضلون عن سبيل الله لهم عذاب شديد بما نسوا يوم الحساب",
    "ayahnumber" : "26",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4070",
    "page" : "454",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4071",
    "ayah_text" : "وَمَا خَلَقۡنَا ٱلسَّمَآءَ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا بَٰطِلٗاۚ ذَٰلِكَ ظَنُّ ٱلَّذِينَ كَفَرُواْۚ فَوَيۡلٞ لِّلَّذِينَ كَفَرُواْ مِنَ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "وما خلقنا السماء والارض وما بينهما بٰطلا ذٰلك ظن الذين كفروا فويل للذين كفروا من النار",
    "ayahnumber" : "27",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4071",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4072",
    "ayah_text" : "أَمۡ نَجۡعَلُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ كَٱلۡمُفۡسِدِينَ فِي ٱلۡأَرۡضِ أَمۡ نَجۡعَلُ ٱلۡمُتَّقِينَ كَٱلۡفُجَّارِ",
    "ayah_text_no_diacratic" : "ام نجعل الذين ءامنوا وعملوا الصٰلحٰت كالمفسدين في الارض ام نجعل المتقين كالفجار",
    "ayahnumber" : "28",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4072",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4073",
    "ayah_text" : "كِتَٰبٌ أَنزَلۡنَٰهُ إِلَيۡكَ مُبَٰرَكٞ لِّيَدَّبَّرُوٓاْ ءَايَٰتِهِۦ وَلِيَتَذَكَّرَ أُوْلُواْ ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "كتٰب انزلنٰه اليك مبٰرك ليدبروا ءايٰته وليتذكر اولوا الالبٰب",
    "ayahnumber" : "29",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4073",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4074",
    "ayah_text" : "وَوَهَبۡنَا لِدَاوُۥدَ سُلَيۡمَٰنَۚ نِعۡمَ ٱلۡعَبۡدُ إِنَّهُۥٓ أَوَّابٌ",
    "ayah_text_no_diacratic" : "ووهبنا لداود سليمٰن نعم العبد انه اواب",
    "ayahnumber" : "30",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4074",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4075",
    "ayah_text" : "إِذۡ عُرِضَ عَلَيۡهِ بِٱلۡعَشِيِّ ٱلصَّٰفِنَٰتُ ٱلۡجِيَادُ",
    "ayah_text_no_diacratic" : "اذ عرض عليه بالعشي الصٰفنٰت الجياد",
    "ayahnumber" : "31",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4075",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4076",
    "ayah_text" : "فَقَالَ إِنِّيٓ أَحۡبَبۡتُ حُبَّ ٱلۡخَيۡرِ عَن ذِكۡرِ رَبِّي حَتَّىٰ تَوَارَتۡ بِٱلۡحِجَابِ",
    "ayah_text_no_diacratic" : "فقال اني احببت حب الخير عن ذكر ربي حتىٰ توارت بالحجاب",
    "ayahnumber" : "32",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4076",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4077",
    "ayah_text" : "رُدُّوهَا عَلَيَّۖ فَطَفِقَ مَسۡحَۢا بِٱلسُّوقِ وَٱلۡأَعۡنَاقِ",
    "ayah_text_no_diacratic" : "ردوها علي فطفق مسحا بالسوق والاعناق",
    "ayahnumber" : "33",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4077",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4078",
    "ayah_text" : "وَلَقَدۡ فَتَنَّا سُلَيۡمَٰنَ وَأَلۡقَيۡنَا عَلَىٰ كُرۡسِيِّهِۦ جَسَدٗا ثُمَّ أَنَابَ",
    "ayah_text_no_diacratic" : "ولقد فتنا سليمٰن والقينا علىٰ كرسيه جسدا ثم اناب",
    "ayahnumber" : "34",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4078",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4079",
    "ayah_text" : "قَالَ رَبِّ ٱغۡفِرۡ لِي وَهَبۡ لِي مُلۡكٗا لَّا يَنۢبَغِي لِأَحَدٖ مِّنۢ بَعۡدِيٓۖ إِنَّكَ أَنتَ ٱلۡوَهَّابُ",
    "ayah_text_no_diacratic" : "قال رب اغفر لي وهب لي ملكا لا ينبغي لاحد من بعدي انك انت الوهاب",
    "ayahnumber" : "35",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4079",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:408",
    "ayah_text" : "كُنتُمۡ خَيۡرَ أُمَّةٍ أُخۡرِجَتۡ لِلنَّاسِ تَأۡمُرُونَ بِٱلۡمَعۡرُوفِ وَتَنۡهَوۡنَ عَنِ ٱلۡمُنكَرِ وَتُؤۡمِنُونَ بِٱللَّهِۗ وَلَوۡ ءَامَنَ أَهۡلُ ٱلۡكِتَٰبِ لَكَانَ خَيۡرٗا لَّهُمۚ مِّنۡهُمُ ٱلۡمُؤۡمِنُونَ وَأَكۡثَرُهُمُ ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "كنتم خير امة اخرجت للناس تامرون بالمعروف وتنهون عن المنكر وتؤمنون بالله ولو ءامن اهل الكتٰب لكان خيرا لهم منهم المؤمنون واكثرهم الفٰسقون",
    "ayahnumber" : "110",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "408",
    "page" : "64",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4080",
    "ayah_text" : "فَسَخَّرۡنَا لَهُ ٱلرِّيحَ تَجۡرِي بِأَمۡرِهِۦ رُخَآءً حَيۡثُ أَصَابَ",
    "ayah_text_no_diacratic" : "فسخرنا له الريح تجري بامره رخاء حيث اصاب",
    "ayahnumber" : "36",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4080",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4081",
    "ayah_text" : "وَٱلشَّيَٰطِينَ كُلَّ بَنَّآءٖ وَغَوَّاصٖ",
    "ayah_text_no_diacratic" : "والشيٰطين كل بناء وغواص",
    "ayahnumber" : "37",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4081",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4082",
    "ayah_text" : "وَءَاخَرِينَ مُقَرَّنِينَ فِي ٱلۡأَصۡفَادِ",
    "ayah_text_no_diacratic" : "وءاخرين مقرنين في الاصفاد",
    "ayahnumber" : "38",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4082",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4083",
    "ayah_text" : "هَٰذَا عَطَآؤُنَا فَٱمۡنُنۡ أَوۡ أَمۡسِكۡ بِغَيۡرِ حِسَابٖ",
    "ayah_text_no_diacratic" : "هٰذا عطاؤنا فامنن او امسك بغير حساب",
    "ayahnumber" : "39",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4083",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4084",
    "ayah_text" : "وَإِنَّ لَهُۥ عِندَنَا لَزُلۡفَىٰ وَحُسۡنَ مَـَٔابٖ",
    "ayah_text_no_diacratic" : "وان له عندنا لزلفىٰ وحسن ماب",
    "ayahnumber" : "40",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4084",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4085",
    "ayah_text" : "وَٱذۡكُرۡ عَبۡدَنَآ أَيُّوبَ إِذۡ نَادَىٰ رَبَّهُۥٓ أَنِّي مَسَّنِيَ ٱلشَّيۡطَٰنُ بِنُصۡبٖ وَعَذَابٍ",
    "ayah_text_no_diacratic" : "واذكر عبدنا ايوب اذ نادىٰ ربه اني مسني الشيطٰن بنصب وعذاب",
    "ayahnumber" : "41",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4085",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4086",
    "ayah_text" : "ٱرۡكُضۡ بِرِجۡلِكَۖ هَٰذَا مُغۡتَسَلُۢ بَارِدٞ وَشَرَابٞ",
    "ayah_text_no_diacratic" : "اركض برجلك هٰذا مغتسل بارد وشراب",
    "ayahnumber" : "42",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4086",
    "page" : "455",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4087",
    "ayah_text" : "وَوَهَبۡنَا لَهُۥٓ أَهۡلَهُۥ وَمِثۡلَهُم مَّعَهُمۡ رَحۡمَةٗ مِّنَّا وَذِكۡرَىٰ لِأُوْلِي ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "ووهبنا له اهله ومثلهم معهم رحمة منا وذكرىٰ لاولي الالبٰب",
    "ayahnumber" : "43",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4087",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4088",
    "ayah_text" : "وَخُذۡ بِيَدِكَ ضِغۡثٗا فَٱضۡرِب بِّهِۦ وَلَا تَحۡنَثۡۗ إِنَّا وَجَدۡنَٰهُ صَابِرٗاۚ نِّعۡمَ ٱلۡعَبۡدُ إِنَّهُۥٓ أَوَّابٞ",
    "ayah_text_no_diacratic" : "وخذ بيدك ضغثا فاضرب به ولا تحنث انا وجدنٰه صابرا نعم العبد انه اواب",
    "ayahnumber" : "44",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4088",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4089",
    "ayah_text" : "وَٱذۡكُرۡ عِبَٰدَنَآ إِبۡرَٰهِيمَ وَإِسۡحَٰقَ وَيَعۡقُوبَ أُوْلِي ٱلۡأَيۡدِي وَٱلۡأَبۡصَٰرِ",
    "ayah_text_no_diacratic" : "واذكر عبٰدنا ابرٰهيم واسحٰق ويعقوب اولي الايدي والابصٰر",
    "ayahnumber" : "45",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4089",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:409",
    "ayah_text" : "لَن يَضُرُّوكُمۡ إِلَّآ أَذٗىۖ وَإِن يُقَٰتِلُوكُمۡ يُوَلُّوكُمُ ٱلۡأَدۡبَارَ ثُمَّ لَا يُنصَرُونَ",
    "ayah_text_no_diacratic" : "لن يضروكم الا اذى وان يقٰتلوكم يولوكم الادبار ثم لا ينصرون",
    "ayahnumber" : "111",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "409",
    "page" : "64",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4090",
    "ayah_text" : "إِنَّآ أَخۡلَصۡنَٰهُم بِخَالِصَةٖ ذِكۡرَى ٱلدَّارِ",
    "ayah_text_no_diacratic" : "انا اخلصنٰهم بخالصة ذكرى الدار",
    "ayahnumber" : "46",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4090",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4091",
    "ayah_text" : "وَإِنَّهُمۡ عِندَنَا لَمِنَ ٱلۡمُصۡطَفَيۡنَ ٱلۡأَخۡيَارِ",
    "ayah_text_no_diacratic" : "وانهم عندنا لمن المصطفين الاخيار",
    "ayahnumber" : "47",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4091",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4092",
    "ayah_text" : "وَٱذۡكُرۡ إِسۡمَٰعِيلَ وَٱلۡيَسَعَ وَذَا ٱلۡكِفۡلِۖ وَكُلّٞ مِّنَ ٱلۡأَخۡيَارِ",
    "ayah_text_no_diacratic" : "واذكر اسمٰعيل واليسع وذا الكفل وكل من الاخيار",
    "ayahnumber" : "48",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4092",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4093",
    "ayah_text" : "هَٰذَا ذِكۡرٞۚ وَإِنَّ لِلۡمُتَّقِينَ لَحُسۡنَ مَـَٔابٖ",
    "ayah_text_no_diacratic" : "هٰذا ذكر وان للمتقين لحسن ماب",
    "ayahnumber" : "49",
    "chapter" : "23",
    "hizb" : "45",
