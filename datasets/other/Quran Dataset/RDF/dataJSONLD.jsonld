    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4725",
    "ayah_text" : "يَمُنُّونَ عَلَيۡكَ أَنۡ أَسۡلَمُواْۖ قُل لَّا تَمُنُّواْ عَلَيَّ إِسۡلَٰمَكُمۖ بَلِ ٱللَّهُ يَمُنُّ عَلَيۡكُمۡ أَنۡ هَدَىٰكُمۡ لِلۡإِيمَٰنِ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "يمنون عليك ان اسلموا قل لا تمنوا علي اسلٰمكم بل الله يمن عليكم ان هدىٰكم للايمٰن ان كنتم صٰدقين",
