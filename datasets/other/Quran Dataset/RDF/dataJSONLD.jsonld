    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:792",
    "ayah_text" : "قَالَ عِيسَى ٱبۡنُ مَرۡيَمَ ٱللَّهُمَّ رَبَّنَآ أَنزِلۡ عَلَيۡنَا مَآئِدَةٗ مِّنَ ٱلسَّمَآءِ تَكُونُ لَنَا عِيدٗا لِّأَوَّلِنَا وَءَاخِرِنَا وَءَايَةٗ مِّنكَۖ وَٱرۡزُقۡنَا وَأَنتَ خَيۡرُ ٱلرَّٰزِقِينَ",
    "ayah_text_no_diacratic" : "قال عيسى ابن مريم اللهم ربنا انزل علينا مائدة من السماء تكون لنا عيدا لاولنا وءاخرنا وءاية منك وارزقنا وانت خير الرٰزقين",
    "ayahnumber" : "114",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "792",
    "page" : "127",
    "surahname" : "سُورَةُ المَائـِدَةِ",
