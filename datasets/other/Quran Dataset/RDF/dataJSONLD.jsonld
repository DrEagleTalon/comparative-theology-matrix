    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3921",
    "ayah_text" : "لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ",
    "ayah_text_no_diacratic" : "لمثل هٰذا فليعمل العٰملون",
    "ayahnumber" : "61",
    "chapter" : "23",
