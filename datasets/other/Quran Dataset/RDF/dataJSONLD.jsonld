    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:318",
    "ayah_text" : "فَإِنۡ حَآجُّوكَ فَقُلۡ أَسۡلَمۡتُ وَجۡهِيَ لِلَّهِ وَمَنِ ٱتَّبَعَنِۗ وَقُل لِّلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡأُمِّيِّـۧنَ ءَأَسۡلَمۡتُمۡۚ فَإِنۡ أَسۡلَمُواْ فَقَدِ ٱهۡتَدَواْۖ وَّإِن تَوَلَّوۡاْ فَإِنَّمَا عَلَيۡكَ ٱلۡبَلَٰغُۗ وَٱللَّهُ بَصِيرُۢ بِٱلۡعِبَادِ",
    "ayah_text_no_diacratic" : "فان حاجوك فقل اسلمت وجهي لله ومن اتبعن وقل للذين اوتوا الكتٰب والامين ءاسلمتم فان اسلموا فقد اهتدوا وان تولوا فانما عليك البلٰغ والله بصير بالعباد",
    "ayahnumber" : "20",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "318",
    "page" : "52",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3180",
    "ayah_text" : "وَلَوۡ نَزَّلۡنَٰهُ عَلَىٰ بَعۡضِ ٱلۡأَعۡجَمِينَ",
    "ayah_text_no_diacratic" : "ولو نزلنٰه علىٰ بعض الاعجمين",
    "ayahnumber" : "198",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3180",
    "page" : "375",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3181",
    "ayah_text" : "فَقَرَأَهُۥ عَلَيۡهِم مَّا كَانُواْ بِهِۦ مُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "فقراه عليهم ما كانوا به مؤمنين",
