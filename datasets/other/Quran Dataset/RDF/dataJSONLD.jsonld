    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4857",
    "ayah_text" : "مُتَّكِـِٔينَ عَلَىٰ سُرُرٖ مَّصۡفُوفَةٖۖ وَزَوَّجۡنَٰهُم بِحُورٍ عِينٖ",
    "ayah_text_no_diacratic" : "متكين علىٰ سرر مصفوفة وزوجنٰهم بحور عين",
    "ayahnumber" : "20",
    "chapter" : "27",
    "hizb" : "52",
