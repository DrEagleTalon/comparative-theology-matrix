    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2073",
    "ayah_text" : "وَجَعَلۡنَا ٱلَّيۡلَ وَٱلنَّهَارَ ءَايَتَيۡنِۖ فَمَحَوۡنَآ ءَايَةَ ٱلَّيۡلِ وَجَعَلۡنَآ ءَايَةَ ٱلنَّهَارِ مُبۡصِرَةٗ لِّتَبۡتَغُواْ فَضۡلٗا مِّن رَّبِّكُمۡ وَلِتَعۡلَمُواْ عَدَدَ ٱلسِّنِينَ وَٱلۡحِسَابَۚ وَكُلَّ شَيۡءٖ فَصَّلۡنَٰهُ تَفۡصِيلٗا",
    "ayah_text_no_diacratic" : "وجعلنا اليل والنهار ءايتين فمحونا ءاية اليل وجعلنا ءاية النهار مبصرة لتبتغوا فضلا من ربكم ولتعلموا عدد السنين والحساب وكل شيء فصلنٰه تفصيلا",
    "ayahnumber" : "12",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2073",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2074",
    "ayah_text" : "وَكُلَّ إِنسَٰنٍ أَلۡزَمۡنَٰهُ طَٰٓئِرَهُۥ فِي عُنُقِهِۦۖ وَنُخۡرِجُ لَهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ كِتَٰبٗا يَلۡقَىٰهُ مَنشُورًا",
    "ayah_text_no_diacratic" : "وكل انسٰن الزمنٰه طٰئره في عنقه ونخرج له يوم القيٰمة كتٰبا يلقىٰه منشورا",
    "ayahnumber" : "13",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2074",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2075",
    "ayah_text" : "ٱقۡرَأۡ كِتَٰبَكَ كَفَىٰ بِنَفۡسِكَ ٱلۡيَوۡمَ عَلَيۡكَ حَسِيبٗا",
    "ayah_text_no_diacratic" : "اقرا كتٰبك كفىٰ بنفسك اليوم عليك حسيبا",
    "ayahnumber" : "14",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2075",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2076",
    "ayah_text" : "مَّنِ ٱهۡتَدَىٰ فَإِنَّمَا يَهۡتَدِي لِنَفۡسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيۡهَاۚ وَلَا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰۗ وَمَا كُنَّا مُعَذِّبِينَ حَتَّىٰ نَبۡعَثَ رَسُولٗا",
    "ayah_text_no_diacratic" : "من اهتدىٰ فانما يهتدي لنفسه ومن ضل فانما يضل عليها ولا تزر وازرة وزر اخرىٰ وما كنا معذبين حتىٰ نبعث رسولا",
    "ayahnumber" : "15",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2076",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2077",
    "ayah_text" : "وَإِذَآ أَرَدۡنَآ أَن نُّهۡلِكَ قَرۡيَةً أَمَرۡنَا مُتۡرَفِيهَا فَفَسَقُواْ فِيهَا فَحَقَّ عَلَيۡهَا ٱلۡقَوۡلُ فَدَمَّرۡنَٰهَا تَدۡمِيرٗا",
    "ayah_text_no_diacratic" : "واذا اردنا ان نهلك قرية امرنا مترفيها ففسقوا فيها فحق عليها القول فدمرنٰها تدميرا",
    "ayahnumber" : "16",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2077",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2078",
    "ayah_text" : "وَكَمۡ أَهۡلَكۡنَا مِنَ ٱلۡقُرُونِ مِنۢ بَعۡدِ نُوحٖۗ وَكَفَىٰ بِرَبِّكَ بِذُنُوبِ عِبَادِهِۦ خَبِيرَۢا بَصِيرٗا",
    "ayah_text_no_diacratic" : "وكم اهلكنا من القرون من بعد نوح وكفىٰ بربك بذنوب عباده خبيرا بصيرا",
    "ayahnumber" : "17",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2078",
    "page" : "283",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2079",
    "ayah_text" : "مَّن كَانَ يُرِيدُ ٱلۡعَاجِلَةَ عَجَّلۡنَا لَهُۥ فِيهَا مَا نَشَآءُ لِمَن نُّرِيدُ ثُمَّ جَعَلۡنَا لَهُۥ جَهَنَّمَ يَصۡلَىٰهَا مَذۡمُومٗا مَّدۡحُورٗا",
    "ayah_text_no_diacratic" : "من كان يريد العاجلة عجلنا له فيها ما نشاء لمن نريد ثم جعلنا له جهنم يصلىٰها مذموما مدحورا",
    "ayahnumber" : "18",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2079",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:208",
    "ayah_text" : "لَيۡسَ عَلَيۡكُمۡ جُنَاحٌ أَن تَبۡتَغُواْ فَضۡلٗا مِّن رَّبِّكُمۡۚ فَإِذَآ أَفَضۡتُم مِّنۡ عَرَفَٰتٖ فَٱذۡكُرُواْ ٱللَّهَ عِندَ ٱلۡمَشۡعَرِ ٱلۡحَرَامِۖ وَٱذۡكُرُوهُ كَمَا هَدَىٰكُمۡ وَإِن كُنتُم مِّن قَبۡلِهِۦ لَمِنَ ٱلضَّآلِّينَ",
    "ayah_text_no_diacratic" : "ليس عليكم جناح ان تبتغوا فضلا من ربكم فاذا افضتم من عرفٰت فاذكروا الله عند المشعر الحرام واذكروه كما هدىٰكم وان كنتم من قبله لمن الضالين",
    "ayahnumber" : "198",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "208",
    "page" : "31",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2080",
    "ayah_text" : "وَمَنۡ أَرَادَ ٱلۡأٓخِرَةَ وَسَعَىٰ لَهَا سَعۡيَهَا وَهُوَ مُؤۡمِنٞ فَأُوْلَٰٓئِكَ كَانَ سَعۡيُهُم مَّشۡكُورٗا",
    "ayah_text_no_diacratic" : "ومن اراد الاخرة وسعىٰ لها سعيها وهو مؤمن فاولٰئك كان سعيهم مشكورا",
    "ayahnumber" : "19",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2080",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2081",
    "ayah_text" : "كُلّٗا نُّمِدُّ هَٰٓؤُلَآءِ وَهَٰٓؤُلَآءِ مِنۡ عَطَآءِ رَبِّكَۚ وَمَا كَانَ عَطَآءُ رَبِّكَ مَحۡظُورًا",
    "ayah_text_no_diacratic" : "كلا نمد هٰؤلاء وهٰؤلاء من عطاء ربك وما كان عطاء ربك محظورا",
    "ayahnumber" : "20",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2081",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2082",
    "ayah_text" : "ٱنظُرۡ كَيۡفَ فَضَّلۡنَا بَعۡضَهُمۡ عَلَىٰ بَعۡضٖۚ وَلَلۡأٓخِرَةُ أَكۡبَرُ دَرَجَٰتٖ وَأَكۡبَرُ تَفۡضِيلٗا",
    "ayah_text_no_diacratic" : "انظر كيف فضلنا بعضهم علىٰ بعض وللاخرة اكبر درجٰت واكبر تفضيلا",
    "ayahnumber" : "21",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2082",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2083",
    "ayah_text" : "لَّا تَجۡعَلۡ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَتَقۡعُدَ مَذۡمُومٗا مَّخۡذُولٗا",
    "ayah_text_no_diacratic" : "لا تجعل مع الله الٰها ءاخر فتقعد مذموما مخذولا",
    "ayahnumber" : "22",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2083",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2084",
    "ayah_text" : "۞وَقَضَىٰ رَبُّكَ أَلَّا تَعۡبُدُوٓاْ إِلَّآ إِيَّاهُ وَبِٱلۡوَٰلِدَيۡنِ إِحۡسَٰنًاۚ إِمَّا يَبۡلُغَنَّ عِندَكَ ٱلۡكِبَرَ أَحَدُهُمَآ أَوۡ كِلَاهُمَا فَلَا تَقُل لَّهُمَآ أُفّٖ وَلَا تَنۡهَرۡهُمَا وَقُل لَّهُمَا قَوۡلٗا كَرِيمٗا",
    "ayah_text_no_diacratic" : "وقضىٰ ربك الا تعبدوا الا اياه وبالوٰلدين احسٰنا اما يبلغن عندك الكبر احدهما او كلاهما فلا تقل لهما اف ولا تنهرهما وقل لهما قولا كريما",
    "ayahnumber" : "23",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2084",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2085",
    "ayah_text" : "وَٱخۡفِضۡ لَهُمَا جَنَاحَ ٱلذُّلِّ مِنَ ٱلرَّحۡمَةِ وَقُل رَّبِّ ٱرۡحَمۡهُمَا كَمَا رَبَّيَانِي صَغِيرٗا",
    "ayah_text_no_diacratic" : "واخفض لهما جناح الذل من الرحمة وقل رب ارحمهما كما ربياني صغيرا",
    "ayahnumber" : "24",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2085",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2086",
    "ayah_text" : "رَّبُّكُمۡ أَعۡلَمُ بِمَا فِي نُفُوسِكُمۡۚ إِن تَكُونُواْ صَٰلِحِينَ فَإِنَّهُۥ كَانَ لِلۡأَوَّٰبِينَ غَفُورٗا",
    "ayah_text_no_diacratic" : "ربكم اعلم بما في نفوسكم ان تكونوا صٰلحين فانه كان للاوٰبين غفورا",
    "ayahnumber" : "25",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2086",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2087",
    "ayah_text" : "وَءَاتِ ذَا ٱلۡقُرۡبَىٰ حَقَّهُۥ وَٱلۡمِسۡكِينَ وَٱبۡنَ ٱلسَّبِيلِ وَلَا تُبَذِّرۡ تَبۡذِيرًا",
    "ayah_text_no_diacratic" : "وءات ذا القربىٰ حقه والمسكين وابن السبيل ولا تبذر تبذيرا",
    "ayahnumber" : "26",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2087",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2088",
    "ayah_text" : "إِنَّ ٱلۡمُبَذِّرِينَ كَانُوٓاْ إِخۡوَٰنَ ٱلشَّيَٰطِينِۖ وَكَانَ ٱلشَّيۡطَٰنُ لِرَبِّهِۦ كَفُورٗا",
    "ayah_text_no_diacratic" : "ان المبذرين كانوا اخوٰن الشيٰطين وكان الشيطٰن لربه كفورا",
    "ayahnumber" : "27",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2088",
    "page" : "284",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2089",
    "ayah_text" : "وَإِمَّا تُعۡرِضَنَّ عَنۡهُمُ ٱبۡتِغَآءَ رَحۡمَةٖ مِّن رَّبِّكَ تَرۡجُوهَا فَقُل لَّهُمۡ قَوۡلٗا مَّيۡسُورٗا",
    "ayah_text_no_diacratic" : "واما تعرضن عنهم ابتغاء رحمة من ربك ترجوها فقل لهم قولا ميسورا",
    "ayahnumber" : "28",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2089",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:209",
    "ayah_text" : "ثُمَّ أَفِيضُواْ مِنۡ حَيۡثُ أَفَاضَ ٱلنَّاسُ وَٱسۡتَغۡفِرُواْ ٱللَّهَۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "ثم افيضوا من حيث افاض الناس واستغفروا الله ان الله غفور رحيم",
    "ayahnumber" : "199",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "209",
    "page" : "31",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2090",
    "ayah_text" : "وَلَا تَجۡعَلۡ يَدَكَ مَغۡلُولَةً إِلَىٰ عُنُقِكَ وَلَا تَبۡسُطۡهَا كُلَّ ٱلۡبَسۡطِ فَتَقۡعُدَ مَلُومٗا مَّحۡسُورًا",
    "ayah_text_no_diacratic" : "ولا تجعل يدك مغلولة الىٰ عنقك ولا تبسطها كل البسط فتقعد ملوما محسورا",
    "ayahnumber" : "29",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2090",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2091",
    "ayah_text" : "إِنَّ رَبَّكَ يَبۡسُطُ ٱلرِّزۡقَ لِمَن يَشَآءُ وَيَقۡدِرُۚ إِنَّهُۥ كَانَ بِعِبَادِهِۦ خَبِيرَۢا بَصِيرٗا",
    "ayah_text_no_diacratic" : "ان ربك يبسط الرزق لمن يشاء ويقدر انه كان بعباده خبيرا بصيرا",
    "ayahnumber" : "30",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2091",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2092",
    "ayah_text" : "وَلَا تَقۡتُلُوٓاْ أَوۡلَٰدَكُمۡ خَشۡيَةَ إِمۡلَٰقٖۖ نَّحۡنُ نَرۡزُقُهُمۡ وَإِيَّاكُمۡۚ إِنَّ قَتۡلَهُمۡ كَانَ خِطۡـٔٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "ولا تقتلوا اولٰدكم خشية املٰق نحن نرزقهم واياكم ان قتلهم كان خطا كبيرا",
    "ayahnumber" : "31",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2092",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2093",
    "ayah_text" : "وَلَا تَقۡرَبُواْ ٱلزِّنَىٰٓۖ إِنَّهُۥ كَانَ فَٰحِشَةٗ وَسَآءَ سَبِيلٗا",
    "ayah_text_no_diacratic" : "ولا تقربوا الزنىٰ انه كان فٰحشة وساء سبيلا",
    "ayahnumber" : "32",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2093",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2094",
    "ayah_text" : "وَلَا تَقۡتُلُواْ ٱلنَّفۡسَ ٱلَّتِي حَرَّمَ ٱللَّهُ إِلَّا بِٱلۡحَقِّۗ وَمَن قُتِلَ مَظۡلُومٗا فَقَدۡ جَعَلۡنَا لِوَلِيِّهِۦ سُلۡطَٰنٗا فَلَا يُسۡرِف فِّي ٱلۡقَتۡلِۖ إِنَّهُۥ كَانَ مَنصُورٗا",
    "ayah_text_no_diacratic" : "ولا تقتلوا النفس التي حرم الله الا بالحق ومن قتل مظلوما فقد جعلنا لوليه سلطٰنا فلا يسرف في القتل انه كان منصورا",
    "ayahnumber" : "33",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2094",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2095",
    "ayah_text" : "وَلَا تَقۡرَبُواْ مَالَ ٱلۡيَتِيمِ إِلَّا بِٱلَّتِي هِيَ أَحۡسَنُ حَتَّىٰ يَبۡلُغَ أَشُدَّهُۥۚ وَأَوۡفُواْ بِٱلۡعَهۡدِۖ إِنَّ ٱلۡعَهۡدَ كَانَ مَسۡـُٔولٗا",
    "ayah_text_no_diacratic" : "ولا تقربوا مال اليتيم الا بالتي هي احسن حتىٰ يبلغ اشده واوفوا بالعهد ان العهد كان مسولا",
    "ayahnumber" : "34",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2095",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2096",
    "ayah_text" : "وَأَوۡفُواْ ٱلۡكَيۡلَ إِذَا كِلۡتُمۡ وَزِنُواْ بِٱلۡقِسۡطَاسِ ٱلۡمُسۡتَقِيمِۚ ذَٰلِكَ خَيۡرٞ وَأَحۡسَنُ تَأۡوِيلٗا",
    "ayah_text_no_diacratic" : "واوفوا الكيل اذا كلتم وزنوا بالقسطاس المستقيم ذٰلك خير واحسن تاويلا",
    "ayahnumber" : "35",
    "chapter" : "15",
    "hizb" : "28",
