  }, {
    "@id" : "quran:1741",
    "ayah_text" : "سَوَآءٞ مِّنكُم مَّنۡ أَسَرَّ ٱلۡقَوۡلَ وَمَن جَهَرَ بِهِۦ وَمَنۡ هُوَ مُسۡتَخۡفِۭ بِٱلَّيۡلِ وَسَارِبُۢ بِٱلنَّهَارِ",
    "ayah_text_no_diacratic" : "سواء منكم من اسر القول ومن جهر به ومن هو مستخف باليل وسارب بالنهار",
    "ayahnumber" : "10",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1741",
    "page" : "250",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1742",
    "ayah_text" : "لَهُۥ مُعَقِّبَٰتٞ مِّنۢ بَيۡنِ يَدَيۡهِ وَمِنۡ خَلۡفِهِۦ يَحۡفَظُونَهُۥ مِنۡ أَمۡرِ ٱللَّهِۗ إِنَّ ٱللَّهَ لَا يُغَيِّرُ مَا بِقَوۡمٍ حَتَّىٰ يُغَيِّرُواْ مَا بِأَنفُسِهِمۡۗ وَإِذَآ أَرَادَ ٱللَّهُ بِقَوۡمٖ سُوٓءٗا فَلَا مَرَدَّ لَهُۥۚ وَمَا لَهُم مِّن دُونِهِۦ مِن وَالٍ",
    "ayah_text_no_diacratic" : "له معقبٰت من بين يديه ومن خلفه يحفظونه من امر الله ان الله لا يغير ما بقوم حتىٰ يغيروا ما بانفسهم واذا اراد الله بقوم سوءا فلا مرد له وما لهم من دونه من وال",
    "ayahnumber" : "11",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1742",
    "page" : "250",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1743",
    "ayah_text" : "هُوَ ٱلَّذِي يُرِيكُمُ ٱلۡبَرۡقَ خَوۡفٗا وَطَمَعٗا وَيُنشِئُ ٱلسَّحَابَ ٱلثِّقَالَ",
    "ayah_text_no_diacratic" : "هو الذي يريكم البرق خوفا وطمعا وينشئ السحاب الثقال",
    "ayahnumber" : "12",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1743",
    "page" : "250",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1744",
    "ayah_text" : "وَيُسَبِّحُ ٱلرَّعۡدُ بِحَمۡدِهِۦ وَٱلۡمَلَٰٓئِكَةُ مِنۡ خِيفَتِهِۦ وَيُرۡسِلُ ٱلصَّوَٰعِقَ فَيُصِيبُ بِهَا مَن يَشَآءُ وَهُمۡ يُجَٰدِلُونَ فِي ٱللَّهِ وَهُوَ شَدِيدُ ٱلۡمِحَالِ",
    "ayah_text_no_diacratic" : "ويسبح الرعد بحمده والملٰئكة من خيفته ويرسل الصوٰعق فيصيب بها من يشاء وهم يجٰدلون في الله وهو شديد المحال",
    "ayahnumber" : "13",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1744",
    "page" : "250",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1745",
    "ayah_text" : "لَهُۥ دَعۡوَةُ ٱلۡحَقِّۚ وَٱلَّذِينَ يَدۡعُونَ مِن دُونِهِۦ لَا يَسۡتَجِيبُونَ لَهُم بِشَيۡءٍ إِلَّا كَبَٰسِطِ كَفَّيۡهِ إِلَى ٱلۡمَآءِ لِيَبۡلُغَ فَاهُ وَمَا هُوَ بِبَٰلِغِهِۦۚ وَمَا دُعَآءُ ٱلۡكَٰفِرِينَ إِلَّا فِي ضَلَٰلٖ",
    "ayah_text_no_diacratic" : "له دعوة الحق والذين يدعون من دونه لا يستجيبون لهم بشيء الا كبٰسط كفيه الى الماء ليبلغ فاه وما هو ببٰلغه وما دعاء الكٰفرين الا في ضلٰل",
    "ayahnumber" : "14",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1745",
    "page" : "251",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1746",
    "ayah_text" : "وَلِلَّهِۤ يَسۡجُدُۤ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ طَوۡعٗا وَكَرۡهٗا وَظِلَٰلُهُم بِٱلۡغُدُوِّ وَٱلۡأٓصَالِ۩",
    "ayah_text_no_diacratic" : "ولله يسجد من في السمٰوٰت والارض طوعا وكرها وظلٰلهم بالغدو والاصال",
    "ayahnumber" : "15",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1746",
    "page" : "251",
    "sajdah" : "1",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1747",
    "ayah_text" : "قُلۡ مَن رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ قُلِ ٱللَّهُۚ قُلۡ أَفَٱتَّخَذۡتُم مِّن دُونِهِۦٓ أَوۡلِيَآءَ لَا يَمۡلِكُونَ لِأَنفُسِهِمۡ نَفۡعٗا وَلَا ضَرّٗاۚ قُلۡ هَلۡ يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ أَمۡ هَلۡ تَسۡتَوِي ٱلظُّلُمَٰتُ وَٱلنُّورُۗ أَمۡ جَعَلُواْ لِلَّهِ شُرَكَآءَ خَلَقُواْ كَخَلۡقِهِۦ فَتَشَٰبَهَ ٱلۡخَلۡقُ عَلَيۡهِمۡۚ قُلِ ٱللَّهُ خَٰلِقُ كُلِّ شَيۡءٖ وَهُوَ ٱلۡوَٰحِدُ ٱلۡقَهَّٰرُ",
    "ayah_text_no_diacratic" : "قل من رب السمٰوٰت والارض قل الله قل افاتخذتم من دونه اولياء لا يملكون لانفسهم نفعا ولا ضرا قل هل يستوي الاعمىٰ والبصير ام هل تستوي الظلمٰت والنور ام جعلوا لله شركاء خلقوا كخلقه فتشٰبه الخلق عليهم قل الله خٰلق كل شيء وهو الوٰحد القهٰر",
    "ayahnumber" : "16",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1747",
    "page" : "251",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1748",
    "ayah_text" : "أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَسَالَتۡ أَوۡدِيَةُۢ بِقَدَرِهَا فَٱحۡتَمَلَ ٱلسَّيۡلُ زَبَدٗا رَّابِيٗاۖ وَمِمَّا يُوقِدُونَ عَلَيۡهِ فِي ٱلنَّارِ ٱبۡتِغَآءَ حِلۡيَةٍ أَوۡ مَتَٰعٖ زَبَدٞ مِّثۡلُهُۥۚ كَذَٰلِكَ يَضۡرِبُ ٱللَّهُ ٱلۡحَقَّ وَٱلۡبَٰطِلَۚ فَأَمَّا ٱلزَّبَدُ فَيَذۡهَبُ جُفَآءٗۖ وَأَمَّا مَا يَنفَعُ ٱلنَّاسَ فَيَمۡكُثُ فِي ٱلۡأَرۡضِۚ كَذَٰلِكَ يَضۡرِبُ ٱللَّهُ ٱلۡأَمۡثَالَ",
    "ayah_text_no_diacratic" : "انزل من السماء ماء فسالت اودية بقدرها فاحتمل السيل زبدا رابيا ومما يوقدون عليه في النار ابتغاء حلية او متٰع زبد مثله كذٰلك يضرب الله الحق والبٰطل فاما الزبد فيذهب جفاء واما ما ينفع الناس فيمكث في الارض كذٰلك يضرب الله الامثال",
    "ayahnumber" : "17",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1748",
    "page" : "251",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1749",
    "ayah_text" : "لِلَّذِينَ ٱسۡتَجَابُواْ لِرَبِّهِمُ ٱلۡحُسۡنَىٰۚ وَٱلَّذِينَ لَمۡ يَسۡتَجِيبُواْ لَهُۥ لَوۡ أَنَّ لَهُم مَّا فِي ٱلۡأَرۡضِ جَمِيعٗا وَمِثۡلَهُۥ مَعَهُۥ لَٱفۡتَدَوۡاْ بِهِۦٓۚ أُوْلَٰٓئِكَ لَهُمۡ سُوٓءُ ٱلۡحِسَابِ وَمَأۡوَىٰهُمۡ جَهَنَّمُۖ وَبِئۡسَ ٱلۡمِهَادُ",
    "ayah_text_no_diacratic" : "للذين استجابوا لربهم الحسنىٰ والذين لم يستجيبوا له لو ان لهم ما في الارض جميعا ومثله معه لافتدوا به اولٰئك لهم سوء الحساب وماوىٰهم جهنم وبئس المهاد",
    "ayahnumber" : "18",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1749",
    "page" : "251",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:175",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يَتَّخِذُ مِن دُونِ ٱللَّهِ أَندَادٗا يُحِبُّونَهُمۡ كَحُبِّ ٱللَّهِۖ وَٱلَّذِينَ ءَامَنُوٓاْ أَشَدُّ حُبّٗا لِّلَّهِۗ وَلَوۡ يَرَى ٱلَّذِينَ ظَلَمُوٓاْ إِذۡ يَرَوۡنَ ٱلۡعَذَابَ أَنَّ ٱلۡقُوَّةَ لِلَّهِ جَمِيعٗا وَأَنَّ ٱللَّهَ شَدِيدُ ٱلۡعَذَابِ",
    "ayah_text_no_diacratic" : "ومن الناس من يتخذ من دون الله اندادا يحبونهم كحب الله والذين ءامنوا اشد حبا لله ولو يرى الذين ظلموا اذ يرون العذاب ان القوة لله جميعا وان الله شديد العذاب",
    "ayahnumber" : "165",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "175",
    "page" : "25",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1750",
    "ayah_text" : "۞أَفَمَن يَعۡلَمُ أَنَّمَآ أُنزِلَ إِلَيۡكَ مِن رَّبِّكَ ٱلۡحَقُّ كَمَنۡ هُوَ أَعۡمَىٰٓۚ إِنَّمَا يَتَذَكَّرُ أُوْلُواْ ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "افمن يعلم انما انزل اليك من ربك الحق كمن هو اعمىٰ انما يتذكر اولوا الالبٰب",
    "ayahnumber" : "19",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1750",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1751",
    "ayah_text" : "ٱلَّذِينَ يُوفُونَ بِعَهۡدِ ٱللَّهِ وَلَا يَنقُضُونَ ٱلۡمِيثَٰقَ",
    "ayah_text_no_diacratic" : "الذين يوفون بعهد الله ولا ينقضون الميثٰق",
    "ayahnumber" : "20",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1751",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1752",
    "ayah_text" : "وَٱلَّذِينَ يَصِلُونَ مَآ أَمَرَ ٱللَّهُ بِهِۦٓ أَن يُوصَلَ وَيَخۡشَوۡنَ رَبَّهُمۡ وَيَخَافُونَ سُوٓءَ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "والذين يصلون ما امر الله به ان يوصل ويخشون ربهم ويخافون سوء الحساب",
    "ayahnumber" : "21",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1752",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1753",
    "ayah_text" : "وَٱلَّذِينَ صَبَرُواْ ٱبۡتِغَآءَ وَجۡهِ رَبِّهِمۡ وَأَقَامُواْ ٱلصَّلَوٰةَ وَأَنفَقُواْ مِمَّا رَزَقۡنَٰهُمۡ سِرّٗا وَعَلَانِيَةٗ وَيَدۡرَءُونَ بِٱلۡحَسَنَةِ ٱلسَّيِّئَةَ أُوْلَٰٓئِكَ لَهُمۡ عُقۡبَى ٱلدَّارِ",
    "ayah_text_no_diacratic" : "والذين صبروا ابتغاء وجه ربهم واقاموا الصلوٰة وانفقوا مما رزقنٰهم سرا وعلانية ويدرءون بالحسنة السيئة اولٰئك لهم عقبى الدار",
    "ayahnumber" : "22",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1753",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1754",
    "ayah_text" : "جَنَّٰتُ عَدۡنٖ يَدۡخُلُونَهَا وَمَن صَلَحَ مِنۡ ءَابَآئِهِمۡ وَأَزۡوَٰجِهِمۡ وَذُرِّيَّٰتِهِمۡۖ وَٱلۡمَلَٰٓئِكَةُ يَدۡخُلُونَ عَلَيۡهِم مِّن كُلِّ بَابٖ",
    "ayah_text_no_diacratic" : "جنٰت عدن يدخلونها ومن صلح من ءابائهم وازوٰجهم وذريٰتهم والملٰئكة يدخلون عليهم من كل باب",
    "ayahnumber" : "23",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1754",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1755",
    "ayah_text" : "سَلَٰمٌ عَلَيۡكُم بِمَا صَبَرۡتُمۡۚ فَنِعۡمَ عُقۡبَى ٱلدَّارِ",
    "ayah_text_no_diacratic" : "سلٰم عليكم بما صبرتم فنعم عقبى الدار",
    "ayahnumber" : "24",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1755",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1756",
    "ayah_text" : "وَٱلَّذِينَ يَنقُضُونَ عَهۡدَ ٱللَّهِ مِنۢ بَعۡدِ مِيثَٰقِهِۦ وَيَقۡطَعُونَ مَآ أَمَرَ ٱللَّهُ بِهِۦٓ أَن يُوصَلَ وَيُفۡسِدُونَ فِي ٱلۡأَرۡضِ أُوْلَٰٓئِكَ لَهُمُ ٱللَّعۡنَةُ وَلَهُمۡ سُوٓءُ ٱلدَّارِ",
    "ayah_text_no_diacratic" : "والذين ينقضون عهد الله من بعد ميثٰقه ويقطعون ما امر الله به ان يوصل ويفسدون في الارض اولٰئك لهم اللعنة ولهم سوء الدار",
    "ayahnumber" : "25",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1756",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1757",
    "ayah_text" : "ٱللَّهُ يَبۡسُطُ ٱلرِّزۡقَ لِمَن يَشَآءُ وَيَقۡدِرُۚ وَفَرِحُواْ بِٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَمَا ٱلۡحَيَوٰةُ ٱلدُّنۡيَا فِي ٱلۡأٓخِرَةِ إِلَّا مَتَٰعٞ",
    "ayah_text_no_diacratic" : "الله يبسط الرزق لمن يشاء ويقدر وفرحوا بالحيوٰة الدنيا وما الحيوٰة الدنيا في الاخرة الا متٰع",
    "ayahnumber" : "26",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1757",
