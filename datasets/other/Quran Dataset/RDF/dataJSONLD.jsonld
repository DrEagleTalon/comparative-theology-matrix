    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:920",
    "ayah_text" : "وَذَرُواْ ظَٰهِرَ ٱلۡإِثۡمِ وَبَاطِنَهُۥٓۚ إِنَّ ٱلَّذِينَ يَكۡسِبُونَ ٱلۡإِثۡمَ سَيُجۡزَوۡنَ بِمَا كَانُواْ يَقۡتَرِفُونَ",
    "ayah_text_no_diacratic" : "وذروا ظٰهر الاثم وباطنه ان الذين يكسبون الاثم سيجزون بما كانوا يقترفون",
    "ayahnumber" : "120",
    "chapter" : "8",
    "hizb" : "14",
