    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1884",
    "ayah_text" : "قَالَ أَبَشَّرۡتُمُونِي عَلَىٰٓ أَن مَّسَّنِيَ ٱلۡكِبَرُ فَبِمَ تُبَشِّرُونَ",
    "ayah_text_no_diacratic" : "قال ابشرتموني علىٰ ان مسني الكبر فبم تبشرون",
