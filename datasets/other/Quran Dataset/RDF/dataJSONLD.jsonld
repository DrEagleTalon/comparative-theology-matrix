    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:425",
    "ayah_text" : "لِيَقۡطَعَ طَرَفٗا مِّنَ ٱلَّذِينَ كَفَرُوٓاْ أَوۡ يَكۡبِتَهُمۡ فَيَنقَلِبُواْ خَآئِبِينَ",
    "ayah_text_no_diacratic" : "ليقطع طرفا من الذين كفروا او يكبتهم فينقلبوا خائبين",
    "ayahnumber" : "127",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "425",
    "page" : "66",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4250",
    "ayah_text" : "يَٰقَوۡمِ إِنَّمَا هَٰذِهِ ٱلۡحَيَوٰةُ ٱلدُّنۡيَا مَتَٰعٞ وَإِنَّ ٱلۡأٓخِرَةَ هِيَ دَارُ ٱلۡقَرَارِ",
    "ayah_text_no_diacratic" : "يٰقوم انما هٰذه الحيوٰة الدنيا متٰع وان الاخرة هي دار القرار",
    "ayahnumber" : "39",
    "chapter" : "24",
    "hizb" : "47",
