    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4101",
    "ayah_text" : "هَٰذَا فَلۡيَذُوقُوهُ حَمِيمٞ وَغَسَّاقٞ",
    "ayah_text_no_diacratic" : "هٰذا فليذوقوه حميم وغساق",
    "ayahnumber" : "57",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4101",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4102",
    "ayah_text" : "وَءَاخَرُ مِن شَكۡلِهِۦٓ أَزۡوَٰجٌ",
    "ayah_text_no_diacratic" : "وءاخر من شكله ازوٰج",
    "ayahnumber" : "58",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4102",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4103",
    "ayah_text" : "هَٰذَا فَوۡجٞ مُّقۡتَحِمٞ مَّعَكُمۡ لَا مَرۡحَبَۢا بِهِمۡۚ إِنَّهُمۡ صَالُواْ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "هٰذا فوج مقتحم معكم لا مرحبا بهم انهم صالوا النار",
    "ayahnumber" : "59",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4103",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4104",
    "ayah_text" : "قَالُواْ بَلۡ أَنتُمۡ لَا مَرۡحَبَۢا بِكُمۡۖ أَنتُمۡ قَدَّمۡتُمُوهُ لَنَاۖ فَبِئۡسَ ٱلۡقَرَارُ",
    "ayah_text_no_diacratic" : "قالوا بل انتم لا مرحبا بكم انتم قدمتموه لنا فبئس القرار",
    "ayahnumber" : "60",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4104",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4105",
    "ayah_text" : "قَالُواْ رَبَّنَا مَن قَدَّمَ لَنَا هَٰذَا فَزِدۡهُ عَذَابٗا ضِعۡفٗا فِي ٱلنَّارِ",
    "ayah_text_no_diacratic" : "قالوا ربنا من قدم لنا هٰذا فزده عذابا ضعفا في النار",
    "ayahnumber" : "61",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4105",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4106",
    "ayah_text" : "وَقَالُواْ مَا لَنَا لَا نَرَىٰ رِجَالٗا كُنَّا نَعُدُّهُم مِّنَ ٱلۡأَشۡرَارِ",
    "ayah_text_no_diacratic" : "وقالوا ما لنا لا نرىٰ رجالا كنا نعدهم من الاشرار",
    "ayahnumber" : "62",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4106",
    "page" : "457",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4107",
    "ayah_text" : "أَتَّخَذۡنَٰهُمۡ سِخۡرِيًّا أَمۡ زَاغَتۡ عَنۡهُمُ ٱلۡأَبۡصَٰرُ",
    "ayah_text_no_diacratic" : "اتخذنٰهم سخريا ام زاغت عنهم الابصٰر",
    "ayahnumber" : "63",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4107",
    "page" : "457",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4108",
    "ayah_text" : "إِنَّ ذَٰلِكَ لَحَقّٞ تَخَاصُمُ أَهۡلِ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "ان ذٰلك لحق تخاصم اهل النار",
    "ayahnumber" : "64",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4108",
    "page" : "457",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4109",
    "ayah_text" : "قُلۡ إِنَّمَآ أَنَا۠ مُنذِرٞۖ وَمَا مِنۡ إِلَٰهٍ إِلَّا ٱللَّهُ ٱلۡوَٰحِدُ ٱلۡقَهَّارُ",
    "ayah_text_no_diacratic" : "قل انما انا منذر وما من الٰه الا الله الوٰحد القهار",
    "ayahnumber" : "65",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4109",
    "page" : "457",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:411",
    "ayah_text" : "۞لَيۡسُواْ سَوَآءٗۗ مِّنۡ أَهۡلِ ٱلۡكِتَٰبِ أُمَّةٞ قَآئِمَةٞ يَتۡلُونَ ءَايَٰتِ ٱللَّهِ ءَانَآءَ ٱلَّيۡلِ وَهُمۡ يَسۡجُدُونَ",
    "ayah_text_no_diacratic" : "ليسوا سواء من اهل الكتٰب امة قائمة يتلون ءايٰت الله ءاناء اليل وهم يسجدون",
    "ayahnumber" : "113",
    "chapter" : "4",
    "hizb" : "6",
