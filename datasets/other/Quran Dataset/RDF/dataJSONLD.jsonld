    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3158",
    "ayah_text" : "كَذَّبَ أَصۡحَٰبُ لۡـَٔيۡكَةِ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "كذب اصحٰب ليكة المرسلين",
