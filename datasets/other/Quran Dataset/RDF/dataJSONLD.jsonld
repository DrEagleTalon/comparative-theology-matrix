  }, {
    "@id" : "quran:5234",
    "ayah_text" : "ٱتَّخَذُوٓاْ أَيۡمَٰنَهُمۡ جُنَّةٗ فَصَدُّواْ عَن سَبِيلِ ٱللَّهِ فَلَهُمۡ عَذَابٞ مُّهِينٞ",
    "ayah_text_no_diacratic" : "اتخذوا ايمٰنهم جنة فصدوا عن سبيل الله فلهم عذاب مهين",
