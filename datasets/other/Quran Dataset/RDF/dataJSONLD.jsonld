    "surahnumber" : "85",
    "surrahname_no_diacratic" : "سورة البروج"
  }, {
    "@id" : "quran:6088",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت لهم جنٰت تجري من تحتها الانهٰر ذٰلك الفوز الكبير",
