    "surrahname_no_diacratic" : "سورة الممتحنة"
  }, {
    "@id" : "quran:5275",
    "ayah_text" : "۞عَسَى ٱللَّهُ أَن يَجۡعَلَ بَيۡنَكُمۡ وَبَيۡنَ ٱلَّذِينَ عَادَيۡتُم مِّنۡهُم مَّوَدَّةٗۚ وَٱللَّهُ قَدِيرٞۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "عسى الله ان يجعل بينكم وبين الذين عاديتم منهم مودة والله قدير والله غفور رحيم",
    "ayahnumber" : "7",
