    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4978",
    "ayah_text" : "سَيَعۡلَمُونَ غَدٗا مَّنِ ٱلۡكَذَّابُ ٱلۡأَشِرُ",
    "ayah_text_no_diacratic" : "سيعلمون غدا من الكذاب الاشر",
