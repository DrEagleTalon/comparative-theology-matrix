  }, {
    "@id" : "quran:2247",
    "ayah_text" : "قَالَ لَا تُؤَاخِذۡنِي بِمَا نَسِيتُ وَلَا تُرۡهِقۡنِي مِنۡ أَمۡرِي عُسۡرٗا",
    "ayah_text_no_diacratic" : "قال لا تؤاخذني بما نسيت ولا ترهقني من امري عسرا",
    "ayahnumber" : "73",
    "chapter" : "15",
    "hizb" : "30",
