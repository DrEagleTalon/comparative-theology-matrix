    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3063",
    "ayah_text" : "وَٱلَّذِي يُمِيتُنِي ثُمَّ يُحۡيِينِ",
    "ayah_text_no_diacratic" : "والذي يميتني ثم يحيين",
