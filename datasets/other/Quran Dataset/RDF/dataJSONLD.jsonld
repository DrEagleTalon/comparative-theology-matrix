  }, {
    "@id" : "quran:5149",
    "ayah_text" : "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ",
    "ayah_text_no_diacratic" : "نحن قدرنا بينكم الموت وما نحن بمسبوقين",
