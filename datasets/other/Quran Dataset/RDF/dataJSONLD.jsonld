    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3568",
    "ayah_text" : "أَمۡ يَقُولُونَ ٱفۡتَرَىٰهُۚ بَلۡ هُوَ ٱلۡحَقُّ مِن رَّبِّكَ لِتُنذِرَ قَوۡمٗا مَّآ أَتَىٰهُم مِّن نَّذِيرٖ مِّن قَبۡلِكَ لَعَلَّهُمۡ يَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "ام يقولون افترىٰه بل هو الحق من ربك لتنذر قوما ما اتىٰهم من نذير من قبلك لعلهم يهتدون",
    "ayahnumber" : "3",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3568",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3569",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ مَا لَكُم مِّن دُونِهِۦ مِن وَلِيّٖ وَلَا شَفِيعٍۚ أَفَلَا تَتَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "الله الذي خلق السمٰوٰت والارض وما بينهما في ستة ايام ثم استوىٰ على العرش ما لكم من دونه من ولي ولا شفيع افلا تتذكرون",
    "ayahnumber" : "4",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3569",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:357",
    "ayah_text" : "إِنَّ مَثَلَ عِيسَىٰ عِندَ ٱللَّهِ كَمَثَلِ ءَادَمَۖ خَلَقَهُۥ مِن تُرَابٖ ثُمَّ قَالَ لَهُۥ كُن فَيَكُونُ",
    "ayah_text_no_diacratic" : "ان مثل عيسىٰ عند الله كمثل ءادم خلقه من تراب ثم قال له كن فيكون",
    "ayahnumber" : "59",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "357",
    "page" : "57",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3570",
    "ayah_text" : "يُدَبِّرُ ٱلۡأَمۡرَ مِنَ ٱلسَّمَآءِ إِلَى ٱلۡأَرۡضِ ثُمَّ يَعۡرُجُ إِلَيۡهِ فِي يَوۡمٖ كَانَ مِقۡدَارُهُۥٓ أَلۡفَ سَنَةٖ مِّمَّا تَعُدُّونَ",
    "ayah_text_no_diacratic" : "يدبر الامر من السماء الى الارض ثم يعرج اليه في يوم كان مقداره الف سنة مما تعدون",
    "ayahnumber" : "5",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3570",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3571",
    "ayah_text" : "ذَٰلِكَ عَٰلِمُ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "ذٰلك عٰلم الغيب والشهٰدة العزيز الرحيم",
    "ayahnumber" : "6",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3571",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3572",
    "ayah_text" : "ٱلَّذِيٓ أَحۡسَنَ كُلَّ شَيۡءٍ خَلَقَهُۥۖ وَبَدَأَ خَلۡقَ ٱلۡإِنسَٰنِ مِن طِينٖ",
    "ayah_text_no_diacratic" : "الذي احسن كل شيء خلقه وبدا خلق الانسٰن من طين",
    "ayahnumber" : "7",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3572",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3573",
    "ayah_text" : "ثُمَّ جَعَلَ نَسۡلَهُۥ مِن سُلَٰلَةٖ مِّن مَّآءٖ مَّهِينٖ",
    "ayah_text_no_diacratic" : "ثم جعل نسله من سلٰلة من ماء مهين",
    "ayahnumber" : "8",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3573",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3574",
    "ayah_text" : "ثُمَّ سَوَّىٰهُ وَنَفَخَ فِيهِ مِن رُّوحِهِۦۖ وَجَعَلَ لَكُمُ ٱلسَّمۡعَ وَٱلۡأَبۡصَٰرَ وَٱلۡأَفۡـِٔدَةَۚ قَلِيلٗا مَّا تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "ثم سوىٰه ونفخ فيه من روحه وجعل لكم السمع والابصٰر والافدة قليلا ما تشكرون",
    "ayahnumber" : "9",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3574",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3575",
    "ayah_text" : "وَقَالُوٓاْ أَءِذَا ضَلَلۡنَا فِي ٱلۡأَرۡضِ أَءِنَّا لَفِي خَلۡقٖ جَدِيدِۭۚ بَلۡ هُم بِلِقَآءِ رَبِّهِمۡ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "وقالوا اءذا ضللنا في الارض اءنا لفي خلق جديد بل هم بلقاء ربهم كٰفرون",
    "ayahnumber" : "10",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3575",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3576",
    "ayah_text" : "۞قُلۡ يَتَوَفَّىٰكُم مَّلَكُ ٱلۡمَوۡتِ ٱلَّذِي وُكِّلَ بِكُمۡ ثُمَّ إِلَىٰ رَبِّكُمۡ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "قل يتوفىٰكم ملك الموت الذي وكل بكم ثم الىٰ ربكم ترجعون",
    "ayahnumber" : "11",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3576",
    "page" : "415",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3577",
    "ayah_text" : "وَلَوۡ تَرَىٰٓ إِذِ ٱلۡمُجۡرِمُونَ نَاكِسُواْ رُءُوسِهِمۡ عِندَ رَبِّهِمۡ رَبَّنَآ أَبۡصَرۡنَا وَسَمِعۡنَا فَٱرۡجِعۡنَا نَعۡمَلۡ صَٰلِحًا إِنَّا مُوقِنُونَ",
    "ayah_text_no_diacratic" : "ولو ترىٰ اذ المجرمون ناكسوا رءوسهم عند ربهم ربنا ابصرنا وسمعنا فارجعنا نعمل صٰلحا انا موقنون",
    "ayahnumber" : "12",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3577",
    "page" : "416",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3578",
    "ayah_text" : "وَلَوۡ شِئۡنَا لَأٓتَيۡنَا كُلَّ نَفۡسٍ هُدَىٰهَا وَلَٰكِنۡ حَقَّ ٱلۡقَوۡلُ مِنِّي لَأَمۡلَأَنَّ جَهَنَّمَ مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "ولو شئنا لاتينا كل نفس هدىٰها ولٰكن حق القول مني لاملان جهنم من الجنة والناس اجمعين",
    "ayahnumber" : "13",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3578",
    "page" : "416",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3579",
    "ayah_text" : "فَذُوقُواْ بِمَا نَسِيتُمۡ لِقَآءَ يَوۡمِكُمۡ هَٰذَآ إِنَّا نَسِينَٰكُمۡۖ وَذُوقُواْ عَذَابَ ٱلۡخُلۡدِ بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "فذوقوا بما نسيتم لقاء يومكم هٰذا انا نسينٰكم وذوقوا عذاب الخلد بما كنتم تعملون",
    "ayahnumber" : "14",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3579",
    "page" : "416",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:358",
    "ayah_text" : "ٱلۡحَقُّ مِن رَّبِّكَ فَلَا تَكُن مِّنَ ٱلۡمُمۡتَرِينَ",
    "ayah_text_no_diacratic" : "الحق من ربك فلا تكن من الممترين",
    "ayahnumber" : "60",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "358",
    "page" : "57",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3580",
    "ayah_text" : "إِنَّمَا يُؤۡمِنُ بِـَٔايَٰتِنَا ٱلَّذِينَ إِذَا ذُكِّرُواْ بِهَا خَرُّواْۤ سُجَّدٗاۤ وَسَبَّحُواْ بِحَمۡدِ رَبِّهِمۡ وَهُمۡ لَا يَسۡتَكۡبِرُونَ۩",
    "ayah_text_no_diacratic" : "انما يؤمن بايٰتنا الذين اذا ذكروا بها خروا سجدا وسبحوا بحمد ربهم وهم لا يستكبرون",
    "ayahnumber" : "15",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3580",
    "page" : "416",
    "sajdah" : "1",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3581",
    "ayah_text" : "تَتَجَافَىٰ جُنُوبُهُمۡ عَنِ ٱلۡمَضَاجِعِ يَدۡعُونَ رَبَّهُمۡ خَوۡفٗا وَطَمَعٗا وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ",
    "ayah_text_no_diacratic" : "تتجافىٰ جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا ومما رزقنٰهم ينفقون",
    "ayahnumber" : "16",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3581",
    "page" : "416",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3582",
    "ayah_text" : "فَلَا تَعۡلَمُ نَفۡسٞ مَّآ أُخۡفِيَ لَهُم مِّن قُرَّةِ أَعۡيُنٖ جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "فلا تعلم نفس ما اخفي لهم من قرة اعين جزاء بما كانوا يعملون",
    "ayahnumber" : "17",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3582",
    "page" : "416",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3583",
    "ayah_text" : "أَفَمَن كَانَ مُؤۡمِنٗا كَمَن كَانَ فَاسِقٗاۚ لَّا يَسۡتَوُۥنَ",
    "ayah_text_no_diacratic" : "افمن كان مؤمنا كمن كان فاسقا لا يستون",
    "ayahnumber" : "18",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3583",
    "page" : "416",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3584",
    "ayah_text" : "أَمَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ جَنَّٰتُ ٱلۡمَأۡوَىٰ نُزُلَۢا بِمَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "اما الذين ءامنوا وعملوا الصٰلحٰت فلهم جنٰت الماوىٰ نزلا بما كانوا يعملون",
    "ayahnumber" : "19",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3584",
    "page" : "416",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3585",
    "ayah_text" : "وَأَمَّا ٱلَّذِينَ فَسَقُواْ فَمَأۡوَىٰهُمُ ٱلنَّارُۖ كُلَّمَآ أَرَادُوٓاْ أَن يَخۡرُجُواْ مِنۡهَآ أُعِيدُواْ فِيهَا وَقِيلَ لَهُمۡ ذُوقُواْ عَذَابَ ٱلنَّارِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ",
    "ayah_text_no_diacratic" : "واما الذين فسقوا فماوىٰهم النار كلما ارادوا ان يخرجوا منها اعيدوا فيها وقيل لهم ذوقوا عذاب النار الذي كنتم به تكذبون",
    "ayahnumber" : "20",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3585",
    "page" : "416",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3586",
    "ayah_text" : "وَلَنُذِيقَنَّهُم مِّنَ ٱلۡعَذَابِ ٱلۡأَدۡنَىٰ دُونَ ٱلۡعَذَابِ ٱلۡأَكۡبَرِ لَعَلَّهُمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "ولنذيقنهم من العذاب الادنىٰ دون العذاب الاكبر لعلهم يرجعون",
    "ayahnumber" : "21",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3586",
    "page" : "417",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3587",
    "ayah_text" : "وَمَنۡ أَظۡلَمُ مِمَّن ذُكِّرَ بِـَٔايَٰتِ رَبِّهِۦ ثُمَّ أَعۡرَضَ عَنۡهَآۚ إِنَّا مِنَ ٱلۡمُجۡرِمِينَ مُنتَقِمُونَ",
    "ayah_text_no_diacratic" : "ومن اظلم ممن ذكر بايٰت ربه ثم اعرض عنها انا من المجرمين منتقمون",
    "ayahnumber" : "22",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3587",
    "page" : "417",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3588",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ فَلَا تَكُن فِي مِرۡيَةٖ مِّن لِّقَآئِهِۦۖ وَجَعَلۡنَٰهُ هُدٗى لِّبَنِيٓ إِسۡرَٰٓءِيلَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسى الكتٰب فلا تكن في مرية من لقائه وجعلنٰه هدى لبني اسرٰءيل",
    "ayahnumber" : "23",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3588",
    "page" : "417",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3589",
    "ayah_text" : "وَجَعَلۡنَا مِنۡهُمۡ أَئِمَّةٗ يَهۡدُونَ بِأَمۡرِنَا لَمَّا صَبَرُواْۖ وَكَانُواْ بِـَٔايَٰتِنَا يُوقِنُونَ",
    "ayah_text_no_diacratic" : "وجعلنا منهم ائمة يهدون بامرنا لما صبروا وكانوا بايٰتنا يوقنون",
    "ayahnumber" : "24",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3589",
    "page" : "417",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:359",
    "ayah_text" : "فَمَنۡ حَآجَّكَ فِيهِ مِنۢ بَعۡدِ مَا جَآءَكَ مِنَ ٱلۡعِلۡمِ فَقُلۡ تَعَالَوۡاْ نَدۡعُ أَبۡنَآءَنَا وَأَبۡنَآءَكُمۡ وَنِسَآءَنَا وَنِسَآءَكُمۡ وَأَنفُسَنَا وَأَنفُسَكُمۡ ثُمَّ نَبۡتَهِلۡ فَنَجۡعَل لَّعۡنَتَ ٱللَّهِ عَلَى ٱلۡكَٰذِبِينَ",
    "ayah_text_no_diacratic" : "فمن حاجك فيه من بعد ما جاءك من العلم فقل تعالوا ندع ابناءنا وابناءكم ونساءنا ونساءكم وانفسنا وانفسكم ثم نبتهل فنجعل لعنت الله على الكٰذبين",
    "ayahnumber" : "61",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "359",
    "page" : "57",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3590",
    "ayah_text" : "إِنَّ رَبَّكَ هُوَ يَفۡصِلُ بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "ان ربك هو يفصل بينهم يوم القيٰمة فيما كانوا فيه يختلفون",
    "ayahnumber" : "25",
    "chapter" : "21",
    "hizb" : "41",
