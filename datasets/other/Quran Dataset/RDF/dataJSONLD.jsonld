    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3689",
    "ayah_text" : "ذَٰلِكَ جَزَيۡنَٰهُم بِمَا كَفَرُواْۖ وَهَلۡ نُجَٰزِيٓ إِلَّا ٱلۡكَفُورَ",
    "ayah_text_no_diacratic" : "ذٰلك جزينٰهم بما كفروا وهل نجٰزي الا الكفور",
    "ayahnumber" : "17",
