    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4940",
    "ayah_text" : "وَقَوۡمَ نُوحٖ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُواْ هُمۡ أَظۡلَمَ وَأَطۡغَىٰ",
    "ayah_text_no_diacratic" : "وقوم نوح من قبل انهم كانوا هم اظلم واطغىٰ",
    "ayahnumber" : "52",
