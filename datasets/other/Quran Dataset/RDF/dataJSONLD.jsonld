    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4115",
    "ayah_text" : "إِذۡ قَالَ رَبُّكَ لِلۡمَلَٰٓئِكَةِ إِنِّي خَٰلِقُۢ بَشَرٗا مِّن طِينٖ",
    "ayah_text_no_diacratic" : "اذ قال ربك للملٰئكة اني خٰلق بشرا من طين",
    "ayahnumber" : "71",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4115",
