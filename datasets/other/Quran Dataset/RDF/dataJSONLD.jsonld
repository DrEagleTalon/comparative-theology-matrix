  }, {
    "@id" : "quran:2968",
    "ayah_text" : "وَٱلَّذِينَ يَقُولُونَ رَبَّنَا ٱصۡرِفۡ عَنَّا عَذَابَ جَهَنَّمَۖ إِنَّ عَذَابَهَا كَانَ غَرَامًا",
    "ayah_text_no_diacratic" : "والذين يقولون ربنا اصرف عنا عذاب جهنم ان عذابها كان غراما",
    "ayahnumber" : "65",
    "chapter" : "19",
    "hizb" : "36",
