    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:5294",
    "ayah_text" : "تُؤۡمِنُونَ بِٱللَّهِ وَرَسُولِهِۦ وَتُجَٰهِدُونَ فِي سَبِيلِ ٱللَّهِ بِأَمۡوَٰلِكُمۡ وَأَنفُسِكُمۡۚ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "تؤمنون بالله ورسوله وتجٰهدون في سبيل الله باموٰلكم وانفسكم ذٰلكم خير لكم ان كنتم تعلمون",
    "ayahnumber" : "11",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5294",
    "page" : "552",
    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:5295",
    "ayah_text" : "يَغۡفِرۡ لَكُمۡ ذُنُوبَكُمۡ وَيُدۡخِلۡكُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ وَمَسَٰكِنَ طَيِّبَةٗ فِي جَنَّٰتِ عَدۡنٖۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "يغفر لكم ذنوبكم ويدخلكم جنٰت تجري من تحتها الانهٰر ومسٰكن طيبة في جنٰت عدن ذٰلك الفوز العظيم",
    "ayahnumber" : "12",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5295",
    "page" : "552",
    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:5296",
    "ayah_text" : "وَأُخۡرَىٰ تُحِبُّونَهَاۖ نَصۡرٞ مِّنَ ٱللَّهِ وَفَتۡحٞ قَرِيبٞۗ وَبَشِّرِ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "واخرىٰ تحبونها نصر من الله وفتح قريب وبشر المؤمنين",
    "ayahnumber" : "13",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5296",
    "page" : "552",
    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:5297",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُونُوٓاْ أَنصَارَ ٱللَّهِ كَمَا قَالَ عِيسَى ٱبۡنُ مَرۡيَمَ لِلۡحَوَارِيِّـۧنَ مَنۡ أَنصَارِيٓ إِلَى ٱللَّهِۖ قَالَ ٱلۡحَوَارِيُّونَ نَحۡنُ أَنصَارُ ٱللَّهِۖ فَـَٔامَنَت طَّآئِفَةٞ مِّنۢ بَنِيٓ إِسۡرَٰٓءِيلَ وَكَفَرَت طَّآئِفَةٞۖ فَأَيَّدۡنَا ٱلَّذِينَ ءَامَنُواْ عَلَىٰ عَدُوِّهِمۡ فَأَصۡبَحُواْ ظَٰهِرِينَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا كونوا انصار الله كما قال عيسى ابن مريم للحوارين من انصاري الى الله قال الحواريون نحن انصار الله فامنت طائفة من بني اسرٰءيل وكفرت طائفة فايدنا الذين ءامنوا علىٰ عدوهم فاصبحوا ظٰهرين",
