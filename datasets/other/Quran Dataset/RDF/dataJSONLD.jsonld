    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:430",
    "ayah_text" : "وَأَطِيعُواْ ٱللَّهَ وَٱلرَّسُولَ لَعَلَّكُمۡ تُرۡحَمُونَ",
    "ayah_text_no_diacratic" : "واطيعوا الله والرسول لعلكم ترحمون",
