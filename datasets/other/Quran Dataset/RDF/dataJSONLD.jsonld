    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:178",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ كُلُواْ مِمَّا فِي ٱلۡأَرۡضِ حَلَٰلٗا طَيِّبٗا وَلَا تَتَّبِعُواْ خُطُوَٰتِ ٱلشَّيۡطَٰنِۚ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٌ",
    "ayah_text_no_diacratic" : "يٰايها الناس كلوا مما في الارض حلٰلا طيبا ولا تتبعوا خطوٰت الشيطٰن انه لكم عدو مبين",
    "ayahnumber" : "168",
