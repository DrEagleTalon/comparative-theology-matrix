    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2964",
    "ayah_text" : "تَبَارَكَ ٱلَّذِي جَعَلَ فِي ٱلسَّمَآءِ بُرُوجٗا وَجَعَلَ فِيهَا سِرَٰجٗا وَقَمَرٗا مُّنِيرٗا",
    "ayah_text_no_diacratic" : "تبارك الذي جعل في السماء بروجا وجعل فيها سرٰجا وقمرا منيرا",
    "ayahnumber" : "61",
    "chapter" : "19",
