    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1874",
    "ayah_text" : "لَهَا سَبۡعَةُ أَبۡوَٰبٖ لِّكُلِّ بَابٖ مِّنۡهُمۡ جُزۡءٞ مَّقۡسُومٌ",
    "ayah_text_no_diacratic" : "لها سبعة ابوٰب لكل باب منهم جزء مقسوم",
