    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:948",
    "ayah_text" : "سَيَقُولُ ٱلَّذِينَ أَشۡرَكُواْ لَوۡ شَآءَ ٱللَّهُ مَآ أَشۡرَكۡنَا وَلَآ ءَابَآؤُنَا وَلَا حَرَّمۡنَا مِن شَيۡءٖۚ كَذَٰلِكَ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ حَتَّىٰ ذَاقُواْ بَأۡسَنَاۗ قُلۡ هَلۡ عِندَكُم مِّنۡ عِلۡمٖ فَتُخۡرِجُوهُ لَنَآۖ إِن تَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنۡ أَنتُمۡ إِلَّا تَخۡرُصُونَ",
    "ayah_text_no_diacratic" : "سيقول الذين اشركوا لو شاء الله ما اشركنا ولا ءاباؤنا ولا حرمنا من شيء كذٰلك كذب الذين من قبلهم حتىٰ ذاقوا باسنا قل هل عندكم من علم فتخرجوه لنا ان تتبعون الا الظن وان انتم الا تخرصون",
    "ayahnumber" : "148",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "948",
    "page" : "148",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:949",
    "ayah_text" : "قُلۡ فَلِلَّهِ ٱلۡحُجَّةُ ٱلۡبَٰلِغَةُۖ فَلَوۡ شَآءَ لَهَدَىٰكُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "قل فلله الحجة البٰلغة فلو شاء لهدىٰكم اجمعين",
