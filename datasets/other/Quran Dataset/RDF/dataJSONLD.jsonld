    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3062",
    "ayah_text" : "وَإِذَا مَرِضۡتُ فَهُوَ يَشۡفِينِ",
    "ayah_text_no_diacratic" : "واذا مرضت فهو يشفين",
