    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4119",
    "ayah_text" : "قَالَ يَٰٓإِبۡلِيسُ مَا مَنَعَكَ أَن تَسۡجُدَ لِمَا خَلَقۡتُ بِيَدَيَّۖ أَسۡتَكۡبَرۡتَ أَمۡ كُنتَ مِنَ ٱلۡعَالِينَ",
    "ayah_text_no_diacratic" : "قال يٰابليس ما منعك ان تسجد لما خلقت بيدي استكبرت ام كنت من العالين",
    "ayahnumber" : "75",
    "chapter" : "23",
