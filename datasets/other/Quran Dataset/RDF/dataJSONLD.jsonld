    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1077",
    "ayah_text" : "يُرِيدُ أَن يُخۡرِجَكُم مِّنۡ أَرۡضِكُمۡۖ فَمَاذَا تَأۡمُرُونَ",
    "ayah_text_no_diacratic" : "يريد ان يخرجكم من ارضكم فماذا تامرون",
    "ayahnumber" : "110",
    "chapter" : "9",
