    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4030",
    "ayah_text" : "فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فكفروا به فسوف يعلمون",
