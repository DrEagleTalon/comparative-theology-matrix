    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4134",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4134",
    "page" : "458",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4135",
    "ayah_text" : "تَنزِيلُ ٱلۡكِتَٰبِ مِنَ ٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَكِيمِ",
    "ayah_text_no_diacratic" : "تنزيل الكتٰب من الله العزيز الحكيم",
    "ayahnumber" : "1",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4135",
    "page" : "458",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4136",
    "ayah_text" : "إِنَّآ أَنزَلۡنَآ إِلَيۡكَ ٱلۡكِتَٰبَ بِٱلۡحَقِّ فَٱعۡبُدِ ٱللَّهَ مُخۡلِصٗا لَّهُ ٱلدِّينَ",
    "ayah_text_no_diacratic" : "انا انزلنا اليك الكتٰب بالحق فاعبد الله مخلصا له الدين",
    "ayahnumber" : "2",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4136",
    "page" : "458",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4137",
    "ayah_text" : "أَلَا لِلَّهِ ٱلدِّينُ ٱلۡخَالِصُۚ وَٱلَّذِينَ ٱتَّخَذُواْ مِن دُونِهِۦٓ أَوۡلِيَآءَ مَا نَعۡبُدُهُمۡ إِلَّا لِيُقَرِّبُونَآ إِلَى ٱللَّهِ زُلۡفَىٰٓ إِنَّ ٱللَّهَ يَحۡكُمُ بَيۡنَهُمۡ فِي مَا هُمۡ فِيهِ يَخۡتَلِفُونَۗ إِنَّ ٱللَّهَ لَا يَهۡدِي مَنۡ هُوَ كَٰذِبٞ كَفَّارٞ",
    "ayah_text_no_diacratic" : "الا لله الدين الخالص والذين اتخذوا من دونه اولياء ما نعبدهم الا ليقربونا الى الله زلفىٰ ان الله يحكم بينهم في ما هم فيه يختلفون ان الله لا يهدي من هو كٰذب كفار",
    "ayahnumber" : "3",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4137",
    "page" : "458",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4138",
    "ayah_text" : "لَّوۡ أَرَادَ ٱللَّهُ أَن يَتَّخِذَ وَلَدٗا لَّٱصۡطَفَىٰ مِمَّا يَخۡلُقُ مَا يَشَآءُۚ سُبۡحَٰنَهُۥۖ هُوَ ٱللَّهُ ٱلۡوَٰحِدُ ٱلۡقَهَّارُ",
    "ayah_text_no_diacratic" : "لو اراد الله ان يتخذ ولدا لاصطفىٰ مما يخلق ما يشاء سبحٰنه هو الله الوٰحد القهار",
    "ayahnumber" : "4",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4138",
    "page" : "458",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4139",
    "ayah_text" : "خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۖ يُكَوِّرُ ٱلَّيۡلَ عَلَى ٱلنَّهَارِ وَيُكَوِّرُ ٱلنَّهَارَ عَلَى ٱلَّيۡلِۖ وَسَخَّرَ ٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ يَجۡرِي لِأَجَلٖ مُّسَمًّىۗ أَلَا هُوَ ٱلۡعَزِيزُ ٱلۡغَفَّٰرُ",
    "ayah_text_no_diacratic" : "خلق السمٰوٰت والارض بالحق يكور اليل على النهار ويكور النهار على اليل وسخر الشمس والقمر كل يجري لاجل مسمى الا هو العزيز الغفٰر",
    "ayahnumber" : "5",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4139",
    "page" : "458",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:414",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ لَن تُغۡنِيَ عَنۡهُمۡ أَمۡوَٰلُهُمۡ وَلَآ أَوۡلَٰدُهُم مِّنَ ٱللَّهِ شَيۡـٔٗاۖ وَأُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "ان الذين كفروا لن تغني عنهم اموٰلهم ولا اولٰدهم من الله شيا واولٰئك اصحٰب النار هم فيها خٰلدون",
    "ayahnumber" : "116",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "414",
    "page" : "65",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4140",
    "ayah_text" : "خَلَقَكُم مِّن نَّفۡسٖ وَٰحِدَةٖ ثُمَّ جَعَلَ مِنۡهَا زَوۡجَهَا وَأَنزَلَ لَكُم مِّنَ ٱلۡأَنۡعَٰمِ ثَمَٰنِيَةَ أَزۡوَٰجٖۚ يَخۡلُقُكُمۡ فِي بُطُونِ أُمَّهَٰتِكُمۡ خَلۡقٗا مِّنۢ بَعۡدِ خَلۡقٖ فِي ظُلُمَٰتٖ ثَلَٰثٖۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ لَهُ ٱلۡمُلۡكُۖ لَآ إِلَٰهَ إِلَّا هُوَۖ فَأَنَّىٰ تُصۡرَفُونَ",
    "ayah_text_no_diacratic" : "خلقكم من نفس وٰحدة ثم جعل منها زوجها وانزل لكم من الانعٰم ثمٰنية ازوٰج يخلقكم في بطون امهٰتكم خلقا من بعد خلق في ظلمٰت ثلٰث ذٰلكم الله ربكم له الملك لا الٰه الا هو فانىٰ تصرفون",
    "ayahnumber" : "6",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4140",
    "page" : "459",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4141",
    "ayah_text" : "إِن تَكۡفُرُواْ فَإِنَّ ٱللَّهَ غَنِيٌّ عَنكُمۡۖ وَلَا يَرۡضَىٰ لِعِبَادِهِ ٱلۡكُفۡرَۖ وَإِن تَشۡكُرُواْ يَرۡضَهُ لَكُمۡۗ وَلَا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰۚ ثُمَّ إِلَىٰ رَبِّكُم مَّرۡجِعُكُمۡ فَيُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَۚ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "ان تكفروا فان الله غني عنكم ولا يرضىٰ لعباده الكفر وان تشكروا يرضه لكم ولا تزر وازرة وزر اخرىٰ ثم الىٰ ربكم مرجعكم فينبئكم بما كنتم تعملون انه عليم بذات الصدور",
    "ayahnumber" : "7",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4141",
    "page" : "459",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4142",
    "ayah_text" : "۞وَإِذَا مَسَّ ٱلۡإِنسَٰنَ ضُرّٞ دَعَا رَبَّهُۥ مُنِيبًا إِلَيۡهِ ثُمَّ إِذَا خَوَّلَهُۥ نِعۡمَةٗ مِّنۡهُ نَسِيَ مَا كَانَ يَدۡعُوٓاْ إِلَيۡهِ مِن قَبۡلُ وَجَعَلَ لِلَّهِ أَندَادٗا لِّيُضِلَّ عَن سَبِيلِهِۦۚ قُلۡ تَمَتَّعۡ بِكُفۡرِكَ قَلِيلًا إِنَّكَ مِنۡ أَصۡحَٰبِ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "واذا مس الانسٰن ضر دعا ربه منيبا اليه ثم اذا خوله نعمة منه نسي ما كان يدعوا اليه من قبل وجعل لله اندادا ليضل عن سبيله قل تمتع بكفرك قليلا انك من اصحٰب النار",
    "ayahnumber" : "8",
    "chapter" : "23",
    "hizb" : "46",
    "index" : "4142",
    "page" : "459",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4143",
    "ayah_text" : "أَمَّنۡ هُوَ قَٰنِتٌ ءَانَآءَ ٱلَّيۡلِ سَاجِدٗا وَقَآئِمٗا يَحۡذَرُ ٱلۡأٓخِرَةَ وَيَرۡجُواْ رَحۡمَةَ رَبِّهِۦۗ قُلۡ هَلۡ يَسۡتَوِي ٱلَّذِينَ يَعۡلَمُونَ وَٱلَّذِينَ لَا يَعۡلَمُونَۗ إِنَّمَا يَتَذَكَّرُ أُوْلُواْ ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "امن هو قٰنت ءاناء اليل ساجدا وقائما يحذر الاخرة ويرجوا رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون انما يتذكر اولوا الالبٰب",
    "ayahnumber" : "9",
    "chapter" : "23",
    "hizb" : "46",
