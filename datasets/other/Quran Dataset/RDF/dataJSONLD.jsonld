    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1979",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ إِلَىٰ مَا خَلَقَ ٱللَّهُ مِن شَيۡءٖ يَتَفَيَّؤُاْ ظِلَٰلُهُۥ عَنِ ٱلۡيَمِينِ وَٱلشَّمَآئِلِ سُجَّدٗا لِّلَّهِ وَهُمۡ دَٰخِرُونَ",
    "ayah_text_no_diacratic" : "اولم يروا الىٰ ما خلق الله من شيء يتفيؤا ظلٰله عن اليمين والشمائل سجدا لله وهم دٰخرون",
    "ayahnumber" : "48",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1979",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:198",
    "ayah_text" : "وَلَا تَأۡكُلُوٓاْ أَمۡوَٰلَكُم بَيۡنَكُم بِٱلۡبَٰطِلِ وَتُدۡلُواْ بِهَآ إِلَى ٱلۡحُكَّامِ لِتَأۡكُلُواْ فَرِيقٗا مِّنۡ أَمۡوَٰلِ ٱلنَّاسِ بِٱلۡإِثۡمِ وَأَنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولا تاكلوا اموٰلكم بينكم بالبٰطل وتدلوا بها الى الحكام لتاكلوا فريقا من اموٰل الناس بالاثم وانتم تعلمون",
    "ayahnumber" : "188",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "198",
    "page" : "29",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1980",
    "ayah_text" : "وَلِلَّهِۤ يَسۡجُدُۤ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ مِن دَآبَّةٖ وَٱلۡمَلَٰٓئِكَةُ وَهُمۡ لَا يَسۡتَكۡبِرُونَ",
    "ayah_text_no_diacratic" : "ولله يسجد ما في السمٰوٰت وما في الارض من دابة والملٰئكة وهم لا يستكبرون",
    "ayahnumber" : "49",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1980",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1981",
    "ayah_text" : "يَخَافُونَ رَبَّهُم مِّن فَوۡقِهِمۡ وَيَفۡعَلُونَ مَا يُؤۡمَرُونَ۩",
    "ayah_text_no_diacratic" : "يخافون ربهم من فوقهم ويفعلون ما يؤمرون",
    "ayahnumber" : "50",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1981",
    "page" : "272",
    "sajdah" : "1",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1982",
    "ayah_text" : "۞وَقَالَ ٱللَّهُ لَا تَتَّخِذُوٓاْ إِلَٰهَيۡنِ ٱثۡنَيۡنِۖ إِنَّمَا هُوَ إِلَٰهٞ وَٰحِدٞ فَإِيَّٰيَ فَٱرۡهَبُونِ",
    "ayah_text_no_diacratic" : "وقال الله لا تتخذوا الٰهين اثنين انما هو الٰه وٰحد فايٰي فارهبون",
    "ayahnumber" : "51",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1982",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1983",
    "ayah_text" : "وَلَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَلَهُ ٱلدِّينُ وَاصِبًاۚ أَفَغَيۡرَ ٱللَّهِ تَتَّقُونَ",
    "ayah_text_no_diacratic" : "وله ما في السمٰوٰت والارض وله الدين واصبا افغير الله تتقون",
    "ayahnumber" : "52",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1983",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1984",
    "ayah_text" : "وَمَا بِكُم مِّن نِّعۡمَةٖ فَمِنَ ٱللَّهِۖ ثُمَّ إِذَا مَسَّكُمُ ٱلضُّرُّ فَإِلَيۡهِ تَجۡـَٔرُونَ",
    "ayah_text_no_diacratic" : "وما بكم من نعمة فمن الله ثم اذا مسكم الضر فاليه تجرون",
    "ayahnumber" : "53",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1984",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1985",
    "ayah_text" : "ثُمَّ إِذَا كَشَفَ ٱلضُّرَّ عَنكُمۡ إِذَا فَرِيقٞ مِّنكُم بِرَبِّهِمۡ يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "ثم اذا كشف الضر عنكم اذا فريق منكم بربهم يشركون",
    "ayahnumber" : "54",
