  }, {
    "@id" : "quran:4216",
    "ayah_text" : "كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحٖ وَٱلۡأَحۡزَابُ مِنۢ بَعۡدِهِمۡۖ وَهَمَّتۡ كُلُّ أُمَّةِۭ بِرَسُولِهِمۡ لِيَأۡخُذُوهُۖ وَجَٰدَلُواْ بِٱلۡبَٰطِلِ لِيُدۡحِضُواْ بِهِ ٱلۡحَقَّ فَأَخَذۡتُهُمۡۖ فَكَيۡفَ كَانَ عِقَابِ",
    "ayah_text_no_diacratic" : "كذبت قبلهم قوم نوح والاحزاب من بعدهم وهمت كل امة برسولهم لياخذوه وجٰدلوا بالبٰطل ليدحضوا به الحق فاخذتهم فكيف كان عقاب",
    "ayahnumber" : "5",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4216",
    "page" : "467",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4217",
    "ayah_text" : "وَكَذَٰلِكَ حَقَّتۡ كَلِمَتُ رَبِّكَ عَلَى ٱلَّذِينَ كَفَرُوٓاْ أَنَّهُمۡ أَصۡحَٰبُ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "وكذٰلك حقت كلمت ربك على الذين كفروا انهم اصحٰب النار",
    "ayahnumber" : "6",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4217",
    "page" : "467",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4218",
    "ayah_text" : "ٱلَّذِينَ يَحۡمِلُونَ ٱلۡعَرۡشَ وَمَنۡ حَوۡلَهُۥ يُسَبِّحُونَ بِحَمۡدِ رَبِّهِمۡ وَيُؤۡمِنُونَ بِهِۦ وَيَسۡتَغۡفِرُونَ لِلَّذِينَ ءَامَنُواْۖ رَبَّنَا وَسِعۡتَ كُلَّ شَيۡءٖ رَّحۡمَةٗ وَعِلۡمٗا فَٱغۡفِرۡ لِلَّذِينَ تَابُواْ وَٱتَّبَعُواْ سَبِيلَكَ وَقِهِمۡ عَذَابَ ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "الذين يحملون العرش ومن حوله يسبحون بحمد ربهم ويؤمنون به ويستغفرون للذين ءامنوا ربنا وسعت كل شيء رحمة وعلما فاغفر للذين تابوا واتبعوا سبيلك وقهم عذاب الجحيم",
    "ayahnumber" : "7",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4218",
    "page" : "467",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4219",
    "ayah_text" : "رَبَّنَا وَأَدۡخِلۡهُمۡ جَنَّٰتِ عَدۡنٍ ٱلَّتِي وَعَدتَّهُمۡ وَمَن صَلَحَ مِنۡ ءَابَآئِهِمۡ وَأَزۡوَٰجِهِمۡ وَذُرِّيَّٰتِهِمۡۚ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "ربنا وادخلهم جنٰت عدن التي وعدتهم ومن صلح من ءابائهم وازوٰجهم وذريٰتهم انك انت العزيز الحكيم",
    "ayahnumber" : "8",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4219",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:422",
    "ayah_text" : "إِذۡ تَقُولُ لِلۡمُؤۡمِنِينَ أَلَن يَكۡفِيَكُمۡ أَن يُمِدَّكُمۡ رَبُّكُم بِثَلَٰثَةِ ءَالَٰفٖ مِّنَ ٱلۡمَلَٰٓئِكَةِ مُنزَلِينَ",
    "ayah_text_no_diacratic" : "اذ تقول للمؤمنين الن يكفيكم ان يمدكم ربكم بثلٰثة ءالٰف من الملٰئكة منزلين",
    "ayahnumber" : "124",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "422",
    "page" : "66",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4220",
    "ayah_text" : "وَقِهِمُ ٱلسَّيِّـَٔاتِۚ وَمَن تَقِ ٱلسَّيِّـَٔاتِ يَوۡمَئِذٖ فَقَدۡ رَحِمۡتَهُۥۚ وَذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "وقهم السيات ومن تق السيات يومئذ فقد رحمته وذٰلك هو الفوز العظيم",
    "ayahnumber" : "9",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4220",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4221",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ يُنَادَوۡنَ لَمَقۡتُ ٱللَّهِ أَكۡبَرُ مِن مَّقۡتِكُمۡ أَنفُسَكُمۡ إِذۡ تُدۡعَوۡنَ إِلَى ٱلۡإِيمَٰنِ فَتَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "ان الذين كفروا ينادون لمقت الله اكبر من مقتكم انفسكم اذ تدعون الى الايمٰن فتكفرون",
    "ayahnumber" : "10",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4221",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4222",
    "ayah_text" : "قَالُواْ رَبَّنَآ أَمَتَّنَا ٱثۡنَتَيۡنِ وَأَحۡيَيۡتَنَا ٱثۡنَتَيۡنِ فَٱعۡتَرَفۡنَا بِذُنُوبِنَا فَهَلۡ إِلَىٰ خُرُوجٖ مِّن سَبِيلٖ",
    "ayah_text_no_diacratic" : "قالوا ربنا امتنا اثنتين واحييتنا اثنتين فاعترفنا بذنوبنا فهل الىٰ خروج من سبيل",
    "ayahnumber" : "11",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4222",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4223",
    "ayah_text" : "ذَٰلِكُم بِأَنَّهُۥٓ إِذَا دُعِيَ ٱللَّهُ وَحۡدَهُۥ كَفَرۡتُمۡ وَإِن يُشۡرَكۡ بِهِۦ تُؤۡمِنُواْۚ فَٱلۡحُكۡمُ لِلَّهِ ٱلۡعَلِيِّ ٱلۡكَبِيرِ",
    "ayah_text_no_diacratic" : "ذٰلكم بانه اذا دعي الله وحده كفرتم وان يشرك به تؤمنوا فالحكم لله العلي الكبير",
    "ayahnumber" : "12",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4223",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4224",
    "ayah_text" : "هُوَ ٱلَّذِي يُرِيكُمۡ ءَايَٰتِهِۦ وَيُنَزِّلُ لَكُم مِّنَ ٱلسَّمَآءِ رِزۡقٗاۚ وَمَا يَتَذَكَّرُ إِلَّا مَن يُنِيبُ",
    "ayah_text_no_diacratic" : "هو الذي يريكم ءايٰته وينزل لكم من السماء رزقا وما يتذكر الا من ينيب",
    "ayahnumber" : "13",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4224",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4225",
    "ayah_text" : "فَٱدۡعُواْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ وَلَوۡ كَرِهَ ٱلۡكَٰفِرُونَ",
    "ayah_text_no_diacratic" : "فادعوا الله مخلصين له الدين ولو كره الكٰفرون",
    "ayahnumber" : "14",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4225",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4226",
    "ayah_text" : "رَفِيعُ ٱلدَّرَجَٰتِ ذُو ٱلۡعَرۡشِ يُلۡقِي ٱلرُّوحَ مِنۡ أَمۡرِهِۦ عَلَىٰ مَن يَشَآءُ مِنۡ عِبَادِهِۦ لِيُنذِرَ يَوۡمَ ٱلتَّلَاقِ",
    "ayah_text_no_diacratic" : "رفيع الدرجٰت ذو العرش يلقي الروح من امره علىٰ من يشاء من عباده لينذر يوم التلاق",
    "ayahnumber" : "15",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4226",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4227",
    "ayah_text" : "يَوۡمَ هُم بَٰرِزُونَۖ لَا يَخۡفَىٰ عَلَى ٱللَّهِ مِنۡهُمۡ شَيۡءٞۚ لِّمَنِ ٱلۡمُلۡكُ ٱلۡيَوۡمَۖ لِلَّهِ ٱلۡوَٰحِدِ ٱلۡقَهَّارِ",
    "ayah_text_no_diacratic" : "يوم هم بٰرزون لا يخفىٰ على الله منهم شيء لمن الملك اليوم لله الوٰحد القهار",
    "ayahnumber" : "16",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4227",
    "page" : "468",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4228",
    "ayah_text" : "ٱلۡيَوۡمَ تُجۡزَىٰ كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡۚ لَا ظُلۡمَ ٱلۡيَوۡمَۚ إِنَّ ٱللَّهَ سَرِيعُ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "اليوم تجزىٰ كل نفس بما كسبت لا ظلم اليوم ان الله سريع الحساب",
    "ayahnumber" : "17",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4228",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4229",
    "ayah_text" : "وَأَنذِرۡهُمۡ يَوۡمَ ٱلۡأٓزِفَةِ إِذِ ٱلۡقُلُوبُ لَدَى ٱلۡحَنَاجِرِ كَٰظِمِينَۚ مَا لِلظَّٰلِمِينَ مِنۡ حَمِيمٖ وَلَا شَفِيعٖ يُطَاعُ",
    "ayah_text_no_diacratic" : "وانذرهم يوم الازفة اذ القلوب لدى الحناجر كٰظمين ما للظٰلمين من حميم ولا شفيع يطاع",
    "ayahnumber" : "18",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4229",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:423",
    "ayah_text" : "بَلَىٰٓۚ إِن تَصۡبِرُواْ وَتَتَّقُواْ وَيَأۡتُوكُم مِّن فَوۡرِهِمۡ هَٰذَا يُمۡدِدۡكُمۡ رَبُّكُم بِخَمۡسَةِ ءَالَٰفٖ مِّنَ ٱلۡمَلَٰٓئِكَةِ مُسَوِّمِينَ",
    "ayah_text_no_diacratic" : "بلىٰ ان تصبروا وتتقوا وياتوكم من فورهم هٰذا يمددكم ربكم بخمسة ءالٰف من الملٰئكة مسومين",
    "ayahnumber" : "125",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "423",
    "page" : "66",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4230",
    "ayah_text" : "يَعۡلَمُ خَآئِنَةَ ٱلۡأَعۡيُنِ وَمَا تُخۡفِي ٱلصُّدُورُ",
    "ayah_text_no_diacratic" : "يعلم خائنة الاعين وما تخفي الصدور",
    "ayahnumber" : "19",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4230",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4231",
    "ayah_text" : "وَٱللَّهُ يَقۡضِي بِٱلۡحَقِّۖ وَٱلَّذِينَ يَدۡعُونَ مِن دُونِهِۦ لَا يَقۡضُونَ بِشَيۡءٍۗ إِنَّ ٱللَّهَ هُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ",
    "ayah_text_no_diacratic" : "والله يقضي بالحق والذين يدعون من دونه لا يقضون بشيء ان الله هو السميع البصير",
    "ayahnumber" : "20",
    "chapter" : "24",
    "hizb" : "46",
    "index" : "4231",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4232",
    "ayah_text" : "۞أَوَلَمۡ يَسِيرُواْ فِي ٱلۡأَرۡضِ فَيَنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ كَانُواْ مِن قَبۡلِهِمۡۚ كَانُواْ هُمۡ أَشَدَّ مِنۡهُمۡ قُوَّةٗ وَءَاثَارٗا فِي ٱلۡأَرۡضِ فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمۡ وَمَا كَانَ لَهُم مِّنَ ٱللَّهِ مِن وَاقٖ",
    "ayah_text_no_diacratic" : "اولم يسيروا في الارض فينظروا كيف كان عٰقبة الذين كانوا من قبلهم كانوا هم اشد منهم قوة وءاثارا في الارض فاخذهم الله بذنوبهم وما كان لهم من الله من واق",
    "ayahnumber" : "21",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4232",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4233",
    "ayah_text" : "ذَٰلِكَ بِأَنَّهُمۡ كَانَت تَّأۡتِيهِمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ فَكَفَرُواْ فَأَخَذَهُمُ ٱللَّهُۚ إِنَّهُۥ قَوِيّٞ شَدِيدُ ٱلۡعِقَابِ",
    "ayah_text_no_diacratic" : "ذٰلك بانهم كانت تاتيهم رسلهم بالبينٰت فكفروا فاخذهم الله انه قوي شديد العقاب",
    "ayahnumber" : "22",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4233",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4234",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا مُوسَىٰ بِـَٔايَٰتِنَا وَسُلۡطَٰنٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا موسىٰ بايٰتنا وسلطٰن مبين",
    "ayahnumber" : "23",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4234",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4235",
    "ayah_text" : "إِلَىٰ فِرۡعَوۡنَ وَهَٰمَٰنَ وَقَٰرُونَ فَقَالُواْ سَٰحِرٞ كَذَّابٞ",
    "ayah_text_no_diacratic" : "الىٰ فرعون وهٰمٰن وقٰرون فقالوا سٰحر كذاب",
    "ayahnumber" : "24",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4235",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4236",
    "ayah_text" : "فَلَمَّا جَآءَهُم بِٱلۡحَقِّ مِنۡ عِندِنَا قَالُواْ ٱقۡتُلُوٓاْ أَبۡنَآءَ ٱلَّذِينَ ءَامَنُواْ مَعَهُۥ وَٱسۡتَحۡيُواْ نِسَآءَهُمۡۚ وَمَا كَيۡدُ ٱلۡكَٰفِرِينَ إِلَّا فِي ضَلَٰلٖ",
    "ayah_text_no_diacratic" : "فلما جاءهم بالحق من عندنا قالوا اقتلوا ابناء الذين ءامنوا معه واستحيوا نساءهم وما كيد الكٰفرين الا في ضلٰل",
    "ayahnumber" : "25",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4236",
    "page" : "469",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4237",
    "ayah_text" : "وَقَالَ فِرۡعَوۡنُ ذَرُونِيٓ أَقۡتُلۡ مُوسَىٰ وَلۡيَدۡعُ رَبَّهُۥٓۖ إِنِّيٓ أَخَافُ أَن يُبَدِّلَ دِينَكُمۡ أَوۡ أَن يُظۡهِرَ فِي ٱلۡأَرۡضِ ٱلۡفَسَادَ",
    "ayah_text_no_diacratic" : "وقال فرعون ذروني اقتل موسىٰ وليدع ربه اني اخاف ان يبدل دينكم او ان يظهر في الارض الفساد",
    "ayahnumber" : "26",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4237",
    "page" : "470",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4238",
    "ayah_text" : "وَقَالَ مُوسَىٰٓ إِنِّي عُذۡتُ بِرَبِّي وَرَبِّكُم مِّن كُلِّ مُتَكَبِّرٖ لَّا يُؤۡمِنُ بِيَوۡمِ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "وقال موسىٰ اني عذت بربي وربكم من كل متكبر لا يؤمن بيوم الحساب",
    "ayahnumber" : "27",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4238",
    "page" : "470",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4239",
    "ayah_text" : "وَقَالَ رَجُلٞ مُّؤۡمِنٞ مِّنۡ ءَالِ فِرۡعَوۡنَ يَكۡتُمُ إِيمَٰنَهُۥٓ أَتَقۡتُلُونَ رَجُلًا أَن يَقُولَ رَبِّيَ ٱللَّهُ وَقَدۡ جَآءَكُم بِٱلۡبَيِّنَٰتِ مِن رَّبِّكُمۡۖ وَإِن يَكُ كَٰذِبٗا فَعَلَيۡهِ كَذِبُهُۥۖ وَإِن يَكُ صَادِقٗا يُصِبۡكُم بَعۡضُ ٱلَّذِي يَعِدُكُمۡۖ إِنَّ ٱللَّهَ لَا يَهۡدِي مَنۡ هُوَ مُسۡرِفٞ كَذَّابٞ",
    "ayah_text_no_diacratic" : "وقال رجل مؤمن من ءال فرعون يكتم ايمٰنه اتقتلون رجلا ان يقول ربي الله وقد جاءكم بالبينٰت من ربكم وان يك كٰذبا فعليه كذبه وان يك صادقا يصبكم بعض الذي يعدكم ان الله لا يهدي من هو مسرف كذاب",
    "ayahnumber" : "28",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4239",
    "page" : "470",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:424",
    "ayah_text" : "وَمَا جَعَلَهُ ٱللَّهُ إِلَّا بُشۡرَىٰ لَكُمۡ وَلِتَطۡمَئِنَّ قُلُوبُكُم بِهِۦۗ وَمَا ٱلنَّصۡرُ إِلَّا مِنۡ عِندِ ٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَكِيمِ",
    "ayah_text_no_diacratic" : "وما جعله الله الا بشرىٰ لكم ولتطمئن قلوبكم به وما النصر الا من عند الله العزيز الحكيم",
    "ayahnumber" : "126",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "424",
    "page" : "66",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4240",
    "ayah_text" : "يَٰقَوۡمِ لَكُمُ ٱلۡمُلۡكُ ٱلۡيَوۡمَ ظَٰهِرِينَ فِي ٱلۡأَرۡضِ فَمَن يَنصُرُنَا مِنۢ بَأۡسِ ٱللَّهِ إِن جَآءَنَاۚ قَالَ فِرۡعَوۡنُ مَآ أُرِيكُمۡ إِلَّا مَآ أَرَىٰ وَمَآ أَهۡدِيكُمۡ إِلَّا سَبِيلَ ٱلرَّشَادِ",
    "ayah_text_no_diacratic" : "يٰقوم لكم الملك اليوم ظٰهرين في الارض فمن ينصرنا من باس الله ان جاءنا قال فرعون ما اريكم الا ما ارىٰ وما اهديكم الا سبيل الرشاد",
    "ayahnumber" : "29",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4240",
    "page" : "470",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4241",
    "ayah_text" : "وَقَالَ ٱلَّذِيٓ ءَامَنَ يَٰقَوۡمِ إِنِّيٓ أَخَافُ عَلَيۡكُم مِّثۡلَ يَوۡمِ ٱلۡأَحۡزَابِ",
    "ayah_text_no_diacratic" : "وقال الذي ءامن يٰقوم اني اخاف عليكم مثل يوم الاحزاب",
    "ayahnumber" : "30",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4241",
    "page" : "470",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4242",
    "ayah_text" : "مِثۡلَ دَأۡبِ قَوۡمِ نُوحٖ وَعَادٖ وَثَمُودَ وَٱلَّذِينَ مِنۢ بَعۡدِهِمۡۚ وَمَا ٱللَّهُ يُرِيدُ ظُلۡمٗا لِّلۡعِبَادِ",
    "ayah_text_no_diacratic" : "مثل داب قوم نوح وعاد وثمود والذين من بعدهم وما الله يريد ظلما للعباد",
    "ayahnumber" : "31",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4242",
    "page" : "470",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4243",
    "ayah_text" : "وَيَٰقَوۡمِ إِنِّيٓ أَخَافُ عَلَيۡكُمۡ يَوۡمَ ٱلتَّنَادِ",
    "ayah_text_no_diacratic" : "ويٰقوم اني اخاف عليكم يوم التناد",
    "ayahnumber" : "32",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4243",
