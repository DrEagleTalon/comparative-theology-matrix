    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3006",
    "ayah_text" : "قَالَ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُم مُّوقِنِينَ",
    "ayah_text_no_diacratic" : "قال رب السمٰوٰت والارض وما بينهما ان كنتم موقنين",
