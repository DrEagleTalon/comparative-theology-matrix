    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:818",
    "ayah_text" : "وَهُوَ ٱلۡقَاهِرُ فَوۡقَ عِبَادِهِۦۚ وَهُوَ ٱلۡحَكِيمُ ٱلۡخَبِيرُ",
    "ayah_text_no_diacratic" : "وهو القاهر فوق عباده وهو الحكيم الخبير",
    "ayahnumber" : "18",
    "chapter" : "7",
