    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:403",
    "ayah_text" : "وَلَا تَكُونُواْ كَٱلَّذِينَ تَفَرَّقُواْ وَٱخۡتَلَفُواْ مِنۢ بَعۡدِ مَا جَآءَهُمُ ٱلۡبَيِّنَٰتُۚ وَأُوْلَٰٓئِكَ لَهُمۡ عَذَابٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "ولا تكونوا كالذين تفرقوا واختلفوا من بعد ما جاءهم البينٰت واولٰئك لهم عذاب عظيم",
    "ayahnumber" : "105",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "403",
    "page" : "63",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
