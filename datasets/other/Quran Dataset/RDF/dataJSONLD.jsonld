    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4040",
    "ayah_text" : "سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ",
