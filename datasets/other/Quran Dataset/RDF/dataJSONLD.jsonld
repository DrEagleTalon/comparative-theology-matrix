  }, {
    "@id" : "quran:5020",
    "ayah_text" : "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ",
    "ayah_text_no_diacratic" : "فيها فٰكهة والنخل ذات الاكمام",
