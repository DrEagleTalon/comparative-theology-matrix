  }, {
    "@id" : "quran:4519",
    "ayah_text" : "وَأَن لَّا تَعۡلُواْ عَلَى ٱللَّهِۖ إِنِّيٓ ءَاتِيكُم بِسُلۡطَٰنٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "وان لا تعلوا على الله اني ءاتيكم بسلطٰن مبين",
    "ayahnumber" : "19",
    "chapter" : "25",
    "hizb" : "49",
