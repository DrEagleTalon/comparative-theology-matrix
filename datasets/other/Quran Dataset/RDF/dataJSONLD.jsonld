    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2914",
    "ayah_text" : "بَلۡ كَذَّبُواْ بِٱلسَّاعَةِۖ وَأَعۡتَدۡنَا لِمَن كَذَّبَ بِٱلسَّاعَةِ سَعِيرًا",
    "ayah_text_no_diacratic" : "بل كذبوا بالساعة واعتدنا لمن كذب بالساعة سعيرا",
    "ayahnumber" : "11",
