    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4714",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِن جَآءَكُمۡ فَاسِقُۢ بِنَبَإٖ فَتَبَيَّنُوٓاْ أَن تُصِيبُواْ قَوۡمَۢا بِجَهَٰلَةٖ فَتُصۡبِحُواْ عَلَىٰ مَا فَعَلۡتُمۡ نَٰدِمِينَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ان جاءكم فاسق بنبا فتبينوا ان تصيبوا قوما بجهٰلة فتصبحوا علىٰ ما فعلتم نٰدمين",
    "ayahnumber" : "6",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4714",
    "page" : "516",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4715",
    "ayah_text" : "وَٱعۡلَمُوٓاْ أَنَّ فِيكُمۡ رَسُولَ ٱللَّهِۚ لَوۡ يُطِيعُكُمۡ فِي كَثِيرٖ مِّنَ ٱلۡأَمۡرِ لَعَنِتُّمۡ وَلَٰكِنَّ ٱللَّهَ حَبَّبَ إِلَيۡكُمُ ٱلۡإِيمَٰنَ وَزَيَّنَهُۥ فِي قُلُوبِكُمۡ وَكَرَّهَ إِلَيۡكُمُ ٱلۡكُفۡرَ وَٱلۡفُسُوقَ وَٱلۡعِصۡيَانَۚ أُوْلَٰٓئِكَ هُمُ ٱلرَّٰشِدُونَ",
    "ayah_text_no_diacratic" : "واعلموا ان فيكم رسول الله لو يطيعكم في كثير من الامر لعنتم ولٰكن الله حبب اليكم الايمٰن وزينه في قلوبكم وكره اليكم الكفر والفسوق والعصيان اولٰئك هم الرٰشدون",
    "ayahnumber" : "7",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4715",
