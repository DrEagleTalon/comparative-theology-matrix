    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1691",
    "ayah_text" : "قَالُواْ تَٱللَّهِ لَقَدۡ عَلِمۡتُم مَّا جِئۡنَا لِنُفۡسِدَ فِي ٱلۡأَرۡضِ وَمَا كُنَّا سَٰرِقِينَ",
    "ayah_text_no_diacratic" : "قالوا تالله لقد علمتم ما جئنا لنفسد في الارض وما كنا سٰرقين",
