    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3207",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّهُمۡ فِي كُلِّ وَادٖ يَهِيمُونَ",
    "ayah_text_no_diacratic" : "الم تر انهم في كل واد يهيمون",
