    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3745",
    "ayah_text" : "وَمَا ذَٰلِكَ عَلَى ٱللَّهِ بِعَزِيزٖ",
    "ayah_text_no_diacratic" : "وما ذٰلك على الله بعزيز",
    "ayahnumber" : "17",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3745",
    "page" : "436",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3746",
    "ayah_text" : "وَلَا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰۚ وَإِن تَدۡعُ مُثۡقَلَةٌ إِلَىٰ حِمۡلِهَا لَا يُحۡمَلۡ مِنۡهُ شَيۡءٞ وَلَوۡ كَانَ ذَا قُرۡبَىٰٓۗ إِنَّمَا تُنذِرُ ٱلَّذِينَ يَخۡشَوۡنَ رَبَّهُم بِٱلۡغَيۡبِ وَأَقَامُواْ ٱلصَّلَوٰةَۚ وَمَن تَزَكَّىٰ فَإِنَّمَا يَتَزَكَّىٰ لِنَفۡسِهِۦۚ وَإِلَى ٱللَّهِ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "ولا تزر وازرة وزر اخرىٰ وان تدع مثقلة الىٰ حملها لا يحمل منه شيء ولو كان ذا قربىٰ انما تنذر الذين يخشون ربهم بالغيب واقاموا الصلوٰة ومن تزكىٰ فانما يتزكىٰ لنفسه والى الله المصير",
    "ayahnumber" : "18",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3746",
    "page" : "436",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3747",
    "ayah_text" : "وَمَا يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ",
    "ayah_text_no_diacratic" : "وما يستوي الاعمىٰ والبصير",
    "ayahnumber" : "19",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3747",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3748",
    "ayah_text" : "وَلَا ٱلظُّلُمَٰتُ وَلَا ٱلنُّورُ",
    "ayah_text_no_diacratic" : "ولا الظلمٰت ولا النور",
    "ayahnumber" : "20",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3748",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3749",
    "ayah_text" : "وَلَا ٱلظِّلُّ وَلَا ٱلۡحَرُورُ",
    "ayah_text_no_diacratic" : "ولا الظل ولا الحرور",
    "ayahnumber" : "21",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3749",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:375",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَشۡتَرُونَ بِعَهۡدِ ٱللَّهِ وَأَيۡمَٰنِهِمۡ ثَمَنٗا قَلِيلًا أُوْلَٰٓئِكَ لَا خَلَٰقَ لَهُمۡ فِي ٱلۡأٓخِرَةِ وَلَا يُكَلِّمُهُمُ ٱللَّهُ وَلَا يَنظُرُ إِلَيۡهِمۡ يَوۡمَ ٱلۡقِيَٰمَةِ وَلَا يُزَكِّيهِمۡ وَلَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "ان الذين يشترون بعهد الله وايمٰنهم ثمنا قليلا اولٰئك لا خلٰق لهم في الاخرة ولا يكلمهم الله ولا ينظر اليهم يوم القيٰمة ولا يزكيهم ولهم عذاب اليم",
    "ayahnumber" : "77",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "375",
    "page" : "59",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3750",
    "ayah_text" : "وَمَا يَسۡتَوِي ٱلۡأَحۡيَآءُ وَلَا ٱلۡأَمۡوَٰتُۚ إِنَّ ٱللَّهَ يُسۡمِعُ مَن يَشَآءُۖ وَمَآ أَنتَ بِمُسۡمِعٖ مَّن فِي ٱلۡقُبُورِ",
    "ayah_text_no_diacratic" : "وما يستوي الاحياء ولا الاموٰت ان الله يسمع من يشاء وما انت بمسمع من في القبور",
    "ayahnumber" : "22",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3750",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3751",
    "ayah_text" : "إِنۡ أَنتَ إِلَّا نَذِيرٌ",
    "ayah_text_no_diacratic" : "ان انت الا نذير",
    "ayahnumber" : "23",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3751",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3752",
    "ayah_text" : "إِنَّآ أَرۡسَلۡنَٰكَ بِٱلۡحَقِّ بَشِيرٗا وَنَذِيرٗاۚ وَإِن مِّنۡ أُمَّةٍ إِلَّا خَلَا فِيهَا نَذِيرٞ",
    "ayah_text_no_diacratic" : "انا ارسلنٰك بالحق بشيرا ونذيرا وان من امة الا خلا فيها نذير",
    "ayahnumber" : "24",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3752",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3753",
    "ayah_text" : "وَإِن يُكَذِّبُوكَ فَقَدۡ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ جَآءَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ وَبِٱلزُّبُرِ وَبِٱلۡكِتَٰبِ ٱلۡمُنِيرِ",
    "ayah_text_no_diacratic" : "وان يكذبوك فقد كذب الذين من قبلهم جاءتهم رسلهم بالبينٰت وبالزبر وبالكتٰب المنير",
    "ayahnumber" : "25",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3753",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3754",
    "ayah_text" : "ثُمَّ أَخَذۡتُ ٱلَّذِينَ كَفَرُواْۖ فَكَيۡفَ كَانَ نَكِيرِ",
    "ayah_text_no_diacratic" : "ثم اخذت الذين كفروا فكيف كان نكير",
    "ayahnumber" : "26",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3754",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3755",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱللَّهَ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجۡنَا بِهِۦ ثَمَرَٰتٖ مُّخۡتَلِفًا أَلۡوَٰنُهَاۚ وَمِنَ ٱلۡجِبَالِ جُدَدُۢ بِيضٞ وَحُمۡرٞ مُّخۡتَلِفٌ أَلۡوَٰنُهَا وَغَرَابِيبُ سُودٞ",
    "ayah_text_no_diacratic" : "الم تر ان الله انزل من السماء ماء فاخرجنا به ثمرٰت مختلفا الوٰنها ومن الجبال جدد بيض وحمر مختلف الوٰنها وغرابيب سود",
    "ayahnumber" : "27",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3755",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3756",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ وَٱلدَّوَآبِّ وَٱلۡأَنۡعَٰمِ مُخۡتَلِفٌ أَلۡوَٰنُهُۥ كَذَٰلِكَۗ إِنَّمَا يَخۡشَى ٱللَّهَ مِنۡ عِبَادِهِ ٱلۡعُلَمَٰٓؤُاْۗ إِنَّ ٱللَّهَ عَزِيزٌ غَفُورٌ",
    "ayah_text_no_diacratic" : "ومن الناس والدواب والانعٰم مختلف الوٰنه كذٰلك انما يخشى الله من عباده العلمٰؤا ان الله عزيز غفور",
    "ayahnumber" : "28",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3756",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3757",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَتۡلُونَ كِتَٰبَ ٱللَّهِ وَأَقَامُواْ ٱلصَّلَوٰةَ وَأَنفَقُواْ مِمَّا رَزَقۡنَٰهُمۡ سِرّٗا وَعَلَانِيَةٗ يَرۡجُونَ تِجَٰرَةٗ لَّن تَبُورَ",
    "ayah_text_no_diacratic" : "ان الذين يتلون كتٰب الله واقاموا الصلوٰة وانفقوا مما رزقنٰهم سرا وعلانية يرجون تجٰرة لن تبور",
    "ayahnumber" : "29",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3757",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3758",
    "ayah_text" : "لِيُوَفِّيَهُمۡ أُجُورَهُمۡ وَيَزِيدَهُم مِّن فَضۡلِهِۦٓۚ إِنَّهُۥ غَفُورٞ شَكُورٞ",
    "ayah_text_no_diacratic" : "ليوفيهم اجورهم ويزيدهم من فضله انه غفور شكور",
    "ayahnumber" : "30",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3758",
    "page" : "437",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3759",
    "ayah_text" : "وَٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ مِنَ ٱلۡكِتَٰبِ هُوَ ٱلۡحَقُّ مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِۗ إِنَّ ٱللَّهَ بِعِبَادِهِۦ لَخَبِيرُۢ بَصِيرٞ",
    "ayah_text_no_diacratic" : "والذي اوحينا اليك من الكتٰب هو الحق مصدقا لما بين يديه ان الله بعباده لخبير بصير",
    "ayahnumber" : "31",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3759",
    "page" : "438",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:376",
    "ayah_text" : "وَإِنَّ مِنۡهُمۡ لَفَرِيقٗا يَلۡوُۥنَ أَلۡسِنَتَهُم بِٱلۡكِتَٰبِ لِتَحۡسَبُوهُ مِنَ ٱلۡكِتَٰبِ وَمَا هُوَ مِنَ ٱلۡكِتَٰبِ وَيَقُولُونَ هُوَ مِنۡ عِندِ ٱللَّهِ وَمَا هُوَ مِنۡ عِندِ ٱللَّهِۖ وَيَقُولُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ وَهُمۡ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وان منهم لفريقا يلون السنتهم بالكتٰب لتحسبوه من الكتٰب وما هو من الكتٰب ويقولون هو من عند الله وما هو من عند الله ويقولون على الله الكذب وهم يعلمون",
    "ayahnumber" : "78",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "376",
    "page" : "60",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3760",
    "ayah_text" : "ثُمَّ أَوۡرَثۡنَا ٱلۡكِتَٰبَ ٱلَّذِينَ ٱصۡطَفَيۡنَا مِنۡ عِبَادِنَاۖ فَمِنۡهُمۡ ظَالِمٞ لِّنَفۡسِهِۦ وَمِنۡهُم مُّقۡتَصِدٞ وَمِنۡهُمۡ سَابِقُۢ بِٱلۡخَيۡرَٰتِ بِإِذۡنِ ٱللَّهِۚ ذَٰلِكَ هُوَ ٱلۡفَضۡلُ ٱلۡكَبِيرُ",
    "ayah_text_no_diacratic" : "ثم اورثنا الكتٰب الذين اصطفينا من عبادنا فمنهم ظالم لنفسه ومنهم مقتصد ومنهم سابق بالخيرٰت باذن الله ذٰلك هو الفضل الكبير",
    "ayahnumber" : "32",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3760",
    "page" : "438",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3761",
    "ayah_text" : "جَنَّٰتُ عَدۡنٖ يَدۡخُلُونَهَا يُحَلَّوۡنَ فِيهَا مِنۡ أَسَاوِرَ مِن ذَهَبٖ وَلُؤۡلُؤٗاۖ وَلِبَاسُهُمۡ فِيهَا حَرِيرٞ",
    "ayah_text_no_diacratic" : "جنٰت عدن يدخلونها يحلون فيها من اساور من ذهب ولؤلؤا ولباسهم فيها حرير",
    "ayahnumber" : "33",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3761",
    "page" : "438",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3762",
    "ayah_text" : "وَقَالُواْ ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِيٓ أَذۡهَبَ عَنَّا ٱلۡحَزَنَۖ إِنَّ رَبَّنَا لَغَفُورٞ شَكُورٌ",
    "ayah_text_no_diacratic" : "وقالوا الحمد لله الذي اذهب عنا الحزن ان ربنا لغفور شكور",
    "ayahnumber" : "34",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3762",
    "page" : "438",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3763",
    "ayah_text" : "ٱلَّذِيٓ أَحَلَّنَا دَارَ ٱلۡمُقَامَةِ مِن فَضۡلِهِۦ لَا يَمَسُّنَا فِيهَا نَصَبٞ وَلَا يَمَسُّنَا فِيهَا لُغُوبٞ",
    "ayah_text_no_diacratic" : "الذي احلنا دار المقامة من فضله لا يمسنا فيها نصب ولا يمسنا فيها لغوب",
    "ayahnumber" : "35",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3763",
    "page" : "438",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3764",
    "ayah_text" : "وَٱلَّذِينَ كَفَرُواْ لَهُمۡ نَارُ جَهَنَّمَ لَا يُقۡضَىٰ عَلَيۡهِمۡ فَيَمُوتُواْ وَلَا يُخَفَّفُ عَنۡهُم مِّنۡ عَذَابِهَاۚ كَذَٰلِكَ نَجۡزِي كُلَّ كَفُورٖ",
    "ayah_text_no_diacratic" : "والذين كفروا لهم نار جهنم لا يقضىٰ عليهم فيموتوا ولا يخفف عنهم من عذابها كذٰلك نجزي كل كفور",
    "ayahnumber" : "36",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3764",
    "page" : "438",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3765",
    "ayah_text" : "وَهُمۡ يَصۡطَرِخُونَ فِيهَا رَبَّنَآ أَخۡرِجۡنَا نَعۡمَلۡ صَٰلِحًا غَيۡرَ ٱلَّذِي كُنَّا نَعۡمَلُۚ أَوَلَمۡ نُعَمِّرۡكُم مَّا يَتَذَكَّرُ فِيهِ مَن تَذَكَّرَ وَجَآءَكُمُ ٱلنَّذِيرُۖ فَذُوقُواْ فَمَا لِلظَّٰلِمِينَ مِن نَّصِيرٍ",
    "ayah_text_no_diacratic" : "وهم يصطرخون فيها ربنا اخرجنا نعمل صٰلحا غير الذي كنا نعمل اولم نعمركم ما يتذكر فيه من تذكر وجاءكم النذير فذوقوا فما للظٰلمين من نصير",
    "ayahnumber" : "37",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3765",
    "page" : "438",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3766",
    "ayah_text" : "إِنَّ ٱللَّهَ عَٰلِمُ غَيۡبِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "ان الله عٰلم غيب السمٰوٰت والارض انه عليم بذات الصدور",
    "ayahnumber" : "38",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3766",
    "page" : "438",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3767",
    "ayah_text" : "هُوَ ٱلَّذِي جَعَلَكُمۡ خَلَٰٓئِفَ فِي ٱلۡأَرۡضِۚ فَمَن كَفَرَ فَعَلَيۡهِ كُفۡرُهُۥۖ وَلَا يَزِيدُ ٱلۡكَٰفِرِينَ كُفۡرُهُمۡ عِندَ رَبِّهِمۡ إِلَّا مَقۡتٗاۖ وَلَا يَزِيدُ ٱلۡكَٰفِرِينَ كُفۡرُهُمۡ إِلَّا خَسَارٗا",
    "ayah_text_no_diacratic" : "هو الذي جعلكم خلٰئف في الارض فمن كفر فعليه كفره ولا يزيد الكٰفرين كفرهم عند ربهم الا مقتا ولا يزيد الكٰفرين كفرهم الا خسارا",
    "ayahnumber" : "39",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3767",
    "page" : "439",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3768",
    "ayah_text" : "قُلۡ أَرَءَيۡتُمۡ شُرَكَآءَكُمُ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِ أَرُونِي مَاذَا خَلَقُواْ مِنَ ٱلۡأَرۡضِ أَمۡ لَهُمۡ شِرۡكٞ فِي ٱلسَّمَٰوَٰتِ أَمۡ ءَاتَيۡنَٰهُمۡ كِتَٰبٗا فَهُمۡ عَلَىٰ بَيِّنَتٖ مِّنۡهُۚ بَلۡ إِن يَعِدُ ٱلظَّٰلِمُونَ بَعۡضُهُم بَعۡضًا إِلَّا غُرُورًا",
    "ayah_text_no_diacratic" : "قل ارءيتم شركاءكم الذين تدعون من دون الله اروني ماذا خلقوا من الارض ام لهم شرك في السمٰوٰت ام ءاتينٰهم كتٰبا فهم علىٰ بينت منه بل ان يعد الظٰلمون بعضهم بعضا الا غرورا",
    "ayahnumber" : "40",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3768",
    "page" : "439",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3769",
    "ayah_text" : "۞إِنَّ ٱللَّهَ يُمۡسِكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ أَن تَزُولَاۚ وَلَئِن زَالَتَآ إِنۡ أَمۡسَكَهُمَا مِنۡ أَحَدٖ مِّنۢ بَعۡدِهِۦٓۚ إِنَّهُۥ كَانَ حَلِيمًا غَفُورٗا",
    "ayah_text_no_diacratic" : "ان الله يمسك السمٰوٰت والارض ان تزولا ولئن زالتا ان امسكهما من احد من بعده انه كان حليما غفورا",
    "ayahnumber" : "41",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3769",
    "page" : "439",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:377",
    "ayah_text" : "مَا كَانَ لِبَشَرٍ أَن يُؤۡتِيَهُ ٱللَّهُ ٱلۡكِتَٰبَ وَٱلۡحُكۡمَ وَٱلنُّبُوَّةَ ثُمَّ يَقُولَ لِلنَّاسِ كُونُواْ عِبَادٗا لِّي مِن دُونِ ٱللَّهِ وَلَٰكِن كُونُواْ رَبَّٰنِيِّـۧنَ بِمَا كُنتُمۡ تُعَلِّمُونَ ٱلۡكِتَٰبَ وَبِمَا كُنتُمۡ تَدۡرُسُونَ",
    "ayah_text_no_diacratic" : "ما كان لبشر ان يؤتيه الله الكتٰب والحكم والنبوة ثم يقول للناس كونوا عبادا لي من دون الله ولٰكن كونوا ربٰنين بما كنتم تعلمون الكتٰب وبما كنتم تدرسون",
    "ayahnumber" : "79",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "377",
    "page" : "60",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3770",
    "ayah_text" : "وَأَقۡسَمُواْ بِٱللَّهِ جَهۡدَ أَيۡمَٰنِهِمۡ لَئِن جَآءَهُمۡ نَذِيرٞ لَّيَكُونُنَّ أَهۡدَىٰ مِنۡ إِحۡدَى ٱلۡأُمَمِۖ فَلَمَّا جَآءَهُمۡ نَذِيرٞ مَّا زَادَهُمۡ إِلَّا نُفُورًا",
    "ayah_text_no_diacratic" : "واقسموا بالله جهد ايمٰنهم لئن جاءهم نذير ليكونن اهدىٰ من احدى الامم فلما جاءهم نذير ما زادهم الا نفورا",
    "ayahnumber" : "42",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3770",
    "page" : "439",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3771",
    "ayah_text" : "ٱسۡتِكۡبَارٗا فِي ٱلۡأَرۡضِ وَمَكۡرَ ٱلسَّيِّيِٕۚ وَلَا يَحِيقُ ٱلۡمَكۡرُ ٱلسَّيِّئُ إِلَّا بِأَهۡلِهِۦۚ فَهَلۡ يَنظُرُونَ إِلَّا سُنَّتَ ٱلۡأَوَّلِينَۚ فَلَن تَجِدَ لِسُنَّتِ ٱللَّهِ تَبۡدِيلٗاۖ وَلَن تَجِدَ لِسُنَّتِ ٱللَّهِ تَحۡوِيلًا",
    "ayah_text_no_diacratic" : "استكبارا في الارض ومكر السيي ولا يحيق المكر السيئ الا باهله فهل ينظرون الا سنت الاولين فلن تجد لسنت الله تبديلا ولن تجد لسنت الله تحويلا",
    "ayahnumber" : "43",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3771",
    "page" : "439",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3772",
    "ayah_text" : "أَوَلَمۡ يَسِيرُواْ فِي ٱلۡأَرۡضِ فَيَنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبۡلِهِمۡ وَكَانُوٓاْ أَشَدَّ مِنۡهُمۡ قُوَّةٗۚ وَمَا كَانَ ٱللَّهُ لِيُعۡجِزَهُۥ مِن شَيۡءٖ فِي ٱلسَّمَٰوَٰتِ وَلَا فِي ٱلۡأَرۡضِۚ إِنَّهُۥ كَانَ عَلِيمٗا قَدِيرٗا",
    "ayah_text_no_diacratic" : "اولم يسيروا في الارض فينظروا كيف كان عٰقبة الذين من قبلهم وكانوا اشد منهم قوة وما كان الله ليعجزه من شيء في السمٰوٰت ولا في الارض انه كان عليما قديرا",
    "ayahnumber" : "44",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3772",
    "page" : "439",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3773",
    "ayah_text" : "وَلَوۡ يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ بِمَا كَسَبُواْ مَا تَرَكَ عَلَىٰ ظَهۡرِهَا مِن دَآبَّةٖ وَلَٰكِن يُؤَخِّرُهُمۡ إِلَىٰٓ أَجَلٖ مُّسَمّٗىۖ فَإِذَا جَآءَ أَجَلُهُمۡ فَإِنَّ ٱللَّهَ كَانَ بِعِبَادِهِۦ بَصِيرَۢا",
    "ayah_text_no_diacratic" : "ولو يؤاخذ الله الناس بما كسبوا ما ترك علىٰ ظهرها من دابة ولٰكن يؤخرهم الىٰ اجل مسمى فاذا جاء اجلهم فان الله كان بعباده بصيرا",
