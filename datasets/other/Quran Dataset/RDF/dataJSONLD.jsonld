  }, {
    "@id" : "quran:3785",
    "ayah_text" : "وَسَوَآءٌ عَلَيۡهِمۡ ءَأَنذَرۡتَهُمۡ أَمۡ لَمۡ تُنذِرۡهُمۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "وسواء عليهم ءانذرتهم ام لم تنذرهم لا يؤمنون",
    "ayahnumber" : "10",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3785",
    "page" : "440",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3786",
    "ayah_text" : "إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكۡرَ وَخَشِيَ ٱلرَّحۡمَٰنَ بِٱلۡغَيۡبِۖ فَبَشِّرۡهُ بِمَغۡفِرَةٖ وَأَجۡرٖ كَرِيمٍ",
    "ayah_text_no_diacratic" : "انما تنذر من اتبع الذكر وخشي الرحمٰن بالغيب فبشره بمغفرة واجر كريم",
    "ayahnumber" : "11",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3786",
    "page" : "440",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3787",
    "ayah_text" : "إِنَّا نَحۡنُ نُحۡيِ ٱلۡمَوۡتَىٰ وَنَكۡتُبُ مَا قَدَّمُواْ وَءَاثَٰرَهُمۡۚ وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ فِيٓ إِمَامٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "انا نحن نحي الموتىٰ ونكتب ما قدموا وءاثٰرهم وكل شيء احصينٰه في امام مبين",
    "ayahnumber" : "12",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3787",
    "page" : "440",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3788",
    "ayah_text" : "وَٱضۡرِبۡ لَهُم مَّثَلًا أَصۡحَٰبَ ٱلۡقَرۡيَةِ إِذۡ جَآءَهَا ٱلۡمُرۡسَلُونَ",
    "ayah_text_no_diacratic" : "واضرب لهم مثلا اصحٰب القرية اذ جاءها المرسلون",
    "ayahnumber" : "13",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3788",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3789",
    "ayah_text" : "إِذۡ أَرۡسَلۡنَآ إِلَيۡهِمُ ٱثۡنَيۡنِ فَكَذَّبُوهُمَا فَعَزَّزۡنَا بِثَالِثٖ فَقَالُوٓاْ إِنَّآ إِلَيۡكُم مُّرۡسَلُونَ",
    "ayah_text_no_diacratic" : "اذ ارسلنا اليهم اثنين فكذبوهما فعززنا بثالث فقالوا انا اليكم مرسلون",
    "ayahnumber" : "14",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3789",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:379",
    "ayah_text" : "وَإِذۡ أَخَذَ ٱللَّهُ مِيثَٰقَ ٱلنَّبِيِّـۧنَ لَمَآ ءَاتَيۡتُكُم مِّن كِتَٰبٖ وَحِكۡمَةٖ ثُمَّ جَآءَكُمۡ رَسُولٞ مُّصَدِّقٞ لِّمَا مَعَكُمۡ لَتُؤۡمِنُنَّ بِهِۦ وَلَتَنصُرُنَّهُۥۚ قَالَ ءَأَقۡرَرۡتُمۡ وَأَخَذۡتُمۡ عَلَىٰ ذَٰلِكُمۡ إِصۡرِيۖ قَالُوٓاْ أَقۡرَرۡنَاۚ قَالَ فَٱشۡهَدُواْ وَأَنَا۠ مَعَكُم مِّنَ ٱلشَّٰهِدِينَ",
    "ayah_text_no_diacratic" : "واذ اخذ الله ميثٰق النبين لما ءاتيتكم من كتٰب وحكمة ثم جاءكم رسول مصدق لما معكم لتؤمنن به ولتنصرنه قال ءاقررتم واخذتم علىٰ ذٰلكم اصري قالوا اقررنا قال فاشهدوا وانا معكم من الشٰهدين",
    "ayahnumber" : "81",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "379",
    "page" : "60",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3790",
    "ayah_text" : "قَالُواْ مَآ أَنتُمۡ إِلَّا بَشَرٞ مِّثۡلُنَا وَمَآ أَنزَلَ ٱلرَّحۡمَٰنُ مِن شَيۡءٍ إِنۡ أَنتُمۡ إِلَّا تَكۡذِبُونَ",
    "ayah_text_no_diacratic" : "قالوا ما انتم الا بشر مثلنا وما انزل الرحمٰن من شيء ان انتم الا تكذبون",
    "ayahnumber" : "15",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3790",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3791",
    "ayah_text" : "قَالُواْ رَبُّنَا يَعۡلَمُ إِنَّآ إِلَيۡكُمۡ لَمُرۡسَلُونَ",
    "ayah_text_no_diacratic" : "قالوا ربنا يعلم انا اليكم لمرسلون",
    "ayahnumber" : "16",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3791",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3792",
    "ayah_text" : "وَمَا عَلَيۡنَآ إِلَّا ٱلۡبَلَٰغُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "وما علينا الا البلٰغ المبين",
    "ayahnumber" : "17",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3792",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3793",
    "ayah_text" : "قَالُوٓاْ إِنَّا تَطَيَّرۡنَا بِكُمۡۖ لَئِن لَّمۡ تَنتَهُواْ لَنَرۡجُمَنَّكُمۡ وَلَيَمَسَّنَّكُم مِّنَّا عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "قالوا انا تطيرنا بكم لئن لم تنتهوا لنرجمنكم وليمسنكم منا عذاب اليم",
    "ayahnumber" : "18",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3793",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3794",
    "ayah_text" : "قَالُواْ طَٰٓئِرُكُم مَّعَكُمۡ أَئِن ذُكِّرۡتُمۚ بَلۡ أَنتُمۡ قَوۡمٞ مُّسۡرِفُونَ",
    "ayah_text_no_diacratic" : "قالوا طٰئركم معكم ائن ذكرتم بل انتم قوم مسرفون",
    "ayahnumber" : "19",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3794",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3795",
    "ayah_text" : "وَجَآءَ مِنۡ أَقۡصَا ٱلۡمَدِينَةِ رَجُلٞ يَسۡعَىٰ قَالَ يَٰقَوۡمِ ٱتَّبِعُواْ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "وجاء من اقصا المدينة رجل يسعىٰ قال يٰقوم اتبعوا المرسلين",
    "ayahnumber" : "20",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3795",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3796",
    "ayah_text" : "ٱتَّبِعُواْ مَن لَّا يَسۡـَٔلُكُمۡ أَجۡرٗا وَهُم مُّهۡتَدُونَ",
    "ayah_text_no_diacratic" : "اتبعوا من لا يسلكم اجرا وهم مهتدون",
    "ayahnumber" : "21",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3796",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3797",
    "ayah_text" : "وَمَالِيَ لَآ أَعۡبُدُ ٱلَّذِي فَطَرَنِي وَإِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "ومالي لا اعبد الذي فطرني واليه ترجعون",
    "ayahnumber" : "22",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3797",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3798",
    "ayah_text" : "ءَأَتَّخِذُ مِن دُونِهِۦٓ ءَالِهَةً إِن يُرِدۡنِ ٱلرَّحۡمَٰنُ بِضُرّٖ لَّا تُغۡنِ عَنِّي شَفَٰعَتُهُمۡ شَيۡـٔٗا وَلَا يُنقِذُونِ",
    "ayah_text_no_diacratic" : "ءاتخذ من دونه ءالهة ان يردن الرحمٰن بضر لا تغن عني شفٰعتهم شيا ولا ينقذون",
    "ayahnumber" : "23",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3798",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3799",
    "ayah_text" : "إِنِّيٓ إِذٗا لَّفِي ضَلَٰلٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "اني اذا لفي ضلٰل مبين",
    "ayahnumber" : "24",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3799",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:38",
    "ayah_text" : "كَيۡفَ تَكۡفُرُونَ بِٱللَّهِ وَكُنتُمۡ أَمۡوَٰتٗا فَأَحۡيَٰكُمۡۖ ثُمَّ يُمِيتُكُمۡ ثُمَّ يُحۡيِيكُمۡ ثُمَّ إِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "كيف تكفرون بالله وكنتم اموٰتا فاحيٰكم ثم يميتكم ثم يحييكم ثم اليه ترجعون",
    "ayahnumber" : "28",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "38",
    "page" : "5",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:380",
    "ayah_text" : "فَمَن تَوَلَّىٰ بَعۡدَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "فمن تولىٰ بعد ذٰلك فاولٰئك هم الفٰسقون",
    "ayahnumber" : "82",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "380",
    "page" : "60",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3800",
    "ayah_text" : "إِنِّيٓ ءَامَنتُ بِرَبِّكُمۡ فَٱسۡمَعُونِ",
    "ayah_text_no_diacratic" : "اني ءامنت بربكم فاسمعون",
    "ayahnumber" : "25",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3800",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3801",
    "ayah_text" : "قِيلَ ٱدۡخُلِ ٱلۡجَنَّةَۖ قَالَ يَٰلَيۡتَ قَوۡمِي يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قيل ادخل الجنة قال يٰليت قومي يعلمون",
    "ayahnumber" : "26",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3801",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3802",
    "ayah_text" : "بِمَا غَفَرَ لِي رَبِّي وَجَعَلَنِي مِنَ ٱلۡمُكۡرَمِينَ",
    "ayah_text_no_diacratic" : "بما غفر لي ربي وجعلني من المكرمين",
    "ayahnumber" : "27",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3802",
    "page" : "441",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3803",
    "ayah_text" : "۞وَمَآ أَنزَلۡنَا عَلَىٰ قَوۡمِهِۦ مِنۢ بَعۡدِهِۦ مِن جُندٖ مِّنَ ٱلسَّمَآءِ وَمَا كُنَّا مُنزِلِينَ",
    "ayah_text_no_diacratic" : "وما انزلنا علىٰ قومه من بعده من جند من السماء وما كنا منزلين",
    "ayahnumber" : "28",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3803",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3804",
    "ayah_text" : "إِن كَانَتۡ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ فَإِذَا هُمۡ خَٰمِدُونَ",
    "ayah_text_no_diacratic" : "ان كانت الا صيحة وٰحدة فاذا هم خٰمدون",
    "ayahnumber" : "29",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3804",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3805",
    "ayah_text" : "يَٰحَسۡرَةً عَلَى ٱلۡعِبَادِۚ مَا يَأۡتِيهِم مِّن رَّسُولٍ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "يٰحسرة على العباد ما ياتيهم من رسول الا كانوا به يستهزءون",
    "ayahnumber" : "30",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3805",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3806",
    "ayah_text" : "أَلَمۡ يَرَوۡاْ كَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّنَ ٱلۡقُرُونِ أَنَّهُمۡ إِلَيۡهِمۡ لَا يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "الم يروا كم اهلكنا قبلهم من القرون انهم اليهم لا يرجعون",
    "ayahnumber" : "31",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3806",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3807",
    "ayah_text" : "وَإِن كُلّٞ لَّمَّا جَمِيعٞ لَّدَيۡنَا مُحۡضَرُونَ",
    "ayah_text_no_diacratic" : "وان كل لما جميع لدينا محضرون",
    "ayahnumber" : "32",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3807",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3808",
    "ayah_text" : "وَءَايَةٞ لَّهُمُ ٱلۡأَرۡضُ ٱلۡمَيۡتَةُ أَحۡيَيۡنَٰهَا وَأَخۡرَجۡنَا مِنۡهَا حَبّٗا فَمِنۡهُ يَأۡكُلُونَ",
    "ayah_text_no_diacratic" : "وءاية لهم الارض الميتة احيينٰها واخرجنا منها حبا فمنه ياكلون",
    "ayahnumber" : "33",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3808",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3809",
    "ayah_text" : "وَجَعَلۡنَا فِيهَا جَنَّٰتٖ مِّن نَّخِيلٖ وَأَعۡنَٰبٖ وَفَجَّرۡنَا فِيهَا مِنَ ٱلۡعُيُونِ",
    "ayah_text_no_diacratic" : "وجعلنا فيها جنٰت من نخيل واعنٰب وفجرنا فيها من العيون",
    "ayahnumber" : "34",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3809",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:381",
    "ayah_text" : "أَفَغَيۡرَ دِينِ ٱللَّهِ يَبۡغُونَ وَلَهُۥٓ أَسۡلَمَ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ طَوۡعٗا وَكَرۡهٗا وَإِلَيۡهِ يُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "افغير دين الله يبغون وله اسلم من في السمٰوٰت والارض طوعا وكرها واليه يرجعون",
    "ayahnumber" : "83",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "381",
    "page" : "60",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3810",
    "ayah_text" : "لِيَأۡكُلُواْ مِن ثَمَرِهِۦ وَمَا عَمِلَتۡهُ أَيۡدِيهِمۡۚ أَفَلَا يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "لياكلوا من ثمره وما عملته ايديهم افلا يشكرون",
    "ayahnumber" : "35",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3810",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3811",
    "ayah_text" : "سُبۡحَٰنَ ٱلَّذِي خَلَقَ ٱلۡأَزۡوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ ٱلۡأَرۡضُ وَمِنۡ أَنفُسِهِمۡ وَمِمَّا لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "سبحٰن الذي خلق الازوٰج كلها مما تنبت الارض ومن انفسهم ومما لا يعلمون",
    "ayahnumber" : "36",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3811",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3812",
    "ayah_text" : "وَءَايَةٞ لَّهُمُ ٱلَّيۡلُ نَسۡلَخُ مِنۡهُ ٱلنَّهَارَ فَإِذَا هُم مُّظۡلِمُونَ",
    "ayah_text_no_diacratic" : "وءاية لهم اليل نسلخ منه النهار فاذا هم مظلمون",
    "ayahnumber" : "37",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3812",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3813",
    "ayah_text" : "وَٱلشَّمۡسُ تَجۡرِي لِمُسۡتَقَرّٖ لَّهَاۚ ذَٰلِكَ تَقۡدِيرُ ٱلۡعَزِيزِ ٱلۡعَلِيمِ",
    "ayah_text_no_diacratic" : "والشمس تجري لمستقر لها ذٰلك تقدير العزيز العليم",
    "ayahnumber" : "38",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3813",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3814",
    "ayah_text" : "وَٱلۡقَمَرَ قَدَّرۡنَٰهُ مَنَازِلَ حَتَّىٰ عَادَ كَٱلۡعُرۡجُونِ ٱلۡقَدِيمِ",
    "ayah_text_no_diacratic" : "والقمر قدرنٰه منازل حتىٰ عاد كالعرجون القديم",
    "ayahnumber" : "39",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3814",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3815",
    "ayah_text" : "لَا ٱلشَّمۡسُ يَنۢبَغِي لَهَآ أَن تُدۡرِكَ ٱلۡقَمَرَ وَلَا ٱلَّيۡلُ سَابِقُ ٱلنَّهَارِۚ وَكُلّٞ فِي فَلَكٖ يَسۡبَحُونَ",
    "ayah_text_no_diacratic" : "لا الشمس ينبغي لها ان تدرك القمر ولا اليل سابق النهار وكل في فلك يسبحون",
    "ayahnumber" : "40",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3815",
    "page" : "442",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3816",
    "ayah_text" : "وَءَايَةٞ لَّهُمۡ أَنَّا حَمَلۡنَا ذُرِّيَّتَهُمۡ فِي ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ",
    "ayah_text_no_diacratic" : "وءاية لهم انا حملنا ذريتهم في الفلك المشحون",
    "ayahnumber" : "41",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3816",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3817",
    "ayah_text" : "وَخَلَقۡنَا لَهُم مِّن مِّثۡلِهِۦ مَا يَرۡكَبُونَ",
    "ayah_text_no_diacratic" : "وخلقنا لهم من مثله ما يركبون",
    "ayahnumber" : "42",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3817",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3818",
    "ayah_text" : "وَإِن نَّشَأۡ نُغۡرِقۡهُمۡ فَلَا صَرِيخَ لَهُمۡ وَلَا هُمۡ يُنقَذُونَ",
    "ayah_text_no_diacratic" : "وان نشا نغرقهم فلا صريخ لهم ولا هم ينقذون",
    "ayahnumber" : "43",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3818",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3819",
    "ayah_text" : "إِلَّا رَحۡمَةٗ مِّنَّا وَمَتَٰعًا إِلَىٰ حِينٖ",
    "ayah_text_no_diacratic" : "الا رحمة منا ومتٰعا الىٰ حين",
    "ayahnumber" : "44",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3819",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:382",
    "ayah_text" : "قُلۡ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ عَلَيۡنَا وَمَآ أُنزِلَ عَلَىٰٓ إِبۡرَٰهِيمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ وَيَعۡقُوبَ وَٱلۡأَسۡبَاطِ وَمَآ أُوتِيَ مُوسَىٰ وَعِيسَىٰ وَٱلنَّبِيُّونَ مِن رَّبِّهِمۡ لَا نُفَرِّقُ بَيۡنَ أَحَدٖ مِّنۡهُمۡ وَنَحۡنُ لَهُۥ مُسۡلِمُونَ",
    "ayah_text_no_diacratic" : "قل ءامنا بالله وما انزل علينا وما انزل علىٰ ابرٰهيم واسمٰعيل واسحٰق ويعقوب والاسباط وما اوتي موسىٰ وعيسىٰ والنبيون من ربهم لا نفرق بين احد منهم ونحن له مسلمون",
    "ayahnumber" : "84",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "382",
    "page" : "61",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3820",
    "ayah_text" : "وَإِذَا قِيلَ لَهُمُ ٱتَّقُواْ مَا بَيۡنَ أَيۡدِيكُمۡ وَمَا خَلۡفَكُمۡ لَعَلَّكُمۡ تُرۡحَمُونَ",
    "ayah_text_no_diacratic" : "واذا قيل لهم اتقوا ما بين ايديكم وما خلفكم لعلكم ترحمون",
    "ayahnumber" : "45",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3820",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3821",
    "ayah_text" : "وَمَا تَأۡتِيهِم مِّنۡ ءَايَةٖ مِّنۡ ءَايَٰتِ رَبِّهِمۡ إِلَّا كَانُواْ عَنۡهَا مُعۡرِضِينَ",
    "ayah_text_no_diacratic" : "وما تاتيهم من ءاية من ءايٰت ربهم الا كانوا عنها معرضين",
    "ayahnumber" : "46",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3821",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3822",
    "ayah_text" : "وَإِذَا قِيلَ لَهُمۡ أَنفِقُواْ مِمَّا رَزَقَكُمُ ٱللَّهُ قَالَ ٱلَّذِينَ كَفَرُواْ لِلَّذِينَ ءَامَنُوٓاْ أَنُطۡعِمُ مَن لَّوۡ يَشَآءُ ٱللَّهُ أَطۡعَمَهُۥٓ إِنۡ أَنتُمۡ إِلَّا فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "واذا قيل لهم انفقوا مما رزقكم الله قال الذين كفروا للذين ءامنوا انطعم من لو يشاء الله اطعمه ان انتم الا في ضلٰل مبين",
    "ayahnumber" : "47",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3822",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3823",
    "ayah_text" : "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ويقولون متىٰ هٰذا الوعد ان كنتم صٰدقين",
    "ayahnumber" : "48",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3823",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3824",
    "ayah_text" : "مَا يَنظُرُونَ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ تَأۡخُذُهُمۡ وَهُمۡ يَخِصِّمُونَ",
    "ayah_text_no_diacratic" : "ما ينظرون الا صيحة وٰحدة تاخذهم وهم يخصمون",
    "ayahnumber" : "49",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3824",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3825",
    "ayah_text" : "فَلَا يَسۡتَطِيعُونَ تَوۡصِيَةٗ وَلَآ إِلَىٰٓ أَهۡلِهِمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "فلا يستطيعون توصية ولا الىٰ اهلهم يرجعون",
    "ayahnumber" : "50",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3825",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3826",
    "ayah_text" : "وَنُفِخَ فِي ٱلصُّورِ فَإِذَا هُم مِّنَ ٱلۡأَجۡدَاثِ إِلَىٰ رَبِّهِمۡ يَنسِلُونَ",
    "ayah_text_no_diacratic" : "ونفخ في الصور فاذا هم من الاجداث الىٰ ربهم ينسلون",
    "ayahnumber" : "51",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3826",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3827",
    "ayah_text" : "قَالُواْ يَٰوَيۡلَنَا مَنۢ بَعَثَنَا مِن مَّرۡقَدِنَاۜۗ هَٰذَا مَا وَعَدَ ٱلرَّحۡمَٰنُ وَصَدَقَ ٱلۡمُرۡسَلُونَ",
    "ayah_text_no_diacratic" : "قالوا يٰويلنا من بعثنا من مرقدنا هٰذا ما وعد الرحمٰن وصدق المرسلون",
    "ayahnumber" : "52",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3827",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3828",
    "ayah_text" : "إِن كَانَتۡ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ فَإِذَا هُمۡ جَمِيعٞ لَّدَيۡنَا مُحۡضَرُونَ",
    "ayah_text_no_diacratic" : "ان كانت الا صيحة وٰحدة فاذا هم جميع لدينا محضرون",
    "ayahnumber" : "53",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3828",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3829",
    "ayah_text" : "فَٱلۡيَوۡمَ لَا تُظۡلَمُ نَفۡسٞ شَيۡـٔٗا وَلَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "فاليوم لا تظلم نفس شيا ولا تجزون الا ما كنتم تعملون",
    "ayahnumber" : "54",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3829",
    "page" : "443",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:383",
    "ayah_text" : "وَمَن يَبۡتَغِ غَيۡرَ ٱلۡإِسۡلَٰمِ دِينٗا فَلَن يُقۡبَلَ مِنۡهُ وَهُوَ فِي ٱلۡأٓخِرَةِ مِنَ ٱلۡخَٰسِرِينَ",
    "ayah_text_no_diacratic" : "ومن يبتغ غير الاسلٰم دينا فلن يقبل منه وهو في الاخرة من الخٰسرين",
    "ayahnumber" : "85",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "383",
    "page" : "61",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3830",
    "ayah_text" : "إِنَّ أَصۡحَٰبَ ٱلۡجَنَّةِ ٱلۡيَوۡمَ فِي شُغُلٖ فَٰكِهُونَ",
    "ayah_text_no_diacratic" : "ان اصحٰب الجنة اليوم في شغل فٰكهون",
    "ayahnumber" : "55",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3830",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3831",
    "ayah_text" : "هُمۡ وَأَزۡوَٰجُهُمۡ فِي ظِلَٰلٍ عَلَى ٱلۡأَرَآئِكِ مُتَّكِـُٔونَ",
    "ayah_text_no_diacratic" : "هم وازوٰجهم في ظلٰل على الارائك متكون",
    "ayahnumber" : "56",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3831",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3832",
    "ayah_text" : "لَهُمۡ فِيهَا فَٰكِهَةٞ وَلَهُم مَّا يَدَّعُونَ",
    "ayah_text_no_diacratic" : "لهم فيها فٰكهة ولهم ما يدعون",
    "ayahnumber" : "57",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3832",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3833",
    "ayah_text" : "سَلَٰمٞ قَوۡلٗا مِّن رَّبّٖ رَّحِيمٖ",
    "ayah_text_no_diacratic" : "سلٰم قولا من رب رحيم",
    "ayahnumber" : "58",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3833",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3834",
    "ayah_text" : "وَٱمۡتَٰزُواْ ٱلۡيَوۡمَ أَيُّهَا ٱلۡمُجۡرِمُونَ",
    "ayah_text_no_diacratic" : "وامتٰزوا اليوم ايها المجرمون",
    "ayahnumber" : "59",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3834",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3835",
    "ayah_text" : "۞أَلَمۡ أَعۡهَدۡ إِلَيۡكُمۡ يَٰبَنِيٓ ءَادَمَ أَن لَّا تَعۡبُدُواْ ٱلشَّيۡطَٰنَۖ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "الم اعهد اليكم يٰبني ءادم ان لا تعبدوا الشيطٰن انه لكم عدو مبين",
    "ayahnumber" : "60",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3835",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3836",
    "ayah_text" : "وَأَنِ ٱعۡبُدُونِيۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ",
    "ayah_text_no_diacratic" : "وان اعبدوني هٰذا صرٰط مستقيم",
    "ayahnumber" : "61",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3836",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3837",
    "ayah_text" : "وَلَقَدۡ أَضَلَّ مِنكُمۡ جِبِلّٗا كَثِيرًاۖ أَفَلَمۡ تَكُونُواْ تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ولقد اضل منكم جبلا كثيرا افلم تكونوا تعقلون",
    "ayahnumber" : "62",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3837",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3838",
    "ayah_text" : "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي كُنتُمۡ تُوعَدُونَ",
    "ayah_text_no_diacratic" : "هٰذه جهنم التي كنتم توعدون",
    "ayahnumber" : "63",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3838",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3839",
    "ayah_text" : "ٱصۡلَوۡهَا ٱلۡيَوۡمَ بِمَا كُنتُمۡ تَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "اصلوها اليوم بما كنتم تكفرون",
    "ayahnumber" : "64",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3839",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:384",
    "ayah_text" : "كَيۡفَ يَهۡدِي ٱللَّهُ قَوۡمٗا كَفَرُواْ بَعۡدَ إِيمَٰنِهِمۡ وَشَهِدُوٓاْ أَنَّ ٱلرَّسُولَ حَقّٞ وَجَآءَهُمُ ٱلۡبَيِّنَٰتُۚ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "كيف يهدي الله قوما كفروا بعد ايمٰنهم وشهدوا ان الرسول حق وجاءهم البينٰت والله لا يهدي القوم الظٰلمين",
    "ayahnumber" : "86",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "384",
    "page" : "61",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3840",
    "ayah_text" : "ٱلۡيَوۡمَ نَخۡتِمُ عَلَىٰٓ أَفۡوَٰهِهِمۡ وَتُكَلِّمُنَآ أَيۡدِيهِمۡ وَتَشۡهَدُ أَرۡجُلُهُم بِمَا كَانُواْ يَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "اليوم نختم علىٰ افوٰههم وتكلمنا ايديهم وتشهد ارجلهم بما كانوا يكسبون",
    "ayahnumber" : "65",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3840",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3841",
    "ayah_text" : "وَلَوۡ نَشَآءُ لَطَمَسۡنَا عَلَىٰٓ أَعۡيُنِهِمۡ فَٱسۡتَبَقُواْ ٱلصِّرَٰطَ فَأَنَّىٰ يُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "ولو نشاء لطمسنا علىٰ اعينهم فاستبقوا الصرٰط فانىٰ يبصرون",
    "ayahnumber" : "66",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3841",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3842",
    "ayah_text" : "وَلَوۡ نَشَآءُ لَمَسَخۡنَٰهُمۡ عَلَىٰ مَكَانَتِهِمۡ فَمَا ٱسۡتَطَٰعُواْ مُضِيّٗا وَلَا يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "ولو نشاء لمسخنٰهم علىٰ مكانتهم فما استطٰعوا مضيا ولا يرجعون",
    "ayahnumber" : "67",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3842",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3843",
    "ayah_text" : "وَمَن نُّعَمِّرۡهُ نُنَكِّسۡهُ فِي ٱلۡخَلۡقِۚ أَفَلَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ومن نعمره ننكسه في الخلق افلا يعقلون",
    "ayahnumber" : "68",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3843",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3844",
    "ayah_text" : "وَمَا عَلَّمۡنَٰهُ ٱلشِّعۡرَ وَمَا يَنۢبَغِي لَهُۥٓۚ إِنۡ هُوَ إِلَّا ذِكۡرٞ وَقُرۡءَانٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "وما علمنٰه الشعر وما ينبغي له ان هو الا ذكر وقرءان مبين",
    "ayahnumber" : "69",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3844",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3845",
    "ayah_text" : "لِّيُنذِرَ مَن كَانَ حَيّٗا وَيَحِقَّ ٱلۡقَوۡلُ عَلَى ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "لينذر من كان حيا ويحق القول على الكٰفرين",
    "ayahnumber" : "70",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3845",
    "page" : "444",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3846",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ أَنَّا خَلَقۡنَا لَهُم مِّمَّا عَمِلَتۡ أَيۡدِينَآ أَنۡعَٰمٗا فَهُمۡ لَهَا مَٰلِكُونَ",
    "ayah_text_no_diacratic" : "اولم يروا انا خلقنا لهم مما عملت ايدينا انعٰما فهم لها مٰلكون",
    "ayahnumber" : "71",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3846",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3847",
    "ayah_text" : "وَذَلَّلۡنَٰهَا لَهُمۡ فَمِنۡهَا رَكُوبُهُمۡ وَمِنۡهَا يَأۡكُلُونَ",
    "ayah_text_no_diacratic" : "وذللنٰها لهم فمنها ركوبهم ومنها ياكلون",
    "ayahnumber" : "72",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3847",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3848",
    "ayah_text" : "وَلَهُمۡ فِيهَا مَنَٰفِعُ وَمَشَارِبُۚ أَفَلَا يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "ولهم فيها منٰفع ومشارب افلا يشكرون",
    "ayahnumber" : "73",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3848",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3849",
    "ayah_text" : "وَٱتَّخَذُواْ مِن دُونِ ٱللَّهِ ءَالِهَةٗ لَّعَلَّهُمۡ يُنصَرُونَ",
    "ayah_text_no_diacratic" : "واتخذوا من دون الله ءالهة لعلهم ينصرون",
    "ayahnumber" : "74",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3849",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:385",
    "ayah_text" : "أُوْلَٰٓئِكَ جَزَآؤُهُمۡ أَنَّ عَلَيۡهِمۡ لَعۡنَةَ ٱللَّهِ وَٱلۡمَلَٰٓئِكَةِ وَٱلنَّاسِ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "اولٰئك جزاؤهم ان عليهم لعنة الله والملٰئكة والناس اجمعين",
    "ayahnumber" : "87",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "385",
    "page" : "61",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3850",
    "ayah_text" : "لَا يَسۡتَطِيعُونَ نَصۡرَهُمۡ وَهُمۡ لَهُمۡ جُندٞ مُّحۡضَرُونَ",
    "ayah_text_no_diacratic" : "لا يستطيعون نصرهم وهم لهم جند محضرون",
    "ayahnumber" : "75",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3850",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3851",
    "ayah_text" : "فَلَا يَحۡزُنكَ قَوۡلُهُمۡۘ إِنَّا نَعۡلَمُ مَا يُسِرُّونَ وَمَا يُعۡلِنُونَ",
    "ayah_text_no_diacratic" : "فلا يحزنك قولهم انا نعلم ما يسرون وما يعلنون",
    "ayahnumber" : "76",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3851",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3852",
    "ayah_text" : "أَوَلَمۡ يَرَ ٱلۡإِنسَٰنُ أَنَّا خَلَقۡنَٰهُ مِن نُّطۡفَةٖ فَإِذَا هُوَ خَصِيمٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "اولم ير الانسٰن انا خلقنٰه من نطفة فاذا هو خصيم مبين",
    "ayahnumber" : "77",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3852",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3853",
    "ayah_text" : "وَضَرَبَ لَنَا مَثَلٗا وَنَسِيَ خَلۡقَهُۥۖ قَالَ مَن يُحۡيِ ٱلۡعِظَٰمَ وَهِيَ رَمِيمٞ",
    "ayah_text_no_diacratic" : "وضرب لنا مثلا ونسي خلقه قال من يحي العظٰم وهي رميم",
    "ayahnumber" : "78",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3853",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3854",
    "ayah_text" : "قُلۡ يُحۡيِيهَا ٱلَّذِيٓ أَنشَأَهَآ أَوَّلَ مَرَّةٖۖ وَهُوَ بِكُلِّ خَلۡقٍ عَلِيمٌ",
    "ayah_text_no_diacratic" : "قل يحييها الذي انشاها اول مرة وهو بكل خلق عليم",
    "ayahnumber" : "79",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3854",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3855",
    "ayah_text" : "ٱلَّذِي جَعَلَ لَكُم مِّنَ ٱلشَّجَرِ ٱلۡأَخۡضَرِ نَارٗا فَإِذَآ أَنتُم مِّنۡهُ تُوقِدُونَ",
    "ayah_text_no_diacratic" : "الذي جعل لكم من الشجر الاخضر نارا فاذا انتم منه توقدون",
    "ayahnumber" : "80",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3855",
    "page" : "445",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3856",
    "ayah_text" : "أَوَلَيۡسَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِقَٰدِرٍ عَلَىٰٓ أَن يَخۡلُقَ مِثۡلَهُمۚ بَلَىٰ وَهُوَ ٱلۡخَلَّٰقُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "اوليس الذي خلق السمٰوٰت والارض بقٰدر علىٰ ان يخلق مثلهم بلىٰ وهو الخلٰق العليم",
    "ayahnumber" : "81",
