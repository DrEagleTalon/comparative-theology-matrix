    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4569",
    "ayah_text" : "يَسۡمَعُ ءَايَٰتِ ٱللَّهِ تُتۡلَىٰ عَلَيۡهِ ثُمَّ يُصِرُّ مُسۡتَكۡبِرٗا كَأَن لَّمۡ يَسۡمَعۡهَاۖ فَبَشِّرۡهُ بِعَذَابٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "يسمع ءايٰت الله تتلىٰ عليه ثم يصر مستكبرا كان لم يسمعها فبشره بعذاب اليم",
    "ayahnumber" : "8",
    "chapter" : "25",
    "hizb" : "49",
