    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3639",
    "ayah_text" : "وَسَبِّحُوهُ بُكۡرَةٗ وَأَصِيلًا",
    "ayah_text_no_diacratic" : "وسبحوه بكرة واصيلا",
    "ayahnumber" : "42",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3639",
    "page" : "423",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:364",
    "ayah_text" : "هَٰٓأَنتُمۡ هَٰٓؤُلَآءِ حَٰجَجۡتُمۡ فِيمَا لَكُم بِهِۦ عِلۡمٞ فَلِمَ تُحَآجُّونَ فِيمَا لَيۡسَ لَكُم بِهِۦ عِلۡمٞۚ وَٱللَّهُ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "هٰانتم هٰؤلاء حٰججتم فيما لكم به علم فلم تحاجون فيما ليس لكم به علم والله يعلم وانتم لا تعلمون",
    "ayahnumber" : "66",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "364",
    "page" : "58",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
