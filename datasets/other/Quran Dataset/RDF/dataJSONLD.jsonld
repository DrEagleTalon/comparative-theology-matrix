    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1392",
    "ayah_text" : "دَعۡوَىٰهُمۡ فِيهَا سُبۡحَٰنَكَ ٱللَّهُمَّ وَتَحِيَّتُهُمۡ فِيهَا سَلَٰمٞۚ وَءَاخِرُ دَعۡوَىٰهُمۡ أَنِ ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "دعوىٰهم فيها سبحٰنك اللهم وتحيتهم فيها سلٰم وءاخر دعوىٰهم ان الحمد لله رب العٰلمين",
    "ayahnumber" : "10",
    "chapter" : "11",
    "hizb" : "20",
    "index" : "1392",
    "page" : "209",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1393",
    "ayah_text" : "۞وَلَوۡ يُعَجِّلُ ٱللَّهُ لِلنَّاسِ ٱلشَّرَّ ٱسۡتِعۡجَالَهُم بِٱلۡخَيۡرِ لَقُضِيَ إِلَيۡهِمۡ أَجَلُهُمۡۖ فَنَذَرُ ٱلَّذِينَ لَا يَرۡجُونَ لِقَآءَنَا فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ",
    "ayah_text_no_diacratic" : "ولو يعجل الله للناس الشر استعجالهم بالخير لقضي اليهم اجلهم فنذر الذين لا يرجون لقاءنا في طغيٰنهم يعمهون",
    "ayahnumber" : "11",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1393",
    "page" : "209",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1394",
    "ayah_text" : "وَإِذَا مَسَّ ٱلۡإِنسَٰنَ ٱلضُّرُّ دَعَانَا لِجَنۢبِهِۦٓ أَوۡ قَاعِدًا أَوۡ قَآئِمٗا فَلَمَّا كَشَفۡنَا عَنۡهُ ضُرَّهُۥ مَرَّ كَأَن لَّمۡ يَدۡعُنَآ إِلَىٰ ضُرّٖ مَّسَّهُۥۚ كَذَٰلِكَ زُيِّنَ لِلۡمُسۡرِفِينَ مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "واذا مس الانسٰن الضر دعانا لجنبه او قاعدا او قائما فلما كشفنا عنه ضره مر كان لم يدعنا الىٰ ضر مسه كذٰلك زين للمسرفين ما كانوا يعملون",
    "ayahnumber" : "12",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1394",
    "page" : "209",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1395",
    "ayah_text" : "وَلَقَدۡ أَهۡلَكۡنَا ٱلۡقُرُونَ مِن قَبۡلِكُمۡ لَمَّا ظَلَمُواْ وَجَآءَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ وَمَا كَانُواْ لِيُؤۡمِنُواْۚ كَذَٰلِكَ نَجۡزِي ٱلۡقَوۡمَ ٱلۡمُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "ولقد اهلكنا القرون من قبلكم لما ظلموا وجاءتهم رسلهم بالبينٰت وما كانوا ليؤمنوا كذٰلك نجزي القوم المجرمين",
    "ayahnumber" : "13",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1395",
    "page" : "209",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1396",
    "ayah_text" : "ثُمَّ جَعَلۡنَٰكُمۡ خَلَٰٓئِفَ فِي ٱلۡأَرۡضِ مِنۢ بَعۡدِهِمۡ لِنَنظُرَ كَيۡفَ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ثم جعلنٰكم خلٰئف في الارض من بعدهم لننظر كيف تعملون",
    "ayahnumber" : "14",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1396",
    "page" : "209",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1397",
    "ayah_text" : "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَاتُنَا بَيِّنَٰتٖ قَالَ ٱلَّذِينَ لَا يَرۡجُونَ لِقَآءَنَا ٱئۡتِ بِقُرۡءَانٍ غَيۡرِ هَٰذَآ أَوۡ بَدِّلۡهُۚ قُلۡ مَا يَكُونُ لِيٓ أَنۡ أُبَدِّلَهُۥ مِن تِلۡقَآيِٕ نَفۡسِيٓۖ إِنۡ أَتَّبِعُ إِلَّا مَا يُوحَىٰٓ إِلَيَّۖ إِنِّيٓ أَخَافُ إِنۡ عَصَيۡتُ رَبِّي عَذَابَ يَوۡمٍ عَظِيمٖ",
    "ayah_text_no_diacratic" : "واذا تتلىٰ عليهم ءاياتنا بينٰت قال الذين لا يرجون لقاءنا ائت بقرءان غير هٰذا او بدله قل ما يكون لي ان ابدله من تلقاي نفسي ان اتبع الا ما يوحىٰ الي اني اخاف ان عصيت ربي عذاب يوم عظيم",
    "ayahnumber" : "15",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1397",
    "page" : "210",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1398",
    "ayah_text" : "قُل لَّوۡ شَآءَ ٱللَّهُ مَا تَلَوۡتُهُۥ عَلَيۡكُمۡ وَلَآ أَدۡرَىٰكُم بِهِۦۖ فَقَدۡ لَبِثۡتُ فِيكُمۡ عُمُرٗا مِّن قَبۡلِهِۦٓۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "قل لو شاء الله ما تلوته عليكم ولا ادرىٰكم به فقد لبثت فيكم عمرا من قبله افلا تعقلون",
    "ayahnumber" : "16",
    "chapter" : "11",
    "hizb" : "21",
    "index" : "1398",
    "page" : "210",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1399",
    "ayah_text" : "فَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوۡ كَذَّبَ بِـَٔايَٰتِهِۦٓۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلۡمُجۡرِمُونَ",
    "ayah_text_no_diacratic" : "فمن اظلم ممن افترىٰ على الله كذبا او كذب بايٰته انه لا يفلح المجرمون",
    "ayahnumber" : "17",
