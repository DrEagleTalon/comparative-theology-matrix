  }, {
    "@id" : "quran:5500",
    "ayah_text" : "وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "وما هو بقول شاعر قليلا ما تؤمنون",
