    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1202",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَخُونُواْ ٱللَّهَ وَٱلرَّسُولَ وَتَخُونُوٓاْ أَمَٰنَٰتِكُمۡ وَأَنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تخونوا الله والرسول وتخونوا امٰنٰتكم وانتم تعلمون",
