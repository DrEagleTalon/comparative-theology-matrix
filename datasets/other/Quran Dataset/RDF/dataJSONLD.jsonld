    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1689",
    "ayah_text" : "قَالُواْ وَأَقۡبَلُواْ عَلَيۡهِم مَّاذَا تَفۡقِدُونَ",
    "ayah_text_no_diacratic" : "قالوا واقبلوا عليهم ماذا تفقدون",
