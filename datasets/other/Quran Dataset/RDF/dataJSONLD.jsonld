    "page" : "404",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3471",
    "ayah_text" : "فِي بِضۡعِ سِنِينَۗ لِلَّهِ ٱلۡأَمۡرُ مِن قَبۡلُ وَمِنۢ بَعۡدُۚ وَيَوۡمَئِذٖ يَفۡرَحُ ٱلۡمُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "في بضع سنين لله الامر من قبل ومن بعد ويومئذ يفرح المؤمنون",
    "ayahnumber" : "4",
    "chapter" : "21",
