    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1289",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ مَا لَكُمۡ إِذَا قِيلَ لَكُمُ ٱنفِرُواْ فِي سَبِيلِ ٱللَّهِ ٱثَّاقَلۡتُمۡ إِلَى ٱلۡأَرۡضِۚ أَرَضِيتُم بِٱلۡحَيَوٰةِ ٱلدُّنۡيَا مِنَ ٱلۡأٓخِرَةِۚ فَمَا مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا فِي ٱلۡأٓخِرَةِ إِلَّا قَلِيلٌ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ما لكم اذا قيل لكم انفروا في سبيل الله اثاقلتم الى الارض ارضيتم بالحيوٰة الدنيا من الاخرة فما متٰع الحيوٰة الدنيا في الاخرة الا قليل",
    "ayahnumber" : "38",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1289",
