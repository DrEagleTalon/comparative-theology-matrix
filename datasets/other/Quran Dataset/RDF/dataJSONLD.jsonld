  }, {
    "@id" : "quran:969",
    "ayah_text" : "كِتَٰبٌ أُنزِلَ إِلَيۡكَ فَلَا يَكُن فِي صَدۡرِكَ حَرَجٞ مِّنۡهُ لِتُنذِرَ بِهِۦ وَذِكۡرَىٰ لِلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "كتٰب انزل اليك فلا يكن في صدرك حرج منه لتنذر به وذكرىٰ للمؤمنين",
    "ayahnumber" : "2",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "969",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:97",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ وَقَفَّيۡنَا مِنۢ بَعۡدِهِۦ بِٱلرُّسُلِۖ وَءَاتَيۡنَا عِيسَى ٱبۡنَ مَرۡيَمَ ٱلۡبَيِّنَٰتِ وَأَيَّدۡنَٰهُ بِرُوحِ ٱلۡقُدُسِۗ أَفَكُلَّمَا جَآءَكُمۡ رَسُولُۢ بِمَا لَا تَهۡوَىٰٓ أَنفُسُكُمُ ٱسۡتَكۡبَرۡتُمۡ فَفَرِيقٗا كَذَّبۡتُمۡ وَفَرِيقٗا تَقۡتُلُونَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسى الكتٰب وقفينا من بعده بالرسل وءاتينا عيسى ابن مريم البينٰت وايدنٰه بروح القدس افكلما جاءكم رسول بما لا تهوىٰ انفسكم استكبرتم ففريقا كذبتم وفريقا تقتلون",
    "ayahnumber" : "87",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "97",
    "page" : "13",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:970",
    "ayah_text" : "ٱتَّبِعُواْ مَآ أُنزِلَ إِلَيۡكُم مِّن رَّبِّكُمۡ وَلَا تَتَّبِعُواْ مِن دُونِهِۦٓ أَوۡلِيَآءَۗ قَلِيلٗا مَّا تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "اتبعوا ما انزل اليكم من ربكم ولا تتبعوا من دونه اولياء قليلا ما تذكرون",
    "ayahnumber" : "3",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "970",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:971",
    "ayah_text" : "وَكَم مِّن قَرۡيَةٍ أَهۡلَكۡنَٰهَا فَجَآءَهَا بَأۡسُنَا بَيَٰتًا أَوۡ هُمۡ قَآئِلُونَ",
    "ayah_text_no_diacratic" : "وكم من قرية اهلكنٰها فجاءها باسنا بيٰتا او هم قائلون",
    "ayahnumber" : "4",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "971",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:972",
    "ayah_text" : "فَمَا كَانَ دَعۡوَىٰهُمۡ إِذۡ جَآءَهُم بَأۡسُنَآ إِلَّآ أَن قَالُوٓاْ إِنَّا كُنَّا ظَٰلِمِينَ",
    "ayah_text_no_diacratic" : "فما كان دعوىٰهم اذ جاءهم باسنا الا ان قالوا انا كنا ظٰلمين",
    "ayahnumber" : "5",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "972",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:973",
    "ayah_text" : "فَلَنَسۡـَٔلَنَّ ٱلَّذِينَ أُرۡسِلَ إِلَيۡهِمۡ وَلَنَسۡـَٔلَنَّ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "فلنسلن الذين ارسل اليهم ولنسلن المرسلين",
    "ayahnumber" : "6",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "973",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:974",
    "ayah_text" : "فَلَنَقُصَّنَّ عَلَيۡهِم بِعِلۡمٖۖ وَمَا كُنَّا غَآئِبِينَ",
    "ayah_text_no_diacratic" : "فلنقصن عليهم بعلم وما كنا غائبين",
    "ayahnumber" : "7",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "974",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:975",
    "ayah_text" : "وَٱلۡوَزۡنُ يَوۡمَئِذٍ ٱلۡحَقُّۚ فَمَن ثَقُلَتۡ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "والوزن يومئذ الحق فمن ثقلت موٰزينه فاولٰئك هم المفلحون",
    "ayahnumber" : "8",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "975",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:976",
    "ayah_text" : "وَمَنۡ خَفَّتۡ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُم بِمَا كَانُواْ بِـَٔايَٰتِنَا يَظۡلِمُونَ",
    "ayah_text_no_diacratic" : "ومن خفت موٰزينه فاولٰئك الذين خسروا انفسهم بما كانوا بايٰتنا يظلمون",
    "ayahnumber" : "9",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "976",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:977",
    "ayah_text" : "وَلَقَدۡ مَكَّنَّٰكُمۡ فِي ٱلۡأَرۡضِ وَجَعَلۡنَا لَكُمۡ فِيهَا مَعَٰيِشَۗ قَلِيلٗا مَّا تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "ولقد مكنٰكم في الارض وجعلنا لكم فيها معٰيش قليلا ما تشكرون",
    "ayahnumber" : "10",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "977",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:978",
    "ayah_text" : "وَلَقَدۡ خَلَقۡنَٰكُمۡ ثُمَّ صَوَّرۡنَٰكُمۡ ثُمَّ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ لَمۡ يَكُن مِّنَ ٱلسَّٰجِدِينَ",
    "ayah_text_no_diacratic" : "ولقد خلقنٰكم ثم صورنٰكم ثم قلنا للملٰئكة اسجدوا لادم فسجدوا الا ابليس لم يكن من السٰجدين",
    "ayahnumber" : "11",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "978",
    "page" : "151",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:979",
    "ayah_text" : "قَالَ مَا مَنَعَكَ أَلَّا تَسۡجُدَ إِذۡ أَمَرۡتُكَۖ قَالَ أَنَا۠ خَيۡرٞ مِّنۡهُ خَلَقۡتَنِي مِن نَّارٖ وَخَلَقۡتَهُۥ مِن طِينٖ",
    "ayah_text_no_diacratic" : "قال ما منعك الا تسجد اذ امرتك قال انا خير منه خلقتني من نار وخلقته من طين",
    "ayahnumber" : "12",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "979",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:98",
    "ayah_text" : "وَقَالُواْ قُلُوبُنَا غُلۡفُۢۚ بَل لَّعَنَهُمُ ٱللَّهُ بِكُفۡرِهِمۡ فَقَلِيلٗا مَّا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "وقالوا قلوبنا غلف بل لعنهم الله بكفرهم فقليلا ما يؤمنون",
    "ayahnumber" : "88",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "98",
    "page" : "13",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:980",
    "ayah_text" : "قَالَ فَٱهۡبِطۡ مِنۡهَا فَمَا يَكُونُ لَكَ أَن تَتَكَبَّرَ فِيهَا فَٱخۡرُجۡ إِنَّكَ مِنَ ٱلصَّٰغِرِينَ",
    "ayah_text_no_diacratic" : "قال فاهبط منها فما يكون لك ان تتكبر فيها فاخرج انك من الصٰغرين",
    "ayahnumber" : "13",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "980",
    "page" : "152",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:981",
    "ayah_text" : "قَالَ أَنظِرۡنِيٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ",
    "ayah_text_no_diacratic" : "قال انظرني الىٰ يوم يبعثون",
    "ayahnumber" : "14",
    "chapter" : "8",
    "hizb" : "15",
