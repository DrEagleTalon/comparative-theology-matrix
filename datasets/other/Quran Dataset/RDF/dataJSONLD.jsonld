    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4292",
    "ayah_text" : "وَيُرِيكُمۡ ءَايَٰتِهِۦ فَأَيَّ ءَايَٰتِ ٱللَّهِ تُنكِرُونَ",
    "ayah_text_no_diacratic" : "ويريكم ءايٰته فاي ءايٰت الله تنكرون",
