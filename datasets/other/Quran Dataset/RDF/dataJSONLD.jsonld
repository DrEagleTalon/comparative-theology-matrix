  }, {
    "@id" : "quran:3068",
    "ayah_text" : "وَٱغۡفِرۡ لِأَبِيٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ",
    "ayah_text_no_diacratic" : "واغفر لابي انه كان من الضالين",
