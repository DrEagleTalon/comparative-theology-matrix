    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:700",
    "ayah_text" : "قَالُواْ يَٰمُوسَىٰٓ إِنَّ فِيهَا قَوۡمٗا جَبَّارِينَ وَإِنَّا لَن نَّدۡخُلَهَا حَتَّىٰ يَخۡرُجُواْ مِنۡهَا فَإِن يَخۡرُجُواْ مِنۡهَا فَإِنَّا دَٰخِلُونَ",
    "ayah_text_no_diacratic" : "قالوا يٰموسىٰ ان فيها قوما جبارين وانا لن ندخلها حتىٰ يخرجوا منها فان يخرجوا منها فانا دٰخلون",
    "ayahnumber" : "22",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "700",
    "page" : "111",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:701",
    "ayah_text" : "قَالَ رَجُلَانِ مِنَ ٱلَّذِينَ يَخَافُونَ أَنۡعَمَ ٱللَّهُ عَلَيۡهِمَا ٱدۡخُلُواْ عَلَيۡهِمُ ٱلۡبَابَ فَإِذَا دَخَلۡتُمُوهُ فَإِنَّكُمۡ غَٰلِبُونَۚ وَعَلَى ٱللَّهِ فَتَوَكَّلُوٓاْ إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "قال رجلان من الذين يخافون انعم الله عليهما ادخلوا عليهم الباب فاذا دخلتموه فانكم غٰلبون وعلى الله فتوكلوا ان كنتم مؤمنين",
    "ayahnumber" : "23",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "701",
    "page" : "111",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:702",
    "ayah_text" : "قَالُواْ يَٰمُوسَىٰٓ إِنَّا لَن نَّدۡخُلَهَآ أَبَدٗا مَّا دَامُواْ فِيهَا فَٱذۡهَبۡ أَنتَ وَرَبُّكَ فَقَٰتِلَآ إِنَّا هَٰهُنَا قَٰعِدُونَ",
    "ayah_text_no_diacratic" : "قالوا يٰموسىٰ انا لن ندخلها ابدا ما داموا فيها فاذهب انت وربك فقٰتلا انا هٰهنا قٰعدون",
    "ayahnumber" : "24",
    "chapter" : "6",
    "hizb" : "11",
