    "surrahname_no_diacratic" : "سورة المعارج"
  }, {
    "@id" : "quran:5552",
    "ayah_text" : "كَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ",
