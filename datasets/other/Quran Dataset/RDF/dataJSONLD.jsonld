    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4381",
    "ayah_text" : "۞وَلَوۡ بَسَطَ ٱللَّهُ ٱلرِّزۡقَ لِعِبَادِهِۦ لَبَغَوۡاْ فِي ٱلۡأَرۡضِ وَلَٰكِن يُنَزِّلُ بِقَدَرٖ مَّا يَشَآءُۚ إِنَّهُۥ بِعِبَادِهِۦ خَبِيرُۢ بَصِيرٞ",
    "ayah_text_no_diacratic" : "ولو بسط الله الرزق لعباده لبغوا في الارض ولٰكن ينزل بقدر ما يشاء انه بعباده خبير بصير",
    "ayahnumber" : "27",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4381",
    "page" : "486",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4382",
    "ayah_text" : "وَهُوَ ٱلَّذِي يُنَزِّلُ ٱلۡغَيۡثَ مِنۢ بَعۡدِ مَا قَنَطُواْ وَيَنشُرُ رَحۡمَتَهُۥۚ وَهُوَ ٱلۡوَلِيُّ ٱلۡحَمِيدُ",
    "ayah_text_no_diacratic" : "وهو الذي ينزل الغيث من بعد ما قنطوا وينشر رحمته وهو الولي الحميد",
    "ayahnumber" : "28",
    "chapter" : "25",
    "hizb" : "48",
