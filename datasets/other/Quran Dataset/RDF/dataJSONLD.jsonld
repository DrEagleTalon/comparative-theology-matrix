  }, {
    "@id" : "quran:2595",
    "ayah_text" : "وَوَهَبۡنَا لَهُۥٓ إِسۡحَٰقَ وَيَعۡقُوبَ نَافِلَةٗۖ وَكُلّٗا جَعَلۡنَا صَٰلِحِينَ",
    "ayah_text_no_diacratic" : "ووهبنا له اسحٰق ويعقوب نافلة وكلا جعلنا صٰلحين",
