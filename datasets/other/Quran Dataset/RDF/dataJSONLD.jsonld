    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2583",
    "ayah_text" : "قَالُواْ سَمِعۡنَا فَتٗى يَذۡكُرُهُمۡ يُقَالُ لَهُۥٓ إِبۡرَٰهِيمُ",
    "ayah_text_no_diacratic" : "قالوا سمعنا فتى يذكرهم يقال له ابرٰهيم",
