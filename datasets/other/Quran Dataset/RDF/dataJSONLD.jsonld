    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1905",
    "ayah_text" : "إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّلۡمُتَوَسِّمِينَ",
    "ayah_text_no_diacratic" : "ان في ذٰلك لايٰت للمتوسمين",
    "ayahnumber" : "75",
    "chapter" : "14",
