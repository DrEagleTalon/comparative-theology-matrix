    "page" : "354",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2872",
    "ayah_text" : "۞ٱللَّهُ نُورُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ مَثَلُ نُورِهِۦ كَمِشۡكَوٰةٖ فِيهَا مِصۡبَاحٌۖ ٱلۡمِصۡبَاحُ فِي زُجَاجَةٍۖ ٱلزُّجَاجَةُ كَأَنَّهَا كَوۡكَبٞ دُرِّيّٞ يُوقَدُ مِن شَجَرَةٖ مُّبَٰرَكَةٖ زَيۡتُونَةٖ لَّا شَرۡقِيَّةٖ وَلَا غَرۡبِيَّةٖ يَكَادُ زَيۡتُهَا يُضِيٓءُ وَلَوۡ لَمۡ تَمۡسَسۡهُ نَارٞۚ نُّورٌ عَلَىٰ نُورٖۚ يَهۡدِي ٱللَّهُ لِنُورِهِۦ مَن يَشَآءُۚ وَيَضۡرِبُ ٱللَّهُ ٱلۡأَمۡثَٰلَ لِلنَّاسِۗ وَٱللَّهُ بِكُلِّ شَيۡءٍ عَلِيمٞ",
    "ayah_text_no_diacratic" : "الله نور السمٰوٰت والارض مثل نوره كمشكوٰة فيها مصباح المصباح في زجاجة الزجاجة كانها كوكب دري يوقد من شجرة مبٰركة زيتونة لا شرقية ولا غربية يكاد زيتها يضيء ولو لم تمسسه نار نور علىٰ نور يهدي الله لنوره من يشاء ويضرب الله الامثٰل للناس والله بكل شيء عليم",
    "ayahnumber" : "35",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2872",
    "page" : "354",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2873",
    "ayah_text" : "فِي بُيُوتٍ أَذِنَ ٱللَّهُ أَن تُرۡفَعَ وَيُذۡكَرَ فِيهَا ٱسۡمُهُۥ يُسَبِّحُ لَهُۥ فِيهَا بِٱلۡغُدُوِّ وَٱلۡأٓصَالِ",
    "ayah_text_no_diacratic" : "في بيوت اذن الله ان ترفع ويذكر فيها اسمه يسبح له فيها بالغدو والاصال",
    "ayahnumber" : "36",
    "chapter" : "18",
    "hizb" : "35",
