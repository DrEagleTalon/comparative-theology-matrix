  }, {
    "@id" : "quran:3642",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ إِنَّآ أَرۡسَلۡنَٰكَ شَٰهِدٗا وَمُبَشِّرٗا وَنَذِيرٗا",
    "ayah_text_no_diacratic" : "يٰايها النبي انا ارسلنٰك شٰهدا ومبشرا ونذيرا",
