    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2800",
    "ayah_text" : "لَقَدۡ وُعِدۡنَا نَحۡنُ وَءَابَآؤُنَا هَٰذَا مِن قَبۡلُ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "لقد وعدنا نحن وءاباؤنا هٰذا من قبل ان هٰذا الا اسٰطير الاولين",
    "ayahnumber" : "83",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2800",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2801",
    "ayah_text" : "قُل لِّمَنِ ٱلۡأَرۡضُ وَمَن فِيهَآ إِن كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قل لمن الارض ومن فيها ان كنتم تعلمون",
    "ayahnumber" : "84",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2801",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2802",
    "ayah_text" : "سَيَقُولُونَ لِلَّهِۚ قُلۡ أَفَلَا تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "سيقولون لله قل افلا تذكرون",
    "ayahnumber" : "85",
