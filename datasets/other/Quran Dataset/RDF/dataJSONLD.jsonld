    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2799",
    "ayah_text" : "قَالُوٓاْ أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
    "ayah_text_no_diacratic" : "قالوا اءذا متنا وكنا ترابا وعظٰما اءنا لمبعوثون",
    "ayahnumber" : "82",
