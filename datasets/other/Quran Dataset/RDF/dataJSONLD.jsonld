  }, {
    "@id" : "quran:2730",
    "ayah_text" : "ثُمَّ جَعَلۡنَٰهُ نُطۡفَةٗ فِي قَرَارٖ مَّكِينٖ",
    "ayah_text_no_diacratic" : "ثم جعلنٰه نطفة في قرار مكين",
