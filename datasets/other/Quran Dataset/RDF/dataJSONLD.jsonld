    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:862",
    "ayah_text" : "ثُمَّ رُدُّوٓاْ إِلَى ٱللَّهِ مَوۡلَىٰهُمُ ٱلۡحَقِّۚ أَلَا لَهُ ٱلۡحُكۡمُ وَهُوَ أَسۡرَعُ ٱلۡحَٰسِبِينَ",
    "ayah_text_no_diacratic" : "ثم ردوا الى الله مولىٰهم الحق الا له الحكم وهو اسرع الحٰسبين",
