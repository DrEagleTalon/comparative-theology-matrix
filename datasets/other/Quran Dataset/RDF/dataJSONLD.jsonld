    "hizb" : "32",
    "index" : "2599",
    "page" : "328",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:26",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ ٱشۡتَرَوُاْ ٱلضَّلَٰلَةَ بِٱلۡهُدَىٰ فَمَا رَبِحَت تِّجَٰرَتُهُمۡ وَمَا كَانُواْ مُهۡتَدِينَ",
    "ayah_text_no_diacratic" : "اولٰئك الذين اشتروا الضلٰلة بالهدىٰ فما ربحت تجٰرتهم وما كانوا مهتدين",
