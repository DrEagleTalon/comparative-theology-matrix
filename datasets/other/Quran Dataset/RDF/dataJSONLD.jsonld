    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1229",
    "ayah_text" : "كَدَأۡبِ ءَالِ فِرۡعَوۡنَ وَٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَذَّبُواْ بِـَٔايَٰتِ رَبِّهِمۡ فَأَهۡلَكۡنَٰهُم بِذُنُوبِهِمۡ وَأَغۡرَقۡنَآ ءَالَ فِرۡعَوۡنَۚ وَكُلّٞ كَانُواْ ظَٰلِمِينَ",
    "ayah_text_no_diacratic" : "كداب ءال فرعون والذين من قبلهم كذبوا بايٰت ربهم فاهلكنٰهم بذنوبهم واغرقنا ءال فرعون وكل كانوا ظٰلمين",
    "ayahnumber" : "54",
