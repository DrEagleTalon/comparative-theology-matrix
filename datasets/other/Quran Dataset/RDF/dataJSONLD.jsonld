    "page" : "12",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:930",
    "ayah_text" : "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ أَلَمۡ يَأۡتِكُمۡ رُسُلٞ مِّنكُمۡ يَقُصُّونَ عَلَيۡكُمۡ ءَايَٰتِي وَيُنذِرُونَكُمۡ لِقَآءَ يَوۡمِكُمۡ هَٰذَاۚ قَالُواْ شَهِدۡنَا عَلَىٰٓ أَنفُسِنَاۖ وَغَرَّتۡهُمُ ٱلۡحَيَوٰةُ ٱلدُّنۡيَا وَشَهِدُواْ عَلَىٰٓ أَنفُسِهِمۡ أَنَّهُمۡ كَانُواْ كَٰفِرِينَ",
    "ayah_text_no_diacratic" : "يٰمعشر الجن والانس الم ياتكم رسل منكم يقصون عليكم ءايٰتي وينذرونكم لقاء يومكم هٰذا قالوا شهدنا علىٰ انفسنا وغرتهم الحيوٰة الدنيا وشهدوا علىٰ انفسهم انهم كانوا كٰفرين",
    "ayahnumber" : "130",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "930",
    "page" : "144",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:931",
    "ayah_text" : "ذَٰلِكَ أَن لَّمۡ يَكُن رَّبُّكَ مُهۡلِكَ ٱلۡقُرَىٰ بِظُلۡمٖ وَأَهۡلُهَا غَٰفِلُونَ",
    "ayah_text_no_diacratic" : "ذٰلك ان لم يكن ربك مهلك القرىٰ بظلم واهلها غٰفلون",
    "ayahnumber" : "131",
    "chapter" : "8",
    "hizb" : "14",
