    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1086",
    "ayah_text" : "فَغُلِبُواْ هُنَالِكَ وَٱنقَلَبُواْ صَٰغِرِينَ",
    "ayah_text_no_diacratic" : "فغلبوا هنالك وانقلبوا صٰغرين",
    "ayahnumber" : "119",
    "chapter" : "9",
