    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1673",
    "ayah_text" : "قَالَ ٱجۡعَلۡنِي عَلَىٰ خَزَآئِنِ ٱلۡأَرۡضِۖ إِنِّي حَفِيظٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "قال اجعلني علىٰ خزائن الارض اني حفيظ عليم",
