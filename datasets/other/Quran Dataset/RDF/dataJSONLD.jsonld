    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4869",
    "ayah_text" : "أَمۡ تَأۡمُرُهُمۡ أَحۡلَٰمُهُم بِهَٰذَآۚ أَمۡ هُمۡ قَوۡمٞ طَاغُونَ",
    "ayah_text_no_diacratic" : "ام تامرهم احلٰمهم بهٰذا ام هم قوم طاغون",
    "ayahnumber" : "32",
    "chapter" : "27",
