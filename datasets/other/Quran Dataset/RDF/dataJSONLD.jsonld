    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3064",
    "ayah_text" : "وَٱلَّذِيٓ أَطۡمَعُ أَن يَغۡفِرَ لِي خَطِيٓـَٔتِي يَوۡمَ ٱلدِّينِ",
    "ayah_text_no_diacratic" : "والذي اطمع ان يغفر لي خطيتي يوم الدين",
