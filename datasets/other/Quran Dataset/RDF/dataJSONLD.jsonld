    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:260",
    "ayah_text" : "وَلَمَّا بَرَزُواْ لِجَالُوتَ وَجُنُودِهِۦ قَالُواْ رَبَّنَآ أَفۡرِغۡ عَلَيۡنَا صَبۡرٗا وَثَبِّتۡ أَقۡدَامَنَا وَٱنصُرۡنَا عَلَى ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ولما برزوا لجالوت وجنوده قالوا ربنا افرغ علينا صبرا وثبت اقدامنا وانصرنا على القوم الكٰفرين",
    "ayahnumber" : "250",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "260",
    "page" : "41",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2600",
    "ayah_text" : "وَنَصَرۡنَٰهُ مِنَ ٱلۡقَوۡمِ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَآۚ إِنَّهُمۡ كَانُواْ قَوۡمَ سَوۡءٖ فَأَغۡرَقۡنَٰهُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "ونصرنٰه من القوم الذين كذبوا بايٰتنا انهم كانوا قوم سوء فاغرقنٰهم اجمعين",
    "ayahnumber" : "77",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2600",
    "page" : "328",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2601",
    "ayah_text" : "وَدَاوُۥدَ وَسُلَيۡمَٰنَ إِذۡ يَحۡكُمَانِ فِي ٱلۡحَرۡثِ إِذۡ نَفَشَتۡ فِيهِ غَنَمُ ٱلۡقَوۡمِ وَكُنَّا لِحُكۡمِهِمۡ شَٰهِدِينَ",
    "ayah_text_no_diacratic" : "وداود وسليمٰن اذ يحكمان في الحرث اذ نفشت فيه غنم القوم وكنا لحكمهم شٰهدين",
    "ayahnumber" : "78",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2601",
    "page" : "328",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2602",
    "ayah_text" : "فَفَهَّمۡنَٰهَا سُلَيۡمَٰنَۚ وَكُلًّا ءَاتَيۡنَا حُكۡمٗا وَعِلۡمٗاۚ وَسَخَّرۡنَا مَعَ دَاوُۥدَ ٱلۡجِبَالَ يُسَبِّحۡنَ وَٱلطَّيۡرَۚ وَكُنَّا فَٰعِلِينَ",
    "ayah_text_no_diacratic" : "ففهمنٰها سليمٰن وكلا ءاتينا حكما وعلما وسخرنا مع داود الجبال يسبحن والطير وكنا فٰعلين",
    "ayahnumber" : "79",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2602",
