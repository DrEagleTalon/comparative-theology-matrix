    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1496",
    "ayah_text" : "وَأَنِ ٱسۡتَغۡفِرُواْ رَبَّكُمۡ ثُمَّ تُوبُوٓاْ إِلَيۡهِ يُمَتِّعۡكُم مَّتَٰعًا حَسَنًا إِلَىٰٓ أَجَلٖ مُّسَمّٗى وَيُؤۡتِ كُلَّ ذِي فَضۡلٖ فَضۡلَهُۥۖ وَإِن تَوَلَّوۡاْ فَإِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٖ كَبِيرٍ",
    "ayah_text_no_diacratic" : "وان استغفروا ربكم ثم توبوا اليه يمتعكم متٰعا حسنا الىٰ اجل مسمى ويؤت كل ذي فضل فضله وان تولوا فاني اخاف عليكم عذاب يوم كبير",
    "ayahnumber" : "3",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1496",
    "page" : "221",
    "surahname" : "سُورَةُ هُودٍ",
