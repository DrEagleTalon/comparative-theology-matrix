    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2813",
    "ayah_text" : "ٱدۡفَعۡ بِٱلَّتِي هِيَ أَحۡسَنُ ٱلسَّيِّئَةَۚ نَحۡنُ أَعۡلَمُ بِمَا يَصِفُونَ",
    "ayah_text_no_diacratic" : "ادفع بالتي هي احسن السيئة نحن اعلم بما يصفون",
    "ayahnumber" : "96",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2813",
