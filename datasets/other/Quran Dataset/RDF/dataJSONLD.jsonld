    "surrahname_no_diacratic" : "سورة الانشقاق"
  }, {
    "@id" : "quran:605",
    "ayah_text" : "إِنَّآ أَنزَلۡنَآ إِلَيۡكَ ٱلۡكِتَٰبَ بِٱلۡحَقِّ لِتَحۡكُمَ بَيۡنَ ٱلنَّاسِ بِمَآ أَرَىٰكَ ٱللَّهُۚ وَلَا تَكُن لِّلۡخَآئِنِينَ خَصِيمٗا",
    "ayah_text_no_diacratic" : "انا انزلنا اليك الكتٰب بالحق لتحكم بين الناس بما ارىٰك الله ولا تكن للخائنين خصيما",
    "ayahnumber" : "105",
    "chapter" : "5",
