  }, {
    "@id" : "quran:3707",
    "ayah_text" : "وَقَالُواْ نَحۡنُ أَكۡثَرُ أَمۡوَٰلٗا وَأَوۡلَٰدٗا وَمَا نَحۡنُ بِمُعَذَّبِينَ",
    "ayah_text_no_diacratic" : "وقالوا نحن اكثر اموٰلا واولٰدا وما نحن بمعذبين",
