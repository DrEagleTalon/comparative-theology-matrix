    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2660",
    "ayah_text" : "إِنَّ ٱللَّهَ يُدۡخِلُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ يُحَلَّوۡنَ فِيهَا مِنۡ أَسَاوِرَ مِن ذَهَبٖ وَلُؤۡلُؤٗاۖ وَلِبَاسُهُمۡ فِيهَا حَرِيرٞ",
    "ayah_text_no_diacratic" : "ان الله يدخل الذين ءامنوا وعملوا الصٰلحٰت جنٰت تجري من تحتها الانهٰر يحلون فيها من اساور من ذهب ولؤلؤا ولباسهم فيها حرير",
    "ayahnumber" : "23",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2660",
    "page" : "334",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2661",
    "ayah_text" : "وَهُدُوٓاْ إِلَى ٱلطَّيِّبِ مِنَ ٱلۡقَوۡلِ وَهُدُوٓاْ إِلَىٰ صِرَٰطِ ٱلۡحَمِيدِ",
    "ayah_text_no_diacratic" : "وهدوا الى الطيب من القول وهدوا الىٰ صرٰط الحميد",
    "ayahnumber" : "24",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2661",
    "page" : "335",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2662",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَٱلۡمَسۡجِدِ ٱلۡحَرَامِ ٱلَّذِي جَعَلۡنَٰهُ لِلنَّاسِ سَوَآءً ٱلۡعَٰكِفُ فِيهِ وَٱلۡبَادِۚ وَمَن يُرِدۡ فِيهِ بِإِلۡحَادِۭ بِظُلۡمٖ نُّذِقۡهُ مِنۡ عَذَابٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "ان الذين كفروا ويصدون عن سبيل الله والمسجد الحرام الذي جعلنٰه للناس سواء العٰكف فيه والباد ومن يرد فيه بالحاد بظلم نذقه من عذاب اليم",
    "ayahnumber" : "25",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2662",
    "page" : "335",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2663",
    "ayah_text" : "وَإِذۡ بَوَّأۡنَا لِإِبۡرَٰهِيمَ مَكَانَ ٱلۡبَيۡتِ أَن لَّا تُشۡرِكۡ بِي شَيۡـٔٗا وَطَهِّرۡ بَيۡتِيَ لِلطَّآئِفِينَ وَٱلۡقَآئِمِينَ وَٱلرُّكَّعِ ٱلسُّجُودِ",
    "ayah_text_no_diacratic" : "واذ بوانا لابرٰهيم مكان البيت ان لا تشرك بي شيا وطهر بيتي للطائفين والقائمين والركع السجود",
    "ayahnumber" : "26",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2663",
    "page" : "335",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2664",
    "ayah_text" : "وَأَذِّن فِي ٱلنَّاسِ بِٱلۡحَجِّ يَأۡتُوكَ رِجَالٗا وَعَلَىٰ كُلِّ ضَامِرٖ يَأۡتِينَ مِن كُلِّ فَجٍّ عَمِيقٖ",
    "ayah_text_no_diacratic" : "واذن في الناس بالحج ياتوك رجالا وعلىٰ كل ضامر ياتين من كل فج عميق",
    "ayahnumber" : "27",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2664",
    "page" : "335",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2665",
    "ayah_text" : "لِّيَشۡهَدُواْ مَنَٰفِعَ لَهُمۡ وَيَذۡكُرُواْ ٱسۡمَ ٱللَّهِ فِيٓ أَيَّامٖ مَّعۡلُومَٰتٍ عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلۡأَنۡعَٰمِۖ فَكُلُواْ مِنۡهَا وَأَطۡعِمُواْ ٱلۡبَآئِسَ ٱلۡفَقِيرَ",
    "ayah_text_no_diacratic" : "ليشهدوا منٰفع لهم ويذكروا اسم الله في ايام معلومٰت علىٰ ما رزقهم من بهيمة الانعٰم فكلوا منها واطعموا البائس الفقير",
    "ayahnumber" : "28",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2665",
    "page" : "335",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2666",
    "ayah_text" : "ثُمَّ لۡيَقۡضُواْ تَفَثَهُمۡ وَلۡيُوفُواْ نُذُورَهُمۡ وَلۡيَطَّوَّفُواْ بِٱلۡبَيۡتِ ٱلۡعَتِيقِ",
    "ayah_text_no_diacratic" : "ثم ليقضوا تفثهم وليوفوا نذورهم وليطوفوا بالبيت العتيق",
    "ayahnumber" : "29",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2666",
    "page" : "335",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2667",
    "ayah_text" : "ذَٰلِكَۖ وَمَن يُعَظِّمۡ حُرُمَٰتِ ٱللَّهِ فَهُوَ خَيۡرٞ لَّهُۥ عِندَ رَبِّهِۦۗ وَأُحِلَّتۡ لَكُمُ ٱلۡأَنۡعَٰمُ إِلَّا مَا يُتۡلَىٰ عَلَيۡكُمۡۖ فَٱجۡتَنِبُواْ ٱلرِّجۡسَ مِنَ ٱلۡأَوۡثَٰنِ وَٱجۡتَنِبُواْ قَوۡلَ ٱلزُّورِ",
    "ayah_text_no_diacratic" : "ذٰلك ومن يعظم حرمٰت الله فهو خير له عند ربه واحلت لكم الانعٰم الا ما يتلىٰ عليكم فاجتنبوا الرجس من الاوثٰن واجتنبوا قول الزور",
    "ayahnumber" : "30",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2667",
    "page" : "335",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2668",
    "ayah_text" : "حُنَفَآءَ لِلَّهِ غَيۡرَ مُشۡرِكِينَ بِهِۦۚ وَمَن يُشۡرِكۡ بِٱللَّهِ فَكَأَنَّمَا خَرَّ مِنَ ٱلسَّمَآءِ فَتَخۡطَفُهُ ٱلطَّيۡرُ أَوۡ تَهۡوِي بِهِ ٱلرِّيحُ فِي مَكَانٖ سَحِيقٖ",
    "ayah_text_no_diacratic" : "حنفاء لله غير مشركين به ومن يشرك بالله فكانما خر من السماء فتخطفه الطير او تهوي به الريح في مكان سحيق",
    "ayahnumber" : "31",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2668",
    "page" : "336",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2669",
    "ayah_text" : "ذَٰلِكَۖ وَمَن يُعَظِّمۡ شَعَٰٓئِرَ ٱللَّهِ فَإِنَّهَا مِن تَقۡوَى ٱلۡقُلُوبِ",
    "ayah_text_no_diacratic" : "ذٰلك ومن يعظم شعٰئر الله فانها من تقوى القلوب",
    "ayahnumber" : "32",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2669",
    "page" : "336",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:267",
    "ayah_text" : "ٱللَّهُ وَلِيُّ ٱلَّذِينَ ءَامَنُواْ يُخۡرِجُهُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۖ وَٱلَّذِينَ كَفَرُوٓاْ أَوۡلِيَآؤُهُمُ ٱلطَّٰغُوتُ يُخۡرِجُونَهُم مِّنَ ٱلنُّورِ إِلَى ٱلظُّلُمَٰتِۗ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "الله ولي الذين ءامنوا يخرجهم من الظلمٰت الى النور والذين كفروا اولياؤهم الطٰغوت يخرجونهم من النور الى الظلمٰت اولٰئك اصحٰب النار هم فيها خٰلدون",
    "ayahnumber" : "257",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "267",
    "page" : "43",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2670",
    "ayah_text" : "لَكُمۡ فِيهَا مَنَٰفِعُ إِلَىٰٓ أَجَلٖ مُّسَمّٗى ثُمَّ مَحِلُّهَآ إِلَى ٱلۡبَيۡتِ ٱلۡعَتِيقِ",
    "ayah_text_no_diacratic" : "لكم فيها منٰفع الىٰ اجل مسمى ثم محلها الى البيت العتيق",
    "ayahnumber" : "33",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2670",
    "page" : "336",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2671",
    "ayah_text" : "وَلِكُلِّ أُمَّةٖ جَعَلۡنَا مَنسَكٗا لِّيَذۡكُرُواْ ٱسۡمَ ٱللَّهِ عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلۡأَنۡعَٰمِۗ فَإِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞ فَلَهُۥٓ أَسۡلِمُواْۗ وَبَشِّرِ ٱلۡمُخۡبِتِينَ",
    "ayah_text_no_diacratic" : "ولكل امة جعلنا منسكا ليذكروا اسم الله علىٰ ما رزقهم من بهيمة الانعٰم فالٰهكم الٰه وٰحد فله اسلموا وبشر المخبتين",
    "ayahnumber" : "34",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2671",
    "page" : "336",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2672",
    "ayah_text" : "ٱلَّذِينَ إِذَا ذُكِرَ ٱللَّهُ وَجِلَتۡ قُلُوبُهُمۡ وَٱلصَّٰبِرِينَ عَلَىٰ مَآ أَصَابَهُمۡ وَٱلۡمُقِيمِي ٱلصَّلَوٰةِ وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ",
    "ayah_text_no_diacratic" : "الذين اذا ذكر الله وجلت قلوبهم والصٰبرين علىٰ ما اصابهم والمقيمي الصلوٰة ومما رزقنٰهم ينفقون",
    "ayahnumber" : "35",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2672",
    "page" : "336",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2673",
    "ayah_text" : "وَٱلۡبُدۡنَ جَعَلۡنَٰهَا لَكُم مِّن شَعَٰٓئِرِ ٱللَّهِ لَكُمۡ فِيهَا خَيۡرٞۖ فَٱذۡكُرُواْ ٱسۡمَ ٱللَّهِ عَلَيۡهَا صَوَآفَّۖ فَإِذَا وَجَبَتۡ جُنُوبُهَا فَكُلُواْ مِنۡهَا وَأَطۡعِمُواْ ٱلۡقَانِعَ وَٱلۡمُعۡتَرَّۚ كَذَٰلِكَ سَخَّرۡنَٰهَا لَكُمۡ لَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "والبدن جعلنٰها لكم من شعٰئر الله لكم فيها خير فاذكروا اسم الله عليها صواف فاذا وجبت جنوبها فكلوا منها واطعموا القانع والمعتر كذٰلك سخرنٰها لكم لعلكم تشكرون",
    "ayahnumber" : "36",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2673",
    "page" : "336",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2674",
    "ayah_text" : "لَن يَنَالَ ٱللَّهَ لُحُومُهَا وَلَا دِمَآؤُهَا وَلَٰكِن يَنَالُهُ ٱلتَّقۡوَىٰ مِنكُمۡۚ كَذَٰلِكَ سَخَّرَهَا لَكُمۡ لِتُكَبِّرُواْ ٱللَّهَ عَلَىٰ مَا هَدَىٰكُمۡۗ وَبَشِّرِ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "لن ينال الله لحومها ولا دماؤها ولٰكن يناله التقوىٰ منكم كذٰلك سخرها لكم لتكبروا الله علىٰ ما هدىٰكم وبشر المحسنين",
    "ayahnumber" : "37",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2674",
    "page" : "336",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2675",
    "ayah_text" : "۞إِنَّ ٱللَّهَ يُدَٰفِعُ عَنِ ٱلَّذِينَ ءَامَنُوٓاْۗ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ خَوَّانٖ كَفُورٍ",
    "ayah_text_no_diacratic" : "ان الله يدٰفع عن الذين ءامنوا ان الله لا يحب كل خوان كفور",
    "ayahnumber" : "38",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2675",
    "page" : "336",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2676",
    "ayah_text" : "أُذِنَ لِلَّذِينَ يُقَٰتَلُونَ بِأَنَّهُمۡ ظُلِمُواْۚ وَإِنَّ ٱللَّهَ عَلَىٰ نَصۡرِهِمۡ لَقَدِيرٌ",
    "ayah_text_no_diacratic" : "اذن للذين يقٰتلون بانهم ظلموا وان الله علىٰ نصرهم لقدير",
    "ayahnumber" : "39",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2676",
    "page" : "337",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2677",
    "ayah_text" : "ٱلَّذِينَ أُخۡرِجُواْ مِن دِيَٰرِهِم بِغَيۡرِ حَقٍّ إِلَّآ أَن يَقُولُواْ رَبُّنَا ٱللَّهُۗ وَلَوۡلَا دَفۡعُ ٱللَّهِ ٱلنَّاسَ بَعۡضَهُم بِبَعۡضٖ لَّهُدِّمَتۡ صَوَٰمِعُ وَبِيَعٞ وَصَلَوَٰتٞ وَمَسَٰجِدُ يُذۡكَرُ فِيهَا ٱسۡمُ ٱللَّهِ كَثِيرٗاۗ وَلَيَنصُرَنَّ ٱللَّهُ مَن يَنصُرُهُۥٓۚ إِنَّ ٱللَّهَ لَقَوِيٌّ عَزِيزٌ",
    "ayah_text_no_diacratic" : "الذين اخرجوا من ديٰرهم بغير حق الا ان يقولوا ربنا الله ولولا دفع الله الناس بعضهم ببعض لهدمت صوٰمع وبيع وصلوٰت ومسٰجد يذكر فيها اسم الله كثيرا ولينصرن الله من ينصره ان الله لقوي عزيز",
    "ayahnumber" : "40",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2677",
    "page" : "337",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2678",
    "ayah_text" : "ٱلَّذِينَ إِن مَّكَّنَّٰهُمۡ فِي ٱلۡأَرۡضِ أَقَامُواْ ٱلصَّلَوٰةَ وَءَاتَوُاْ ٱلزَّكَوٰةَ وَأَمَرُواْ بِٱلۡمَعۡرُوفِ وَنَهَوۡاْ عَنِ ٱلۡمُنكَرِۗ وَلِلَّهِ عَٰقِبَةُ ٱلۡأُمُورِ",
    "ayah_text_no_diacratic" : "الذين ان مكنٰهم في الارض اقاموا الصلوٰة وءاتوا الزكوٰة وامروا بالمعروف ونهوا عن المنكر ولله عٰقبة الامور",
    "ayahnumber" : "41",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2678",
    "page" : "337",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2679",
    "ayah_text" : "وَإِن يُكَذِّبُوكَ فَقَدۡ كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحٖ وَعَادٞ وَثَمُودُ",
    "ayah_text_no_diacratic" : "وان يكذبوك فقد كذبت قبلهم قوم نوح وعاد وثمود",
    "ayahnumber" : "42",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2679",
    "page" : "337",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:268",
    "ayah_text" : "أَلَمۡ تَرَ إِلَى ٱلَّذِي حَآجَّ إِبۡرَٰهِـۧمَ فِي رَبِّهِۦٓ أَنۡ ءَاتَىٰهُ ٱللَّهُ ٱلۡمُلۡكَ إِذۡ قَالَ إِبۡرَٰهِـۧمُ رَبِّيَ ٱلَّذِي يُحۡيِۦ وَيُمِيتُ قَالَ أَنَا۠ أُحۡيِۦ وَأُمِيتُۖ قَالَ إِبۡرَٰهِـۧمُ فَإِنَّ ٱللَّهَ يَأۡتِي بِٱلشَّمۡسِ مِنَ ٱلۡمَشۡرِقِ فَأۡتِ بِهَا مِنَ ٱلۡمَغۡرِبِ فَبُهِتَ ٱلَّذِي كَفَرَۗ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "الم تر الى الذي حاج ابرٰهم في ربه ان ءاتىٰه الله الملك اذ قال ابرٰهم ربي الذي يحي ويميت قال انا احي واميت قال ابرٰهم فان الله ياتي بالشمس من المشرق فات بها من المغرب فبهت الذي كفر والله لا يهدي القوم الظٰلمين",
    "ayahnumber" : "258",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "268",
    "page" : "43",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2680",
    "ayah_text" : "وَقَوۡمُ إِبۡرَٰهِيمَ وَقَوۡمُ لُوطٖ",
    "ayah_text_no_diacratic" : "وقوم ابرٰهيم وقوم لوط",
    "ayahnumber" : "43",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2680",
    "page" : "337",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2681",
    "ayah_text" : "وَأَصۡحَٰبُ مَدۡيَنَۖ وَكُذِّبَ مُوسَىٰۖ فَأَمۡلَيۡتُ لِلۡكَٰفِرِينَ ثُمَّ أَخَذۡتُهُمۡۖ فَكَيۡفَ كَانَ نَكِيرِ",
    "ayah_text_no_diacratic" : "واصحٰب مدين وكذب موسىٰ فامليت للكٰفرين ثم اخذتهم فكيف كان نكير",
    "ayahnumber" : "44",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2681",
    "page" : "337",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2682",
    "ayah_text" : "فَكَأَيِّن مِّن قَرۡيَةٍ أَهۡلَكۡنَٰهَا وَهِيَ ظَالِمَةٞ فَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَبِئۡرٖ مُّعَطَّلَةٖ وَقَصۡرٖ مَّشِيدٍ",
    "ayah_text_no_diacratic" : "فكاين من قرية اهلكنٰها وهي ظالمة فهي خاوية علىٰ عروشها وبئر معطلة وقصر مشيد",
    "ayahnumber" : "45",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2682",
    "page" : "337",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2683",
    "ayah_text" : "أَفَلَمۡ يَسِيرُواْ فِي ٱلۡأَرۡضِ فَتَكُونَ لَهُمۡ قُلُوبٞ يَعۡقِلُونَ بِهَآ أَوۡ ءَاذَانٞ يَسۡمَعُونَ بِهَاۖ فَإِنَّهَا لَا تَعۡمَى ٱلۡأَبۡصَٰرُ وَلَٰكِن تَعۡمَى ٱلۡقُلُوبُ ٱلَّتِي فِي ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "افلم يسيروا في الارض فتكون لهم قلوب يعقلون بها او ءاذان يسمعون بها فانها لا تعمى الابصٰر ولٰكن تعمى القلوب التي في الصدور",
    "ayahnumber" : "46",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2683",
    "page" : "337",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2684",
    "ayah_text" : "وَيَسۡتَعۡجِلُونَكَ بِٱلۡعَذَابِ وَلَن يُخۡلِفَ ٱللَّهُ وَعۡدَهُۥۚ وَإِنَّ يَوۡمًا عِندَ رَبِّكَ كَأَلۡفِ سَنَةٖ مِّمَّا تَعُدُّونَ",
    "ayah_text_no_diacratic" : "ويستعجلونك بالعذاب ولن يخلف الله وعده وان يوما عند ربك كالف سنة مما تعدون",
    "ayahnumber" : "47",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2684",
