    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4046",
    "ayah_text" : "بَلِ ٱلَّذِينَ كَفَرُواْ فِي عِزَّةٖ وَشِقَاقٖ",
    "ayah_text_no_diacratic" : "بل الذين كفروا في عزة وشقاق",
