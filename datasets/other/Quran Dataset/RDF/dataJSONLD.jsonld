    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2733",
    "ayah_text" : "ثُمَّ إِنَّكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ تُبۡعَثُونَ",
    "ayah_text_no_diacratic" : "ثم انكم يوم القيٰمة تبعثون",
    "ayahnumber" : "16",
    "chapter" : "18",
    "hizb" : "34",
