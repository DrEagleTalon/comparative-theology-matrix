  }, {
    "@id" : "quran:6019",
    "ayah_text" : "كَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ",
    "ayah_text_no_diacratic" : "كلا ان كتٰب الفجار لفي سجين",
