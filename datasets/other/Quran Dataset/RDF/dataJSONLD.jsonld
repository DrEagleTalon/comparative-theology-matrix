    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2921",
    "ayah_text" : "قَالُواْ سُبۡحَٰنَكَ مَا كَانَ يَنۢبَغِي لَنَآ أَن نَّتَّخِذَ مِن دُونِكَ مِنۡ أَوۡلِيَآءَ وَلَٰكِن مَّتَّعۡتَهُمۡ وَءَابَآءَهُمۡ حَتَّىٰ نَسُواْ ٱلذِّكۡرَ وَكَانُواْ قَوۡمَۢا بُورٗا",
    "ayah_text_no_diacratic" : "قالوا سبحٰنك ما كان ينبغي لنا ان نتخذ من دونك من اولياء ولٰكن متعتهم وءاباءهم حتىٰ نسوا الذكر وكانوا قوما بورا",
    "ayahnumber" : "18",
    "chapter" : "18",
    "hizb" : "36",
    "index" : "2921",
    "page" : "361",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2922",
    "ayah_text" : "فَقَدۡ كَذَّبُوكُم بِمَا تَقُولُونَ فَمَا تَسۡتَطِيعُونَ صَرۡفٗا وَلَا نَصۡرٗاۚ وَمَن يَظۡلِم مِّنكُمۡ نُذِقۡهُ عَذَابٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "فقد كذبوكم بما تقولون فما تستطيعون صرفا ولا نصرا ومن يظلم منكم نذقه عذابا كبيرا",
    "ayahnumber" : "19",
    "chapter" : "18",
    "hizb" : "36",
    "index" : "2922",
    "page" : "361",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2923",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَا قَبۡلَكَ مِنَ ٱلۡمُرۡسَلِينَ إِلَّآ إِنَّهُمۡ لَيَأۡكُلُونَ ٱلطَّعَامَ وَيَمۡشُونَ فِي ٱلۡأَسۡوَاقِۗ وَجَعَلۡنَا بَعۡضَكُمۡ لِبَعۡضٖ فِتۡنَةً أَتَصۡبِرُونَۗ وَكَانَ رَبُّكَ بَصِيرٗا",
    "ayah_text_no_diacratic" : "وما ارسلنا قبلك من المرسلين الا انهم لياكلون الطعام ويمشون في الاسواق وجعلنا بعضكم لبعض فتنة اتصبرون وكان ربك بصيرا",
    "ayahnumber" : "20",
    "chapter" : "18",
    "hizb" : "36",
    "index" : "2923",
    "page" : "361",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2924",
    "ayah_text" : "۞وَقَالَ ٱلَّذِينَ لَا يَرۡجُونَ لِقَآءَنَا لَوۡلَآ أُنزِلَ عَلَيۡنَا ٱلۡمَلَٰٓئِكَةُ أَوۡ نَرَىٰ رَبَّنَاۗ لَقَدِ ٱسۡتَكۡبَرُواْ فِيٓ أَنفُسِهِمۡ وَعَتَوۡ عُتُوّٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "وقال الذين لا يرجون لقاءنا لولا انزل علينا الملٰئكة او نرىٰ ربنا لقد استكبروا في انفسهم وعتو عتوا كبيرا",
    "ayahnumber" : "21",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2924",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2925",
    "ayah_text" : "يَوۡمَ يَرَوۡنَ ٱلۡمَلَٰٓئِكَةَ لَا بُشۡرَىٰ يَوۡمَئِذٖ لِّلۡمُجۡرِمِينَ وَيَقُولُونَ حِجۡرٗا مَّحۡجُورٗا",
    "ayah_text_no_diacratic" : "يوم يرون الملٰئكة لا بشرىٰ يومئذ للمجرمين ويقولون حجرا محجورا",
    "ayahnumber" : "22",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2925",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2926",
    "ayah_text" : "وَقَدِمۡنَآ إِلَىٰ مَا عَمِلُواْ مِنۡ عَمَلٖ فَجَعَلۡنَٰهُ هَبَآءٗ مَّنثُورًا",
    "ayah_text_no_diacratic" : "وقدمنا الىٰ ما عملوا من عمل فجعلنٰه هباء منثورا",
    "ayahnumber" : "23",
