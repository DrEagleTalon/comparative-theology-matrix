  }, {
    "@id" : "quran:3004",
    "ayah_text" : "وَتِلۡكَ نِعۡمَةٞ تَمُنُّهَا عَلَيَّ أَنۡ عَبَّدتَّ بَنِيٓ إِسۡرَٰٓءِيلَ",
    "ayah_text_no_diacratic" : "وتلك نعمة تمنها علي ان عبدت بني اسرٰءيل",
