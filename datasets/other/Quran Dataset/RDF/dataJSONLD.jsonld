    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1829",
    "ayah_text" : "سُورَةُ الحِجۡرِ",
    "ayah_text_no_diacratic" : "سورة الحجر",
    "ayahnumber" : "0",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1829",
