    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3034",
    "ayah_text" : "۞وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنۡ أَسۡرِ بِعِبَادِيٓ إِنَّكُم مُّتَّبَعُونَ",
    "ayah_text_no_diacratic" : "واوحينا الىٰ موسىٰ ان اسر بعبادي انكم متبعون",
