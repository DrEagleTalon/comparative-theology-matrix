    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4771",
    "ayah_text" : "إِنَّا نَحۡنُ نُحۡيِۦ وَنُمِيتُ وَإِلَيۡنَا ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "انا نحن نحي ونميت والينا المصير",
    "ayahnumber" : "43",
    "chapter" : "26",
    "hizb" : "52",
