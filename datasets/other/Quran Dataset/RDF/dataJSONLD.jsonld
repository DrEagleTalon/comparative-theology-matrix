    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4291",
    "ayah_text" : "وَلَكُمۡ فِيهَا مَنَٰفِعُ وَلِتَبۡلُغُواْ عَلَيۡهَا حَاجَةٗ فِي صُدُورِكُمۡ وَعَلَيۡهَا وَعَلَى ٱلۡفُلۡكِ تُحۡمَلُونَ",
    "ayah_text_no_diacratic" : "ولكم فيها منٰفع ولتبلغوا عليها حاجة في صدوركم وعليها وعلى الفلك تحملون",
    "ayahnumber" : "80",
