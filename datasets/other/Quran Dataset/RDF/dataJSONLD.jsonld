    "surahname" : "سُورَةُ المُجَادلَةِ",
    "surahnumber" : "58",
    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:5224",
    "ayah_text" : "يَوۡمَ يَبۡعَثُهُمُ ٱللَّهُ جَمِيعٗا فَيُنَبِّئُهُم بِمَا عَمِلُوٓاْۚ أَحۡصَىٰهُ ٱللَّهُ وَنَسُوهُۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ",
    "ayah_text_no_diacratic" : "يوم يبعثهم الله جميعا فينبئهم بما عملوا احصىٰه الله ونسوه والله علىٰ كل شيء شهيد",
    "ayahnumber" : "6",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5224",
    "page" : "542",
    "surahname" : "سُورَةُ المُجَادلَةِ",
    "surahnumber" : "58",
    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:5225",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱللَّهَ يَعۡلَمُ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۖ مَا يَكُونُ مِن نَّجۡوَىٰ ثَلَٰثَةٍ إِلَّا هُوَ رَابِعُهُمۡ وَلَا خَمۡسَةٍ إِلَّا هُوَ سَادِسُهُمۡ وَلَآ أَدۡنَىٰ مِن ذَٰلِكَ وَلَآ أَكۡثَرَ إِلَّا هُوَ مَعَهُمۡ أَيۡنَ مَا كَانُواْۖ ثُمَّ يُنَبِّئُهُم بِمَا عَمِلُواْ يَوۡمَ ٱلۡقِيَٰمَةِۚ إِنَّ ٱللَّهَ بِكُلِّ شَيۡءٍ عَلِيمٌ",
    "ayah_text_no_diacratic" : "الم تر ان الله يعلم ما في السمٰوٰت وما في الارض ما يكون من نجوىٰ ثلٰثة الا هو رابعهم ولا خمسة الا هو سادسهم ولا ادنىٰ من ذٰلك ولا اكثر الا هو معهم اين ما كانوا ثم ينبئهم بما عملوا يوم القيٰمة ان الله بكل شيء عليم",
    "ayahnumber" : "7",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5225",
    "page" : "543",
    "surahname" : "سُورَةُ المُجَادلَةِ",
    "surahnumber" : "58",
    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:5226",
    "ayah_text" : "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ نُهُواْ عَنِ ٱلنَّجۡوَىٰ ثُمَّ يَعُودُونَ لِمَا نُهُواْ عَنۡهُ وَيَتَنَٰجَوۡنَ بِٱلۡإِثۡمِ وَٱلۡعُدۡوَٰنِ وَمَعۡصِيَتِ ٱلرَّسُولِۖ وَإِذَا جَآءُوكَ حَيَّوۡكَ بِمَا لَمۡ يُحَيِّكَ بِهِ ٱللَّهُ وَيَقُولُونَ فِيٓ أَنفُسِهِمۡ لَوۡلَا يُعَذِّبُنَا ٱللَّهُ بِمَا نَقُولُۚ حَسۡبُهُمۡ جَهَنَّمُ يَصۡلَوۡنَهَاۖ فَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "الم تر الى الذين نهوا عن النجوىٰ ثم يعودون لما نهوا عنه ويتنٰجون بالاثم والعدوٰن ومعصيت الرسول واذا جاءوك حيوك بما لم يحيك به الله ويقولون في انفسهم لولا يعذبنا الله بما نقول حسبهم جهنم يصلونها فبئس المصير",
    "ayahnumber" : "8",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5226",
    "page" : "543",
    "surahname" : "سُورَةُ المُجَادلَةِ",
    "surahnumber" : "58",
    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:5227",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا تَنَٰجَيۡتُمۡ فَلَا تَتَنَٰجَوۡاْ بِٱلۡإِثۡمِ وَٱلۡعُدۡوَٰنِ وَمَعۡصِيَتِ ٱلرَّسُولِ وَتَنَٰجَوۡاْ بِٱلۡبِرِّ وَٱلتَّقۡوَىٰۖ وَٱتَّقُواْ ٱللَّهَ ٱلَّذِيٓ إِلَيۡهِ تُحۡشَرُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اذا تنٰجيتم فلا تتنٰجوا بالاثم والعدوٰن ومعصيت الرسول وتنٰجوا بالبر والتقوىٰ واتقوا الله الذي اليه تحشرون",
    "ayahnumber" : "9",
    "chapter" : "28",
