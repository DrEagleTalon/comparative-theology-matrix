    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2811",
    "ayah_text" : "رَبِّ فَلَا تَجۡعَلۡنِي فِي ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "رب فلا تجعلني في القوم الظٰلمين",
    "ayahnumber" : "94",
    "chapter" : "18",
    "hizb" : "34",
