    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1205",
    "ayah_text" : "وَإِذۡ يَمۡكُرُ بِكَ ٱلَّذِينَ كَفَرُواْ لِيُثۡبِتُوكَ أَوۡ يَقۡتُلُوكَ أَوۡ يُخۡرِجُوكَۚ وَيَمۡكُرُونَ وَيَمۡكُرُ ٱللَّهُۖ وَٱللَّهُ خَيۡرُ ٱلۡمَٰكِرِينَ",
    "ayah_text_no_diacratic" : "واذ يمكر بك الذين كفروا ليثبتوك او يقتلوك او يخرجوك ويمكرون ويمكر الله والله خير المٰكرين",
    "ayahnumber" : "30",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1205",
    "page" : "180",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1206",
    "ayah_text" : "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُنَا قَالُواْ قَدۡ سَمِعۡنَا لَوۡ نَشَآءُ لَقُلۡنَا مِثۡلَ هَٰذَآ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "واذا تتلىٰ عليهم ءايٰتنا قالوا قد سمعنا لو نشاء لقلنا مثل هٰذا ان هٰذا الا اسٰطير الاولين",
    "ayahnumber" : "31",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1206",
    "page" : "180",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1207",
    "ayah_text" : "وَإِذۡ قَالُواْ ٱللَّهُمَّ إِن كَانَ هَٰذَا هُوَ ٱلۡحَقَّ مِنۡ عِندِكَ فَأَمۡطِرۡ عَلَيۡنَا حِجَارَةٗ مِّنَ ٱلسَّمَآءِ أَوِ ٱئۡتِنَا بِعَذَابٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "واذ قالوا اللهم ان كان هٰذا هو الحق من عندك فامطر علينا حجارة من السماء او ائتنا بعذاب اليم",
    "ayahnumber" : "32",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1207",
    "page" : "180",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1208",
    "ayah_text" : "وَمَا كَانَ ٱللَّهُ لِيُعَذِّبَهُمۡ وَأَنتَ فِيهِمۡۚ وَمَا كَانَ ٱللَّهُ مُعَذِّبَهُمۡ وَهُمۡ يَسۡتَغۡفِرُونَ",
    "ayah_text_no_diacratic" : "وما كان الله ليعذبهم وانت فيهم وما كان الله معذبهم وهم يستغفرون",
    "ayahnumber" : "33",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1208",
    "page" : "180",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1209",
    "ayah_text" : "وَمَا لَهُمۡ أَلَّا يُعَذِّبَهُمُ ٱللَّهُ وَهُمۡ يَصُدُّونَ عَنِ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ وَمَا كَانُوٓاْ أَوۡلِيَآءَهُۥٓۚ إِنۡ أَوۡلِيَآؤُهُۥٓ إِلَّا ٱلۡمُتَّقُونَ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وما لهم الا يعذبهم الله وهم يصدون عن المسجد الحرام وما كانوا اولياءه ان اولياؤه الا المتقون ولٰكن اكثرهم لا يعلمون",
    "ayahnumber" : "34",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1209",
    "page" : "181",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:121",
    "ayah_text" : "وَقَالُواْ لَن يَدۡخُلَ ٱلۡجَنَّةَ إِلَّا مَن كَانَ هُودًا أَوۡ نَصَٰرَىٰۗ تِلۡكَ أَمَانِيُّهُمۡۗ قُلۡ هَاتُواْ بُرۡهَٰنَكُمۡ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "وقالوا لن يدخل الجنة الا من كان هودا او نصٰرىٰ تلك امانيهم قل هاتوا برهٰنكم ان كنتم صٰدقين",
    "ayahnumber" : "111",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "121",
    "page" : "17",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1210",
    "ayah_text" : "وَمَا كَانَ صَلَاتُهُمۡ عِندَ ٱلۡبَيۡتِ إِلَّا مُكَآءٗ وَتَصۡدِيَةٗۚ فَذُوقُواْ ٱلۡعَذَابَ بِمَا كُنتُمۡ تَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "وما كان صلاتهم عند البيت الا مكاء وتصدية فذوقوا العذاب بما كنتم تكفرون",
    "ayahnumber" : "35",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1210",
    "page" : "181",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1211",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ يُنفِقُونَ أَمۡوَٰلَهُمۡ لِيَصُدُّواْ عَن سَبِيلِ ٱللَّهِۚ فَسَيُنفِقُونَهَا ثُمَّ تَكُونُ عَلَيۡهِمۡ حَسۡرَةٗ ثُمَّ يُغۡلَبُونَۗ وَٱلَّذِينَ كَفَرُوٓاْ إِلَىٰ جَهَنَّمَ يُحۡشَرُونَ",
    "ayah_text_no_diacratic" : "ان الذين كفروا ينفقون اموٰلهم ليصدوا عن سبيل الله فسينفقونها ثم تكون عليهم حسرة ثم يغلبون والذين كفروا الىٰ جهنم يحشرون",
    "ayahnumber" : "36",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1211",
    "page" : "181",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1212",
    "ayah_text" : "لِيَمِيزَ ٱللَّهُ ٱلۡخَبِيثَ مِنَ ٱلطَّيِّبِ وَيَجۡعَلَ ٱلۡخَبِيثَ بَعۡضَهُۥ عَلَىٰ بَعۡضٖ فَيَرۡكُمَهُۥ جَمِيعٗا فَيَجۡعَلَهُۥ فِي جَهَنَّمَۚ أُوْلَٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "ليميز الله الخبيث من الطيب ويجعل الخبيث بعضه علىٰ بعض فيركمه جميعا فيجعله في جهنم اولٰئك هم الخٰسرون",
    "ayahnumber" : "37",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1212",
    "page" : "181",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1213",
    "ayah_text" : "قُل لِّلَّذِينَ كَفَرُوٓاْ إِن يَنتَهُواْ يُغۡفَرۡ لَهُم مَّا قَدۡ سَلَفَ وَإِن يَعُودُواْ فَقَدۡ مَضَتۡ سُنَّتُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "قل للذين كفروا ان ينتهوا يغفر لهم ما قد سلف وان يعودوا فقد مضت سنت الاولين",
    "ayahnumber" : "38",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1213",
    "page" : "181",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1214",
    "ayah_text" : "وَقَٰتِلُوهُمۡ حَتَّىٰ لَا تَكُونَ فِتۡنَةٞ وَيَكُونَ ٱلدِّينُ كُلُّهُۥ لِلَّهِۚ فَإِنِ ٱنتَهَوۡاْ فَإِنَّ ٱللَّهَ بِمَا يَعۡمَلُونَ بَصِيرٞ",
    "ayah_text_no_diacratic" : "وقٰتلوهم حتىٰ لا تكون فتنة ويكون الدين كله لله فان انتهوا فان الله بما يعملون بصير",
    "ayahnumber" : "39",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1214",
    "page" : "181",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1215",
    "ayah_text" : "وَإِن تَوَلَّوۡاْ فَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَوۡلَىٰكُمۡۚ نِعۡمَ ٱلۡمَوۡلَىٰ وَنِعۡمَ ٱلنَّصِيرُ",
    "ayah_text_no_diacratic" : "وان تولوا فاعلموا ان الله مولىٰكم نعم المولىٰ ونعم النصير",
    "ayahnumber" : "40",
    "chapter" : "9",
    "hizb" : "18",
    "index" : "1215",
    "page" : "181",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1216",
    "ayah_text" : "۞وَٱعۡلَمُوٓاْ أَنَّمَا غَنِمۡتُم مِّن شَيۡءٖ فَأَنَّ لِلَّهِ خُمُسَهُۥ وَلِلرَّسُولِ وَلِذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِ إِن كُنتُمۡ ءَامَنتُم بِٱللَّهِ وَمَآ أَنزَلۡنَا عَلَىٰ عَبۡدِنَا يَوۡمَ ٱلۡفُرۡقَانِ يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "ayah_text_no_diacratic" : "واعلموا انما غنمتم من شيء فان لله خمسه وللرسول ولذي القربىٰ واليتٰمىٰ والمسٰكين وابن السبيل ان كنتم ءامنتم بالله وما انزلنا علىٰ عبدنا يوم الفرقان يوم التقى الجمعان والله علىٰ كل شيء قدير",
    "ayahnumber" : "41",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1216",
    "page" : "182",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1217",
    "ayah_text" : "إِذۡ أَنتُم بِٱلۡعُدۡوَةِ ٱلدُّنۡيَا وَهُم بِٱلۡعُدۡوَةِ ٱلۡقُصۡوَىٰ وَٱلرَّكۡبُ أَسۡفَلَ مِنكُمۡۚ وَلَوۡ تَوَاعَدتُّمۡ لَٱخۡتَلَفۡتُمۡ فِي ٱلۡمِيعَٰدِ وَلَٰكِن لِّيَقۡضِيَ ٱللَّهُ أَمۡرٗا كَانَ مَفۡعُولٗا لِّيَهۡلِكَ مَنۡ هَلَكَ عَنۢ بَيِّنَةٖ وَيَحۡيَىٰ مَنۡ حَيَّ عَنۢ بَيِّنَةٖۗ وَإِنَّ ٱللَّهَ لَسَمِيعٌ عَلِيمٌ",
    "ayah_text_no_diacratic" : "اذ انتم بالعدوة الدنيا وهم بالعدوة القصوىٰ والركب اسفل منكم ولو تواعدتم لاختلفتم في الميعٰد ولٰكن ليقضي الله امرا كان مفعولا ليهلك من هلك عن بينة ويحيىٰ من حي عن بينة وان الله لسميع عليم",
    "ayahnumber" : "42",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1217",
    "page" : "182",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1218",
    "ayah_text" : "إِذۡ يُرِيكَهُمُ ٱللَّهُ فِي مَنَامِكَ قَلِيلٗاۖ وَلَوۡ أَرَىٰكَهُمۡ كَثِيرٗا لَّفَشِلۡتُمۡ وَلَتَنَٰزَعۡتُمۡ فِي ٱلۡأَمۡرِ وَلَٰكِنَّ ٱللَّهَ سَلَّمَۚ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "اذ يريكهم الله في منامك قليلا ولو ارىٰكهم كثيرا لفشلتم ولتنٰزعتم في الامر ولٰكن الله سلم انه عليم بذات الصدور",
    "ayahnumber" : "43",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1218",
    "page" : "182",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1219",
    "ayah_text" : "وَإِذۡ يُرِيكُمُوهُمۡ إِذِ ٱلۡتَقَيۡتُمۡ فِيٓ أَعۡيُنِكُمۡ قَلِيلٗا وَيُقَلِّلُكُمۡ فِيٓ أَعۡيُنِهِمۡ لِيَقۡضِيَ ٱللَّهُ أَمۡرٗا كَانَ مَفۡعُولٗاۗ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ",
    "ayah_text_no_diacratic" : "واذ يريكموهم اذ التقيتم في اعينكم قليلا ويقللكم في اعينهم ليقضي الله امرا كان مفعولا والى الله ترجع الامور",
    "ayahnumber" : "44",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1219",
    "page" : "182",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:122",
    "ayah_text" : "بَلَىٰۚ مَنۡ أَسۡلَمَ وَجۡهَهُۥ لِلَّهِ وَهُوَ مُحۡسِنٞ فَلَهُۥٓ أَجۡرُهُۥ عِندَ رَبِّهِۦ وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "بلىٰ من اسلم وجهه لله وهو محسن فله اجره عند ربه ولا خوف عليهم ولا هم يحزنون",
    "ayahnumber" : "112",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "122",
    "page" : "17",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1220",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا لَقِيتُمۡ فِئَةٗ فَٱثۡبُتُواْ وَٱذۡكُرُواْ ٱللَّهَ كَثِيرٗا لَّعَلَّكُمۡ تُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اذا لقيتم فئة فاثبتوا واذكروا الله كثيرا لعلكم تفلحون",
    "ayahnumber" : "45",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1220",
    "page" : "182",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1221",
    "ayah_text" : "وَأَطِيعُواْ ٱللَّهَ وَرَسُولَهُۥ وَلَا تَنَٰزَعُواْ فَتَفۡشَلُواْ وَتَذۡهَبَ رِيحُكُمۡۖ وَٱصۡبِرُوٓاْۚ إِنَّ ٱللَّهَ مَعَ ٱلصَّٰبِرِينَ",
    "ayah_text_no_diacratic" : "واطيعوا الله ورسوله ولا تنٰزعوا فتفشلوا وتذهب ريحكم واصبروا ان الله مع الصٰبرين",
    "ayahnumber" : "46",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1221",
    "page" : "183",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1222",
    "ayah_text" : "وَلَا تَكُونُواْ كَٱلَّذِينَ خَرَجُواْ مِن دِيَٰرِهِم بَطَرٗا وَرِئَآءَ ٱلنَّاسِ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِۚ وَٱللَّهُ بِمَا يَعۡمَلُونَ مُحِيطٞ",
    "ayah_text_no_diacratic" : "ولا تكونوا كالذين خرجوا من ديٰرهم بطرا ورئاء الناس ويصدون عن سبيل الله والله بما يعملون محيط",
    "ayahnumber" : "47",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1222",
    "page" : "183",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1223",
    "ayah_text" : "وَإِذۡ زَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ أَعۡمَٰلَهُمۡ وَقَالَ لَا غَالِبَ لَكُمُ ٱلۡيَوۡمَ مِنَ ٱلنَّاسِ وَإِنِّي جَارٞ لَّكُمۡۖ فَلَمَّا تَرَآءَتِ ٱلۡفِئَتَانِ نَكَصَ عَلَىٰ عَقِبَيۡهِ وَقَالَ إِنِّي بَرِيٓءٞ مِّنكُمۡ إِنِّيٓ أَرَىٰ مَا لَا تَرَوۡنَ إِنِّيٓ أَخَافُ ٱللَّهَۚ وَٱللَّهُ شَدِيدُ ٱلۡعِقَابِ",
    "ayah_text_no_diacratic" : "واذ زين لهم الشيطٰن اعمٰلهم وقال لا غالب لكم اليوم من الناس واني جار لكم فلما تراءت الفئتان نكص علىٰ عقبيه وقال اني بريء منكم اني ارىٰ ما لا ترون اني اخاف الله والله شديد العقاب",
    "ayahnumber" : "48",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1223",
    "page" : "183",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1224",
    "ayah_text" : "إِذۡ يَقُولُ ٱلۡمُنَٰفِقُونَ وَٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٌ غَرَّ هَٰٓؤُلَآءِ دِينُهُمۡۗ وَمَن يَتَوَكَّلۡ عَلَى ٱللَّهِ فَإِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "اذ يقول المنٰفقون والذين في قلوبهم مرض غر هٰؤلاء دينهم ومن يتوكل على الله فان الله عزيز حكيم",
    "ayahnumber" : "49",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1224",
    "page" : "183",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1225",
    "ayah_text" : "وَلَوۡ تَرَىٰٓ إِذۡ يَتَوَفَّى ٱلَّذِينَ كَفَرُواْ ٱلۡمَلَٰٓئِكَةُ يَضۡرِبُونَ وُجُوهَهُمۡ وَأَدۡبَٰرَهُمۡ وَذُوقُواْ عَذَابَ ٱلۡحَرِيقِ",
    "ayah_text_no_diacratic" : "ولو ترىٰ اذ يتوفى الذين كفروا الملٰئكة يضربون وجوههم وادبٰرهم وذوقوا عذاب الحريق",
    "ayahnumber" : "50",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1225",
    "page" : "183",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1226",
    "ayah_text" : "ذَٰلِكَ بِمَا قَدَّمَتۡ أَيۡدِيكُمۡ وَأَنَّ ٱللَّهَ لَيۡسَ بِظَلَّٰمٖ لِّلۡعَبِيدِ",
    "ayah_text_no_diacratic" : "ذٰلك بما قدمت ايديكم وان الله ليس بظلٰم للعبيد",
    "ayahnumber" : "51",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1226",
    "page" : "183",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1227",
    "ayah_text" : "كَدَأۡبِ ءَالِ فِرۡعَوۡنَ وَٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَفَرُواْ بِـَٔايَٰتِ ٱللَّهِ فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمۡۚ إِنَّ ٱللَّهَ قَوِيّٞ شَدِيدُ ٱلۡعِقَابِ",
    "ayah_text_no_diacratic" : "كداب ءال فرعون والذين من قبلهم كفروا بايٰت الله فاخذهم الله بذنوبهم ان الله قوي شديد العقاب",
    "ayahnumber" : "52",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1227",
    "page" : "183",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1228",
    "ayah_text" : "ذَٰلِكَ بِأَنَّ ٱللَّهَ لَمۡ يَكُ مُغَيِّرٗا نِّعۡمَةً أَنۡعَمَهَا عَلَىٰ قَوۡمٍ حَتَّىٰ يُغَيِّرُواْ مَا بِأَنفُسِهِمۡ وَأَنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "ذٰلك بان الله لم يك مغيرا نعمة انعمها علىٰ قوم حتىٰ يغيروا ما بانفسهم وان الله سميع عليم",
    "ayahnumber" : "53",
    "chapter" : "10",
    "hizb" : "18",
