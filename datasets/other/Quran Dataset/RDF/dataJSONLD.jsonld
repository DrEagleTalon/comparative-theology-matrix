    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5579",
    "ayah_text" : "لِّتَسۡلُكُواْ مِنۡهَا سُبُلٗا فِجَاجٗا",
    "ayah_text_no_diacratic" : "لتسلكوا منها سبلا فجاجا",
    "ayahnumber" : "20",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5579",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:558",
    "ayah_text" : "۞إِنَّ ٱللَّهَ يَأۡمُرُكُمۡ أَن تُؤَدُّواْ ٱلۡأَمَٰنَٰتِ إِلَىٰٓ أَهۡلِهَا وَإِذَا حَكَمۡتُم بَيۡنَ ٱلنَّاسِ أَن تَحۡكُمُواْ بِٱلۡعَدۡلِۚ إِنَّ ٱللَّهَ نِعِمَّا يَعِظُكُم بِهِۦٓۗ إِنَّ ٱللَّهَ كَانَ سَمِيعَۢا بَصِيرٗا",
    "ayah_text_no_diacratic" : "ان الله يامركم ان تؤدوا الامٰنٰت الىٰ اهلها واذا حكمتم بين الناس ان تحكموا بالعدل ان الله نعما يعظكم به ان الله كان سميعا بصيرا",
    "ayahnumber" : "58",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "558",
    "page" : "87",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5580",
    "ayah_text" : "قَالَ نُوحٞ رَّبِّ إِنَّهُمۡ عَصَوۡنِي وَٱتَّبَعُواْ مَن لَّمۡ يَزِدۡهُ مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا خَسَارٗا",
    "ayah_text_no_diacratic" : "قال نوح رب انهم عصوني واتبعوا من لم يزده ماله وولده الا خسارا",
    "ayahnumber" : "21",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5580",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5581",
    "ayah_text" : "وَمَكَرُواْ مَكۡرٗا كُبَّارٗا",
    "ayah_text_no_diacratic" : "ومكروا مكرا كبارا",
    "ayahnumber" : "22",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5581",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5582",
    "ayah_text" : "وَقَالُواْ لَا تَذَرُنَّ ءَالِهَتَكُمۡ وَلَا تَذَرُنَّ وَدّٗا وَلَا سُوَاعٗا وَلَا يَغُوثَ وَيَعُوقَ وَنَسۡرٗا",
    "ayah_text_no_diacratic" : "وقالوا لا تذرن ءالهتكم ولا تذرن ودا ولا سواعا ولا يغوث ويعوق ونسرا",
    "ayahnumber" : "23",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5582",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5583",
    "ayah_text" : "وَقَدۡ أَضَلُّواْ كَثِيرٗاۖ وَلَا تَزِدِ ٱلظَّٰلِمِينَ إِلَّا ضَلَٰلٗا",
    "ayah_text_no_diacratic" : "وقد اضلوا كثيرا ولا تزد الظٰلمين الا ضلٰلا",
    "ayahnumber" : "24",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5583",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5584",
    "ayah_text" : "مِّمَّا خَطِيٓـَٰٔتِهِمۡ أُغۡرِقُواْ فَأُدۡخِلُواْ نَارٗا فَلَمۡ يَجِدُواْ لَهُم مِّن دُونِ ٱللَّهِ أَنصَارٗا",
    "ayah_text_no_diacratic" : "مما خطيٰتهم اغرقوا فادخلوا نارا فلم يجدوا لهم من دون الله انصارا",
    "ayahnumber" : "25",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5584",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5585",
    "ayah_text" : "وَقَالَ نُوحٞ رَّبِّ لَا تَذَرۡ عَلَى ٱلۡأَرۡضِ مِنَ ٱلۡكَٰفِرِينَ دَيَّارًا",
    "ayah_text_no_diacratic" : "وقال نوح رب لا تذر على الارض من الكٰفرين ديارا",
    "ayahnumber" : "26",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5585",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5586",
    "ayah_text" : "إِنَّكَ إِن تَذَرۡهُمۡ يُضِلُّواْ عِبَادَكَ وَلَا يَلِدُوٓاْ إِلَّا فَاجِرٗا كَفَّارٗا",
    "ayah_text_no_diacratic" : "انك ان تذرهم يضلوا عبادك ولا يلدوا الا فاجرا كفارا",
    "ayahnumber" : "27",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5586",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5587",
    "ayah_text" : "رَّبِّ ٱغۡفِرۡ لِي وَلِوَٰلِدَيَّ وَلِمَن دَخَلَ بَيۡتِيَ مُؤۡمِنٗا وَلِلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِۖ وَلَا تَزِدِ ٱلظَّٰلِمِينَ إِلَّا تَبَارَۢا",
    "ayah_text_no_diacratic" : "رب اغفر لي ولوٰلدي ولمن دخل بيتي مؤمنا وللمؤمنين والمؤمنٰت ولا تزد الظٰلمين الا تبارا",
    "ayahnumber" : "28",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5587",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5588",
    "ayah_text" : "سُورَةُ الجِنِّ",
    "ayah_text_no_diacratic" : "سورة الجن",
    "ayahnumber" : "0",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5588",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5589",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5589",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:559",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَطِيعُواْ ٱللَّهَ وَأَطِيعُواْ ٱلرَّسُولَ وَأُوْلِي ٱلۡأَمۡرِ مِنكُمۡۖ فَإِن تَنَٰزَعۡتُمۡ فِي شَيۡءٖ فَرُدُّوهُ إِلَى ٱللَّهِ وَٱلرَّسُولِ إِن كُنتُمۡ تُؤۡمِنُونَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۚ ذَٰلِكَ خَيۡرٞ وَأَحۡسَنُ تَأۡوِيلًا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اطيعوا الله واطيعوا الرسول واولي الامر منكم فان تنٰزعتم في شيء فردوه الى الله والرسول ان كنتم تؤمنون بالله واليوم الاخر ذٰلك خير واحسن تاويلا",
    "ayahnumber" : "59",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "559",
    "page" : "87",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5590",
    "ayah_text" : "قُلۡ أُوحِيَ إِلَيَّ أَنَّهُ ٱسۡتَمَعَ نَفَرٞ مِّنَ ٱلۡجِنِّ فَقَالُوٓاْ إِنَّا سَمِعۡنَا قُرۡءَانًا عَجَبٗا",
    "ayah_text_no_diacratic" : "قل اوحي الي انه استمع نفر من الجن فقالوا انا سمعنا قرءانا عجبا",
    "ayahnumber" : "1",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5590",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5591",
    "ayah_text" : "يَهۡدِيٓ إِلَى ٱلرُّشۡدِ فَـَٔامَنَّا بِهِۦۖ وَلَن نُّشۡرِكَ بِرَبِّنَآ أَحَدٗا",
    "ayah_text_no_diacratic" : "يهدي الى الرشد فامنا به ولن نشرك بربنا احدا",
    "ayahnumber" : "2",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5591",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5592",
    "ayah_text" : "وَأَنَّهُۥ تَعَٰلَىٰ جَدُّ رَبِّنَا مَا ٱتَّخَذَ صَٰحِبَةٗ وَلَا وَلَدٗا",
    "ayah_text_no_diacratic" : "وانه تعٰلىٰ جد ربنا ما اتخذ صٰحبة ولا ولدا",
    "ayahnumber" : "3",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5592",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5593",
    "ayah_text" : "وَأَنَّهُۥ كَانَ يَقُولُ سَفِيهُنَا عَلَى ٱللَّهِ شَطَطٗا",
    "ayah_text_no_diacratic" : "وانه كان يقول سفيهنا على الله شططا",
    "ayahnumber" : "4",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5593",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5594",
    "ayah_text" : "وَأَنَّا ظَنَنَّآ أَن لَّن تَقُولَ ٱلۡإِنسُ وَٱلۡجِنُّ عَلَى ٱللَّهِ كَذِبٗا",
    "ayah_text_no_diacratic" : "وانا ظننا ان لن تقول الانس والجن على الله كذبا",
    "ayahnumber" : "5",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5594",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5595",
    "ayah_text" : "وَأَنَّهُۥ كَانَ رِجَالٞ مِّنَ ٱلۡإِنسِ يَعُوذُونَ بِرِجَالٖ مِّنَ ٱلۡجِنِّ فَزَادُوهُمۡ رَهَقٗا",
    "ayah_text_no_diacratic" : "وانه كان رجال من الانس يعوذون برجال من الجن فزادوهم رهقا",
    "ayahnumber" : "6",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5595",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5596",
    "ayah_text" : "وَأَنَّهُمۡ ظَنُّواْ كَمَا ظَنَنتُمۡ أَن لَّن يَبۡعَثَ ٱللَّهُ أَحَدٗا",
    "ayah_text_no_diacratic" : "وانهم ظنوا كما ظننتم ان لن يبعث الله احدا",
    "ayahnumber" : "7",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5596",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5597",
    "ayah_text" : "وَأَنَّا لَمَسۡنَا ٱلسَّمَآءَ فَوَجَدۡنَٰهَا مُلِئَتۡ حَرَسٗا شَدِيدٗا وَشُهُبٗا",
    "ayah_text_no_diacratic" : "وانا لمسنا السماء فوجدنٰها ملئت حرسا شديدا وشهبا",
    "ayahnumber" : "8",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5597",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5598",
    "ayah_text" : "وَأَنَّا كُنَّا نَقۡعُدُ مِنۡهَا مَقَٰعِدَ لِلسَّمۡعِۖ فَمَن يَسۡتَمِعِ ٱلۡأٓنَ يَجِدۡ لَهُۥ شِهَابٗا رَّصَدٗا",
    "ayah_text_no_diacratic" : "وانا كنا نقعد منها مقٰعد للسمع فمن يستمع الان يجد له شهابا رصدا",
    "ayahnumber" : "9",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5598",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5599",
    "ayah_text" : "وَأَنَّا لَا نَدۡرِيٓ أَشَرٌّ أُرِيدَ بِمَن فِي ٱلۡأَرۡضِ أَمۡ أَرَادَ بِهِمۡ رَبُّهُمۡ رَشَدٗا",
    "ayah_text_no_diacratic" : "وانا لا ندري اشر اريد بمن في الارض ام اراد بهم ربهم رشدا",
    "ayahnumber" : "10",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5599",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:56",
    "ayah_text" : "ٱلَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَٰقُواْ رَبِّهِمۡ وَأَنَّهُمۡ إِلَيۡهِ رَٰجِعُونَ",
    "ayah_text_no_diacratic" : "الذين يظنون انهم ملٰقوا ربهم وانهم اليه رٰجعون",
    "ayahnumber" : "46",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "56",
    "page" : "7",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:560",
    "ayah_text" : "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ يَزۡعُمُونَ أَنَّهُمۡ ءَامَنُواْ بِمَآ أُنزِلَ إِلَيۡكَ وَمَآ أُنزِلَ مِن قَبۡلِكَ يُرِيدُونَ أَن يَتَحَاكَمُوٓاْ إِلَى ٱلطَّٰغُوتِ وَقَدۡ أُمِرُوٓاْ أَن يَكۡفُرُواْ بِهِۦۖ وَيُرِيدُ ٱلشَّيۡطَٰنُ أَن يُضِلَّهُمۡ ضَلَٰلَۢا بَعِيدٗا",
    "ayah_text_no_diacratic" : "الم تر الى الذين يزعمون انهم ءامنوا بما انزل اليك وما انزل من قبلك يريدون ان يتحاكموا الى الطٰغوت وقد امروا ان يكفروا به ويريد الشيطٰن ان يضلهم ضلٰلا بعيدا",
    "ayahnumber" : "60",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "560",
    "page" : "88",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5600",
    "ayah_text" : "وَأَنَّا مِنَّا ٱلصَّٰلِحُونَ وَمِنَّا دُونَ ذَٰلِكَۖ كُنَّا طَرَآئِقَ قِدَدٗا",
    "ayah_text_no_diacratic" : "وانا منا الصٰلحون ومنا دون ذٰلك كنا طرائق قددا",
    "ayahnumber" : "11",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5600",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5601",
    "ayah_text" : "وَأَنَّا ظَنَنَّآ أَن لَّن نُّعۡجِزَ ٱللَّهَ فِي ٱلۡأَرۡضِ وَلَن نُّعۡجِزَهُۥ هَرَبٗا",
    "ayah_text_no_diacratic" : "وانا ظننا ان لن نعجز الله في الارض ولن نعجزه هربا",
    "ayahnumber" : "12",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5601",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5602",
    "ayah_text" : "وَأَنَّا لَمَّا سَمِعۡنَا ٱلۡهُدَىٰٓ ءَامَنَّا بِهِۦۖ فَمَن يُؤۡمِنۢ بِرَبِّهِۦ فَلَا يَخَافُ بَخۡسٗا وَلَا رَهَقٗا",
    "ayah_text_no_diacratic" : "وانا لما سمعنا الهدىٰ ءامنا به فمن يؤمن بربه فلا يخاف بخسا ولا رهقا",
    "ayahnumber" : "13",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5602",
    "page" : "572",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5603",
    "ayah_text" : "وَأَنَّا مِنَّا ٱلۡمُسۡلِمُونَ وَمِنَّا ٱلۡقَٰسِطُونَۖ فَمَنۡ أَسۡلَمَ فَأُوْلَٰٓئِكَ تَحَرَّوۡاْ رَشَدٗا",
    "ayah_text_no_diacratic" : "وانا منا المسلمون ومنا القٰسطون فمن اسلم فاولٰئك تحروا رشدا",
    "ayahnumber" : "14",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5603",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5604",
    "ayah_text" : "وَأَمَّا ٱلۡقَٰسِطُونَ فَكَانُواْ لِجَهَنَّمَ حَطَبٗا",
    "ayah_text_no_diacratic" : "واما القٰسطون فكانوا لجهنم حطبا",
    "ayahnumber" : "15",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5604",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5605",
    "ayah_text" : "وَأَلَّوِ ٱسۡتَقَٰمُواْ عَلَى ٱلطَّرِيقَةِ لَأَسۡقَيۡنَٰهُم مَّآءً غَدَقٗا",
    "ayah_text_no_diacratic" : "والو استقٰموا على الطريقة لاسقينٰهم ماء غدقا",
    "ayahnumber" : "16",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5605",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5606",
    "ayah_text" : "لِّنَفۡتِنَهُمۡ فِيهِۚ وَمَن يُعۡرِضۡ عَن ذِكۡرِ رَبِّهِۦ يَسۡلُكۡهُ عَذَابٗا صَعَدٗا",
    "ayah_text_no_diacratic" : "لنفتنهم فيه ومن يعرض عن ذكر ربه يسلكه عذابا صعدا",
    "ayahnumber" : "17",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5606",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5607",
    "ayah_text" : "وَأَنَّ ٱلۡمَسَٰجِدَ لِلَّهِ فَلَا تَدۡعُواْ مَعَ ٱللَّهِ أَحَدٗا",
    "ayah_text_no_diacratic" : "وان المسٰجد لله فلا تدعوا مع الله احدا",
    "ayahnumber" : "18",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5607",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5608",
    "ayah_text" : "وَأَنَّهُۥ لَمَّا قَامَ عَبۡدُ ٱللَّهِ يَدۡعُوهُ كَادُواْ يَكُونُونَ عَلَيۡهِ لِبَدٗا",
    "ayah_text_no_diacratic" : "وانه لما قام عبد الله يدعوه كادوا يكونون عليه لبدا",
    "ayahnumber" : "19",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5608",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5609",
    "ayah_text" : "قُلۡ إِنَّمَآ أَدۡعُواْ رَبِّي وَلَآ أُشۡرِكُ بِهِۦٓ أَحَدٗا",
    "ayah_text_no_diacratic" : "قل انما ادعوا ربي ولا اشرك به احدا",
    "ayahnumber" : "20",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5609",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:561",
    "ayah_text" : "وَإِذَا قِيلَ لَهُمۡ تَعَالَوۡاْ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ رَأَيۡتَ ٱلۡمُنَٰفِقِينَ يَصُدُّونَ عَنكَ صُدُودٗا",
    "ayah_text_no_diacratic" : "واذا قيل لهم تعالوا الىٰ ما انزل الله والى الرسول رايت المنٰفقين يصدون عنك صدودا",
    "ayahnumber" : "61",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "561",
    "page" : "88",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5610",
    "ayah_text" : "قُلۡ إِنِّي لَآ أَمۡلِكُ لَكُمۡ ضَرّٗا وَلَا رَشَدٗا",
    "ayah_text_no_diacratic" : "قل اني لا املك لكم ضرا ولا رشدا",
    "ayahnumber" : "21",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5610",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5611",
    "ayah_text" : "قُلۡ إِنِّي لَن يُجِيرَنِي مِنَ ٱللَّهِ أَحَدٞ وَلَنۡ أَجِدَ مِن دُونِهِۦ مُلۡتَحَدًا",
    "ayah_text_no_diacratic" : "قل اني لن يجيرني من الله احد ولن اجد من دونه ملتحدا",
    "ayahnumber" : "22",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5611",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5612",
    "ayah_text" : "إِلَّا بَلَٰغٗا مِّنَ ٱللَّهِ وَرِسَٰلَٰتِهِۦۚ وَمَن يَعۡصِ ٱللَّهَ وَرَسُولَهُۥ فَإِنَّ لَهُۥ نَارَ جَهَنَّمَ خَٰلِدِينَ فِيهَآ أَبَدًا",
    "ayah_text_no_diacratic" : "الا بلٰغا من الله ورسٰلٰته ومن يعص الله ورسوله فان له نار جهنم خٰلدين فيها ابدا",
    "ayahnumber" : "23",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5612",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5613",
    "ayah_text" : "حَتَّىٰٓ إِذَا رَأَوۡاْ مَا يُوعَدُونَ فَسَيَعۡلَمُونَ مَنۡ أَضۡعَفُ نَاصِرٗا وَأَقَلُّ عَدَدٗا",
    "ayah_text_no_diacratic" : "حتىٰ اذا راوا ما يوعدون فسيعلمون من اضعف ناصرا واقل عددا",
    "ayahnumber" : "24",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5613",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5614",
    "ayah_text" : "قُلۡ إِنۡ أَدۡرِيٓ أَقَرِيبٞ مَّا تُوعَدُونَ أَمۡ يَجۡعَلُ لَهُۥ رَبِّيٓ أَمَدًا",
    "ayah_text_no_diacratic" : "قل ان ادري اقريب ما توعدون ام يجعل له ربي امدا",
    "ayahnumber" : "25",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5614",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5615",
    "ayah_text" : "عَٰلِمُ ٱلۡغَيۡبِ فَلَا يُظۡهِرُ عَلَىٰ غَيۡبِهِۦٓ أَحَدًا",
    "ayah_text_no_diacratic" : "عٰلم الغيب فلا يظهر علىٰ غيبه احدا",
    "ayahnumber" : "26",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5615",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5616",
    "ayah_text" : "إِلَّا مَنِ ٱرۡتَضَىٰ مِن رَّسُولٖ فَإِنَّهُۥ يَسۡلُكُ مِنۢ بَيۡنِ يَدَيۡهِ وَمِنۡ خَلۡفِهِۦ رَصَدٗا",
    "ayah_text_no_diacratic" : "الا من ارتضىٰ من رسول فانه يسلك من بين يديه ومن خلفه رصدا",
    "ayahnumber" : "27",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5616",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5617",
    "ayah_text" : "لِّيَعۡلَمَ أَن قَدۡ أَبۡلَغُواْ رِسَٰلَٰتِ رَبِّهِمۡ وَأَحَاطَ بِمَا لَدَيۡهِمۡ وَأَحۡصَىٰ كُلَّ شَيۡءٍ عَدَدَۢا",
    "ayah_text_no_diacratic" : "ليعلم ان قد ابلغوا رسٰلٰت ربهم واحاط بما لديهم واحصىٰ كل شيء عددا",
    "ayahnumber" : "28",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5617",
    "page" : "573",
    "surahname" : "سُورَةُ الجِنِّ",
    "surahnumber" : "72",
    "surrahname_no_diacratic" : "سورة الجن"
  }, {
    "@id" : "quran:5618",
    "ayah_text" : "سُورَةُ المُزَّمِّلِ",
    "ayah_text_no_diacratic" : "سورة المزمل",
