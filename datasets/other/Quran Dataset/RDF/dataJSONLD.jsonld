    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3098",
    "ayah_text" : "قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلۡمَرۡجُومِينَ",
    "ayah_text_no_diacratic" : "قالوا لئن لم تنته يٰنوح لتكونن من المرجومين",
