    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:833",
    "ayah_text" : "قَدۡ نَعۡلَمُ إِنَّهُۥ لَيَحۡزُنُكَ ٱلَّذِي يَقُولُونَۖ فَإِنَّهُمۡ لَا يُكَذِّبُونَكَ وَلَٰكِنَّ ٱلظَّٰلِمِينَ بِـَٔايَٰتِ ٱللَّهِ يَجۡحَدُونَ",
    "ayah_text_no_diacratic" : "قد نعلم انه ليحزنك الذي يقولون فانهم لا يكذبونك ولٰكن الظٰلمين بايٰت الله يجحدون",
    "ayahnumber" : "33",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "833",
    "page" : "131",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:834",
    "ayah_text" : "وَلَقَدۡ كُذِّبَتۡ رُسُلٞ مِّن قَبۡلِكَ فَصَبَرُواْ عَلَىٰ مَا كُذِّبُواْ وَأُوذُواْ حَتَّىٰٓ أَتَىٰهُمۡ نَصۡرُنَاۚ وَلَا مُبَدِّلَ لِكَلِمَٰتِ ٱللَّهِۚ وَلَقَدۡ جَآءَكَ مِن نَّبَإِيْ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "ولقد كذبت رسل من قبلك فصبروا علىٰ ما كذبوا واوذوا حتىٰ اتىٰهم نصرنا ولا مبدل لكلمٰت الله ولقد جاءك من نباي المرسلين",
    "ayahnumber" : "34",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "834",
    "page" : "131",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:835",
    "ayah_text" : "وَإِن كَانَ كَبُرَ عَلَيۡكَ إِعۡرَاضُهُمۡ فَإِنِ ٱسۡتَطَعۡتَ أَن تَبۡتَغِيَ نَفَقٗا فِي ٱلۡأَرۡضِ أَوۡ سُلَّمٗا فِي ٱلسَّمَآءِ فَتَأۡتِيَهُم بِـَٔايَةٖۚ وَلَوۡ شَآءَ ٱللَّهُ لَجَمَعَهُمۡ عَلَى ٱلۡهُدَىٰۚ فَلَا تَكُونَنَّ مِنَ ٱلۡجَٰهِلِينَ",
    "ayah_text_no_diacratic" : "وان كان كبر عليك اعراضهم فان استطعت ان تبتغي نفقا في الارض او سلما في السماء فتاتيهم باية ولو شاء الله لجمعهم على الهدىٰ فلا تكونن من الجٰهلين",
    "ayahnumber" : "35",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "835",
    "page" : "131",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:836",
    "ayah_text" : "۞إِنَّمَا يَسۡتَجِيبُ ٱلَّذِينَ يَسۡمَعُونَۘ وَٱلۡمَوۡتَىٰ يَبۡعَثُهُمُ ٱللَّهُ ثُمَّ إِلَيۡهِ يُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "انما يستجيب الذين يسمعون والموتىٰ يبعثهم الله ثم اليه يرجعون",
    "ayahnumber" : "36",
    "chapter" : "7",
