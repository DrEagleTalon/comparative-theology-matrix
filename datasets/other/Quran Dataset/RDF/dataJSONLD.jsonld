    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3607",
    "ayah_text" : "إِذۡ جَآءُوكُم مِّن فَوۡقِكُمۡ وَمِنۡ أَسۡفَلَ مِنكُمۡ وَإِذۡ زَاغَتِ ٱلۡأَبۡصَٰرُ وَبَلَغَتِ ٱلۡقُلُوبُ ٱلۡحَنَاجِرَ وَتَظُنُّونَ بِٱللَّهِ ٱلظُّنُونَا۠",
    "ayah_text_no_diacratic" : "اذ جاءوكم من فوقكم ومن اسفل منكم واذ زاغت الابصٰر وبلغت القلوب الحناجر وتظنون بالله الظنونا",
    "ayahnumber" : "10",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3607",
    "page" : "419",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3608",
    "ayah_text" : "هُنَالِكَ ٱبۡتُلِيَ ٱلۡمُؤۡمِنُونَ وَزُلۡزِلُواْ زِلۡزَالٗا شَدِيدٗا",
    "ayah_text_no_diacratic" : "هنالك ابتلي المؤمنون وزلزلوا زلزالا شديدا",
    "ayahnumber" : "11",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3608",
    "page" : "419",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3609",
    "ayah_text" : "وَإِذۡ يَقُولُ ٱلۡمُنَٰفِقُونَ وَٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ مَّا وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥٓ إِلَّا غُرُورٗا",
    "ayah_text_no_diacratic" : "واذ يقول المنٰفقون والذين في قلوبهم مرض ما وعدنا الله ورسوله الا غرورا",
    "ayahnumber" : "12",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3609",
    "page" : "419",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:361",
    "ayah_text" : "فَإِن تَوَلَّوۡاْ فَإِنَّ ٱللَّهَ عَلِيمُۢ بِٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "فان تولوا فان الله عليم بالمفسدين",
    "ayahnumber" : "63",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "361",
    "page" : "58",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3610",
    "ayah_text" : "وَإِذۡ قَالَت طَّآئِفَةٞ مِّنۡهُمۡ يَٰٓأَهۡلَ يَثۡرِبَ لَا مُقَامَ لَكُمۡ فَٱرۡجِعُواْۚ وَيَسۡتَـٔۡذِنُ فَرِيقٞ مِّنۡهُمُ ٱلنَّبِيَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوۡرَةٞ وَمَا هِيَ بِعَوۡرَةٍۖ إِن يُرِيدُونَ إِلَّا فِرَارٗا",
    "ayah_text_no_diacratic" : "واذ قالت طائفة منهم يٰاهل يثرب لا مقام لكم فارجعوا ويستذن فريق منهم النبي يقولون ان بيوتنا عورة وما هي بعورة ان يريدون الا فرارا",
    "ayahnumber" : "13",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3610",
    "page" : "419",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3611",
    "ayah_text" : "وَلَوۡ دُخِلَتۡ عَلَيۡهِم مِّنۡ أَقۡطَارِهَا ثُمَّ سُئِلُواْ ٱلۡفِتۡنَةَ لَأٓتَوۡهَا وَمَا تَلَبَّثُواْ بِهَآ إِلَّا يَسِيرٗا",
    "ayah_text_no_diacratic" : "ولو دخلت عليهم من اقطارها ثم سئلوا الفتنة لاتوها وما تلبثوا بها الا يسيرا",
    "ayahnumber" : "14",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3611",
    "page" : "419",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3612",
    "ayah_text" : "وَلَقَدۡ كَانُواْ عَٰهَدُواْ ٱللَّهَ مِن قَبۡلُ لَا يُوَلُّونَ ٱلۡأَدۡبَٰرَۚ وَكَانَ عَهۡدُ ٱللَّهِ مَسۡـُٔولٗا",
    "ayah_text_no_diacratic" : "ولقد كانوا عٰهدوا الله من قبل لا يولون الادبٰر وكان عهد الله مسولا",
    "ayahnumber" : "15",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3612",
    "page" : "419",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3613",
    "ayah_text" : "قُل لَّن يَنفَعَكُمُ ٱلۡفِرَارُ إِن فَرَرۡتُم مِّنَ ٱلۡمَوۡتِ أَوِ ٱلۡقَتۡلِ وَإِذٗا لَّا تُمَتَّعُونَ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "قل لن ينفعكم الفرار ان فررتم من الموت او القتل واذا لا تمتعون الا قليلا",
    "ayahnumber" : "16",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3613",
    "page" : "420",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3614",
    "ayah_text" : "قُلۡ مَن ذَا ٱلَّذِي يَعۡصِمُكُم مِّنَ ٱللَّهِ إِنۡ أَرَادَ بِكُمۡ سُوٓءًا أَوۡ أَرَادَ بِكُمۡ رَحۡمَةٗۚ وَلَا يَجِدُونَ لَهُم مِّن دُونِ ٱللَّهِ وَلِيّٗا وَلَا نَصِيرٗا",
    "ayah_text_no_diacratic" : "قل من ذا الذي يعصمكم من الله ان اراد بكم سوءا او اراد بكم رحمة ولا يجدون لهم من دون الله وليا ولا نصيرا",
    "ayahnumber" : "17",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3614",
    "page" : "420",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3615",
    "ayah_text" : "۞قَدۡ يَعۡلَمُ ٱللَّهُ ٱلۡمُعَوِّقِينَ مِنكُمۡ وَٱلۡقَآئِلِينَ لِإِخۡوَٰنِهِمۡ هَلُمَّ إِلَيۡنَاۖ وَلَا يَأۡتُونَ ٱلۡبَأۡسَ إِلَّا قَلِيلًا",
    "ayah_text_no_diacratic" : "قد يعلم الله المعوقين منكم والقائلين لاخوٰنهم هلم الينا ولا ياتون الباس الا قليلا",
    "ayahnumber" : "18",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3615",
    "page" : "420",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3616",
    "ayah_text" : "أَشِحَّةً عَلَيۡكُمۡۖ فَإِذَا جَآءَ ٱلۡخَوۡفُ رَأَيۡتَهُمۡ يَنظُرُونَ إِلَيۡكَ تَدُورُ أَعۡيُنُهُمۡ كَٱلَّذِي يُغۡشَىٰ عَلَيۡهِ مِنَ ٱلۡمَوۡتِۖ فَإِذَا ذَهَبَ ٱلۡخَوۡفُ سَلَقُوكُم بِأَلۡسِنَةٍ حِدَادٍ أَشِحَّةً عَلَى ٱلۡخَيۡرِۚ أُوْلَٰٓئِكَ لَمۡ يُؤۡمِنُواْ فَأَحۡبَطَ ٱللَّهُ أَعۡمَٰلَهُمۡۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٗا",
    "ayah_text_no_diacratic" : "اشحة عليكم فاذا جاء الخوف رايتهم ينظرون اليك تدور اعينهم كالذي يغشىٰ عليه من الموت فاذا ذهب الخوف سلقوكم بالسنة حداد اشحة على الخير اولٰئك لم يؤمنوا فاحبط الله اعمٰلهم وكان ذٰلك على الله يسيرا",
    "ayahnumber" : "19",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3616",
    "page" : "420",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3617",
    "ayah_text" : "يَحۡسَبُونَ ٱلۡأَحۡزَابَ لَمۡ يَذۡهَبُواْۖ وَإِن يَأۡتِ ٱلۡأَحۡزَابُ يَوَدُّواْ لَوۡ أَنَّهُم بَادُونَ فِي ٱلۡأَعۡرَابِ يَسۡـَٔلُونَ عَنۡ أَنۢبَآئِكُمۡۖ وَلَوۡ كَانُواْ فِيكُم مَّا قَٰتَلُوٓاْ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "يحسبون الاحزاب لم يذهبوا وان يات الاحزاب يودوا لو انهم بادون في الاعراب يسلون عن انبائكم ولو كانوا فيكم ما قٰتلوا الا قليلا",
    "ayahnumber" : "20",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3617",
    "page" : "420",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3618",
    "ayah_text" : "لَّقَدۡ كَانَ لَكُمۡ فِي رَسُولِ ٱللَّهِ أُسۡوَةٌ حَسَنَةٞ لِّمَن كَانَ يَرۡجُواْ ٱللَّهَ وَٱلۡيَوۡمَ ٱلۡأٓخِرَ وَذَكَرَ ٱللَّهَ كَثِيرٗا",
    "ayah_text_no_diacratic" : "لقد كان لكم في رسول الله اسوة حسنة لمن كان يرجوا الله واليوم الاخر وذكر الله كثيرا",
    "ayahnumber" : "21",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3618",
    "page" : "420",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3619",
    "ayah_text" : "وَلَمَّا رَءَا ٱلۡمُؤۡمِنُونَ ٱلۡأَحۡزَابَ قَالُواْ هَٰذَا مَا وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥ وَصَدَقَ ٱللَّهُ وَرَسُولُهُۥۚ وَمَا زَادَهُمۡ إِلَّآ إِيمَٰنٗا وَتَسۡلِيمٗا",
    "ayah_text_no_diacratic" : "ولما رءا المؤمنون الاحزاب قالوا هٰذا ما وعدنا الله ورسوله وصدق الله ورسوله وما زادهم الا ايمٰنا وتسليما",
    "ayahnumber" : "22",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3619",
    "page" : "420",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:362",
    "ayah_text" : "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ تَعَالَوۡاْ إِلَىٰ كَلِمَةٖ سَوَآءِۭ بَيۡنَنَا وَبَيۡنَكُمۡ أَلَّا نَعۡبُدَ إِلَّا ٱللَّهَ وَلَا نُشۡرِكَ بِهِۦ شَيۡـٔٗا وَلَا يَتَّخِذَ بَعۡضُنَا بَعۡضًا أَرۡبَابٗا مِّن دُونِ ٱللَّهِۚ فَإِن تَوَلَّوۡاْ فَقُولُواْ ٱشۡهَدُواْ بِأَنَّا مُسۡلِمُونَ",
    "ayah_text_no_diacratic" : "قل يٰاهل الكتٰب تعالوا الىٰ كلمة سواء بيننا وبينكم الا نعبد الا الله ولا نشرك به شيا ولا يتخذ بعضنا بعضا اربابا من دون الله فان تولوا فقولوا اشهدوا بانا مسلمون",
    "ayahnumber" : "64",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "362",
    "page" : "58",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3620",
    "ayah_text" : "مِّنَ ٱلۡمُؤۡمِنِينَ رِجَالٞ صَدَقُواْ مَا عَٰهَدُواْ ٱللَّهَ عَلَيۡهِۖ فَمِنۡهُم مَّن قَضَىٰ نَحۡبَهُۥ وَمِنۡهُم مَّن يَنتَظِرُۖ وَمَا بَدَّلُواْ تَبۡدِيلٗا",
    "ayah_text_no_diacratic" : "من المؤمنين رجال صدقوا ما عٰهدوا الله عليه فمنهم من قضىٰ نحبه ومنهم من ينتظر وما بدلوا تبديلا",
    "ayahnumber" : "23",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3620",
    "page" : "421",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3621",
    "ayah_text" : "لِّيَجۡزِيَ ٱللَّهُ ٱلصَّٰدِقِينَ بِصِدۡقِهِمۡ وَيُعَذِّبَ ٱلۡمُنَٰفِقِينَ إِن شَآءَ أَوۡ يَتُوبَ عَلَيۡهِمۡۚ إِنَّ ٱللَّهَ كَانَ غَفُورٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "ليجزي الله الصٰدقين بصدقهم ويعذب المنٰفقين ان شاء او يتوب عليهم ان الله كان غفورا رحيما",
    "ayahnumber" : "24",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3621",
    "page" : "421",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3622",
    "ayah_text" : "وَرَدَّ ٱللَّهُ ٱلَّذِينَ كَفَرُواْ بِغَيۡظِهِمۡ لَمۡ يَنَالُواْ خَيۡرٗاۚ وَكَفَى ٱللَّهُ ٱلۡمُؤۡمِنِينَ ٱلۡقِتَالَۚ وَكَانَ ٱللَّهُ قَوِيًّا عَزِيزٗا",
    "ayah_text_no_diacratic" : "ورد الله الذين كفروا بغيظهم لم ينالوا خيرا وكفى الله المؤمنين القتال وكان الله قويا عزيزا",
    "ayahnumber" : "25",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3622",
    "page" : "421",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3623",
    "ayah_text" : "وَأَنزَلَ ٱلَّذِينَ ظَٰهَرُوهُم مِّنۡ أَهۡلِ ٱلۡكِتَٰبِ مِن صَيَاصِيهِمۡ وَقَذَفَ فِي قُلُوبِهِمُ ٱلرُّعۡبَ فَرِيقٗا تَقۡتُلُونَ وَتَأۡسِرُونَ فَرِيقٗا",
    "ayah_text_no_diacratic" : "وانزل الذين ظٰهروهم من اهل الكتٰب من صياصيهم وقذف في قلوبهم الرعب فريقا تقتلون وتاسرون فريقا",
    "ayahnumber" : "26",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3623",
    "page" : "421",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3624",
    "ayah_text" : "وَأَوۡرَثَكُمۡ أَرۡضَهُمۡ وَدِيَٰرَهُمۡ وَأَمۡوَٰلَهُمۡ وَأَرۡضٗا لَّمۡ تَطَـُٔوهَاۚ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٗا",
    "ayah_text_no_diacratic" : "واورثكم ارضهم وديٰرهم واموٰلهم وارضا لم تطوها وكان الله علىٰ كل شيء قديرا",
    "ayahnumber" : "27",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3624",
    "page" : "421",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3625",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ قُل لِّأَزۡوَٰجِكَ إِن كُنتُنَّ تُرِدۡنَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا وَزِينَتَهَا فَتَعَالَيۡنَ أُمَتِّعۡكُنَّ وَأُسَرِّحۡكُنَّ سَرَاحٗا جَمِيلٗا",
    "ayah_text_no_diacratic" : "يٰايها النبي قل لازوٰجك ان كنتن تردن الحيوٰة الدنيا وزينتها فتعالين امتعكن واسرحكن سراحا جميلا",
    "ayahnumber" : "28",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3625",
    "page" : "421",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3626",
    "ayah_text" : "وَإِن كُنتُنَّ تُرِدۡنَ ٱللَّهَ وَرَسُولَهُۥ وَٱلدَّارَ ٱلۡأٓخِرَةَ فَإِنَّ ٱللَّهَ أَعَدَّ لِلۡمُحۡسِنَٰتِ مِنكُنَّ أَجۡرًا عَظِيمٗا",
    "ayah_text_no_diacratic" : "وان كنتن تردن الله ورسوله والدار الاخرة فان الله اعد للمحسنٰت منكن اجرا عظيما",
    "ayahnumber" : "29",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3626",
    "page" : "421",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3627",
    "ayah_text" : "يَٰنِسَآءَ ٱلنَّبِيِّ مَن يَأۡتِ مِنكُنَّ بِفَٰحِشَةٖ مُّبَيِّنَةٖ يُضَٰعَفۡ لَهَا ٱلۡعَذَابُ ضِعۡفَيۡنِۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٗا",
    "ayah_text_no_diacratic" : "يٰنساء النبي من يات منكن بفٰحشة مبينة يضٰعف لها العذاب ضعفين وكان ذٰلك على الله يسيرا",
    "ayahnumber" : "30",
    "chapter" : "21",
    "hizb" : "42",
    "index" : "3627",
    "page" : "421",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3628",
    "ayah_text" : "۞وَمَن يَقۡنُتۡ مِنكُنَّ لِلَّهِ وَرَسُولِهِۦ وَتَعۡمَلۡ صَٰلِحٗا نُّؤۡتِهَآ أَجۡرَهَا مَرَّتَيۡنِ وَأَعۡتَدۡنَا لَهَا رِزۡقٗا كَرِيمٗا",
    "ayah_text_no_diacratic" : "ومن يقنت منكن لله ورسوله وتعمل صٰلحا نؤتها اجرها مرتين واعتدنا لها رزقا كريما",
    "ayahnumber" : "31",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3628",
    "page" : "422",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3629",
    "ayah_text" : "يَٰنِسَآءَ ٱلنَّبِيِّ لَسۡتُنَّ كَأَحَدٖ مِّنَ ٱلنِّسَآءِ إِنِ ٱتَّقَيۡتُنَّۚ فَلَا تَخۡضَعۡنَ بِٱلۡقَوۡلِ فَيَطۡمَعَ ٱلَّذِي فِي قَلۡبِهِۦ مَرَضٞ وَقُلۡنَ قَوۡلٗا مَّعۡرُوفٗا",
    "ayah_text_no_diacratic" : "يٰنساء النبي لستن كاحد من النساء ان اتقيتن فلا تخضعن بالقول فيطمع الذي في قلبه مرض وقلن قولا معروفا",
    "ayahnumber" : "32",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3629",
    "page" : "422",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:363",
    "ayah_text" : "يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لِمَ تُحَآجُّونَ فِيٓ إِبۡرَٰهِيمَ وَمَآ أُنزِلَتِ ٱلتَّوۡرَىٰةُ وَٱلۡإِنجِيلُ إِلَّا مِنۢ بَعۡدِهِۦٓۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "يٰاهل الكتٰب لم تحاجون في ابرٰهيم وما انزلت التورىٰة والانجيل الا من بعده افلا تعقلون",
    "ayahnumber" : "65",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "363",
    "page" : "58",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3630",
    "ayah_text" : "وَقَرۡنَ فِي بُيُوتِكُنَّ وَلَا تَبَرَّجۡنَ تَبَرُّجَ ٱلۡجَٰهِلِيَّةِ ٱلۡأُولَىٰۖ وَأَقِمۡنَ ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعۡنَ ٱللَّهَ وَرَسُولَهُۥٓۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُذۡهِبَ عَنكُمُ ٱلرِّجۡسَ أَهۡلَ ٱلۡبَيۡتِ وَيُطَهِّرَكُمۡ تَطۡهِيرٗا",
    "ayah_text_no_diacratic" : "وقرن في بيوتكن ولا تبرجن تبرج الجٰهلية الاولىٰ واقمن الصلوٰة وءاتين الزكوٰة واطعن الله ورسوله انما يريد الله ليذهب عنكم الرجس اهل البيت ويطهركم تطهيرا",
    "ayahnumber" : "33",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3630",
    "page" : "422",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3631",
    "ayah_text" : "وَٱذۡكُرۡنَ مَا يُتۡلَىٰ فِي بُيُوتِكُنَّ مِنۡ ءَايَٰتِ ٱللَّهِ وَٱلۡحِكۡمَةِۚ إِنَّ ٱللَّهَ كَانَ لَطِيفًا خَبِيرًا",
    "ayah_text_no_diacratic" : "واذكرن ما يتلىٰ في بيوتكن من ءايٰت الله والحكمة ان الله كان لطيفا خبيرا",
    "ayahnumber" : "34",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3631",
    "page" : "422",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3632",
    "ayah_text" : "إِنَّ ٱلۡمُسۡلِمِينَ وَٱلۡمُسۡلِمَٰتِ وَٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ وَٱلۡقَٰنِتِينَ وَٱلۡقَٰنِتَٰتِ وَٱلصَّٰدِقِينَ وَٱلصَّٰدِقَٰتِ وَٱلصَّٰبِرِينَ وَٱلصَّٰبِرَٰتِ وَٱلۡخَٰشِعِينَ وَٱلۡخَٰشِعَٰتِ وَٱلۡمُتَصَدِّقِينَ وَٱلۡمُتَصَدِّقَٰتِ وَٱلصَّٰٓئِمِينَ وَٱلصَّٰٓئِمَٰتِ وَٱلۡحَٰفِظِينَ فُرُوجَهُمۡ وَٱلۡحَٰفِظَٰتِ وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرٗا وَٱلذَّٰكِرَٰتِ أَعَدَّ ٱللَّهُ لَهُم مَّغۡفِرَةٗ وَأَجۡرًا عَظِيمٗا",
    "ayah_text_no_diacratic" : "ان المسلمين والمسلمٰت والمؤمنين والمؤمنٰت والقٰنتين والقٰنتٰت والصٰدقين والصٰدقٰت والصٰبرين والصٰبرٰت والخٰشعين والخٰشعٰت والمتصدقين والمتصدقٰت والصٰئمين والصٰئمٰت والحٰفظين فروجهم والحٰفظٰت والذٰكرين الله كثيرا والذٰكرٰت اعد الله لهم مغفرة واجرا عظيما",
    "ayahnumber" : "35",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3632",
    "page" : "422",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3633",
    "ayah_text" : "وَمَا كَانَ لِمُؤۡمِنٖ وَلَا مُؤۡمِنَةٍ إِذَا قَضَى ٱللَّهُ وَرَسُولُهُۥٓ أَمۡرًا أَن يَكُونَ لَهُمُ ٱلۡخِيَرَةُ مِنۡ أَمۡرِهِمۡۗ وَمَن يَعۡصِ ٱللَّهَ وَرَسُولَهُۥ فَقَدۡ ضَلَّ ضَلَٰلٗا مُّبِينٗا",
    "ayah_text_no_diacratic" : "وما كان لمؤمن ولا مؤمنة اذا قضى الله ورسوله امرا ان يكون لهم الخيرة من امرهم ومن يعص الله ورسوله فقد ضل ضلٰلا مبينا",
    "ayahnumber" : "36",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3633",
    "page" : "423",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3634",
    "ayah_text" : "وَإِذۡ تَقُولُ لِلَّذِيٓ أَنۡعَمَ ٱللَّهُ عَلَيۡهِ وَأَنۡعَمۡتَ عَلَيۡهِ أَمۡسِكۡ عَلَيۡكَ زَوۡجَكَ وَٱتَّقِ ٱللَّهَ وَتُخۡفِي فِي نَفۡسِكَ مَا ٱللَّهُ مُبۡدِيهِ وَتَخۡشَى ٱلنَّاسَ وَٱللَّهُ أَحَقُّ أَن تَخۡشَىٰهُۖ فَلَمَّا قَضَىٰ زَيۡدٞ مِّنۡهَا وَطَرٗا زَوَّجۡنَٰكَهَا لِكَيۡ لَا يَكُونَ عَلَى ٱلۡمُؤۡمِنِينَ حَرَجٞ فِيٓ أَزۡوَٰجِ أَدۡعِيَآئِهِمۡ إِذَا قَضَوۡاْ مِنۡهُنَّ وَطَرٗاۚ وَكَانَ أَمۡرُ ٱللَّهِ مَفۡعُولٗا",
    "ayah_text_no_diacratic" : "واذ تقول للذي انعم الله عليه وانعمت عليه امسك عليك زوجك واتق الله وتخفي في نفسك ما الله مبديه وتخشى الناس والله احق ان تخشىٰه فلما قضىٰ زيد منها وطرا زوجنٰكها لكي لا يكون على المؤمنين حرج في ازوٰج ادعيائهم اذا قضوا منهن وطرا وكان امر الله مفعولا",
    "ayahnumber" : "37",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3634",
    "page" : "423",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3635",
    "ayah_text" : "مَّا كَانَ عَلَى ٱلنَّبِيِّ مِنۡ حَرَجٖ فِيمَا فَرَضَ ٱللَّهُ لَهُۥۖ سُنَّةَ ٱللَّهِ فِي ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلُۚ وَكَانَ أَمۡرُ ٱللَّهِ قَدَرٗا مَّقۡدُورًا",
    "ayah_text_no_diacratic" : "ما كان على النبي من حرج فيما فرض الله له سنة الله في الذين خلوا من قبل وكان امر الله قدرا مقدورا",
    "ayahnumber" : "38",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3635",
    "page" : "423",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3636",
    "ayah_text" : "ٱلَّذِينَ يُبَلِّغُونَ رِسَٰلَٰتِ ٱللَّهِ وَيَخۡشَوۡنَهُۥ وَلَا يَخۡشَوۡنَ أَحَدًا إِلَّا ٱللَّهَۗ وَكَفَىٰ بِٱللَّهِ حَسِيبٗا",
    "ayah_text_no_diacratic" : "الذين يبلغون رسٰلٰت الله ويخشونه ولا يخشون احدا الا الله وكفىٰ بالله حسيبا",
    "ayahnumber" : "39",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3636",
    "page" : "423",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3637",
    "ayah_text" : "مَّا كَانَ مُحَمَّدٌ أَبَآ أَحَدٖ مِّن رِّجَالِكُمۡ وَلَٰكِن رَّسُولَ ٱللَّهِ وَخَاتَمَ ٱلنَّبِيِّـۧنَۗ وَكَانَ ٱللَّهُ بِكُلِّ شَيۡءٍ عَلِيمٗا",
    "ayah_text_no_diacratic" : "ما كان محمد ابا احد من رجالكم ولٰكن رسول الله وخاتم النبين وكان الله بكل شيء عليما",
    "ayahnumber" : "40",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3637",
    "page" : "423",
    "surahname" : "سُورَةُ الأَحۡزَابِ",
    "surahnumber" : "33",
    "surrahname_no_diacratic" : "سورة الاحزاب"
  }, {
    "@id" : "quran:3638",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱذۡكُرُواْ ٱللَّهَ ذِكۡرٗا كَثِيرٗا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اذكروا الله ذكرا كثيرا",
    "ayahnumber" : "41",
    "chapter" : "22",
    "hizb" : "42",
