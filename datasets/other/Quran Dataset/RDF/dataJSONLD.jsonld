  }, {
    "@id" : "quran:849",
    "ayah_text" : "وَٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا يَمَسُّهُمُ ٱلۡعَذَابُ بِمَا كَانُواْ يَفۡسُقُونَ",
    "ayah_text_no_diacratic" : "والذين كذبوا بايٰتنا يمسهم العذاب بما كانوا يفسقون",
