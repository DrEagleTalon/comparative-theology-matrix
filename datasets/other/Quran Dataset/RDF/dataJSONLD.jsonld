    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4447",
    "ayah_text" : "حَتَّىٰٓ إِذَا جَآءَنَا قَالَ يَٰلَيۡتَ بَيۡنِي وَبَيۡنَكَ بُعۡدَ ٱلۡمَشۡرِقَيۡنِ فَبِئۡسَ ٱلۡقَرِينُ",
    "ayah_text_no_diacratic" : "حتىٰ اذا جاءنا قال يٰليت بيني وبينك بعد المشرقين فبئس القرين",
    "ayahnumber" : "38",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4447",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4448",
    "ayah_text" : "وَلَن يَنفَعَكُمُ ٱلۡيَوۡمَ إِذ ظَّلَمۡتُمۡ أَنَّكُمۡ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ",
    "ayah_text_no_diacratic" : "ولن ينفعكم اليوم اذ ظلمتم انكم في العذاب مشتركون",
    "ayahnumber" : "39",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4448",
