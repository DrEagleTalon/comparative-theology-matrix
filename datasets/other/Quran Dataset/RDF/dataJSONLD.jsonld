    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1495",
    "ayah_text" : "أَلَّا تَعۡبُدُوٓاْ إِلَّا ٱللَّهَۚ إِنَّنِي لَكُم مِّنۡهُ نَذِيرٞ وَبَشِيرٞ",
    "ayah_text_no_diacratic" : "الا تعبدوا الا الله انني لكم منه نذير وبشير",
