    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:4023",
    "ayah_text" : "إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "الا من هو صال الجحيم",
