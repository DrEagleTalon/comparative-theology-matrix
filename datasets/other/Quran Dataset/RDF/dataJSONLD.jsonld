    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2577",
    "ayah_text" : "قَالَ لَقَدۡ كُنتُمۡ أَنتُمۡ وَءَابَآؤُكُمۡ فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "قال لقد كنتم انتم وءاباؤكم في ضلٰل مبين",
    "ayahnumber" : "54",
    "chapter" : "17",
    "hizb" : "32",
