    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:4031",
    "ayah_text" : "وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "ولقد سبقت كلمتنا لعبادنا المرسلين",
    "ayahnumber" : "171",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4031",
    "page" : "452",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:4032",
    "ayah_text" : "إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ",
    "ayah_text_no_diacratic" : "انهم لهم المنصورون",
