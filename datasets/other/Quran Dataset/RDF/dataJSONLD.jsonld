  }, {
    "@id" : "quran:3203",
    "ayah_text" : "هَلۡ أُنَبِّئُكُمۡ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَٰطِينُ",
    "ayah_text_no_diacratic" : "هل انبئكم علىٰ من تنزل الشيٰطين",
