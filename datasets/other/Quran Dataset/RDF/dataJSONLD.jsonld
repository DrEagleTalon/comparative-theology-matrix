    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3532",
    "ayah_text" : "هُدٗى وَرَحۡمَةٗ لِّلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "هدى ورحمة للمحسنين",
    "ayahnumber" : "3",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3532",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3533",
    "ayah_text" : "ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤۡتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلۡأٓخِرَةِ هُمۡ يُوقِنُونَ",
    "ayah_text_no_diacratic" : "الذين يقيمون الصلوٰة ويؤتون الزكوٰة وهم بالاخرة هم يوقنون",
    "ayahnumber" : "4",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3533",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3534",
    "ayah_text" : "أُوْلَٰٓئِكَ عَلَىٰ هُدٗى مِّن رَّبِّهِمۡۖ وَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "اولٰئك علىٰ هدى من ربهم واولٰئك هم المفلحون",
    "ayahnumber" : "5",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3534",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3535",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يَشۡتَرِي لَهۡوَ ٱلۡحَدِيثِ لِيُضِلَّ عَن سَبِيلِ ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَيَتَّخِذَهَا هُزُوًاۚ أُوْلَٰٓئِكَ لَهُمۡ عَذَابٞ مُّهِينٞ",
    "ayah_text_no_diacratic" : "ومن الناس من يشتري لهو الحديث ليضل عن سبيل الله بغير علم ويتخذها هزوا اولٰئك لهم عذاب مهين",
    "ayahnumber" : "6",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3535",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3536",
    "ayah_text" : "وَإِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا وَلَّىٰ مُسۡتَكۡبِرٗا كَأَن لَّمۡ يَسۡمَعۡهَا كَأَنَّ فِيٓ أُذُنَيۡهِ وَقۡرٗاۖ فَبَشِّرۡهُ بِعَذَابٍ أَلِيمٍ",
    "ayah_text_no_diacratic" : "واذا تتلىٰ عليه ءايٰتنا ولىٰ مستكبرا كان لم يسمعها كان في اذنيه وقرا فبشره بعذاب اليم",
    "ayahnumber" : "7",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3536",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3537",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتُ ٱلنَّعِيمِ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت لهم جنٰت النعيم",
    "ayahnumber" : "8",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3537",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3538",
    "ayah_text" : "خَٰلِدِينَ فِيهَاۖ وَعۡدَ ٱللَّهِ حَقّٗاۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "خٰلدين فيها وعد الله حقا وهو العزيز الحكيم",
    "ayahnumber" : "9",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3538",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3539",
    "ayah_text" : "خَلَقَ ٱلسَّمَٰوَٰتِ بِغَيۡرِ عَمَدٖ تَرَوۡنَهَاۖ وَأَلۡقَىٰ فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِكُمۡ وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٖۚ وَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ فَأَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ",
    "ayah_text_no_diacratic" : "خلق السمٰوٰت بغير عمد ترونها والقىٰ في الارض روٰسي ان تميد بكم وبث فيها من كل دابة وانزلنا من السماء ماء فانبتنا فيها من كل زوج كريم",
    "ayahnumber" : "10",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3539",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:354",
    "ayah_text" : "فَأَمَّا ٱلَّذِينَ كَفَرُواْ فَأُعَذِّبُهُمۡ عَذَابٗا شَدِيدٗا فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَمَا لَهُم مِّن نَّٰصِرِينَ",
    "ayah_text_no_diacratic" : "فاما الذين كفروا فاعذبهم عذابا شديدا في الدنيا والاخرة وما لهم من نٰصرين",
    "ayahnumber" : "56",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "354",
    "page" : "57",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3540",
    "ayah_text" : "هَٰذَا خَلۡقُ ٱللَّهِ فَأَرُونِي مَاذَا خَلَقَ ٱلَّذِينَ مِن دُونِهِۦۚ بَلِ ٱلظَّٰلِمُونَ فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "هٰذا خلق الله فاروني ماذا خلق الذين من دونه بل الظٰلمون في ضلٰل مبين",
    "ayahnumber" : "11",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3540",
    "page" : "411",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3541",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا لُقۡمَٰنَ ٱلۡحِكۡمَةَ أَنِ ٱشۡكُرۡ لِلَّهِۚ وَمَن يَشۡكُرۡ فَإِنَّمَا يَشۡكُرُ لِنَفۡسِهِۦۖ وَمَن كَفَرَ فَإِنَّ ٱللَّهَ غَنِيٌّ حَمِيدٞ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا لقمٰن الحكمة ان اشكر لله ومن يشكر فانما يشكر لنفسه ومن كفر فان الله غني حميد",
    "ayahnumber" : "12",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3541",
    "page" : "412",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3542",
    "ayah_text" : "وَإِذۡ قَالَ لُقۡمَٰنُ لِٱبۡنِهِۦ وَهُوَ يَعِظُهُۥ يَٰبُنَيَّ لَا تُشۡرِكۡ بِٱللَّهِۖ إِنَّ ٱلشِّرۡكَ لَظُلۡمٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "واذ قال لقمٰن لابنه وهو يعظه يٰبني لا تشرك بالله ان الشرك لظلم عظيم",
    "ayahnumber" : "13",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3542",
    "page" : "412",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3543",
    "ayah_text" : "وَوَصَّيۡنَا ٱلۡإِنسَٰنَ بِوَٰلِدَيۡهِ حَمَلَتۡهُ أُمُّهُۥ وَهۡنًا عَلَىٰ وَهۡنٖ وَفِصَٰلُهُۥ فِي عَامَيۡنِ أَنِ ٱشۡكُرۡ لِي وَلِوَٰلِدَيۡكَ إِلَيَّ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "ووصينا الانسٰن بوٰلديه حملته امه وهنا علىٰ وهن وفصٰله في عامين ان اشكر لي ولوٰلديك الي المصير",
    "ayahnumber" : "14",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3543",
    "page" : "412",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3544",
    "ayah_text" : "وَإِن جَٰهَدَاكَ عَلَىٰٓ أَن تُشۡرِكَ بِي مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٞ فَلَا تُطِعۡهُمَاۖ وَصَاحِبۡهُمَا فِي ٱلدُّنۡيَا مَعۡرُوفٗاۖ وَٱتَّبِعۡ سَبِيلَ مَنۡ أَنَابَ إِلَيَّۚ ثُمَّ إِلَيَّ مَرۡجِعُكُمۡ فَأُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "وان جٰهداك علىٰ ان تشرك بي ما ليس لك به علم فلا تطعهما وصاحبهما في الدنيا معروفا واتبع سبيل من اناب الي ثم الي مرجعكم فانبئكم بما كنتم تعملون",
    "ayahnumber" : "15",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3544",
    "page" : "412",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3545",
    "ayah_text" : "يَٰبُنَيَّ إِنَّهَآ إِن تَكُ مِثۡقَالَ حَبَّةٖ مِّنۡ خَرۡدَلٖ فَتَكُن فِي صَخۡرَةٍ أَوۡ فِي ٱلسَّمَٰوَٰتِ أَوۡ فِي ٱلۡأَرۡضِ يَأۡتِ بِهَا ٱللَّهُۚ إِنَّ ٱللَّهَ لَطِيفٌ خَبِيرٞ",
    "ayah_text_no_diacratic" : "يٰبني انها ان تك مثقال حبة من خردل فتكن في صخرة او في السمٰوٰت او في الارض يات بها الله ان الله لطيف خبير",
    "ayahnumber" : "16",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3545",
    "page" : "412",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3546",
    "ayah_text" : "يَٰبُنَيَّ أَقِمِ ٱلصَّلَوٰةَ وَأۡمُرۡ بِٱلۡمَعۡرُوفِ وَٱنۡهَ عَنِ ٱلۡمُنكَرِ وَٱصۡبِرۡ عَلَىٰ مَآ أَصَابَكَۖ إِنَّ ذَٰلِكَ مِنۡ عَزۡمِ ٱلۡأُمُورِ",
    "ayah_text_no_diacratic" : "يٰبني اقم الصلوٰة وامر بالمعروف وانه عن المنكر واصبر علىٰ ما اصابك ان ذٰلك من عزم الامور",
    "ayahnumber" : "17",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3546",
    "page" : "412",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3547",
    "ayah_text" : "وَلَا تُصَعِّرۡ خَدَّكَ لِلنَّاسِ وَلَا تَمۡشِ فِي ٱلۡأَرۡضِ مَرَحًاۖ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ مُخۡتَالٖ فَخُورٖ",
    "ayah_text_no_diacratic" : "ولا تصعر خدك للناس ولا تمش في الارض مرحا ان الله لا يحب كل مختال فخور",
    "ayahnumber" : "18",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3547",
    "page" : "412",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3548",
    "ayah_text" : "وَٱقۡصِدۡ فِي مَشۡيِكَ وَٱغۡضُضۡ مِن صَوۡتِكَۚ إِنَّ أَنكَرَ ٱلۡأَصۡوَٰتِ لَصَوۡتُ ٱلۡحَمِيرِ",
    "ayah_text_no_diacratic" : "واقصد في مشيك واغضض من صوتك ان انكر الاصوٰت لصوت الحمير",
    "ayahnumber" : "19",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3548",
    "page" : "412",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3549",
    "ayah_text" : "أَلَمۡ تَرَوۡاْ أَنَّ ٱللَّهَ سَخَّرَ لَكُم مَّا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ وَأَسۡبَغَ عَلَيۡكُمۡ نِعَمَهُۥ ظَٰهِرَةٗ وَبَاطِنَةٗۗ وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَلَا هُدٗى وَلَا كِتَٰبٖ مُّنِيرٖ",
    "ayah_text_no_diacratic" : "الم تروا ان الله سخر لكم ما في السمٰوٰت وما في الارض واسبغ عليكم نعمه ظٰهرة وباطنة ومن الناس من يجٰدل في الله بغير علم ولا هدى ولا كتٰب منير",
    "ayahnumber" : "20",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3549",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:355",
    "ayah_text" : "وَأَمَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَيُوَفِّيهِمۡ أُجُورَهُمۡۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "واما الذين ءامنوا وعملوا الصٰلحٰت فيوفيهم اجورهم والله لا يحب الظٰلمين",
    "ayahnumber" : "57",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "355",
    "page" : "57",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3550",
    "ayah_text" : "وَإِذَا قِيلَ لَهُمُ ٱتَّبِعُواْ مَآ أَنزَلَ ٱللَّهُ قَالُواْ بَلۡ نَتَّبِعُ مَا وَجَدۡنَا عَلَيۡهِ ءَابَآءَنَآۚ أَوَلَوۡ كَانَ ٱلشَّيۡطَٰنُ يَدۡعُوهُمۡ إِلَىٰ عَذَابِ ٱلسَّعِيرِ",
    "ayah_text_no_diacratic" : "واذا قيل لهم اتبعوا ما انزل الله قالوا بل نتبع ما وجدنا عليه ءاباءنا اولو كان الشيطٰن يدعوهم الىٰ عذاب السعير",
    "ayahnumber" : "21",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3550",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3551",
    "ayah_text" : "۞وَمَن يُسۡلِمۡ وَجۡهَهُۥٓ إِلَى ٱللَّهِ وَهُوَ مُحۡسِنٞ فَقَدِ ٱسۡتَمۡسَكَ بِٱلۡعُرۡوَةِ ٱلۡوُثۡقَىٰۗ وَإِلَى ٱللَّهِ عَٰقِبَةُ ٱلۡأُمُورِ",
    "ayah_text_no_diacratic" : "ومن يسلم وجهه الى الله وهو محسن فقد استمسك بالعروة الوثقىٰ والى الله عٰقبة الامور",
    "ayahnumber" : "22",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3551",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3552",
    "ayah_text" : "وَمَن كَفَرَ فَلَا يَحۡزُنكَ كُفۡرُهُۥٓۚ إِلَيۡنَا مَرۡجِعُهُمۡ فَنُنَبِّئُهُم بِمَا عَمِلُوٓاْۚ إِنَّ ٱللَّهَ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "ومن كفر فلا يحزنك كفره الينا مرجعهم فننبئهم بما عملوا ان الله عليم بذات الصدور",
    "ayahnumber" : "23",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3552",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3553",
    "ayah_text" : "نُمَتِّعُهُمۡ قَلِيلٗا ثُمَّ نَضۡطَرُّهُمۡ إِلَىٰ عَذَابٍ غَلِيظٖ",
    "ayah_text_no_diacratic" : "نمتعهم قليلا ثم نضطرهم الىٰ عذاب غليظ",
    "ayahnumber" : "24",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3553",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3554",
    "ayah_text" : "وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ لَيَقُولُنَّ ٱللَّهُۚ قُلِ ٱلۡحَمۡدُ لِلَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولئن سالتهم من خلق السمٰوٰت والارض ليقولن الله قل الحمد لله بل اكثرهم لا يعلمون",
    "ayahnumber" : "25",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3554",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3555",
    "ayah_text" : "لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ إِنَّ ٱللَّهَ هُوَ ٱلۡغَنِيُّ ٱلۡحَمِيدُ",
    "ayah_text_no_diacratic" : "لله ما في السمٰوٰت والارض ان الله هو الغني الحميد",
    "ayahnumber" : "26",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3555",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3556",
    "ayah_text" : "وَلَوۡ أَنَّمَا فِي ٱلۡأَرۡضِ مِن شَجَرَةٍ أَقۡلَٰمٞ وَٱلۡبَحۡرُ يَمُدُّهُۥ مِنۢ بَعۡدِهِۦ سَبۡعَةُ أَبۡحُرٖ مَّا نَفِدَتۡ كَلِمَٰتُ ٱللَّهِۚ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "ولو انما في الارض من شجرة اقلٰم والبحر يمده من بعده سبعة ابحر ما نفدت كلمٰت الله ان الله عزيز حكيم",
    "ayahnumber" : "27",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3556",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3557",
    "ayah_text" : "مَّا خَلۡقُكُمۡ وَلَا بَعۡثُكُمۡ إِلَّا كَنَفۡسٖ وَٰحِدَةٍۚ إِنَّ ٱللَّهَ سَمِيعُۢ بَصِيرٌ",
    "ayah_text_no_diacratic" : "ما خلقكم ولا بعثكم الا كنفس وٰحدة ان الله سميع بصير",
    "ayahnumber" : "28",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3557",
    "page" : "413",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3558",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱللَّهَ يُولِجُ ٱلَّيۡلَ فِي ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِي ٱلَّيۡلِ وَسَخَّرَ ٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ يَجۡرِيٓ إِلَىٰٓ أَجَلٖ مُّسَمّٗى وَأَنَّ ٱللَّهَ بِمَا تَعۡمَلُونَ خَبِيرٞ",
    "ayah_text_no_diacratic" : "الم تر ان الله يولج اليل في النهار ويولج النهار في اليل وسخر الشمس والقمر كل يجري الىٰ اجل مسمى وان الله بما تعملون خبير",
    "ayahnumber" : "29",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3558",
    "page" : "414",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3559",
    "ayah_text" : "ذَٰلِكَ بِأَنَّ ٱللَّهَ هُوَ ٱلۡحَقُّ وَأَنَّ مَا يَدۡعُونَ مِن دُونِهِ ٱلۡبَٰطِلُ وَأَنَّ ٱللَّهَ هُوَ ٱلۡعَلِيُّ ٱلۡكَبِيرُ",
    "ayah_text_no_diacratic" : "ذٰلك بان الله هو الحق وان ما يدعون من دونه البٰطل وان الله هو العلي الكبير",
    "ayahnumber" : "30",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3559",
    "page" : "414",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:356",
    "ayah_text" : "ذَٰلِكَ نَتۡلُوهُ عَلَيۡكَ مِنَ ٱلۡأٓيَٰتِ وَٱلذِّكۡرِ ٱلۡحَكِيمِ",
    "ayah_text_no_diacratic" : "ذٰلك نتلوه عليك من الايٰت والذكر الحكيم",
    "ayahnumber" : "58",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "356",
    "page" : "57",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3560",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱلۡفُلۡكَ تَجۡرِي فِي ٱلۡبَحۡرِ بِنِعۡمَتِ ٱللَّهِ لِيُرِيَكُم مِّنۡ ءَايَٰتِهِۦٓۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّكُلِّ صَبَّارٖ شَكُورٖ",
    "ayah_text_no_diacratic" : "الم تر ان الفلك تجري في البحر بنعمت الله ليريكم من ءايٰته ان في ذٰلك لايٰت لكل صبار شكور",
    "ayahnumber" : "31",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3560",
    "page" : "414",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3561",
    "ayah_text" : "وَإِذَا غَشِيَهُم مَّوۡجٞ كَٱلظُّلَلِ دَعَوُاْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ فَلَمَّا نَجَّىٰهُمۡ إِلَى ٱلۡبَرِّ فَمِنۡهُم مُّقۡتَصِدٞۚ وَمَا يَجۡحَدُ بِـَٔايَٰتِنَآ إِلَّا كُلُّ خَتَّارٖ كَفُورٖ",
    "ayah_text_no_diacratic" : "واذا غشيهم موج كالظلل دعوا الله مخلصين له الدين فلما نجىٰهم الى البر فمنهم مقتصد وما يجحد بايٰتنا الا كل ختار كفور",
    "ayahnumber" : "32",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3561",
    "page" : "414",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3562",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُواْ رَبَّكُمۡ وَٱخۡشَوۡاْ يَوۡمٗا لَّا يَجۡزِي وَالِدٌ عَن وَلَدِهِۦ وَلَا مَوۡلُودٌ هُوَ جَازٍ عَن وَالِدِهِۦ شَيۡـًٔاۚ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞۖ فَلَا تَغُرَّنَّكُمُ ٱلۡحَيَوٰةُ ٱلدُّنۡيَا وَلَا يَغُرَّنَّكُم بِٱللَّهِ ٱلۡغَرُورُ",
    "ayah_text_no_diacratic" : "يٰايها الناس اتقوا ربكم واخشوا يوما لا يجزي والد عن ولده ولا مولود هو جاز عن والده شيا ان وعد الله حق فلا تغرنكم الحيوٰة الدنيا ولا يغرنكم بالله الغرور",
    "ayahnumber" : "33",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3562",
    "page" : "414",
    "surahname" : "سُورَةُ لُقۡمَانَ",
    "surahnumber" : "31",
    "surrahname_no_diacratic" : "سورة لقمان"
  }, {
    "@id" : "quran:3563",
    "ayah_text" : "إِنَّ ٱللَّهَ عِندَهُۥ عِلۡمُ ٱلسَّاعَةِ وَيُنَزِّلُ ٱلۡغَيۡثَ وَيَعۡلَمُ مَا فِي ٱلۡأَرۡحَامِۖ وَمَا تَدۡرِي نَفۡسٞ مَّاذَا تَكۡسِبُ غَدٗاۖ وَمَا تَدۡرِي نَفۡسُۢ بِأَيِّ أَرۡضٖ تَمُوتُۚ إِنَّ ٱللَّهَ عَلِيمٌ خَبِيرُۢ",
    "ayah_text_no_diacratic" : "ان الله عنده علم الساعة وينزل الغيث ويعلم ما في الارحام وما تدري نفس ماذا تكسب غدا وما تدري نفس باي ارض تموت ان الله عليم خبير",
    "ayahnumber" : "34",
    "chapter" : "21",
    "hizb" : "41",
