    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5576",
    "ayah_text" : "وَٱللَّهُ أَنۢبَتَكُم مِّنَ ٱلۡأَرۡضِ نَبَاتٗا",
    "ayah_text_no_diacratic" : "والله انبتكم من الارض نباتا",
    "ayahnumber" : "17",
    "chapter" : "29",
    "hizb" : "57",
