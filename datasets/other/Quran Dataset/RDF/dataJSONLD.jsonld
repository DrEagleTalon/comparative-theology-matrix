    "surrahname_no_diacratic" : "سورة الفجر"
  }, {
    "@id" : "quran:6192",
    "ayah_text" : "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ",
    "ayah_text_no_diacratic" : "وجايء يومئذ بجهنم يومئذ يتذكر الانسٰن وانىٰ له الذكرىٰ",
