  }, {
    "@id" : "quran:3035",
    "ayah_text" : "فَأَرۡسَلَ فِرۡعَوۡنُ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ",
    "ayah_text_no_diacratic" : "فارسل فرعون في المدائن حٰشرين",
