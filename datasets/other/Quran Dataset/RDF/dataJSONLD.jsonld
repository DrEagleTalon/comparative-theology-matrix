    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4010",
    "ayah_text" : "أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ",
