    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:488",
    "ayah_text" : "إِنَّ فِي خَلۡقِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ لَأٓيَٰتٖ لِّأُوْلِي ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "ان في خلق السمٰوٰت والارض واختلٰف اليل والنهار لايٰت لاولي الالبٰب",
    "ayahnumber" : "190",
    "chapter" : "4",
    "hizb" : "7",
