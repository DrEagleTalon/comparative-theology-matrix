  }, {
    "@id" : "quran:713",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ وَٱبۡتَغُوٓاْ إِلَيۡهِ ٱلۡوَسِيلَةَ وَجَٰهِدُواْ فِي سَبِيلِهِۦ لَعَلَّكُمۡ تُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اتقوا الله وابتغوا اليه الوسيلة وجٰهدوا في سبيله لعلكم تفلحون",
    "ayahnumber" : "35",
    "chapter" : "6",
    "hizb" : "11",
    "index" : "713",
