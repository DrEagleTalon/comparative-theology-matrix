    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:5237",
    "ayah_text" : "ٱسۡتَحۡوَذَ عَلَيۡهِمُ ٱلشَّيۡطَٰنُ فَأَنسَىٰهُمۡ ذِكۡرَ ٱللَّهِۚ أُوْلَٰٓئِكَ حِزۡبُ ٱلشَّيۡطَٰنِۚ أَلَآ إِنَّ حِزۡبَ ٱلشَّيۡطَٰنِ هُمُ ٱلۡخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "استحوذ عليهم الشيطٰن فانسىٰهم ذكر الله اولٰئك حزب الشيطٰن الا ان حزب الشيطٰن هم الخٰسرون",
    "ayahnumber" : "19",
    "chapter" : "28",
    "hizb" : "54",
