    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1255",
    "ayah_text" : "إِلَّا ٱلَّذِينَ عَٰهَدتُّم مِّنَ ٱلۡمُشۡرِكِينَ ثُمَّ لَمۡ يَنقُصُوكُمۡ شَيۡـٔٗا وَلَمۡ يُظَٰهِرُواْ عَلَيۡكُمۡ أَحَدٗا فَأَتِمُّوٓاْ إِلَيۡهِمۡ عَهۡدَهُمۡ إِلَىٰ مُدَّتِهِمۡۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "الا الذين عٰهدتم من المشركين ثم لم ينقصوكم شيا ولم يظٰهروا عليكم احدا فاتموا اليهم عهدهم الىٰ مدتهم ان الله يحب المتقين",
    "ayahnumber" : "4",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1255",
    "page" : "187",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1256",
    "ayah_text" : "فَإِذَا ٱنسَلَخَ ٱلۡأَشۡهُرُ ٱلۡحُرُمُ فَٱقۡتُلُواْ ٱلۡمُشۡرِكِينَ حَيۡثُ وَجَدتُّمُوهُمۡ وَخُذُوهُمۡ وَٱحۡصُرُوهُمۡ وَٱقۡعُدُواْ لَهُمۡ كُلَّ مَرۡصَدٖۚ فَإِن تَابُواْ وَأَقَامُواْ ٱلصَّلَوٰةَ وَءَاتَوُاْ ٱلزَّكَوٰةَ فَخَلُّواْ سَبِيلَهُمۡۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "فاذا انسلخ الاشهر الحرم فاقتلوا المشركين حيث وجدتموهم وخذوهم واحصروهم واقعدوا لهم كل مرصد فان تابوا واقاموا الصلوٰة وءاتوا الزكوٰة فخلوا سبيلهم ان الله غفور رحيم",
    "ayahnumber" : "5",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1256",
    "page" : "187",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1257",
    "ayah_text" : "وَإِنۡ أَحَدٞ مِّنَ ٱلۡمُشۡرِكِينَ ٱسۡتَجَارَكَ فَأَجِرۡهُ حَتَّىٰ يَسۡمَعَ كَلَٰمَ ٱللَّهِ ثُمَّ أَبۡلِغۡهُ مَأۡمَنَهُۥۚ ذَٰلِكَ بِأَنَّهُمۡ قَوۡمٞ لَّا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وان احد من المشركين استجارك فاجره حتىٰ يسمع كلٰم الله ثم ابلغه مامنه ذٰلك بانهم قوم لا يعلمون",
    "ayahnumber" : "6",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1257",
    "page" : "187",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1258",
    "ayah_text" : "كَيۡفَ يَكُونُ لِلۡمُشۡرِكِينَ عَهۡدٌ عِندَ ٱللَّهِ وَعِندَ رَسُولِهِۦٓ إِلَّا ٱلَّذِينَ عَٰهَدتُّمۡ عِندَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِۖ فَمَا ٱسۡتَقَٰمُواْ لَكُمۡ فَٱسۡتَقِيمُواْ لَهُمۡۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "كيف يكون للمشركين عهد عند الله وعند رسوله الا الذين عٰهدتم عند المسجد الحرام فما استقٰموا لكم فاستقيموا لهم ان الله يحب المتقين",
    "ayahnumber" : "7",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1258",
    "page" : "188",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1259",
    "ayah_text" : "كَيۡفَ وَإِن يَظۡهَرُواْ عَلَيۡكُمۡ لَا يَرۡقُبُواْ فِيكُمۡ إِلّٗا وَلَا ذِمَّةٗۚ يُرۡضُونَكُم بِأَفۡوَٰهِهِمۡ وَتَأۡبَىٰ قُلُوبُهُمۡ وَأَكۡثَرُهُمۡ فَٰسِقُونَ",
    "ayah_text_no_diacratic" : "كيف وان يظهروا عليكم لا يرقبوا فيكم الا ولا ذمة يرضونكم بافوٰههم وتابىٰ قلوبهم واكثرهم فٰسقون",
    "ayahnumber" : "8",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1259",
    "page" : "188",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:126",
    "ayah_text" : "وَقَالُواْ ٱتَّخَذَ ٱللَّهُ وَلَدٗاۗ سُبۡحَٰنَهُۥۖ بَل لَّهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ كُلّٞ لَّهُۥ قَٰنِتُونَ",
    "ayah_text_no_diacratic" : "وقالوا اتخذ الله ولدا سبحٰنه بل له ما في السمٰوٰت والارض كل له قٰنتون",
    "ayahnumber" : "116",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "126",
    "page" : "18",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1260",
    "ayah_text" : "ٱشۡتَرَوۡاْ بِـَٔايَٰتِ ٱللَّهِ ثَمَنٗا قَلِيلٗا فَصَدُّواْ عَن سَبِيلِهِۦٓۚ إِنَّهُمۡ سَآءَ مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "اشتروا بايٰت الله ثمنا قليلا فصدوا عن سبيله انهم ساء ما كانوا يعملون",
    "ayahnumber" : "9",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1260",
    "page" : "188",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1261",
    "ayah_text" : "لَا يَرۡقُبُونَ فِي مُؤۡمِنٍ إِلّٗا وَلَا ذِمَّةٗۚ وَأُوْلَٰٓئِكَ هُمُ ٱلۡمُعۡتَدُونَ",
    "ayah_text_no_diacratic" : "لا يرقبون في مؤمن الا ولا ذمة واولٰئك هم المعتدون",
    "ayahnumber" : "10",
    "chapter" : "10",
