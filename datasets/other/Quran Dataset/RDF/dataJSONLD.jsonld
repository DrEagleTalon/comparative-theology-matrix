    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4126",
    "ayah_text" : "قَالَ فَبِعِزَّتِكَ لَأُغۡوِيَنَّهُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "قال فبعزتك لاغوينهم اجمعين",
