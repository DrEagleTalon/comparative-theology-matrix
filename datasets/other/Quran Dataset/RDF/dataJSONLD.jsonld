    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3028",
    "ayah_text" : "فَأُلۡقِيَ ٱلسَّحَرَةُ سَٰجِدِينَ",
    "ayah_text_no_diacratic" : "فالقي السحرة سٰجدين",
    "ayahnumber" : "46",
    "chapter" : "19",
