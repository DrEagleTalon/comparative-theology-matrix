    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2965",
    "ayah_text" : "وَهُوَ ٱلَّذِي جَعَلَ ٱلَّيۡلَ وَٱلنَّهَارَ خِلۡفَةٗ لِّمَنۡ أَرَادَ أَن يَذَّكَّرَ أَوۡ أَرَادَ شُكُورٗا",
    "ayah_text_no_diacratic" : "وهو الذي جعل اليل والنهار خلفة لمن اراد ان يذكر او اراد شكورا",
