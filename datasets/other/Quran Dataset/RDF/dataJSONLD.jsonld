  }, {
    "@id" : "quran:5268",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5268",
    "page" : "549",
    "surahname" : "سُورَةُ المُمۡتَحنَةِ",
    "surahnumber" : "60",
    "surrahname_no_diacratic" : "سورة الممتحنة"
  }, {
    "@id" : "quran:5269",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّخِذُواْ عَدُوِّي وَعَدُوَّكُمۡ أَوۡلِيَآءَ تُلۡقُونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ وَقَدۡ كَفَرُواْ بِمَا جَآءَكُم مِّنَ ٱلۡحَقِّ يُخۡرِجُونَ ٱلرَّسُولَ وَإِيَّاكُمۡ أَن تُؤۡمِنُواْ بِٱللَّهِ رَبِّكُمۡ إِن كُنتُمۡ خَرَجۡتُمۡ جِهَٰدٗا فِي سَبِيلِي وَٱبۡتِغَآءَ مَرۡضَاتِيۚ تُسِرُّونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ وَأَنَا۠ أَعۡلَمُ بِمَآ أَخۡفَيۡتُمۡ وَمَآ أَعۡلَنتُمۡۚ وَمَن يَفۡعَلۡهُ مِنكُمۡ فَقَدۡ ضَلَّ سَوَآءَ ٱلسَّبِيلِ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تتخذوا عدوي وعدوكم اولياء تلقون اليهم بالمودة وقد كفروا بما جاءكم من الحق يخرجون الرسول واياكم ان تؤمنوا بالله ربكم ان كنتم خرجتم جهٰدا في سبيلي وابتغاء مرضاتي تسرون اليهم بالمودة وانا اعلم بما اخفيتم وما اعلنتم ومن يفعله منكم فقد ضل سواء السبيل",
    "ayahnumber" : "1",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5269",
    "page" : "549",
    "surahname" : "سُورَةُ المُمۡتَحنَةِ",
    "surahnumber" : "60",
    "surrahname_no_diacratic" : "سورة الممتحنة"
  }, {
    "@id" : "quran:527",
    "ayah_text" : "وَٱللَّهُ يُرِيدُ أَن يَتُوبَ عَلَيۡكُمۡ وَيُرِيدُ ٱلَّذِينَ يَتَّبِعُونَ ٱلشَّهَوَٰتِ أَن تَمِيلُواْ مَيۡلًا عَظِيمٗا",
    "ayah_text_no_diacratic" : "والله يريد ان يتوب عليكم ويريد الذين يتبعون الشهوٰت ان تميلوا ميلا عظيما",
    "ayahnumber" : "27",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "527",
    "page" : "83",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5270",
    "ayah_text" : "إِن يَثۡقَفُوكُمۡ يَكُونُواْ لَكُمۡ أَعۡدَآءٗ وَيَبۡسُطُوٓاْ إِلَيۡكُمۡ أَيۡدِيَهُمۡ وَأَلۡسِنَتَهُم بِٱلسُّوٓءِ وَوَدُّواْ لَوۡ تَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "ان يثقفوكم يكونوا لكم اعداء ويبسطوا اليكم ايديهم والسنتهم بالسوء وودوا لو تكفرون",
    "ayahnumber" : "2",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5270",
    "page" : "549",
    "surahname" : "سُورَةُ المُمۡتَحنَةِ",
    "surahnumber" : "60",
    "surrahname_no_diacratic" : "سورة الممتحنة"
  }, {
    "@id" : "quran:5271",
    "ayah_text" : "لَن تَنفَعَكُمۡ أَرۡحَامُكُمۡ وَلَآ أَوۡلَٰدُكُمۡۚ يَوۡمَ ٱلۡقِيَٰمَةِ يَفۡصِلُ بَيۡنَكُمۡۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرٞ",
    "ayah_text_no_diacratic" : "لن تنفعكم ارحامكم ولا اولٰدكم يوم القيٰمة يفصل بينكم والله بما تعملون بصير",
    "ayahnumber" : "3",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5271",
    "page" : "549",
    "surahname" : "سُورَةُ المُمۡتَحنَةِ",
    "surahnumber" : "60",
