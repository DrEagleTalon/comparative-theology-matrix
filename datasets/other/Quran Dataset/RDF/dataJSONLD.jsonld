    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3017",
    "ayah_text" : "يُرِيدُ أَن يُخۡرِجَكُم مِّنۡ أَرۡضِكُم بِسِحۡرِهِۦ فَمَاذَا تَأۡمُرُونَ",
    "ayah_text_no_diacratic" : "يريد ان يخرجكم من ارضكم بسحره فماذا تامرون",
