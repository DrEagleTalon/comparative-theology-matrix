  }, {
    "@id" : "quran:5919",
    "ayah_text" : "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
    "ayah_text_no_diacratic" : "وما يدريك لعله يزكىٰ",
