    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1882",
    "ayah_text" : "إِذۡ دَخَلُواْ عَلَيۡهِ فَقَالُواْ سَلَٰمٗا قَالَ إِنَّا مِنكُمۡ وَجِلُونَ",
    "ayah_text_no_diacratic" : "اذ دخلوا عليه فقالوا سلٰما قال انا منكم وجلون",
    "ayahnumber" : "52",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1882",
