    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4113",
    "ayah_text" : "مَا كَانَ لِيَ مِنۡ عِلۡمِۭ بِٱلۡمَلَإِ ٱلۡأَعۡلَىٰٓ إِذۡ يَخۡتَصِمُونَ",
    "ayah_text_no_diacratic" : "ما كان لي من علم بالملا الاعلىٰ اذ يختصمون",
    "ayahnumber" : "69",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4113",
