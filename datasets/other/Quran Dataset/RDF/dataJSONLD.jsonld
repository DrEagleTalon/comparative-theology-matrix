    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4428",
    "ayah_text" : "وَجَعَلُواْ ٱلۡمَلَٰٓئِكَةَ ٱلَّذِينَ هُمۡ عِبَٰدُ ٱلرَّحۡمَٰنِ إِنَٰثًاۚ أَشَهِدُواْ خَلۡقَهُمۡۚ سَتُكۡتَبُ شَهَٰدَتُهُمۡ وَيُسۡـَٔلُونَ",
    "ayah_text_no_diacratic" : "وجعلوا الملٰئكة الذين هم عبٰد الرحمٰن انٰثا اشهدوا خلقهم ستكتب شهٰدتهم ويسلون",
    "ayahnumber" : "19",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4428",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4429",
    "ayah_text" : "وَقَالُواْ لَوۡ شَآءَ ٱلرَّحۡمَٰنُ مَا عَبَدۡنَٰهُمۗ مَّا لَهُم بِذَٰلِكَ مِنۡ عِلۡمٍۖ إِنۡ هُمۡ إِلَّا يَخۡرُصُونَ",
    "ayah_text_no_diacratic" : "وقالوا لو شاء الرحمٰن ما عبدنٰهم ما لهم بذٰلك من علم ان هم الا يخرصون",
    "ayahnumber" : "20",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4429",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:443",
    "ayah_text" : "وَمَا كَانَ لِنَفۡسٍ أَن تَمُوتَ إِلَّا بِإِذۡنِ ٱللَّهِ كِتَٰبٗا مُّؤَجَّلٗاۗ وَمَن يُرِدۡ ثَوَابَ ٱلدُّنۡيَا نُؤۡتِهِۦ مِنۡهَا وَمَن يُرِدۡ ثَوَابَ ٱلۡأٓخِرَةِ نُؤۡتِهِۦ مِنۡهَاۚ وَسَنَجۡزِي ٱلشَّٰكِرِينَ",
    "ayah_text_no_diacratic" : "وما كان لنفس ان تموت الا باذن الله كتٰبا مؤجلا ومن يرد ثواب الدنيا نؤته منها ومن يرد ثواب الاخرة نؤته منها وسنجزي الشٰكرين",
    "ayahnumber" : "145",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "443",
    "page" : "68",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4430",
    "ayah_text" : "أَمۡ ءَاتَيۡنَٰهُمۡ كِتَٰبٗا مِّن قَبۡلِهِۦ فَهُم بِهِۦ مُسۡتَمۡسِكُونَ",
    "ayah_text_no_diacratic" : "ام ءاتينٰهم كتٰبا من قبله فهم به مستمسكون",
    "ayahnumber" : "21",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4430",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4431",
    "ayah_text" : "بَلۡ قَالُوٓاْ إِنَّا وَجَدۡنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٖ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّهۡتَدُونَ",
    "ayah_text_no_diacratic" : "بل قالوا انا وجدنا ءاباءنا علىٰ امة وانا علىٰ ءاثٰرهم مهتدون",
    "ayahnumber" : "22",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4431",
    "page" : "490",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4432",
    "ayah_text" : "وَكَذَٰلِكَ مَآ أَرۡسَلۡنَا مِن قَبۡلِكَ فِي قَرۡيَةٖ مِّن نَّذِيرٍ إِلَّا قَالَ مُتۡرَفُوهَآ إِنَّا وَجَدۡنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٖ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّقۡتَدُونَ",
    "ayah_text_no_diacratic" : "وكذٰلك ما ارسلنا من قبلك في قرية من نذير الا قال مترفوها انا وجدنا ءاباءنا علىٰ امة وانا علىٰ ءاثٰرهم مقتدون",
    "ayahnumber" : "23",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4432",
    "page" : "491",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4433",
    "ayah_text" : "۞قَٰلَ أَوَلَوۡ جِئۡتُكُم بِأَهۡدَىٰ مِمَّا وَجَدتُّمۡ عَلَيۡهِ ءَابَآءَكُمۡۖ قَالُوٓاْ إِنَّا بِمَآ أُرۡسِلۡتُم بِهِۦ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "قٰل اولو جئتكم باهدىٰ مما وجدتم عليه ءاباءكم قالوا انا بما ارسلتم به كٰفرون",
    "ayahnumber" : "24",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4433",
    "page" : "491",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4434",
    "ayah_text" : "فَٱنتَقَمۡنَا مِنۡهُمۡۖ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُكَذِّبِينَ",
    "ayah_text_no_diacratic" : "فانتقمنا منهم فانظر كيف كان عٰقبة المكذبين",
