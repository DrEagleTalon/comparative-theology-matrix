    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2585",
    "ayah_text" : "قَالُوٓاْ ءَأَنتَ فَعَلۡتَ هَٰذَا بِـَٔالِهَتِنَا يَٰٓإِبۡرَٰهِيمُ",
    "ayah_text_no_diacratic" : "قالوا ءانت فعلت هٰذا بالهتنا يٰابرٰهيم",
