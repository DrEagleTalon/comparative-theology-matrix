    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4604",
    "ayah_text" : "قُلۡ أَرَءَيۡتُم مَّا تَدۡعُونَ مِن دُونِ ٱللَّهِ أَرُونِي مَاذَا خَلَقُواْ مِنَ ٱلۡأَرۡضِ أَمۡ لَهُمۡ شِرۡكٞ فِي ٱلسَّمَٰوَٰتِۖ ٱئۡتُونِي بِكِتَٰبٖ مِّن قَبۡلِ هَٰذَآ أَوۡ أَثَٰرَةٖ مِّنۡ عِلۡمٍ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "قل ارءيتم ما تدعون من دون الله اروني ماذا خلقوا من الارض ام لهم شرك في السمٰوٰت ائتوني بكتٰب من قبل هٰذا او اثٰرة من علم ان كنتم صٰدقين",
    "ayahnumber" : "4",
    "chapter" : "26",
    "hizb" : "50",
    "index" : "4604",
    "page" : "502",
    "surahname" : "سُورَةُ الأَحۡقَافِ",
    "surahnumber" : "46",
    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:4605",
    "ayah_text" : "وَمَنۡ أَضَلُّ مِمَّن يَدۡعُواْ مِن دُونِ ٱللَّهِ مَن لَّا يَسۡتَجِيبُ لَهُۥٓ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ وَهُمۡ عَن دُعَآئِهِمۡ غَٰفِلُونَ",
    "ayah_text_no_diacratic" : "ومن اضل ممن يدعوا من دون الله من لا يستجيب له الىٰ يوم القيٰمة وهم عن دعائهم غٰفلون",
    "ayahnumber" : "5",
