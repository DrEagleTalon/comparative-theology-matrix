  }, {
    "@id" : "quran:3149",
    "ayah_text" : "قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ ٱلۡمُخۡرَجِينَ",
    "ayah_text_no_diacratic" : "قالوا لئن لم تنته يٰلوط لتكونن من المخرجين",
