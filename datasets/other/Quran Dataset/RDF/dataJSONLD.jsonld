    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:88",
    "ayah_text" : "وَمِنۡهُمۡ أُمِّيُّونَ لَا يَعۡلَمُونَ ٱلۡكِتَٰبَ إِلَّآ أَمَانِيَّ وَإِنۡ هُمۡ إِلَّا يَظُنُّونَ",
    "ayah_text_no_diacratic" : "ومنهم اميون لا يعلمون الكتٰب الا اماني وان هم الا يظنون",
    "ayahnumber" : "78",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "88",
    "page" : "12",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:880",
    "ayah_text" : "وَحَآجَّهُۥ قَوۡمُهُۥۚ قَالَ أَتُحَٰٓجُّوٓنِّي فِي ٱللَّهِ وَقَدۡ هَدَىٰنِۚ وَلَآ أَخَافُ مَا تُشۡرِكُونَ بِهِۦٓ إِلَّآ أَن يَشَآءَ رَبِّي شَيۡـٔٗاۚ وَسِعَ رَبِّي كُلَّ شَيۡءٍ عِلۡمًاۚ أَفَلَا تَتَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "وحاجه قومه قال اتحٰجوني في الله وقد هدىٰن ولا اخاف ما تشركون به الا ان يشاء ربي شيا وسع ربي كل شيء علما افلا تتذكرون",
    "ayahnumber" : "80",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "880",
    "page" : "137",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:881",
    "ayah_text" : "وَكَيۡفَ أَخَافُ مَآ أَشۡرَكۡتُمۡ وَلَا تَخَافُونَ أَنَّكُمۡ أَشۡرَكۡتُم بِٱللَّهِ مَا لَمۡ يُنَزِّلۡ بِهِۦ عَلَيۡكُمۡ سُلۡطَٰنٗاۚ فَأَيُّ ٱلۡفَرِيقَيۡنِ أَحَقُّ بِٱلۡأَمۡنِۖ إِن كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وكيف اخاف ما اشركتم ولا تخافون انكم اشركتم بالله ما لم ينزل به عليكم سلطٰنا فاي الفريقين احق بالامن ان كنتم تعلمون",
    "ayahnumber" : "81",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "881",
    "page" : "137",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:882",
    "ayah_text" : "ٱلَّذِينَ ءَامَنُواْ وَلَمۡ يَلۡبِسُوٓاْ إِيمَٰنَهُم بِظُلۡمٍ أُوْلَٰٓئِكَ لَهُمُ ٱلۡأَمۡنُ وَهُم مُّهۡتَدُونَ",
    "ayah_text_no_diacratic" : "الذين ءامنوا ولم يلبسوا ايمٰنهم بظلم اولٰئك لهم الامن وهم مهتدون",
    "ayahnumber" : "82",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "882",
    "page" : "138",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:883",
    "ayah_text" : "وَتِلۡكَ حُجَّتُنَآ ءَاتَيۡنَٰهَآ إِبۡرَٰهِيمَ عَلَىٰ قَوۡمِهِۦۚ نَرۡفَعُ دَرَجَٰتٖ مَّن نَّشَآءُۗ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "وتلك حجتنا ءاتينٰها ابرٰهيم علىٰ قومه نرفع درجٰت من نشاء ان ربك حكيم عليم",
    "ayahnumber" : "83",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "883",
    "page" : "138",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:884",
    "ayah_text" : "وَوَهَبۡنَا لَهُۥٓ إِسۡحَٰقَ وَيَعۡقُوبَۚ كُلًّا هَدَيۡنَاۚ وَنُوحًا هَدَيۡنَا مِن قَبۡلُۖ وَمِن ذُرِّيَّتِهِۦ دَاوُۥدَ وَسُلَيۡمَٰنَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَىٰ وَهَٰرُونَۚ وَكَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "ووهبنا له اسحٰق ويعقوب كلا هدينا ونوحا هدينا من قبل ومن ذريته داود وسليمٰن وايوب ويوسف وموسىٰ وهٰرون وكذٰلك نجزي المحسنين",
    "ayahnumber" : "84",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "884",
    "page" : "138",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
