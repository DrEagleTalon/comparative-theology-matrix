    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1774",
    "ayah_text" : "وَيَقُولُ ٱلَّذِينَ كَفَرُواْ لَسۡتَ مُرۡسَلٗاۚ قُلۡ كَفَىٰ بِٱللَّهِ شَهِيدَۢا بَيۡنِي وَبَيۡنَكُمۡ وَمَنۡ عِندَهُۥ عِلۡمُ ٱلۡكِتَٰبِ",
    "ayah_text_no_diacratic" : "ويقول الذين كفروا لست مرسلا قل كفىٰ بالله شهيدا بيني وبينكم ومن عنده علم الكتٰب",
