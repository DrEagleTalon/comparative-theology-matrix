    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:2997",
    "ayah_text" : "قَالَ كَلَّاۖ فَٱذۡهَبَا بِـَٔايَٰتِنَآۖ إِنَّا مَعَكُم مُّسۡتَمِعُونَ",
    "ayah_text_no_diacratic" : "قال كلا فاذهبا بايٰتنا انا معكم مستمعون",
