    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1092",
    "ayah_text" : "قَالُوٓاْ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ",
    "ayah_text_no_diacratic" : "قالوا انا الىٰ ربنا منقلبون",
    "ayahnumber" : "125",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1092",
    "page" : "165",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1093",
    "ayah_text" : "وَمَا تَنقِمُ مِنَّآ إِلَّآ أَنۡ ءَامَنَّا بِـَٔايَٰتِ رَبِّنَا لَمَّا جَآءَتۡنَاۚ رَبَّنَآ أَفۡرِغۡ عَلَيۡنَا صَبۡرٗا وَتَوَفَّنَا مُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "وما تنقم منا الا ان ءامنا بايٰت ربنا لما جاءتنا ربنا افرغ علينا صبرا وتوفنا مسلمين",
    "ayahnumber" : "126",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1093",
    "page" : "165",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1094",
    "ayah_text" : "وَقَالَ ٱلۡمَلَأُ مِن قَوۡمِ فِرۡعَوۡنَ أَتَذَرُ مُوسَىٰ وَقَوۡمَهُۥ لِيُفۡسِدُواْ فِي ٱلۡأَرۡضِ وَيَذَرَكَ وَءَالِهَتَكَۚ قَالَ سَنُقَتِّلُ أَبۡنَآءَهُمۡ وَنَسۡتَحۡيِۦ نِسَآءَهُمۡ وَإِنَّا فَوۡقَهُمۡ قَٰهِرُونَ",
    "ayah_text_no_diacratic" : "وقال الملا من قوم فرعون اتذر موسىٰ وقومه ليفسدوا في الارض ويذرك وءالهتك قال سنقتل ابناءهم ونستحي نساءهم وانا فوقهم قٰهرون",
    "ayahnumber" : "127",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1094",
    "page" : "165",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1095",
    "ayah_text" : "قَالَ مُوسَىٰ لِقَوۡمِهِ ٱسۡتَعِينُواْ بِٱللَّهِ وَٱصۡبِرُوٓاْۖ إِنَّ ٱلۡأَرۡضَ لِلَّهِ يُورِثُهَا مَن يَشَآءُ مِنۡ عِبَادِهِۦۖ وَٱلۡعَٰقِبَةُ لِلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "قال موسىٰ لقومه استعينوا بالله واصبروا ان الارض لله يورثها من يشاء من عباده والعٰقبة للمتقين",
    "ayahnumber" : "128",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1095",
    "page" : "165",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1096",
    "ayah_text" : "قَالُوٓاْ أُوذِينَا مِن قَبۡلِ أَن تَأۡتِيَنَا وَمِنۢ بَعۡدِ مَا جِئۡتَنَاۚ قَالَ عَسَىٰ رَبُّكُمۡ أَن يُهۡلِكَ عَدُوَّكُمۡ وَيَسۡتَخۡلِفَكُمۡ فِي ٱلۡأَرۡضِ فَيَنظُرَ كَيۡفَ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "قالوا اوذينا من قبل ان تاتينا ومن بعد ما جئتنا قال عسىٰ ربكم ان يهلك عدوكم ويستخلفكم في الارض فينظر كيف تعملون",
    "ayahnumber" : "129",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1096",
    "page" : "165",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1097",
    "ayah_text" : "وَلَقَدۡ أَخَذۡنَآ ءَالَ فِرۡعَوۡنَ بِٱلسِّنِينَ وَنَقۡصٖ مِّنَ ٱلثَّمَرَٰتِ لَعَلَّهُمۡ يَذَّكَّرُونَ",
    "ayah_text_no_diacratic" : "ولقد اخذنا ءال فرعون بالسنين ونقص من الثمرٰت لعلهم يذكرون",
    "ayahnumber" : "130",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1097",
    "page" : "165",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1098",
    "ayah_text" : "فَإِذَا جَآءَتۡهُمُ ٱلۡحَسَنَةُ قَالُواْ لَنَا هَٰذِهِۦۖ وَإِن تُصِبۡهُمۡ سَيِّئَةٞ يَطَّيَّرُواْ بِمُوسَىٰ وَمَن مَّعَهُۥٓۗ أَلَآ إِنَّمَا طَٰٓئِرُهُمۡ عِندَ ٱللَّهِ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فاذا جاءتهم الحسنة قالوا لنا هٰذه وان تصبهم سيئة يطيروا بموسىٰ ومن معه الا انما طٰئرهم عند الله ولٰكن اكثرهم لا يعلمون",
    "ayahnumber" : "131",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1098",
    "page" : "166",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1099",
    "ayah_text" : "وَقَالُواْ مَهۡمَا تَأۡتِنَا بِهِۦ مِنۡ ءَايَةٖ لِّتَسۡحَرَنَا بِهَا فَمَا نَحۡنُ لَكَ بِمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وقالوا مهما تاتنا به من ءاية لتسحرنا بها فما نحن لك بمؤمنين",
    "ayahnumber" : "132",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1099",
    "page" : "166",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:11",
    "ayah_text" : "الٓمٓ",
    "ayah_text_no_diacratic" : "الم",
    "ayahnumber" : "1",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "11",
