    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3259",
    "ayah_text" : "وَكَانَ فِي ٱلۡمَدِينَةِ تِسۡعَةُ رَهۡطٖ يُفۡسِدُونَ فِي ٱلۡأَرۡضِ وَلَا يُصۡلِحُونَ",
    "ayah_text_no_diacratic" : "وكان في المدينة تسعة رهط يفسدون في الارض ولا يصلحون",
    "ayahnumber" : "48",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3259",
    "page" : "381",
