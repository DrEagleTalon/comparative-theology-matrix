  }, {
    "@id" : "quran:2984",
    "ayah_text" : "تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ",
    "ayah_text_no_diacratic" : "تلك ءايٰت الكتٰب المبين",
