    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:781",
    "ayah_text" : "مَا جَعَلَ ٱللَّهُ مِنۢ بَحِيرَةٖ وَلَا سَآئِبَةٖ وَلَا وَصِيلَةٖ وَلَا حَامٖ وَلَٰكِنَّ ٱلَّذِينَ كَفَرُواْ يَفۡتَرُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَۖ وَأَكۡثَرُهُمۡ لَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ما جعل الله من بحيرة ولا سائبة ولا وصيلة ولا حام ولٰكن الذين كفروا يفترون على الله الكذب واكثرهم لا يعقلون",
    "ayahnumber" : "103",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "781",
    "page" : "124",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:782",
    "ayah_text" : "وَإِذَا قِيلَ لَهُمۡ تَعَالَوۡاْ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ قَالُواْ حَسۡبُنَا مَا وَجَدۡنَا عَلَيۡهِ ءَابَآءَنَآۚ أَوَلَوۡ كَانَ ءَابَآؤُهُمۡ لَا يَعۡلَمُونَ شَيۡـٔٗا وَلَا يَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "واذا قيل لهم تعالوا الىٰ ما انزل الله والى الرسول قالوا حسبنا ما وجدنا عليه ءاباءنا اولو كان ءاباؤهم لا يعلمون شيا ولا يهتدون",
    "ayahnumber" : "104",
