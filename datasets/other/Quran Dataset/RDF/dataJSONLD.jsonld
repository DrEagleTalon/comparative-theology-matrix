    "page" : "460",
    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4153",
    "ayah_text" : "أَفَمَنۡ حَقَّ عَلَيۡهِ كَلِمَةُ ٱلۡعَذَابِ أَفَأَنتَ تُنقِذُ مَن فِي ٱلنَّارِ",
    "ayah_text_no_diacratic" : "افمن حق عليه كلمة العذاب افانت تنقذ من في النار",
    "ayahnumber" : "19",
    "chapter" : "23",
