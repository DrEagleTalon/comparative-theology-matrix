    "surrahname_no_diacratic" : "سورة البينة"
  }, {
    "@id" : "quran:6324",
    "ayah_text" : "رَسُولٞ مِّنَ ٱللَّهِ يَتۡلُواْ صُحُفٗا مُّطَهَّرَةٗ",
    "ayah_text_no_diacratic" : "رسول من الله يتلوا صحفا مطهرة",
