    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3189",
    "ayah_text" : "مَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يُمَتَّعُونَ",
    "ayah_text_no_diacratic" : "ما اغنىٰ عنهم ما كانوا يمتعون",
