    "surahnumber" : "83",
    "surrahname_no_diacratic" : "سورة المطففين"
  }, {
    "@id" : "quran:6043",
    "ayah_text" : "وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ",
    "ayah_text_no_diacratic" : "واذا انقلبوا الىٰ اهلهم انقلبوا فكهين",
