    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1292",
    "ayah_text" : "ٱنفِرُواْ خِفَافٗا وَثِقَالٗا وَجَٰهِدُواْ بِأَمۡوَٰلِكُمۡ وَأَنفُسِكُمۡ فِي سَبِيلِ ٱللَّهِۚ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "انفروا خفافا وثقالا وجٰهدوا باموٰلكم وانفسكم في سبيل الله ذٰلكم خير لكم ان كنتم تعلمون",
    "ayahnumber" : "41",
    "chapter" : "10",
    "hizb" : "19",
