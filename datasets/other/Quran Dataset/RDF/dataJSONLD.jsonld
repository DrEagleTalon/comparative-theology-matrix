  }, {
    "@id" : "quran:3781",
    "ayah_text" : "لِتُنذِرَ قَوۡمٗا مَّآ أُنذِرَ ءَابَآؤُهُمۡ فَهُمۡ غَٰفِلُونَ",
    "ayah_text_no_diacratic" : "لتنذر قوما ما انذر ءاباؤهم فهم غٰفلون",
    "ayahnumber" : "6",
