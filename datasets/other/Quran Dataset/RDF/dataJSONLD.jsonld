    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3937",
    "ayah_text" : "وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ",
