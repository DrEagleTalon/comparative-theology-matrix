    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:169",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَكۡتُمُونَ مَآ أَنزَلۡنَا مِنَ ٱلۡبَيِّنَٰتِ وَٱلۡهُدَىٰ مِنۢ بَعۡدِ مَا بَيَّنَّٰهُ لِلنَّاسِ فِي ٱلۡكِتَٰبِ أُوْلَٰٓئِكَ يَلۡعَنُهُمُ ٱللَّهُ وَيَلۡعَنُهُمُ ٱللَّٰعِنُونَ",
    "ayah_text_no_diacratic" : "ان الذين يكتمون ما انزلنا من البينٰت والهدىٰ من بعد ما بينٰه للناس في الكتٰب اولٰئك يلعنهم الله ويلعنهم اللٰعنون",
    "ayahnumber" : "159",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "169",
    "page" : "24",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1690",
    "ayah_text" : "قَالُواْ نَفۡقِدُ صُوَاعَ ٱلۡمَلِكِ وَلِمَن جَآءَ بِهِۦ حِمۡلُ بَعِيرٖ وَأَنَا۠ بِهِۦ زَعِيمٞ",
    "ayah_text_no_diacratic" : "قالوا نفقد صواع الملك ولمن جاء به حمل بعير وانا به زعيم",
    "ayahnumber" : "72",
    "chapter" : "13",
