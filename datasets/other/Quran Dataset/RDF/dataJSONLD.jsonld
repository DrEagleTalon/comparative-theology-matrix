    "surahnumber" : "70",
    "surrahname_no_diacratic" : "سورة المعارج"
  }, {
    "@id" : "quran:5553",
    "ayah_text" : "فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ",
    "ayah_text_no_diacratic" : "فلا اقسم برب المشٰرق والمغٰرب انا لقٰدرون",
