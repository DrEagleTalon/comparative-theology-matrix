    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3012",
    "ayah_text" : "قَالَ أَوَلَوۡ جِئۡتُكَ بِشَيۡءٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "قال اولو جئتك بشيء مبين",
