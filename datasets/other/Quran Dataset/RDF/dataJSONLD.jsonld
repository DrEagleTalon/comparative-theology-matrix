    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4564",
    "ayah_text" : "إِنَّ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ لَأٓيَٰتٖ لِّلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ان في السمٰوٰت والارض لايٰت للمؤمنين",
    "ayahnumber" : "3",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4564",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4565",
    "ayah_text" : "وَفِي خَلۡقِكُمۡ وَمَا يَبُثُّ مِن دَآبَّةٍ ءَايَٰتٞ لِّقَوۡمٖ يُوقِنُونَ",
    "ayah_text_no_diacratic" : "وفي خلقكم وما يبث من دابة ءايٰت لقوم يوقنون",
    "ayahnumber" : "4",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4565",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4566",
    "ayah_text" : "وَٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ وَمَآ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَآءِ مِن رِّزۡقٖ فَأَحۡيَا بِهِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَا وَتَصۡرِيفِ ٱلرِّيَٰحِ ءَايَٰتٞ لِّقَوۡمٖ يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "واختلٰف اليل والنهار وما انزل الله من السماء من رزق فاحيا به الارض بعد موتها وتصريف الريٰح ءايٰت لقوم يعقلون",
    "ayahnumber" : "5",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4566",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4567",
    "ayah_text" : "تِلۡكَ ءَايَٰتُ ٱللَّهِ نَتۡلُوهَا عَلَيۡكَ بِٱلۡحَقِّۖ فَبِأَيِّ حَدِيثِۭ بَعۡدَ ٱللَّهِ وَءَايَٰتِهِۦ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "تلك ءايٰت الله نتلوها عليك بالحق فباي حديث بعد الله وءايٰته يؤمنون",
    "ayahnumber" : "6",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4567",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4568",
    "ayah_text" : "وَيۡلٞ لِّكُلِّ أَفَّاكٍ أَثِيمٖ",
    "ayah_text_no_diacratic" : "ويل لكل افاك اثيم",
    "ayahnumber" : "7",
