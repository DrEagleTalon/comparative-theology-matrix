    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:5291",
    "ayah_text" : "يُرِيدُونَ لِيُطۡفِـُٔواْ نُورَ ٱللَّهِ بِأَفۡوَٰهِهِمۡ وَٱللَّهُ مُتِمُّ نُورِهِۦ وَلَوۡ كَرِهَ ٱلۡكَٰفِرُونَ",
    "ayah_text_no_diacratic" : "يريدون ليطفوا نور الله بافوٰههم والله متم نوره ولو كره الكٰفرون",
    "ayahnumber" : "8",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5291",
    "page" : "552",
    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:5292",
    "ayah_text" : "هُوَ ٱلَّذِيٓ أَرۡسَلَ رَسُولَهُۥ بِٱلۡهُدَىٰ وَدِينِ ٱلۡحَقِّ لِيُظۡهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦ وَلَوۡ كَرِهَ ٱلۡمُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "هو الذي ارسل رسوله بالهدىٰ ودين الحق ليظهره على الدين كله ولو كره المشركون",
    "ayahnumber" : "9",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5292",
    "page" : "552",
    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:5293",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ هَلۡ أَدُلُّكُمۡ عَلَىٰ تِجَٰرَةٖ تُنجِيكُم مِّنۡ عَذَابٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا هل ادلكم علىٰ تجٰرة تنجيكم من عذاب اليم",
