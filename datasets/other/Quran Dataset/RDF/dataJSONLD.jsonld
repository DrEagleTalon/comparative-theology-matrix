    "page" : "511",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4684",
    "ayah_text" : "وَلِلَّهِ جُنُودُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا",
    "ayah_text_no_diacratic" : "ولله جنود السمٰوٰت والارض وكان الله عزيزا حكيما",
