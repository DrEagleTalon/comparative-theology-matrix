    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3943",
    "ayah_text" : "۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ",
    "ayah_text_no_diacratic" : "وان من شيعته لابرٰهيم",
