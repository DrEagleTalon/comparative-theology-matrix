  }, {
    "@id" : "quran:982",
    "ayah_text" : "قَالَ إِنَّكَ مِنَ ٱلۡمُنظَرِينَ",
    "ayah_text_no_diacratic" : "قال انك من المنظرين",
    "ayahnumber" : "15",
    "chapter" : "8",
