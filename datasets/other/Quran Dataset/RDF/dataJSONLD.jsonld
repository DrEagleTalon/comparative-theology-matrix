  }, {
    "@id" : "quran:5463",
    "ayah_text" : "كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ",
    "ayah_text_no_diacratic" : "كذبت ثمود وعاد بالقارعة",
