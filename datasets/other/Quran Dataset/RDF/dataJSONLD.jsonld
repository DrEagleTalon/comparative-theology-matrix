    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1708",
    "ayah_text" : "قَالُوٓاْ أَءِنَّكَ لَأَنتَ يُوسُفُۖ قَالَ أَنَا۠ يُوسُفُ وَهَٰذَآ أَخِيۖ قَدۡ مَنَّ ٱللَّهُ عَلَيۡنَآۖ إِنَّهُۥ مَن يَتَّقِ وَيَصۡبِرۡ فَإِنَّ ٱللَّهَ لَا يُضِيعُ أَجۡرَ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "قالوا اءنك لانت يوسف قال انا يوسف وهٰذا اخي قد من الله علينا انه من يتق ويصبر فان الله لا يضيع اجر المحسنين",
    "ayahnumber" : "90",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1708",
    "page" : "246",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1709",
    "ayah_text" : "قَالُواْ تَٱللَّهِ لَقَدۡ ءَاثَرَكَ ٱللَّهُ عَلَيۡنَا وَإِن كُنَّا لَخَٰطِـِٔينَ",
    "ayah_text_no_diacratic" : "قالوا تالله لقد ءاثرك الله علينا وان كنا لخٰطين",
