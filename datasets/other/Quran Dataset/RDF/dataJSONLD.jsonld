    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:307",
    "ayah_text" : "رَبَّنَآ إِنَّكَ جَامِعُ ٱلنَّاسِ لِيَوۡمٖ لَّا رَيۡبَ فِيهِۚ إِنَّ ٱللَّهَ لَا يُخۡلِفُ ٱلۡمِيعَادَ",
    "ayah_text_no_diacratic" : "ربنا انك جامع الناس ليوم لا ريب فيه ان الله لا يخلف الميعاد",
    "ayahnumber" : "9",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "307",
    "page" : "50",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
