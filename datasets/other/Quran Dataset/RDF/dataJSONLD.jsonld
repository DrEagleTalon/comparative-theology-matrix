    "page" : "546",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5251",
    "ayah_text" : "وَٱلَّذِينَ تَبَوَّءُو ٱلدَّارَ وَٱلۡإِيمَٰنَ مِن قَبۡلِهِمۡ يُحِبُّونَ مَنۡ هَاجَرَ إِلَيۡهِمۡ وَلَا يَجِدُونَ فِي صُدُورِهِمۡ حَاجَةٗ مِّمَّآ أُوتُواْ وَيُؤۡثِرُونَ عَلَىٰٓ أَنفُسِهِمۡ وَلَوۡ كَانَ بِهِمۡ خَصَاصَةٞۚ وَمَن يُوقَ شُحَّ نَفۡسِهِۦ فَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "والذين تبوءو الدار والايمٰن من قبلهم يحبون من هاجر اليهم ولا يجدون في صدورهم حاجة مما اوتوا ويؤثرون علىٰ انفسهم ولو كان بهم خصاصة ومن يوق شح نفسه فاولٰئك هم المفلحون",
    "ayahnumber" : "9",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5251",
    "page" : "546",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5252",
    "ayah_text" : "وَٱلَّذِينَ جَآءُو مِنۢ بَعۡدِهِمۡ يَقُولُونَ رَبَّنَا ٱغۡفِرۡ لَنَا وَلِإِخۡوَٰنِنَا ٱلَّذِينَ سَبَقُونَا بِٱلۡإِيمَٰنِ وَلَا تَجۡعَلۡ فِي قُلُوبِنَا غِلّٗا لِّلَّذِينَ ءَامَنُواْ رَبَّنَآ إِنَّكَ رَءُوفٞ رَّحِيمٌ",
    "ayah_text_no_diacratic" : "والذين جاءو من بعدهم يقولون ربنا اغفر لنا ولاخوٰننا الذين سبقونا بالايمٰن ولا تجعل في قلوبنا غلا للذين ءامنوا ربنا انك رءوف رحيم",
    "ayahnumber" : "10",
    "chapter" : "28",
    "hizb" : "54",
    "index" : "5252",
    "page" : "547",
    "surahname" : "سُورَةُ الحَشۡرِ",
    "surahnumber" : "59",
    "surrahname_no_diacratic" : "سورة الحشر"
  }, {
    "@id" : "quran:5253",
    "ayah_text" : "۞أَلَمۡ تَرَ إِلَى ٱلَّذِينَ نَافَقُواْ يَقُولُونَ لِإِخۡوَٰنِهِمُ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ لَئِنۡ أُخۡرِجۡتُمۡ لَنَخۡرُجَنَّ مَعَكُمۡ وَلَا نُطِيعُ فِيكُمۡ أَحَدًا أَبَدٗا وَإِن قُوتِلۡتُمۡ لَنَنصُرَنَّكُمۡ وَٱللَّهُ يَشۡهَدُ إِنَّهُمۡ لَكَٰذِبُونَ",
    "ayah_text_no_diacratic" : "الم تر الى الذين نافقوا يقولون لاخوٰنهم الذين كفروا من اهل الكتٰب لئن اخرجتم لنخرجن معكم ولا نطيع فيكم احدا ابدا وان قوتلتم لننصرنكم والله يشهد انهم لكٰذبون",
    "ayahnumber" : "11",
    "chapter" : "28",
    "hizb" : "54",
