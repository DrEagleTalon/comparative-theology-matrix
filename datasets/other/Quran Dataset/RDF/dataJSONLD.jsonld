    "surrahname_no_diacratic" : "سورة الدخان"
  }, {
    "@id" : "quran:455",
    "ayah_text" : "وَلَئِن قُتِلۡتُمۡ فِي سَبِيلِ ٱللَّهِ أَوۡ مُتُّمۡ لَمَغۡفِرَةٞ مِّنَ ٱللَّهِ وَرَحۡمَةٌ خَيۡرٞ مِّمَّا يَجۡمَعُونَ",
    "ayah_text_no_diacratic" : "ولئن قتلتم في سبيل الله او متم لمغفرة من الله ورحمة خير مما يجمعون",
    "ayahnumber" : "157",
