    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5434",
    "ayah_text" : "قَالُواْ سُبۡحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ",
    "ayah_text_no_diacratic" : "قالوا سبحٰن ربنا انا كنا ظٰلمين",
