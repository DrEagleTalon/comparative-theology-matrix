    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:886",
    "ayah_text" : "وَإِسۡمَٰعِيلَ وَٱلۡيَسَعَ وَيُونُسَ وَلُوطٗاۚ وَكُلّٗا فَضَّلۡنَا عَلَى ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "واسمٰعيل واليسع ويونس ولوطا وكلا فضلنا على العٰلمين",
