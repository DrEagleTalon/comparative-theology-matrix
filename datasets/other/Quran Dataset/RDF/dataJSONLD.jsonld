  }, {
    "@id" : "quran:5633",
    "ayah_text" : "يَوۡمَ تَرۡجُفُ ٱلۡأَرۡضُ وَٱلۡجِبَالُ وَكَانَتِ ٱلۡجِبَالُ كَثِيبٗا مَّهِيلًا",
    "ayah_text_no_diacratic" : "يوم ترجف الارض والجبال وكانت الجبال كثيبا مهيلا",
