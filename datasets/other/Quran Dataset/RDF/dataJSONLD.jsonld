  }, {
    "@id" : "quran:2949",
    "ayah_text" : "ثُمَّ قَبَضۡنَٰهُ إِلَيۡنَا قَبۡضٗا يَسِيرٗا",
    "ayah_text_no_diacratic" : "ثم قبضنٰه الينا قبضا يسيرا",
