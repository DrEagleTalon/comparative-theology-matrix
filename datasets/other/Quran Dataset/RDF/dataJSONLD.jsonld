    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1674",
    "ayah_text" : "وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِي ٱلۡأَرۡضِ يَتَبَوَّأُ مِنۡهَا حَيۡثُ يَشَآءُۚ نُصِيبُ بِرَحۡمَتِنَا مَن نَّشَآءُۖ وَلَا نُضِيعُ أَجۡرَ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "وكذٰلك مكنا ليوسف في الارض يتبوا منها حيث يشاء نصيب برحمتنا من نشاء ولا نضيع اجر المحسنين",
    "ayahnumber" : "56",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1674",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1675",
    "ayah_text" : "وَلَأَجۡرُ ٱلۡأٓخِرَةِ خَيۡرٞ لِّلَّذِينَ ءَامَنُواْ وَكَانُواْ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "ولاجر الاخرة خير للذين ءامنوا وكانوا يتقون",
    "ayahnumber" : "57",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1675",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1676",
    "ayah_text" : "وَجَآءَ إِخۡوَةُ يُوسُفَ فَدَخَلُواْ عَلَيۡهِ فَعَرَفَهُمۡ وَهُمۡ لَهُۥ مُنكِرُونَ",
    "ayah_text_no_diacratic" : "وجاء اخوة يوسف فدخلوا عليه فعرفهم وهم له منكرون",
    "ayahnumber" : "58",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1676",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1677",
    "ayah_text" : "وَلَمَّا جَهَّزَهُم بِجَهَازِهِمۡ قَالَ ٱئۡتُونِي بِأَخٖ لَّكُم مِّنۡ أَبِيكُمۡۚ أَلَا تَرَوۡنَ أَنِّيٓ أُوفِي ٱلۡكَيۡلَ وَأَنَا۠ خَيۡرُ ٱلۡمُنزِلِينَ",
    "ayah_text_no_diacratic" : "ولما جهزهم بجهازهم قال ائتوني باخ لكم من ابيكم الا ترون اني اوفي الكيل وانا خير المنزلين",
    "ayahnumber" : "59",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1677",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1678",
    "ayah_text" : "فَإِن لَّمۡ تَأۡتُونِي بِهِۦ فَلَا كَيۡلَ لَكُمۡ عِندِي وَلَا تَقۡرَبُونِ",
    "ayah_text_no_diacratic" : "فان لم تاتوني به فلا كيل لكم عندي ولا تقربون",
    "ayahnumber" : "60",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1678",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1679",
    "ayah_text" : "قَالُواْ سَنُرَٰوِدُ عَنۡهُ أَبَاهُ وَإِنَّا لَفَٰعِلُونَ",
    "ayah_text_no_diacratic" : "قالوا سنرٰود عنه اباه وانا لفٰعلون",
    "ayahnumber" : "61",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1679",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:168",
    "ayah_text" : "۞إِنَّ ٱلصَّفَا وَٱلۡمَرۡوَةَ مِن شَعَآئِرِ ٱللَّهِۖ فَمَنۡ حَجَّ ٱلۡبَيۡتَ أَوِ ٱعۡتَمَرَ فَلَا جُنَاحَ عَلَيۡهِ أَن يَطَّوَّفَ بِهِمَاۚ وَمَن تَطَوَّعَ خَيۡرٗا فَإِنَّ ٱللَّهَ شَاكِرٌ عَلِيمٌ",
    "ayah_text_no_diacratic" : "ان الصفا والمروة من شعائر الله فمن حج البيت او اعتمر فلا جناح عليه ان يطوف بهما ومن تطوع خيرا فان الله شاكر عليم",
    "ayahnumber" : "158",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "168",
    "page" : "24",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1680",
    "ayah_text" : "وَقَالَ لِفِتۡيَٰنِهِ ٱجۡعَلُواْ بِضَٰعَتَهُمۡ فِي رِحَالِهِمۡ لَعَلَّهُمۡ يَعۡرِفُونَهَآ إِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمۡ لَعَلَّهُمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "وقال لفتيٰنه اجعلوا بضٰعتهم في رحالهم لعلهم يعرفونها اذا انقلبوا الىٰ اهلهم لعلهم يرجعون",
    "ayahnumber" : "62",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1680",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1681",
    "ayah_text" : "فَلَمَّا رَجَعُوٓاْ إِلَىٰٓ أَبِيهِمۡ قَالُواْ يَٰٓأَبَانَا مُنِعَ مِنَّا ٱلۡكَيۡلُ فَأَرۡسِلۡ مَعَنَآ أَخَانَا نَكۡتَلۡ وَإِنَّا لَهُۥ لَحَٰفِظُونَ",
    "ayah_text_no_diacratic" : "فلما رجعوا الىٰ ابيهم قالوا يٰابانا منع منا الكيل فارسل معنا اخانا نكتل وانا له لحٰفظون",
    "ayahnumber" : "63",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1681",
    "page" : "242",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1682",
    "ayah_text" : "قَالَ هَلۡ ءَامَنُكُمۡ عَلَيۡهِ إِلَّا كَمَآ أَمِنتُكُمۡ عَلَىٰٓ أَخِيهِ مِن قَبۡلُ فَٱللَّهُ خَيۡرٌ حَٰفِظٗاۖ وَهُوَ أَرۡحَمُ ٱلرَّٰحِمِينَ",
    "ayah_text_no_diacratic" : "قال هل ءامنكم عليه الا كما امنتكم علىٰ اخيه من قبل فالله خير حٰفظا وهو ارحم الرٰحمين",
    "ayahnumber" : "64",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1682",
    "page" : "243",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1683",
    "ayah_text" : "وَلَمَّا فَتَحُواْ مَتَٰعَهُمۡ وَجَدُواْ بِضَٰعَتَهُمۡ رُدَّتۡ إِلَيۡهِمۡۖ قَالُواْ يَٰٓأَبَانَا مَا نَبۡغِيۖ هَٰذِهِۦ بِضَٰعَتُنَا رُدَّتۡ إِلَيۡنَاۖ وَنَمِيرُ أَهۡلَنَا وَنَحۡفَظُ أَخَانَا وَنَزۡدَادُ كَيۡلَ بَعِيرٖۖ ذَٰلِكَ كَيۡلٞ يَسِيرٞ",
    "ayah_text_no_diacratic" : "ولما فتحوا متٰعهم وجدوا بضٰعتهم ردت اليهم قالوا يٰابانا ما نبغي هٰذه بضٰعتنا ردت الينا ونمير اهلنا ونحفظ اخانا ونزداد كيل بعير ذٰلك كيل يسير",
    "ayahnumber" : "65",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1683",
    "page" : "243",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1684",
    "ayah_text" : "قَالَ لَنۡ أُرۡسِلَهُۥ مَعَكُمۡ حَتَّىٰ تُؤۡتُونِ مَوۡثِقٗا مِّنَ ٱللَّهِ لَتَأۡتُنَّنِي بِهِۦٓ إِلَّآ أَن يُحَاطَ بِكُمۡۖ فَلَمَّآ ءَاتَوۡهُ مَوۡثِقَهُمۡ قَالَ ٱللَّهُ عَلَىٰ مَا نَقُولُ وَكِيلٞ",
    "ayah_text_no_diacratic" : "قال لن ارسله معكم حتىٰ تؤتون موثقا من الله لتاتنني به الا ان يحاط بكم فلما ءاتوه موثقهم قال الله علىٰ ما نقول وكيل",
    "ayahnumber" : "66",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1684",
    "page" : "243",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1685",
    "ayah_text" : "وَقَالَ يَٰبَنِيَّ لَا تَدۡخُلُواْ مِنۢ بَابٖ وَٰحِدٖ وَٱدۡخُلُواْ مِنۡ أَبۡوَٰبٖ مُّتَفَرِّقَةٖۖ وَمَآ أُغۡنِي عَنكُم مِّنَ ٱللَّهِ مِن شَيۡءٍۖ إِنِ ٱلۡحُكۡمُ إِلَّا لِلَّهِۖ عَلَيۡهِ تَوَكَّلۡتُۖ وَعَلَيۡهِ فَلۡيَتَوَكَّلِ ٱلۡمُتَوَكِّلُونَ",
    "ayah_text_no_diacratic" : "وقال يٰبني لا تدخلوا من باب وٰحد وادخلوا من ابوٰب متفرقة وما اغني عنكم من الله من شيء ان الحكم الا لله عليه توكلت وعليه فليتوكل المتوكلون",
    "ayahnumber" : "67",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1685",
    "page" : "243",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1686",
    "ayah_text" : "وَلَمَّا دَخَلُواْ مِنۡ حَيۡثُ أَمَرَهُمۡ أَبُوهُم مَّا كَانَ يُغۡنِي عَنۡهُم مِّنَ ٱللَّهِ مِن شَيۡءٍ إِلَّا حَاجَةٗ فِي نَفۡسِ يَعۡقُوبَ قَضَىٰهَاۚ وَإِنَّهُۥ لَذُو عِلۡمٖ لِّمَا عَلَّمۡنَٰهُ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولما دخلوا من حيث امرهم ابوهم ما كان يغني عنهم من الله من شيء الا حاجة في نفس يعقوب قضىٰها وانه لذو علم لما علمنٰه ولٰكن اكثر الناس لا يعلمون",
    "ayahnumber" : "68",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1686",
    "page" : "243",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1687",
    "ayah_text" : "وَلَمَّا دَخَلُواْ عَلَىٰ يُوسُفَ ءَاوَىٰٓ إِلَيۡهِ أَخَاهُۖ قَالَ إِنِّيٓ أَنَا۠ أَخُوكَ فَلَا تَبۡتَئِسۡ بِمَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ولما دخلوا علىٰ يوسف ءاوىٰ اليه اخاه قال اني انا اخوك فلا تبتئس بما كانوا يعملون",
    "ayahnumber" : "69",
