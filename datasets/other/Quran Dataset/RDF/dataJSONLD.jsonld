    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2302",
    "ayah_text" : "وَٱذۡكُرۡ فِي ٱلۡكِتَٰبِ مَرۡيَمَ إِذِ ٱنتَبَذَتۡ مِنۡ أَهۡلِهَا مَكَانٗا شَرۡقِيّٗا",
    "ayah_text_no_diacratic" : "واذكر في الكتٰب مريم اذ انتبذت من اهلها مكانا شرقيا",
