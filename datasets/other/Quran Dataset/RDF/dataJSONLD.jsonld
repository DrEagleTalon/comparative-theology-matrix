  }, {
    "@id" : "quran:1149",
    "ayah_text" : "وَٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا سَنَسۡتَدۡرِجُهُم مِّنۡ حَيۡثُ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "والذين كذبوا بايٰتنا سنستدرجهم من حيث لا يعلمون",
    "ayahnumber" : "182",
