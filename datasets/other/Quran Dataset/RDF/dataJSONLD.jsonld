    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4876",
    "ayah_text" : "أَمۡ لَهُ ٱلۡبَنَٰتُ وَلَكُمُ ٱلۡبَنُونَ",
    "ayah_text_no_diacratic" : "ام له البنٰت ولكم البنون",
    "ayahnumber" : "39",
    "chapter" : "27",
