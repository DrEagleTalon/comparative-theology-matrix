    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1771",
    "ayah_text" : "وَإِن مَّا نُرِيَنَّكَ بَعۡضَ ٱلَّذِي نَعِدُهُمۡ أَوۡ نَتَوَفَّيَنَّكَ فَإِنَّمَا عَلَيۡكَ ٱلۡبَلَٰغُ وَعَلَيۡنَا ٱلۡحِسَابُ",
    "ayah_text_no_diacratic" : "وان ما نرينك بعض الذي نعدهم او نتوفينك فانما عليك البلٰغ وعلينا الحساب",
