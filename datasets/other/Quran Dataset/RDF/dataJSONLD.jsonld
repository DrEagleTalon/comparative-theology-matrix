    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3880",
    "ayah_text" : "وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ",
    "ayah_text_no_diacratic" : "وقالوا يٰويلنا هٰذا يوم الدين",
