    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:873",
    "ayah_text" : "وَهُوَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۖ وَيَوۡمَ يَقُولُ كُن فَيَكُونُۚ قَوۡلُهُ ٱلۡحَقُّۚ وَلَهُ ٱلۡمُلۡكُ يَوۡمَ يُنفَخُ فِي ٱلصُّورِۚ عَٰلِمُ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِۚ وَهُوَ ٱلۡحَكِيمُ ٱلۡخَبِيرُ",
    "ayah_text_no_diacratic" : "وهو الذي خلق السمٰوٰت والارض بالحق ويوم يقول كن فيكون قوله الحق وله الملك يوم ينفخ في الصور عٰلم الغيب والشهٰدة وهو الحكيم الخبير",
    "ayahnumber" : "73",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "873",
    "page" : "136",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:874",
    "ayah_text" : "۞وَإِذۡ قَالَ إِبۡرَٰهِيمُ لِأَبِيهِ ءَازَرَ أَتَتَّخِذُ أَصۡنَامًا ءَالِهَةً إِنِّيٓ أَرَىٰكَ وَقَوۡمَكَ فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "واذ قال ابرٰهيم لابيه ءازر اتتخذ اصناما ءالهة اني ارىٰك وقومك في ضلٰل مبين",
    "ayahnumber" : "74",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "874",
    "page" : "137",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:875",
    "ayah_text" : "وَكَذَٰلِكَ نُرِيٓ إِبۡرَٰهِيمَ مَلَكُوتَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَلِيَكُونَ مِنَ ٱلۡمُوقِنِينَ",
    "ayah_text_no_diacratic" : "وكذٰلك نري ابرٰهيم ملكوت السمٰوٰت والارض وليكون من الموقنين",
