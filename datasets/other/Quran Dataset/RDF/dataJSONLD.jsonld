    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4721",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ إِنَّا خَلَقۡنَٰكُم مِّن ذَكَرٖ وَأُنثَىٰ وَجَعَلۡنَٰكُمۡ شُعُوبٗا وَقَبَآئِلَ لِتَعَارَفُوٓاْۚ إِنَّ أَكۡرَمَكُمۡ عِندَ ٱللَّهِ أَتۡقَىٰكُمۡۚ إِنَّ ٱللَّهَ عَلِيمٌ خَبِيرٞ",
    "ayah_text_no_diacratic" : "يٰايها الناس انا خلقنٰكم من ذكر وانثىٰ وجعلنٰكم شعوبا وقبائل لتعارفوا ان اكرمكم عند الله اتقىٰكم ان الله عليم خبير",
    "ayahnumber" : "13",
    "chapter" : "26",
