    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1355",
    "ayah_text" : "أَلَمۡ يَعۡلَمُوٓاْ أَنَّ ٱللَّهَ هُوَ يَقۡبَلُ ٱلتَّوۡبَةَ عَنۡ عِبَادِهِۦ وَيَأۡخُذُ ٱلصَّدَقَٰتِ وَأَنَّ ٱللَّهَ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "الم يعلموا ان الله هو يقبل التوبة عن عباده وياخذ الصدقٰت وان الله هو التواب الرحيم",
    "ayahnumber" : "104",
    "chapter" : "11",
