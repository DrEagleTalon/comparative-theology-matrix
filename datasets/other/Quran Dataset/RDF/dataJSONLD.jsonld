    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:780",
    "ayah_text" : "قَدۡ سَأَلَهَا قَوۡمٞ مِّن قَبۡلِكُمۡ ثُمَّ أَصۡبَحُواْ بِهَا كَٰفِرِينَ",
    "ayah_text_no_diacratic" : "قد سالها قوم من قبلكم ثم اصبحوا بها كٰفرين",
