    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:301",
    "ayah_text" : "نَزَّلَ عَلَيۡكَ ٱلۡكِتَٰبَ بِٱلۡحَقِّ مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ وَأَنزَلَ ٱلتَّوۡرَىٰةَ وَٱلۡإِنجِيلَ",
    "ayah_text_no_diacratic" : "نزل عليك الكتٰب بالحق مصدقا لما بين يديه وانزل التورىٰة والانجيل",
