    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4438",
    "ayah_text" : "بَلۡ مَتَّعۡتُ هَٰٓؤُلَآءِ وَءَابَآءَهُمۡ حَتَّىٰ جَآءَهُمُ ٱلۡحَقُّ وَرَسُولٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "بل متعت هٰؤلاء وءاباءهم حتىٰ جاءهم الحق ورسول مبين",
    "ayahnumber" : "29",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4438",
