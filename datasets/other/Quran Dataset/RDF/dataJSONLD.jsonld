  }, {
    "@id" : "quran:4538",
    "ayah_text" : "وَمَا خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا لَٰعِبِينَ",
    "ayah_text_no_diacratic" : "وما خلقنا السمٰوٰت والارض وما بينهما لٰعبين",
