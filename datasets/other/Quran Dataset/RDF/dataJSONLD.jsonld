    "surrahname_no_diacratic" : "سورة البروج"
  }, {
    "@id" : "quran:608",
    "ayah_text" : "يَسۡتَخۡفُونَ مِنَ ٱلنَّاسِ وَلَا يَسۡتَخۡفُونَ مِنَ ٱللَّهِ وَهُوَ مَعَهُمۡ إِذۡ يُبَيِّتُونَ مَا لَا يَرۡضَىٰ مِنَ ٱلۡقَوۡلِۚ وَكَانَ ٱللَّهُ بِمَا يَعۡمَلُونَ مُحِيطًا",
    "ayah_text_no_diacratic" : "يستخفون من الناس ولا يستخفون من الله وهو معهم اذ يبيتون ما لا يرضىٰ من القول وكان الله بما يعملون محيطا",
