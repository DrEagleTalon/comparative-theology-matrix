    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3959",
    "ayah_text" : "وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ",
    "ayah_text_no_diacratic" : "وقال اني ذاهب الىٰ ربي سيهدين",
    "ayahnumber" : "99",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "3959",
