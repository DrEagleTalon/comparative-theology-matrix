  }, {
    "@id" : "quran:2040",
    "ayah_text" : "لَا جَرَمَ أَنَّهُمۡ فِي ٱلۡأٓخِرَةِ هُمُ ٱلۡخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "لا جرم انهم في الاخرة هم الخٰسرون",
    "ayahnumber" : "109",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2040",
