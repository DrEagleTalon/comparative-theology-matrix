    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2907",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُوٓاْ إِنۡ هَٰذَآ إِلَّآ إِفۡكٌ ٱفۡتَرَىٰهُ وَأَعَانَهُۥ عَلَيۡهِ قَوۡمٌ ءَاخَرُونَۖ فَقَدۡ جَآءُو ظُلۡمٗا وَزُورٗا",
    "ayah_text_no_diacratic" : "وقال الذين كفروا ان هٰذا الا افك افترىٰه واعانه عليه قوم ءاخرون فقد جاءو ظلما وزورا",
    "ayahnumber" : "4",
    "chapter" : "18",
    "hizb" : "36",
