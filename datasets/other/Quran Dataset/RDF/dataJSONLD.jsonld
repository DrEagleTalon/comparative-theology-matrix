  }, {
    "@id" : "quran:1151",
    "ayah_text" : "أَوَلَمۡ يَتَفَكَّرُواْۗ مَا بِصَاحِبِهِم مِّن جِنَّةٍۚ إِنۡ هُوَ إِلَّا نَذِيرٞ مُّبِينٌ",
    "ayah_text_no_diacratic" : "اولم يتفكروا ما بصاحبهم من جنة ان هو الا نذير مبين",
    "ayahnumber" : "184",
    "chapter" : "9",
    "hizb" : "17",
