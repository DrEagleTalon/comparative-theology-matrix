    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3926",
    "ayah_text" : "فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
    "ayah_text_no_diacratic" : "فانهم لاكلون منها فمالون منها البطون",
    "ayahnumber" : "66",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3926",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3927",
    "ayah_text" : "ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ",
    "ayah_text_no_diacratic" : "ثم ان لهم عليها لشوبا من حميم",
    "ayahnumber" : "67",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3927",
