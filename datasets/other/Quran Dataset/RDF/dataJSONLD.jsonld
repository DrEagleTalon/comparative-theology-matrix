    "chapter" : "26",
    "hizb" : "51",
    "index" : "4712",
    "page" : "515",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4713",
    "ayah_text" : "وَلَوۡ أَنَّهُمۡ صَبَرُواْ حَتَّىٰ تَخۡرُجَ إِلَيۡهِمۡ لَكَانَ خَيۡرٗا لَّهُمۡۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "ولو انهم صبروا حتىٰ تخرج اليهم لكان خيرا لهم والله غفور رحيم",
