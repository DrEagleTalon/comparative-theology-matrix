    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4820",
    "ayah_text" : "فَمَا ٱسۡتَطَٰعُواْ مِن قِيَامٖ وَمَا كَانُواْ مُنتَصِرِينَ",
    "ayah_text_no_diacratic" : "فما استطٰعوا من قيام وما كانوا منتصرين",
