  }, {
    "@id" : "quran:4685",
    "ayah_text" : "إِنَّآ أَرۡسَلۡنَٰكَ شَٰهِدٗا وَمُبَشِّرٗا وَنَذِيرٗا",
    "ayah_text_no_diacratic" : "انا ارسلنٰك شٰهدا ومبشرا ونذيرا",
    "ayahnumber" : "8",
    "chapter" : "26",
