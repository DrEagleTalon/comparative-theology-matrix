    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1881",
    "ayah_text" : "وَنَبِّئۡهُمۡ عَن ضَيۡفِ إِبۡرَٰهِيمَ",
    "ayah_text_no_diacratic" : "ونبئهم عن ضيف ابرٰهيم",
    "ayahnumber" : "51",
