    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2305",
    "ayah_text" : "قَالَ إِنَّمَآ أَنَا۠ رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُلَٰمٗا زَكِيّٗا",
    "ayah_text_no_diacratic" : "قال انما انا رسول ربك لاهب لك غلٰما زكيا",
