  }, {
    "@id" : "quran:855",
    "ayah_text" : "وَكَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ وَلِتَسۡتَبِينَ سَبِيلُ ٱلۡمُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "وكذٰلك نفصل الايٰت ولتستبين سبيل المجرمين",
