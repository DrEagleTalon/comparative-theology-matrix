    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4931",
    "ayah_text" : "وَأَنَّهُۥ هُوَ أَضۡحَكَ وَأَبۡكَىٰ",
    "ayah_text_no_diacratic" : "وانه هو اضحك وابكىٰ",
    "ayahnumber" : "43",
    "chapter" : "27",
