  }, {
    "@id" : "quran:3567",
    "ayah_text" : "تَنزِيلُ ٱلۡكِتَٰبِ لَا رَيۡبَ فِيهِ مِن رَّبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "تنزيل الكتٰب لا ريب فيه من رب العٰلمين",
    "ayahnumber" : "2",
    "chapter" : "21",
    "hizb" : "41",
