    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2398",
    "ayah_text" : "إِنِّيٓ أَنَا۠ رَبُّكَ فَٱخۡلَعۡ نَعۡلَيۡكَ إِنَّكَ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوٗى",
    "ayah_text_no_diacratic" : "اني انا ربك فاخلع نعليك انك بالواد المقدس طوى",
