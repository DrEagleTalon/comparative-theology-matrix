    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2744",
    "ayah_text" : "فَأَوۡحَيۡنَآ إِلَيۡهِ أَنِ ٱصۡنَعِ ٱلۡفُلۡكَ بِأَعۡيُنِنَا وَوَحۡيِنَا فَإِذَا جَآءَ أَمۡرُنَا وَفَارَ ٱلتَّنُّورُ فَٱسۡلُكۡ فِيهَا مِن كُلّٖ زَوۡجَيۡنِ ٱثۡنَيۡنِ وَأَهۡلَكَ إِلَّا مَن سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ مِنۡهُمۡۖ وَلَا تُخَٰطِبۡنِي فِي ٱلَّذِينَ ظَلَمُوٓاْ إِنَّهُم مُّغۡرَقُونَ",
    "ayah_text_no_diacratic" : "فاوحينا اليه ان اصنع الفلك باعيننا ووحينا فاذا جاء امرنا وفار التنور فاسلك فيها من كل زوجين اثنين واهلك الا من سبق عليه القول منهم ولا تخٰطبني في الذين ظلموا انهم مغرقون",
    "ayahnumber" : "27",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2744",
    "page" : "343",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2745",
    "ayah_text" : "فَإِذَا ٱسۡتَوَيۡتَ أَنتَ وَمَن مَّعَكَ عَلَى ٱلۡفُلۡكِ فَقُلِ ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي نَجَّىٰنَا مِنَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "فاذا استويت انت ومن معك على الفلك فقل الحمد لله الذي نجىٰنا من القوم الظٰلمين",
    "ayahnumber" : "28",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2745",
    "page" : "344",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2746",
    "ayah_text" : "وَقُل رَّبِّ أَنزِلۡنِي مُنزَلٗا مُّبَارَكٗا وَأَنتَ خَيۡرُ ٱلۡمُنزِلِينَ",
    "ayah_text_no_diacratic" : "وقل رب انزلني منزلا مباركا وانت خير المنزلين",
    "ayahnumber" : "29",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2746",
    "page" : "344",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2747",
    "ayah_text" : "إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ وَإِن كُنَّا لَمُبۡتَلِينَ",
    "ayah_text_no_diacratic" : "ان في ذٰلك لايٰت وان كنا لمبتلين",
    "ayahnumber" : "30",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2747",
    "page" : "344",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2748",
    "ayah_text" : "ثُمَّ أَنشَأۡنَا مِنۢ بَعۡدِهِمۡ قَرۡنًا ءَاخَرِينَ",
    "ayah_text_no_diacratic" : "ثم انشانا من بعدهم قرنا ءاخرين",
    "ayahnumber" : "31",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2748",
    "page" : "344",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2749",
    "ayah_text" : "فَأَرۡسَلۡنَا فِيهِمۡ رَسُولٗا مِّنۡهُمۡ أَنِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓۚ أَفَلَا تَتَّقُونَ",
    "ayah_text_no_diacratic" : "فارسلنا فيهم رسولا منهم ان اعبدوا الله ما لكم من الٰه غيره افلا تتقون",
    "ayahnumber" : "32",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2749",
    "page" : "344",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:275",
    "ayah_text" : "وَمَثَلُ ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُمُ ٱبۡتِغَآءَ مَرۡضَاتِ ٱللَّهِ وَتَثۡبِيتٗا مِّنۡ أَنفُسِهِمۡ كَمَثَلِ جَنَّةِۭ بِرَبۡوَةٍ أَصَابَهَا وَابِلٞ فَـَٔاتَتۡ أُكُلَهَا ضِعۡفَيۡنِ فَإِن لَّمۡ يُصِبۡهَا وَابِلٞ فَطَلّٞۗ وَٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرٌ",
    "ayah_text_no_diacratic" : "ومثل الذين ينفقون اموٰلهم ابتغاء مرضات الله وتثبيتا من انفسهم كمثل جنة بربوة اصابها وابل فاتت اكلها ضعفين فان لم يصبها وابل فطل والله بما تعملون بصير",
    "ayahnumber" : "265",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "275",
    "page" : "45",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2750",
    "ayah_text" : "وَقَالَ ٱلۡمَلَأُ مِن قَوۡمِهِ ٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِلِقَآءِ ٱلۡأٓخِرَةِ وَأَتۡرَفۡنَٰهُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا مَا هَٰذَآ إِلَّا بَشَرٞ مِّثۡلُكُمۡ يَأۡكُلُ مِمَّا تَأۡكُلُونَ مِنۡهُ وَيَشۡرَبُ مِمَّا تَشۡرَبُونَ",
    "ayah_text_no_diacratic" : "وقال الملا من قومه الذين كفروا وكذبوا بلقاء الاخرة واترفنٰهم في الحيوٰة الدنيا ما هٰذا الا بشر مثلكم ياكل مما تاكلون منه ويشرب مما تشربون",
    "ayahnumber" : "33",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2750",
    "page" : "344",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2751",
    "ayah_text" : "وَلَئِنۡ أَطَعۡتُم بَشَرٗا مِّثۡلَكُمۡ إِنَّكُمۡ إِذٗا لَّخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "ولئن اطعتم بشرا مثلكم انكم اذا لخٰسرون",
    "ayahnumber" : "34",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2751",
