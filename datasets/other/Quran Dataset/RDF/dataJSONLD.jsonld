    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3922",
    "ayah_text" : "أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ",
    "ayah_text_no_diacratic" : "اذٰلك خير نزلا ام شجرة الزقوم",
