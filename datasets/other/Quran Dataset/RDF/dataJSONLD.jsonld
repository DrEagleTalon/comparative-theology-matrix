  }, {
    "@id" : "quran:2688",
    "ayah_text" : "وَٱلَّذِينَ سَعَوۡاْ فِيٓ ءَايَٰتِنَا مُعَٰجِزِينَ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "والذين سعوا في ءايٰتنا معٰجزين اولٰئك اصحٰب الجحيم",
    "ayahnumber" : "51",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2688",
