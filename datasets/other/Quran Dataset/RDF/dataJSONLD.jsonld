    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1141",
    "ayah_text" : "وَكَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ وَلَعَلَّهُمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "وكذٰلك نفصل الايٰت ولعلهم يرجعون",
    "ayahnumber" : "174",
    "chapter" : "9",
