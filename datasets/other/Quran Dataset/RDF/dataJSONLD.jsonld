    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2030",
    "ayah_text" : "إِنَّهُۥ لَيۡسَ لَهُۥ سُلۡطَٰنٌ عَلَى ٱلَّذِينَ ءَامَنُواْ وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ",
    "ayah_text_no_diacratic" : "انه ليس له سلطٰن على الذين ءامنوا وعلىٰ ربهم يتوكلون",
    "ayahnumber" : "99",
    "chapter" : "14",
