  }, {
    "@id" : "quran:1367",
    "ayah_text" : "إِنَّ ٱللَّهَ لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ يُحۡيِۦ وَيُمِيتُۚ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِيّٖ وَلَا نَصِيرٖ",
    "ayah_text_no_diacratic" : "ان الله له ملك السمٰوٰت والارض يحي ويميت وما لكم من دون الله من ولي ولا نصير",
    "ayahnumber" : "116",
    "chapter" : "11",
