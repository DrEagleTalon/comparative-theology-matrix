    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3951",
    "ayah_text" : "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ",
