    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2884",
    "ayah_text" : "وَيَقُولُونَ ءَامَنَّا بِٱللَّهِ وَبِٱلرَّسُولِ وَأَطَعۡنَا ثُمَّ يَتَوَلَّىٰ فَرِيقٞ مِّنۡهُم مِّنۢ بَعۡدِ ذَٰلِكَۚ وَمَآ أُوْلَٰٓئِكَ بِٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ويقولون ءامنا بالله وبالرسول واطعنا ثم يتولىٰ فريق منهم من بعد ذٰلك وما اولٰئك بالمؤمنين",
    "ayahnumber" : "47",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2884",
    "page" : "356",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2885",
    "ayah_text" : "وَإِذَا دُعُوٓاْ إِلَى ٱللَّهِ وَرَسُولِهِۦ لِيَحۡكُمَ بَيۡنَهُمۡ إِذَا فَرِيقٞ مِّنۡهُم مُّعۡرِضُونَ",
    "ayah_text_no_diacratic" : "واذا دعوا الى الله ورسوله ليحكم بينهم اذا فريق منهم معرضون",
    "ayahnumber" : "48",
    "chapter" : "18",
    "hizb" : "35",
