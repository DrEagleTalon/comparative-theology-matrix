    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:869",
    "ayah_text" : "وَمَا عَلَى ٱلَّذِينَ يَتَّقُونَ مِنۡ حِسَابِهِم مِّن شَيۡءٖ وَلَٰكِن ذِكۡرَىٰ لَعَلَّهُمۡ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "وما على الذين يتقون من حسابهم من شيء ولٰكن ذكرىٰ لعلهم يتقون",
