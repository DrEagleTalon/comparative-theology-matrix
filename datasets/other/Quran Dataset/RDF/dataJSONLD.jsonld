    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2306",
    "ayah_text" : "قَالَتۡ أَنَّىٰ يَكُونُ لِي غُلَٰمٞ وَلَمۡ يَمۡسَسۡنِي بَشَرٞ وَلَمۡ أَكُ بَغِيّٗا",
    "ayah_text_no_diacratic" : "قالت انىٰ يكون لي غلٰم ولم يمسسني بشر ولم اك بغيا",
