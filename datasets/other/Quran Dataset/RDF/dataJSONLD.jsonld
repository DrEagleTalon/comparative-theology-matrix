  }, {
    "@id" : "quran:2376",
    "ayah_text" : "تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرۡنَ مِنۡهُ وَتَنشَقُّ ٱلۡأَرۡضُ وَتَخِرُّ ٱلۡجِبَالُ هَدًّا",
    "ayah_text_no_diacratic" : "تكاد السمٰوٰت يتفطرن منه وتنشق الارض وتخر الجبال هدا",
    "ayahnumber" : "90",
    "chapter" : "16",
    "hizb" : "31",
