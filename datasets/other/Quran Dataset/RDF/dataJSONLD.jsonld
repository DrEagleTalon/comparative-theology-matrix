  }, {
    "@id" : "quran:647",
    "ayah_text" : "مَّا يَفۡعَلُ ٱللَّهُ بِعَذَابِكُمۡ إِن شَكَرۡتُمۡ وَءَامَنتُمۡۚ وَكَانَ ٱللَّهُ شَاكِرًا عَلِيمٗا",
    "ayah_text_no_diacratic" : "ما يفعل الله بعذابكم ان شكرتم وءامنتم وكان الله شاكرا عليما",
    "ayahnumber" : "147",
    "chapter" : "5",
    "hizb" : "10",
    "index" : "647",
    "page" : "101",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:648",
    "ayah_text" : "۞لَّا يُحِبُّ ٱللَّهُ ٱلۡجَهۡرَ بِٱلسُّوٓءِ مِنَ ٱلۡقَوۡلِ إِلَّا مَن ظُلِمَۚ وَكَانَ ٱللَّهُ سَمِيعًا عَلِيمًا",
    "ayah_text_no_diacratic" : "لا يحب الله الجهر بالسوء من القول الا من ظلم وكان الله سميعا عليما",
    "ayahnumber" : "148",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "648",
    "page" : "102",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:649",
    "ayah_text" : "إِن تُبۡدُواْ خَيۡرًا أَوۡ تُخۡفُوهُ أَوۡ تَعۡفُواْ عَن سُوٓءٖ فَإِنَّ ٱللَّهَ كَانَ عَفُوّٗا قَدِيرًا",
    "ayah_text_no_diacratic" : "ان تبدوا خيرا او تخفوه او تعفوا عن سوء فان الله كان عفوا قديرا",
    "ayahnumber" : "149",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "649",
    "page" : "102",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:65",
    "ayah_text" : "وَإِذۡ قُلۡتُمۡ يَٰمُوسَىٰ لَن نُّؤۡمِنَ لَكَ حَتَّىٰ نَرَى ٱللَّهَ جَهۡرَةٗ فَأَخَذَتۡكُمُ ٱلصَّٰعِقَةُ وَأَنتُمۡ تَنظُرُونَ",
    "ayah_text_no_diacratic" : "واذ قلتم يٰموسىٰ لن نؤمن لك حتىٰ نرى الله جهرة فاخذتكم الصٰعقة وانتم تنظرون",
    "ayahnumber" : "55",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "65",
    "page" : "8",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:650",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَكۡفُرُونَ بِٱللَّهِ وَرُسُلِهِۦ وَيُرِيدُونَ أَن يُفَرِّقُواْ بَيۡنَ ٱللَّهِ وَرُسُلِهِۦ وَيَقُولُونَ نُؤۡمِنُ بِبَعۡضٖ وَنَكۡفُرُ بِبَعۡضٖ وَيُرِيدُونَ أَن يَتَّخِذُواْ بَيۡنَ ذَٰلِكَ سَبِيلًا",
    "ayah_text_no_diacratic" : "ان الذين يكفرون بالله ورسله ويريدون ان يفرقوا بين الله ورسله ويقولون نؤمن ببعض ونكفر ببعض ويريدون ان يتخذوا بين ذٰلك سبيلا",
    "ayahnumber" : "150",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "650",
    "page" : "102",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:651",
    "ayah_text" : "أُوْلَٰٓئِكَ هُمُ ٱلۡكَٰفِرُونَ حَقّٗاۚ وَأَعۡتَدۡنَا لِلۡكَٰفِرِينَ عَذَابٗا مُّهِينٗا",
    "ayah_text_no_diacratic" : "اولٰئك هم الكٰفرون حقا واعتدنا للكٰفرين عذابا مهينا",
    "ayahnumber" : "151",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "651",
    "page" : "102",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:652",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ بِٱللَّهِ وَرُسُلِهِۦ وَلَمۡ يُفَرِّقُواْ بَيۡنَ أَحَدٖ مِّنۡهُمۡ أُوْلَٰٓئِكَ سَوۡفَ يُؤۡتِيهِمۡ أُجُورَهُمۡۚ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "والذين ءامنوا بالله ورسله ولم يفرقوا بين احد منهم اولٰئك سوف يؤتيهم اجورهم وكان الله غفورا رحيما",
    "ayahnumber" : "152",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "652",
    "page" : "102",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:653",
    "ayah_text" : "يَسۡـَٔلُكَ أَهۡلُ ٱلۡكِتَٰبِ أَن تُنَزِّلَ عَلَيۡهِمۡ كِتَٰبٗا مِّنَ ٱلسَّمَآءِۚ فَقَدۡ سَأَلُواْ مُوسَىٰٓ أَكۡبَرَ مِن ذَٰلِكَ فَقَالُوٓاْ أَرِنَا ٱللَّهَ جَهۡرَةٗ فَأَخَذَتۡهُمُ ٱلصَّٰعِقَةُ بِظُلۡمِهِمۡۚ ثُمَّ ٱتَّخَذُواْ ٱلۡعِجۡلَ مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَٰتُ فَعَفَوۡنَا عَن ذَٰلِكَۚ وَءَاتَيۡنَا مُوسَىٰ سُلۡطَٰنٗا مُّبِينٗا",
    "ayah_text_no_diacratic" : "يسلك اهل الكتٰب ان تنزل عليهم كتٰبا من السماء فقد سالوا موسىٰ اكبر من ذٰلك فقالوا ارنا الله جهرة فاخذتهم الصٰعقة بظلمهم ثم اتخذوا العجل من بعد ما جاءتهم البينٰت فعفونا عن ذٰلك وءاتينا موسىٰ سلطٰنا مبينا",
    "ayahnumber" : "153",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "653",
    "page" : "102",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:654",
    "ayah_text" : "وَرَفَعۡنَا فَوۡقَهُمُ ٱلطُّورَ بِمِيثَٰقِهِمۡ وَقُلۡنَا لَهُمُ ٱدۡخُلُواْ ٱلۡبَابَ سُجَّدٗا وَقُلۡنَا لَهُمۡ لَا تَعۡدُواْ فِي ٱلسَّبۡتِ وَأَخَذۡنَا مِنۡهُم مِّيثَٰقًا غَلِيظٗا",
    "ayah_text_no_diacratic" : "ورفعنا فوقهم الطور بميثٰقهم وقلنا لهم ادخلوا الباب سجدا وقلنا لهم لا تعدوا في السبت واخذنا منهم ميثٰقا غليظا",
    "ayahnumber" : "154",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "654",
    "page" : "102",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:655",
    "ayah_text" : "فَبِمَا نَقۡضِهِم مِّيثَٰقَهُمۡ وَكُفۡرِهِم بِـَٔايَٰتِ ٱللَّهِ وَقَتۡلِهِمُ ٱلۡأَنۢبِيَآءَ بِغَيۡرِ حَقّٖ وَقَوۡلِهِمۡ قُلُوبُنَا غُلۡفُۢۚ بَلۡ طَبَعَ ٱللَّهُ عَلَيۡهَا بِكُفۡرِهِمۡ فَلَا يُؤۡمِنُونَ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "فبما نقضهم ميثٰقهم وكفرهم بايٰت الله وقتلهم الانبياء بغير حق وقولهم قلوبنا غلف بل طبع الله عليها بكفرهم فلا يؤمنون الا قليلا",
    "ayahnumber" : "155",
    "chapter" : "6",
    "hizb" : "10",
    "index" : "655",
    "page" : "103",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
