  }, {
    "@id" : "quran:2994",
    "ayah_text" : "قَالَ رَبِّ إِنِّيٓ أَخَافُ أَن يُكَذِّبُونِ",
    "ayah_text_no_diacratic" : "قال رب اني اخاف ان يكذبون",
