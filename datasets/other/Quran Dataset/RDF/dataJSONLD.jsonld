    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2178",
    "ayah_text" : "وَيُنذِرَ ٱلَّذِينَ قَالُواْ ٱتَّخَذَ ٱللَّهُ وَلَدٗا",
    "ayah_text_no_diacratic" : "وينذر الذين قالوا اتخذ الله ولدا",
    "ayahnumber" : "4",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2178",
    "page" : "293",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2179",
    "ayah_text" : "مَّا لَهُم بِهِۦ مِنۡ عِلۡمٖ وَلَا لِأٓبَآئِهِمۡۚ كَبُرَتۡ كَلِمَةٗ تَخۡرُجُ مِنۡ أَفۡوَٰهِهِمۡۚ إِن يَقُولُونَ إِلَّا كَذِبٗا",
    "ayah_text_no_diacratic" : "ما لهم به من علم ولا لابائهم كبرت كلمة تخرج من افوٰههم ان يقولون الا كذبا",
    "ayahnumber" : "5",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2179",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:218",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱدۡخُلُواْ فِي ٱلسِّلۡمِ كَآفَّةٗ وَلَا تَتَّبِعُواْ خُطُوَٰتِ ٱلشَّيۡطَٰنِۚ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ادخلوا في السلم كافة ولا تتبعوا خطوٰت الشيطٰن انه لكم عدو مبين",
    "ayahnumber" : "208",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "218",
    "page" : "32",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2180",
    "ayah_text" : "فَلَعَلَّكَ بَٰخِعٞ نَّفۡسَكَ عَلَىٰٓ ءَاثَٰرِهِمۡ إِن لَّمۡ يُؤۡمِنُواْ بِهَٰذَا ٱلۡحَدِيثِ أَسَفًا",
    "ayah_text_no_diacratic" : "فلعلك بٰخع نفسك علىٰ ءاثٰرهم ان لم يؤمنوا بهٰذا الحديث اسفا",
    "ayahnumber" : "6",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2180",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2181",
    "ayah_text" : "إِنَّا جَعَلۡنَا مَا عَلَى ٱلۡأَرۡضِ زِينَةٗ لَّهَا لِنَبۡلُوَهُمۡ أَيُّهُمۡ أَحۡسَنُ عَمَلٗا",
    "ayah_text_no_diacratic" : "انا جعلنا ما على الارض زينة لها لنبلوهم ايهم احسن عملا",
    "ayahnumber" : "7",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2181",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2182",
    "ayah_text" : "وَإِنَّا لَجَٰعِلُونَ مَا عَلَيۡهَا صَعِيدٗا جُرُزًا",
    "ayah_text_no_diacratic" : "وانا لجٰعلون ما عليها صعيدا جرزا",
    "ayahnumber" : "8",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2182",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2183",
    "ayah_text" : "أَمۡ حَسِبۡتَ أَنَّ أَصۡحَٰبَ ٱلۡكَهۡفِ وَٱلرَّقِيمِ كَانُواْ مِنۡ ءَايَٰتِنَا عَجَبًا",
    "ayah_text_no_diacratic" : "ام حسبت ان اصحٰب الكهف والرقيم كانوا من ءايٰتنا عجبا",
    "ayahnumber" : "9",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2183",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2184",
    "ayah_text" : "إِذۡ أَوَى ٱلۡفِتۡيَةُ إِلَى ٱلۡكَهۡفِ فَقَالُواْ رَبَّنَآ ءَاتِنَا مِن لَّدُنكَ رَحۡمَةٗ وَهَيِّئۡ لَنَا مِنۡ أَمۡرِنَا رَشَدٗا",
    "ayah_text_no_diacratic" : "اذ اوى الفتية الى الكهف فقالوا ربنا ءاتنا من لدنك رحمة وهيئ لنا من امرنا رشدا",
    "ayahnumber" : "10",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2184",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2185",
    "ayah_text" : "فَضَرَبۡنَا عَلَىٰٓ ءَاذَانِهِمۡ فِي ٱلۡكَهۡفِ سِنِينَ عَدَدٗا",
    "ayah_text_no_diacratic" : "فضربنا علىٰ ءاذانهم في الكهف سنين عددا",
    "ayahnumber" : "11",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2185",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2186",
    "ayah_text" : "ثُمَّ بَعَثۡنَٰهُمۡ لِنَعۡلَمَ أَيُّ ٱلۡحِزۡبَيۡنِ أَحۡصَىٰ لِمَا لَبِثُوٓاْ أَمَدٗا",
    "ayah_text_no_diacratic" : "ثم بعثنٰهم لنعلم اي الحزبين احصىٰ لما لبثوا امدا",
    "ayahnumber" : "12",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2186",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2187",
    "ayah_text" : "نَّحۡنُ نَقُصُّ عَلَيۡكَ نَبَأَهُم بِٱلۡحَقِّۚ إِنَّهُمۡ فِتۡيَةٌ ءَامَنُواْ بِرَبِّهِمۡ وَزِدۡنَٰهُمۡ هُدٗى",
    "ayah_text_no_diacratic" : "نحن نقص عليك نباهم بالحق انهم فتية ءامنوا بربهم وزدنٰهم هدى",
    "ayahnumber" : "13",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2187",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2188",
    "ayah_text" : "وَرَبَطۡنَا عَلَىٰ قُلُوبِهِمۡ إِذۡ قَامُواْ فَقَالُواْ رَبُّنَا رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ لَن نَّدۡعُوَاْ مِن دُونِهِۦٓ إِلَٰهٗاۖ لَّقَدۡ قُلۡنَآ إِذٗا شَطَطًا",
    "ayah_text_no_diacratic" : "وربطنا علىٰ قلوبهم اذ قاموا فقالوا ربنا رب السمٰوٰت والارض لن ندعوا من دونه الٰها لقد قلنا اذا شططا",
    "ayahnumber" : "14",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2188",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2189",
    "ayah_text" : "هَٰٓؤُلَآءِ قَوۡمُنَا ٱتَّخَذُواْ مِن دُونِهِۦٓ ءَالِهَةٗۖ لَّوۡلَا يَأۡتُونَ عَلَيۡهِم بِسُلۡطَٰنِۭ بَيِّنٖۖ فَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبٗا",
    "ayah_text_no_diacratic" : "هٰؤلاء قومنا اتخذوا من دونه ءالهة لولا ياتون عليهم بسلطٰن بين فمن اظلم ممن افترىٰ على الله كذبا",
    "ayahnumber" : "15",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2189",
    "page" : "294",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:219",
    "ayah_text" : "فَإِن زَلَلۡتُم مِّنۢ بَعۡدِ مَا جَآءَتۡكُمُ ٱلۡبَيِّنَٰتُ فَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ",
    "ayah_text_no_diacratic" : "فان زللتم من بعد ما جاءتكم البينٰت فاعلموا ان الله عزيز حكيم",
    "ayahnumber" : "209",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "219",
    "page" : "32",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2190",
    "ayah_text" : "وَإِذِ ٱعۡتَزَلۡتُمُوهُمۡ وَمَا يَعۡبُدُونَ إِلَّا ٱللَّهَ فَأۡوُۥٓاْ إِلَى ٱلۡكَهۡفِ يَنشُرۡ لَكُمۡ رَبُّكُم مِّن رَّحۡمَتِهِۦ وَيُهَيِّئۡ لَكُم مِّنۡ أَمۡرِكُم مِّرۡفَقٗا",
    "ayah_text_no_diacratic" : "واذ اعتزلتموهم وما يعبدون الا الله فاوا الى الكهف ينشر لكم ربكم من رحمته ويهيئ لكم من امركم مرفقا",
    "ayahnumber" : "16",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2190",
    "page" : "295",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2191",
    "ayah_text" : "۞وَتَرَى ٱلشَّمۡسَ إِذَا طَلَعَت تَّزَٰوَرُ عَن كَهۡفِهِمۡ ذَاتَ ٱلۡيَمِينِ وَإِذَا غَرَبَت تَّقۡرِضُهُمۡ ذَاتَ ٱلشِّمَالِ وَهُمۡ فِي فَجۡوَةٖ مِّنۡهُۚ ذَٰلِكَ مِنۡ ءَايَٰتِ ٱللَّهِۗ مَن يَهۡدِ ٱللَّهُ فَهُوَ ٱلۡمُهۡتَدِۖ وَمَن يُضۡلِلۡ فَلَن تَجِدَ لَهُۥ وَلِيّٗا مُّرۡشِدٗا",
    "ayah_text_no_diacratic" : "وترى الشمس اذا طلعت تزٰور عن كهفهم ذات اليمين واذا غربت تقرضهم ذات الشمال وهم في فجوة منه ذٰلك من ءايٰت الله من يهد الله فهو المهتد ومن يضلل فلن تجد له وليا مرشدا",
    "ayahnumber" : "17",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2191",
    "page" : "295",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2192",
    "ayah_text" : "وَتَحۡسَبُهُمۡ أَيۡقَاظٗا وَهُمۡ رُقُودٞۚ وَنُقَلِّبُهُمۡ ذَاتَ ٱلۡيَمِينِ وَذَاتَ ٱلشِّمَالِۖ وَكَلۡبُهُم بَٰسِطٞ ذِرَاعَيۡهِ بِٱلۡوَصِيدِۚ لَوِ ٱطَّلَعۡتَ عَلَيۡهِمۡ لَوَلَّيۡتَ مِنۡهُمۡ فِرَارٗا وَلَمُلِئۡتَ مِنۡهُمۡ رُعۡبٗا",
    "ayah_text_no_diacratic" : "وتحسبهم ايقاظا وهم رقود ونقلبهم ذات اليمين وذات الشمال وكلبهم بٰسط ذراعيه بالوصيد لو اطلعت عليهم لوليت منهم فرارا ولملئت منهم رعبا",
    "ayahnumber" : "18",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2192",
    "page" : "295",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2193",
    "ayah_text" : "وَكَذَٰلِكَ بَعَثۡنَٰهُمۡ لِيَتَسَآءَلُواْ بَيۡنَهُمۡۚ قَالَ قَآئِلٞ مِّنۡهُمۡ كَمۡ لَبِثۡتُمۡۖ قَالُواْ لَبِثۡنَا يَوۡمًا أَوۡ بَعۡضَ يَوۡمٖۚ قَالُواْ رَبُّكُمۡ أَعۡلَمُ بِمَا لَبِثۡتُمۡ فَٱبۡعَثُوٓاْ أَحَدَكُم بِوَرِقِكُمۡ هَٰذِهِۦٓ إِلَى ٱلۡمَدِينَةِ فَلۡيَنظُرۡ أَيُّهَآ أَزۡكَىٰ طَعَامٗا فَلۡيَأۡتِكُم بِرِزۡقٖ مِّنۡهُ وَلۡيَتَلَطَّفۡ وَلَا يُشۡعِرَنَّ بِكُمۡ أَحَدًا",
    "ayah_text_no_diacratic" : "وكذٰلك بعثنٰهم ليتساءلوا بينهم قال قائل منهم كم لبثتم قالوا لبثنا يوما او بعض يوم قالوا ربكم اعلم بما لبثتم فابعثوا احدكم بورقكم هٰذه الى المدينة فلينظر ايها ازكىٰ طعاما فلياتكم برزق منه وليتلطف ولا يشعرن بكم احدا",
    "ayahnumber" : "19",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2193",
    "page" : "295",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2194",
    "ayah_text" : "إِنَّهُمۡ إِن يَظۡهَرُواْ عَلَيۡكُمۡ يَرۡجُمُوكُمۡ أَوۡ يُعِيدُوكُمۡ فِي مِلَّتِهِمۡ وَلَن تُفۡلِحُوٓاْ إِذًا أَبَدٗا",
    "ayah_text_no_diacratic" : "انهم ان يظهروا عليكم يرجموكم او يعيدوكم في ملتهم ولن تفلحوا اذا ابدا",
    "ayahnumber" : "20",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2194",
    "page" : "295",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2195",
    "ayah_text" : "وَكَذَٰلِكَ أَعۡثَرۡنَا عَلَيۡهِمۡ لِيَعۡلَمُوٓاْ أَنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَأَنَّ ٱلسَّاعَةَ لَا رَيۡبَ فِيهَآ إِذۡ يَتَنَٰزَعُونَ بَيۡنَهُمۡ أَمۡرَهُمۡۖ فَقَالُواْ ٱبۡنُواْ عَلَيۡهِم بُنۡيَٰنٗاۖ رَّبُّهُمۡ أَعۡلَمُ بِهِمۡۚ قَالَ ٱلَّذِينَ غَلَبُواْ عَلَىٰٓ أَمۡرِهِمۡ لَنَتَّخِذَنَّ عَلَيۡهِم مَّسۡجِدٗا",
    "ayah_text_no_diacratic" : "وكذٰلك اعثرنا عليهم ليعلموا ان وعد الله حق وان الساعة لا ريب فيها اذ يتنٰزعون بينهم امرهم فقالوا ابنوا عليهم بنيٰنا ربهم اعلم بهم قال الذين غلبوا علىٰ امرهم لنتخذن عليهم مسجدا",
    "ayahnumber" : "21",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2195",
    "page" : "296",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2196",
    "ayah_text" : "سَيَقُولُونَ ثَلَٰثَةٞ رَّابِعُهُمۡ كَلۡبُهُمۡ وَيَقُولُونَ خَمۡسَةٞ سَادِسُهُمۡ كَلۡبُهُمۡ رَجۡمَۢا بِٱلۡغَيۡبِۖ وَيَقُولُونَ سَبۡعَةٞ وَثَامِنُهُمۡ كَلۡبُهُمۡۚ قُل رَّبِّيٓ أَعۡلَمُ بِعِدَّتِهِم مَّا يَعۡلَمُهُمۡ إِلَّا قَلِيلٞۗ فَلَا تُمَارِ فِيهِمۡ إِلَّا مِرَآءٗ ظَٰهِرٗا وَلَا تَسۡتَفۡتِ فِيهِم مِّنۡهُمۡ أَحَدٗا",
    "ayah_text_no_diacratic" : "سيقولون ثلٰثة رابعهم كلبهم ويقولون خمسة سادسهم كلبهم رجما بالغيب ويقولون سبعة وثامنهم كلبهم قل ربي اعلم بعدتهم ما يعلمهم الا قليل فلا تمار فيهم الا مراء ظٰهرا ولا تستفت فيهم منهم احدا",
    "ayahnumber" : "22",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2196",
    "page" : "296",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2197",
    "ayah_text" : "وَلَا تَقُولَنَّ لِشَاْيۡءٍ إِنِّي فَاعِلٞ ذَٰلِكَ غَدًا",
    "ayah_text_no_diacratic" : "ولا تقولن لشايء اني فاعل ذٰلك غدا",
    "ayahnumber" : "23",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2197",
    "page" : "296",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2198",
    "ayah_text" : "إِلَّآ أَن يَشَآءَ ٱللَّهُۚ وَٱذۡكُر رَّبَّكَ إِذَا نَسِيتَ وَقُلۡ عَسَىٰٓ أَن يَهۡدِيَنِ رَبِّي لِأَقۡرَبَ مِنۡ هَٰذَا رَشَدٗا",
    "ayah_text_no_diacratic" : "الا ان يشاء الله واذكر ربك اذا نسيت وقل عسىٰ ان يهدين ربي لاقرب من هٰذا رشدا",
    "ayahnumber" : "24",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2198",
    "page" : "296",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2199",
    "ayah_text" : "وَلَبِثُواْ فِي كَهۡفِهِمۡ ثَلَٰثَ مِاْئَةٖ سِنِينَ وَٱزۡدَادُواْ تِسۡعٗا",
    "ayah_text_no_diacratic" : "ولبثوا في كهفهم ثلٰث مائة سنين وازدادوا تسعا",
    "ayahnumber" : "25",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2199",
    "page" : "296",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:22",
    "ayah_text" : "أَلَآ إِنَّهُمۡ هُمُ ٱلۡمُفۡسِدُونَ وَلَٰكِن لَّا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "الا انهم هم المفسدون ولٰكن لا يشعرون",
    "ayahnumber" : "12",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "22",
    "page" : "3",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:220",
    "ayah_text" : "هَلۡ يَنظُرُونَ إِلَّآ أَن يَأۡتِيَهُمُ ٱللَّهُ فِي ظُلَلٖ مِّنَ ٱلۡغَمَامِ وَٱلۡمَلَٰٓئِكَةُ وَقُضِيَ ٱلۡأَمۡرُۚ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ",
    "ayah_text_no_diacratic" : "هل ينظرون الا ان ياتيهم الله في ظلل من الغمام والملٰئكة وقضي الامر والى الله ترجع الامور",
    "ayahnumber" : "210",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "220",
    "page" : "32",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2200",
    "ayah_text" : "قُلِ ٱللَّهُ أَعۡلَمُ بِمَا لَبِثُواْۖ لَهُۥ غَيۡبُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ أَبۡصِرۡ بِهِۦ وَأَسۡمِعۡۚ مَا لَهُم مِّن دُونِهِۦ مِن وَلِيّٖ وَلَا يُشۡرِكُ فِي حُكۡمِهِۦٓ أَحَدٗا",
    "ayah_text_no_diacratic" : "قل الله اعلم بما لبثوا له غيب السمٰوٰت والارض ابصر به واسمع ما لهم من دونه من ولي ولا يشرك في حكمه احدا",
    "ayahnumber" : "26",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2200",
    "page" : "296",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2201",
    "ayah_text" : "وَٱتۡلُ مَآ أُوحِيَ إِلَيۡكَ مِن كِتَابِ رَبِّكَۖ لَا مُبَدِّلَ لِكَلِمَٰتِهِۦ وَلَن تَجِدَ مِن دُونِهِۦ مُلۡتَحَدٗا",
    "ayah_text_no_diacratic" : "واتل ما اوحي اليك من كتاب ربك لا مبدل لكلمٰته ولن تجد من دونه ملتحدا",
    "ayahnumber" : "27",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2201",
    "page" : "296",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2202",
    "ayah_text" : "وَٱصۡبِرۡ نَفۡسَكَ مَعَ ٱلَّذِينَ يَدۡعُونَ رَبَّهُم بِٱلۡغَدَوٰةِ وَٱلۡعَشِيِّ يُرِيدُونَ وَجۡهَهُۥۖ وَلَا تَعۡدُ عَيۡنَاكَ عَنۡهُمۡ تُرِيدُ زِينَةَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَلَا تُطِعۡ مَنۡ أَغۡفَلۡنَا قَلۡبَهُۥ عَن ذِكۡرِنَا وَٱتَّبَعَ هَوَىٰهُ وَكَانَ أَمۡرُهُۥ فُرُطٗا",
    "ayah_text_no_diacratic" : "واصبر نفسك مع الذين يدعون ربهم بالغدوٰة والعشي يريدون وجهه ولا تعد عيناك عنهم تريد زينة الحيوٰة الدنيا ولا تطع من اغفلنا قلبه عن ذكرنا واتبع هوىٰه وكان امره فرطا",
    "ayahnumber" : "28",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2202",
    "page" : "297",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2203",
    "ayah_text" : "وَقُلِ ٱلۡحَقُّ مِن رَّبِّكُمۡۖ فَمَن شَآءَ فَلۡيُؤۡمِن وَمَن شَآءَ فَلۡيَكۡفُرۡۚ إِنَّآ أَعۡتَدۡنَا لِلظَّٰلِمِينَ نَارًا أَحَاطَ بِهِمۡ سُرَادِقُهَاۚ وَإِن يَسۡتَغِيثُواْ يُغَاثُواْ بِمَآءٖ كَٱلۡمُهۡلِ يَشۡوِي ٱلۡوُجُوهَۚ بِئۡسَ ٱلشَّرَابُ وَسَآءَتۡ مُرۡتَفَقًا",
    "ayah_text_no_diacratic" : "وقل الحق من ربكم فمن شاء فليؤمن ومن شاء فليكفر انا اعتدنا للظٰلمين نارا احاط بهم سرادقها وان يستغيثوا يغاثوا بماء كالمهل يشوي الوجوه بئس الشراب وساءت مرتفقا",
    "ayahnumber" : "29",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2203",
    "page" : "297",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2204",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ إِنَّا لَا نُضِيعُ أَجۡرَ مَنۡ أَحۡسَنَ عَمَلًا",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت انا لا نضيع اجر من احسن عملا",
    "ayahnumber" : "30",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2204",
    "page" : "297",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2205",
    "ayah_text" : "أُوْلَٰٓئِكَ لَهُمۡ جَنَّٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهِمُ ٱلۡأَنۡهَٰرُ يُحَلَّوۡنَ فِيهَا مِنۡ أَسَاوِرَ مِن ذَهَبٖ وَيَلۡبَسُونَ ثِيَابًا خُضۡرٗا مِّن سُندُسٖ وَإِسۡتَبۡرَقٖ مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلۡأَرَآئِكِۚ نِعۡمَ ٱلثَّوَابُ وَحَسُنَتۡ مُرۡتَفَقٗا",
    "ayah_text_no_diacratic" : "اولٰئك لهم جنٰت عدن تجري من تحتهم الانهٰر يحلون فيها من اساور من ذهب ويلبسون ثيابا خضرا من سندس واستبرق متكين فيها على الارائك نعم الثواب وحسنت مرتفقا",
    "ayahnumber" : "31",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2205",
    "page" : "297",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2206",
    "ayah_text" : "۞وَٱضۡرِبۡ لَهُم مَّثَلٗا رَّجُلَيۡنِ جَعَلۡنَا لِأَحَدِهِمَا جَنَّتَيۡنِ مِنۡ أَعۡنَٰبٖ وَحَفَفۡنَٰهُمَا بِنَخۡلٖ وَجَعَلۡنَا بَيۡنَهُمَا زَرۡعٗا",
    "ayah_text_no_diacratic" : "واضرب لهم مثلا رجلين جعلنا لاحدهما جنتين من اعنٰب وحففنٰهما بنخل وجعلنا بينهما زرعا",
    "ayahnumber" : "32",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2206",
    "page" : "297",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2207",
    "ayah_text" : "كِلۡتَا ٱلۡجَنَّتَيۡنِ ءَاتَتۡ أُكُلَهَا وَلَمۡ تَظۡلِم مِّنۡهُ شَيۡـٔٗاۚ وَفَجَّرۡنَا خِلَٰلَهُمَا نَهَرٗا",
    "ayah_text_no_diacratic" : "كلتا الجنتين ءاتت اكلها ولم تظلم منه شيا وفجرنا خلٰلهما نهرا",
    "ayahnumber" : "33",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2207",
    "page" : "297",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2208",
    "ayah_text" : "وَكَانَ لَهُۥ ثَمَرٞ فَقَالَ لِصَٰحِبِهِۦ وَهُوَ يُحَاوِرُهُۥٓ أَنَا۠ أَكۡثَرُ مِنكَ مَالٗا وَأَعَزُّ نَفَرٗا",
    "ayah_text_no_diacratic" : "وكان له ثمر فقال لصٰحبه وهو يحاوره انا اكثر منك مالا واعز نفرا",
    "ayahnumber" : "34",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2208",
    "page" : "297",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2209",
    "ayah_text" : "وَدَخَلَ جَنَّتَهُۥ وَهُوَ ظَالِمٞ لِّنَفۡسِهِۦ قَالَ مَآ أَظُنُّ أَن تَبِيدَ هَٰذِهِۦٓ أَبَدٗا",
    "ayah_text_no_diacratic" : "ودخل جنته وهو ظالم لنفسه قال ما اظن ان تبيد هٰذه ابدا",
    "ayahnumber" : "35",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2209",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:221",
    "ayah_text" : "سَلۡ بَنِيٓ إِسۡرَٰٓءِيلَ كَمۡ ءَاتَيۡنَٰهُم مِّنۡ ءَايَةِۭ بَيِّنَةٖۗ وَمَن يُبَدِّلۡ نِعۡمَةَ ٱللَّهِ مِنۢ بَعۡدِ مَا جَآءَتۡهُ فَإِنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ",
    "ayah_text_no_diacratic" : "سل بني اسرٰءيل كم ءاتينٰهم من ءاية بينة ومن يبدل نعمة الله من بعد ما جاءته فان الله شديد العقاب",
    "ayahnumber" : "211",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "221",
    "page" : "33",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2210",
    "ayah_text" : "وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةٗ وَلَئِن رُّدِدتُّ إِلَىٰ رَبِّي لَأَجِدَنَّ خَيۡرٗا مِّنۡهَا مُنقَلَبٗا",
    "ayah_text_no_diacratic" : "وما اظن الساعة قائمة ولئن رددت الىٰ ربي لاجدن خيرا منها منقلبا",
    "ayahnumber" : "36",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2210",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2211",
    "ayah_text" : "قَالَ لَهُۥ صَاحِبُهُۥ وَهُوَ يُحَاوِرُهُۥٓ أَكَفَرۡتَ بِٱلَّذِي خَلَقَكَ مِن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ سَوَّىٰكَ رَجُلٗا",
    "ayah_text_no_diacratic" : "قال له صاحبه وهو يحاوره اكفرت بالذي خلقك من تراب ثم من نطفة ثم سوىٰك رجلا",
    "ayahnumber" : "37",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2211",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2212",
    "ayah_text" : "لَّٰكِنَّا۠ هُوَ ٱللَّهُ رَبِّي وَلَآ أُشۡرِكُ بِرَبِّيٓ أَحَدٗا",
    "ayah_text_no_diacratic" : "لٰكنا هو الله ربي ولا اشرك بربي احدا",
    "ayahnumber" : "38",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2212",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2213",
    "ayah_text" : "وَلَوۡلَآ إِذۡ دَخَلۡتَ جَنَّتَكَ قُلۡتَ مَا شَآءَ ٱللَّهُ لَا قُوَّةَ إِلَّا بِٱللَّهِۚ إِن تَرَنِ أَنَا۠ أَقَلَّ مِنكَ مَالٗا وَوَلَدٗا",
    "ayah_text_no_diacratic" : "ولولا اذ دخلت جنتك قلت ما شاء الله لا قوة الا بالله ان ترن انا اقل منك مالا وولدا",
    "ayahnumber" : "39",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2213",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2214",
    "ayah_text" : "فَعَسَىٰ رَبِّيٓ أَن يُؤۡتِيَنِ خَيۡرٗا مِّن جَنَّتِكَ وَيُرۡسِلَ عَلَيۡهَا حُسۡبَانٗا مِّنَ ٱلسَّمَآءِ فَتُصۡبِحَ صَعِيدٗا زَلَقًا",
    "ayah_text_no_diacratic" : "فعسىٰ ربي ان يؤتين خيرا من جنتك ويرسل عليها حسبانا من السماء فتصبح صعيدا زلقا",
    "ayahnumber" : "40",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2214",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2215",
    "ayah_text" : "أَوۡ يُصۡبِحَ مَآؤُهَا غَوۡرٗا فَلَن تَسۡتَطِيعَ لَهُۥ طَلَبٗا",
    "ayah_text_no_diacratic" : "او يصبح ماؤها غورا فلن تستطيع له طلبا",
    "ayahnumber" : "41",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2215",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2216",
    "ayah_text" : "وَأُحِيطَ بِثَمَرِهِۦ فَأَصۡبَحَ يُقَلِّبُ كَفَّيۡهِ عَلَىٰ مَآ أَنفَقَ فِيهَا وَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُشۡرِكۡ بِرَبِّيٓ أَحَدٗا",
    "ayah_text_no_diacratic" : "واحيط بثمره فاصبح يقلب كفيه علىٰ ما انفق فيها وهي خاوية علىٰ عروشها ويقول يٰليتني لم اشرك بربي احدا",
    "ayahnumber" : "42",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2216",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2217",
    "ayah_text" : "وَلَمۡ تَكُن لَّهُۥ فِئَةٞ يَنصُرُونَهُۥ مِن دُونِ ٱللَّهِ وَمَا كَانَ مُنتَصِرًا",
    "ayah_text_no_diacratic" : "ولم تكن له فئة ينصرونه من دون الله وما كان منتصرا",
    "ayahnumber" : "43",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2217",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2218",
    "ayah_text" : "هُنَالِكَ ٱلۡوَلَٰيَةُ لِلَّهِ ٱلۡحَقِّۚ هُوَ خَيۡرٞ ثَوَابٗا وَخَيۡرٌ عُقۡبٗا",
    "ayah_text_no_diacratic" : "هنالك الولٰية لله الحق هو خير ثوابا وخير عقبا",
    "ayahnumber" : "44",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2218",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2219",
    "ayah_text" : "وَٱضۡرِبۡ لَهُم مَّثَلَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا كَمَآءٍ أَنزَلۡنَٰهُ مِنَ ٱلسَّمَآءِ فَٱخۡتَلَطَ بِهِۦ نَبَاتُ ٱلۡأَرۡضِ فَأَصۡبَحَ هَشِيمٗا تَذۡرُوهُ ٱلرِّيَٰحُۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ مُّقۡتَدِرًا",
    "ayah_text_no_diacratic" : "واضرب لهم مثل الحيوٰة الدنيا كماء انزلنٰه من السماء فاختلط به نبات الارض فاصبح هشيما تذروه الريٰح وكان الله علىٰ كل شيء مقتدرا",
    "ayahnumber" : "45",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2219",
    "page" : "298",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:222",
    "ayah_text" : "زُيِّنَ لِلَّذِينَ كَفَرُواْ ٱلۡحَيَوٰةُ ٱلدُّنۡيَا وَيَسۡخَرُونَ مِنَ ٱلَّذِينَ ءَامَنُواْۘ وَٱلَّذِينَ ٱتَّقَوۡاْ فَوۡقَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِۗ وَٱللَّهُ يَرۡزُقُ مَن يَشَآءُ بِغَيۡرِ حِسَابٖ",
    "ayah_text_no_diacratic" : "زين للذين كفروا الحيوٰة الدنيا ويسخرون من الذين ءامنوا والذين اتقوا فوقهم يوم القيٰمة والله يرزق من يشاء بغير حساب",
    "ayahnumber" : "212",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "222",
    "page" : "33",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2220",
    "ayah_text" : "ٱلۡمَالُ وَٱلۡبَنُونَ زِينَةُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَٱلۡبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ خَيۡرٌ عِندَ رَبِّكَ ثَوَابٗا وَخَيۡرٌ أَمَلٗا",
    "ayah_text_no_diacratic" : "المال والبنون زينة الحيوٰة الدنيا والبٰقيٰت الصٰلحٰت خير عند ربك ثوابا وخير املا",
    "ayahnumber" : "46",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2220",
    "page" : "299",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2221",
    "ayah_text" : "وَيَوۡمَ نُسَيِّرُ ٱلۡجِبَالَ وَتَرَى ٱلۡأَرۡضَ بَارِزَةٗ وَحَشَرۡنَٰهُمۡ فَلَمۡ نُغَادِرۡ مِنۡهُمۡ أَحَدٗا",
    "ayah_text_no_diacratic" : "ويوم نسير الجبال وترى الارض بارزة وحشرنٰهم فلم نغادر منهم احدا",
    "ayahnumber" : "47",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2221",
    "page" : "299",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2222",
    "ayah_text" : "وَعُرِضُواْ عَلَىٰ رَبِّكَ صَفّٗا لَّقَدۡ جِئۡتُمُونَا كَمَا خَلَقۡنَٰكُمۡ أَوَّلَ مَرَّةِۭۚ بَلۡ زَعَمۡتُمۡ أَلَّن نَّجۡعَلَ لَكُم مَّوۡعِدٗا",
    "ayah_text_no_diacratic" : "وعرضوا علىٰ ربك صفا لقد جئتمونا كما خلقنٰكم اول مرة بل زعمتم الن نجعل لكم موعدا",
    "ayahnumber" : "48",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2222",
    "page" : "299",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2223",
    "ayah_text" : "وَوُضِعَ ٱلۡكِتَٰبُ فَتَرَى ٱلۡمُجۡرِمِينَ مُشۡفِقِينَ مِمَّا فِيهِ وَيَقُولُونَ يَٰوَيۡلَتَنَا مَالِ هَٰذَا ٱلۡكِتَٰبِ لَا يُغَادِرُ صَغِيرَةٗ وَلَا كَبِيرَةً إِلَّآ أَحۡصَىٰهَاۚ وَوَجَدُواْ مَا عَمِلُواْ حَاضِرٗاۗ وَلَا يَظۡلِمُ رَبُّكَ أَحَدٗا",
    "ayah_text_no_diacratic" : "ووضع الكتٰب فترى المجرمين مشفقين مما فيه ويقولون يٰويلتنا مال هٰذا الكتٰب لا يغادر صغيرة ولا كبيرة الا احصىٰها ووجدوا ما عملوا حاضرا ولا يظلم ربك احدا",
    "ayahnumber" : "49",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2223",
    "page" : "299",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2224",
    "ayah_text" : "وَإِذۡ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ كَانَ مِنَ ٱلۡجِنِّ فَفَسَقَ عَنۡ أَمۡرِ رَبِّهِۦٓۗ أَفَتَتَّخِذُونَهُۥ وَذُرِّيَّتَهُۥٓ أَوۡلِيَآءَ مِن دُونِي وَهُمۡ لَكُمۡ عَدُوُّۢۚ بِئۡسَ لِلظَّٰلِمِينَ بَدَلٗا",
    "ayah_text_no_diacratic" : "واذ قلنا للملٰئكة اسجدوا لادم فسجدوا الا ابليس كان من الجن ففسق عن امر ربه افتتخذونه وذريته اولياء من دوني وهم لكم عدو بئس للظٰلمين بدلا",
    "ayahnumber" : "50",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2224",
    "page" : "299",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2225",
    "ayah_text" : "۞مَّآ أَشۡهَدتُّهُمۡ خَلۡقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَلَا خَلۡقَ أَنفُسِهِمۡ وَمَا كُنتُ مُتَّخِذَ ٱلۡمُضِلِّينَ عَضُدٗا",
    "ayah_text_no_diacratic" : "ما اشهدتهم خلق السمٰوٰت والارض ولا خلق انفسهم وما كنت متخذ المضلين عضدا",
    "ayahnumber" : "51",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2225",
    "page" : "299",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2226",
    "ayah_text" : "وَيَوۡمَ يَقُولُ نَادُواْ شُرَكَآءِيَ ٱلَّذِينَ زَعَمۡتُمۡ فَدَعَوۡهُمۡ فَلَمۡ يَسۡتَجِيبُواْ لَهُمۡ وَجَعَلۡنَا بَيۡنَهُم مَّوۡبِقٗا",
    "ayah_text_no_diacratic" : "ويوم يقول نادوا شركاءي الذين زعمتم فدعوهم فلم يستجيبوا لهم وجعلنا بينهم موبقا",
    "ayahnumber" : "52",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2226",
    "page" : "299",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2227",
    "ayah_text" : "وَرَءَا ٱلۡمُجۡرِمُونَ ٱلنَّارَ فَظَنُّوٓاْ أَنَّهُم مُّوَاقِعُوهَا وَلَمۡ يَجِدُواْ عَنۡهَا مَصۡرِفٗا",
    "ayah_text_no_diacratic" : "ورءا المجرمون النار فظنوا انهم مواقعوها ولم يجدوا عنها مصرفا",
    "ayahnumber" : "53",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2227",
    "page" : "299",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2228",
    "ayah_text" : "وَلَقَدۡ صَرَّفۡنَا فِي هَٰذَا ٱلۡقُرۡءَانِ لِلنَّاسِ مِن كُلِّ مَثَلٖۚ وَكَانَ ٱلۡإِنسَٰنُ أَكۡثَرَ شَيۡءٖ جَدَلٗا",
    "ayah_text_no_diacratic" : "ولقد صرفنا في هٰذا القرءان للناس من كل مثل وكان الانسٰن اكثر شيء جدلا",
    "ayahnumber" : "54",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2228",
    "page" : "300",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2229",
    "ayah_text" : "وَمَا مَنَعَ ٱلنَّاسَ أَن يُؤۡمِنُوٓاْ إِذۡ جَآءَهُمُ ٱلۡهُدَىٰ وَيَسۡتَغۡفِرُواْ رَبَّهُمۡ إِلَّآ أَن تَأۡتِيَهُمۡ سُنَّةُ ٱلۡأَوَّلِينَ أَوۡ يَأۡتِيَهُمُ ٱلۡعَذَابُ قُبُلٗا",
    "ayah_text_no_diacratic" : "وما منع الناس ان يؤمنوا اذ جاءهم الهدىٰ ويستغفروا ربهم الا ان تاتيهم سنة الاولين او ياتيهم العذاب قبلا",
    "ayahnumber" : "55",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2229",
    "page" : "300",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:223",
    "ayah_text" : "كَانَ ٱلنَّاسُ أُمَّةٗ وَٰحِدَةٗ فَبَعَثَ ٱللَّهُ ٱلنَّبِيِّـۧنَ مُبَشِّرِينَ وَمُنذِرِينَ وَأَنزَلَ مَعَهُمُ ٱلۡكِتَٰبَ بِٱلۡحَقِّ لِيَحۡكُمَ بَيۡنَ ٱلنَّاسِ فِيمَا ٱخۡتَلَفُواْ فِيهِۚ وَمَا ٱخۡتَلَفَ فِيهِ إِلَّا ٱلَّذِينَ أُوتُوهُ مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَٰتُ بَغۡيَۢا بَيۡنَهُمۡۖ فَهَدَى ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ لِمَا ٱخۡتَلَفُواْ فِيهِ مِنَ ٱلۡحَقِّ بِإِذۡنِهِۦۗ وَٱللَّهُ يَهۡدِي مَن يَشَآءُ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٍ",
    "ayah_text_no_diacratic" : "كان الناس امة وٰحدة فبعث الله النبين مبشرين ومنذرين وانزل معهم الكتٰب بالحق ليحكم بين الناس فيما اختلفوا فيه وما اختلف فيه الا الذين اوتوه من بعد ما جاءتهم البينٰت بغيا بينهم فهدى الله الذين ءامنوا لما اختلفوا فيه من الحق باذنه والله يهدي من يشاء الىٰ صرٰط مستقيم",
    "ayahnumber" : "213",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "223",
    "page" : "33",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2230",
    "ayah_text" : "وَمَا نُرۡسِلُ ٱلۡمُرۡسَلِينَ إِلَّا مُبَشِّرِينَ وَمُنذِرِينَۚ وَيُجَٰدِلُ ٱلَّذِينَ كَفَرُواْ بِٱلۡبَٰطِلِ لِيُدۡحِضُواْ بِهِ ٱلۡحَقَّۖ وَٱتَّخَذُوٓاْ ءَايَٰتِي وَمَآ أُنذِرُواْ هُزُوٗا",
    "ayah_text_no_diacratic" : "وما نرسل المرسلين الا مبشرين ومنذرين ويجٰدل الذين كفروا بالبٰطل ليدحضوا به الحق واتخذوا ءايٰتي وما انذروا هزوا",
    "ayahnumber" : "56",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2230",
    "page" : "300",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2231",
    "ayah_text" : "وَمَنۡ أَظۡلَمُ مِمَّن ذُكِّرَ بِـَٔايَٰتِ رَبِّهِۦ فَأَعۡرَضَ عَنۡهَا وَنَسِيَ مَا قَدَّمَتۡ يَدَاهُۚ إِنَّا جَعَلۡنَا عَلَىٰ قُلُوبِهِمۡ أَكِنَّةً أَن يَفۡقَهُوهُ وَفِيٓ ءَاذَانِهِمۡ وَقۡرٗاۖ وَإِن تَدۡعُهُمۡ إِلَى ٱلۡهُدَىٰ فَلَن يَهۡتَدُوٓاْ إِذًا أَبَدٗا",
    "ayah_text_no_diacratic" : "ومن اظلم ممن ذكر بايٰت ربه فاعرض عنها ونسي ما قدمت يداه انا جعلنا علىٰ قلوبهم اكنة ان يفقهوه وفي ءاذانهم وقرا وان تدعهم الى الهدىٰ فلن يهتدوا اذا ابدا",
    "ayahnumber" : "57",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2231",
    "page" : "300",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2232",
    "ayah_text" : "وَرَبُّكَ ٱلۡغَفُورُ ذُو ٱلرَّحۡمَةِۖ لَوۡ يُؤَاخِذُهُم بِمَا كَسَبُواْ لَعَجَّلَ لَهُمُ ٱلۡعَذَابَۚ بَل لَّهُم مَّوۡعِدٞ لَّن يَجِدُواْ مِن دُونِهِۦ مَوۡئِلٗا",
    "ayah_text_no_diacratic" : "وربك الغفور ذو الرحمة لو يؤاخذهم بما كسبوا لعجل لهم العذاب بل لهم موعد لن يجدوا من دونه موئلا",
    "ayahnumber" : "58",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2232",
    "page" : "300",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2233",
    "ayah_text" : "وَتِلۡكَ ٱلۡقُرَىٰٓ أَهۡلَكۡنَٰهُمۡ لَمَّا ظَلَمُواْ وَجَعَلۡنَا لِمَهۡلِكِهِم مَّوۡعِدٗا",
    "ayah_text_no_diacratic" : "وتلك القرىٰ اهلكنٰهم لما ظلموا وجعلنا لمهلكهم موعدا",
    "ayahnumber" : "59",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2233",
    "page" : "300",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2234",
    "ayah_text" : "وَإِذۡ قَالَ مُوسَىٰ لِفَتَىٰهُ لَآ أَبۡرَحُ حَتَّىٰٓ أَبۡلُغَ مَجۡمَعَ ٱلۡبَحۡرَيۡنِ أَوۡ أَمۡضِيَ حُقُبٗا",
    "ayah_text_no_diacratic" : "واذ قال موسىٰ لفتىٰه لا ابرح حتىٰ ابلغ مجمع البحرين او امضي حقبا",
    "ayahnumber" : "60",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2234",
    "page" : "300",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2235",
    "ayah_text" : "فَلَمَّا بَلَغَا مَجۡمَعَ بَيۡنِهِمَا نَسِيَا حُوتَهُمَا فَٱتَّخَذَ سَبِيلَهُۥ فِي ٱلۡبَحۡرِ سَرَبٗا",
    "ayah_text_no_diacratic" : "فلما بلغا مجمع بينهما نسيا حوتهما فاتخذ سبيله في البحر سربا",
    "ayahnumber" : "61",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2235",
    "page" : "300",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2236",
    "ayah_text" : "فَلَمَّا جَاوَزَا قَالَ لِفَتَىٰهُ ءَاتِنَا غَدَآءَنَا لَقَدۡ لَقِينَا مِن سَفَرِنَا هَٰذَا نَصَبٗا",
    "ayah_text_no_diacratic" : "فلما جاوزا قال لفتىٰه ءاتنا غداءنا لقد لقينا من سفرنا هٰذا نصبا",
    "ayahnumber" : "62",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2236",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2237",
    "ayah_text" : "قَالَ أَرَءَيۡتَ إِذۡ أَوَيۡنَآ إِلَى ٱلصَّخۡرَةِ فَإِنِّي نَسِيتُ ٱلۡحُوتَ وَمَآ أَنسَىٰنِيهُ إِلَّا ٱلشَّيۡطَٰنُ أَنۡ أَذۡكُرَهُۥۚ وَٱتَّخَذَ سَبِيلَهُۥ فِي ٱلۡبَحۡرِ عَجَبٗا",
    "ayah_text_no_diacratic" : "قال ارءيت اذ اوينا الى الصخرة فاني نسيت الحوت وما انسىٰنيه الا الشيطٰن ان اذكره واتخذ سبيله في البحر عجبا",
    "ayahnumber" : "63",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2237",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2238",
    "ayah_text" : "قَالَ ذَٰلِكَ مَا كُنَّا نَبۡغِۚ فَٱرۡتَدَّا عَلَىٰٓ ءَاثَارِهِمَا قَصَصٗا",
    "ayah_text_no_diacratic" : "قال ذٰلك ما كنا نبغ فارتدا علىٰ ءاثارهما قصصا",
    "ayahnumber" : "64",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2238",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2239",
    "ayah_text" : "فَوَجَدَا عَبۡدٗا مِّنۡ عِبَادِنَآ ءَاتَيۡنَٰهُ رَحۡمَةٗ مِّنۡ عِندِنَا وَعَلَّمۡنَٰهُ مِن لَّدُنَّا عِلۡمٗا",
    "ayah_text_no_diacratic" : "فوجدا عبدا من عبادنا ءاتينٰه رحمة من عندنا وعلمنٰه من لدنا علما",
    "ayahnumber" : "65",
    "chapter" : "15",
    "hizb" : "30",
    "index" : "2239",
    "page" : "301",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:224",
    "ayah_text" : "أَمۡ حَسِبۡتُمۡ أَن تَدۡخُلُواْ ٱلۡجَنَّةَ وَلَمَّا يَأۡتِكُم مَّثَلُ ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلِكُمۖ مَّسَّتۡهُمُ ٱلۡبَأۡسَآءُ وَٱلضَّرَّآءُ وَزُلۡزِلُواْ حَتَّىٰ يَقُولَ ٱلرَّسُولُ وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ مَتَىٰ نَصۡرُ ٱللَّهِۗ أَلَآ إِنَّ نَصۡرَ ٱللَّهِ قَرِيبٞ",
    "ayah_text_no_diacratic" : "ام حسبتم ان تدخلوا الجنة ولما ياتكم مثل الذين خلوا من قبلكم مستهم الباساء والضراء وزلزلوا حتىٰ يقول الرسول والذين ءامنوا معه متىٰ نصر الله الا ان نصر الله قريب",
    "ayahnumber" : "214",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "224",
    "page" : "33",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2240",
    "ayah_text" : "قَالَ لَهُۥ مُوسَىٰ هَلۡ أَتَّبِعُكَ عَلَىٰٓ أَن تُعَلِّمَنِ مِمَّا عُلِّمۡتَ رُشۡدٗا",
    "ayah_text_no_diacratic" : "قال له موسىٰ هل اتبعك علىٰ ان تعلمن مما علمت رشدا",
    "ayahnumber" : "66",
    "chapter" : "15",
    "hizb" : "30",
