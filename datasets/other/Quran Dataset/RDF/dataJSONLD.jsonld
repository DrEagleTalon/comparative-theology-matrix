    "hizb" : "43",
    "index" : "3689",
    "page" : "430",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:369",
    "ayah_text" : "يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لِمَ تَلۡبِسُونَ ٱلۡحَقَّ بِٱلۡبَٰطِلِ وَتَكۡتُمُونَ ٱلۡحَقَّ وَأَنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "يٰاهل الكتٰب لم تلبسون الحق بالبٰطل وتكتمون الحق وانتم تعلمون",
    "ayahnumber" : "71",
    "chapter" : "3",
