  }, {
    "@id" : "quran:4553",
    "ayah_text" : "يَلۡبَسُونَ مِن سُندُسٖ وَإِسۡتَبۡرَقٖ مُّتَقَٰبِلِينَ",
    "ayah_text_no_diacratic" : "يلبسون من سندس واستبرق متقٰبلين",
