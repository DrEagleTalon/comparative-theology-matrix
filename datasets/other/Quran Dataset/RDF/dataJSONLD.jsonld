    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4095",
    "ayah_text" : "مُتَّكِـِٔينَ فِيهَا يَدۡعُونَ فِيهَا بِفَٰكِهَةٖ كَثِيرَةٖ وَشَرَابٖ",
    "ayah_text_no_diacratic" : "متكين فيها يدعون فيها بفٰكهة كثيرة وشراب",
    "ayahnumber" : "51",
    "chapter" : "23",
