  }, {
    "@id" : "quran:5551",
    "ayah_text" : "أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ",
    "ayah_text_no_diacratic" : "ايطمع كل امري منهم ان يدخل جنة نعيم",
