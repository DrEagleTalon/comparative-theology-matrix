  }, {
    "@id" : "quran:4503",
    "ayah_text" : "إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةٖ مُّبَٰرَكَةٍۚ إِنَّا كُنَّا مُنذِرِينَ",
    "ayah_text_no_diacratic" : "انا انزلنٰه في ليلة مبٰركة انا كنا منذرين",
