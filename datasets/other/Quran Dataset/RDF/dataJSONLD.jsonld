    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5622",
    "ayah_text" : "نِّصۡفَهُۥٓ أَوِ ٱنقُصۡ مِنۡهُ قَلِيلًا",
    "ayah_text_no_diacratic" : "نصفه او انقص منه قليلا",
    "ayahnumber" : "3",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5622",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5623",
    "ayah_text" : "أَوۡ زِدۡ عَلَيۡهِ وَرَتِّلِ ٱلۡقُرۡءَانَ تَرۡتِيلًا",
    "ayah_text_no_diacratic" : "او زد عليه ورتل القرءان ترتيلا",
    "ayahnumber" : "4",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5623",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5624",
    "ayah_text" : "إِنَّا سَنُلۡقِي عَلَيۡكَ قَوۡلٗا ثَقِيلًا",
    "ayah_text_no_diacratic" : "انا سنلقي عليك قولا ثقيلا",
    "ayahnumber" : "5",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5624",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5625",
    "ayah_text" : "إِنَّ نَاشِئَةَ ٱلَّيۡلِ هِيَ أَشَدُّ وَطۡـٔٗا وَأَقۡوَمُ قِيلًا",
    "ayah_text_no_diacratic" : "ان ناشئة اليل هي اشد وطا واقوم قيلا",
    "ayahnumber" : "6",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5625",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5626",
    "ayah_text" : "إِنَّ لَكَ فِي ٱلنَّهَارِ سَبۡحٗا طَوِيلٗا",
    "ayah_text_no_diacratic" : "ان لك في النهار سبحا طويلا",
    "ayahnumber" : "7",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5626",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5627",
    "ayah_text" : "وَٱذۡكُرِ ٱسۡمَ رَبِّكَ وَتَبَتَّلۡ إِلَيۡهِ تَبۡتِيلٗا",
    "ayah_text_no_diacratic" : "واذكر اسم ربك وتبتل اليه تبتيلا",
    "ayahnumber" : "8",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5627",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5628",
    "ayah_text" : "رَّبُّ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ لَآ إِلَٰهَ إِلَّا هُوَ فَٱتَّخِذۡهُ وَكِيلٗا",
    "ayah_text_no_diacratic" : "رب المشرق والمغرب لا الٰه الا هو فاتخذه وكيلا",
    "ayahnumber" : "9",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5628",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5629",
    "ayah_text" : "وَٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَٱهۡجُرۡهُمۡ هَجۡرٗا جَمِيلٗا",
    "ayah_text_no_diacratic" : "واصبر علىٰ ما يقولون واهجرهم هجرا جميلا",
    "ayahnumber" : "10",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5629",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:563",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ يَعۡلَمُ ٱللَّهُ مَا فِي قُلُوبِهِمۡ فَأَعۡرِضۡ عَنۡهُمۡ وَعِظۡهُمۡ وَقُل لَّهُمۡ فِيٓ أَنفُسِهِمۡ قَوۡلَۢا بَلِيغٗا",
    "ayah_text_no_diacratic" : "اولٰئك الذين يعلم الله ما في قلوبهم فاعرض عنهم وعظهم وقل لهم في انفسهم قولا بليغا",
    "ayahnumber" : "63",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "563",
    "page" : "88",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5630",
    "ayah_text" : "وَذَرۡنِي وَٱلۡمُكَذِّبِينَ أُوْلِي ٱلنَّعۡمَةِ وَمَهِّلۡهُمۡ قَلِيلًا",
    "ayah_text_no_diacratic" : "وذرني والمكذبين اولي النعمة ومهلهم قليلا",
    "ayahnumber" : "11",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5630",
