  }, {
    "@id" : "quran:4096",
    "ayah_text" : "۞وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ أَتۡرَابٌ",
    "ayah_text_no_diacratic" : "وعندهم قٰصرٰت الطرف اتراب",
