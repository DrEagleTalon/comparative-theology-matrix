  }, {
    "@id" : "quran:2633",
    "ayah_text" : "إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ مِنَ ٱلۡقَوۡلِ وَيَعۡلَمُ مَا تَكۡتُمُونَ",
    "ayah_text_no_diacratic" : "انه يعلم الجهر من القول ويعلم ما تكتمون",
    "ayahnumber" : "110",
    "chapter" : "17",
