  }, {
    "@id" : "quran:2022",
    "ayah_text" : "وَأَوۡفُواْ بِعَهۡدِ ٱللَّهِ إِذَا عَٰهَدتُّمۡ وَلَا تَنقُضُواْ ٱلۡأَيۡمَٰنَ بَعۡدَ تَوۡكِيدِهَا وَقَدۡ جَعَلۡتُمُ ٱللَّهَ عَلَيۡكُمۡ كَفِيلًاۚ إِنَّ ٱللَّهَ يَعۡلَمُ مَا تَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "واوفوا بعهد الله اذا عٰهدتم ولا تنقضوا الايمٰن بعد توكيدها وقد جعلتم الله عليكم كفيلا ان الله يعلم ما تفعلون",
    "ayahnumber" : "91",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2022",
    "page" : "277",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2023",
    "ayah_text" : "وَلَا تَكُونُواْ كَٱلَّتِي نَقَضَتۡ غَزۡلَهَا مِنۢ بَعۡدِ قُوَّةٍ أَنكَٰثٗا تَتَّخِذُونَ أَيۡمَٰنَكُمۡ دَخَلَۢا بَيۡنَكُمۡ أَن تَكُونَ أُمَّةٌ هِيَ أَرۡبَىٰ مِنۡ أُمَّةٍۚ إِنَّمَا يَبۡلُوكُمُ ٱللَّهُ بِهِۦۚ وَلَيُبَيِّنَنَّ لَكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ مَا كُنتُمۡ فِيهِ تَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "ولا تكونوا كالتي نقضت غزلها من بعد قوة انكٰثا تتخذون ايمٰنكم دخلا بينكم ان تكون امة هي اربىٰ من امة انما يبلوكم الله به وليبينن لكم يوم القيٰمة ما كنتم فيه تختلفون",
    "ayahnumber" : "92",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2023",
    "page" : "277",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2024",
    "ayah_text" : "وَلَوۡ شَآءَ ٱللَّهُ لَجَعَلَكُمۡ أُمَّةٗ وَٰحِدَةٗ وَلَٰكِن يُضِلُّ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَلَتُسۡـَٔلُنَّ عَمَّا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ولو شاء الله لجعلكم امة وٰحدة ولٰكن يضل من يشاء ويهدي من يشاء ولتسلن عما كنتم تعملون",
    "ayahnumber" : "93",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2024",
    "page" : "277",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2025",
    "ayah_text" : "وَلَا تَتَّخِذُوٓاْ أَيۡمَٰنَكُمۡ دَخَلَۢا بَيۡنَكُمۡ فَتَزِلَّ قَدَمُۢ بَعۡدَ ثُبُوتِهَا وَتَذُوقُواْ ٱلسُّوٓءَ بِمَا صَدَدتُّمۡ عَن سَبِيلِ ٱللَّهِ وَلَكُمۡ عَذَابٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "ولا تتخذوا ايمٰنكم دخلا بينكم فتزل قدم بعد ثبوتها وتذوقوا السوء بما صددتم عن سبيل الله ولكم عذاب عظيم",
    "ayahnumber" : "94",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2025",
    "page" : "278",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2026",
    "ayah_text" : "وَلَا تَشۡتَرُواْ بِعَهۡدِ ٱللَّهِ ثَمَنٗا قَلِيلًاۚ إِنَّمَا عِندَ ٱللَّهِ هُوَ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولا تشتروا بعهد الله ثمنا قليلا انما عند الله هو خير لكم ان كنتم تعلمون",
    "ayahnumber" : "95",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2026",
    "page" : "278",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2027",
    "ayah_text" : "مَا عِندَكُمۡ يَنفَدُ وَمَا عِندَ ٱللَّهِ بَاقٖۗ وَلَنَجۡزِيَنَّ ٱلَّذِينَ صَبَرُوٓاْ أَجۡرَهُم بِأَحۡسَنِ مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ما عندكم ينفد وما عند الله باق ولنجزين الذين صبروا اجرهم باحسن ما كانوا يعملون",
    "ayahnumber" : "96",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2027",
