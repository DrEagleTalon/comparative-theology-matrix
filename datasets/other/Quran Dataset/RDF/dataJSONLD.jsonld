    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1885",
    "ayah_text" : "قَالُواْ بَشَّرۡنَٰكَ بِٱلۡحَقِّ فَلَا تَكُن مِّنَ ٱلۡقَٰنِطِينَ",
    "ayah_text_no_diacratic" : "قالوا بشرنٰك بالحق فلا تكن من القٰنطين",
