  }, {
    "@id" : "quran:2406",
    "ayah_text" : "فَأَلۡقَىٰهَا فَإِذَا هِيَ حَيَّةٞ تَسۡعَىٰ",
    "ayah_text_no_diacratic" : "فالقىٰها فاذا هي حية تسعىٰ",
