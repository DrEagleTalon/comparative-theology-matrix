  }, {
    "@id" : "quran:3595",
    "ayah_text" : "فَأَعۡرِضۡ عَنۡهُمۡ وَٱنتَظِرۡ إِنَّهُم مُّنتَظِرُونَ",
    "ayah_text_no_diacratic" : "فاعرض عنهم وانتظر انهم منتظرون",
