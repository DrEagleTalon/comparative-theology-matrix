  }, {
    "@id" : "quran:3015",
    "ayah_text" : "وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيۡضَآءُ لِلنَّٰظِرِينَ",
    "ayah_text_no_diacratic" : "ونزع يده فاذا هي بيضاء للنٰظرين",
