    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:487",
    "ayah_text" : "وَلِلَّهِ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "ayah_text_no_diacratic" : "ولله ملك السمٰوٰت والارض والله علىٰ كل شيء قدير",
    "ayahnumber" : "189",
