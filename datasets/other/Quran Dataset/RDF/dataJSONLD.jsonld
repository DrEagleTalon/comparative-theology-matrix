  }, {
    "@id" : "quran:1065",
    "ayah_text" : "أَوَأَمِنَ أَهۡلُ ٱلۡقُرَىٰٓ أَن يَأۡتِيَهُم بَأۡسُنَا ضُحٗى وَهُمۡ يَلۡعَبُونَ",
    "ayah_text_no_diacratic" : "اوامن اهل القرىٰ ان ياتيهم باسنا ضحى وهم يلعبون",
