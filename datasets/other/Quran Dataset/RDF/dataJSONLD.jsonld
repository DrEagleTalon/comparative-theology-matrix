    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1384",
    "ayah_text" : "أَكَانَ لِلنَّاسِ عَجَبًا أَنۡ أَوۡحَيۡنَآ إِلَىٰ رَجُلٖ مِّنۡهُمۡ أَنۡ أَنذِرِ ٱلنَّاسَ وَبَشِّرِ ٱلَّذِينَ ءَامَنُوٓاْ أَنَّ لَهُمۡ قَدَمَ صِدۡقٍ عِندَ رَبِّهِمۡۗ قَالَ ٱلۡكَٰفِرُونَ إِنَّ هَٰذَا لَسَٰحِرٞ مُّبِينٌ",
    "ayah_text_no_diacratic" : "اكان للناس عجبا ان اوحينا الىٰ رجل منهم ان انذر الناس وبشر الذين ءامنوا ان لهم قدم صدق عند ربهم قال الكٰفرون ان هٰذا لسٰحر مبين",
    "ayahnumber" : "2",
    "chapter" : "11",
    "hizb" : "20",
    "index" : "1384",
    "page" : "208",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1385",
    "ayah_text" : "إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ يُدَبِّرُ ٱلۡأَمۡرَۖ مَا مِن شَفِيعٍ إِلَّا مِنۢ بَعۡدِ إِذۡنِهِۦۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ فَٱعۡبُدُوهُۚ أَفَلَا تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "ان ربكم الله الذي خلق السمٰوٰت والارض في ستة ايام ثم استوىٰ على العرش يدبر الامر ما من شفيع الا من بعد اذنه ذٰلكم الله ربكم فاعبدوه افلا تذكرون",
    "ayahnumber" : "3",
    "chapter" : "11",
    "hizb" : "20",
    "index" : "1385",
    "page" : "208",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1386",
    "ayah_text" : "إِلَيۡهِ مَرۡجِعُكُمۡ جَمِيعٗاۖ وَعۡدَ ٱللَّهِ حَقًّاۚ إِنَّهُۥ يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥ لِيَجۡزِيَ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ بِٱلۡقِسۡطِۚ وَٱلَّذِينَ كَفَرُواْ لَهُمۡ شَرَابٞ مِّنۡ حَمِيمٖ وَعَذَابٌ أَلِيمُۢ بِمَا كَانُواْ يَكۡفُرُونَ",
    "ayah_text_no_diacratic" : "اليه مرجعكم جميعا وعد الله حقا انه يبدؤا الخلق ثم يعيده ليجزي الذين ءامنوا وعملوا الصٰلحٰت بالقسط والذين كفروا لهم شراب من حميم وعذاب اليم بما كانوا يكفرون",
    "ayahnumber" : "4",
    "chapter" : "11",
    "hizb" : "20",
    "index" : "1386",
    "page" : "208",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1387",
    "ayah_text" : "هُوَ ٱلَّذِي جَعَلَ ٱلشَّمۡسَ ضِيَآءٗ وَٱلۡقَمَرَ نُورٗا وَقَدَّرَهُۥ مَنَازِلَ لِتَعۡلَمُواْ عَدَدَ ٱلسِّنِينَ وَٱلۡحِسَابَۚ مَا خَلَقَ ٱللَّهُ ذَٰلِكَ إِلَّا بِٱلۡحَقِّۚ يُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "هو الذي جعل الشمس ضياء والقمر نورا وقدره منازل لتعلموا عدد السنين والحساب ما خلق الله ذٰلك الا بالحق يفصل الايٰت لقوم يعلمون",
    "ayahnumber" : "5",
    "chapter" : "11",
    "hizb" : "20",
    "index" : "1387",
    "page" : "208",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1388",
    "ayah_text" : "إِنَّ فِي ٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ وَمَا خَلَقَ ٱللَّهُ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ لَأٓيَٰتٖ لِّقَوۡمٖ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "ان في اختلٰف اليل والنهار وما خلق الله في السمٰوٰت والارض لايٰت لقوم يتقون",
    "ayahnumber" : "6",
    "chapter" : "11",
    "hizb" : "20",
    "index" : "1388",
    "page" : "208",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:1389",
    "ayah_text" : "إِنَّ ٱلَّذِينَ لَا يَرۡجُونَ لِقَآءَنَا وَرَضُواْ بِٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَٱطۡمَأَنُّواْ بِهَا وَٱلَّذِينَ هُمۡ عَنۡ ءَايَٰتِنَا غَٰفِلُونَ",
    "ayah_text_no_diacratic" : "ان الذين لا يرجون لقاءنا ورضوا بالحيوٰة الدنيا واطمانوا بها والذين هم عن ءايٰتنا غٰفلون",
    "ayahnumber" : "7",
    "chapter" : "11",
    "hizb" : "20",
    "index" : "1389",
