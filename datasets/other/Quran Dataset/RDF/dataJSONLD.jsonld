    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:181",
    "ayah_text" : "وَمَثَلُ ٱلَّذِينَ كَفَرُواْ كَمَثَلِ ٱلَّذِي يَنۡعِقُ بِمَا لَا يَسۡمَعُ إِلَّا دُعَآءٗ وَنِدَآءٗۚ صُمُّۢ بُكۡمٌ عُمۡيٞ فَهُمۡ لَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ومثل الذين كفروا كمثل الذي ينعق بما لا يسمع الا دعاء ونداء صم بكم عمي فهم لا يعقلون",
    "ayahnumber" : "171",
    "chapter" : "2",
