    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3472",
    "ayah_text" : "بِنَصۡرِ ٱللَّهِۚ يَنصُرُ مَن يَشَآءُۖ وَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "بنصر الله ينصر من يشاء وهو العزيز الرحيم",
    "ayahnumber" : "5",
    "chapter" : "21",
    "hizb" : "40",
