    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1165",
    "ayah_text" : "وَإِن تَدۡعُوهُمۡ إِلَى ٱلۡهُدَىٰ لَا يَسۡمَعُواْۖ وَتَرَىٰهُمۡ يَنظُرُونَ إِلَيۡكَ وَهُمۡ لَا يُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "وان تدعوهم الى الهدىٰ لا يسمعوا وترىٰهم ينظرون اليك وهم لا يبصرون",
