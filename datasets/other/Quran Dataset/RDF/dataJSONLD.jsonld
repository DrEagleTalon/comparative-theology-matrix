    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4825",
    "ayah_text" : "فَفِرُّوٓاْ إِلَى ٱللَّهِۖ إِنِّي لَكُم مِّنۡهُ نَذِيرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "ففروا الى الله اني لكم منه نذير مبين",
