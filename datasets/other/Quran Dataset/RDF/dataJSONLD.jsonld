    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:885",
    "ayah_text" : "وَزَكَرِيَّا وَيَحۡيَىٰ وَعِيسَىٰ وَإِلۡيَاسَۖ كُلّٞ مِّنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "وزكريا ويحيىٰ وعيسىٰ والياس كل من الصٰلحين",
    "ayahnumber" : "85",
    "chapter" : "7",
    "hizb" : "13",
