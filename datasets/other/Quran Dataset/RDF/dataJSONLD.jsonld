    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:854",
    "ayah_text" : "وَإِذَا جَآءَكَ ٱلَّذِينَ يُؤۡمِنُونَ بِـَٔايَٰتِنَا فَقُلۡ سَلَٰمٌ عَلَيۡكُمۡۖ كَتَبَ رَبُّكُمۡ عَلَىٰ نَفۡسِهِ ٱلرَّحۡمَةَ أَنَّهُۥ مَنۡ عَمِلَ مِنكُمۡ سُوٓءَۢا بِجَهَٰلَةٖ ثُمَّ تَابَ مِنۢ بَعۡدِهِۦ وَأَصۡلَحَ فَأَنَّهُۥ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "واذا جاءك الذين يؤمنون بايٰتنا فقل سلٰم عليكم كتب ربكم علىٰ نفسه الرحمة انه من عمل منكم سوءا بجهٰلة ثم تاب من بعده واصلح فانه غفور رحيم",
    "ayahnumber" : "54",
    "chapter" : "7",
