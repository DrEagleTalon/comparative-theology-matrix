    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3876",
    "ayah_text" : "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
