  }, {
    "@id" : "quran:3018",
    "ayah_text" : "قَالُوٓاْ أَرۡجِهۡ وَأَخَاهُ وَٱبۡعَثۡ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ",
    "ayah_text_no_diacratic" : "قالوا ارجه واخاه وابعث في المدائن حٰشرين",
