    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1516",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَأَخۡبَتُوٓاْ إِلَىٰ رَبِّهِمۡ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡجَنَّةِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت واخبتوا الىٰ ربهم اولٰئك اصحٰب الجنة هم فيها خٰلدون",
    "ayahnumber" : "23",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1516",
    "page" : "224",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1517",
    "ayah_text" : "۞مَثَلُ ٱلۡفَرِيقَيۡنِ كَٱلۡأَعۡمَىٰ وَٱلۡأَصَمِّ وَٱلۡبَصِيرِ وَٱلسَّمِيعِۚ هَلۡ يَسۡتَوِيَانِ مَثَلًاۚ أَفَلَا تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "مثل الفريقين كالاعمىٰ والاصم والبصير والسميع هل يستويان مثلا افلا تذكرون",
    "ayahnumber" : "24",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1517",
    "page" : "224",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1518",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦٓ إِنِّي لَكُمۡ نَذِيرٞ مُّبِينٌ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا نوحا الىٰ قومه اني لكم نذير مبين",
    "ayahnumber" : "25",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1518",
    "page" : "224",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1519",
    "ayah_text" : "أَن لَّا تَعۡبُدُوٓاْ إِلَّا ٱللَّهَۖ إِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "ان لا تعبدوا الا الله اني اخاف عليكم عذاب يوم اليم",
    "ayahnumber" : "26",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1519",
    "page" : "224",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:152",
    "ayah_text" : "۞سَيَقُولُ ٱلسُّفَهَآءُ مِنَ ٱلنَّاسِ مَا وَلَّىٰهُمۡ عَن قِبۡلَتِهِمُ ٱلَّتِي كَانُواْ عَلَيۡهَاۚ قُل لِّلَّهِ ٱلۡمَشۡرِقُ وَٱلۡمَغۡرِبُۚ يَهۡدِي مَن يَشَآءُ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "سيقول السفهاء من الناس ما ولىٰهم عن قبلتهم التي كانوا عليها قل لله المشرق والمغرب يهدي من يشاء الىٰ صرٰط مستقيم",
    "ayahnumber" : "142",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "152",
    "page" : "22",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1520",
    "ayah_text" : "فَقَالَ ٱلۡمَلَأُ ٱلَّذِينَ كَفَرُواْ مِن قَوۡمِهِۦ مَا نَرَىٰكَ إِلَّا بَشَرٗا مِّثۡلَنَا وَمَا نَرَىٰكَ ٱتَّبَعَكَ إِلَّا ٱلَّذِينَ هُمۡ أَرَاذِلُنَا بَادِيَ ٱلرَّأۡيِ وَمَا نَرَىٰ لَكُمۡ عَلَيۡنَا مِن فَضۡلِۭ بَلۡ نَظُنُّكُمۡ كَٰذِبِينَ",
    "ayah_text_no_diacratic" : "فقال الملا الذين كفروا من قومه ما نرىٰك الا بشرا مثلنا وما نرىٰك اتبعك الا الذين هم اراذلنا بادي الراي وما نرىٰ لكم علينا من فضل بل نظنكم كٰذبين",
    "ayahnumber" : "27",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1520",
    "page" : "224",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1521",
    "ayah_text" : "قَالَ يَٰقَوۡمِ أَرَءَيۡتُمۡ إِن كُنتُ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّي وَءَاتَىٰنِي رَحۡمَةٗ مِّنۡ عِندِهِۦ فَعُمِّيَتۡ عَلَيۡكُمۡ أَنُلۡزِمُكُمُوهَا وَأَنتُمۡ لَهَا كَٰرِهُونَ",
    "ayah_text_no_diacratic" : "قال يٰقوم ارءيتم ان كنت علىٰ بينة من ربي وءاتىٰني رحمة من عنده فعميت عليكم انلزمكموها وانتم لها كٰرهون",
    "ayahnumber" : "28",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1521",
    "page" : "224",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1522",
    "ayah_text" : "وَيَٰقَوۡمِ لَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مَالًاۖ إِنۡ أَجۡرِيَ إِلَّا عَلَى ٱللَّهِۚ وَمَآ أَنَا۠ بِطَارِدِ ٱلَّذِينَ ءَامَنُوٓاْۚ إِنَّهُم مُّلَٰقُواْ رَبِّهِمۡ وَلَٰكِنِّيٓ أَرَىٰكُمۡ قَوۡمٗا تَجۡهَلُونَ",
    "ayah_text_no_diacratic" : "ويٰقوم لا اسلكم عليه مالا ان اجري الا على الله وما انا بطارد الذين ءامنوا انهم ملٰقوا ربهم ولٰكني ارىٰكم قوما تجهلون",
    "ayahnumber" : "29",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1522",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1523",
    "ayah_text" : "وَيَٰقَوۡمِ مَن يَنصُرُنِي مِنَ ٱللَّهِ إِن طَرَدتُّهُمۡۚ أَفَلَا تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "ويٰقوم من ينصرني من الله ان طردتهم افلا تذكرون",
    "ayahnumber" : "30",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1523",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1524",
    "ayah_text" : "وَلَآ أَقُولُ لَكُمۡ عِندِي خَزَآئِنُ ٱللَّهِ وَلَآ أَعۡلَمُ ٱلۡغَيۡبَ وَلَآ أَقُولُ إِنِّي مَلَكٞ وَلَآ أَقُولُ لِلَّذِينَ تَزۡدَرِيٓ أَعۡيُنُكُمۡ لَن يُؤۡتِيَهُمُ ٱللَّهُ خَيۡرًاۖ ٱللَّهُ أَعۡلَمُ بِمَا فِيٓ أَنفُسِهِمۡ إِنِّيٓ إِذٗا لَّمِنَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ولا اقول لكم عندي خزائن الله ولا اعلم الغيب ولا اقول اني ملك ولا اقول للذين تزدري اعينكم لن يؤتيهم الله خيرا الله اعلم بما في انفسهم اني اذا لمن الظٰلمين",
    "ayahnumber" : "31",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1524",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1525",
    "ayah_text" : "قَالُواْ يَٰنُوحُ قَدۡ جَٰدَلۡتَنَا فَأَكۡثَرۡتَ جِدَٰلَنَا فَأۡتِنَا بِمَا تَعِدُنَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "قالوا يٰنوح قد جٰدلتنا فاكثرت جدٰلنا فاتنا بما تعدنا ان كنت من الصٰدقين",
    "ayahnumber" : "32",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1525",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1526",
    "ayah_text" : "قَالَ إِنَّمَا يَأۡتِيكُم بِهِ ٱللَّهُ إِن شَآءَ وَمَآ أَنتُم بِمُعۡجِزِينَ",
    "ayah_text_no_diacratic" : "قال انما ياتيكم به الله ان شاء وما انتم بمعجزين",
    "ayahnumber" : "33",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1526",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1527",
    "ayah_text" : "وَلَا يَنفَعُكُمۡ نُصۡحِيٓ إِنۡ أَرَدتُّ أَنۡ أَنصَحَ لَكُمۡ إِن كَانَ ٱللَّهُ يُرِيدُ أَن يُغۡوِيَكُمۡۚ هُوَ رَبُّكُمۡ وَإِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "ولا ينفعكم نصحي ان اردت ان انصح لكم ان كان الله يريد ان يغويكم هو ربكم واليه ترجعون",
    "ayahnumber" : "34",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1527",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1528",
    "ayah_text" : "أَمۡ يَقُولُونَ ٱفۡتَرَىٰهُۖ قُلۡ إِنِ ٱفۡتَرَيۡتُهُۥ فَعَلَيَّ إِجۡرَامِي وَأَنَا۠ بَرِيٓءٞ مِّمَّا تُجۡرِمُونَ",
    "ayah_text_no_diacratic" : "ام يقولون افترىٰه قل ان افتريته فعلي اجرامي وانا بريء مما تجرمون",
    "ayahnumber" : "35",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1528",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1529",
    "ayah_text" : "وَأُوحِيَ إِلَىٰ نُوحٍ أَنَّهُۥ لَن يُؤۡمِنَ مِن قَوۡمِكَ إِلَّا مَن قَدۡ ءَامَنَ فَلَا تَبۡتَئِسۡ بِمَا كَانُواْ يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "واوحي الىٰ نوح انه لن يؤمن من قومك الا من قد ءامن فلا تبتئس بما كانوا يفعلون",
    "ayahnumber" : "36",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1529",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:153",
    "ayah_text" : "وَكَذَٰلِكَ جَعَلۡنَٰكُمۡ أُمَّةٗ وَسَطٗا لِّتَكُونُواْ شُهَدَآءَ عَلَى ٱلنَّاسِ وَيَكُونَ ٱلرَّسُولُ عَلَيۡكُمۡ شَهِيدٗاۗ وَمَا جَعَلۡنَا ٱلۡقِبۡلَةَ ٱلَّتِي كُنتَ عَلَيۡهَآ إِلَّا لِنَعۡلَمَ مَن يَتَّبِعُ ٱلرَّسُولَ مِمَّن يَنقَلِبُ عَلَىٰ عَقِبَيۡهِۚ وَإِن كَانَتۡ لَكَبِيرَةً إِلَّا عَلَى ٱلَّذِينَ هَدَى ٱللَّهُۗ وَمَا كَانَ ٱللَّهُ لِيُضِيعَ إِيمَٰنَكُمۡۚ إِنَّ ٱللَّهَ بِٱلنَّاسِ لَرَءُوفٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "وكذٰلك جعلنٰكم امة وسطا لتكونوا شهداء على الناس ويكون الرسول عليكم شهيدا وما جعلنا القبلة التي كنت عليها الا لنعلم من يتبع الرسول ممن ينقلب علىٰ عقبيه وان كانت لكبيرة الا على الذين هدى الله وما كان الله ليضيع ايمٰنكم ان الله بالناس لرءوف رحيم",
    "ayahnumber" : "143",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "153",
    "page" : "22",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1530",
    "ayah_text" : "وَٱصۡنَعِ ٱلۡفُلۡكَ بِأَعۡيُنِنَا وَوَحۡيِنَا وَلَا تُخَٰطِبۡنِي فِي ٱلَّذِينَ ظَلَمُوٓاْ إِنَّهُم مُّغۡرَقُونَ",
    "ayah_text_no_diacratic" : "واصنع الفلك باعيننا ووحينا ولا تخٰطبني في الذين ظلموا انهم مغرقون",
    "ayahnumber" : "37",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1530",
    "page" : "225",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1531",
    "ayah_text" : "وَيَصۡنَعُ ٱلۡفُلۡكَ وَكُلَّمَا مَرَّ عَلَيۡهِ مَلَأٞ مِّن قَوۡمِهِۦ سَخِرُواْ مِنۡهُۚ قَالَ إِن تَسۡخَرُواْ مِنَّا فَإِنَّا نَسۡخَرُ مِنكُمۡ كَمَا تَسۡخَرُونَ",
    "ayah_text_no_diacratic" : "ويصنع الفلك وكلما مر عليه ملا من قومه سخروا منه قال ان تسخروا منا فانا نسخر منكم كما تسخرون",
    "ayahnumber" : "38",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1531",
    "page" : "226",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1532",
    "ayah_text" : "فَسَوۡفَ تَعۡلَمُونَ مَن يَأۡتِيهِ عَذَابٞ يُخۡزِيهِ وَيَحِلُّ عَلَيۡهِ عَذَابٞ مُّقِيمٌ",
    "ayah_text_no_diacratic" : "فسوف تعلمون من ياتيه عذاب يخزيه ويحل عليه عذاب مقيم",
    "ayahnumber" : "39",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1532",
    "page" : "226",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1533",
    "ayah_text" : "حَتَّىٰٓ إِذَا جَآءَ أَمۡرُنَا وَفَارَ ٱلتَّنُّورُ قُلۡنَا ٱحۡمِلۡ فِيهَا مِن كُلّٖ زَوۡجَيۡنِ ٱثۡنَيۡنِ وَأَهۡلَكَ إِلَّا مَن سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ وَمَنۡ ءَامَنَۚ وَمَآ ءَامَنَ مَعَهُۥٓ إِلَّا قَلِيلٞ",
    "ayah_text_no_diacratic" : "حتىٰ اذا جاء امرنا وفار التنور قلنا احمل فيها من كل زوجين اثنين واهلك الا من سبق عليه القول ومن ءامن وما ءامن معه الا قليل",
    "ayahnumber" : "40",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1533",
    "page" : "226",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1534",
    "ayah_text" : "۞وَقَالَ ٱرۡكَبُواْ فِيهَا بِسۡمِ ٱللَّهِ مَجۡرٜىٰهَا وَمُرۡسَىٰهَآۚ إِنَّ رَبِّي لَغَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "وقال اركبوا فيها بسم الله مجرىٰها ومرسىٰها ان ربي لغفور رحيم",
    "ayahnumber" : "41",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1534",
    "page" : "226",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1535",
    "ayah_text" : "وَهِيَ تَجۡرِي بِهِمۡ فِي مَوۡجٖ كَٱلۡجِبَالِ وَنَادَىٰ نُوحٌ ٱبۡنَهُۥ وَكَانَ فِي مَعۡزِلٖ يَٰبُنَيَّ ٱرۡكَب مَّعَنَا وَلَا تَكُن مَّعَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "وهي تجري بهم في موج كالجبال ونادىٰ نوح ابنه وكان في معزل يٰبني اركب معنا ولا تكن مع الكٰفرين",
    "ayahnumber" : "42",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1535",
    "page" : "226",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1536",
    "ayah_text" : "قَالَ سَـَٔاوِيٓ إِلَىٰ جَبَلٖ يَعۡصِمُنِي مِنَ ٱلۡمَآءِۚ قَالَ لَا عَاصِمَ ٱلۡيَوۡمَ مِنۡ أَمۡرِ ٱللَّهِ إِلَّا مَن رَّحِمَۚ وَحَالَ بَيۡنَهُمَا ٱلۡمَوۡجُ فَكَانَ مِنَ ٱلۡمُغۡرَقِينَ",
    "ayah_text_no_diacratic" : "قال ساوي الىٰ جبل يعصمني من الماء قال لا عاصم اليوم من امر الله الا من رحم وحال بينهما الموج فكان من المغرقين",
    "ayahnumber" : "43",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1536",
    "page" : "226",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1537",
    "ayah_text" : "وَقِيلَ يَٰٓأَرۡضُ ٱبۡلَعِي مَآءَكِ وَيَٰسَمَآءُ أَقۡلِعِي وَغِيضَ ٱلۡمَآءُ وَقُضِيَ ٱلۡأَمۡرُ وَٱسۡتَوَتۡ عَلَى ٱلۡجُودِيِّۖ وَقِيلَ بُعۡدٗا لِّلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "وقيل يٰارض ابلعي ماءك ويٰسماء اقلعي وغيض الماء وقضي الامر واستوت على الجودي وقيل بعدا للقوم الظٰلمين",
    "ayahnumber" : "44",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1537",
    "page" : "226",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1538",
    "ayah_text" : "وَنَادَىٰ نُوحٞ رَّبَّهُۥ فَقَالَ رَبِّ إِنَّ ٱبۡنِي مِنۡ أَهۡلِي وَإِنَّ وَعۡدَكَ ٱلۡحَقُّ وَأَنتَ أَحۡكَمُ ٱلۡحَٰكِمِينَ",
    "ayah_text_no_diacratic" : "ونادىٰ نوح ربه فقال رب ان ابني من اهلي وان وعدك الحق وانت احكم الحٰكمين",
    "ayahnumber" : "45",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1538",
    "page" : "226",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1539",
    "ayah_text" : "قَالَ يَٰنُوحُ إِنَّهُۥ لَيۡسَ مِنۡ أَهۡلِكَۖ إِنَّهُۥ عَمَلٌ غَيۡرُ صَٰلِحٖۖ فَلَا تَسۡـَٔلۡنِ مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٌۖ إِنِّيٓ أَعِظُكَ أَن تَكُونَ مِنَ ٱلۡجَٰهِلِينَ",
    "ayah_text_no_diacratic" : "قال يٰنوح انه ليس من اهلك انه عمل غير صٰلح فلا تسلن ما ليس لك به علم اني اعظك ان تكون من الجٰهلين",
    "ayahnumber" : "46",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1539",
    "page" : "227",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:154",
    "ayah_text" : "قَدۡ نَرَىٰ تَقَلُّبَ وَجۡهِكَ فِي ٱلسَّمَآءِۖ فَلَنُوَلِّيَنَّكَ قِبۡلَةٗ تَرۡضَىٰهَاۚ فَوَلِّ وَجۡهَكَ شَطۡرَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِۚ وَحَيۡثُ مَا كُنتُمۡ فَوَلُّواْ وُجُوهَكُمۡ شَطۡرَهُۥۗ وَإِنَّ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ لَيَعۡلَمُونَ أَنَّهُ ٱلۡحَقُّ مِن رَّبِّهِمۡۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "قد نرىٰ تقلب وجهك في السماء فلنولينك قبلة ترضىٰها فول وجهك شطر المسجد الحرام وحيث ما كنتم فولوا وجوهكم شطره وان الذين اوتوا الكتٰب ليعلمون انه الحق من ربهم وما الله بغٰفل عما يعملون",
    "ayahnumber" : "144",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "154",
    "page" : "22",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1540",
    "ayah_text" : "قَالَ رَبِّ إِنِّيٓ أَعُوذُ بِكَ أَنۡ أَسۡـَٔلَكَ مَا لَيۡسَ لِي بِهِۦ عِلۡمٞۖ وَإِلَّا تَغۡفِرۡ لِي وَتَرۡحَمۡنِيٓ أَكُن مِّنَ ٱلۡخَٰسِرِينَ",
    "ayah_text_no_diacratic" : "قال رب اني اعوذ بك ان اسلك ما ليس لي به علم والا تغفر لي وترحمني اكن من الخٰسرين",
    "ayahnumber" : "47",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1540",
    "page" : "227",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1541",
    "ayah_text" : "قِيلَ يَٰنُوحُ ٱهۡبِطۡ بِسَلَٰمٖ مِّنَّا وَبَرَكَٰتٍ عَلَيۡكَ وَعَلَىٰٓ أُمَمٖ مِّمَّن مَّعَكَۚ وَأُمَمٞ سَنُمَتِّعُهُمۡ ثُمَّ يَمَسُّهُم مِّنَّا عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "قيل يٰنوح اهبط بسلٰم منا وبركٰت عليك وعلىٰ امم ممن معك وامم سنمتعهم ثم يمسهم منا عذاب اليم",
    "ayahnumber" : "48",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1541",
    "page" : "227",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1542",
    "ayah_text" : "تِلۡكَ مِنۡ أَنۢبَآءِ ٱلۡغَيۡبِ نُوحِيهَآ إِلَيۡكَۖ مَا كُنتَ تَعۡلَمُهَآ أَنتَ وَلَا قَوۡمُكَ مِن قَبۡلِ هَٰذَاۖ فَٱصۡبِرۡۖ إِنَّ ٱلۡعَٰقِبَةَ لِلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "تلك من انباء الغيب نوحيها اليك ما كنت تعلمها انت ولا قومك من قبل هٰذا فاصبر ان العٰقبة للمتقين",
    "ayahnumber" : "49",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1542",
    "page" : "227",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1543",
    "ayah_text" : "وَإِلَىٰ عَادٍ أَخَاهُمۡ هُودٗاۚ قَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓۖ إِنۡ أَنتُمۡ إِلَّا مُفۡتَرُونَ",
    "ayah_text_no_diacratic" : "والىٰ عاد اخاهم هودا قال يٰقوم اعبدوا الله ما لكم من الٰه غيره ان انتم الا مفترون",
    "ayahnumber" : "50",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1543",
    "page" : "227",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1544",
    "ayah_text" : "يَٰقَوۡمِ لَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ أَجۡرًاۖ إِنۡ أَجۡرِيَ إِلَّا عَلَى ٱلَّذِي فَطَرَنِيٓۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "يٰقوم لا اسلكم عليه اجرا ان اجري الا على الذي فطرني افلا تعقلون",
    "ayahnumber" : "51",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1544",
    "page" : "227",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1545",
    "ayah_text" : "وَيَٰقَوۡمِ ٱسۡتَغۡفِرُواْ رَبَّكُمۡ ثُمَّ تُوبُوٓاْ إِلَيۡهِ يُرۡسِلِ ٱلسَّمَآءَ عَلَيۡكُم مِّدۡرَارٗا وَيَزِدۡكُمۡ قُوَّةً إِلَىٰ قُوَّتِكُمۡ وَلَا تَتَوَلَّوۡاْ مُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "ويٰقوم استغفروا ربكم ثم توبوا اليه يرسل السماء عليكم مدرارا ويزدكم قوة الىٰ قوتكم ولا تتولوا مجرمين",
    "ayahnumber" : "52",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1545",
    "page" : "227",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1546",
    "ayah_text" : "قَالُواْ يَٰهُودُ مَا جِئۡتَنَا بِبَيِّنَةٖ وَمَا نَحۡنُ بِتَارِكِيٓ ءَالِهَتِنَا عَن قَوۡلِكَ وَمَا نَحۡنُ لَكَ بِمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "قالوا يٰهود ما جئتنا ببينة وما نحن بتاركي ءالهتنا عن قولك وما نحن لك بمؤمنين",
    "ayahnumber" : "53",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1546",
    "page" : "227",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1547",
    "ayah_text" : "إِن نَّقُولُ إِلَّا ٱعۡتَرَىٰكَ بَعۡضُ ءَالِهَتِنَا بِسُوٓءٖۗ قَالَ إِنِّيٓ أُشۡهِدُ ٱللَّهَ وَٱشۡهَدُوٓاْ أَنِّي بَرِيٓءٞ مِّمَّا تُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "ان نقول الا اعترىٰك بعض ءالهتنا بسوء قال اني اشهد الله واشهدوا اني بريء مما تشركون",
    "ayahnumber" : "54",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1547",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1548",
    "ayah_text" : "مِن دُونِهِۦۖ فَكِيدُونِي جَمِيعٗا ثُمَّ لَا تُنظِرُونِ",
    "ayah_text_no_diacratic" : "من دونه فكيدوني جميعا ثم لا تنظرون",
    "ayahnumber" : "55",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1548",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1549",
    "ayah_text" : "إِنِّي تَوَكَّلۡتُ عَلَى ٱللَّهِ رَبِّي وَرَبِّكُمۚ مَّا مِن دَآبَّةٍ إِلَّا هُوَ ءَاخِذُۢ بِنَاصِيَتِهَآۚ إِنَّ رَبِّي عَلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "اني توكلت على الله ربي وربكم ما من دابة الا هو ءاخذ بناصيتها ان ربي علىٰ صرٰط مستقيم",
    "ayahnumber" : "56",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1549",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:155",
    "ayah_text" : "وَلَئِنۡ أَتَيۡتَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ بِكُلِّ ءَايَةٖ مَّا تَبِعُواْ قِبۡلَتَكَۚ وَمَآ أَنتَ بِتَابِعٖ قِبۡلَتَهُمۡۚ وَمَا بَعۡضُهُم بِتَابِعٖ قِبۡلَةَ بَعۡضٖۚ وَلَئِنِ ٱتَّبَعۡتَ أَهۡوَآءَهُم مِّنۢ بَعۡدِ مَا جَآءَكَ مِنَ ٱلۡعِلۡمِ إِنَّكَ إِذٗا لَّمِنَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ولئن اتيت الذين اوتوا الكتٰب بكل ءاية ما تبعوا قبلتك وما انت بتابع قبلتهم وما بعضهم بتابع قبلة بعض ولئن اتبعت اهواءهم من بعد ما جاءك من العلم انك اذا لمن الظٰلمين",
    "ayahnumber" : "145",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "155",
    "page" : "22",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1550",
    "ayah_text" : "فَإِن تَوَلَّوۡاْ فَقَدۡ أَبۡلَغۡتُكُم مَّآ أُرۡسِلۡتُ بِهِۦٓ إِلَيۡكُمۡۚ وَيَسۡتَخۡلِفُ رَبِّي قَوۡمًا غَيۡرَكُمۡ وَلَا تَضُرُّونَهُۥ شَيۡـًٔاۚ إِنَّ رَبِّي عَلَىٰ كُلِّ شَيۡءٍ حَفِيظٞ",
    "ayah_text_no_diacratic" : "فان تولوا فقد ابلغتكم ما ارسلت به اليكم ويستخلف ربي قوما غيركم ولا تضرونه شيا ان ربي علىٰ كل شيء حفيظ",
    "ayahnumber" : "57",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1550",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1551",
    "ayah_text" : "وَلَمَّا جَآءَ أَمۡرُنَا نَجَّيۡنَا هُودٗا وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ بِرَحۡمَةٖ مِّنَّا وَنَجَّيۡنَٰهُم مِّنۡ عَذَابٍ غَلِيظٖ",
    "ayah_text_no_diacratic" : "ولما جاء امرنا نجينا هودا والذين ءامنوا معه برحمة منا ونجينٰهم من عذاب غليظ",
    "ayahnumber" : "58",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1551",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1552",
    "ayah_text" : "وَتِلۡكَ عَادٞۖ جَحَدُواْ بِـَٔايَٰتِ رَبِّهِمۡ وَعَصَوۡاْ رُسُلَهُۥ وَٱتَّبَعُوٓاْ أَمۡرَ كُلِّ جَبَّارٍ عَنِيدٖ",
    "ayah_text_no_diacratic" : "وتلك عاد جحدوا بايٰت ربهم وعصوا رسله واتبعوا امر كل جبار عنيد",
    "ayahnumber" : "59",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1552",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1553",
    "ayah_text" : "وَأُتۡبِعُواْ فِي هَٰذِهِ ٱلدُّنۡيَا لَعۡنَةٗ وَيَوۡمَ ٱلۡقِيَٰمَةِۗ أَلَآ إِنَّ عَادٗا كَفَرُواْ رَبَّهُمۡۗ أَلَا بُعۡدٗا لِّعَادٖ قَوۡمِ هُودٖ",
    "ayah_text_no_diacratic" : "واتبعوا في هٰذه الدنيا لعنة ويوم القيٰمة الا ان عادا كفروا ربهم الا بعدا لعاد قوم هود",
    "ayahnumber" : "60",
    "chapter" : "12",
    "hizb" : "22",
    "index" : "1553",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1554",
    "ayah_text" : "۞وَإِلَىٰ ثَمُودَ أَخَاهُمۡ صَٰلِحٗاۚ قَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥۖ هُوَ أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ وَٱسۡتَعۡمَرَكُمۡ فِيهَا فَٱسۡتَغۡفِرُوهُ ثُمَّ تُوبُوٓاْ إِلَيۡهِۚ إِنَّ رَبِّي قَرِيبٞ مُّجِيبٞ",
    "ayah_text_no_diacratic" : "والىٰ ثمود اخاهم صٰلحا قال يٰقوم اعبدوا الله ما لكم من الٰه غيره هو انشاكم من الارض واستعمركم فيها فاستغفروه ثم توبوا اليه ان ربي قريب مجيب",
    "ayahnumber" : "61",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1554",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1555",
    "ayah_text" : "قَالُواْ يَٰصَٰلِحُ قَدۡ كُنتَ فِينَا مَرۡجُوّٗا قَبۡلَ هَٰذَآۖ أَتَنۡهَىٰنَآ أَن نَّعۡبُدَ مَا يَعۡبُدُ ءَابَآؤُنَا وَإِنَّنَا لَفِي شَكّٖ مِّمَّا تَدۡعُونَآ إِلَيۡهِ مُرِيبٖ",
    "ayah_text_no_diacratic" : "قالوا يٰصٰلح قد كنت فينا مرجوا قبل هٰذا اتنهىٰنا ان نعبد ما يعبد ءاباؤنا واننا لفي شك مما تدعونا اليه مريب",
    "ayahnumber" : "62",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1555",
    "page" : "228",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1556",
    "ayah_text" : "قَالَ يَٰقَوۡمِ أَرَءَيۡتُمۡ إِن كُنتُ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّي وَءَاتَىٰنِي مِنۡهُ رَحۡمَةٗ فَمَن يَنصُرُنِي مِنَ ٱللَّهِ إِنۡ عَصَيۡتُهُۥۖ فَمَا تَزِيدُونَنِي غَيۡرَ تَخۡسِيرٖ",
    "ayah_text_no_diacratic" : "قال يٰقوم ارءيتم ان كنت علىٰ بينة من ربي وءاتىٰني منه رحمة فمن ينصرني من الله ان عصيته فما تزيدونني غير تخسير",
    "ayahnumber" : "63",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1556",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1557",
    "ayah_text" : "وَيَٰقَوۡمِ هَٰذِهِۦ نَاقَةُ ٱللَّهِ لَكُمۡ ءَايَةٗۖ فَذَرُوهَا تَأۡكُلۡ فِيٓ أَرۡضِ ٱللَّهِۖ وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَأۡخُذَكُمۡ عَذَابٞ قَرِيبٞ",
    "ayah_text_no_diacratic" : "ويٰقوم هٰذه ناقة الله لكم ءاية فذروها تاكل في ارض الله ولا تمسوها بسوء فياخذكم عذاب قريب",
    "ayahnumber" : "64",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1557",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1558",
    "ayah_text" : "فَعَقَرُوهَا فَقَالَ تَمَتَّعُواْ فِي دَارِكُمۡ ثَلَٰثَةَ أَيَّامٖۖ ذَٰلِكَ وَعۡدٌ غَيۡرُ مَكۡذُوبٖ",
    "ayah_text_no_diacratic" : "فعقروها فقال تمتعوا في داركم ثلٰثة ايام ذٰلك وعد غير مكذوب",
    "ayahnumber" : "65",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1558",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1559",
    "ayah_text" : "فَلَمَّا جَآءَ أَمۡرُنَا نَجَّيۡنَا صَٰلِحٗا وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ بِرَحۡمَةٖ مِّنَّا وَمِنۡ خِزۡيِ يَوۡمِئِذٍۚ إِنَّ رَبَّكَ هُوَ ٱلۡقَوِيُّ ٱلۡعَزِيزُ",
    "ayah_text_no_diacratic" : "فلما جاء امرنا نجينا صٰلحا والذين ءامنوا معه برحمة منا ومن خزي يومئذ ان ربك هو القوي العزيز",
    "ayahnumber" : "66",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1559",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:156",
    "ayah_text" : "ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَعۡرِفُونَهُۥ كَمَا يَعۡرِفُونَ أَبۡنَآءَهُمۡۖ وَإِنَّ فَرِيقٗا مِّنۡهُمۡ لَيَكۡتُمُونَ ٱلۡحَقَّ وَهُمۡ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "الذين ءاتينٰهم الكتٰب يعرفونه كما يعرفون ابناءهم وان فريقا منهم ليكتمون الحق وهم يعلمون",
    "ayahnumber" : "146",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "156",
    "page" : "23",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1560",
    "ayah_text" : "وَأَخَذَ ٱلَّذِينَ ظَلَمُواْ ٱلصَّيۡحَةُ فَأَصۡبَحُواْ فِي دِيَٰرِهِمۡ جَٰثِمِينَ",
    "ayah_text_no_diacratic" : "واخذ الذين ظلموا الصيحة فاصبحوا في ديٰرهم جٰثمين",
    "ayahnumber" : "67",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1560",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1561",
    "ayah_text" : "كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَآۗ أَلَآ إِنَّ ثَمُودَاْ كَفَرُواْ رَبَّهُمۡۗ أَلَا بُعۡدٗا لِّثَمُودَ",
    "ayah_text_no_diacratic" : "كان لم يغنوا فيها الا ان ثمودا كفروا ربهم الا بعدا لثمود",
    "ayahnumber" : "68",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1561",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1562",
    "ayah_text" : "وَلَقَدۡ جَآءَتۡ رُسُلُنَآ إِبۡرَٰهِيمَ بِٱلۡبُشۡرَىٰ قَالُواْ سَلَٰمٗاۖ قَالَ سَلَٰمٞۖ فَمَا لَبِثَ أَن جَآءَ بِعِجۡلٍ حَنِيذٖ",
    "ayah_text_no_diacratic" : "ولقد جاءت رسلنا ابرٰهيم بالبشرىٰ قالوا سلٰما قال سلٰم فما لبث ان جاء بعجل حنيذ",
    "ayahnumber" : "69",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1562",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1563",
    "ayah_text" : "فَلَمَّا رَءَآ أَيۡدِيَهُمۡ لَا تَصِلُ إِلَيۡهِ نَكِرَهُمۡ وَأَوۡجَسَ مِنۡهُمۡ خِيفَةٗۚ قَالُواْ لَا تَخَفۡ إِنَّآ أُرۡسِلۡنَآ إِلَىٰ قَوۡمِ لُوطٖ",
    "ayah_text_no_diacratic" : "فلما رءا ايديهم لا تصل اليه نكرهم واوجس منهم خيفة قالوا لا تخف انا ارسلنا الىٰ قوم لوط",
    "ayahnumber" : "70",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1563",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1564",
    "ayah_text" : "وَٱمۡرَأَتُهُۥ قَآئِمَةٞ فَضَحِكَتۡ فَبَشَّرۡنَٰهَا بِإِسۡحَٰقَ وَمِن وَرَآءِ إِسۡحَٰقَ يَعۡقُوبَ",
    "ayah_text_no_diacratic" : "وامراته قائمة فضحكت فبشرنٰها باسحٰق ومن وراء اسحٰق يعقوب",
    "ayahnumber" : "71",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1564",
    "page" : "229",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1565",
    "ayah_text" : "قَالَتۡ يَٰوَيۡلَتَىٰٓ ءَأَلِدُ وَأَنَا۠ عَجُوزٞ وَهَٰذَا بَعۡلِي شَيۡخًاۖ إِنَّ هَٰذَا لَشَيۡءٌ عَجِيبٞ",
    "ayah_text_no_diacratic" : "قالت يٰويلتىٰ ءالد وانا عجوز وهٰذا بعلي شيخا ان هٰذا لشيء عجيب",
    "ayahnumber" : "72",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1565",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1566",
    "ayah_text" : "قَالُوٓاْ أَتَعۡجَبِينَ مِنۡ أَمۡرِ ٱللَّهِۖ رَحۡمَتُ ٱللَّهِ وَبَرَكَٰتُهُۥ عَلَيۡكُمۡ أَهۡلَ ٱلۡبَيۡتِۚ إِنَّهُۥ حَمِيدٞ مَّجِيدٞ",
    "ayah_text_no_diacratic" : "قالوا اتعجبين من امر الله رحمت الله وبركٰته عليكم اهل البيت انه حميد مجيد",
    "ayahnumber" : "73",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1566",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1567",
    "ayah_text" : "فَلَمَّا ذَهَبَ عَنۡ إِبۡرَٰهِيمَ ٱلرَّوۡعُ وَجَآءَتۡهُ ٱلۡبُشۡرَىٰ يُجَٰدِلُنَا فِي قَوۡمِ لُوطٍ",
    "ayah_text_no_diacratic" : "فلما ذهب عن ابرٰهيم الروع وجاءته البشرىٰ يجٰدلنا في قوم لوط",
    "ayahnumber" : "74",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1567",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1568",
    "ayah_text" : "إِنَّ إِبۡرَٰهِيمَ لَحَلِيمٌ أَوَّٰهٞ مُّنِيبٞ",
    "ayah_text_no_diacratic" : "ان ابرٰهيم لحليم اوٰه منيب",
    "ayahnumber" : "75",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1568",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1569",
    "ayah_text" : "يَٰٓإِبۡرَٰهِيمُ أَعۡرِضۡ عَنۡ هَٰذَآۖ إِنَّهُۥ قَدۡ جَآءَ أَمۡرُ رَبِّكَۖ وَإِنَّهُمۡ ءَاتِيهِمۡ عَذَابٌ غَيۡرُ مَرۡدُودٖ",
    "ayah_text_no_diacratic" : "يٰابرٰهيم اعرض عن هٰذا انه قد جاء امر ربك وانهم ءاتيهم عذاب غير مردود",
    "ayahnumber" : "76",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1569",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:157",
    "ayah_text" : "ٱلۡحَقُّ مِن رَّبِّكَ فَلَا تَكُونَنَّ مِنَ ٱلۡمُمۡتَرِينَ",
    "ayah_text_no_diacratic" : "الحق من ربك فلا تكونن من الممترين",
    "ayahnumber" : "147",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "157",
    "page" : "23",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1570",
    "ayah_text" : "وَلَمَّا جَآءَتۡ رُسُلُنَا لُوطٗا سِيٓءَ بِهِمۡ وَضَاقَ بِهِمۡ ذَرۡعٗا وَقَالَ هَٰذَا يَوۡمٌ عَصِيبٞ",
    "ayah_text_no_diacratic" : "ولما جاءت رسلنا لوطا سيء بهم وضاق بهم ذرعا وقال هٰذا يوم عصيب",
    "ayahnumber" : "77",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1570",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1571",
    "ayah_text" : "وَجَآءَهُۥ قَوۡمُهُۥ يُهۡرَعُونَ إِلَيۡهِ وَمِن قَبۡلُ كَانُواْ يَعۡمَلُونَ ٱلسَّيِّـَٔاتِۚ قَالَ يَٰقَوۡمِ هَٰٓؤُلَآءِ بَنَاتِي هُنَّ أَطۡهَرُ لَكُمۡۖ فَٱتَّقُواْ ٱللَّهَ وَلَا تُخۡزُونِ فِي ضَيۡفِيٓۖ أَلَيۡسَ مِنكُمۡ رَجُلٞ رَّشِيدٞ",
    "ayah_text_no_diacratic" : "وجاءه قومه يهرعون اليه ومن قبل كانوا يعملون السيات قال يٰقوم هٰؤلاء بناتي هن اطهر لكم فاتقوا الله ولا تخزون في ضيفي اليس منكم رجل رشيد",
    "ayahnumber" : "78",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1571",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1572",
    "ayah_text" : "قَالُواْ لَقَدۡ عَلِمۡتَ مَا لَنَا فِي بَنَاتِكَ مِنۡ حَقّٖ وَإِنَّكَ لَتَعۡلَمُ مَا نُرِيدُ",
    "ayah_text_no_diacratic" : "قالوا لقد علمت ما لنا في بناتك من حق وانك لتعلم ما نريد",
    "ayahnumber" : "79",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1572",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1573",
    "ayah_text" : "قَالَ لَوۡ أَنَّ لِي بِكُمۡ قُوَّةً أَوۡ ءَاوِيٓ إِلَىٰ رُكۡنٖ شَدِيدٖ",
    "ayah_text_no_diacratic" : "قال لو ان لي بكم قوة او ءاوي الىٰ ركن شديد",
    "ayahnumber" : "80",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1573",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1574",
    "ayah_text" : "قَالُواْ يَٰلُوطُ إِنَّا رُسُلُ رَبِّكَ لَن يَصِلُوٓاْ إِلَيۡكَۖ فَأَسۡرِ بِأَهۡلِكَ بِقِطۡعٖ مِّنَ ٱلَّيۡلِ وَلَا يَلۡتَفِتۡ مِنكُمۡ أَحَدٌ إِلَّا ٱمۡرَأَتَكَۖ إِنَّهُۥ مُصِيبُهَا مَآ أَصَابَهُمۡۚ إِنَّ مَوۡعِدَهُمُ ٱلصُّبۡحُۚ أَلَيۡسَ ٱلصُّبۡحُ بِقَرِيبٖ",
    "ayah_text_no_diacratic" : "قالوا يٰلوط انا رسل ربك لن يصلوا اليك فاسر باهلك بقطع من اليل ولا يلتفت منكم احد الا امراتك انه مصيبها ما اصابهم ان موعدهم الصبح اليس الصبح بقريب",
    "ayahnumber" : "81",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1574",
    "page" : "230",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1575",
    "ayah_text" : "فَلَمَّا جَآءَ أَمۡرُنَا جَعَلۡنَا عَٰلِيَهَا سَافِلَهَا وَأَمۡطَرۡنَا عَلَيۡهَا حِجَارَةٗ مِّن سِجِّيلٖ مَّنضُودٖ",
    "ayah_text_no_diacratic" : "فلما جاء امرنا جعلنا عٰليها سافلها وامطرنا عليها حجارة من سجيل منضود",
    "ayahnumber" : "82",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1575",
    "page" : "231",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1576",
    "ayah_text" : "مُّسَوَّمَةً عِندَ رَبِّكَۖ وَمَا هِيَ مِنَ ٱلظَّٰلِمِينَ بِبَعِيدٖ",
    "ayah_text_no_diacratic" : "مسومة عند ربك وما هي من الظٰلمين ببعيد",
    "ayahnumber" : "83",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1576",
    "page" : "231",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1577",
    "ayah_text" : "۞وَإِلَىٰ مَدۡيَنَ أَخَاهُمۡ شُعَيۡبٗاۚ قَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥۖ وَلَا تَنقُصُواْ ٱلۡمِكۡيَالَ وَٱلۡمِيزَانَۖ إِنِّيٓ أَرَىٰكُم بِخَيۡرٖ وَإِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٖ مُّحِيطٖ",
    "ayah_text_no_diacratic" : "والىٰ مدين اخاهم شعيبا قال يٰقوم اعبدوا الله ما لكم من الٰه غيره ولا تنقصوا المكيال والميزان اني ارىٰكم بخير واني اخاف عليكم عذاب يوم محيط",
    "ayahnumber" : "84",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1577",
    "page" : "231",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1578",
    "ayah_text" : "وَيَٰقَوۡمِ أَوۡفُواْ ٱلۡمِكۡيَالَ وَٱلۡمِيزَانَ بِٱلۡقِسۡطِۖ وَلَا تَبۡخَسُواْ ٱلنَّاسَ أَشۡيَآءَهُمۡ وَلَا تَعۡثَوۡاْ فِي ٱلۡأَرۡضِ مُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "ويٰقوم اوفوا المكيال والميزان بالقسط ولا تبخسوا الناس اشياءهم ولا تعثوا في الارض مفسدين",
    "ayahnumber" : "85",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1578",
    "page" : "231",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1579",
    "ayah_text" : "بَقِيَّتُ ٱللَّهِ خَيۡرٞ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِينَۚ وَمَآ أَنَا۠ عَلَيۡكُم بِحَفِيظٖ",
    "ayah_text_no_diacratic" : "بقيت الله خير لكم ان كنتم مؤمنين وما انا عليكم بحفيظ",
    "ayahnumber" : "86",
    "chapter" : "12",
    "hizb" : "23",
