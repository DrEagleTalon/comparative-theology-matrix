  }, {
    "@id" : "quran:2927",
    "ayah_text" : "أَصۡحَٰبُ ٱلۡجَنَّةِ يَوۡمَئِذٍ خَيۡرٞ مُّسۡتَقَرّٗا وَأَحۡسَنُ مَقِيلٗا",
    "ayah_text_no_diacratic" : "اصحٰب الجنة يومئذ خير مستقرا واحسن مقيلا",
    "ayahnumber" : "24",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2927",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2928",
    "ayah_text" : "وَيَوۡمَ تَشَقَّقُ ٱلسَّمَآءُ بِٱلۡغَمَٰمِ وَنُزِّلَ ٱلۡمَلَٰٓئِكَةُ تَنزِيلًا",
    "ayah_text_no_diacratic" : "ويوم تشقق السماء بالغمٰم ونزل الملٰئكة تنزيلا",
    "ayahnumber" : "25",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2928",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2929",
    "ayah_text" : "ٱلۡمُلۡكُ يَوۡمَئِذٍ ٱلۡحَقُّ لِلرَّحۡمَٰنِۚ وَكَانَ يَوۡمًا عَلَى ٱلۡكَٰفِرِينَ عَسِيرٗا",
    "ayah_text_no_diacratic" : "الملك يومئذ الحق للرحمٰن وكان يوما على الكٰفرين عسيرا",
    "ayahnumber" : "26",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2929",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:293",
    "ayah_text" : "۞وَإِن كُنتُمۡ عَلَىٰ سَفَرٖ وَلَمۡ تَجِدُواْ كَاتِبٗا فَرِهَٰنٞ مَّقۡبُوضَةٞۖ فَإِنۡ أَمِنَ بَعۡضُكُم بَعۡضٗا فَلۡيُؤَدِّ ٱلَّذِي ٱؤۡتُمِنَ أَمَٰنَتَهُۥ وَلۡيَتَّقِ ٱللَّهَ رَبَّهُۥۗ وَلَا تَكۡتُمُواْ ٱلشَّهَٰدَةَۚ وَمَن يَكۡتُمۡهَا فَإِنَّهُۥٓ ءَاثِمٞ قَلۡبُهُۥۗ وَٱللَّهُ بِمَا تَعۡمَلُونَ عَلِيمٞ",
    "ayah_text_no_diacratic" : "وان كنتم علىٰ سفر ولم تجدوا كاتبا فرهٰن مقبوضة فان امن بعضكم بعضا فليؤد الذي اؤتمن امٰنته وليتق الله ربه ولا تكتموا الشهٰدة ومن يكتمها فانه ءاثم قلبه والله بما تعملون عليم",
    "ayahnumber" : "283",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "293",
    "page" : "49",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2930",
    "ayah_text" : "وَيَوۡمَ يَعَضُّ ٱلظَّالِمُ عَلَىٰ يَدَيۡهِ يَقُولُ يَٰلَيۡتَنِي ٱتَّخَذۡتُ مَعَ ٱلرَّسُولِ سَبِيلٗا",
    "ayah_text_no_diacratic" : "ويوم يعض الظالم علىٰ يديه يقول يٰليتني اتخذت مع الرسول سبيلا",
    "ayahnumber" : "27",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2930",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2931",
    "ayah_text" : "يَٰوَيۡلَتَىٰ لَيۡتَنِي لَمۡ أَتَّخِذۡ فُلَانًا خَلِيلٗا",
    "ayah_text_no_diacratic" : "يٰويلتىٰ ليتني لم اتخذ فلانا خليلا",
    "ayahnumber" : "28",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2931",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2932",
    "ayah_text" : "لَّقَدۡ أَضَلَّنِي عَنِ ٱلذِّكۡرِ بَعۡدَ إِذۡ جَآءَنِيۗ وَكَانَ ٱلشَّيۡطَٰنُ لِلۡإِنسَٰنِ خَذُولٗا",
    "ayah_text_no_diacratic" : "لقد اضلني عن الذكر بعد اذ جاءني وكان الشيطٰن للانسٰن خذولا",
    "ayahnumber" : "29",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2932",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2933",
    "ayah_text" : "وَقَالَ ٱلرَّسُولُ يَٰرَبِّ إِنَّ قَوۡمِي ٱتَّخَذُواْ هَٰذَا ٱلۡقُرۡءَانَ مَهۡجُورٗا",
    "ayah_text_no_diacratic" : "وقال الرسول يٰرب ان قومي اتخذوا هٰذا القرءان مهجورا",
    "ayahnumber" : "30",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2933",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2934",
    "ayah_text" : "وَكَذَٰلِكَ جَعَلۡنَا لِكُلِّ نَبِيٍّ عَدُوّٗا مِّنَ ٱلۡمُجۡرِمِينَۗ وَكَفَىٰ بِرَبِّكَ هَادِيٗا وَنَصِيرٗا",
    "ayah_text_no_diacratic" : "وكذٰلك جعلنا لكل نبي عدوا من المجرمين وكفىٰ بربك هاديا ونصيرا",
    "ayahnumber" : "31",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2934",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2935",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُواْ لَوۡلَا نُزِّلَ عَلَيۡهِ ٱلۡقُرۡءَانُ جُمۡلَةٗ وَٰحِدَةٗۚ كَذَٰلِكَ لِنُثَبِّتَ بِهِۦ فُؤَادَكَۖ وَرَتَّلۡنَٰهُ تَرۡتِيلٗا",
    "ayah_text_no_diacratic" : "وقال الذين كفروا لولا نزل عليه القرءان جملة وٰحدة كذٰلك لنثبت به فؤادك ورتلنٰه ترتيلا",
    "ayahnumber" : "32",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2935",
    "page" : "362",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2936",
    "ayah_text" : "وَلَا يَأۡتُونَكَ بِمَثَلٍ إِلَّا جِئۡنَٰكَ بِٱلۡحَقِّ وَأَحۡسَنَ تَفۡسِيرًا",
    "ayah_text_no_diacratic" : "ولا ياتونك بمثل الا جئنٰك بالحق واحسن تفسيرا",
    "ayahnumber" : "33",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2936",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2937",
    "ayah_text" : "ٱلَّذِينَ يُحۡشَرُونَ عَلَىٰ وُجُوهِهِمۡ إِلَىٰ جَهَنَّمَ أُوْلَٰٓئِكَ شَرّٞ مَّكَانٗا وَأَضَلُّ سَبِيلٗا",
    "ayah_text_no_diacratic" : "الذين يحشرون علىٰ وجوههم الىٰ جهنم اولٰئك شر مكانا واضل سبيلا",
    "ayahnumber" : "34",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2937",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2938",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ وَجَعَلۡنَا مَعَهُۥٓ أَخَاهُ هَٰرُونَ وَزِيرٗا",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسى الكتٰب وجعلنا معه اخاه هٰرون وزيرا",
    "ayahnumber" : "35",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2938",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2939",
    "ayah_text" : "فَقُلۡنَا ٱذۡهَبَآ إِلَى ٱلۡقَوۡمِ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا فَدَمَّرۡنَٰهُمۡ تَدۡمِيرٗا",
    "ayah_text_no_diacratic" : "فقلنا اذهبا الى القوم الذين كذبوا بايٰتنا فدمرنٰهم تدميرا",
    "ayahnumber" : "36",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2939",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:294",
    "ayah_text" : "لِّلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ وَإِن تُبۡدُواْ مَا فِيٓ أَنفُسِكُمۡ أَوۡ تُخۡفُوهُ يُحَاسِبۡكُم بِهِ ٱللَّهُۖ فَيَغۡفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "ayah_text_no_diacratic" : "لله ما في السمٰوٰت وما في الارض وان تبدوا ما في انفسكم او تخفوه يحاسبكم به الله فيغفر لمن يشاء ويعذب من يشاء والله علىٰ كل شيء قدير",
    "ayahnumber" : "284",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "294",
    "page" : "49",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2940",
    "ayah_text" : "وَقَوۡمَ نُوحٖ لَّمَّا كَذَّبُواْ ٱلرُّسُلَ أَغۡرَقۡنَٰهُمۡ وَجَعَلۡنَٰهُمۡ لِلنَّاسِ ءَايَةٗۖ وَأَعۡتَدۡنَا لِلظَّٰلِمِينَ عَذَابًا أَلِيمٗا",
    "ayah_text_no_diacratic" : "وقوم نوح لما كذبوا الرسل اغرقنٰهم وجعلنٰهم للناس ءاية واعتدنا للظٰلمين عذابا اليما",
    "ayahnumber" : "37",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2940",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2941",
    "ayah_text" : "وَعَادٗا وَثَمُودَاْ وَأَصۡحَٰبَ ٱلرَّسِّ وَقُرُونَۢا بَيۡنَ ذَٰلِكَ كَثِيرٗا",
    "ayah_text_no_diacratic" : "وعادا وثمودا واصحٰب الرس وقرونا بين ذٰلك كثيرا",
    "ayahnumber" : "38",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2941",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2942",
    "ayah_text" : "وَكُلّٗا ضَرَبۡنَا لَهُ ٱلۡأَمۡثَٰلَۖ وَكُلّٗا تَبَّرۡنَا تَتۡبِيرٗا",
    "ayah_text_no_diacratic" : "وكلا ضربنا له الامثٰل وكلا تبرنا تتبيرا",
    "ayahnumber" : "39",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2942",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2943",
    "ayah_text" : "وَلَقَدۡ أَتَوۡاْ عَلَى ٱلۡقَرۡيَةِ ٱلَّتِيٓ أُمۡطِرَتۡ مَطَرَ ٱلسَّوۡءِۚ أَفَلَمۡ يَكُونُواْ يَرَوۡنَهَاۚ بَلۡ كَانُواْ لَا يَرۡجُونَ نُشُورٗا",
    "ayah_text_no_diacratic" : "ولقد اتوا على القرية التي امطرت مطر السوء افلم يكونوا يرونها بل كانوا لا يرجون نشورا",
    "ayahnumber" : "40",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2943",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2944",
    "ayah_text" : "وَإِذَا رَأَوۡكَ إِن يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا ٱلَّذِي بَعَثَ ٱللَّهُ رَسُولًا",
    "ayah_text_no_diacratic" : "واذا راوك ان يتخذونك الا هزوا اهٰذا الذي بعث الله رسولا",
    "ayahnumber" : "41",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2944",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2945",
    "ayah_text" : "إِن كَادَ لَيُضِلُّنَا عَنۡ ءَالِهَتِنَا لَوۡلَآ أَن صَبَرۡنَا عَلَيۡهَاۚ وَسَوۡفَ يَعۡلَمُونَ حِينَ يَرَوۡنَ ٱلۡعَذَابَ مَنۡ أَضَلُّ سَبِيلًا",
    "ayah_text_no_diacratic" : "ان كاد ليضلنا عن ءالهتنا لولا ان صبرنا عليها وسوف يعلمون حين يرون العذاب من اضل سبيلا",
    "ayahnumber" : "42",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2945",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2946",
    "ayah_text" : "أَرَءَيۡتَ مَنِ ٱتَّخَذَ إِلَٰهَهُۥ هَوَىٰهُ أَفَأَنتَ تَكُونُ عَلَيۡهِ وَكِيلًا",
    "ayah_text_no_diacratic" : "ارءيت من اتخذ الٰهه هوىٰه افانت تكون عليه وكيلا",
    "ayahnumber" : "43",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2946",
    "page" : "363",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2947",
    "ayah_text" : "أَمۡ تَحۡسَبُ أَنَّ أَكۡثَرَهُمۡ يَسۡمَعُونَ أَوۡ يَعۡقِلُونَۚ إِنۡ هُمۡ إِلَّا كَٱلۡأَنۡعَٰمِ بَلۡ هُمۡ أَضَلُّ سَبِيلًا",
    "ayah_text_no_diacratic" : "ام تحسب ان اكثرهم يسمعون او يعقلون ان هم الا كالانعٰم بل هم اضل سبيلا",
    "ayahnumber" : "44",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2947",
    "page" : "364",
