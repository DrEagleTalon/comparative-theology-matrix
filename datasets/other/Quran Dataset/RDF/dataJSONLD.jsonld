    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2969",
    "ayah_text" : "إِنَّهَا سَآءَتۡ مُسۡتَقَرّٗا وَمُقَامٗا",
    "ayah_text_no_diacratic" : "انها ساءت مستقرا ومقاما",
    "ayahnumber" : "66",
    "chapter" : "19",
    "hizb" : "36",
