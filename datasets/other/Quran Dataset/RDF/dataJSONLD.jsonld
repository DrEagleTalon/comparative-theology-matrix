  }, {
    "@id" : "quran:1252",
    "ayah_text" : "بَرَآءَةٞ مِّنَ ٱللَّهِ وَرَسُولِهِۦٓ إِلَى ٱلَّذِينَ عَٰهَدتُّم مِّنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "براءة من الله ورسوله الى الذين عٰهدتم من المشركين",
