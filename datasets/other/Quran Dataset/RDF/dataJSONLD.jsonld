  }, {
    "@id" : "quran:3095",
    "ayah_text" : "إِنۡ حِسَابُهُمۡ إِلَّا عَلَىٰ رَبِّيۖ لَوۡ تَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "ان حسابهم الا علىٰ ربي لو تشعرون",
