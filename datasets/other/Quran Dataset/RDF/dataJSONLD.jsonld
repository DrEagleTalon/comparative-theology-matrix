  }, {
    "@id" : "quran:5431",
    "ayah_text" : "فَلَمَّا رَأَوۡهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ",
    "ayah_text_no_diacratic" : "فلما راوها قالوا انا لضالون",
