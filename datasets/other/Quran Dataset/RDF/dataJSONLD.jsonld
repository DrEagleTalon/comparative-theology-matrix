    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2803",
    "ayah_text" : "قُلۡ مَن رَّبُّ ٱلسَّمَٰوَٰتِ ٱلسَّبۡعِ وَرَبُّ ٱلۡعَرۡشِ ٱلۡعَظِيمِ",
    "ayah_text_no_diacratic" : "قل من رب السمٰوٰت السبع ورب العرش العظيم",
    "ayahnumber" : "86",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2803",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2804",
    "ayah_text" : "سَيَقُولُونَ لِلَّهِۚ قُلۡ أَفَلَا تَتَّقُونَ",
    "ayah_text_no_diacratic" : "سيقولون لله قل افلا تتقون",
    "ayahnumber" : "87",
    "chapter" : "18",
