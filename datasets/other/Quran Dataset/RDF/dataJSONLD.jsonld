    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2691",
    "ayah_text" : "وَلِيَعۡلَمَ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ أَنَّهُ ٱلۡحَقُّ مِن رَّبِّكَ فَيُؤۡمِنُواْ بِهِۦ فَتُخۡبِتَ لَهُۥ قُلُوبُهُمۡۗ وَإِنَّ ٱللَّهَ لَهَادِ ٱلَّذِينَ ءَامَنُوٓاْ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "وليعلم الذين اوتوا العلم انه الحق من ربك فيؤمنوا به فتخبت له قلوبهم وان الله لهاد الذين ءامنوا الىٰ صرٰط مستقيم",
    "ayahnumber" : "54",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2691",
    "page" : "338",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2692",
    "ayah_text" : "وَلَا يَزَالُ ٱلَّذِينَ كَفَرُواْ فِي مِرۡيَةٖ مِّنۡهُ حَتَّىٰ تَأۡتِيَهُمُ ٱلسَّاعَةُ بَغۡتَةً أَوۡ يَأۡتِيَهُمۡ عَذَابُ يَوۡمٍ عَقِيمٍ",
    "ayah_text_no_diacratic" : "ولا يزال الذين كفروا في مرية منه حتىٰ تاتيهم الساعة بغتة او ياتيهم عذاب يوم عقيم",
    "ayahnumber" : "55",
