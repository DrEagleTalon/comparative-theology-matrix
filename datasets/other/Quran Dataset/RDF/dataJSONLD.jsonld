    "page" : "356",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2891",
    "ayah_text" : "قُلۡ أَطِيعُواْ ٱللَّهَ وَأَطِيعُواْ ٱلرَّسُولَۖ فَإِن تَوَلَّوۡاْ فَإِنَّمَا عَلَيۡهِ مَا حُمِّلَ وَعَلَيۡكُم مَّا حُمِّلۡتُمۡۖ وَإِن تُطِيعُوهُ تَهۡتَدُواْۚ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلۡبَلَٰغُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "قل اطيعوا الله واطيعوا الرسول فان تولوا فانما عليه ما حمل وعليكم ما حملتم وان تطيعوه تهتدوا وما على الرسول الا البلٰغ المبين",
    "ayahnumber" : "54",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2891",
    "page" : "357",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2892",
    "ayah_text" : "وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ مِنكُمۡ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَيَسۡتَخۡلِفَنَّهُمۡ فِي ٱلۡأَرۡضِ كَمَا ٱسۡتَخۡلَفَ ٱلَّذِينَ مِن قَبۡلِهِمۡ وَلَيُمَكِّنَنَّ لَهُمۡ دِينَهُمُ ٱلَّذِي ٱرۡتَضَىٰ لَهُمۡ وَلَيُبَدِّلَنَّهُم مِّنۢ بَعۡدِ خَوۡفِهِمۡ أَمۡنٗاۚ يَعۡبُدُونَنِي لَا يُشۡرِكُونَ بِي شَيۡـٔٗاۚ وَمَن كَفَرَ بَعۡدَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "وعد الله الذين ءامنوا منكم وعملوا الصٰلحٰت ليستخلفنهم في الارض كما استخلف الذين من قبلهم وليمكنن لهم دينهم الذي ارتضىٰ لهم وليبدلنهم من بعد خوفهم امنا يعبدونني لا يشركون بي شيا ومن كفر بعد ذٰلك فاولٰئك هم الفٰسقون",
    "ayahnumber" : "55",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2892",
    "page" : "357",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2893",
    "ayah_text" : "وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ وَأَطِيعُواْ ٱلرَّسُولَ لَعَلَّكُمۡ تُرۡحَمُونَ",
    "ayah_text_no_diacratic" : "واقيموا الصلوٰة وءاتوا الزكوٰة واطيعوا الرسول لعلكم ترحمون",
    "ayahnumber" : "56",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2893",
    "page" : "357",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2894",
    "ayah_text" : "لَا تَحۡسَبَنَّ ٱلَّذِينَ كَفَرُواْ مُعۡجِزِينَ فِي ٱلۡأَرۡضِۚ وَمَأۡوَىٰهُمُ ٱلنَّارُۖ وَلَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "لا تحسبن الذين كفروا معجزين في الارض وماوىٰهم النار ولبئس المصير",
    "ayahnumber" : "57",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2894",
    "page" : "357",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2895",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لِيَسۡتَـٔۡذِنكُمُ ٱلَّذِينَ مَلَكَتۡ أَيۡمَٰنُكُمۡ وَٱلَّذِينَ لَمۡ يَبۡلُغُواْ ٱلۡحُلُمَ مِنكُمۡ ثَلَٰثَ مَرَّٰتٖۚ مِّن قَبۡلِ صَلَوٰةِ ٱلۡفَجۡرِ وَحِينَ تَضَعُونَ ثِيَابَكُم مِّنَ ٱلظَّهِيرَةِ وَمِنۢ بَعۡدِ صَلَوٰةِ ٱلۡعِشَآءِۚ ثَلَٰثُ عَوۡرَٰتٖ لَّكُمۡۚ لَيۡسَ عَلَيۡكُمۡ وَلَا عَلَيۡهِمۡ جُنَاحُۢ بَعۡدَهُنَّۚ طَوَّٰفُونَ عَلَيۡكُم بَعۡضُكُمۡ عَلَىٰ بَعۡضٖۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ليستذنكم الذين ملكت ايمٰنكم والذين لم يبلغوا الحلم منكم ثلٰث مرٰت من قبل صلوٰة الفجر وحين تضعون ثيابكم من الظهيرة ومن بعد صلوٰة العشاء ثلٰث عورٰت لكم ليس عليكم ولا عليهم جناح بعدهن طوٰفون عليكم بعضكم علىٰ بعض كذٰلك يبين الله لكم الايٰت والله عليم حكيم",
    "ayahnumber" : "58",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2895",
    "page" : "357",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2896",
    "ayah_text" : "وَإِذَا بَلَغَ ٱلۡأَطۡفَٰلُ مِنكُمُ ٱلۡحُلُمَ فَلۡيَسۡتَـٔۡذِنُواْ كَمَا ٱسۡتَـٔۡذَنَ ٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمۡ ءَايَٰتِهِۦۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "واذا بلغ الاطفٰل منكم الحلم فليستذنوا كما استذن الذين من قبلهم كذٰلك يبين الله لكم ءايٰته والله عليم حكيم",
    "ayahnumber" : "59",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2896",
    "page" : "358",
    "surahname" : "سُورَةُ النُّورِ",
