    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:801",
    "ayah_text" : "ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَجَعَلَ ٱلظُّلُمَٰتِ وَٱلنُّورَۖ ثُمَّ ٱلَّذِينَ كَفَرُواْ بِرَبِّهِمۡ يَعۡدِلُونَ",
    "ayah_text_no_diacratic" : "الحمد لله الذي خلق السمٰوٰت والارض وجعل الظلمٰت والنور ثم الذين كفروا بربهم يعدلون",
    "ayahnumber" : "1",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "801",
    "page" : "128",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:802",
    "ayah_text" : "هُوَ ٱلَّذِي خَلَقَكُم مِّن طِينٖ ثُمَّ قَضَىٰٓ أَجَلٗاۖ وَأَجَلٞ مُّسَمًّى عِندَهُۥۖ ثُمَّ أَنتُمۡ تَمۡتَرُونَ",
    "ayah_text_no_diacratic" : "هو الذي خلقكم من طين ثم قضىٰ اجلا واجل مسمى عنده ثم انتم تمترون",
    "ayahnumber" : "2",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "802",
    "page" : "128",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:803",
    "ayah_text" : "وَهُوَ ٱللَّهُ فِي ٱلسَّمَٰوَٰتِ وَفِي ٱلۡأَرۡضِ يَعۡلَمُ سِرَّكُمۡ وَجَهۡرَكُمۡ وَيَعۡلَمُ مَا تَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "وهو الله في السمٰوٰت وفي الارض يعلم سركم وجهركم ويعلم ما تكسبون",
    "ayahnumber" : "3",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "803",
    "page" : "128",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:804",
    "ayah_text" : "وَمَا تَأۡتِيهِم مِّنۡ ءَايَةٖ مِّنۡ ءَايَٰتِ رَبِّهِمۡ إِلَّا كَانُواْ عَنۡهَا مُعۡرِضِينَ",
    "ayah_text_no_diacratic" : "وما تاتيهم من ءاية من ءايٰت ربهم الا كانوا عنها معرضين",
    "ayahnumber" : "4",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "804",
    "page" : "128",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:805",
    "ayah_text" : "فَقَدۡ كَذَّبُواْ بِٱلۡحَقِّ لَمَّا جَآءَهُمۡ فَسَوۡفَ يَأۡتِيهِمۡ أَنۢبَٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "فقد كذبوا بالحق لما جاءهم فسوف ياتيهم انبٰؤا ما كانوا به يستهزءون",
    "ayahnumber" : "5",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "805",
    "page" : "128",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:806",
    "ayah_text" : "أَلَمۡ يَرَوۡاْ كَمۡ أَهۡلَكۡنَا مِن قَبۡلِهِم مِّن قَرۡنٖ مَّكَّنَّٰهُمۡ فِي ٱلۡأَرۡضِ مَا لَمۡ نُمَكِّن لَّكُمۡ وَأَرۡسَلۡنَا ٱلسَّمَآءَ عَلَيۡهِم مِّدۡرَارٗا وَجَعَلۡنَا ٱلۡأَنۡهَٰرَ تَجۡرِي مِن تَحۡتِهِمۡ فَأَهۡلَكۡنَٰهُم بِذُنُوبِهِمۡ وَأَنشَأۡنَا مِنۢ بَعۡدِهِمۡ قَرۡنًا ءَاخَرِينَ",
    "ayah_text_no_diacratic" : "الم يروا كم اهلكنا من قبلهم من قرن مكنٰهم في الارض ما لم نمكن لكم وارسلنا السماء عليهم مدرارا وجعلنا الانهٰر تجري من تحتهم فاهلكنٰهم بذنوبهم وانشانا من بعدهم قرنا ءاخرين",
    "ayahnumber" : "6",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "806",
    "page" : "128",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:807",
    "ayah_text" : "وَلَوۡ نَزَّلۡنَا عَلَيۡكَ كِتَٰبٗا فِي قِرۡطَاسٖ فَلَمَسُوهُ بِأَيۡدِيهِمۡ لَقَالَ ٱلَّذِينَ كَفَرُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "ولو نزلنا عليك كتٰبا في قرطاس فلمسوه بايديهم لقال الذين كفروا ان هٰذا الا سحر مبين",
    "ayahnumber" : "7",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "807",
    "page" : "128",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:808",
    "ayah_text" : "وَقَالُواْ لَوۡلَآ أُنزِلَ عَلَيۡهِ مَلَكٞۖ وَلَوۡ أَنزَلۡنَا مَلَكٗا لَّقُضِيَ ٱلۡأَمۡرُ ثُمَّ لَا يُنظَرُونَ",
    "ayah_text_no_diacratic" : "وقالوا لولا انزل عليه ملك ولو انزلنا ملكا لقضي الامر ثم لا ينظرون",
    "ayahnumber" : "8",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "808",
    "page" : "128",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:809",
    "ayah_text" : "وَلَوۡ جَعَلۡنَٰهُ مَلَكٗا لَّجَعَلۡنَٰهُ رَجُلٗا وَلَلَبَسۡنَا عَلَيۡهِم مَّا يَلۡبِسُونَ",
    "ayah_text_no_diacratic" : "ولو جعلنٰه ملكا لجعلنٰه رجلا وللبسنا عليهم ما يلبسون",
    "ayahnumber" : "9",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "809",
    "page" : "129",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:81",
    "ayah_text" : "قَالَ إِنَّهُۥ يَقُولُ إِنَّهَا بَقَرَةٞ لَّا ذَلُولٞ تُثِيرُ ٱلۡأَرۡضَ وَلَا تَسۡقِي ٱلۡحَرۡثَ مُسَلَّمَةٞ لَّا شِيَةَ فِيهَاۚ قَالُواْ ٱلۡـَٰٔنَ جِئۡتَ بِٱلۡحَقِّۚ فَذَبَحُوهَا وَمَا كَادُواْ يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "قال انه يقول انها بقرة لا ذلول تثير الارض ولا تسقي الحرث مسلمة لا شية فيها قالوا الٰن جئت بالحق فذبحوها وما كادوا يفعلون",
    "ayahnumber" : "71",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "81",
    "page" : "11",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:810",
    "ayah_text" : "وَلَقَدِ ٱسۡتُهۡزِئَ بِرُسُلٖ مِّن قَبۡلِكَ فَحَاقَ بِٱلَّذِينَ سَخِرُواْ مِنۡهُم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "ولقد استهزئ برسل من قبلك فحاق بالذين سخروا منهم ما كانوا به يستهزءون",
    "ayahnumber" : "10",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "810",
    "page" : "129",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:811",
    "ayah_text" : "قُلۡ سِيرُواْ فِي ٱلۡأَرۡضِ ثُمَّ ٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُكَذِّبِينَ",
    "ayah_text_no_diacratic" : "قل سيروا في الارض ثم انظروا كيف كان عٰقبة المكذبين",
    "ayahnumber" : "11",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "811",
    "page" : "129",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:812",
    "ayah_text" : "قُل لِّمَن مَّا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ قُل لِّلَّهِۚ كَتَبَ عَلَىٰ نَفۡسِهِ ٱلرَّحۡمَةَۚ لَيَجۡمَعَنَّكُمۡ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ لَا رَيۡبَ فِيهِۚ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ فَهُمۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "قل لمن ما في السمٰوٰت والارض قل لله كتب علىٰ نفسه الرحمة ليجمعنكم الىٰ يوم القيٰمة لا ريب فيه الذين خسروا انفسهم فهم لا يؤمنون",
    "ayahnumber" : "12",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "812",
    "page" : "129",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:813",
    "ayah_text" : "۞وَلَهُۥ مَا سَكَنَ فِي ٱلَّيۡلِ وَٱلنَّهَارِۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "وله ما سكن في اليل والنهار وهو السميع العليم",
    "ayahnumber" : "13",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "813",
    "page" : "129",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:814",
    "ayah_text" : "قُلۡ أَغَيۡرَ ٱللَّهِ أَتَّخِذُ وَلِيّٗا فَاطِرِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَهُوَ يُطۡعِمُ وَلَا يُطۡعَمُۗ قُلۡ إِنِّيٓ أُمِرۡتُ أَنۡ أَكُونَ أَوَّلَ مَنۡ أَسۡلَمَۖ وَلَا تَكُونَنَّ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "قل اغير الله اتخذ وليا فاطر السمٰوٰت والارض وهو يطعم ولا يطعم قل اني امرت ان اكون اول من اسلم ولا تكونن من المشركين",
    "ayahnumber" : "14",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "814",
    "page" : "129",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:815",
    "ayah_text" : "قُلۡ إِنِّيٓ أَخَافُ إِنۡ عَصَيۡتُ رَبِّي عَذَابَ يَوۡمٍ عَظِيمٖ",
    "ayah_text_no_diacratic" : "قل اني اخاف ان عصيت ربي عذاب يوم عظيم",
    "ayahnumber" : "15",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "815",
    "page" : "129",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:816",
    "ayah_text" : "مَّن يُصۡرَفۡ عَنۡهُ يَوۡمَئِذٖ فَقَدۡ رَحِمَهُۥۚ وَذَٰلِكَ ٱلۡفَوۡزُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "من يصرف عنه يومئذ فقد رحمه وذٰلك الفوز المبين",
    "ayahnumber" : "16",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "816",
    "page" : "129",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:817",
    "ayah_text" : "وَإِن يَمۡسَسۡكَ ٱللَّهُ بِضُرّٖ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَۖ وَإِن يَمۡسَسۡكَ بِخَيۡرٖ فَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "وان يمسسك الله بضر فلا كاشف له الا هو وان يمسسك بخير فهو علىٰ كل شيء قدير",
    "ayahnumber" : "17",
    "chapter" : "7",
