    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1799",
    "ayah_text" : "وَأُدۡخِلَ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا بِإِذۡنِ رَبِّهِمۡۖ تَحِيَّتُهُمۡ فِيهَا سَلَٰمٌ",
    "ayah_text_no_diacratic" : "وادخل الذين ءامنوا وعملوا الصٰلحٰت جنٰت تجري من تحتها الانهٰر خٰلدين فيها باذن ربهم تحيتهم فيها سلٰم",
    "ayahnumber" : "23",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1799",
    "page" : "258",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:18",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلۡيَوۡمِ ٱلۡأٓخِرِ وَمَا هُم بِمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ومن الناس من يقول ءامنا بالله وباليوم الاخر وما هم بمؤمنين",
