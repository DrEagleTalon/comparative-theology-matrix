    "surahnumber" : "70",
    "surrahname_no_diacratic" : "سورة المعارج"
  }, {
    "@id" : "quran:5517",
    "ayah_text" : "تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي يَوۡمٖ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةٖ",
    "ayah_text_no_diacratic" : "تعرج الملٰئكة والروح اليه في يوم كان مقداره خمسين الف سنة",
