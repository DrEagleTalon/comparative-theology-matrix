    "index" : "321",
    "page" : "53",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3210",
    "ayah_text" : "سُورَةُ النَّمۡلِ",
    "ayah_text_no_diacratic" : "سورة النمل",
    "ayahnumber" : "0",
