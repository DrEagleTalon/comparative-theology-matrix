    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:550",
    "ayah_text" : "ٱنظُرۡ كَيۡفَ يَفۡتَرُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَۖ وَكَفَىٰ بِهِۦٓ إِثۡمٗا مُّبِينًا",
    "ayah_text_no_diacratic" : "انظر كيف يفترون على الله الكذب وكفىٰ به اثما مبينا",
