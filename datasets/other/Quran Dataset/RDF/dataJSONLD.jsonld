    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1886",
    "ayah_text" : "قَالَ وَمَن يَقۡنَطُ مِن رَّحۡمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ",
    "ayah_text_no_diacratic" : "قال ومن يقنط من رحمة ربه الا الضالون",
