    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4880",
    "ayah_text" : "أَمۡ لَهُمۡ إِلَٰهٌ غَيۡرُ ٱللَّهِۚ سُبۡحَٰنَ ٱللَّهِ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "ام لهم الٰه غير الله سبحٰن الله عما يشركون",
