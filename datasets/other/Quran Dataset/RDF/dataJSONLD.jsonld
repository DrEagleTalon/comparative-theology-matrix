    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2598",
    "ayah_text" : "وَأَدۡخَلۡنَٰهُ فِي رَحۡمَتِنَآۖ إِنَّهُۥ مِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "وادخلنٰه في رحمتنا انه من الصٰلحين",
    "ayahnumber" : "75",
    "chapter" : "17",
