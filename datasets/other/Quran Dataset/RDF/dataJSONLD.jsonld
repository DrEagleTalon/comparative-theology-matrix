    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3208",
    "ayah_text" : "وَأَنَّهُمۡ يَقُولُونَ مَا لَا يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "وانهم يقولون ما لا يفعلون",
    "ayahnumber" : "226",
    "chapter" : "19",
    "hizb" : "37",
