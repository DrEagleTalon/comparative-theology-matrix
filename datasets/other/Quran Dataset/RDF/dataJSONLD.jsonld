    "page" : "520",
    "surahname" : "سُورَةُ قٓ",
    "surahnumber" : "50",
    "surrahname_no_diacratic" : "سورة ق"
  }, {
    "@id" : "quran:4772",
    "ayah_text" : "يَوۡمَ تَشَقَّقُ ٱلۡأَرۡضُ عَنۡهُمۡ سِرَاعٗاۚ ذَٰلِكَ حَشۡرٌ عَلَيۡنَا يَسِيرٞ",
    "ayah_text_no_diacratic" : "يوم تشقق الارض عنهم سراعا ذٰلك حشر علينا يسير",
    "ayahnumber" : "44",
    "chapter" : "26",
