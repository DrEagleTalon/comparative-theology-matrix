    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4826",
    "ayah_text" : "وَلَا تَجۡعَلُواْ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَۖ إِنِّي لَكُم مِّنۡهُ نَذِيرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "ولا تجعلوا مع الله الٰها ءاخر اني لكم منه نذير مبين",
