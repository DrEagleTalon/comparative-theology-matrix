    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1883",
    "ayah_text" : "قَالُواْ لَا تَوۡجَلۡ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمٖ",
    "ayah_text_no_diacratic" : "قالوا لا توجل انا نبشرك بغلٰم عليم",
