    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4351",
    "ayah_text" : "سَنُرِيهِمۡ ءَايَٰتِنَا فِي ٱلۡأٓفَاقِ وَفِيٓ أَنفُسِهِمۡ حَتَّىٰ يَتَبَيَّنَ لَهُمۡ أَنَّهُ ٱلۡحَقُّۗ أَوَلَمۡ يَكۡفِ بِرَبِّكَ أَنَّهُۥ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ",
    "ayah_text_no_diacratic" : "سنريهم ءايٰتنا في الافاق وفي انفسهم حتىٰ يتبين لهم انه الحق اولم يكف بربك انه علىٰ كل شيء شهيد",
    "ayahnumber" : "53",
    "chapter" : "25",
    "hizb" : "48",
