    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2039",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ طَبَعَ ٱللَّهُ عَلَىٰ قُلُوبِهِمۡ وَسَمۡعِهِمۡ وَأَبۡصَٰرِهِمۡۖ وَأُوْلَٰٓئِكَ هُمُ ٱلۡغَٰفِلُونَ",
    "ayah_text_no_diacratic" : "اولٰئك الذين طبع الله علىٰ قلوبهم وسمعهم وابصٰرهم واولٰئك هم الغٰفلون",
    "ayahnumber" : "108",
    "chapter" : "14",
    "hizb" : "27",
