    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:936",
    "ayah_text" : "وَجَعَلُواْ لِلَّهِ مِمَّا ذَرَأَ مِنَ ٱلۡحَرۡثِ وَٱلۡأَنۡعَٰمِ نَصِيبٗا فَقَالُواْ هَٰذَا لِلَّهِ بِزَعۡمِهِمۡ وَهَٰذَا لِشُرَكَآئِنَاۖ فَمَا كَانَ لِشُرَكَآئِهِمۡ فَلَا يَصِلُ إِلَى ٱللَّهِۖ وَمَا كَانَ لِلَّهِ فَهُوَ يَصِلُ إِلَىٰ شُرَكَآئِهِمۡۗ سَآءَ مَا يَحۡكُمُونَ",
    "ayah_text_no_diacratic" : "وجعلوا لله مما ذرا من الحرث والانعٰم نصيبا فقالوا هٰذا لله بزعمهم وهٰذا لشركائنا فما كان لشركائهم فلا يصل الى الله وما كان لله فهو يصل الىٰ شركائهم ساء ما يحكمون",
    "ayahnumber" : "136",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "936",
    "page" : "145",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:937",
    "ayah_text" : "وَكَذَٰلِكَ زَيَّنَ لِكَثِيرٖ مِّنَ ٱلۡمُشۡرِكِينَ قَتۡلَ أَوۡلَٰدِهِمۡ شُرَكَآؤُهُمۡ لِيُرۡدُوهُمۡ وَلِيَلۡبِسُواْ عَلَيۡهِمۡ دِينَهُمۡۖ وَلَوۡ شَآءَ ٱللَّهُ مَا فَعَلُوهُۖ فَذَرۡهُمۡ وَمَا يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "وكذٰلك زين لكثير من المشركين قتل اولٰدهم شركاؤهم ليردوهم وليلبسوا عليهم دينهم ولو شاء الله ما فعلوه فذرهم وما يفترون",
    "ayahnumber" : "137",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "937",
    "page" : "145",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:938",
    "ayah_text" : "وَقَالُواْ هَٰذِهِۦٓ أَنۡعَٰمٞ وَحَرۡثٌ حِجۡرٞ لَّا يَطۡعَمُهَآ إِلَّا مَن نَّشَآءُ بِزَعۡمِهِمۡ وَأَنۡعَٰمٌ حُرِّمَتۡ ظُهُورُهَا وَأَنۡعَٰمٞ لَّا يَذۡكُرُونَ ٱسۡمَ ٱللَّهِ عَلَيۡهَا ٱفۡتِرَآءً عَلَيۡهِۚ سَيَجۡزِيهِم بِمَا كَانُواْ يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "وقالوا هٰذه انعٰم وحرث حجر لا يطعمها الا من نشاء بزعمهم وانعٰم حرمت ظهورها وانعٰم لا يذكرون اسم الله عليها افتراء عليه سيجزيهم بما كانوا يفترون",
    "ayahnumber" : "138",
    "chapter" : "8",
