  }, {
    "@id" : "quran:3643",
    "ayah_text" : "وَدَاعِيًا إِلَى ٱللَّهِ بِإِذۡنِهِۦ وَسِرَاجٗا مُّنِيرٗا",
    "ayah_text_no_diacratic" : "وداعيا الى الله باذنه وسراجا منيرا",
