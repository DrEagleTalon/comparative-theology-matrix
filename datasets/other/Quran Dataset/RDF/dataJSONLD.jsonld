    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4097",
    "ayah_text" : "هَٰذَا مَا تُوعَدُونَ لِيَوۡمِ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "هٰذا ما توعدون ليوم الحساب",
    "ayahnumber" : "53",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4097",
    "page" : "456",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4098",
    "ayah_text" : "إِنَّ هَٰذَا لَرِزۡقُنَا مَا لَهُۥ مِن نَّفَادٍ",
    "ayah_text_no_diacratic" : "ان هٰذا لرزقنا ما له من نفاد",
    "ayahnumber" : "54",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4098",
