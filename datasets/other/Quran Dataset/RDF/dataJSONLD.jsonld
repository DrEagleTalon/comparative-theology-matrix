    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4045",
    "ayah_text" : "صٓۚ وَٱلۡقُرۡءَانِ ذِي ٱلذِّكۡرِ",
    "ayah_text_no_diacratic" : "ص والقرءان ذي الذكر",
