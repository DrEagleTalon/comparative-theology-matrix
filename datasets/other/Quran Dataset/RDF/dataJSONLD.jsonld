    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1811",
    "ayah_text" : "وَإِذۡ قَالَ إِبۡرَٰهِيمُ رَبِّ ٱجۡعَلۡ هَٰذَا ٱلۡبَلَدَ ءَامِنٗا وَٱجۡنُبۡنِي وَبَنِيَّ أَن نَّعۡبُدَ ٱلۡأَصۡنَامَ",
    "ayah_text_no_diacratic" : "واذ قال ابرٰهيم رب اجعل هٰذا البلد ءامنا واجنبني وبني ان نعبد الاصنام",
    "ayahnumber" : "35",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1811",
    "page" : "260",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1812",
    "ayah_text" : "رَبِّ إِنَّهُنَّ أَضۡلَلۡنَ كَثِيرٗا مِّنَ ٱلنَّاسِۖ فَمَن تَبِعَنِي فَإِنَّهُۥ مِنِّيۖ وَمَنۡ عَصَانِي فَإِنَّكَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "رب انهن اضللن كثيرا من الناس فمن تبعني فانه مني ومن عصاني فانك غفور رحيم",
    "ayahnumber" : "36",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1812",
    "page" : "260",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1813",
    "ayah_text" : "رَّبَّنَآ إِنِّيٓ أَسۡكَنتُ مِن ذُرِّيَّتِي بِوَادٍ غَيۡرِ ذِي زَرۡعٍ عِندَ بَيۡتِكَ ٱلۡمُحَرَّمِ رَبَّنَا لِيُقِيمُواْ ٱلصَّلَوٰةَ فَٱجۡعَلۡ أَفۡـِٔدَةٗ مِّنَ ٱلنَّاسِ تَهۡوِيٓ إِلَيۡهِمۡ وَٱرۡزُقۡهُم مِّنَ ٱلثَّمَرَٰتِ لَعَلَّهُمۡ يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "ربنا اني اسكنت من ذريتي بواد غير ذي زرع عند بيتك المحرم ربنا ليقيموا الصلوٰة فاجعل افدة من الناس تهوي اليهم وارزقهم من الثمرٰت لعلهم يشكرون",
    "ayahnumber" : "37",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1813",
    "page" : "260",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1814",
    "ayah_text" : "رَبَّنَآ إِنَّكَ تَعۡلَمُ مَا نُخۡفِي وَمَا نُعۡلِنُۗ وَمَا يَخۡفَىٰ عَلَى ٱللَّهِ مِن شَيۡءٖ فِي ٱلۡأَرۡضِ وَلَا فِي ٱلسَّمَآءِ",
    "ayah_text_no_diacratic" : "ربنا انك تعلم ما نخفي وما نعلن وما يخفىٰ على الله من شيء في الارض ولا في السماء",
    "ayahnumber" : "38",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1814",
    "page" : "260",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1815",
    "ayah_text" : "ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي وَهَبَ لِي عَلَى ٱلۡكِبَرِ إِسۡمَٰعِيلَ وَإِسۡحَٰقَۚ إِنَّ رَبِّي لَسَمِيعُ ٱلدُّعَآءِ",
    "ayah_text_no_diacratic" : "الحمد لله الذي وهب لي على الكبر اسمٰعيل واسحٰق ان ربي لسميع الدعاء",
    "ayahnumber" : "39",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1815",
    "page" : "260",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1816",
    "ayah_text" : "رَبِّ ٱجۡعَلۡنِي مُقِيمَ ٱلصَّلَوٰةِ وَمِن ذُرِّيَّتِيۚ رَبَّنَا وَتَقَبَّلۡ دُعَآءِ",
    "ayah_text_no_diacratic" : "رب اجعلني مقيم الصلوٰة ومن ذريتي ربنا وتقبل دعاء",
    "ayahnumber" : "40",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1816",
    "page" : "260",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1817",
    "ayah_text" : "رَبَّنَا ٱغۡفِرۡ لِي وَلِوَٰلِدَيَّ وَلِلۡمُؤۡمِنِينَ يَوۡمَ يَقُومُ ٱلۡحِسَابُ",
    "ayah_text_no_diacratic" : "ربنا اغفر لي ولوٰلدي وللمؤمنين يوم يقوم الحساب",
    "ayahnumber" : "41",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1817",
    "page" : "260",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1818",
    "ayah_text" : "وَلَا تَحۡسَبَنَّ ٱللَّهَ غَٰفِلًا عَمَّا يَعۡمَلُ ٱلظَّٰلِمُونَۚ إِنَّمَا يُؤَخِّرُهُمۡ لِيَوۡمٖ تَشۡخَصُ فِيهِ ٱلۡأَبۡصَٰرُ",
    "ayah_text_no_diacratic" : "ولا تحسبن الله غٰفلا عما يعمل الظٰلمون انما يؤخرهم ليوم تشخص فيه الابصٰر",
    "ayahnumber" : "42",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1818",
    "page" : "260",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1819",
    "ayah_text" : "مُهۡطِعِينَ مُقۡنِعِي رُءُوسِهِمۡ لَا يَرۡتَدُّ إِلَيۡهِمۡ طَرۡفُهُمۡۖ وَأَفۡـِٔدَتُهُمۡ هَوَآءٞ",
    "ayah_text_no_diacratic" : "مهطعين مقنعي رءوسهم لا يرتد اليهم طرفهم وافدتهم هواء",
    "ayahnumber" : "43",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1819",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:182",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُلُواْ مِن طَيِّبَٰتِ مَا رَزَقۡنَٰكُمۡ وَٱشۡكُرُواْ لِلَّهِ إِن كُنتُمۡ إِيَّاهُ تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا كلوا من طيبٰت ما رزقنٰكم واشكروا لله ان كنتم اياه تعبدون",
    "ayahnumber" : "172",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "182",
    "page" : "26",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1820",
    "ayah_text" : "وَأَنذِرِ ٱلنَّاسَ يَوۡمَ يَأۡتِيهِمُ ٱلۡعَذَابُ فَيَقُولُ ٱلَّذِينَ ظَلَمُواْ رَبَّنَآ أَخِّرۡنَآ إِلَىٰٓ أَجَلٖ قَرِيبٖ نُّجِبۡ دَعۡوَتَكَ وَنَتَّبِعِ ٱلرُّسُلَۗ أَوَلَمۡ تَكُونُوٓاْ أَقۡسَمۡتُم مِّن قَبۡلُ مَا لَكُم مِّن زَوَالٖ",
    "ayah_text_no_diacratic" : "وانذر الناس يوم ياتيهم العذاب فيقول الذين ظلموا ربنا اخرنا الىٰ اجل قريب نجب دعوتك ونتبع الرسل اولم تكونوا اقسمتم من قبل ما لكم من زوال",
    "ayahnumber" : "44",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1820",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1821",
    "ayah_text" : "وَسَكَنتُمۡ فِي مَسَٰكِنِ ٱلَّذِينَ ظَلَمُوٓاْ أَنفُسَهُمۡ وَتَبَيَّنَ لَكُمۡ كَيۡفَ فَعَلۡنَا بِهِمۡ وَضَرَبۡنَا لَكُمُ ٱلۡأَمۡثَالَ",
    "ayah_text_no_diacratic" : "وسكنتم في مسٰكن الذين ظلموا انفسهم وتبين لكم كيف فعلنا بهم وضربنا لكم الامثال",
    "ayahnumber" : "45",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1821",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1822",
    "ayah_text" : "وَقَدۡ مَكَرُواْ مَكۡرَهُمۡ وَعِندَ ٱللَّهِ مَكۡرُهُمۡ وَإِن كَانَ مَكۡرُهُمۡ لِتَزُولَ مِنۡهُ ٱلۡجِبَالُ",
    "ayah_text_no_diacratic" : "وقد مكروا مكرهم وعند الله مكرهم وان كان مكرهم لتزول منه الجبال",
    "ayahnumber" : "46",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1822",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1823",
    "ayah_text" : "فَلَا تَحۡسَبَنَّ ٱللَّهَ مُخۡلِفَ وَعۡدِهِۦ رُسُلَهُۥٓۚ إِنَّ ٱللَّهَ عَزِيزٞ ذُو ٱنتِقَامٖ",
    "ayah_text_no_diacratic" : "فلا تحسبن الله مخلف وعده رسله ان الله عزيز ذو انتقام",
    "ayahnumber" : "47",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1823",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1824",
    "ayah_text" : "يَوۡمَ تُبَدَّلُ ٱلۡأَرۡضُ غَيۡرَ ٱلۡأَرۡضِ وَٱلسَّمَٰوَٰتُۖ وَبَرَزُواْ لِلَّهِ ٱلۡوَٰحِدِ ٱلۡقَهَّارِ",
    "ayah_text_no_diacratic" : "يوم تبدل الارض غير الارض والسمٰوٰت وبرزوا لله الوٰحد القهار",
    "ayahnumber" : "48",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1824",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1825",
    "ayah_text" : "وَتَرَى ٱلۡمُجۡرِمِينَ يَوۡمَئِذٖ مُّقَرَّنِينَ فِي ٱلۡأَصۡفَادِ",
    "ayah_text_no_diacratic" : "وترى المجرمين يومئذ مقرنين في الاصفاد",
    "ayahnumber" : "49",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1825",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1826",
    "ayah_text" : "سَرَابِيلُهُم مِّن قَطِرَانٖ وَتَغۡشَىٰ وُجُوهَهُمُ ٱلنَّارُ",
    "ayah_text_no_diacratic" : "سرابيلهم من قطران وتغشىٰ وجوههم النار",
    "ayahnumber" : "50",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1826",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1827",
    "ayah_text" : "لِيَجۡزِيَ ٱللَّهُ كُلَّ نَفۡسٖ مَّا كَسَبَتۡۚ إِنَّ ٱللَّهَ سَرِيعُ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "ليجزي الله كل نفس ما كسبت ان الله سريع الحساب",
    "ayahnumber" : "51",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1827",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1828",
    "ayah_text" : "هَٰذَا بَلَٰغٞ لِّلنَّاسِ وَلِيُنذَرُواْ بِهِۦ وَلِيَعۡلَمُوٓاْ أَنَّمَا هُوَ إِلَٰهٞ وَٰحِدٞ وَلِيَذَّكَّرَ أُوْلُواْ ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "هٰذا بلٰغ للناس ولينذروا به وليعلموا انما هو الٰه وٰحد وليذكر اولوا الالبٰب",
    "ayahnumber" : "52",
    "chapter" : "13",
    "hizb" : "26",
    "index" : "1828",
    "page" : "261",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
