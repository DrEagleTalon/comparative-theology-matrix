    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:776",
    "ayah_text" : "ٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ وَأَنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "اعلموا ان الله شديد العقاب وان الله غفور رحيم",
