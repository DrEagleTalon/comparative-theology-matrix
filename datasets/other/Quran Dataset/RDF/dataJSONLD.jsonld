    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1175",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1175",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1176",
    "ayah_text" : "يَسۡـَٔلُونَكَ عَنِ ٱلۡأَنفَالِۖ قُلِ ٱلۡأَنفَالُ لِلَّهِ وَٱلرَّسُولِۖ فَٱتَّقُواْ ٱللَّهَ وَأَصۡلِحُواْ ذَاتَ بَيۡنِكُمۡۖ وَأَطِيعُواْ ٱللَّهَ وَرَسُولَهُۥٓ إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "يسلونك عن الانفال قل الانفال لله والرسول فاتقوا الله واصلحوا ذات بينكم واطيعوا الله ورسوله ان كنتم مؤمنين",
    "ayahnumber" : "1",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1176",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1177",
    "ayah_text" : "إِنَّمَا ٱلۡمُؤۡمِنُونَ ٱلَّذِينَ إِذَا ذُكِرَ ٱللَّهُ وَجِلَتۡ قُلُوبُهُمۡ وَإِذَا تُلِيَتۡ عَلَيۡهِمۡ ءَايَٰتُهُۥ زَادَتۡهُمۡ إِيمَٰنٗا وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ",
    "ayah_text_no_diacratic" : "انما المؤمنون الذين اذا ذكر الله وجلت قلوبهم واذا تليت عليهم ءايٰته زادتهم ايمٰنا وعلىٰ ربهم يتوكلون",
    "ayahnumber" : "2",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1177",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1178",
    "ayah_text" : "ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ",
    "ayah_text_no_diacratic" : "الذين يقيمون الصلوٰة ومما رزقنٰهم ينفقون",
    "ayahnumber" : "3",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1178",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1179",
    "ayah_text" : "أُوْلَٰٓئِكَ هُمُ ٱلۡمُؤۡمِنُونَ حَقّٗاۚ لَّهُمۡ دَرَجَٰتٌ عِندَ رَبِّهِمۡ وَمَغۡفِرَةٞ وَرِزۡقٞ كَرِيمٞ",
    "ayah_text_no_diacratic" : "اولٰئك هم المؤمنون حقا لهم درجٰت عند ربهم ومغفرة ورزق كريم",
    "ayahnumber" : "4",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1179",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:118",
    "ayah_text" : "أَمۡ تُرِيدُونَ أَن تَسۡـَٔلُواْ رَسُولَكُمۡ كَمَا سُئِلَ مُوسَىٰ مِن قَبۡلُۗ وَمَن يَتَبَدَّلِ ٱلۡكُفۡرَ بِٱلۡإِيمَٰنِ فَقَدۡ ضَلَّ سَوَآءَ ٱلسَّبِيلِ",
    "ayah_text_no_diacratic" : "ام تريدون ان تسلوا رسولكم كما سئل موسىٰ من قبل ومن يتبدل الكفر بالايمٰن فقد ضل سواء السبيل",
    "ayahnumber" : "108",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "118",
    "page" : "17",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1180",
    "ayah_text" : "كَمَآ أَخۡرَجَكَ رَبُّكَ مِنۢ بَيۡتِكَ بِٱلۡحَقِّ وَإِنَّ فَرِيقٗا مِّنَ ٱلۡمُؤۡمِنِينَ لَكَٰرِهُونَ",
    "ayah_text_no_diacratic" : "كما اخرجك ربك من بيتك بالحق وان فريقا من المؤمنين لكٰرهون",
    "ayahnumber" : "5",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1180",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1181",
    "ayah_text" : "يُجَٰدِلُونَكَ فِي ٱلۡحَقِّ بَعۡدَ مَا تَبَيَّنَ كَأَنَّمَا يُسَاقُونَ إِلَى ٱلۡمَوۡتِ وَهُمۡ يَنظُرُونَ",
    "ayah_text_no_diacratic" : "يجٰدلونك في الحق بعد ما تبين كانما يساقون الى الموت وهم ينظرون",
    "ayahnumber" : "6",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1181",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1182",
    "ayah_text" : "وَإِذۡ يَعِدُكُمُ ٱللَّهُ إِحۡدَى ٱلطَّآئِفَتَيۡنِ أَنَّهَا لَكُمۡ وَتَوَدُّونَ أَنَّ غَيۡرَ ذَاتِ ٱلشَّوۡكَةِ تَكُونُ لَكُمۡ وَيُرِيدُ ٱللَّهُ أَن يُحِقَّ ٱلۡحَقَّ بِكَلِمَٰتِهِۦ وَيَقۡطَعَ دَابِرَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "واذ يعدكم الله احدى الطائفتين انها لكم وتودون ان غير ذات الشوكة تكون لكم ويريد الله ان يحق الحق بكلمٰته ويقطع دابر الكٰفرين",
    "ayahnumber" : "7",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1182",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1183",
    "ayah_text" : "لِيُحِقَّ ٱلۡحَقَّ وَيُبۡطِلَ ٱلۡبَٰطِلَ وَلَوۡ كَرِهَ ٱلۡمُجۡرِمُونَ",
    "ayah_text_no_diacratic" : "ليحق الحق ويبطل البٰطل ولو كره المجرمون",
    "ayahnumber" : "8",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1183",
    "page" : "177",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1184",
    "ayah_text" : "إِذۡ تَسۡتَغِيثُونَ رَبَّكُمۡ فَٱسۡتَجَابَ لَكُمۡ أَنِّي مُمِدُّكُم بِأَلۡفٖ مِّنَ ٱلۡمَلَٰٓئِكَةِ مُرۡدِفِينَ",
    "ayah_text_no_diacratic" : "اذ تستغيثون ربكم فاستجاب لكم اني ممدكم بالف من الملٰئكة مردفين",
    "ayahnumber" : "9",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1184",
    "page" : "178",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1185",
    "ayah_text" : "وَمَا جَعَلَهُ ٱللَّهُ إِلَّا بُشۡرَىٰ وَلِتَطۡمَئِنَّ بِهِۦ قُلُوبُكُمۡۚ وَمَا ٱلنَّصۡرُ إِلَّا مِنۡ عِندِ ٱللَّهِۚ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ",
    "ayah_text_no_diacratic" : "وما جعله الله الا بشرىٰ ولتطمئن به قلوبكم وما النصر الا من عند الله ان الله عزيز حكيم",
    "ayahnumber" : "10",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1185",
    "page" : "178",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1186",
    "ayah_text" : "إِذۡ يُغَشِّيكُمُ ٱلنُّعَاسَ أَمَنَةٗ مِّنۡهُ وَيُنَزِّلُ عَلَيۡكُم مِّنَ ٱلسَّمَآءِ مَآءٗ لِّيُطَهِّرَكُم بِهِۦ وَيُذۡهِبَ عَنكُمۡ رِجۡزَ ٱلشَّيۡطَٰنِ وَلِيَرۡبِطَ عَلَىٰ قُلُوبِكُمۡ وَيُثَبِّتَ بِهِ ٱلۡأَقۡدَامَ",
    "ayah_text_no_diacratic" : "اذ يغشيكم النعاس امنة منه وينزل عليكم من السماء ماء ليطهركم به ويذهب عنكم رجز الشيطٰن وليربط علىٰ قلوبكم ويثبت به الاقدام",
    "ayahnumber" : "11",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1186",
    "page" : "178",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1187",
    "ayah_text" : "إِذۡ يُوحِي رَبُّكَ إِلَى ٱلۡمَلَٰٓئِكَةِ أَنِّي مَعَكُمۡ فَثَبِّتُواْ ٱلَّذِينَ ءَامَنُواْۚ سَأُلۡقِي فِي قُلُوبِ ٱلَّذِينَ كَفَرُواْ ٱلرُّعۡبَ فَٱضۡرِبُواْ فَوۡقَ ٱلۡأَعۡنَاقِ وَٱضۡرِبُواْ مِنۡهُمۡ كُلَّ بَنَانٖ",
    "ayah_text_no_diacratic" : "اذ يوحي ربك الى الملٰئكة اني معكم فثبتوا الذين ءامنوا سالقي في قلوب الذين كفروا الرعب فاضربوا فوق الاعناق واضربوا منهم كل بنان",
    "ayahnumber" : "12",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1187",
    "page" : "178",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1188",
    "ayah_text" : "ذَٰلِكَ بِأَنَّهُمۡ شَآقُّواْ ٱللَّهَ وَرَسُولَهُۥۚ وَمَن يُشَاقِقِ ٱللَّهَ وَرَسُولَهُۥ فَإِنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ",
    "ayah_text_no_diacratic" : "ذٰلك بانهم شاقوا الله ورسوله ومن يشاقق الله ورسوله فان الله شديد العقاب",
    "ayahnumber" : "13",
    "chapter" : "9",
    "hizb" : "17",
