  }, {
    "@id" : "quran:3130",
    "ayah_text" : "وَزُرُوعٖ وَنَخۡلٖ طَلۡعُهَا هَضِيمٞ",
    "ayah_text_no_diacratic" : "وزروع ونخل طلعها هضيم",
