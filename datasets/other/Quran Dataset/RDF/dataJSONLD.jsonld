    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2587",
    "ayah_text" : "فَرَجَعُوٓاْ إِلَىٰٓ أَنفُسِهِمۡ فَقَالُوٓاْ إِنَّكُمۡ أَنتُمُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "فرجعوا الىٰ انفسهم فقالوا انكم انتم الظٰلمون",
