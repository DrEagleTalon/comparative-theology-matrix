    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4875",
    "ayah_text" : "أَمۡ لَهُمۡ سُلَّمٞ يَسۡتَمِعُونَ فِيهِۖ فَلۡيَأۡتِ مُسۡتَمِعُهُم بِسُلۡطَٰنٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "ام لهم سلم يستمعون فيه فليات مستمعهم بسلطٰن مبين",
