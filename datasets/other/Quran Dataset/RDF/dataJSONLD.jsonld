    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2392",
    "ayah_text" : "لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَمَا تَحۡتَ ٱلثَّرَىٰ",
    "ayah_text_no_diacratic" : "له ما في السمٰوٰت وما في الارض وما بينهما وما تحت الثرىٰ",
    "ayahnumber" : "6",
    "chapter" : "16",
