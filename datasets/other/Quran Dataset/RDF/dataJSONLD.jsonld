    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5449",
    "ayah_text" : "فَذَرۡنِي وَمَن يُكَذِّبُ بِهَٰذَا ٱلۡحَدِيثِۖ سَنَسۡتَدۡرِجُهُم مِّنۡ حَيۡثُ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فذرني ومن يكذب بهٰذا الحديث سنستدرجهم من حيث لا يعلمون",
    "ayahnumber" : "44",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5449",
    "page" : "566",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:545",
    "ayah_text" : "وَٱللَّهُ أَعۡلَمُ بِأَعۡدَآئِكُمۡۚ وَكَفَىٰ بِٱللَّهِ وَلِيّٗا وَكَفَىٰ بِٱللَّهِ نَصِيرٗا",
    "ayah_text_no_diacratic" : "والله اعلم باعدائكم وكفىٰ بالله وليا وكفىٰ بالله نصيرا",
    "ayahnumber" : "45",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "545",
    "page" : "86",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5450",
    "ayah_text" : "وَأُمۡلِي لَهُمۡۚ إِنَّ كَيۡدِي مَتِينٌ",
    "ayah_text_no_diacratic" : "واملي لهم ان كيدي متين",
    "ayahnumber" : "45",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5450",
    "page" : "566",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5451",
    "ayah_text" : "أَمۡ تَسۡـَٔلُهُمۡ أَجۡرٗا فَهُم مِّن مَّغۡرَمٖ مُّثۡقَلُونَ",
    "ayah_text_no_diacratic" : "ام تسلهم اجرا فهم من مغرم مثقلون",
    "ayahnumber" : "46",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5451",
    "page" : "566",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5452",
    "ayah_text" : "أَمۡ عِندَهُمُ ٱلۡغَيۡبُ فَهُمۡ يَكۡتُبُونَ",
    "ayah_text_no_diacratic" : "ام عندهم الغيب فهم يكتبون",
    "ayahnumber" : "47",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5452",
    "page" : "566",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5453",
    "ayah_text" : "فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلۡحُوتِ إِذۡ نَادَىٰ وَهُوَ مَكۡظُومٞ",
    "ayah_text_no_diacratic" : "فاصبر لحكم ربك ولا تكن كصاحب الحوت اذ نادىٰ وهو مكظوم",
    "ayahnumber" : "48",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5453",
    "page" : "566",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5454",
    "ayah_text" : "لَّوۡلَآ أَن تَدَٰرَكَهُۥ نِعۡمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلۡعَرَآءِ وَهُوَ مَذۡمُومٞ",
    "ayah_text_no_diacratic" : "لولا ان تدٰركه نعمة من ربه لنبذ بالعراء وهو مذموم",
    "ayahnumber" : "49",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5454",
    "page" : "566",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5455",
    "ayah_text" : "فَٱجۡتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "فاجتبٰه ربه فجعله من الصٰلحين",
    "ayahnumber" : "50",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5455",
    "page" : "566",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5456",
    "ayah_text" : "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُواْ لَيُزۡلِقُونَكَ بِأَبۡصَٰرِهِمۡ لَمَّا سَمِعُواْ ٱلذِّكۡرَ وَيَقُولُونَ إِنَّهُۥ لَمَجۡنُونٞ",
    "ayah_text_no_diacratic" : "وان يكاد الذين كفروا ليزلقونك بابصٰرهم لما سمعوا الذكر ويقولون انه لمجنون",
    "ayahnumber" : "51",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5456",
    "page" : "566",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5457",
    "ayah_text" : "وَمَا هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "وما هو الا ذكر للعٰلمين",
    "ayahnumber" : "52",
