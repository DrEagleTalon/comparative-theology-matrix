    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:845",
    "ayah_text" : "فَقُطِعَ دَابِرُ ٱلۡقَوۡمِ ٱلَّذِينَ ظَلَمُواْۚ وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "فقطع دابر القوم الذين ظلموا والحمد لله رب العٰلمين",
