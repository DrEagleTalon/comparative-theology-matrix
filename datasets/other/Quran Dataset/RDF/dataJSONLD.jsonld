    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:787",
    "ayah_text" : "۞يَوۡمَ يَجۡمَعُ ٱللَّهُ ٱلرُّسُلَ فَيَقُولُ مَاذَآ أُجِبۡتُمۡۖ قَالُواْ لَا عِلۡمَ لَنَآۖ إِنَّكَ أَنتَ عَلَّٰمُ ٱلۡغُيُوبِ",
    "ayah_text_no_diacratic" : "يوم يجمع الله الرسل فيقول ماذا اجبتم قالوا لا علم لنا انك انت علٰم الغيوب",
    "ayahnumber" : "109",
    "chapter" : "7",
