    "page" : "491",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4437",
    "ayah_text" : "وَجَعَلَهَا كَلِمَةَۢ بَاقِيَةٗ فِي عَقِبِهِۦ لَعَلَّهُمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "وجعلها كلمة باقية في عقبه لعلهم يرجعون",
    "ayahnumber" : "28",
    "chapter" : "25",
    "hizb" : "49",
