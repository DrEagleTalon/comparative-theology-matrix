    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3093",
    "ayah_text" : "۞قَالُوٓاْ أَنُؤۡمِنُ لَكَ وَٱتَّبَعَكَ ٱلۡأَرۡذَلُونَ",
    "ayah_text_no_diacratic" : "قالوا انؤمن لك واتبعك الارذلون",
