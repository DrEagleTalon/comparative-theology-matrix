    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1126",
    "ayah_text" : "وَمِن قَوۡمِ مُوسَىٰٓ أُمَّةٞ يَهۡدُونَ بِٱلۡحَقِّ وَبِهِۦ يَعۡدِلُونَ",
    "ayah_text_no_diacratic" : "ومن قوم موسىٰ امة يهدون بالحق وبه يعدلون",
