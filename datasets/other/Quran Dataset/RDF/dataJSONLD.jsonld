  }, {
    "@id" : "quran:2880",
    "ayah_text" : "أَلَمۡ تَرَ أَنَّ ٱللَّهَ يُزۡجِي سَحَابٗا ثُمَّ يُؤَلِّفُ بَيۡنَهُۥ ثُمَّ يَجۡعَلُهُۥ رُكَامٗا فَتَرَى ٱلۡوَدۡقَ يَخۡرُجُ مِنۡ خِلَٰلِهِۦ وَيُنَزِّلُ مِنَ ٱلسَّمَآءِ مِن جِبَالٖ فِيهَا مِنۢ بَرَدٖ فَيُصِيبُ بِهِۦ مَن يَشَآءُ وَيَصۡرِفُهُۥ عَن مَّن يَشَآءُۖ يَكَادُ سَنَا بَرۡقِهِۦ يَذۡهَبُ بِٱلۡأَبۡصَٰرِ",
    "ayah_text_no_diacratic" : "الم تر ان الله يزجي سحابا ثم يؤلف بينه ثم يجعله ركاما فترى الودق يخرج من خلٰله وينزل من السماء من جبال فيها من برد فيصيب به من يشاء ويصرفه عن من يشاء يكاد سنا برقه يذهب بالابصٰر",
    "ayahnumber" : "43",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2880",
    "page" : "355",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2881",
    "ayah_text" : "يُقَلِّبُ ٱللَّهُ ٱلَّيۡلَ وَٱلنَّهَارَۚ إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّأُوْلِي ٱلۡأَبۡصَٰرِ",
    "ayah_text_no_diacratic" : "يقلب الله اليل والنهار ان في ذٰلك لعبرة لاولي الابصٰر",
    "ayahnumber" : "44",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2881",
    "page" : "356",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2882",
    "ayah_text" : "وَٱللَّهُ خَلَقَ كُلَّ دَآبَّةٖ مِّن مَّآءٖۖ فَمِنۡهُم مَّن يَمۡشِي عَلَىٰ بَطۡنِهِۦ وَمِنۡهُم مَّن يَمۡشِي عَلَىٰ رِجۡلَيۡنِ وَمِنۡهُم مَّن يَمۡشِي عَلَىٰٓ أَرۡبَعٖۚ يَخۡلُقُ ٱللَّهُ مَا يَشَآءُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "والله خلق كل دابة من ماء فمنهم من يمشي علىٰ بطنه ومنهم من يمشي علىٰ رجلين ومنهم من يمشي علىٰ اربع يخلق الله ما يشاء ان الله علىٰ كل شيء قدير",
    "ayahnumber" : "45",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2882",
    "page" : "356",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2883",
    "ayah_text" : "لَّقَدۡ أَنزَلۡنَآ ءَايَٰتٖ مُّبَيِّنَٰتٖۚ وَٱللَّهُ يَهۡدِي مَن يَشَآءُ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "لقد انزلنا ءايٰت مبينٰت والله يهدي من يشاء الىٰ صرٰط مستقيم",
    "ayahnumber" : "46",
    "chapter" : "18",
    "hizb" : "35",
