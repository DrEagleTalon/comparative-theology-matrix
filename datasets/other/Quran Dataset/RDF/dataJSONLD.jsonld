    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4303",
    "ayah_text" : "وَقَالُواْ قُلُوبُنَا فِيٓ أَكِنَّةٖ مِّمَّا تَدۡعُونَآ إِلَيۡهِ وَفِيٓ ءَاذَانِنَا وَقۡرٞ وَمِنۢ بَيۡنِنَا وَبَيۡنِكَ حِجَابٞ فَٱعۡمَلۡ إِنَّنَا عَٰمِلُونَ",
    "ayah_text_no_diacratic" : "وقالوا قلوبنا في اكنة مما تدعونا اليه وفي ءاذاننا وقر ومن بيننا وبينك حجاب فاعمل اننا عٰملون",
    "ayahnumber" : "5",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4303",
    "page" : "477",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4304",
    "ayah_text" : "قُلۡ إِنَّمَآ أَنَا۠ بَشَرٞ مِّثۡلُكُمۡ يُوحَىٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞ فَٱسۡتَقِيمُوٓاْ إِلَيۡهِ وَٱسۡتَغۡفِرُوهُۗ وَوَيۡلٞ لِّلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "قل انما انا بشر مثلكم يوحىٰ الي انما الٰهكم الٰه وٰحد فاستقيموا اليه واستغفروه وويل للمشركين",
    "ayahnumber" : "6",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4304",
    "page" : "477",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4305",
    "ayah_text" : "ٱلَّذِينَ لَا يُؤۡتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلۡأٓخِرَةِ هُمۡ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "الذين لا يؤتون الزكوٰة وهم بالاخرة هم كٰفرون",
    "ayahnumber" : "7",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4305",
    "page" : "477",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4306",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت لهم اجر غير ممنون",
    "ayahnumber" : "8",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4306",
    "page" : "477",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4307",
    "ayah_text" : "۞قُلۡ أَئِنَّكُمۡ لَتَكۡفُرُونَ بِٱلَّذِي خَلَقَ ٱلۡأَرۡضَ فِي يَوۡمَيۡنِ وَتَجۡعَلُونَ لَهُۥٓ أَندَادٗاۚ ذَٰلِكَ رَبُّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "قل ائنكم لتكفرون بالذي خلق الارض في يومين وتجعلون له اندادا ذٰلك رب العٰلمين",
    "ayahnumber" : "9",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4307",
    "page" : "477",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4308",
    "ayah_text" : "وَجَعَلَ فِيهَا رَوَٰسِيَ مِن فَوۡقِهَا وَبَٰرَكَ فِيهَا وَقَدَّرَ فِيهَآ أَقۡوَٰتَهَا فِيٓ أَرۡبَعَةِ أَيَّامٖ سَوَآءٗ لِّلسَّآئِلِينَ",
    "ayah_text_no_diacratic" : "وجعل فيها روٰسي من فوقها وبٰرك فيها وقدر فيها اقوٰتها في اربعة ايام سواء للسائلين",
    "ayahnumber" : "10",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4308",
    "page" : "477",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4309",
    "ayah_text" : "ثُمَّ ٱسۡتَوَىٰٓ إِلَى ٱلسَّمَآءِ وَهِيَ دُخَانٞ فَقَالَ لَهَا وَلِلۡأَرۡضِ ٱئۡتِيَا طَوۡعًا أَوۡ كَرۡهٗا قَالَتَآ أَتَيۡنَا طَآئِعِينَ",
    "ayah_text_no_diacratic" : "ثم استوىٰ الى السماء وهي دخان فقال لها وللارض ائتيا طوعا او كرها قالتا اتينا طائعين",
    "ayahnumber" : "11",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4309",
    "page" : "477",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:431",
    "ayah_text" : "۞وَسَارِعُوٓاْ إِلَىٰ مَغۡفِرَةٖ مِّن رَّبِّكُمۡ وَجَنَّةٍ عَرۡضُهَا ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ أُعِدَّتۡ لِلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "وسارعوا الىٰ مغفرة من ربكم وجنة عرضها السمٰوٰت والارض اعدت للمتقين",
    "ayahnumber" : "133",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "431",
    "page" : "67",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4310",
    "ayah_text" : "فَقَضَىٰهُنَّ سَبۡعَ سَمَٰوَاتٖ فِي يَوۡمَيۡنِ وَأَوۡحَىٰ فِي كُلِّ سَمَآءٍ أَمۡرَهَاۚ وَزَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِمَصَٰبِيحَ وَحِفۡظٗاۚ ذَٰلِكَ تَقۡدِيرُ ٱلۡعَزِيزِ ٱلۡعَلِيمِ",
    "ayah_text_no_diacratic" : "فقضىٰهن سبع سمٰوات في يومين واوحىٰ في كل سماء امرها وزينا السماء الدنيا بمصٰبيح وحفظا ذٰلك تقدير العزيز العليم",
    "ayahnumber" : "12",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4310",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4311",
    "ayah_text" : "فَإِنۡ أَعۡرَضُواْ فَقُلۡ أَنذَرۡتُكُمۡ صَٰعِقَةٗ مِّثۡلَ صَٰعِقَةِ عَادٖ وَثَمُودَ",
    "ayah_text_no_diacratic" : "فان اعرضوا فقل انذرتكم صٰعقة مثل صٰعقة عاد وثمود",
    "ayahnumber" : "13",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4311",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4312",
    "ayah_text" : "إِذۡ جَآءَتۡهُمُ ٱلرُّسُلُ مِنۢ بَيۡنِ أَيۡدِيهِمۡ وَمِنۡ خَلۡفِهِمۡ أَلَّا تَعۡبُدُوٓاْ إِلَّا ٱللَّهَۖ قَالُواْ لَوۡ شَآءَ رَبُّنَا لَأَنزَلَ مَلَٰٓئِكَةٗ فَإِنَّا بِمَآ أُرۡسِلۡتُم بِهِۦ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "اذ جاءتهم الرسل من بين ايديهم ومن خلفهم الا تعبدوا الا الله قالوا لو شاء ربنا لانزل ملٰئكة فانا بما ارسلتم به كٰفرون",
    "ayahnumber" : "14",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4312",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4313",
    "ayah_text" : "فَأَمَّا عَادٞ فَٱسۡتَكۡبَرُواْ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّ وَقَالُواْ مَنۡ أَشَدُّ مِنَّا قُوَّةًۖ أَوَلَمۡ يَرَوۡاْ أَنَّ ٱللَّهَ ٱلَّذِي خَلَقَهُمۡ هُوَ أَشَدُّ مِنۡهُمۡ قُوَّةٗۖ وَكَانُواْ بِـَٔايَٰتِنَا يَجۡحَدُونَ",
    "ayah_text_no_diacratic" : "فاما عاد فاستكبروا في الارض بغير الحق وقالوا من اشد منا قوة اولم يروا ان الله الذي خلقهم هو اشد منهم قوة وكانوا بايٰتنا يجحدون",
    "ayahnumber" : "15",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4313",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4314",
    "ayah_text" : "فَأَرۡسَلۡنَا عَلَيۡهِمۡ رِيحٗا صَرۡصَرٗا فِيٓ أَيَّامٖ نَّحِسَاتٖ لِّنُذِيقَهُمۡ عَذَابَ ٱلۡخِزۡيِ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَخۡزَىٰۖ وَهُمۡ لَا يُنصَرُونَ",
    "ayah_text_no_diacratic" : "فارسلنا عليهم ريحا صرصرا في ايام نحسات لنذيقهم عذاب الخزي في الحيوٰة الدنيا ولعذاب الاخرة اخزىٰ وهم لا ينصرون",
    "ayahnumber" : "16",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4314",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4315",
    "ayah_text" : "وَأَمَّا ثَمُودُ فَهَدَيۡنَٰهُمۡ فَٱسۡتَحَبُّواْ ٱلۡعَمَىٰ عَلَى ٱلۡهُدَىٰ فَأَخَذَتۡهُمۡ صَٰعِقَةُ ٱلۡعَذَابِ ٱلۡهُونِ بِمَا كَانُواْ يَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "واما ثمود فهدينٰهم فاستحبوا العمىٰ على الهدىٰ فاخذتهم صٰعقة العذاب الهون بما كانوا يكسبون",
    "ayahnumber" : "17",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4315",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4316",
    "ayah_text" : "وَنَجَّيۡنَا ٱلَّذِينَ ءَامَنُواْ وَكَانُواْ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "ونجينا الذين ءامنوا وكانوا يتقون",
    "ayahnumber" : "18",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4316",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4317",
    "ayah_text" : "وَيَوۡمَ يُحۡشَرُ أَعۡدَآءُ ٱللَّهِ إِلَى ٱلنَّارِ فَهُمۡ يُوزَعُونَ",
    "ayah_text_no_diacratic" : "ويوم يحشر اعداء الله الى النار فهم يوزعون",
    "ayahnumber" : "19",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4317",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4318",
    "ayah_text" : "حَتَّىٰٓ إِذَا مَا جَآءُوهَا شَهِدَ عَلَيۡهِمۡ سَمۡعُهُمۡ وَأَبۡصَٰرُهُمۡ وَجُلُودُهُم بِمَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "حتىٰ اذا ما جاءوها شهد عليهم سمعهم وابصٰرهم وجلودهم بما كانوا يعملون",
    "ayahnumber" : "20",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4318",
    "page" : "478",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4319",
    "ayah_text" : "وَقَالُواْ لِجُلُودِهِمۡ لِمَ شَهِدتُّمۡ عَلَيۡنَاۖ قَالُوٓاْ أَنطَقَنَا ٱللَّهُ ٱلَّذِيٓ أَنطَقَ كُلَّ شَيۡءٖۚ وَهُوَ خَلَقَكُمۡ أَوَّلَ مَرَّةٖ وَإِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "وقالوا لجلودهم لم شهدتم علينا قالوا انطقنا الله الذي انطق كل شيء وهو خلقكم اول مرة واليه ترجعون",
    "ayahnumber" : "21",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4319",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:432",
    "ayah_text" : "ٱلَّذِينَ يُنفِقُونَ فِي ٱلسَّرَّآءِ وَٱلضَّرَّآءِ وَٱلۡكَٰظِمِينَ ٱلۡغَيۡظَ وَٱلۡعَافِينَ عَنِ ٱلنَّاسِۗ وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "الذين ينفقون في السراء والضراء والكٰظمين الغيظ والعافين عن الناس والله يحب المحسنين",
    "ayahnumber" : "134",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "432",
    "page" : "67",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4320",
    "ayah_text" : "وَمَا كُنتُمۡ تَسۡتَتِرُونَ أَن يَشۡهَدَ عَلَيۡكُمۡ سَمۡعُكُمۡ وَلَآ أَبۡصَٰرُكُمۡ وَلَا جُلُودُكُمۡ وَلَٰكِن ظَنَنتُمۡ أَنَّ ٱللَّهَ لَا يَعۡلَمُ كَثِيرٗا مِّمَّا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "وما كنتم تستترون ان يشهد عليكم سمعكم ولا ابصٰركم ولا جلودكم ولٰكن ظننتم ان الله لا يعلم كثيرا مما تعملون",
    "ayahnumber" : "22",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4320",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4321",
    "ayah_text" : "وَذَٰلِكُمۡ ظَنُّكُمُ ٱلَّذِي ظَنَنتُم بِرَبِّكُمۡ أَرۡدَىٰكُمۡ فَأَصۡبَحۡتُم مِّنَ ٱلۡخَٰسِرِينَ",
    "ayah_text_no_diacratic" : "وذٰلكم ظنكم الذي ظننتم بربكم اردىٰكم فاصبحتم من الخٰسرين",
    "ayahnumber" : "23",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4321",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4322",
    "ayah_text" : "فَإِن يَصۡبِرُواْ فَٱلنَّارُ مَثۡوٗى لَّهُمۡۖ وَإِن يَسۡتَعۡتِبُواْ فَمَا هُم مِّنَ ٱلۡمُعۡتَبِينَ",
    "ayah_text_no_diacratic" : "فان يصبروا فالنار مثوى لهم وان يستعتبوا فما هم من المعتبين",
    "ayahnumber" : "24",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4322",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4323",
    "ayah_text" : "۞وَقَيَّضۡنَا لَهُمۡ قُرَنَآءَ فَزَيَّنُواْ لَهُم مَّا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡ وَحَقَّ عَلَيۡهِمُ ٱلۡقَوۡلُ فِيٓ أُمَمٖ قَدۡ خَلَتۡ مِن قَبۡلِهِم مِّنَ ٱلۡجِنِّ وَٱلۡإِنسِۖ إِنَّهُمۡ كَانُواْ خَٰسِرِينَ",
    "ayah_text_no_diacratic" : "وقيضنا لهم قرناء فزينوا لهم ما بين ايديهم وما خلفهم وحق عليهم القول في امم قد خلت من قبلهم من الجن والانس انهم كانوا خٰسرين",
    "ayahnumber" : "25",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4323",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4324",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُواْ لَا تَسۡمَعُواْ لِهَٰذَا ٱلۡقُرۡءَانِ وَٱلۡغَوۡاْ فِيهِ لَعَلَّكُمۡ تَغۡلِبُونَ",
    "ayah_text_no_diacratic" : "وقال الذين كفروا لا تسمعوا لهٰذا القرءان والغوا فيه لعلكم تغلبون",
    "ayahnumber" : "26",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4324",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4325",
    "ayah_text" : "فَلَنُذِيقَنَّ ٱلَّذِينَ كَفَرُواْ عَذَابٗا شَدِيدٗا وَلَنَجۡزِيَنَّهُمۡ أَسۡوَأَ ٱلَّذِي كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "فلنذيقن الذين كفروا عذابا شديدا ولنجزينهم اسوا الذي كانوا يعملون",
    "ayahnumber" : "27",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4325",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4326",
    "ayah_text" : "ذَٰلِكَ جَزَآءُ أَعۡدَآءِ ٱللَّهِ ٱلنَّارُۖ لَهُمۡ فِيهَا دَارُ ٱلۡخُلۡدِ جَزَآءَۢ بِمَا كَانُواْ بِـَٔايَٰتِنَا يَجۡحَدُونَ",
    "ayah_text_no_diacratic" : "ذٰلك جزاء اعداء الله النار لهم فيها دار الخلد جزاء بما كانوا بايٰتنا يجحدون",
    "ayahnumber" : "28",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4326",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4327",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ كَفَرُواْ رَبَّنَآ أَرِنَا ٱلَّذَيۡنِ أَضَلَّانَا مِنَ ٱلۡجِنِّ وَٱلۡإِنسِ نَجۡعَلۡهُمَا تَحۡتَ أَقۡدَامِنَا لِيَكُونَا مِنَ ٱلۡأَسۡفَلِينَ",
    "ayah_text_no_diacratic" : "وقال الذين كفروا ربنا ارنا الذين اضلانا من الجن والانس نجعلهما تحت اقدامنا ليكونا من الاسفلين",
    "ayahnumber" : "29",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4327",
    "page" : "479",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4328",
    "ayah_text" : "إِنَّ ٱلَّذِينَ قَالُواْ رَبُّنَا ٱللَّهُ ثُمَّ ٱسۡتَقَٰمُواْ تَتَنَزَّلُ عَلَيۡهِمُ ٱلۡمَلَٰٓئِكَةُ أَلَّا تَخَافُواْ وَلَا تَحۡزَنُواْ وَأَبۡشِرُواْ بِٱلۡجَنَّةِ ٱلَّتِي كُنتُمۡ تُوعَدُونَ",
    "ayah_text_no_diacratic" : "ان الذين قالوا ربنا الله ثم استقٰموا تتنزل عليهم الملٰئكة الا تخافوا ولا تحزنوا وابشروا بالجنة التي كنتم توعدون",
    "ayahnumber" : "30",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4328",
    "page" : "480",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4329",
    "ayah_text" : "نَحۡنُ أَوۡلِيَآؤُكُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَفِي ٱلۡأٓخِرَةِۖ وَلَكُمۡ فِيهَا مَا تَشۡتَهِيٓ أَنفُسُكُمۡ وَلَكُمۡ فِيهَا مَا تَدَّعُونَ",
    "ayah_text_no_diacratic" : "نحن اولياؤكم في الحيوٰة الدنيا وفي الاخرة ولكم فيها ما تشتهي انفسكم ولكم فيها ما تدعون",
    "ayahnumber" : "31",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4329",
    "page" : "480",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:433",
    "ayah_text" : "وَٱلَّذِينَ إِذَا فَعَلُواْ فَٰحِشَةً أَوۡ ظَلَمُوٓاْ أَنفُسَهُمۡ ذَكَرُواْ ٱللَّهَ فَٱسۡتَغۡفَرُواْ لِذُنُوبِهِمۡ وَمَن يَغۡفِرُ ٱلذُّنُوبَ إِلَّا ٱللَّهُ وَلَمۡ يُصِرُّواْ عَلَىٰ مَا فَعَلُواْ وَهُمۡ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "والذين اذا فعلوا فٰحشة او ظلموا انفسهم ذكروا الله فاستغفروا لذنوبهم ومن يغفر الذنوب الا الله ولم يصروا علىٰ ما فعلوا وهم يعلمون",
    "ayahnumber" : "135",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "433",
    "page" : "67",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4330",
    "ayah_text" : "نُزُلٗا مِّنۡ غَفُورٖ رَّحِيمٖ",
    "ayah_text_no_diacratic" : "نزلا من غفور رحيم",
    "ayahnumber" : "32",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4330",
    "page" : "480",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4331",
    "ayah_text" : "وَمَنۡ أَحۡسَنُ قَوۡلٗا مِّمَّن دَعَآ إِلَى ٱللَّهِ وَعَمِلَ صَٰلِحٗا وَقَالَ إِنَّنِي مِنَ ٱلۡمُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "ومن احسن قولا ممن دعا الى الله وعمل صٰلحا وقال انني من المسلمين",
    "ayahnumber" : "33",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4331",
    "page" : "480",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4332",
    "ayah_text" : "وَلَا تَسۡتَوِي ٱلۡحَسَنَةُ وَلَا ٱلسَّيِّئَةُۚ ٱدۡفَعۡ بِٱلَّتِي هِيَ أَحۡسَنُ فَإِذَا ٱلَّذِي بَيۡنَكَ وَبَيۡنَهُۥ عَدَٰوَةٞ كَأَنَّهُۥ وَلِيٌّ حَمِيمٞ",
    "ayah_text_no_diacratic" : "ولا تستوي الحسنة ولا السيئة ادفع بالتي هي احسن فاذا الذي بينك وبينه عدٰوة كانه ولي حميم",
    "ayahnumber" : "34",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4332",
    "page" : "480",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4333",
    "ayah_text" : "وَمَا يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ صَبَرُواْ وَمَا يُلَقَّىٰهَآ إِلَّا ذُو حَظٍّ عَظِيمٖ",
    "ayah_text_no_diacratic" : "وما يلقىٰها الا الذين صبروا وما يلقىٰها الا ذو حظ عظيم",
    "ayahnumber" : "35",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4333",
    "page" : "480",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4334",
    "ayah_text" : "وَإِمَّا يَنزَغَنَّكَ مِنَ ٱلشَّيۡطَٰنِ نَزۡغٞ فَٱسۡتَعِذۡ بِٱللَّهِۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "واما ينزغنك من الشيطٰن نزغ فاستعذ بالله انه هو السميع العليم",
    "ayahnumber" : "36",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4334",
    "page" : "480",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4335",
    "ayah_text" : "وَمِنۡ ءَايَٰتِهِ ٱلَّيۡلُ وَٱلنَّهَارُ وَٱلشَّمۡسُ وَٱلۡقَمَرُۚ لَا تَسۡجُدُواْ لِلشَّمۡسِ وَلَا لِلۡقَمَرِ وَٱسۡجُدُواْۤ لِلَّهِۤ ٱلَّذِي خَلَقَهُنَّ إِن كُنتُمۡ إِيَّاهُ تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "ومن ءايٰته اليل والنهار والشمس والقمر لا تسجدوا للشمس ولا للقمر واسجدوا لله الذي خلقهن ان كنتم اياه تعبدون",
    "ayahnumber" : "37",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4335",
    "page" : "480",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4336",
    "ayah_text" : "فَإِنِ ٱسۡتَكۡبَرُواْ فَٱلَّذِينَ عِندَ رَبِّكَ يُسَبِّحُونَ لَهُۥ بِٱلَّيۡلِ وَٱلنَّهَارِ وَهُمۡ لَا يَسۡـَٔمُونَ۩",
    "ayah_text_no_diacratic" : "فان استكبروا فالذين عند ربك يسبحون له باليل والنهار وهم لا يسمون",
    "ayahnumber" : "38",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4336",
    "page" : "480",
    "sajdah" : "1",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4337",
    "ayah_text" : "وَمِنۡ ءَايَٰتِهِۦٓ أَنَّكَ تَرَى ٱلۡأَرۡضَ خَٰشِعَةٗ فَإِذَآ أَنزَلۡنَا عَلَيۡهَا ٱلۡمَآءَ ٱهۡتَزَّتۡ وَرَبَتۡۚ إِنَّ ٱلَّذِيٓ أَحۡيَاهَا لَمُحۡيِ ٱلۡمَوۡتَىٰٓۚ إِنَّهُۥ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "ayah_text_no_diacratic" : "ومن ءايٰته انك ترى الارض خٰشعة فاذا انزلنا عليها الماء اهتزت وربت ان الذي احياها لمحي الموتىٰ انه علىٰ كل شيء قدير",
    "ayahnumber" : "39",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4337",
    "page" : "481",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4338",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يُلۡحِدُونَ فِيٓ ءَايَٰتِنَا لَا يَخۡفَوۡنَ عَلَيۡنَآۗ أَفَمَن يُلۡقَىٰ فِي ٱلنَّارِ خَيۡرٌ أَم مَّن يَأۡتِيٓ ءَامِنٗا يَوۡمَ ٱلۡقِيَٰمَةِۚ ٱعۡمَلُواْ مَا شِئۡتُمۡ إِنَّهُۥ بِمَا تَعۡمَلُونَ بَصِيرٌ",
    "ayah_text_no_diacratic" : "ان الذين يلحدون في ءايٰتنا لا يخفون علينا افمن يلقىٰ في النار خير ام من ياتي ءامنا يوم القيٰمة اعملوا ما شئتم انه بما تعملون بصير",
    "ayahnumber" : "40",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4338",
    "page" : "481",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4339",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ بِٱلذِّكۡرِ لَمَّا جَآءَهُمۡۖ وَإِنَّهُۥ لَكِتَٰبٌ عَزِيزٞ",
    "ayah_text_no_diacratic" : "ان الذين كفروا بالذكر لما جاءهم وانه لكتٰب عزيز",
    "ayahnumber" : "41",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4339",
    "page" : "481",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:434",
    "ayah_text" : "أُوْلَٰٓئِكَ جَزَآؤُهُم مَّغۡفِرَةٞ مِّن رَّبِّهِمۡ وَجَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَنِعۡمَ أَجۡرُ ٱلۡعَٰمِلِينَ",
    "ayah_text_no_diacratic" : "اولٰئك جزاؤهم مغفرة من ربهم وجنٰت تجري من تحتها الانهٰر خٰلدين فيها ونعم اجر العٰملين",
    "ayahnumber" : "136",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "434",
    "page" : "67",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4340",
    "ayah_text" : "لَّا يَأۡتِيهِ ٱلۡبَٰطِلُ مِنۢ بَيۡنِ يَدَيۡهِ وَلَا مِنۡ خَلۡفِهِۦۖ تَنزِيلٞ مِّنۡ حَكِيمٍ حَمِيدٖ",
    "ayah_text_no_diacratic" : "لا ياتيه البٰطل من بين يديه ولا من خلفه تنزيل من حكيم حميد",
    "ayahnumber" : "42",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4340",
    "page" : "481",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4341",
    "ayah_text" : "مَّا يُقَالُ لَكَ إِلَّا مَا قَدۡ قِيلَ لِلرُّسُلِ مِن قَبۡلِكَۚ إِنَّ رَبَّكَ لَذُو مَغۡفِرَةٖ وَذُو عِقَابٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "ما يقال لك الا ما قد قيل للرسل من قبلك ان ربك لذو مغفرة وذو عقاب اليم",
    "ayahnumber" : "43",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4341",
    "page" : "481",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4342",
    "ayah_text" : "وَلَوۡ جَعَلۡنَٰهُ قُرۡءَانًا أَعۡجَمِيّٗا لَّقَالُواْ لَوۡلَا فُصِّلَتۡ ءَايَٰتُهُۥٓۖ ءَا۬عۡجَمِيّٞ وَعَرَبِيّٞۗ قُلۡ هُوَ لِلَّذِينَ ءَامَنُواْ هُدٗى وَشِفَآءٞۚ وَٱلَّذِينَ لَا يُؤۡمِنُونَ فِيٓ ءَاذَانِهِمۡ وَقۡرٞ وَهُوَ عَلَيۡهِمۡ عَمًىۚ أُوْلَٰٓئِكَ يُنَادَوۡنَ مِن مَّكَانِۭ بَعِيدٖ",
    "ayah_text_no_diacratic" : "ولو جعلنٰه قرءانا اعجميا لقالوا لولا فصلت ءايٰته ءاعجمي وعربي قل هو للذين ءامنوا هدى وشفاء والذين لا يؤمنون في ءاذانهم وقر وهو عليهم عمى اولٰئك ينادون من مكان بعيد",
    "ayahnumber" : "44",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4342",
    "page" : "481",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4343",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ فَٱخۡتُلِفَ فِيهِۚ وَلَوۡلَا كَلِمَةٞ سَبَقَتۡ مِن رَّبِّكَ لَقُضِيَ بَيۡنَهُمۡۚ وَإِنَّهُمۡ لَفِي شَكّٖ مِّنۡهُ مُرِيبٖ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسى الكتٰب فاختلف فيه ولولا كلمة سبقت من ربك لقضي بينهم وانهم لفي شك منه مريب",
    "ayahnumber" : "45",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4343",
    "page" : "481",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4344",
    "ayah_text" : "مَّنۡ عَمِلَ صَٰلِحٗا فَلِنَفۡسِهِۦۖ وَمَنۡ أَسَآءَ فَعَلَيۡهَاۗ وَمَا رَبُّكَ بِظَلَّٰمٖ لِّلۡعَبِيدِ",
    "ayah_text_no_diacratic" : "من عمل صٰلحا فلنفسه ومن اساء فعليها وما ربك بظلٰم للعبيد",
    "ayahnumber" : "46",
    "chapter" : "24",
    "hizb" : "48",
    "index" : "4344",
    "page" : "481",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4345",
    "ayah_text" : "۞إِلَيۡهِ يُرَدُّ عِلۡمُ ٱلسَّاعَةِۚ وَمَا تَخۡرُجُ مِن ثَمَرَٰتٖ مِّنۡ أَكۡمَامِهَا وَمَا تَحۡمِلُ مِنۡ أُنثَىٰ وَلَا تَضَعُ إِلَّا بِعِلۡمِهِۦۚ وَيَوۡمَ يُنَادِيهِمۡ أَيۡنَ شُرَكَآءِي قَالُوٓاْ ءَاذَنَّٰكَ مَامِنَّا مِن شَهِيدٖ",
    "ayah_text_no_diacratic" : "اليه يرد علم الساعة وما تخرج من ثمرٰت من اكمامها وما تحمل من انثىٰ ولا تضع الا بعلمه ويوم يناديهم اين شركاءي قالوا ءاذنٰك مامنا من شهيد",
    "ayahnumber" : "47",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4345",
    "page" : "482",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4346",
    "ayah_text" : "وَضَلَّ عَنۡهُم مَّا كَانُواْ يَدۡعُونَ مِن قَبۡلُۖ وَظَنُّواْ مَا لَهُم مِّن مَّحِيصٖ",
    "ayah_text_no_diacratic" : "وضل عنهم ما كانوا يدعون من قبل وظنوا ما لهم من محيص",
    "ayahnumber" : "48",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4346",
    "page" : "482",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4347",
    "ayah_text" : "لَّا يَسۡـَٔمُ ٱلۡإِنسَٰنُ مِن دُعَآءِ ٱلۡخَيۡرِ وَإِن مَّسَّهُ ٱلشَّرُّ فَيَـُٔوسٞ قَنُوطٞ",
    "ayah_text_no_diacratic" : "لا يسم الانسٰن من دعاء الخير وان مسه الشر فيوس قنوط",
    "ayahnumber" : "49",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4347",
    "page" : "482",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4348",
    "ayah_text" : "وَلَئِنۡ أَذَقۡنَٰهُ رَحۡمَةٗ مِّنَّا مِنۢ بَعۡدِ ضَرَّآءَ مَسَّتۡهُ لَيَقُولَنَّ هَٰذَا لِي وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةٗ وَلَئِن رُّجِعۡتُ إِلَىٰ رَبِّيٓ إِنَّ لِي عِندَهُۥ لَلۡحُسۡنَىٰۚ فَلَنُنَبِّئَنَّ ٱلَّذِينَ كَفَرُواْ بِمَا عَمِلُواْ وَلَنُذِيقَنَّهُم مِّنۡ عَذَابٍ غَلِيظٖ",
    "ayah_text_no_diacratic" : "ولئن اذقنٰه رحمة منا من بعد ضراء مسته ليقولن هٰذا لي وما اظن الساعة قائمة ولئن رجعت الىٰ ربي ان لي عنده للحسنىٰ فلننبئن الذين كفروا بما عملوا ولنذيقنهم من عذاب غليظ",
    "ayahnumber" : "50",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4348",
    "page" : "482",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4349",
    "ayah_text" : "وَإِذَآ أَنۡعَمۡنَا عَلَى ٱلۡإِنسَٰنِ أَعۡرَضَ وَنَـَٔا بِجَانِبِهِۦ وَإِذَا مَسَّهُ ٱلشَّرُّ فَذُو دُعَآءٍ عَرِيضٖ",
    "ayah_text_no_diacratic" : "واذا انعمنا على الانسٰن اعرض ونا بجانبه واذا مسه الشر فذو دعاء عريض",
    "ayahnumber" : "51",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4349",
    "page" : "482",
    "surahname" : "سُورَةُ فُصِّلَتۡ",
    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:435",
    "ayah_text" : "قَدۡ خَلَتۡ مِن قَبۡلِكُمۡ سُنَنٞ فَسِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُكَذِّبِينَ",
    "ayah_text_no_diacratic" : "قد خلت من قبلكم سنن فسيروا في الارض فانظروا كيف كان عٰقبة المكذبين",
    "ayahnumber" : "137",
    "chapter" : "4",
