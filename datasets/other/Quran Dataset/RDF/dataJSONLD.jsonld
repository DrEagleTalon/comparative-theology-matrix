    "page" : "354",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2874",
    "ayah_text" : "رِجَالٞ لَّا تُلۡهِيهِمۡ تِجَٰرَةٞ وَلَا بَيۡعٌ عَن ذِكۡرِ ٱللَّهِ وَإِقَامِ ٱلصَّلَوٰةِ وَإِيتَآءِ ٱلزَّكَوٰةِ يَخَافُونَ يَوۡمٗا تَتَقَلَّبُ فِيهِ ٱلۡقُلُوبُ وَٱلۡأَبۡصَٰرُ",
    "ayah_text_no_diacratic" : "رجال لا تلهيهم تجٰرة ولا بيع عن ذكر الله واقام الصلوٰة وايتاء الزكوٰة يخافون يوما تتقلب فيه القلوب والابصٰر",
    "ayahnumber" : "37",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2874",
    "page" : "355",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2875",
    "ayah_text" : "لِيَجۡزِيَهُمُ ٱللَّهُ أَحۡسَنَ مَا عَمِلُواْ وَيَزِيدَهُم مِّن فَضۡلِهِۦۗ وَٱللَّهُ يَرۡزُقُ مَن يَشَآءُ بِغَيۡرِ حِسَابٖ",
    "ayah_text_no_diacratic" : "ليجزيهم الله احسن ما عملوا ويزيدهم من فضله والله يرزق من يشاء بغير حساب",
    "ayahnumber" : "38",
    "chapter" : "18",
    "hizb" : "35",
