    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:315",
    "ayah_text" : "ٱلصَّٰبِرِينَ وَٱلصَّٰدِقِينَ وَٱلۡقَٰنِتِينَ وَٱلۡمُنفِقِينَ وَٱلۡمُسۡتَغۡفِرِينَ بِٱلۡأَسۡحَارِ",
    "ayah_text_no_diacratic" : "الصٰبرين والصٰدقين والقٰنتين والمنفقين والمستغفرين بالاسحار",
    "ayahnumber" : "17",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "315",
    "page" : "52",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3150",
    "ayah_text" : "قَالَ إِنِّي لِعَمَلِكُم مِّنَ ٱلۡقَالِينَ",
    "ayah_text_no_diacratic" : "قال اني لعملكم من القالين",
