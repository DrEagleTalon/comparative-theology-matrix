    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:412",
    "ayah_text" : "يُؤۡمِنُونَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَيَأۡمُرُونَ بِٱلۡمَعۡرُوفِ وَيَنۡهَوۡنَ عَنِ ٱلۡمُنكَرِ وَيُسَٰرِعُونَ فِي ٱلۡخَيۡرَٰتِۖ وَأُوْلَٰٓئِكَ مِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "يؤمنون بالله واليوم الاخر ويامرون بالمعروف وينهون عن المنكر ويسٰرعون في الخيرٰت واولٰئك من الصٰلحين",
    "ayahnumber" : "114",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "412",
    "page" : "64",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4120",
    "ayah_text" : "قَالَ أَنَا۠ خَيۡرٞ مِّنۡهُ خَلَقۡتَنِي مِن نَّارٖ وَخَلَقۡتَهُۥ مِن طِينٖ",
    "ayah_text_no_diacratic" : "قال انا خير منه خلقتني من نار وخلقته من طين",
    "ayahnumber" : "76",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4120",
    "page" : "457",
    "surahname" : "سُورَةُ صٓ",
    "surahnumber" : "38",
    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4121",
    "ayah_text" : "قَالَ فَٱخۡرُجۡ مِنۡهَا فَإِنَّكَ رَجِيمٞ",
    "ayah_text_no_diacratic" : "قال فاخرج منها فانك رجيم",
    "ayahnumber" : "77",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "4121",
