    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4701",
    "ayah_text" : "وَهُوَ ٱلَّذِي كَفَّ أَيۡدِيَهُمۡ عَنكُمۡ وَأَيۡدِيَكُمۡ عَنۡهُم بِبَطۡنِ مَكَّةَ مِنۢ بَعۡدِ أَنۡ أَظۡفَرَكُمۡ عَلَيۡهِمۡۚ وَكَانَ ٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرًا",
    "ayah_text_no_diacratic" : "وهو الذي كف ايديهم عنكم وايديكم عنهم ببطن مكة من بعد ان اظفركم عليهم وكان الله بما تعملون بصيرا",
    "ayahnumber" : "24",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4701",
    "page" : "514",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4702",
    "ayah_text" : "هُمُ ٱلَّذِينَ كَفَرُواْ وَصَدُّوكُمۡ عَنِ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ وَٱلۡهَدۡيَ مَعۡكُوفًا أَن يَبۡلُغَ مَحِلَّهُۥۚ وَلَوۡلَا رِجَالٞ مُّؤۡمِنُونَ وَنِسَآءٞ مُّؤۡمِنَٰتٞ لَّمۡ تَعۡلَمُوهُمۡ أَن تَطَـُٔوهُمۡ فَتُصِيبَكُم مِّنۡهُم مَّعَرَّةُۢ بِغَيۡرِ عِلۡمٖۖ لِّيُدۡخِلَ ٱللَّهُ فِي رَحۡمَتِهِۦ مَن يَشَآءُۚ لَوۡ تَزَيَّلُواْ لَعَذَّبۡنَا ٱلَّذِينَ كَفَرُواْ مِنۡهُمۡ عَذَابًا أَلِيمًا",
    "ayah_text_no_diacratic" : "هم الذين كفروا وصدوكم عن المسجد الحرام والهدي معكوفا ان يبلغ محله ولولا رجال مؤمنون ونساء مؤمنٰت لم تعلموهم ان تطوهم فتصيبكم منهم معرة بغير علم ليدخل الله في رحمته من يشاء لو تزيلوا لعذبنا الذين كفروا منهم عذابا اليما",
    "ayahnumber" : "25",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4702",
    "page" : "514",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4703",
    "ayah_text" : "إِذۡ جَعَلَ ٱلَّذِينَ كَفَرُواْ فِي قُلُوبِهِمُ ٱلۡحَمِيَّةَ حَمِيَّةَ ٱلۡجَٰهِلِيَّةِ فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلۡمُؤۡمِنِينَ وَأَلۡزَمَهُمۡ كَلِمَةَ ٱلتَّقۡوَىٰ وَكَانُوٓاْ أَحَقَّ بِهَا وَأَهۡلَهَاۚ وَكَانَ ٱللَّهُ بِكُلِّ شَيۡءٍ عَلِيمٗا",
    "ayah_text_no_diacratic" : "اذ جعل الذين كفروا في قلوبهم الحمية حمية الجٰهلية فانزل الله سكينته علىٰ رسوله وعلى المؤمنين والزمهم كلمة التقوىٰ وكانوا احق بها واهلها وكان الله بكل شيء عليما",
    "ayahnumber" : "26",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4703",
    "page" : "514",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4704",
    "ayah_text" : "لَّقَدۡ صَدَقَ ٱللَّهُ رَسُولَهُ ٱلرُّءۡيَا بِٱلۡحَقِّۖ لَتَدۡخُلُنَّ ٱلۡمَسۡجِدَ ٱلۡحَرَامَ إِن شَآءَ ٱللَّهُ ءَامِنِينَ مُحَلِّقِينَ رُءُوسَكُمۡ وَمُقَصِّرِينَ لَا تَخَافُونَۖ فَعَلِمَ مَا لَمۡ تَعۡلَمُواْ فَجَعَلَ مِن دُونِ ذَٰلِكَ فَتۡحٗا قَرِيبًا",
    "ayah_text_no_diacratic" : "لقد صدق الله رسوله الرءيا بالحق لتدخلن المسجد الحرام ان شاء الله ءامنين محلقين رءوسكم ومقصرين لا تخافون فعلم ما لم تعلموا فجعل من دون ذٰلك فتحا قريبا",
    "ayahnumber" : "27",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4704",
    "page" : "514",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4705",
    "ayah_text" : "هُوَ ٱلَّذِيٓ أَرۡسَلَ رَسُولَهُۥ بِٱلۡهُدَىٰ وَدِينِ ٱلۡحَقِّ لِيُظۡهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦۚ وَكَفَىٰ بِٱللَّهِ شَهِيدٗا",
    "ayah_text_no_diacratic" : "هو الذي ارسل رسوله بالهدىٰ ودين الحق ليظهره على الدين كله وكفىٰ بالله شهيدا",
    "ayahnumber" : "28",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4705",
    "page" : "514",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4706",
    "ayah_text" : "مُّحَمَّدٞ رَّسُولُ ٱللَّهِۚ وَٱلَّذِينَ مَعَهُۥٓ أَشِدَّآءُ عَلَى ٱلۡكُفَّارِ رُحَمَآءُ بَيۡنَهُمۡۖ تَرَىٰهُمۡ رُكَّعٗا سُجَّدٗا يَبۡتَغُونَ فَضۡلٗا مِّنَ ٱللَّهِ وَرِضۡوَٰنٗاۖ سِيمَاهُمۡ فِي وُجُوهِهِم مِّنۡ أَثَرِ ٱلسُّجُودِۚ ذَٰلِكَ مَثَلُهُمۡ فِي ٱلتَّوۡرَىٰةِۚ وَمَثَلُهُمۡ فِي ٱلۡإِنجِيلِ كَزَرۡعٍ أَخۡرَجَ شَطۡـَٔهُۥ فَـَٔازَرَهُۥ فَٱسۡتَغۡلَظَ فَٱسۡتَوَىٰ عَلَىٰ سُوقِهِۦ يُعۡجِبُ ٱلزُّرَّاعَ لِيَغِيظَ بِهِمُ ٱلۡكُفَّارَۗ وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ مِنۡهُم مَّغۡفِرَةٗ وَأَجۡرًا عَظِيمَۢا",
    "ayah_text_no_diacratic" : "محمد رسول الله والذين معه اشداء على الكفار رحماء بينهم ترىٰهم ركعا سجدا يبتغون فضلا من الله ورضوٰنا سيماهم في وجوههم من اثر السجود ذٰلك مثلهم في التورىٰة ومثلهم في الانجيل كزرع اخرج شطه فازره فاستغلظ فاستوىٰ علىٰ سوقه يعجب الزراع ليغيظ بهم الكفار وعد الله الذين ءامنوا وعملوا الصٰلحٰت منهم مغفرة واجرا عظيما",
    "ayahnumber" : "29",
    "chapter" : "26",
    "hizb" : "51",
