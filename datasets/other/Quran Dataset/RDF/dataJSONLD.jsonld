  }, {
    "@id" : "quran:3179",
    "ayah_text" : "أَوَلَمۡ يَكُن لَّهُمۡ ءَايَةً أَن يَعۡلَمَهُۥ عُلَمَٰٓؤُاْ بَنِيٓ إِسۡرَٰٓءِيلَ",
    "ayah_text_no_diacratic" : "اولم يكن لهم ءاية ان يعلمه علمٰؤا بني اسرٰءيل",
    "ayahnumber" : "197",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3179",
