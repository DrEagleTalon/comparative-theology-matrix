    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:388",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ بَعۡدَ إِيمَٰنِهِمۡ ثُمَّ ٱزۡدَادُواْ كُفۡرٗا لَّن تُقۡبَلَ تَوۡبَتُهُمۡ وَأُوْلَٰٓئِكَ هُمُ ٱلضَّآلُّونَ",
    "ayah_text_no_diacratic" : "ان الذين كفروا بعد ايمٰنهم ثم ازدادوا كفرا لن تقبل توبتهم واولٰئك هم الضالون",
