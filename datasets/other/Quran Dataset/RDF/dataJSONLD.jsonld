    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3016",
    "ayah_text" : "قَالَ لِلۡمَلَإِ حَوۡلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "قال للملا حوله ان هٰذا لسٰحر عليم",
