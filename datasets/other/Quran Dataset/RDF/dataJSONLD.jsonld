    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5768",
    "ayah_text" : "إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلۡعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمۡ يَوۡمٗا ثَقِيلٗا",
    "ayah_text_no_diacratic" : "ان هٰؤلاء يحبون العاجلة ويذرون وراءهم يوما ثقيلا",
    "ayahnumber" : "27",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5768",
