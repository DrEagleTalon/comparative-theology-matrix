    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4947",
    "ayah_text" : "أَفَمِنۡ هَٰذَا ٱلۡحَدِيثِ تَعۡجَبُونَ",
    "ayah_text_no_diacratic" : "افمن هٰذا الحديث تعجبون",
