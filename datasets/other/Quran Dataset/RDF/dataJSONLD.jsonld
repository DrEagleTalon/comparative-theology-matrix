  }, {
    "@id" : "quran:5539",
    "ayah_text" : "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ",
    "ayah_text_no_diacratic" : "والذين يصدقون بيوم الدين",
