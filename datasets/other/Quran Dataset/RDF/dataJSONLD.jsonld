    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4933",
    "ayah_text" : "وَأَنَّهُۥ خَلَقَ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ",
    "ayah_text_no_diacratic" : "وانه خلق الزوجين الذكر والانثىٰ",
