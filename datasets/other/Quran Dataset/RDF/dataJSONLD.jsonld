    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3411",
    "ayah_text" : "فَأَنجَيۡنَٰهُ وَأَصۡحَٰبَ ٱلسَّفِينَةِ وَجَعَلۡنَٰهَآ ءَايَةٗ لِّلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "فانجينٰه واصحٰب السفينة وجعلنٰها ءاية للعٰلمين",
    "ayahnumber" : "15",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3411",
    "page" : "398",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3412",
    "ayah_text" : "وَإِبۡرَٰهِيمَ إِذۡ قَالَ لِقَوۡمِهِ ٱعۡبُدُواْ ٱللَّهَ وَٱتَّقُوهُۖ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وابرٰهيم اذ قال لقومه اعبدوا الله واتقوه ذٰلكم خير لكم ان كنتم تعلمون",
    "ayahnumber" : "16",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3412",
    "page" : "398",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3413",
    "ayah_text" : "إِنَّمَا تَعۡبُدُونَ مِن دُونِ ٱللَّهِ أَوۡثَٰنٗا وَتَخۡلُقُونَ إِفۡكًاۚ إِنَّ ٱلَّذِينَ تَعۡبُدُونَ مِن دُونِ ٱللَّهِ لَا يَمۡلِكُونَ لَكُمۡ رِزۡقٗا فَٱبۡتَغُواْ عِندَ ٱللَّهِ ٱلرِّزۡقَ وَٱعۡبُدُوهُ وَٱشۡكُرُواْ لَهُۥٓۖ إِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "انما تعبدون من دون الله اوثٰنا وتخلقون افكا ان الذين تعبدون من دون الله لا يملكون لكم رزقا فابتغوا عند الله الرزق واعبدوه واشكروا له اليه ترجعون",
    "ayahnumber" : "17",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3413",
    "page" : "398",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3414",
    "ayah_text" : "وَإِن تُكَذِّبُواْ فَقَدۡ كَذَّبَ أُمَمٞ مِّن قَبۡلِكُمۡۖ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلۡبَلَٰغُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "وان تكذبوا فقد كذب امم من قبلكم وما على الرسول الا البلٰغ المبين",
    "ayahnumber" : "18",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3414",
    "page" : "398",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3415",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ كَيۡفَ يُبۡدِئُ ٱللَّهُ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥٓۚ إِنَّ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٞ",
    "ayah_text_no_diacratic" : "اولم يروا كيف يبدئ الله الخلق ثم يعيده ان ذٰلك على الله يسير",
    "ayahnumber" : "19",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3415",
    "page" : "398",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3416",
    "ayah_text" : "قُلۡ سِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ بَدَأَ ٱلۡخَلۡقَۚ ثُمَّ ٱللَّهُ يُنشِئُ ٱلنَّشۡأَةَ ٱلۡأٓخِرَةَۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "قل سيروا في الارض فانظروا كيف بدا الخلق ثم الله ينشئ النشاة الاخرة ان الله علىٰ كل شيء قدير",
    "ayahnumber" : "20",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3416",
    "page" : "398",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3417",
    "ayah_text" : "يُعَذِّبُ مَن يَشَآءُ وَيَرۡحَمُ مَن يَشَآءُۖ وَإِلَيۡهِ تُقۡلَبُونَ",
    "ayah_text_no_diacratic" : "يعذب من يشاء ويرحم من يشاء واليه تقلبون",
    "ayahnumber" : "21",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3417",
    "page" : "398",
    "surahname" : "سُورَةُ العَنكَبُوتِ",
    "surahnumber" : "29",
    "surrahname_no_diacratic" : "سورة العنكبوت"
  }, {
    "@id" : "quran:3418",
    "ayah_text" : "وَمَآ أَنتُم بِمُعۡجِزِينَ فِي ٱلۡأَرۡضِ وَلَا فِي ٱلسَّمَآءِۖ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِيّٖ وَلَا نَصِيرٖ",
    "ayah_text_no_diacratic" : "وما انتم بمعجزين في الارض ولا في السماء وما لكم من دون الله من ولي ولا نصير",
    "ayahnumber" : "22",
    "chapter" : "20",
    "hizb" : "39",
