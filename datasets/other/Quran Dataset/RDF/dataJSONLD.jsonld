    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2696",
    "ayah_text" : "لَيُدۡخِلَنَّهُم مُّدۡخَلٗا يَرۡضَوۡنَهُۥۚ وَإِنَّ ٱللَّهَ لَعَلِيمٌ حَلِيمٞ",
    "ayah_text_no_diacratic" : "ليدخلنهم مدخلا يرضونه وان الله لعليم حليم",
