  }, {
    "@id" : "quran:5239",
    "ayah_text" : "كَتَبَ ٱللَّهُ لَأَغۡلِبَنَّ أَنَا۠ وَرُسُلِيٓۚ إِنَّ ٱللَّهَ قَوِيٌّ عَزِيزٞ",
    "ayah_text_no_diacratic" : "كتب الله لاغلبن انا ورسلي ان الله قوي عزيز",
