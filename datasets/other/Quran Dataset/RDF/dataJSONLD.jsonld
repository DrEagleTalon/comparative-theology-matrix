    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2304",
    "ayah_text" : "قَالَتۡ إِنِّيٓ أَعُوذُ بِٱلرَّحۡمَٰنِ مِنكَ إِن كُنتَ تَقِيّٗا",
    "ayah_text_no_diacratic" : "قالت اني اعوذ بالرحمٰن منك ان كنت تقيا",
