    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3594",
    "ayah_text" : "قُلۡ يَوۡمَ ٱلۡفَتۡحِ لَا يَنفَعُ ٱلَّذِينَ كَفَرُوٓاْ إِيمَٰنُهُمۡ وَلَا هُمۡ يُنظَرُونَ",
    "ayah_text_no_diacratic" : "قل يوم الفتح لا ينفع الذين كفروا ايمٰنهم ولا هم ينظرون",
