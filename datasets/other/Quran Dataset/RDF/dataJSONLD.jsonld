  }, {
    "@id" : "quran:24",
    "ayah_text" : "وَإِذَا لَقُواْ ٱلَّذِينَ ءَامَنُواْ قَالُوٓاْ ءَامَنَّا وَإِذَا خَلَوۡاْ إِلَىٰ شَيَٰطِينِهِمۡ قَالُوٓاْ إِنَّا مَعَكُمۡ إِنَّمَا نَحۡنُ مُسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "واذا لقوا الذين ءامنوا قالوا ءامنا واذا خلوا الىٰ شيٰطينهم قالوا انا معكم انما نحن مستهزءون",
    "ayahnumber" : "14",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "24",
    "page" : "3",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:240",
    "ayah_text" : "فَإِن طَلَّقَهَا فَلَا تَحِلُّ لَهُۥ مِنۢ بَعۡدُ حَتَّىٰ تَنكِحَ زَوۡجًا غَيۡرَهُۥۗ فَإِن طَلَّقَهَا فَلَا جُنَاحَ عَلَيۡهِمَآ أَن يَتَرَاجَعَآ إِن ظَنَّآ أَن يُقِيمَا حُدُودَ ٱللَّهِۗ وَتِلۡكَ حُدُودُ ٱللَّهِ يُبَيِّنُهَا لِقَوۡمٖ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فان طلقها فلا تحل له من بعد حتىٰ تنكح زوجا غيره فان طلقها فلا جناح عليهما ان يتراجعا ان ظنا ان يقيما حدود الله وتلك حدود الله يبينها لقوم يعلمون",
    "ayahnumber" : "230",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "240",
    "page" : "36",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2400",
    "ayah_text" : "إِنَّنِيٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعۡبُدۡنِي وَأَقِمِ ٱلصَّلَوٰةَ لِذِكۡرِيٓ",
    "ayah_text_no_diacratic" : "انني انا الله لا الٰه الا انا فاعبدني واقم الصلوٰة لذكري",
    "ayahnumber" : "14",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2400",
    "page" : "313",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2401",
    "ayah_text" : "إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخۡفِيهَا لِتُجۡزَىٰ كُلُّ نَفۡسِۭ بِمَا تَسۡعَىٰ",
    "ayah_text_no_diacratic" : "ان الساعة ءاتية اكاد اخفيها لتجزىٰ كل نفس بما تسعىٰ",
    "ayahnumber" : "15",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2401",
    "page" : "313",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2402",
    "ayah_text" : "فَلَا يَصُدَّنَّكَ عَنۡهَا مَن لَّا يُؤۡمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرۡدَىٰ",
    "ayah_text_no_diacratic" : "فلا يصدنك عنها من لا يؤمن بها واتبع هوىٰه فتردىٰ",
    "ayahnumber" : "16",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2402",
    "page" : "313",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2403",
    "ayah_text" : "وَمَا تِلۡكَ بِيَمِينِكَ يَٰمُوسَىٰ",
    "ayah_text_no_diacratic" : "وما تلك بيمينك يٰموسىٰ",
    "ayahnumber" : "17",
