    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1497",
    "ayah_text" : "إِلَى ٱللَّهِ مَرۡجِعُكُمۡۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "ayah_text_no_diacratic" : "الى الله مرجعكم وهو علىٰ كل شيء قدير",
    "ayahnumber" : "4",
    "chapter" : "11",
    "hizb" : "22",
