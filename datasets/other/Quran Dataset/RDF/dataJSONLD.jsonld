    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3680",
    "ayah_text" : "أَفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَم بِهِۦ جِنَّةُۢۗ بَلِ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ فِي ٱلۡعَذَابِ وَٱلضَّلَٰلِ ٱلۡبَعِيدِ",
    "ayah_text_no_diacratic" : "افترىٰ على الله كذبا ام به جنة بل الذين لا يؤمنون بالاخرة في العذاب والضلٰل البعيد",
    "ayahnumber" : "8",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3680",
    "page" : "429",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3681",
    "ayah_text" : "أَفَلَمۡ يَرَوۡاْ إِلَىٰ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُم مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِۚ إِن نَّشَأۡ نَخۡسِفۡ بِهِمُ ٱلۡأَرۡضَ أَوۡ نُسۡقِطۡ عَلَيۡهِمۡ كِسَفٗا مِّنَ ٱلسَّمَآءِۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّكُلِّ عَبۡدٖ مُّنِيبٖ",
    "ayah_text_no_diacratic" : "افلم يروا الىٰ ما بين ايديهم وما خلفهم من السماء والارض ان نشا نخسف بهم الارض او نسقط عليهم كسفا من السماء ان في ذٰلك لاية لكل عبد منيب",
    "ayahnumber" : "9",
    "chapter" : "22",
    "hizb" : "42",
    "index" : "3681",
    "page" : "429",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3682",
    "ayah_text" : "۞وَلَقَدۡ ءَاتَيۡنَا دَاوُۥدَ مِنَّا فَضۡلٗاۖ يَٰجِبَالُ أَوِّبِي مَعَهُۥ وَٱلطَّيۡرَۖ وَأَلَنَّا لَهُ ٱلۡحَدِيدَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا داود منا فضلا يٰجبال اوبي معه والطير والنا له الحديد",
    "ayahnumber" : "10",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3682",
    "page" : "429",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3683",
    "ayah_text" : "أَنِ ٱعۡمَلۡ سَٰبِغَٰتٖ وَقَدِّرۡ فِي ٱلسَّرۡدِۖ وَٱعۡمَلُواْ صَٰلِحًاۖ إِنِّي بِمَا تَعۡمَلُونَ بَصِيرٞ",
    "ayah_text_no_diacratic" : "ان اعمل سٰبغٰت وقدر في السرد واعملوا صٰلحا اني بما تعملون بصير",
    "ayahnumber" : "11",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3683",
    "page" : "429",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3684",
    "ayah_text" : "وَلِسُلَيۡمَٰنَ ٱلرِّيحَ غُدُوُّهَا شَهۡرٞ وَرَوَاحُهَا شَهۡرٞۖ وَأَسَلۡنَا لَهُۥ عَيۡنَ ٱلۡقِطۡرِۖ وَمِنَ ٱلۡجِنِّ مَن يَعۡمَلُ بَيۡنَ يَدَيۡهِ بِإِذۡنِ رَبِّهِۦۖ وَمَن يَزِغۡ مِنۡهُمۡ عَنۡ أَمۡرِنَا نُذِقۡهُ مِنۡ عَذَابِ ٱلسَّعِيرِ",
    "ayah_text_no_diacratic" : "ولسليمٰن الريح غدوها شهر ورواحها شهر واسلنا له عين القطر ومن الجن من يعمل بين يديه باذن ربه ومن يزغ منهم عن امرنا نذقه من عذاب السعير",
    "ayahnumber" : "12",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3684",
    "page" : "429",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3685",
    "ayah_text" : "يَعۡمَلُونَ لَهُۥ مَا يَشَآءُ مِن مَّحَٰرِيبَ وَتَمَٰثِيلَ وَجِفَانٖ كَٱلۡجَوَابِ وَقُدُورٖ رَّاسِيَٰتٍۚ ٱعۡمَلُوٓاْ ءَالَ دَاوُۥدَ شُكۡرٗاۚ وَقَلِيلٞ مِّنۡ عِبَادِيَ ٱلشَّكُورُ",
    "ayah_text_no_diacratic" : "يعملون له ما يشاء من محٰريب وتمٰثيل وجفان كالجواب وقدور راسيٰت اعملوا ءال داود شكرا وقليل من عبادي الشكور",
    "ayahnumber" : "13",
    "chapter" : "22",
    "hizb" : "43",
