    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:438",
    "ayah_text" : "إِن يَمۡسَسۡكُمۡ قَرۡحٞ فَقَدۡ مَسَّ ٱلۡقَوۡمَ قَرۡحٞ مِّثۡلُهُۥۚ وَتِلۡكَ ٱلۡأَيَّامُ نُدَاوِلُهَا بَيۡنَ ٱلنَّاسِ وَلِيَعۡلَمَ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ وَيَتَّخِذَ مِنكُمۡ شُهَدَآءَۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ان يمسسكم قرح فقد مس القوم قرح مثله وتلك الايام نداولها بين الناس وليعلم الله الذين ءامنوا ويتخذ منكم شهداء والله لا يحب الظٰلمين",
    "ayahnumber" : "140",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "438",
    "page" : "67",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4380",
    "ayah_text" : "وَيَسۡتَجِيبُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَيَزِيدُهُم مِّن فَضۡلِهِۦۚ وَٱلۡكَٰفِرُونَ لَهُمۡ عَذَابٞ شَدِيدٞ",
    "ayah_text_no_diacratic" : "ويستجيب الذين ءامنوا وعملوا الصٰلحٰت ويزيدهم من فضله والكٰفرون لهم عذاب شديد",
    "ayahnumber" : "26",
