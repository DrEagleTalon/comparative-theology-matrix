    "surrahname_no_diacratic" : "سورة الاحقاف"
  }, {
    "@id" : "quran:461",
    "ayah_text" : "هُمۡ دَرَجَٰتٌ عِندَ ٱللَّهِۗ وَٱللَّهُ بَصِيرُۢ بِمَا يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "هم درجٰت عند الله والله بصير بما يعملون",
    "ayahnumber" : "163",
    "chapter" : "4",
    "hizb" : "7",
