    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3266",
    "ayah_text" : "أَئِنَّكُمۡ لَتَأۡتُونَ ٱلرِّجَالَ شَهۡوَةٗ مِّن دُونِ ٱلنِّسَآءِۚ بَلۡ أَنتُمۡ قَوۡمٞ تَجۡهَلُونَ",
    "ayah_text_no_diacratic" : "ائنكم لتاتون الرجال شهوة من دون النساء بل انتم قوم تجهلون",
    "ayahnumber" : "55",
    "chapter" : "19",
    "hizb" : "38",
