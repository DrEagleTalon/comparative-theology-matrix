    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5540",
    "ayah_text" : "وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ",
    "ayah_text_no_diacratic" : "والذين هم من عذاب ربهم مشفقون",
