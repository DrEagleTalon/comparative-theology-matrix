    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3162",
    "ayah_text" : "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "وما اسلكم عليه من اجر ان اجري الا علىٰ رب العٰلمين",
    "ayahnumber" : "180",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3162",
    "page" : "374",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3163",
    "ayah_text" : "۞أَوۡفُواْ ٱلۡكَيۡلَ وَلَا تَكُونُواْ مِنَ ٱلۡمُخۡسِرِينَ",
    "ayah_text_no_diacratic" : "اوفوا الكيل ولا تكونوا من المخسرين",
    "ayahnumber" : "181",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3163",
    "page" : "374",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3164",
    "ayah_text" : "وَزِنُواْ بِٱلۡقِسۡطَاسِ ٱلۡمُسۡتَقِيمِ",
    "ayah_text_no_diacratic" : "وزنوا بالقسطاس المستقيم",
    "ayahnumber" : "182",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3164",
    "page" : "374",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3165",
    "ayah_text" : "وَلَا تَبۡخَسُواْ ٱلنَّاسَ أَشۡيَآءَهُمۡ وَلَا تَعۡثَوۡاْ فِي ٱلۡأَرۡضِ مُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "ولا تبخسوا الناس اشياءهم ولا تعثوا في الارض مفسدين",
