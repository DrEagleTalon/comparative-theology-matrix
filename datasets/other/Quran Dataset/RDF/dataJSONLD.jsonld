    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5188",
    "ayah_text" : "سَبَّحَ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "سبح لله ما في السمٰوٰت والارض وهو العزيز الحكيم",
    "ayahnumber" : "1",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5188",
    "page" : "537",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5189",
    "ayah_text" : "لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ يُحۡيِۦ وَيُمِيتُۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "ayah_text_no_diacratic" : "له ملك السمٰوٰت والارض يحي ويميت وهو علىٰ كل شيء قدير",
    "ayahnumber" : "2",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5189",
    "page" : "537",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:519",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا يَحِلُّ لَكُمۡ أَن تَرِثُواْ ٱلنِّسَآءَ كَرۡهٗاۖ وَلَا تَعۡضُلُوهُنَّ لِتَذۡهَبُواْ بِبَعۡضِ مَآ ءَاتَيۡتُمُوهُنَّ إِلَّآ أَن يَأۡتِينَ بِفَٰحِشَةٖ مُّبَيِّنَةٖۚ وَعَاشِرُوهُنَّ بِٱلۡمَعۡرُوفِۚ فَإِن كَرِهۡتُمُوهُنَّ فَعَسَىٰٓ أَن تَكۡرَهُواْ شَيۡـٔٗا وَيَجۡعَلَ ٱللَّهُ فِيهِ خَيۡرٗا كَثِيرٗا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا يحل لكم ان ترثوا النساء كرها ولا تعضلوهن لتذهبوا ببعض ما ءاتيتموهن الا ان ياتين بفٰحشة مبينة وعاشروهن بالمعروف فان كرهتموهن فعسىٰ ان تكرهوا شيا ويجعل الله فيه خيرا كثيرا",
    "ayahnumber" : "19",
    "chapter" : "4",
    "hizb" : "8",
    "index" : "519",
    "page" : "80",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5190",
    "ayah_text" : "هُوَ ٱلۡأَوَّلُ وَٱلۡأٓخِرُ وَٱلظَّٰهِرُ وَٱلۡبَاطِنُۖ وَهُوَ بِكُلِّ شَيۡءٍ عَلِيمٌ",
    "ayah_text_no_diacratic" : "هو الاول والاخر والظٰهر والباطن وهو بكل شيء عليم",
    "ayahnumber" : "3",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5190",
    "page" : "537",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5191",
    "ayah_text" : "هُوَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ يَعۡلَمُ مَا يَلِجُ فِي ٱلۡأَرۡضِ وَمَا يَخۡرُجُ مِنۡهَا وَمَا يَنزِلُ مِنَ ٱلسَّمَآءِ وَمَا يَعۡرُجُ فِيهَاۖ وَهُوَ مَعَكُمۡ أَيۡنَ مَا كُنتُمۡۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرٞ",
    "ayah_text_no_diacratic" : "هو الذي خلق السمٰوٰت والارض في ستة ايام ثم استوىٰ على العرش يعلم ما يلج في الارض وما يخرج منها وما ينزل من السماء وما يعرج فيها وهو معكم اين ما كنتم والله بما تعملون بصير",
    "ayahnumber" : "4",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5191",
    "page" : "538",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5192",
    "ayah_text" : "لَّهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ",
    "ayah_text_no_diacratic" : "له ملك السمٰوٰت والارض والى الله ترجع الامور",
    "ayahnumber" : "5",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5192",
    "page" : "538",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5193",
    "ayah_text" : "يُولِجُ ٱلَّيۡلَ فِي ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِي ٱلَّيۡلِۚ وَهُوَ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "يولج اليل في النهار ويولج النهار في اليل وهو عليم بذات الصدور",
    "ayahnumber" : "6",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5193",
    "page" : "538",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5194",
    "ayah_text" : "ءَامِنُواْ بِٱللَّهِ وَرَسُولِهِۦ وَأَنفِقُواْ مِمَّا جَعَلَكُم مُّسۡتَخۡلَفِينَ فِيهِۖ فَٱلَّذِينَ ءَامَنُواْ مِنكُمۡ وَأَنفَقُواْ لَهُمۡ أَجۡرٞ كَبِيرٞ",
    "ayah_text_no_diacratic" : "ءامنوا بالله ورسوله وانفقوا مما جعلكم مستخلفين فيه فالذين ءامنوا منكم وانفقوا لهم اجر كبير",
    "ayahnumber" : "7",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5194",
    "page" : "538",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5195",
    "ayah_text" : "وَمَا لَكُمۡ لَا تُؤۡمِنُونَ بِٱللَّهِ وَٱلرَّسُولُ يَدۡعُوكُمۡ لِتُؤۡمِنُواْ بِرَبِّكُمۡ وَقَدۡ أَخَذَ مِيثَٰقَكُمۡ إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وما لكم لا تؤمنون بالله والرسول يدعوكم لتؤمنوا بربكم وقد اخذ ميثٰقكم ان كنتم مؤمنين",
    "ayahnumber" : "8",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5195",
    "page" : "538",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5196",
    "ayah_text" : "هُوَ ٱلَّذِي يُنَزِّلُ عَلَىٰ عَبۡدِهِۦٓ ءَايَٰتِۭ بَيِّنَٰتٖ لِّيُخۡرِجَكُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۚ وَإِنَّ ٱللَّهَ بِكُمۡ لَرَءُوفٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "هو الذي ينزل علىٰ عبده ءايٰت بينٰت ليخرجكم من الظلمٰت الى النور وان الله بكم لرءوف رحيم",
    "ayahnumber" : "9",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5196",
    "page" : "538",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5197",
    "ayah_text" : "وَمَا لَكُمۡ أَلَّا تُنفِقُواْ فِي سَبِيلِ ٱللَّهِ وَلِلَّهِ مِيرَٰثُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ لَا يَسۡتَوِي مِنكُم مَّنۡ أَنفَقَ مِن قَبۡلِ ٱلۡفَتۡحِ وَقَٰتَلَۚ أُوْلَٰٓئِكَ أَعۡظَمُ دَرَجَةٗ مِّنَ ٱلَّذِينَ أَنفَقُواْ مِنۢ بَعۡدُ وَقَٰتَلُواْۚ وَكُلّٗا وَعَدَ ٱللَّهُ ٱلۡحُسۡنَىٰۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ",
    "ayah_text_no_diacratic" : "وما لكم الا تنفقوا في سبيل الله ولله ميرٰث السمٰوٰت والارض لا يستوي منكم من انفق من قبل الفتح وقٰتل اولٰئك اعظم درجة من الذين انفقوا من بعد وقٰتلوا وكلا وعد الله الحسنىٰ والله بما تعملون خبير",
    "ayahnumber" : "10",
    "chapter" : "27",
    "hizb" : "53",
    "index" : "5197",
    "page" : "538",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5198",
    "ayah_text" : "مَّن ذَا ٱلَّذِي يُقۡرِضُ ٱللَّهَ قَرۡضًا حَسَنٗا فَيُضَٰعِفَهُۥ لَهُۥ وَلَهُۥٓ أَجۡرٞ كَرِيمٞ",
    "ayah_text_no_diacratic" : "من ذا الذي يقرض الله قرضا حسنا فيضٰعفه له وله اجر كريم",
    "ayahnumber" : "11",
