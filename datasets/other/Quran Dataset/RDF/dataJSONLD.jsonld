    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4807",
    "ayah_text" : "قَالُوٓاْ إِنَّآ أُرۡسِلۡنَآ إِلَىٰ قَوۡمٖ مُّجۡرِمِينَ",
    "ayah_text_no_diacratic" : "قالوا انا ارسلنا الىٰ قوم مجرمين",
    "ayahnumber" : "32",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4807",
