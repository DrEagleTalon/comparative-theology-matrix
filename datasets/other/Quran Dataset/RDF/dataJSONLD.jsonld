  }, {
    "@id" : "quran:6190",
    "ayah_text" : "كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا",
    "ayah_text_no_diacratic" : "كلا اذا دكت الارض دكا دكا",
