    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:4036",
    "ayah_text" : "أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ",
    "ayah_text_no_diacratic" : "افبعذابنا يستعجلون",
