    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1283",
    "ayah_text" : "يُرِيدُونَ أَن يُطۡفِـُٔواْ نُورَ ٱللَّهِ بِأَفۡوَٰهِهِمۡ وَيَأۡبَى ٱللَّهُ إِلَّآ أَن يُتِمَّ نُورَهُۥ وَلَوۡ كَرِهَ ٱلۡكَٰفِرُونَ",
    "ayah_text_no_diacratic" : "يريدون ان يطفوا نور الله بافوٰههم ويابى الله الا ان يتم نوره ولو كره الكٰفرون",
    "ayahnumber" : "32",
    "chapter" : "10",
