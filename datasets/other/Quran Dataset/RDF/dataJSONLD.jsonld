    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:261",
    "ayah_text" : "فَهَزَمُوهُم بِإِذۡنِ ٱللَّهِ وَقَتَلَ دَاوُۥدُ جَالُوتَ وَءَاتَىٰهُ ٱللَّهُ ٱلۡمُلۡكَ وَٱلۡحِكۡمَةَ وَعَلَّمَهُۥ مِمَّا يَشَآءُۗ وَلَوۡلَا دَفۡعُ ٱللَّهِ ٱلنَّاسَ بَعۡضَهُم بِبَعۡضٖ لَّفَسَدَتِ ٱلۡأَرۡضُ وَلَٰكِنَّ ٱللَّهَ ذُو فَضۡلٍ عَلَى ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "فهزموهم باذن الله وقتل داود جالوت وءاتىٰه الله الملك والحكمة وعلمه مما يشاء ولولا دفع الله الناس بعضهم ببعض لفسدت الارض ولٰكن الله ذو فضل على العٰلمين",
    "ayahnumber" : "251",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "261",
    "page" : "41",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2610",
    "ayah_text" : "وَذَا ٱلنُّونِ إِذ ذَّهَبَ مُغَٰضِبٗا فَظَنَّ أَن لَّن نَّقۡدِرَ عَلَيۡهِ فَنَادَىٰ فِي ٱلظُّلُمَٰتِ أَن لَّآ إِلَٰهَ إِلَّآ أَنتَ سُبۡحَٰنَكَ إِنِّي كُنتُ مِنَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "وذا النون اذ ذهب مغٰضبا فظن ان لن نقدر عليه فنادىٰ في الظلمٰت ان لا الٰه الا انت سبحٰنك اني كنت من الظٰلمين",
    "ayahnumber" : "87",
