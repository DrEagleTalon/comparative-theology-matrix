    "hizb" : "6",
    "index" : "437",
    "page" : "67",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4370",
    "ayah_text" : "وَٱلَّذِينَ يُحَآجُّونَ فِي ٱللَّهِ مِنۢ بَعۡدِ مَا ٱسۡتُجِيبَ لَهُۥ حُجَّتُهُمۡ دَاحِضَةٌ عِندَ رَبِّهِمۡ وَعَلَيۡهِمۡ غَضَبٞ وَلَهُمۡ عَذَابٞ شَدِيدٌ",
    "ayah_text_no_diacratic" : "والذين يحاجون في الله من بعد ما استجيب له حجتهم داحضة عند ربهم وعليهم غضب ولهم عذاب شديد",
    "ayahnumber" : "16",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4370",
    "page" : "485",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4371",
    "ayah_text" : "ٱللَّهُ ٱلَّذِيٓ أَنزَلَ ٱلۡكِتَٰبَ بِٱلۡحَقِّ وَٱلۡمِيزَانَۗ وَمَا يُدۡرِيكَ لَعَلَّ ٱلسَّاعَةَ قَرِيبٞ",
    "ayah_text_no_diacratic" : "الله الذي انزل الكتٰب بالحق والميزان وما يدريك لعل الساعة قريب",
    "ayahnumber" : "17",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4371",
    "page" : "485",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4372",
    "ayah_text" : "يَسۡتَعۡجِلُ بِهَا ٱلَّذِينَ لَا يُؤۡمِنُونَ بِهَاۖ وَٱلَّذِينَ ءَامَنُواْ مُشۡفِقُونَ مِنۡهَا وَيَعۡلَمُونَ أَنَّهَا ٱلۡحَقُّۗ أَلَآ إِنَّ ٱلَّذِينَ يُمَارُونَ فِي ٱلسَّاعَةِ لَفِي ضَلَٰلِۭ بَعِيدٍ",
    "ayah_text_no_diacratic" : "يستعجل بها الذين لا يؤمنون بها والذين ءامنوا مشفقون منها ويعلمون انها الحق الا ان الذين يمارون في الساعة لفي ضلٰل بعيد",
    "ayahnumber" : "18",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4372",
    "page" : "485",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4373",
    "ayah_text" : "ٱللَّهُ لَطِيفُۢ بِعِبَادِهِۦ يَرۡزُقُ مَن يَشَآءُۖ وَهُوَ ٱلۡقَوِيُّ ٱلۡعَزِيزُ",
    "ayah_text_no_diacratic" : "الله لطيف بعباده يرزق من يشاء وهو القوي العزيز",
    "ayahnumber" : "19",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4373",
    "page" : "485",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4374",
    "ayah_text" : "مَن كَانَ يُرِيدُ حَرۡثَ ٱلۡأٓخِرَةِ نَزِدۡ لَهُۥ فِي حَرۡثِهِۦۖ وَمَن كَانَ يُرِيدُ حَرۡثَ ٱلدُّنۡيَا نُؤۡتِهِۦ مِنۡهَا وَمَا لَهُۥ فِي ٱلۡأٓخِرَةِ مِن نَّصِيبٍ",
    "ayah_text_no_diacratic" : "من كان يريد حرث الاخرة نزد له في حرثه ومن كان يريد حرث الدنيا نؤته منها وما له في الاخرة من نصيب",
    "ayahnumber" : "20",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4374",
    "page" : "485",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4375",
    "ayah_text" : "أَمۡ لَهُمۡ شُرَكَٰٓؤُاْ شَرَعُواْ لَهُم مِّنَ ٱلدِّينِ مَا لَمۡ يَأۡذَنۢ بِهِ ٱللَّهُۚ وَلَوۡلَا كَلِمَةُ ٱلۡفَصۡلِ لَقُضِيَ بَيۡنَهُمۡۗ وَإِنَّ ٱلظَّٰلِمِينَ لَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "ام لهم شركٰؤا شرعوا لهم من الدين ما لم ياذن به الله ولولا كلمة الفصل لقضي بينهم وان الظٰلمين لهم عذاب اليم",
    "ayahnumber" : "21",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4375",
    "page" : "485",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4376",
    "ayah_text" : "تَرَى ٱلظَّٰلِمِينَ مُشۡفِقِينَ مِمَّا كَسَبُواْ وَهُوَ وَاقِعُۢ بِهِمۡۗ وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فِي رَوۡضَاتِ ٱلۡجَنَّاتِۖ لَهُم مَّا يَشَآءُونَ عِندَ رَبِّهِمۡۚ ذَٰلِكَ هُوَ ٱلۡفَضۡلُ ٱلۡكَبِيرُ",
    "ayah_text_no_diacratic" : "ترى الظٰلمين مشفقين مما كسبوا وهو واقع بهم والذين ءامنوا وعملوا الصٰلحٰت في روضات الجنات لهم ما يشاءون عند ربهم ذٰلك هو الفضل الكبير",
    "ayahnumber" : "22",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4376",
    "page" : "485",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4377",
    "ayah_text" : "ذَٰلِكَ ٱلَّذِي يُبَشِّرُ ٱللَّهُ عِبَادَهُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِۗ قُل لَّآ أَسۡـَٔلُكُمۡ عَلَيۡهِ أَجۡرًا إِلَّا ٱلۡمَوَدَّةَ فِي ٱلۡقُرۡبَىٰۗ وَمَن يَقۡتَرِفۡ حَسَنَةٗ نَّزِدۡ لَهُۥ فِيهَا حُسۡنًاۚ إِنَّ ٱللَّهَ غَفُورٞ شَكُورٌ",
    "ayah_text_no_diacratic" : "ذٰلك الذي يبشر الله عباده الذين ءامنوا وعملوا الصٰلحٰت قل لا اسلكم عليه اجرا الا المودة في القربىٰ ومن يقترف حسنة نزد له فيها حسنا ان الله غفور شكور",
    "ayahnumber" : "23",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4377",
    "page" : "486",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4378",
    "ayah_text" : "أَمۡ يَقُولُونَ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبٗاۖ فَإِن يَشَإِ ٱللَّهُ يَخۡتِمۡ عَلَىٰ قَلۡبِكَۗ وَيَمۡحُ ٱللَّهُ ٱلۡبَٰطِلَ وَيُحِقُّ ٱلۡحَقَّ بِكَلِمَٰتِهِۦٓۚ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "ام يقولون افترىٰ على الله كذبا فان يشا الله يختم علىٰ قلبك ويمح الله البٰطل ويحق الحق بكلمٰته انه عليم بذات الصدور",
    "ayahnumber" : "24",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4378",
    "page" : "486",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4379",
    "ayah_text" : "وَهُوَ ٱلَّذِي يَقۡبَلُ ٱلتَّوۡبَةَ عَنۡ عِبَادِهِۦ وَيَعۡفُواْ عَنِ ٱلسَّيِّـَٔاتِ وَيَعۡلَمُ مَا تَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "وهو الذي يقبل التوبة عن عباده ويعفوا عن السيات ويعلم ما تفعلون",
    "ayahnumber" : "25",
    "chapter" : "25",
    "hizb" : "48",
