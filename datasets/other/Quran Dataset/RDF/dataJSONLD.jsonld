    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4127",
    "ayah_text" : "إِلَّا عِبَادَكَ مِنۡهُمُ ٱلۡمُخۡلَصِينَ",
    "ayah_text_no_diacratic" : "الا عبادك منهم المخلصين",
    "ayahnumber" : "83",
