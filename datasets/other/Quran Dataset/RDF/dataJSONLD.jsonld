    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:368",
    "ayah_text" : "يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لِمَ تَكۡفُرُونَ بِـَٔايَٰتِ ٱللَّهِ وَأَنتُمۡ تَشۡهَدُونَ",
    "ayah_text_no_diacratic" : "يٰاهل الكتٰب لم تكفرون بايٰت الله وانتم تشهدون",
