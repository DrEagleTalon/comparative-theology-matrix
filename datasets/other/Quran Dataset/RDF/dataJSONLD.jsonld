    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:273",
    "ayah_text" : "۞قَوۡلٞ مَّعۡرُوفٞ وَمَغۡفِرَةٌ خَيۡرٞ مِّن صَدَقَةٖ يَتۡبَعُهَآ أَذٗىۗ وَٱللَّهُ غَنِيٌّ حَلِيمٞ",
    "ayah_text_no_diacratic" : "قول معروف ومغفرة خير من صدقة يتبعها اذى والله غني حليم",
    "ayahnumber" : "263",
