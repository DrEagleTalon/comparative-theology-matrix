  }, {
    "@id" : "quran:1108",
    "ayah_text" : "وَإِذۡ أَنجَيۡنَٰكُم مِّنۡ ءَالِ فِرۡعَوۡنَ يَسُومُونَكُمۡ سُوٓءَ ٱلۡعَذَابِ يُقَتِّلُونَ أَبۡنَآءَكُمۡ وَيَسۡتَحۡيُونَ نِسَآءَكُمۡۚ وَفِي ذَٰلِكُم بَلَآءٞ مِّن رَّبِّكُمۡ عَظِيمٞ",
    "ayah_text_no_diacratic" : "واذ انجينٰكم من ءال فرعون يسومونكم سوء العذاب يقتلون ابناءكم ويستحيون نساءكم وفي ذٰلكم بلاء من ربكم عظيم",
    "ayahnumber" : "141",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1108",
