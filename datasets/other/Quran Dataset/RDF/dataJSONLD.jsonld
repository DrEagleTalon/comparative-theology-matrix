    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3263",
    "ayah_text" : "فَتِلۡكَ بُيُوتُهُمۡ خَاوِيَةَۢ بِمَا ظَلَمُوٓاْۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فتلك بيوتهم خاوية بما ظلموا ان في ذٰلك لاية لقوم يعلمون",
    "ayahnumber" : "52",
    "chapter" : "19",
    "hizb" : "38",
