    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:287",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَأَقَامُواْ ٱلصَّلَوٰةَ وَءَاتَوُاْ ٱلزَّكَوٰةَ لَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت واقاموا الصلوٰة وءاتوا الزكوٰة لهم اجرهم عند ربهم ولا خوف عليهم ولا هم يحزنون",
    "ayahnumber" : "277",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "287",
    "page" : "47",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2870",
    "ayah_text" : "وَلۡيَسۡتَعۡفِفِ ٱلَّذِينَ لَا يَجِدُونَ نِكَاحًا حَتَّىٰ يُغۡنِيَهُمُ ٱللَّهُ مِن فَضۡلِهِۦۗ وَٱلَّذِينَ يَبۡتَغُونَ ٱلۡكِتَٰبَ مِمَّا مَلَكَتۡ أَيۡمَٰنُكُمۡ فَكَاتِبُوهُمۡ إِنۡ عَلِمۡتُمۡ فِيهِمۡ خَيۡرٗاۖ وَءَاتُوهُم مِّن مَّالِ ٱللَّهِ ٱلَّذِيٓ ءَاتَىٰكُمۡۚ وَلَا تُكۡرِهُواْ فَتَيَٰتِكُمۡ عَلَى ٱلۡبِغَآءِ إِنۡ أَرَدۡنَ تَحَصُّنٗا لِّتَبۡتَغُواْ عَرَضَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَمَن يُكۡرِههُّنَّ فَإِنَّ ٱللَّهَ مِنۢ بَعۡدِ إِكۡرَٰهِهِنَّ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "وليستعفف الذين لا يجدون نكاحا حتىٰ يغنيهم الله من فضله والذين يبتغون الكتٰب مما ملكت ايمٰنكم فكاتبوهم ان علمتم فيهم خيرا وءاتوهم من مال الله الذي ءاتىٰكم ولا تكرهوا فتيٰتكم على البغاء ان اردن تحصنا لتبتغوا عرض الحيوٰة الدنيا ومن يكرههن فان الله من بعد اكرٰههن غفور رحيم",
    "ayahnumber" : "33",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2870",
    "page" : "354",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2871",
    "ayah_text" : "وَلَقَدۡ أَنزَلۡنَآ إِلَيۡكُمۡ ءَايَٰتٖ مُّبَيِّنَٰتٖ وَمَثَلٗا مِّنَ ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلِكُمۡ وَمَوۡعِظَةٗ لِّلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "ولقد انزلنا اليكم ءايٰت مبينٰت ومثلا من الذين خلوا من قبلكم وموعظة للمتقين",
    "ayahnumber" : "34",
    "chapter" : "18",
    "hizb" : "35",
