    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3005",
    "ayah_text" : "قَالَ فِرۡعَوۡنُ وَمَا رَبُّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "قال فرعون وما رب العٰلمين",
