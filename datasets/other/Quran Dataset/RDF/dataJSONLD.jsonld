  }, {
    "@id" : "quran:2308",
    "ayah_text" : "۞فَحَمَلَتۡهُ فَٱنتَبَذَتۡ بِهِۦ مَكَانٗا قَصِيّٗا",
    "ayah_text_no_diacratic" : "فحملته فانتبذت به مكانا قصيا",
