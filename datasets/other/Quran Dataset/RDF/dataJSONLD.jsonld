    "page" : "190",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1278",
    "ayah_text" : "ثُمَّ يَتُوبُ ٱللَّهُ مِنۢ بَعۡدِ ذَٰلِكَ عَلَىٰ مَن يَشَآءُۗ وَٱللَّهُ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "ثم يتوب الله من بعد ذٰلك علىٰ من يشاء والله غفور رحيم",
    "ayahnumber" : "27",
    "chapter" : "10",
    "hizb" : "19",
