    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:820",
    "ayah_text" : "ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَعۡرِفُونَهُۥ كَمَا يَعۡرِفُونَ أَبۡنَآءَهُمُۘ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ فَهُمۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "الذين ءاتينٰهم الكتٰب يعرفونه كما يعرفون ابناءهم الذين خسروا انفسهم فهم لا يؤمنون",
    "ayahnumber" : "20",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "820",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:821",
    "ayah_text" : "وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوۡ كَذَّبَ بِـَٔايَٰتِهِۦٓۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "ومن اظلم ممن افترىٰ على الله كذبا او كذب بايٰته انه لا يفلح الظٰلمون",
    "ayahnumber" : "21",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "821",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:822",
    "ayah_text" : "وَيَوۡمَ نَحۡشُرُهُمۡ جَمِيعٗا ثُمَّ نَقُولُ لِلَّذِينَ أَشۡرَكُوٓاْ أَيۡنَ شُرَكَآؤُكُمُ ٱلَّذِينَ كُنتُمۡ تَزۡعُمُونَ",
    "ayah_text_no_diacratic" : "ويوم نحشرهم جميعا ثم نقول للذين اشركوا اين شركاؤكم الذين كنتم تزعمون",
    "ayahnumber" : "22",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "822",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:823",
    "ayah_text" : "ثُمَّ لَمۡ تَكُن فِتۡنَتُهُمۡ إِلَّآ أَن قَالُواْ وَٱللَّهِ رَبِّنَا مَا كُنَّا مُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "ثم لم تكن فتنتهم الا ان قالوا والله ربنا ما كنا مشركين",
    "ayahnumber" : "23",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "823",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:824",
    "ayah_text" : "ٱنظُرۡ كَيۡفَ كَذَبُواْ عَلَىٰٓ أَنفُسِهِمۡۚ وَضَلَّ عَنۡهُم مَّا كَانُواْ يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "انظر كيف كذبوا علىٰ انفسهم وضل عنهم ما كانوا يفترون",
    "ayahnumber" : "24",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "824",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:825",
    "ayah_text" : "وَمِنۡهُم مَّن يَسۡتَمِعُ إِلَيۡكَۖ وَجَعَلۡنَا عَلَىٰ قُلُوبِهِمۡ أَكِنَّةً أَن يَفۡقَهُوهُ وَفِيٓ ءَاذَانِهِمۡ وَقۡرٗاۚ وَإِن يَرَوۡاْ كُلَّ ءَايَةٖ لَّا يُؤۡمِنُواْ بِهَاۖ حَتَّىٰٓ إِذَا جَآءُوكَ يُجَٰدِلُونَكَ يَقُولُ ٱلَّذِينَ كَفَرُوٓاْ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "ومنهم من يستمع اليك وجعلنا علىٰ قلوبهم اكنة ان يفقهوه وفي ءاذانهم وقرا وان يروا كل ءاية لا يؤمنوا بها حتىٰ اذا جاءوك يجٰدلونك يقول الذين كفروا ان هٰذا الا اسٰطير الاولين",
    "ayahnumber" : "25",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "825",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:826",
    "ayah_text" : "وَهُمۡ يَنۡهَوۡنَ عَنۡهُ وَيَنۡـَٔوۡنَ عَنۡهُۖ وَإِن يُهۡلِكُونَ إِلَّآ أَنفُسَهُمۡ وَمَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "وهم ينهون عنه وينون عنه وان يهلكون الا انفسهم وما يشعرون",
    "ayahnumber" : "26",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "826",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:827",
    "ayah_text" : "وَلَوۡ تَرَىٰٓ إِذۡ وُقِفُواْ عَلَى ٱلنَّارِ فَقَالُواْ يَٰلَيۡتَنَا نُرَدُّ وَلَا نُكَذِّبَ بِـَٔايَٰتِ رَبِّنَا وَنَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ولو ترىٰ اذ وقفوا على النار فقالوا يٰليتنا نرد ولا نكذب بايٰت ربنا ونكون من المؤمنين",
    "ayahnumber" : "27",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "827",
    "page" : "130",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:828",
    "ayah_text" : "بَلۡ بَدَا لَهُم مَّا كَانُواْ يُخۡفُونَ مِن قَبۡلُۖ وَلَوۡ رُدُّواْ لَعَادُواْ لِمَا نُهُواْ عَنۡهُ وَإِنَّهُمۡ لَكَٰذِبُونَ",
    "ayah_text_no_diacratic" : "بل بدا لهم ما كانوا يخفون من قبل ولو ردوا لعادوا لما نهوا عنه وانهم لكٰذبون",
    "ayahnumber" : "28",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "828",
    "page" : "131",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:829",
    "ayah_text" : "وَقَالُوٓاْ إِنۡ هِيَ إِلَّا حَيَاتُنَا ٱلدُّنۡيَا وَمَا نَحۡنُ بِمَبۡعُوثِينَ",
    "ayah_text_no_diacratic" : "وقالوا ان هي الا حياتنا الدنيا وما نحن بمبعوثين",
