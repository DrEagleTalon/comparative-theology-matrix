    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3135",
    "ayah_text" : "قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ",
    "ayah_text_no_diacratic" : "قالوا انما انت من المسحرين",
    "ayahnumber" : "153",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3135",
    "page" : "373",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3136",
    "ayah_text" : "مَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا فَأۡتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "ما انت الا بشر مثلنا فات باية ان كنت من الصٰدقين",
    "ayahnumber" : "154",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3136",
    "page" : "373",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3137",
    "ayah_text" : "قَالَ هَٰذِهِۦ نَاقَةٞ لَّهَا شِرۡبٞ وَلَكُمۡ شِرۡبُ يَوۡمٖ مَّعۡلُومٖ",
    "ayah_text_no_diacratic" : "قال هٰذه ناقة لها شرب ولكم شرب يوم معلوم",
    "ayahnumber" : "155",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3137",
    "page" : "373",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3138",
    "ayah_text" : "وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَأۡخُذَكُمۡ عَذَابُ يَوۡمٍ عَظِيمٖ",
    "ayah_text_no_diacratic" : "ولا تمسوها بسوء فياخذكم عذاب يوم عظيم",
    "ayahnumber" : "156",
