  }, {
    "@id" : "quran:5715",
    "ayah_text" : "لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ",
    "ayah_text_no_diacratic" : "لا تحرك به لسانك لتعجل به",
