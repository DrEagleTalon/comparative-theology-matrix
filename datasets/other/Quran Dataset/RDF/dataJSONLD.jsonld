    "page" : "375",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3168",
    "ayah_text" : "وَمَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلۡكَٰذِبِينَ",
    "ayah_text_no_diacratic" : "وما انت الا بشر مثلنا وان نظنك لمن الكٰذبين",
    "ayahnumber" : "186",
