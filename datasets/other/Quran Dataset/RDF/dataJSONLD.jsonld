    "surrahname_no_diacratic" : "سورة ص"
  }, {
    "@id" : "quran:4131",
    "ayah_text" : "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ان هو الا ذكر للعٰلمين",
    "ayahnumber" : "87",
