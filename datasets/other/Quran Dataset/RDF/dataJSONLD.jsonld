    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3211",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3211",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3212",
    "ayah_text" : "طسٓۚ تِلۡكَ ءَايَٰتُ ٱلۡقُرۡءَانِ وَكِتَابٖ مُّبِينٍ",
    "ayah_text_no_diacratic" : "طس تلك ءايٰت القرءان وكتاب مبين",
    "ayahnumber" : "1",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3212",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3213",
    "ayah_text" : "هُدٗى وَبُشۡرَىٰ لِلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "هدى وبشرىٰ للمؤمنين",
    "ayahnumber" : "2",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3213",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3214",
    "ayah_text" : "ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤۡتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلۡأٓخِرَةِ هُمۡ يُوقِنُونَ",
    "ayah_text_no_diacratic" : "الذين يقيمون الصلوٰة ويؤتون الزكوٰة وهم بالاخرة هم يوقنون",
    "ayahnumber" : "3",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3214",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3215",
    "ayah_text" : "إِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ زَيَّنَّا لَهُمۡ أَعۡمَٰلَهُمۡ فَهُمۡ يَعۡمَهُونَ",
    "ayah_text_no_diacratic" : "ان الذين لا يؤمنون بالاخرة زينا لهم اعمٰلهم فهم يعمهون",
    "ayahnumber" : "4",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3215",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3216",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ لَهُمۡ سُوٓءُ ٱلۡعَذَابِ وَهُمۡ فِي ٱلۡأٓخِرَةِ هُمُ ٱلۡأَخۡسَرُونَ",
    "ayah_text_no_diacratic" : "اولٰئك الذين لهم سوء العذاب وهم في الاخرة هم الاخسرون",
    "ayahnumber" : "5",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3216",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3217",
    "ayah_text" : "وَإِنَّكَ لَتُلَقَّى ٱلۡقُرۡءَانَ مِن لَّدُنۡ حَكِيمٍ عَلِيمٍ",
    "ayah_text_no_diacratic" : "وانك لتلقى القرءان من لدن حكيم عليم",
    "ayahnumber" : "6",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3217",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3218",
    "ayah_text" : "إِذۡ قَالَ مُوسَىٰ لِأَهۡلِهِۦٓ إِنِّيٓ ءَانَسۡتُ نَارٗا سَـَٔاتِيكُم مِّنۡهَا بِخَبَرٍ أَوۡ ءَاتِيكُم بِشِهَابٖ قَبَسٖ لَّعَلَّكُمۡ تَصۡطَلُونَ",
    "ayah_text_no_diacratic" : "اذ قال موسىٰ لاهله اني ءانست نارا ساتيكم منها بخبر او ءاتيكم بشهاب قبس لعلكم تصطلون",
    "ayahnumber" : "7",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3218",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3219",
    "ayah_text" : "فَلَمَّا جَآءَهَا نُودِيَ أَنۢ بُورِكَ مَن فِي ٱلنَّارِ وَمَنۡ حَوۡلَهَا وَسُبۡحَٰنَ ٱللَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "فلما جاءها نودي ان بورك من في النار ومن حولها وسبحٰن الله رب العٰلمين",
    "ayahnumber" : "8",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3219",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:322",
    "ayah_text" : "ذَٰلِكَ بِأَنَّهُمۡ قَالُواْ لَن تَمَسَّنَا ٱلنَّارُ إِلَّآ أَيَّامٗا مَّعۡدُودَٰتٖۖ وَغَرَّهُمۡ فِي دِينِهِم مَّا كَانُواْ يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "ذٰلك بانهم قالوا لن تمسنا النار الا اياما معدودٰت وغرهم في دينهم ما كانوا يفترون",
    "ayahnumber" : "24",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "322",
    "page" : "53",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3220",
    "ayah_text" : "يَٰمُوسَىٰٓ إِنَّهُۥٓ أَنَا ٱللَّهُ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "يٰموسىٰ انه انا الله العزيز الحكيم",
    "ayahnumber" : "9",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3220",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3221",
    "ayah_text" : "وَأَلۡقِ عَصَاكَۚ فَلَمَّا رَءَاهَا تَهۡتَزُّ كَأَنَّهَا جَآنّٞ وَلَّىٰ مُدۡبِرٗا وَلَمۡ يُعَقِّبۡۚ يَٰمُوسَىٰ لَا تَخَفۡ إِنِّي لَا يَخَافُ لَدَيَّ ٱلۡمُرۡسَلُونَ",
    "ayah_text_no_diacratic" : "والق عصاك فلما رءاها تهتز كانها جان ولىٰ مدبرا ولم يعقب يٰموسىٰ لا تخف اني لا يخاف لدي المرسلون",
    "ayahnumber" : "10",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3221",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3222",
    "ayah_text" : "إِلَّا مَن ظَلَمَ ثُمَّ بَدَّلَ حُسۡنَۢا بَعۡدَ سُوٓءٖ فَإِنِّي غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "الا من ظلم ثم بدل حسنا بعد سوء فاني غفور رحيم",
    "ayahnumber" : "11",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3222",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3223",
    "ayah_text" : "وَأَدۡخِلۡ يَدَكَ فِي جَيۡبِكَ تَخۡرُجۡ بَيۡضَآءَ مِنۡ غَيۡرِ سُوٓءٖۖ فِي تِسۡعِ ءَايَٰتٍ إِلَىٰ فِرۡعَوۡنَ وَقَوۡمِهِۦٓۚ إِنَّهُمۡ كَانُواْ قَوۡمٗا فَٰسِقِينَ",
    "ayah_text_no_diacratic" : "وادخل يدك في جيبك تخرج بيضاء من غير سوء في تسع ءايٰت الىٰ فرعون وقومه انهم كانوا قوما فٰسقين",
    "ayahnumber" : "12",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3223",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3224",
    "ayah_text" : "فَلَمَّا جَآءَتۡهُمۡ ءَايَٰتُنَا مُبۡصِرَةٗ قَالُواْ هَٰذَا سِحۡرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "فلما جاءتهم ءايٰتنا مبصرة قالوا هٰذا سحر مبين",
    "ayahnumber" : "13",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3224",
    "page" : "377",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3225",
    "ayah_text" : "وَجَحَدُواْ بِهَا وَٱسۡتَيۡقَنَتۡهَآ أَنفُسُهُمۡ ظُلۡمٗا وَعُلُوّٗاۚ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "وجحدوا بها واستيقنتها انفسهم ظلما وعلوا فانظر كيف كان عٰقبة المفسدين",
    "ayahnumber" : "14",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3225",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3226",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا دَاوُۥدَ وَسُلَيۡمَٰنَ عِلۡمٗاۖ وَقَالَا ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي فَضَّلَنَا عَلَىٰ كَثِيرٖ مِّنۡ عِبَادِهِ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا داود وسليمٰن علما وقالا الحمد لله الذي فضلنا علىٰ كثير من عباده المؤمنين",
    "ayahnumber" : "15",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3226",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3227",
    "ayah_text" : "وَوَرِثَ سُلَيۡمَٰنُ دَاوُۥدَۖ وَقَالَ يَٰٓأَيُّهَا ٱلنَّاسُ عُلِّمۡنَا مَنطِقَ ٱلطَّيۡرِ وَأُوتِينَا مِن كُلِّ شَيۡءٍۖ إِنَّ هَٰذَا لَهُوَ ٱلۡفَضۡلُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "وورث سليمٰن داود وقال يٰايها الناس علمنا منطق الطير واوتينا من كل شيء ان هٰذا لهو الفضل المبين",
    "ayahnumber" : "16",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3227",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3228",
    "ayah_text" : "وَحُشِرَ لِسُلَيۡمَٰنَ جُنُودُهُۥ مِنَ ٱلۡجِنِّ وَٱلۡإِنسِ وَٱلطَّيۡرِ فَهُمۡ يُوزَعُونَ",
    "ayah_text_no_diacratic" : "وحشر لسليمٰن جنوده من الجن والانس والطير فهم يوزعون",
    "ayahnumber" : "17",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3228",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3229",
    "ayah_text" : "حَتَّىٰٓ إِذَآ أَتَوۡاْ عَلَىٰ وَادِ ٱلنَّمۡلِ قَالَتۡ نَمۡلَةٞ يَٰٓأَيُّهَا ٱلنَّمۡلُ ٱدۡخُلُواْ مَسَٰكِنَكُمۡ لَا يَحۡطِمَنَّكُمۡ سُلَيۡمَٰنُ وَجُنُودُهُۥ وَهُمۡ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "حتىٰ اذا اتوا علىٰ واد النمل قالت نملة يٰايها النمل ادخلوا مسٰكنكم لا يحطمنكم سليمٰن وجنوده وهم لا يشعرون",
    "ayahnumber" : "18",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3229",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:323",
    "ayah_text" : "فَكَيۡفَ إِذَا جَمَعۡنَٰهُمۡ لِيَوۡمٖ لَّا رَيۡبَ فِيهِ وَوُفِّيَتۡ كُلُّ نَفۡسٖ مَّا كَسَبَتۡ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "فكيف اذا جمعنٰهم ليوم لا ريب فيه ووفيت كل نفس ما كسبت وهم لا يظلمون",
    "ayahnumber" : "25",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "323",
    "page" : "53",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3230",
    "ayah_text" : "فَتَبَسَّمَ ضَاحِكٗا مِّن قَوۡلِهَا وَقَالَ رَبِّ أَوۡزِعۡنِيٓ أَنۡ أَشۡكُرَ نِعۡمَتَكَ ٱلَّتِيٓ أَنۡعَمۡتَ عَلَيَّ وَعَلَىٰ وَٰلِدَيَّ وَأَنۡ أَعۡمَلَ صَٰلِحٗا تَرۡضَىٰهُ وَأَدۡخِلۡنِي بِرَحۡمَتِكَ فِي عِبَادِكَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "فتبسم ضاحكا من قولها وقال رب اوزعني ان اشكر نعمتك التي انعمت علي وعلىٰ وٰلدي وان اعمل صٰلحا ترضىٰه وادخلني برحمتك في عبادك الصٰلحين",
    "ayahnumber" : "19",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3230",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3231",
    "ayah_text" : "وَتَفَقَّدَ ٱلطَّيۡرَ فَقَالَ مَالِيَ لَآ أَرَى ٱلۡهُدۡهُدَ أَمۡ كَانَ مِنَ ٱلۡغَآئِبِينَ",
    "ayah_text_no_diacratic" : "وتفقد الطير فقال مالي لا ارى الهدهد ام كان من الغائبين",
    "ayahnumber" : "20",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3231",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3232",
    "ayah_text" : "لَأُعَذِّبَنَّهُۥ عَذَابٗا شَدِيدًا أَوۡ لَأَاْذۡبَحَنَّهُۥٓ أَوۡ لَيَأۡتِيَنِّي بِسُلۡطَٰنٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "لاعذبنه عذابا شديدا او لااذبحنه او لياتيني بسلطٰن مبين",
    "ayahnumber" : "21",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3232",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3233",
    "ayah_text" : "فَمَكَثَ غَيۡرَ بَعِيدٖ فَقَالَ أَحَطتُ بِمَا لَمۡ تُحِطۡ بِهِۦ وَجِئۡتُكَ مِن سَبَإِۭ بِنَبَإٖ يَقِينٍ",
    "ayah_text_no_diacratic" : "فمكث غير بعيد فقال احطت بما لم تحط به وجئتك من سبا بنبا يقين",
    "ayahnumber" : "22",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3233",
    "page" : "378",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3234",
    "ayah_text" : "إِنِّي وَجَدتُّ ٱمۡرَأَةٗ تَمۡلِكُهُمۡ وَأُوتِيَتۡ مِن كُلِّ شَيۡءٖ وَلَهَا عَرۡشٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "اني وجدت امراة تملكهم واوتيت من كل شيء ولها عرش عظيم",
    "ayahnumber" : "23",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3234",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3235",
    "ayah_text" : "وَجَدتُّهَا وَقَوۡمَهَا يَسۡجُدُونَ لِلشَّمۡسِ مِن دُونِ ٱللَّهِ وَزَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ أَعۡمَٰلَهُمۡ فَصَدَّهُمۡ عَنِ ٱلسَّبِيلِ فَهُمۡ لَا يَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "وجدتها وقومها يسجدون للشمس من دون الله وزين لهم الشيطٰن اعمٰلهم فصدهم عن السبيل فهم لا يهتدون",
    "ayahnumber" : "24",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3235",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3236",
    "ayah_text" : "أَلَّاۤ يَسۡجُدُواْۤ لِلَّهِ ٱلَّذِي يُخۡرِجُ ٱلۡخَبۡءَ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَيَعۡلَمُ مَا تُخۡفُونَ وَمَا تُعۡلِنُونَ",
    "ayah_text_no_diacratic" : "الا يسجدوا لله الذي يخرج الخبء في السمٰوٰت والارض ويعلم ما تخفون وما تعلنون",
    "ayahnumber" : "25",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3236",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3237",
    "ayah_text" : "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ رَبُّ ٱلۡعَرۡشِ ٱلۡعَظِيمِ۩",
    "ayah_text_no_diacratic" : "الله لا الٰه الا هو رب العرش العظيم",
    "ayahnumber" : "26",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3237",
    "page" : "379",
    "sajdah" : "1",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3238",
    "ayah_text" : "۞قَالَ سَنَنظُرُ أَصَدَقۡتَ أَمۡ كُنتَ مِنَ ٱلۡكَٰذِبِينَ",
    "ayah_text_no_diacratic" : "قال سننظر اصدقت ام كنت من الكٰذبين",
    "ayahnumber" : "27",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3238",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3239",
    "ayah_text" : "ٱذۡهَب بِّكِتَٰبِي هَٰذَا فَأَلۡقِهۡ إِلَيۡهِمۡ ثُمَّ تَوَلَّ عَنۡهُمۡ فَٱنظُرۡ مَاذَا يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "اذهب بكتٰبي هٰذا فالقه اليهم ثم تول عنهم فانظر ماذا يرجعون",
    "ayahnumber" : "28",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3239",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:324",
    "ayah_text" : "قُلِ ٱللَّهُمَّ مَٰلِكَ ٱلۡمُلۡكِ تُؤۡتِي ٱلۡمُلۡكَ مَن تَشَآءُ وَتَنزِعُ ٱلۡمُلۡكَ مِمَّن تَشَآءُ وَتُعِزُّ مَن تَشَآءُ وَتُذِلُّ مَن تَشَآءُۖ بِيَدِكَ ٱلۡخَيۡرُۖ إِنَّكَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "قل اللهم مٰلك الملك تؤتي الملك من تشاء وتنزع الملك ممن تشاء وتعز من تشاء وتذل من تشاء بيدك الخير انك علىٰ كل شيء قدير",
    "ayahnumber" : "26",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "324",
    "page" : "53",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3240",
    "ayah_text" : "قَالَتۡ يَٰٓأَيُّهَا ٱلۡمَلَؤُاْ إِنِّيٓ أُلۡقِيَ إِلَيَّ كِتَٰبٞ كَرِيمٌ",
    "ayah_text_no_diacratic" : "قالت يٰايها الملؤا اني القي الي كتٰب كريم",
    "ayahnumber" : "29",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3240",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3241",
    "ayah_text" : "إِنَّهُۥ مِن سُلَيۡمَٰنَ وَإِنَّهُۥ بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "انه من سليمٰن وانه بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "30",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3241",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3242",
    "ayah_text" : "أَلَّا تَعۡلُواْ عَلَيَّ وَأۡتُونِي مُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "الا تعلوا علي واتوني مسلمين",
    "ayahnumber" : "31",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3242",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3243",
    "ayah_text" : "قَالَتۡ يَٰٓأَيُّهَا ٱلۡمَلَؤُاْ أَفۡتُونِي فِيٓ أَمۡرِي مَا كُنتُ قَاطِعَةً أَمۡرًا حَتَّىٰ تَشۡهَدُونِ",
    "ayah_text_no_diacratic" : "قالت يٰايها الملؤا افتوني في امري ما كنت قاطعة امرا حتىٰ تشهدون",
    "ayahnumber" : "32",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3243",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3244",
    "ayah_text" : "قَالُواْ نَحۡنُ أُوْلُواْ قُوَّةٖ وَأُوْلُواْ بَأۡسٖ شَدِيدٖ وَٱلۡأَمۡرُ إِلَيۡكِ فَٱنظُرِي مَاذَا تَأۡمُرِينَ",
    "ayah_text_no_diacratic" : "قالوا نحن اولوا قوة واولوا باس شديد والامر اليك فانظري ماذا تامرين",
    "ayahnumber" : "33",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3244",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3245",
    "ayah_text" : "قَالَتۡ إِنَّ ٱلۡمُلُوكَ إِذَا دَخَلُواْ قَرۡيَةً أَفۡسَدُوهَا وَجَعَلُوٓاْ أَعِزَّةَ أَهۡلِهَآ أَذِلَّةٗۚ وَكَذَٰلِكَ يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "قالت ان الملوك اذا دخلوا قرية افسدوها وجعلوا اعزة اهلها اذلة وكذٰلك يفعلون",
    "ayahnumber" : "34",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3245",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3246",
    "ayah_text" : "وَإِنِّي مُرۡسِلَةٌ إِلَيۡهِم بِهَدِيَّةٖ فَنَاظِرَةُۢ بِمَ يَرۡجِعُ ٱلۡمُرۡسَلُونَ",
    "ayah_text_no_diacratic" : "واني مرسلة اليهم بهدية فناظرة بم يرجع المرسلون",
    "ayahnumber" : "35",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3246",
    "page" : "379",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3247",
    "ayah_text" : "فَلَمَّا جَآءَ سُلَيۡمَٰنَ قَالَ أَتُمِدُّونَنِ بِمَالٖ فَمَآ ءَاتَىٰنِۦَ ٱللَّهُ خَيۡرٞ مِّمَّآ ءَاتَىٰكُمۚ بَلۡ أَنتُم بِهَدِيَّتِكُمۡ تَفۡرَحُونَ",
    "ayah_text_no_diacratic" : "فلما جاء سليمٰن قال اتمدونن بمال فما ءاتىٰن الله خير مما ءاتىٰكم بل انتم بهديتكم تفرحون",
    "ayahnumber" : "36",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3247",
    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3248",
    "ayah_text" : "ٱرۡجِعۡ إِلَيۡهِمۡ فَلَنَأۡتِيَنَّهُم بِجُنُودٖ لَّا قِبَلَ لَهُم بِهَا وَلَنُخۡرِجَنَّهُم مِّنۡهَآ أَذِلَّةٗ وَهُمۡ صَٰغِرُونَ",
    "ayah_text_no_diacratic" : "ارجع اليهم فلناتينهم بجنود لا قبل لهم بها ولنخرجنهم منها اذلة وهم صٰغرون",
    "ayahnumber" : "37",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3248",
    "page" : "380",
    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3249",
    "ayah_text" : "قَالَ يَٰٓأَيُّهَا ٱلۡمَلَؤُاْ أَيُّكُمۡ يَأۡتِينِي بِعَرۡشِهَا قَبۡلَ أَن يَأۡتُونِي مُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "قال يٰايها الملؤا ايكم ياتيني بعرشها قبل ان ياتوني مسلمين",
    "ayahnumber" : "38",
    "chapter" : "19",
    "hizb" : "38",
