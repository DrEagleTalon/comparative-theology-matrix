    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4817",
    "ayah_text" : "مَا تَذَرُ مِن شَيۡءٍ أَتَتۡ عَلَيۡهِ إِلَّا جَعَلَتۡهُ كَٱلرَّمِيمِ",
    "ayah_text_no_diacratic" : "ما تذر من شيء اتت عليه الا جعلته كالرميم",
