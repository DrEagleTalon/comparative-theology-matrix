    "page" : "386",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:332",
    "ayah_text" : "ذُرِّيَّةَۢ بَعۡضُهَا مِنۢ بَعۡضٖۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ",
    "ayah_text_no_diacratic" : "ذرية بعضها من بعض والله سميع عليم",
    "ayahnumber" : "34",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "332",
    "page" : "54",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3320",
    "ayah_text" : "وَلَمَّا بَلَغَ أَشُدَّهُۥ وَٱسۡتَوَىٰٓ ءَاتَيۡنَٰهُ حُكۡمٗا وَعِلۡمٗاۚ وَكَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "ولما بلغ اشده واستوىٰ ءاتينٰه حكما وعلما وكذٰلك نجزي المحسنين",
    "ayahnumber" : "14",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3320",
    "page" : "387",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3321",
    "ayah_text" : "وَدَخَلَ ٱلۡمَدِينَةَ عَلَىٰ حِينِ غَفۡلَةٖ مِّنۡ أَهۡلِهَا فَوَجَدَ فِيهَا رَجُلَيۡنِ يَقۡتَتِلَانِ هَٰذَا مِن شِيعَتِهِۦ وَهَٰذَا مِنۡ عَدُوِّهِۦۖ فَٱسۡتَغَٰثَهُ ٱلَّذِي مِن شِيعَتِهِۦ عَلَى ٱلَّذِي مِنۡ عَدُوِّهِۦ فَوَكَزَهُۥ مُوسَىٰ فَقَضَىٰ عَلَيۡهِۖ قَالَ هَٰذَا مِنۡ عَمَلِ ٱلشَّيۡطَٰنِۖ إِنَّهُۥ عَدُوّٞ مُّضِلّٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "ودخل المدينة علىٰ حين غفلة من اهلها فوجد فيها رجلين يقتتلان هٰذا من شيعته وهٰذا من عدوه فاستغٰثه الذي من شيعته على الذي من عدوه فوكزه موسىٰ فقضىٰ عليه قال هٰذا من عمل الشيطٰن انه عدو مضل مبين",
    "ayahnumber" : "15",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3321",
    "page" : "387",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3322",
    "ayah_text" : "قَالَ رَبِّ إِنِّي ظَلَمۡتُ نَفۡسِي فَٱغۡفِرۡ لِي فَغَفَرَ لَهُۥٓۚ إِنَّهُۥ هُوَ ٱلۡغَفُورُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "قال رب اني ظلمت نفسي فاغفر لي فغفر له انه هو الغفور الرحيم",
    "ayahnumber" : "16",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3322",
    "page" : "387",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3323",
    "ayah_text" : "قَالَ رَبِّ بِمَآ أَنۡعَمۡتَ عَلَيَّ فَلَنۡ أَكُونَ ظَهِيرٗا لِّلۡمُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "قال رب بما انعمت علي فلن اكون ظهيرا للمجرمين",
    "ayahnumber" : "17",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3323",
    "page" : "387",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3324",
    "ayah_text" : "فَأَصۡبَحَ فِي ٱلۡمَدِينَةِ خَآئِفٗا يَتَرَقَّبُ فَإِذَا ٱلَّذِي ٱسۡتَنصَرَهُۥ بِٱلۡأَمۡسِ يَسۡتَصۡرِخُهُۥۚ قَالَ لَهُۥ مُوسَىٰٓ إِنَّكَ لَغَوِيّٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "فاصبح في المدينة خائفا يترقب فاذا الذي استنصره بالامس يستصرخه قال له موسىٰ انك لغوي مبين",
    "ayahnumber" : "18",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3324",
    "page" : "387",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3325",
    "ayah_text" : "فَلَمَّآ أَنۡ أَرَادَ أَن يَبۡطِشَ بِٱلَّذِي هُوَ عَدُوّٞ لَّهُمَا قَالَ يَٰمُوسَىٰٓ أَتُرِيدُ أَن تَقۡتُلَنِي كَمَا قَتَلۡتَ نَفۡسَۢا بِٱلۡأَمۡسِۖ إِن تُرِيدُ إِلَّآ أَن تَكُونَ جَبَّارٗا فِي ٱلۡأَرۡضِ وَمَا تُرِيدُ أَن تَكُونَ مِنَ ٱلۡمُصۡلِحِينَ",
    "ayah_text_no_diacratic" : "فلما ان اراد ان يبطش بالذي هو عدو لهما قال يٰموسىٰ اتريد ان تقتلني كما قتلت نفسا بالامس ان تريد الا ان تكون جبارا في الارض وما تريد ان تكون من المصلحين",
    "ayahnumber" : "19",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3325",
    "page" : "387",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3326",
    "ayah_text" : "وَجَآءَ رَجُلٞ مِّنۡ أَقۡصَا ٱلۡمَدِينَةِ يَسۡعَىٰ قَالَ يَٰمُوسَىٰٓ إِنَّ ٱلۡمَلَأَ يَأۡتَمِرُونَ بِكَ لِيَقۡتُلُوكَ فَٱخۡرُجۡ إِنِّي لَكَ مِنَ ٱلنَّٰصِحِينَ",
    "ayah_text_no_diacratic" : "وجاء رجل من اقصا المدينة يسعىٰ قال يٰموسىٰ ان الملا ياتمرون بك ليقتلوك فاخرج اني لك من النٰصحين",
    "ayahnumber" : "20",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3326",
    "page" : "387",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3327",
    "ayah_text" : "فَخَرَجَ مِنۡهَا خَآئِفٗا يَتَرَقَّبُۖ قَالَ رَبِّ نَجِّنِي مِنَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "فخرج منها خائفا يترقب قال رب نجني من القوم الظٰلمين",
    "ayahnumber" : "21",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3327",
    "page" : "387",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3328",
    "ayah_text" : "وَلَمَّا تَوَجَّهَ تِلۡقَآءَ مَدۡيَنَ قَالَ عَسَىٰ رَبِّيٓ أَن يَهۡدِيَنِي سَوَآءَ ٱلسَّبِيلِ",
    "ayah_text_no_diacratic" : "ولما توجه تلقاء مدين قال عسىٰ ربي ان يهديني سواء السبيل",
    "ayahnumber" : "22",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3328",
    "page" : "388",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3329",
    "ayah_text" : "وَلَمَّا وَرَدَ مَآءَ مَدۡيَنَ وَجَدَ عَلَيۡهِ أُمَّةٗ مِّنَ ٱلنَّاسِ يَسۡقُونَ وَوَجَدَ مِن دُونِهِمُ ٱمۡرَأَتَيۡنِ تَذُودَانِۖ قَالَ مَا خَطۡبُكُمَاۖ قَالَتَا لَا نَسۡقِي حَتَّىٰ يُصۡدِرَ ٱلرِّعَآءُۖ وَأَبُونَا شَيۡخٞ كَبِيرٞ",
    "ayah_text_no_diacratic" : "ولما ورد ماء مدين وجد عليه امة من الناس يسقون ووجد من دونهم امراتين تذودان قال ما خطبكما قالتا لا نسقي حتىٰ يصدر الرعاء وابونا شيخ كبير",
    "ayahnumber" : "23",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3329",
    "page" : "388",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:333",
    "ayah_text" : "إِذۡ قَالَتِ ٱمۡرَأَتُ عِمۡرَٰنَ رَبِّ إِنِّي نَذَرۡتُ لَكَ مَا فِي بَطۡنِي مُحَرَّرٗا فَتَقَبَّلۡ مِنِّيٓۖ إِنَّكَ أَنتَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "اذ قالت امرات عمرٰن رب اني نذرت لك ما في بطني محررا فتقبل مني انك انت السميع العليم",
    "ayahnumber" : "35",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "333",
    "page" : "54",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3330",
    "ayah_text" : "فَسَقَىٰ لَهُمَا ثُمَّ تَوَلَّىٰٓ إِلَى ٱلظِّلِّ فَقَالَ رَبِّ إِنِّي لِمَآ أَنزَلۡتَ إِلَيَّ مِنۡ خَيۡرٖ فَقِيرٞ",
    "ayah_text_no_diacratic" : "فسقىٰ لهما ثم تولىٰ الى الظل فقال رب اني لما انزلت الي من خير فقير",
    "ayahnumber" : "24",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3330",
    "page" : "388",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3331",
    "ayah_text" : "فَجَآءَتۡهُ إِحۡدَىٰهُمَا تَمۡشِي عَلَى ٱسۡتِحۡيَآءٖ قَالَتۡ إِنَّ أَبِي يَدۡعُوكَ لِيَجۡزِيَكَ أَجۡرَ مَا سَقَيۡتَ لَنَاۚ فَلَمَّا جَآءَهُۥ وَقَصَّ عَلَيۡهِ ٱلۡقَصَصَ قَالَ لَا تَخَفۡۖ نَجَوۡتَ مِنَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "فجاءته احدىٰهما تمشي على استحياء قالت ان ابي يدعوك ليجزيك اجر ما سقيت لنا فلما جاءه وقص عليه القصص قال لا تخف نجوت من القوم الظٰلمين",
    "ayahnumber" : "25",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3331",
    "page" : "388",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3332",
    "ayah_text" : "قَالَتۡ إِحۡدَىٰهُمَا يَٰٓأَبَتِ ٱسۡتَـٔۡجِرۡهُۖ إِنَّ خَيۡرَ مَنِ ٱسۡتَـٔۡجَرۡتَ ٱلۡقَوِيُّ ٱلۡأَمِينُ",
    "ayah_text_no_diacratic" : "قالت احدىٰهما يٰابت استجره ان خير من استجرت القوي الامين",
    "ayahnumber" : "26",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3332",
    "page" : "388",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3333",
    "ayah_text" : "قَالَ إِنِّيٓ أُرِيدُ أَنۡ أُنكِحَكَ إِحۡدَى ٱبۡنَتَيَّ هَٰتَيۡنِ عَلَىٰٓ أَن تَأۡجُرَنِي ثَمَٰنِيَ حِجَجٖۖ فَإِنۡ أَتۡمَمۡتَ عَشۡرٗا فَمِنۡ عِندِكَۖ وَمَآ أُرِيدُ أَنۡ أَشُقَّ عَلَيۡكَۚ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "قال اني اريد ان انكحك احدى ابنتي هٰتين علىٰ ان تاجرني ثمٰني حجج فان اتممت عشرا فمن عندك وما اريد ان اشق عليك ستجدني ان شاء الله من الصٰلحين",
    "ayahnumber" : "27",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3333",
    "page" : "388",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3334",
    "ayah_text" : "قَالَ ذَٰلِكَ بَيۡنِي وَبَيۡنَكَۖ أَيَّمَا ٱلۡأَجَلَيۡنِ قَضَيۡتُ فَلَا عُدۡوَٰنَ عَلَيَّۖ وَٱللَّهُ عَلَىٰ مَا نَقُولُ وَكِيلٞ",
    "ayah_text_no_diacratic" : "قال ذٰلك بيني وبينك ايما الاجلين قضيت فلا عدوٰن علي والله علىٰ ما نقول وكيل",
    "ayahnumber" : "28",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3334",
    "page" : "388",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3335",
    "ayah_text" : "۞فَلَمَّا قَضَىٰ مُوسَى ٱلۡأَجَلَ وَسَارَ بِأَهۡلِهِۦٓ ءَانَسَ مِن جَانِبِ ٱلطُّورِ نَارٗاۖ قَالَ لِأَهۡلِهِ ٱمۡكُثُوٓاْ إِنِّيٓ ءَانَسۡتُ نَارٗا لَّعَلِّيٓ ءَاتِيكُم مِّنۡهَا بِخَبَرٍ أَوۡ جَذۡوَةٖ مِّنَ ٱلنَّارِ لَعَلَّكُمۡ تَصۡطَلُونَ",
    "ayah_text_no_diacratic" : "فلما قضىٰ موسى الاجل وسار باهله ءانس من جانب الطور نارا قال لاهله امكثوا اني ءانست نارا لعلي ءاتيكم منها بخبر او جذوة من النار لعلكم تصطلون",
    "ayahnumber" : "29",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3335",
    "page" : "389",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3336",
    "ayah_text" : "فَلَمَّآ أَتَىٰهَا نُودِيَ مِن شَٰطِيِٕ ٱلۡوَادِ ٱلۡأَيۡمَنِ فِي ٱلۡبُقۡعَةِ ٱلۡمُبَٰرَكَةِ مِنَ ٱلشَّجَرَةِ أَن يَٰمُوسَىٰٓ إِنِّيٓ أَنَا ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "فلما اتىٰها نودي من شٰطي الواد الايمن في البقعة المبٰركة من الشجرة ان يٰموسىٰ اني انا الله رب العٰلمين",
    "ayahnumber" : "30",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3336",
    "page" : "389",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3337",
    "ayah_text" : "وَأَنۡ أَلۡقِ عَصَاكَۚ فَلَمَّا رَءَاهَا تَهۡتَزُّ كَأَنَّهَا جَآنّٞ وَلَّىٰ مُدۡبِرٗا وَلَمۡ يُعَقِّبۡۚ يَٰمُوسَىٰٓ أَقۡبِلۡ وَلَا تَخَفۡۖ إِنَّكَ مِنَ ٱلۡأٓمِنِينَ",
    "ayah_text_no_diacratic" : "وان الق عصاك فلما رءاها تهتز كانها جان ولىٰ مدبرا ولم يعقب يٰموسىٰ اقبل ولا تخف انك من الامنين",
    "ayahnumber" : "31",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3337",
    "page" : "389",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3338",
    "ayah_text" : "ٱسۡلُكۡ يَدَكَ فِي جَيۡبِكَ تَخۡرُجۡ بَيۡضَآءَ مِنۡ غَيۡرِ سُوٓءٖ وَٱضۡمُمۡ إِلَيۡكَ جَنَاحَكَ مِنَ ٱلرَّهۡبِۖ فَذَٰنِكَ بُرۡهَٰنَانِ مِن رَّبِّكَ إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦٓۚ إِنَّهُمۡ كَانُواْ قَوۡمٗا فَٰسِقِينَ",
    "ayah_text_no_diacratic" : "اسلك يدك في جيبك تخرج بيضاء من غير سوء واضمم اليك جناحك من الرهب فذٰنك برهٰنان من ربك الىٰ فرعون وملايه انهم كانوا قوما فٰسقين",
    "ayahnumber" : "32",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3338",
    "page" : "389",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3339",
    "ayah_text" : "قَالَ رَبِّ إِنِّي قَتَلۡتُ مِنۡهُمۡ نَفۡسٗا فَأَخَافُ أَن يَقۡتُلُونِ",
    "ayah_text_no_diacratic" : "قال رب اني قتلت منهم نفسا فاخاف ان يقتلون",
    "ayahnumber" : "33",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3339",
    "page" : "389",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:334",
    "ayah_text" : "فَلَمَّا وَضَعَتۡهَا قَالَتۡ رَبِّ إِنِّي وَضَعۡتُهَآ أُنثَىٰ وَٱللَّهُ أَعۡلَمُ بِمَا وَضَعَتۡ وَلَيۡسَ ٱلذَّكَرُ كَٱلۡأُنثَىٰۖ وَإِنِّي سَمَّيۡتُهَا مَرۡيَمَ وَإِنِّيٓ أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ ٱلشَّيۡطَٰنِ ٱلرَّجِيمِ",
    "ayah_text_no_diacratic" : "فلما وضعتها قالت رب اني وضعتها انثىٰ والله اعلم بما وضعت وليس الذكر كالانثىٰ واني سميتها مريم واني اعيذها بك وذريتها من الشيطٰن الرجيم",
    "ayahnumber" : "36",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "334",
    "page" : "54",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3340",
    "ayah_text" : "وَأَخِي هَٰرُونُ هُوَ أَفۡصَحُ مِنِّي لِسَانٗا فَأَرۡسِلۡهُ مَعِيَ رِدۡءٗا يُصَدِّقُنِيٓۖ إِنِّيٓ أَخَافُ أَن يُكَذِّبُونِ",
    "ayah_text_no_diacratic" : "واخي هٰرون هو افصح مني لسانا فارسله معي ردءا يصدقني اني اخاف ان يكذبون",
    "ayahnumber" : "34",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3340",
    "page" : "389",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3341",
    "ayah_text" : "قَالَ سَنَشُدُّ عَضُدَكَ بِأَخِيكَ وَنَجۡعَلُ لَكُمَا سُلۡطَٰنٗا فَلَا يَصِلُونَ إِلَيۡكُمَا بِـَٔايَٰتِنَآۚ أَنتُمَا وَمَنِ ٱتَّبَعَكُمَا ٱلۡغَٰلِبُونَ",
    "ayah_text_no_diacratic" : "قال سنشد عضدك باخيك ونجعل لكما سلطٰنا فلا يصلون اليكما بايٰتنا انتما ومن اتبعكما الغٰلبون",
    "ayahnumber" : "35",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3341",
    "page" : "389",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3342",
    "ayah_text" : "فَلَمَّا جَآءَهُم مُّوسَىٰ بِـَٔايَٰتِنَا بَيِّنَٰتٖ قَالُواْ مَا هَٰذَآ إِلَّا سِحۡرٞ مُّفۡتَرٗى وَمَا سَمِعۡنَا بِهَٰذَا فِيٓ ءَابَآئِنَا ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "فلما جاءهم موسىٰ بايٰتنا بينٰت قالوا ما هٰذا الا سحر مفترى وما سمعنا بهٰذا في ءابائنا الاولين",
    "ayahnumber" : "36",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3342",
    "page" : "390",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3343",
    "ayah_text" : "وَقَالَ مُوسَىٰ رَبِّيٓ أَعۡلَمُ بِمَن جَآءَ بِٱلۡهُدَىٰ مِنۡ عِندِهِۦ وَمَن تَكُونُ لَهُۥ عَٰقِبَةُ ٱلدَّارِۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "وقال موسىٰ ربي اعلم بمن جاء بالهدىٰ من عنده ومن تكون له عٰقبة الدار انه لا يفلح الظٰلمون",
    "ayahnumber" : "37",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3343",
    "page" : "390",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3344",
    "ayah_text" : "وَقَالَ فِرۡعَوۡنُ يَٰٓأَيُّهَا ٱلۡمَلَأُ مَا عَلِمۡتُ لَكُم مِّنۡ إِلَٰهٍ غَيۡرِي فَأَوۡقِدۡ لِي يَٰهَٰمَٰنُ عَلَى ٱلطِّينِ فَٱجۡعَل لِّي صَرۡحٗا لَّعَلِّيٓ أَطَّلِعُ إِلَىٰٓ إِلَٰهِ مُوسَىٰ وَإِنِّي لَأَظُنُّهُۥ مِنَ ٱلۡكَٰذِبِينَ",
    "ayah_text_no_diacratic" : "وقال فرعون يٰايها الملا ما علمت لكم من الٰه غيري فاوقد لي يٰهٰمٰن على الطين فاجعل لي صرحا لعلي اطلع الىٰ الٰه موسىٰ واني لاظنه من الكٰذبين",
    "ayahnumber" : "38",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3344",
    "page" : "390",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3345",
    "ayah_text" : "وَٱسۡتَكۡبَرَ هُوَ وَجُنُودُهُۥ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّ وَظَنُّوٓاْ أَنَّهُمۡ إِلَيۡنَا لَا يُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "واستكبر هو وجنوده في الارض بغير الحق وظنوا انهم الينا لا يرجعون",
    "ayahnumber" : "39",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3345",
    "page" : "390",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3346",
    "ayah_text" : "فَأَخَذۡنَٰهُ وَجُنُودَهُۥ فَنَبَذۡنَٰهُمۡ فِي ٱلۡيَمِّۖ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "فاخذنٰه وجنوده فنبذنٰهم في اليم فانظر كيف كان عٰقبة الظٰلمين",
    "ayahnumber" : "40",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3346",
    "page" : "390",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3347",
    "ayah_text" : "وَجَعَلۡنَٰهُمۡ أَئِمَّةٗ يَدۡعُونَ إِلَى ٱلنَّارِۖ وَيَوۡمَ ٱلۡقِيَٰمَةِ لَا يُنصَرُونَ",
    "ayah_text_no_diacratic" : "وجعلنٰهم ائمة يدعون الى النار ويوم القيٰمة لا ينصرون",
    "ayahnumber" : "41",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3347",
    "page" : "390",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3348",
    "ayah_text" : "وَأَتۡبَعۡنَٰهُمۡ فِي هَٰذِهِ ٱلدُّنۡيَا لَعۡنَةٗۖ وَيَوۡمَ ٱلۡقِيَٰمَةِ هُم مِّنَ ٱلۡمَقۡبُوحِينَ",
    "ayah_text_no_diacratic" : "واتبعنٰهم في هٰذه الدنيا لعنة ويوم القيٰمة هم من المقبوحين",
    "ayahnumber" : "42",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3348",
    "page" : "390",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3349",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ مِنۢ بَعۡدِ مَآ أَهۡلَكۡنَا ٱلۡقُرُونَ ٱلۡأُولَىٰ بَصَآئِرَ لِلنَّاسِ وَهُدٗى وَرَحۡمَةٗ لَّعَلَّهُمۡ يَتَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسى الكتٰب من بعد ما اهلكنا القرون الاولىٰ بصائر للناس وهدى ورحمة لعلهم يتذكرون",
    "ayahnumber" : "43",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3349",
    "page" : "390",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:335",
    "ayah_text" : "فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ حَسَنٖ وَأَنۢبَتَهَا نَبَاتًا حَسَنٗا وَكَفَّلَهَا زَكَرِيَّاۖ كُلَّمَا دَخَلَ عَلَيۡهَا زَكَرِيَّا ٱلۡمِحۡرَابَ وَجَدَ عِندَهَا رِزۡقٗاۖ قَالَ يَٰمَرۡيَمُ أَنَّىٰ لَكِ هَٰذَاۖ قَالَتۡ هُوَ مِنۡ عِندِ ٱللَّهِۖ إِنَّ ٱللَّهَ يَرۡزُقُ مَن يَشَآءُ بِغَيۡرِ حِسَابٍ",
    "ayah_text_no_diacratic" : "فتقبلها ربها بقبول حسن وانبتها نباتا حسنا وكفلها زكريا كلما دخل عليها زكريا المحراب وجد عندها رزقا قال يٰمريم انىٰ لك هٰذا قالت هو من عند الله ان الله يرزق من يشاء بغير حساب",
    "ayahnumber" : "37",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "335",
    "page" : "54",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3350",
    "ayah_text" : "وَمَا كُنتَ بِجَانِبِ ٱلۡغَرۡبِيِّ إِذۡ قَضَيۡنَآ إِلَىٰ مُوسَى ٱلۡأَمۡرَ وَمَا كُنتَ مِنَ ٱلشَّٰهِدِينَ",
    "ayah_text_no_diacratic" : "وما كنت بجانب الغربي اذ قضينا الىٰ موسى الامر وما كنت من الشٰهدين",
    "ayahnumber" : "44",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3350",
    "page" : "391",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3351",
    "ayah_text" : "وَلَٰكِنَّآ أَنشَأۡنَا قُرُونٗا فَتَطَاوَلَ عَلَيۡهِمُ ٱلۡعُمُرُۚ وَمَا كُنتَ ثَاوِيٗا فِيٓ أَهۡلِ مَدۡيَنَ تَتۡلُواْ عَلَيۡهِمۡ ءَايَٰتِنَا وَلَٰكِنَّا كُنَّا مُرۡسِلِينَ",
    "ayah_text_no_diacratic" : "ولٰكنا انشانا قرونا فتطاول عليهم العمر وما كنت ثاويا في اهل مدين تتلوا عليهم ءايٰتنا ولٰكنا كنا مرسلين",
    "ayahnumber" : "45",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3351",
    "page" : "391",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3352",
    "ayah_text" : "وَمَا كُنتَ بِجَانِبِ ٱلطُّورِ إِذۡ نَادَيۡنَا وَلَٰكِن رَّحۡمَةٗ مِّن رَّبِّكَ لِتُنذِرَ قَوۡمٗا مَّآ أَتَىٰهُم مِّن نَّذِيرٖ مِّن قَبۡلِكَ لَعَلَّهُمۡ يَتَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "وما كنت بجانب الطور اذ نادينا ولٰكن رحمة من ربك لتنذر قوما ما اتىٰهم من نذير من قبلك لعلهم يتذكرون",
    "ayahnumber" : "46",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3352",
    "page" : "391",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3353",
    "ayah_text" : "وَلَوۡلَآ أَن تُصِيبَهُم مُّصِيبَةُۢ بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ فَيَقُولُواْ رَبَّنَا لَوۡلَآ أَرۡسَلۡتَ إِلَيۡنَا رَسُولٗا فَنَتَّبِعَ ءَايَٰتِكَ وَنَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ولولا ان تصيبهم مصيبة بما قدمت ايديهم فيقولوا ربنا لولا ارسلت الينا رسولا فنتبع ءايٰتك ونكون من المؤمنين",
    "ayahnumber" : "47",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3353",
    "page" : "391",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3354",
    "ayah_text" : "فَلَمَّا جَآءَهُمُ ٱلۡحَقُّ مِنۡ عِندِنَا قَالُواْ لَوۡلَآ أُوتِيَ مِثۡلَ مَآ أُوتِيَ مُوسَىٰٓۚ أَوَلَمۡ يَكۡفُرُواْ بِمَآ أُوتِيَ مُوسَىٰ مِن قَبۡلُۖ قَالُواْ سِحۡرَانِ تَظَٰهَرَا وَقَالُوٓاْ إِنَّا بِكُلّٖ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "فلما جاءهم الحق من عندنا قالوا لولا اوتي مثل ما اوتي موسىٰ اولم يكفروا بما اوتي موسىٰ من قبل قالوا سحران تظٰهرا وقالوا انا بكل كٰفرون",
    "ayahnumber" : "48",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3354",
    "page" : "391",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3355",
    "ayah_text" : "قُلۡ فَأۡتُواْ بِكِتَٰبٖ مِّنۡ عِندِ ٱللَّهِ هُوَ أَهۡدَىٰ مِنۡهُمَآ أَتَّبِعۡهُ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "قل فاتوا بكتٰب من عند الله هو اهدىٰ منهما اتبعه ان كنتم صٰدقين",
    "ayahnumber" : "49",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3355",
    "page" : "391",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3356",
    "ayah_text" : "فَإِن لَّمۡ يَسۡتَجِيبُواْ لَكَ فَٱعۡلَمۡ أَنَّمَا يَتَّبِعُونَ أَهۡوَآءَهُمۡۚ وَمَنۡ أَضَلُّ مِمَّنِ ٱتَّبَعَ هَوَىٰهُ بِغَيۡرِ هُدٗى مِّنَ ٱللَّهِۚ إِنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "فان لم يستجيبوا لك فاعلم انما يتبعون اهواءهم ومن اضل ممن اتبع هوىٰه بغير هدى من الله ان الله لا يهدي القوم الظٰلمين",
    "ayahnumber" : "50",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3356",
    "page" : "391",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3357",
    "ayah_text" : "۞وَلَقَدۡ وَصَّلۡنَا لَهُمُ ٱلۡقَوۡلَ لَعَلَّهُمۡ يَتَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "ولقد وصلنا لهم القول لعلهم يتذكرون",
    "ayahnumber" : "51",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3357",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3358",
    "ayah_text" : "ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ مِن قَبۡلِهِۦ هُم بِهِۦ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "الذين ءاتينٰهم الكتٰب من قبله هم به يؤمنون",
    "ayahnumber" : "52",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3358",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3359",
    "ayah_text" : "وَإِذَا يُتۡلَىٰ عَلَيۡهِمۡ قَالُوٓاْ ءَامَنَّا بِهِۦٓ إِنَّهُ ٱلۡحَقُّ مِن رَّبِّنَآ إِنَّا كُنَّا مِن قَبۡلِهِۦ مُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "واذا يتلىٰ عليهم قالوا ءامنا به انه الحق من ربنا انا كنا من قبله مسلمين",
    "ayahnumber" : "53",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3359",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:336",
    "ayah_text" : "هُنَالِكَ دَعَا زَكَرِيَّا رَبَّهُۥۖ قَالَ رَبِّ هَبۡ لِي مِن لَّدُنكَ ذُرِّيَّةٗ طَيِّبَةًۖ إِنَّكَ سَمِيعُ ٱلدُّعَآءِ",
    "ayah_text_no_diacratic" : "هنالك دعا زكريا ربه قال رب هب لي من لدنك ذرية طيبة انك سميع الدعاء",
    "ayahnumber" : "38",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "336",
    "page" : "55",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3360",
    "ayah_text" : "أُوْلَٰٓئِكَ يُؤۡتَوۡنَ أَجۡرَهُم مَّرَّتَيۡنِ بِمَا صَبَرُواْ وَيَدۡرَءُونَ بِٱلۡحَسَنَةِ ٱلسَّيِّئَةَ وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ",
    "ayah_text_no_diacratic" : "اولٰئك يؤتون اجرهم مرتين بما صبروا ويدرءون بالحسنة السيئة ومما رزقنٰهم ينفقون",
    "ayahnumber" : "54",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3360",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3361",
    "ayah_text" : "وَإِذَا سَمِعُواْ ٱللَّغۡوَ أَعۡرَضُواْ عَنۡهُ وَقَالُواْ لَنَآ أَعۡمَٰلُنَا وَلَكُمۡ أَعۡمَٰلُكُمۡ سَلَٰمٌ عَلَيۡكُمۡ لَا نَبۡتَغِي ٱلۡجَٰهِلِينَ",
    "ayah_text_no_diacratic" : "واذا سمعوا اللغو اعرضوا عنه وقالوا لنا اعمٰلنا ولكم اعمٰلكم سلٰم عليكم لا نبتغي الجٰهلين",
    "ayahnumber" : "55",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3361",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3362",
    "ayah_text" : "إِنَّكَ لَا تَهۡدِي مَنۡ أَحۡبَبۡتَ وَلَٰكِنَّ ٱللَّهَ يَهۡدِي مَن يَشَآءُۚ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ",
    "ayah_text_no_diacratic" : "انك لا تهدي من احببت ولٰكن الله يهدي من يشاء وهو اعلم بالمهتدين",
    "ayahnumber" : "56",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3362",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3363",
    "ayah_text" : "وَقَالُوٓاْ إِن نَّتَّبِعِ ٱلۡهُدَىٰ مَعَكَ نُتَخَطَّفۡ مِنۡ أَرۡضِنَآۚ أَوَلَمۡ نُمَكِّن لَّهُمۡ حَرَمًا ءَامِنٗا يُجۡبَىٰٓ إِلَيۡهِ ثَمَرَٰتُ كُلِّ شَيۡءٖ رِّزۡقٗا مِّن لَّدُنَّا وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وقالوا ان نتبع الهدىٰ معك نتخطف من ارضنا اولم نمكن لهم حرما ءامنا يجبىٰ اليه ثمرٰت كل شيء رزقا من لدنا ولٰكن اكثرهم لا يعلمون",
    "ayahnumber" : "57",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3363",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3364",
    "ayah_text" : "وَكَمۡ أَهۡلَكۡنَا مِن قَرۡيَةِۭ بَطِرَتۡ مَعِيشَتَهَاۖ فَتِلۡكَ مَسَٰكِنُهُمۡ لَمۡ تُسۡكَن مِّنۢ بَعۡدِهِمۡ إِلَّا قَلِيلٗاۖ وَكُنَّا نَحۡنُ ٱلۡوَٰرِثِينَ",
    "ayah_text_no_diacratic" : "وكم اهلكنا من قرية بطرت معيشتها فتلك مسٰكنهم لم تسكن من بعدهم الا قليلا وكنا نحن الوٰرثين",
    "ayahnumber" : "58",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3364",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3365",
    "ayah_text" : "وَمَا كَانَ رَبُّكَ مُهۡلِكَ ٱلۡقُرَىٰ حَتَّىٰ يَبۡعَثَ فِيٓ أُمِّهَا رَسُولٗا يَتۡلُواْ عَلَيۡهِمۡ ءَايَٰتِنَاۚ وَمَا كُنَّا مُهۡلِكِي ٱلۡقُرَىٰٓ إِلَّا وَأَهۡلُهَا ظَٰلِمُونَ",
    "ayah_text_no_diacratic" : "وما كان ربك مهلك القرىٰ حتىٰ يبعث في امها رسولا يتلوا عليهم ءايٰتنا وما كنا مهلكي القرىٰ الا واهلها ظٰلمون",
    "ayahnumber" : "59",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3365",
    "page" : "392",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3366",
    "ayah_text" : "وَمَآ أُوتِيتُم مِّن شَيۡءٖ فَمَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَزِينَتُهَاۚ وَمَا عِندَ ٱللَّهِ خَيۡرٞ وَأَبۡقَىٰٓۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "وما اوتيتم من شيء فمتٰع الحيوٰة الدنيا وزينتها وما عند الله خير وابقىٰ افلا تعقلون",
    "ayahnumber" : "60",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3366",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3367",
    "ayah_text" : "أَفَمَن وَعَدۡنَٰهُ وَعۡدًا حَسَنٗا فَهُوَ لَٰقِيهِ كَمَن مَّتَّعۡنَٰهُ مَتَٰعَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا ثُمَّ هُوَ يَوۡمَ ٱلۡقِيَٰمَةِ مِنَ ٱلۡمُحۡضَرِينَ",
    "ayah_text_no_diacratic" : "افمن وعدنٰه وعدا حسنا فهو لٰقيه كمن متعنٰه متٰع الحيوٰة الدنيا ثم هو يوم القيٰمة من المحضرين",
    "ayahnumber" : "61",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3367",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3368",
    "ayah_text" : "وَيَوۡمَ يُنَادِيهِمۡ فَيَقُولُ أَيۡنَ شُرَكَآءِيَ ٱلَّذِينَ كُنتُمۡ تَزۡعُمُونَ",
    "ayah_text_no_diacratic" : "ويوم يناديهم فيقول اين شركاءي الذين كنتم تزعمون",
    "ayahnumber" : "62",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3368",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3369",
    "ayah_text" : "قَالَ ٱلَّذِينَ حَقَّ عَلَيۡهِمُ ٱلۡقَوۡلُ رَبَّنَا هَٰٓؤُلَآءِ ٱلَّذِينَ أَغۡوَيۡنَآ أَغۡوَيۡنَٰهُمۡ كَمَا غَوَيۡنَاۖ تَبَرَّأۡنَآ إِلَيۡكَۖ مَا كَانُوٓاْ إِيَّانَا يَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "قال الذين حق عليهم القول ربنا هٰؤلاء الذين اغوينا اغوينٰهم كما غوينا تبرانا اليك ما كانوا ايانا يعبدون",
    "ayahnumber" : "63",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3369",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:337",
    "ayah_text" : "فَنَادَتۡهُ ٱلۡمَلَٰٓئِكَةُ وَهُوَ قَآئِمٞ يُصَلِّي فِي ٱلۡمِحۡرَابِ أَنَّ ٱللَّهَ يُبَشِّرُكَ بِيَحۡيَىٰ مُصَدِّقَۢا بِكَلِمَةٖ مِّنَ ٱللَّهِ وَسَيِّدٗا وَحَصُورٗا وَنَبِيّٗا مِّنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "فنادته الملٰئكة وهو قائم يصلي في المحراب ان الله يبشرك بيحيىٰ مصدقا بكلمة من الله وسيدا وحصورا ونبيا من الصٰلحين",
    "ayahnumber" : "39",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "337",
    "page" : "55",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3370",
    "ayah_text" : "وَقِيلَ ٱدۡعُواْ شُرَكَآءَكُمۡ فَدَعَوۡهُمۡ فَلَمۡ يَسۡتَجِيبُواْ لَهُمۡ وَرَأَوُاْ ٱلۡعَذَابَۚ لَوۡ أَنَّهُمۡ كَانُواْ يَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "وقيل ادعوا شركاءكم فدعوهم فلم يستجيبوا لهم وراوا العذاب لو انهم كانوا يهتدون",
    "ayahnumber" : "64",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3370",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3371",
    "ayah_text" : "وَيَوۡمَ يُنَادِيهِمۡ فَيَقُولُ مَاذَآ أَجَبۡتُمُ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "ويوم يناديهم فيقول ماذا اجبتم المرسلين",
    "ayahnumber" : "65",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3371",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3372",
    "ayah_text" : "فَعَمِيَتۡ عَلَيۡهِمُ ٱلۡأَنۢبَآءُ يَوۡمَئِذٖ فَهُمۡ لَا يَتَسَآءَلُونَ",
    "ayah_text_no_diacratic" : "فعميت عليهم الانباء يومئذ فهم لا يتساءلون",
    "ayahnumber" : "66",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3372",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3373",
    "ayah_text" : "فَأَمَّا مَن تَابَ وَءَامَنَ وَعَمِلَ صَٰلِحٗا فَعَسَىٰٓ أَن يَكُونَ مِنَ ٱلۡمُفۡلِحِينَ",
    "ayah_text_no_diacratic" : "فاما من تاب وءامن وعمل صٰلحا فعسىٰ ان يكون من المفلحين",
    "ayahnumber" : "67",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3373",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3374",
    "ayah_text" : "وَرَبُّكَ يَخۡلُقُ مَا يَشَآءُ وَيَخۡتَارُۗ مَا كَانَ لَهُمُ ٱلۡخِيَرَةُۚ سُبۡحَٰنَ ٱللَّهِ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "وربك يخلق ما يشاء ويختار ما كان لهم الخيرة سبحٰن الله وتعٰلىٰ عما يشركون",
    "ayahnumber" : "68",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3374",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3375",
    "ayah_text" : "وَرَبُّكَ يَعۡلَمُ مَا تُكِنُّ صُدُورُهُمۡ وَمَا يُعۡلِنُونَ",
    "ayah_text_no_diacratic" : "وربك يعلم ما تكن صدورهم وما يعلنون",
    "ayahnumber" : "69",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3375",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3376",
    "ayah_text" : "وَهُوَ ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ لَهُ ٱلۡحَمۡدُ فِي ٱلۡأُولَىٰ وَٱلۡأٓخِرَةِۖ وَلَهُ ٱلۡحُكۡمُ وَإِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "وهو الله لا الٰه الا هو له الحمد في الاولىٰ والاخرة وله الحكم واليه ترجعون",
    "ayahnumber" : "70",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3376",
    "page" : "393",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3377",
    "ayah_text" : "قُلۡ أَرَءَيۡتُمۡ إِن جَعَلَ ٱللَّهُ عَلَيۡكُمُ ٱلَّيۡلَ سَرۡمَدًا إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ مَنۡ إِلَٰهٌ غَيۡرُ ٱللَّهِ يَأۡتِيكُم بِضِيَآءٍۚ أَفَلَا تَسۡمَعُونَ",
    "ayah_text_no_diacratic" : "قل ارءيتم ان جعل الله عليكم اليل سرمدا الىٰ يوم القيٰمة من الٰه غير الله ياتيكم بضياء افلا تسمعون",
    "ayahnumber" : "71",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3377",
    "page" : "394",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3378",
    "ayah_text" : "قُلۡ أَرَءَيۡتُمۡ إِن جَعَلَ ٱللَّهُ عَلَيۡكُمُ ٱلنَّهَارَ سَرۡمَدًا إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ مَنۡ إِلَٰهٌ غَيۡرُ ٱللَّهِ يَأۡتِيكُم بِلَيۡلٖ تَسۡكُنُونَ فِيهِۚ أَفَلَا تُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "قل ارءيتم ان جعل الله عليكم النهار سرمدا الىٰ يوم القيٰمة من الٰه غير الله ياتيكم بليل تسكنون فيه افلا تبصرون",
    "ayahnumber" : "72",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3378",
    "page" : "394",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3379",
    "ayah_text" : "وَمِن رَّحۡمَتِهِۦ جَعَلَ لَكُمُ ٱلَّيۡلَ وَٱلنَّهَارَ لِتَسۡكُنُواْ فِيهِ وَلِتَبۡتَغُواْ مِن فَضۡلِهِۦ وَلَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "ومن رحمته جعل لكم اليل والنهار لتسكنوا فيه ولتبتغوا من فضله ولعلكم تشكرون",
    "ayahnumber" : "73",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3379",
    "page" : "394",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:338",
    "ayah_text" : "قَالَ رَبِّ أَنَّىٰ يَكُونُ لِي غُلَٰمٞ وَقَدۡ بَلَغَنِيَ ٱلۡكِبَرُ وَٱمۡرَأَتِي عَاقِرٞۖ قَالَ كَذَٰلِكَ ٱللَّهُ يَفۡعَلُ مَا يَشَآءُ",
    "ayah_text_no_diacratic" : "قال رب انىٰ يكون لي غلٰم وقد بلغني الكبر وامراتي عاقر قال كذٰلك الله يفعل ما يشاء",
    "ayahnumber" : "40",
