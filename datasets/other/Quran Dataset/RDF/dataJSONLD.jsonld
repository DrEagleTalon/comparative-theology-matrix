    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1879",
    "ayah_text" : "۞نَبِّئۡ عِبَادِيٓ أَنِّيٓ أَنَا ٱلۡغَفُورُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "نبئ عبادي اني انا الغفور الرحيم",
    "ayahnumber" : "49",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1879",
    "page" : "264",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:188",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُتِبَ عَلَيۡكُمُ ٱلۡقِصَاصُ فِي ٱلۡقَتۡلَىۖ ٱلۡحُرُّ بِٱلۡحُرِّ وَٱلۡعَبۡدُ بِٱلۡعَبۡدِ وَٱلۡأُنثَىٰ بِٱلۡأُنثَىٰۚ فَمَنۡ عُفِيَ لَهُۥ مِنۡ أَخِيهِ شَيۡءٞ فَٱتِّبَاعُۢ بِٱلۡمَعۡرُوفِ وَأَدَآءٌ إِلَيۡهِ بِإِحۡسَٰنٖۗ ذَٰلِكَ تَخۡفِيفٞ مِّن رَّبِّكُمۡ وَرَحۡمَةٞۗ فَمَنِ ٱعۡتَدَىٰ بَعۡدَ ذَٰلِكَ فَلَهُۥ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا كتب عليكم القصاص في القتلى الحر بالحر والعبد بالعبد والانثىٰ بالانثىٰ فمن عفي له من اخيه شيء فاتباع بالمعروف واداء اليه باحسٰن ذٰلك تخفيف من ربكم ورحمة فمن اعتدىٰ بعد ذٰلك فله عذاب اليم",
    "ayahnumber" : "178",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "188",
    "page" : "27",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1880",
    "ayah_text" : "وَأَنَّ عَذَابِي هُوَ ٱلۡعَذَابُ ٱلۡأَلِيمُ",
    "ayah_text_no_diacratic" : "وان عذابي هو العذاب الاليم",
    "ayahnumber" : "50",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1880",
