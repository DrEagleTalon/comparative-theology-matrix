    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4871",
    "ayah_text" : "فَلۡيَأۡتُواْ بِحَدِيثٖ مِّثۡلِهِۦٓ إِن كَانُواْ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "فلياتوا بحديث مثله ان كانوا صٰدقين",
    "ayahnumber" : "34",
