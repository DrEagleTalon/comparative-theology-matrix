    "page" : "137",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:878",
    "ayah_text" : "فَلَمَّا رَءَا ٱلشَّمۡسَ بَازِغَةٗ قَالَ هَٰذَا رَبِّي هَٰذَآ أَكۡبَرُۖ فَلَمَّآ أَفَلَتۡ قَالَ يَٰقَوۡمِ إِنِّي بَرِيٓءٞ مِّمَّا تُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "فلما رءا الشمس بازغة قال هٰذا ربي هٰذا اكبر فلما افلت قال يٰقوم اني بريء مما تشركون",
    "ayahnumber" : "78",
