    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:326",
    "ayah_text" : "لَّا يَتَّخِذِ ٱلۡمُؤۡمِنُونَ ٱلۡكَٰفِرِينَ أَوۡلِيَآءَ مِن دُونِ ٱلۡمُؤۡمِنِينَۖ وَمَن يَفۡعَلۡ ذَٰلِكَ فَلَيۡسَ مِنَ ٱللَّهِ فِي شَيۡءٍ إِلَّآ أَن تَتَّقُواْ مِنۡهُمۡ تُقَىٰةٗۗ وَيُحَذِّرُكُمُ ٱللَّهُ نَفۡسَهُۥۗ وَإِلَى ٱللَّهِ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "لا يتخذ المؤمنون الكٰفرين اولياء من دون المؤمنين ومن يفعل ذٰلك فليس من الله في شيء الا ان تتقوا منهم تقىٰة ويحذركم الله نفسه والى الله المصير",
    "ayahnumber" : "28",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "326",
    "page" : "53",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3260",
    "ayah_text" : "قَالُواْ تَقَاسَمُواْ بِٱللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهۡلَهُۥ ثُمَّ لَنَقُولَنَّ لِوَلِيِّهِۦ مَا شَهِدۡنَا مَهۡلِكَ أَهۡلِهِۦ وَإِنَّا لَصَٰدِقُونَ",
    "ayah_text_no_diacratic" : "قالوا تقاسموا بالله لنبيتنه واهله ثم لنقولن لوليه ما شهدنا مهلك اهله وانا لصٰدقون",
    "ayahnumber" : "49",
    "chapter" : "19",
    "hizb" : "38",
