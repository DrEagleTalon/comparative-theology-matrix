    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4215",
    "ayah_text" : "مَا يُجَٰدِلُ فِيٓ ءَايَٰتِ ٱللَّهِ إِلَّا ٱلَّذِينَ كَفَرُواْ فَلَا يَغۡرُرۡكَ تَقَلُّبُهُمۡ فِي ٱلۡبِلَٰدِ",
    "ayah_text_no_diacratic" : "ما يجٰدل في ءايٰت الله الا الذين كفروا فلا يغررك تقلبهم في البلٰد",
    "ayahnumber" : "4",
