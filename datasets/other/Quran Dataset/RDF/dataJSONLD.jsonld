  }, {
    "@id" : "quran:4094",
    "ayah_text" : "جَنَّٰتِ عَدۡنٖ مُّفَتَّحَةٗ لَّهُمُ ٱلۡأَبۡوَٰبُ",
    "ayah_text_no_diacratic" : "جنٰت عدن مفتحة لهم الابوٰب",
