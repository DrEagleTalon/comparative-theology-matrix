    "surrahname_no_diacratic" : "سورة الحاقة"
  }, {
    "@id" : "quran:5469",
    "ayah_text" : "فَعَصَوۡاْ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةٗ رَّابِيَةً",
    "ayah_text_no_diacratic" : "فعصوا رسول ربهم فاخذهم اخذة رابية",
    "ayahnumber" : "10",
