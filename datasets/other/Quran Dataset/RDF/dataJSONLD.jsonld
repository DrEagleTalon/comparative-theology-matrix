    "page" : "334",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:2659",
    "ayah_text" : "كُلَّمَآ أَرَادُوٓاْ أَن يَخۡرُجُواْ مِنۡهَا مِنۡ غَمٍّ أُعِيدُواْ فِيهَا وَذُوقُواْ عَذَابَ ٱلۡحَرِيقِ",
    "ayah_text_no_diacratic" : "كلما ارادوا ان يخرجوا منها من غم اعيدوا فيها وذوقوا عذاب الحريق",
    "ayahnumber" : "22",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2659",
    "page" : "334",
    "surahname" : "سُورَةُ الحَجِّ",
    "surahnumber" : "22",
    "surrahname_no_diacratic" : "سورة الحج"
  }, {
    "@id" : "quran:266",
    "ayah_text" : "لَآ إِكۡرَاهَ فِي ٱلدِّينِۖ قَد تَّبَيَّنَ ٱلرُّشۡدُ مِنَ ٱلۡغَيِّۚ فَمَن يَكۡفُرۡ بِٱلطَّٰغُوتِ وَيُؤۡمِنۢ بِٱللَّهِ فَقَدِ ٱسۡتَمۡسَكَ بِٱلۡعُرۡوَةِ ٱلۡوُثۡقَىٰ لَا ٱنفِصَامَ لَهَاۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ",
    "ayah_text_no_diacratic" : "لا اكراه في الدين قد تبين الرشد من الغي فمن يكفر بالطٰغوت ويؤمن بالله فقد استمسك بالعروة الوثقىٰ لا انفصام لها والله سميع عليم",
    "ayahnumber" : "256",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "266",
    "page" : "42",
    "surahname" : "سُورَةُ البَقَرَةِ",
