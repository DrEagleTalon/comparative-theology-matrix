  }, {
    "@id" : "quran:2753",
    "ayah_text" : "۞هَيۡهَاتَ هَيۡهَاتَ لِمَا تُوعَدُونَ",
    "ayah_text_no_diacratic" : "هيهات هيهات لما توعدون",
    "ayahnumber" : "36",
    "chapter" : "18",
