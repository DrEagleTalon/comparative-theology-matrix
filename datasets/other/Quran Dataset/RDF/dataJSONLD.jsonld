  }, {
    "@id" : "quran:3972",
    "ayah_text" : "وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "وبشرنٰه باسحٰق نبيا من الصٰلحين",
