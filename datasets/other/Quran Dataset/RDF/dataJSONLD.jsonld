    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4816",
    "ayah_text" : "وَفِي عَادٍ إِذۡ أَرۡسَلۡنَا عَلَيۡهِمُ ٱلرِّيحَ ٱلۡعَقِيمَ",
    "ayah_text_no_diacratic" : "وفي عاد اذ ارسلنا عليهم الريح العقيم",
