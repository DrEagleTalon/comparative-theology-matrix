    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3911",
    "ayah_text" : "قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ",
    "ayah_text_no_diacratic" : "قال قائل منهم اني كان لي قرين",
    "ayahnumber" : "51",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3911",
