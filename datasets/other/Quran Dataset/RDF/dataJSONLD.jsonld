  }, {
    "@id" : "quran:1383",
    "ayah_text" : "الٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡحَكِيمِ",
    "ayah_text_no_diacratic" : "الر تلك ءايٰت الكتٰب الحكيم",
