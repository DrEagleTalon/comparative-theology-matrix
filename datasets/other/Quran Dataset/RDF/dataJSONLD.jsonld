  }, {
    "@id" : "quran:1791",
    "ayah_text" : "وَٱسۡتَفۡتَحُواْ وَخَابَ كُلُّ جَبَّارٍ عَنِيدٖ",
    "ayah_text_no_diacratic" : "واستفتحوا وخاب كل جبار عنيد",
