    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1770",
    "ayah_text" : "يَمۡحُواْ ٱللَّهُ مَا يَشَآءُ وَيُثۡبِتُۖ وَعِندَهُۥٓ أُمُّ ٱلۡكِتَٰبِ",
    "ayah_text_no_diacratic" : "يمحوا الله ما يشاء ويثبت وعنده ام الكتٰب",
    "ayahnumber" : "39",
    "chapter" : "13",
