    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:389",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ وَمَاتُواْ وَهُمۡ كُفَّارٞ فَلَن يُقۡبَلَ مِنۡ أَحَدِهِم مِّلۡءُ ٱلۡأَرۡضِ ذَهَبٗا وَلَوِ ٱفۡتَدَىٰ بِهِۦٓۗ أُوْلَٰٓئِكَ لَهُمۡ عَذَابٌ أَلِيمٞ وَمَا لَهُم مِّن نَّٰصِرِينَ",
    "ayah_text_no_diacratic" : "ان الذين كفروا وماتوا وهم كفار فلن يقبل من احدهم ملء الارض ذهبا ولو افتدىٰ به اولٰئك لهم عذاب اليم وما لهم من نٰصرين",
    "ayahnumber" : "91",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "389",
    "page" : "61",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3890",
    "ayah_text" : "وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ",
    "ayah_text_no_diacratic" : "وما كان لنا عليكم من سلطٰن بل كنتم قوما طٰغين",
    "ayahnumber" : "30",
