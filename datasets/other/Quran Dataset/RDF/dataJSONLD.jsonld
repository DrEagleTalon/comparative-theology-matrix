    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2915",
    "ayah_text" : "إِذَا رَأَتۡهُم مِّن مَّكَانِۭ بَعِيدٖ سَمِعُواْ لَهَا تَغَيُّظٗا وَزَفِيرٗا",
    "ayah_text_no_diacratic" : "اذا راتهم من مكان بعيد سمعوا لها تغيظا وزفيرا",
    "ayahnumber" : "12",
    "chapter" : "18",
    "hizb" : "36",
