    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3157",
    "ayah_text" : "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
