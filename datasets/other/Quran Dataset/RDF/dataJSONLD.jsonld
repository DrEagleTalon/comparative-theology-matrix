    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3882",
    "ayah_text" : "۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "احشروا الذين ظلموا وازوٰجهم وما كانوا يعبدون",
    "ayahnumber" : "22",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3882",
    "page" : "446",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3883",
    "ayah_text" : "مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "من دون الله فاهدوهم الىٰ صرٰط الجحيم",
