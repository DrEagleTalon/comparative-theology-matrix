    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4386",
    "ayah_text" : "وَمِنۡ ءَايَٰتِهِ ٱلۡجَوَارِ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ",
    "ayah_text_no_diacratic" : "ومن ءايٰته الجوار في البحر كالاعلٰم",
    "ayahnumber" : "32",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4386",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4387",
    "ayah_text" : "إِن يَشَأۡ يُسۡكِنِ ٱلرِّيحَ فَيَظۡلَلۡنَ رَوَاكِدَ عَلَىٰ ظَهۡرِهِۦٓۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّكُلِّ صَبَّارٖ شَكُورٍ",
    "ayah_text_no_diacratic" : "ان يشا يسكن الريح فيظللن رواكد علىٰ ظهره ان في ذٰلك لايٰت لكل صبار شكور",
    "ayahnumber" : "33",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4387",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4388",
    "ayah_text" : "أَوۡ يُوبِقۡهُنَّ بِمَا كَسَبُواْ وَيَعۡفُ عَن كَثِيرٖ",
    "ayah_text_no_diacratic" : "او يوبقهن بما كسبوا ويعف عن كثير",
    "ayahnumber" : "34",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4388",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4389",
    "ayah_text" : "وَيَعۡلَمَ ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِنَا مَا لَهُم مِّن مَّحِيصٖ",
    "ayah_text_no_diacratic" : "ويعلم الذين يجٰدلون في ءايٰتنا ما لهم من محيص",
    "ayahnumber" : "35",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4389",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:439",
    "ayah_text" : "وَلِيُمَحِّصَ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ وَيَمۡحَقَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "وليمحص الله الذين ءامنوا ويمحق الكٰفرين",
    "ayahnumber" : "141",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "439",
    "page" : "68",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4390",
    "ayah_text" : "فَمَآ أُوتِيتُم مِّن شَيۡءٖ فَمَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَمَا عِندَ ٱللَّهِ خَيۡرٞ وَأَبۡقَىٰ لِلَّذِينَ ءَامَنُواْ وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ",
    "ayah_text_no_diacratic" : "فما اوتيتم من شيء فمتٰع الحيوٰة الدنيا وما عند الله خير وابقىٰ للذين ءامنوا وعلىٰ ربهم يتوكلون",
    "ayahnumber" : "36",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4390",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4391",
    "ayah_text" : "وَٱلَّذِينَ يَجۡتَنِبُونَ كَبَٰٓئِرَ ٱلۡإِثۡمِ وَٱلۡفَوَٰحِشَ وَإِذَا مَا غَضِبُواْ هُمۡ يَغۡفِرُونَ",
    "ayah_text_no_diacratic" : "والذين يجتنبون كبٰئر الاثم والفوٰحش واذا ما غضبوا هم يغفرون",
    "ayahnumber" : "37",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4391",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4392",
    "ayah_text" : "وَٱلَّذِينَ ٱسۡتَجَابُواْ لِرَبِّهِمۡ وَأَقَامُواْ ٱلصَّلَوٰةَ وَأَمۡرُهُمۡ شُورَىٰ بَيۡنَهُمۡ وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ",
    "ayah_text_no_diacratic" : "والذين استجابوا لربهم واقاموا الصلوٰة وامرهم شورىٰ بينهم ومما رزقنٰهم ينفقون",
    "ayahnumber" : "38",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4392",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4393",
    "ayah_text" : "وَٱلَّذِينَ إِذَآ أَصَابَهُمُ ٱلۡبَغۡيُ هُمۡ يَنتَصِرُونَ",
    "ayah_text_no_diacratic" : "والذين اذا اصابهم البغي هم ينتصرون",
    "ayahnumber" : "39",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4393",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4394",
    "ayah_text" : "وَجَزَٰٓؤُاْ سَيِّئَةٖ سَيِّئَةٞ مِّثۡلُهَاۖ فَمَنۡ عَفَا وَأَصۡلَحَ فَأَجۡرُهُۥ عَلَى ٱللَّهِۚ إِنَّهُۥ لَا يُحِبُّ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "وجزٰؤا سيئة سيئة مثلها فمن عفا واصلح فاجره على الله انه لا يحب الظٰلمين",
    "ayahnumber" : "40",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4394",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4395",
    "ayah_text" : "وَلَمَنِ ٱنتَصَرَ بَعۡدَ ظُلۡمِهِۦ فَأُوْلَٰٓئِكَ مَا عَلَيۡهِم مِّن سَبِيلٍ",
    "ayah_text_no_diacratic" : "ولمن انتصر بعد ظلمه فاولٰئك ما عليهم من سبيل",
    "ayahnumber" : "41",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4395",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4396",
    "ayah_text" : "إِنَّمَا ٱلسَّبِيلُ عَلَى ٱلَّذِينَ يَظۡلِمُونَ ٱلنَّاسَ وَيَبۡغُونَ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّۚ أُوْلَٰٓئِكَ لَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "انما السبيل على الذين يظلمون الناس ويبغون في الارض بغير الحق اولٰئك لهم عذاب اليم",
    "ayahnumber" : "42",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4396",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4397",
    "ayah_text" : "وَلَمَن صَبَرَ وَغَفَرَ إِنَّ ذَٰلِكَ لَمِنۡ عَزۡمِ ٱلۡأُمُورِ",
    "ayah_text_no_diacratic" : "ولمن صبر وغفر ان ذٰلك لمن عزم الامور",
    "ayahnumber" : "43",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4397",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4398",
    "ayah_text" : "وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِن وَلِيّٖ مِّنۢ بَعۡدِهِۦۗ وَتَرَى ٱلظَّٰلِمِينَ لَمَّا رَأَوُاْ ٱلۡعَذَابَ يَقُولُونَ هَلۡ إِلَىٰ مَرَدّٖ مِّن سَبِيلٖ",
    "ayah_text_no_diacratic" : "ومن يضلل الله فما له من ولي من بعده وترى الظٰلمين لما راوا العذاب يقولون هل الىٰ مرد من سبيل",
    "ayahnumber" : "44",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4398",
    "page" : "487",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4399",
    "ayah_text" : "وَتَرَىٰهُمۡ يُعۡرَضُونَ عَلَيۡهَا خَٰشِعِينَ مِنَ ٱلذُّلِّ يَنظُرُونَ مِن طَرۡفٍ خَفِيّٖۗ وَقَالَ ٱلَّذِينَ ءَامَنُوٓاْ إِنَّ ٱلۡخَٰسِرِينَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ وَأَهۡلِيهِمۡ يَوۡمَ ٱلۡقِيَٰمَةِۗ أَلَآ إِنَّ ٱلظَّٰلِمِينَ فِي عَذَابٖ مُّقِيمٖ",
    "ayah_text_no_diacratic" : "وترىٰهم يعرضون عليها خٰشعين من الذل ينظرون من طرف خفي وقال الذين ءامنوا ان الخٰسرين الذين خسروا انفسهم واهليهم يوم القيٰمة الا ان الظٰلمين في عذاب مقيم",
    "ayahnumber" : "45",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4399",
    "page" : "488",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:44",
    "ayah_text" : "وَإِذۡ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ أَبَىٰ وَٱسۡتَكۡبَرَ وَكَانَ مِنَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "واذ قلنا للملٰئكة اسجدوا لادم فسجدوا الا ابليس ابىٰ واستكبر وكان من الكٰفرين",
    "ayahnumber" : "34",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "44",
    "page" : "6",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:440",
    "ayah_text" : "أَمۡ حَسِبۡتُمۡ أَن تَدۡخُلُواْ ٱلۡجَنَّةَ وَلَمَّا يَعۡلَمِ ٱللَّهُ ٱلَّذِينَ جَٰهَدُواْ مِنكُمۡ وَيَعۡلَمَ ٱلصَّٰبِرِينَ",
    "ayah_text_no_diacratic" : "ام حسبتم ان تدخلوا الجنة ولما يعلم الله الذين جٰهدوا منكم ويعلم الصٰبرين",
    "ayahnumber" : "142",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "440",
    "page" : "68",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4400",
    "ayah_text" : "وَمَا كَانَ لَهُم مِّنۡ أَوۡلِيَآءَ يَنصُرُونَهُم مِّن دُونِ ٱللَّهِۗ وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِن سَبِيلٍ",
    "ayah_text_no_diacratic" : "وما كان لهم من اولياء ينصرونهم من دون الله ومن يضلل الله فما له من سبيل",
    "ayahnumber" : "46",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4400",
    "page" : "488",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4401",
    "ayah_text" : "ٱسۡتَجِيبُواْ لِرَبِّكُم مِّن قَبۡلِ أَن يَأۡتِيَ يَوۡمٞ لَّا مَرَدَّ لَهُۥ مِنَ ٱللَّهِۚ مَا لَكُم مِّن مَّلۡجَإٖ يَوۡمَئِذٖ وَمَا لَكُم مِّن نَّكِيرٖ",
    "ayah_text_no_diacratic" : "استجيبوا لربكم من قبل ان ياتي يوم لا مرد له من الله ما لكم من ملجا يومئذ وما لكم من نكير",
    "ayahnumber" : "47",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4401",
    "page" : "488",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4402",
    "ayah_text" : "فَإِنۡ أَعۡرَضُواْ فَمَآ أَرۡسَلۡنَٰكَ عَلَيۡهِمۡ حَفِيظًاۖ إِنۡ عَلَيۡكَ إِلَّا ٱلۡبَلَٰغُۗ وَإِنَّآ إِذَآ أَذَقۡنَا ٱلۡإِنسَٰنَ مِنَّا رَحۡمَةٗ فَرِحَ بِهَاۖ وَإِن تُصِبۡهُمۡ سَيِّئَةُۢ بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ فَإِنَّ ٱلۡإِنسَٰنَ كَفُورٞ",
    "ayah_text_no_diacratic" : "فان اعرضوا فما ارسلنٰك عليهم حفيظا ان عليك الا البلٰغ وانا اذا اذقنا الانسٰن منا رحمة فرح بها وان تصبهم سيئة بما قدمت ايديهم فان الانسٰن كفور",
    "ayahnumber" : "48",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4402",
    "page" : "488",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4403",
    "ayah_text" : "لِّلَّهِ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ يَخۡلُقُ مَا يَشَآءُۚ يَهَبُ لِمَن يَشَآءُ إِنَٰثٗا وَيَهَبُ لِمَن يَشَآءُ ٱلذُّكُورَ",
    "ayah_text_no_diacratic" : "لله ملك السمٰوٰت والارض يخلق ما يشاء يهب لمن يشاء انٰثا ويهب لمن يشاء الذكور",
    "ayahnumber" : "49",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4403",
    "page" : "488",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4404",
    "ayah_text" : "أَوۡ يُزَوِّجُهُمۡ ذُكۡرَانٗا وَإِنَٰثٗاۖ وَيَجۡعَلُ مَن يَشَآءُ عَقِيمًاۚ إِنَّهُۥ عَلِيمٞ قَدِيرٞ",
    "ayah_text_no_diacratic" : "او يزوجهم ذكرانا وانٰثا ويجعل من يشاء عقيما انه عليم قدير",
    "ayahnumber" : "50",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4404",
    "page" : "488",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4405",
    "ayah_text" : "۞وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ ٱللَّهُ إِلَّا وَحۡيًا أَوۡ مِن وَرَآيِٕ حِجَابٍ أَوۡ يُرۡسِلَ رَسُولٗا فَيُوحِيَ بِإِذۡنِهِۦ مَا يَشَآءُۚ إِنَّهُۥ عَلِيٌّ حَكِيمٞ",
    "ayah_text_no_diacratic" : "وما كان لبشر ان يكلمه الله الا وحيا او من وراي حجاب او يرسل رسولا فيوحي باذنه ما يشاء انه علي حكيم",
    "ayahnumber" : "51",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4405",
    "page" : "488",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4406",
    "ayah_text" : "وَكَذَٰلِكَ أَوۡحَيۡنَآ إِلَيۡكَ رُوحٗا مِّنۡ أَمۡرِنَاۚ مَا كُنتَ تَدۡرِي مَا ٱلۡكِتَٰبُ وَلَا ٱلۡإِيمَٰنُ وَلَٰكِن جَعَلۡنَٰهُ نُورٗا نَّهۡدِي بِهِۦ مَن نَّشَآءُ مِنۡ عِبَادِنَاۚ وَإِنَّكَ لَتَهۡدِيٓ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "وكذٰلك اوحينا اليك روحا من امرنا ما كنت تدري ما الكتٰب ولا الايمٰن ولٰكن جعلنٰه نورا نهدي به من نشاء من عبادنا وانك لتهدي الىٰ صرٰط مستقيم",
    "ayahnumber" : "52",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4406",
    "page" : "489",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4407",
    "ayah_text" : "صِرَٰطِ ٱللَّهِ ٱلَّذِي لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ أَلَآ إِلَى ٱللَّهِ تَصِيرُ ٱلۡأُمُورُ",
    "ayah_text_no_diacratic" : "صرٰط الله الذي له ما في السمٰوٰت وما في الارض الا الى الله تصير الامور",
    "ayahnumber" : "53",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4407",
    "page" : "489",
    "surahname" : "سُورَةُ الشُّورَىٰ",
