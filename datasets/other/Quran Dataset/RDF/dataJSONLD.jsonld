  }, {
    "@id" : "quran:4696",
    "ayah_text" : "وَمَغَانِمَ كَثِيرَةٗ يَأۡخُذُونَهَاۗ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمٗا",
    "ayah_text_no_diacratic" : "ومغانم كثيرة ياخذونها وكان الله عزيزا حكيما",
