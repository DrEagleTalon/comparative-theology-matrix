    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3946",
    "ayah_text" : "أَئِفۡكًا ءَالِهَةٗ دُونَ ٱللَّهِ تُرِيدُونَ",
