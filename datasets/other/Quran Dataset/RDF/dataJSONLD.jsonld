    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:397",
    "ayah_text" : "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لِمَ تَصُدُّونَ عَن سَبِيلِ ٱللَّهِ مَنۡ ءَامَنَ تَبۡغُونَهَا عِوَجٗا وَأَنتُمۡ شُهَدَآءُۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "قل يٰاهل الكتٰب لم تصدون عن سبيل الله من ءامن تبغونها عوجا وانتم شهداء وما الله بغٰفل عما تعملون",
    "ayahnumber" : "99",
    "chapter" : "4",
