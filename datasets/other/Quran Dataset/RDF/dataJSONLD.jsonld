    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1060",
    "ayah_text" : "فَتَوَلَّىٰ عَنۡهُمۡ وَقَالَ يَٰقَوۡمِ لَقَدۡ أَبۡلَغۡتُكُمۡ رِسَٰلَٰتِ رَبِّي وَنَصَحۡتُ لَكُمۡۖ فَكَيۡفَ ءَاسَىٰ عَلَىٰ قَوۡمٖ كَٰفِرِينَ",
    "ayah_text_no_diacratic" : "فتولىٰ عنهم وقال يٰقوم لقد ابلغتكم رسٰلٰت ربي ونصحت لكم فكيف ءاسىٰ علىٰ قوم كٰفرين",
    "ayahnumber" : "93",
