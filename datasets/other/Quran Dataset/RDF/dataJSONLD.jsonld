  }, {
    "@id" : "quran:4125",
    "ayah_text" : "إِلَىٰ يَوۡمِ ٱلۡوَقۡتِ ٱلۡمَعۡلُومِ",
    "ayah_text_no_diacratic" : "الىٰ يوم الوقت المعلوم",
