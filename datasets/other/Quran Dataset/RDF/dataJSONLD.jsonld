    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5341",
    "ayah_text" : "فَٱتَّقُواْ ٱللَّهَ مَا ٱسۡتَطَعۡتُمۡ وَٱسۡمَعُواْ وَأَطِيعُواْ وَأَنفِقُواْ خَيۡرٗا لِّأَنفُسِكُمۡۗ وَمَن يُوقَ شُحَّ نَفۡسِهِۦ فَأُوْلَٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "فاتقوا الله ما استطعتم واسمعوا واطيعوا وانفقوا خيرا لانفسكم ومن يوق شح نفسه فاولٰئك هم المفلحون",
    "ayahnumber" : "16",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5341",
    "page" : "557",
    "surahname" : "سُورَةُ التَّغَابُنِ",
    "surahnumber" : "64",
    "surrahname_no_diacratic" : "سورة التغابن"
  }, {
    "@id" : "quran:5342",
    "ayah_text" : "إِن تُقۡرِضُواْ ٱللَّهَ قَرۡضًا حَسَنٗا يُضَٰعِفۡهُ لَكُمۡ وَيَغۡفِرۡ لَكُمۡۚ وَٱللَّهُ شَكُورٌ حَلِيمٌ",
    "ayah_text_no_diacratic" : "ان تقرضوا الله قرضا حسنا يضٰعفه لكم ويغفر لكم والله شكور حليم",
    "ayahnumber" : "17",
    "chapter" : "28",
