    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4717",
    "ayah_text" : "وَإِن طَآئِفَتَانِ مِنَ ٱلۡمُؤۡمِنِينَ ٱقۡتَتَلُواْ فَأَصۡلِحُواْ بَيۡنَهُمَاۖ فَإِنۢ بَغَتۡ إِحۡدَىٰهُمَا عَلَى ٱلۡأُخۡرَىٰ فَقَٰتِلُواْ ٱلَّتِي تَبۡغِي حَتَّىٰ تَفِيٓءَ إِلَىٰٓ أَمۡرِ ٱللَّهِۚ فَإِن فَآءَتۡ فَأَصۡلِحُواْ بَيۡنَهُمَا بِٱلۡعَدۡلِ وَأَقۡسِطُوٓاْۖ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُقۡسِطِينَ",
    "ayah_text_no_diacratic" : "وان طائفتان من المؤمنين اقتتلوا فاصلحوا بينهما فان بغت احدىٰهما على الاخرىٰ فقٰتلوا التي تبغي حتىٰ تفيء الىٰ امر الله فان فاءت فاصلحوا بينهما بالعدل واقسطوا ان الله يحب المقسطين",
    "ayahnumber" : "9",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4717",
    "page" : "516",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4718",
    "ayah_text" : "إِنَّمَا ٱلۡمُؤۡمِنُونَ إِخۡوَةٞ فَأَصۡلِحُواْ بَيۡنَ أَخَوَيۡكُمۡۚ وَٱتَّقُواْ ٱللَّهَ لَعَلَّكُمۡ تُرۡحَمُونَ",
    "ayah_text_no_diacratic" : "انما المؤمنون اخوة فاصلحوا بين اخويكم واتقوا الله لعلكم ترحمون",
    "ayahnumber" : "10",
    "chapter" : "26",
    "hizb" : "51",
