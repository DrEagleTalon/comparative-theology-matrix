    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2301",
    "ayah_text" : "وَسَلَٰمٌ عَلَيۡهِ يَوۡمَ وُلِدَ وَيَوۡمَ يَمُوتُ وَيَوۡمَ يُبۡعَثُ حَيّٗا",
    "ayah_text_no_diacratic" : "وسلٰم عليه يوم ولد ويوم يموت ويوم يبعث حيا",
    "ayahnumber" : "15",
    "chapter" : "16",
    "hizb" : "30",
