    "page" : "408",
    "surahname" : "سُورَةُ الرُّومِ",
    "surahnumber" : "30",
    "surrahname_no_diacratic" : "سورة الروم"
  }, {
    "@id" : "quran:3504",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ أَنَّ ٱللَّهَ يَبۡسُطُ ٱلرِّزۡقَ لِمَن يَشَآءُ وَيَقۡدِرُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "اولم يروا ان الله يبسط الرزق لمن يشاء ويقدر ان في ذٰلك لايٰت لقوم يؤمنون",
    "ayahnumber" : "37",
    "chapter" : "21",
    "hizb" : "40",
