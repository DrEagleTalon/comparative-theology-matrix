    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1329",
    "ayah_text" : "أَلَمۡ يَعۡلَمُوٓاْ أَنَّ ٱللَّهَ يَعۡلَمُ سِرَّهُمۡ وَنَجۡوَىٰهُمۡ وَأَنَّ ٱللَّهَ عَلَّٰمُ ٱلۡغُيُوبِ",
    "ayah_text_no_diacratic" : "الم يعلموا ان الله يعلم سرهم ونجوىٰهم وان الله علٰم الغيوب",
    "ayahnumber" : "78",
    "chapter" : "10",
