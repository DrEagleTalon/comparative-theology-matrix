  }, {
    "@id" : "quran:4021",
    "ayah_text" : "فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "فانكم وما تعبدون",
    "ayahnumber" : "161",
