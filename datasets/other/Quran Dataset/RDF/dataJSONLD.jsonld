    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:879",
    "ayah_text" : "إِنِّي وَجَّهۡتُ وَجۡهِيَ لِلَّذِي فَطَرَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ حَنِيفٗاۖ وَمَآ أَنَا۠ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "اني وجهت وجهي للذي فطر السمٰوٰت والارض حنيفا وما انا من المشركين",
