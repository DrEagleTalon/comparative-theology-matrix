  }, {
    "@id" : "quran:4213",
    "ayah_text" : "تَنزِيلُ ٱلۡكِتَٰبِ مِنَ ٱللَّهِ ٱلۡعَزِيزِ ٱلۡعَلِيمِ",
    "ayah_text_no_diacratic" : "تنزيل الكتٰب من الله العزيز العليم",
