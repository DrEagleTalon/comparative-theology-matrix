    "surahname" : "سُورَةُ المَعَارِجِ",
    "surahnumber" : "70",
    "surrahname_no_diacratic" : "سورة المعارج"
  }, {
    "@id" : "quran:5554",
    "ayah_text" : "عَلَىٰٓ أَن نُّبَدِّلَ خَيۡرٗا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ",
    "ayah_text_no_diacratic" : "علىٰ ان نبدل خيرا منهم وما نحن بمسبوقين",
