    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:441",
    "ayah_text" : "وَلَقَدۡ كُنتُمۡ تَمَنَّوۡنَ ٱلۡمَوۡتَ مِن قَبۡلِ أَن تَلۡقَوۡهُ فَقَدۡ رَأَيۡتُمُوهُ وَأَنتُمۡ تَنظُرُونَ",
    "ayah_text_no_diacratic" : "ولقد كنتم تمنون الموت من قبل ان تلقوه فقد رايتموه وانتم تنظرون",
    "ayahnumber" : "143",
