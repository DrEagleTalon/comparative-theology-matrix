    "surahname" : "سُورَةُ البُرُوجِ",
    "surahnumber" : "85",
    "surrahname_no_diacratic" : "سورة البروج"
  }, {
    "@id" : "quran:6087",
    "ayah_text" : "إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ",
    "ayah_text_no_diacratic" : "ان الذين فتنوا المؤمنين والمؤمنٰت ثم لم يتوبوا فلهم عذاب جهنم ولهم عذاب الحريق",
    "ayahnumber" : "10",
