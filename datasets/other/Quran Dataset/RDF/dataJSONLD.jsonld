    "surrahname_no_diacratic" : "سورة النصر"
  }, {
    "@id" : "quran:643",
    "ayah_text" : "مُّذَبۡذَبِينَ بَيۡنَ ذَٰلِكَ لَآ إِلَىٰ هَٰٓؤُلَآءِ وَلَآ إِلَىٰ هَٰٓؤُلَآءِۚ وَمَن يُضۡلِلِ ٱللَّهُ فَلَن تَجِدَ لَهُۥ سَبِيلٗا",
    "ayah_text_no_diacratic" : "مذبذبين بين ذٰلك لا الىٰ هٰؤلاء ولا الىٰ هٰؤلاء ومن يضلل الله فلن تجد له سبيلا",
