    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4868",
    "ayah_text" : "قُلۡ تَرَبَّصُواْ فَإِنِّي مَعَكُم مِّنَ ٱلۡمُتَرَبِّصِينَ",
    "ayah_text_no_diacratic" : "قل تربصوا فاني معكم من المتربصين",
    "ayahnumber" : "31",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4868",
