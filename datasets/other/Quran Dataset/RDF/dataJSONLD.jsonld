    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1197",
    "ayah_text" : "۞إِنَّ شَرَّ ٱلدَّوَآبِّ عِندَ ٱللَّهِ ٱلصُّمُّ ٱلۡبُكۡمُ ٱلَّذِينَ لَا يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ان شر الدواب عند الله الصم البكم الذين لا يعقلون",
