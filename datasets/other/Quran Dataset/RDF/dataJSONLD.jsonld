  }, {
    "@id" : "quran:1489",
    "ayah_text" : "وَإِن يَمۡسَسۡكَ ٱللَّهُ بِضُرّٖ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَۖ وَإِن يُرِدۡكَ بِخَيۡرٖ فَلَا رَآدَّ لِفَضۡلِهِۦۚ يُصِيبُ بِهِۦ مَن يَشَآءُ مِنۡ عِبَادِهِۦۚ وَهُوَ ٱلۡغَفُورُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "وان يمسسك الله بضر فلا كاشف له الا هو وان يردك بخير فلا راد لفضله يصيب به من يشاء من عباده وهو الغفور الرحيم",
    "ayahnumber" : "107",
    "chapter" : "11",
    "hizb" : "22",
    "index" : "1489",
    "page" : "221",
    "surahname" : "سُورَةُ يُونُسَ",
    "surahnumber" : "10",
    "surrahname_no_diacratic" : "سورة يونس"
  }, {
    "@id" : "quran:149",
    "ayah_text" : "قُلۡ أَتُحَآجُّونَنَا فِي ٱللَّهِ وَهُوَ رَبُّنَا وَرَبُّكُمۡ وَلَنَآ أَعۡمَٰلُنَا وَلَكُمۡ أَعۡمَٰلُكُمۡ وَنَحۡنُ لَهُۥ مُخۡلِصُونَ",
    "ayah_text_no_diacratic" : "قل اتحاجوننا في الله وهو ربنا وربكم ولنا اعمٰلنا ولكم اعمٰلكم ونحن له مخلصون",
    "ayahnumber" : "139",
    "chapter" : "1",
    "hizb" : "2",
    "index" : "149",
    "page" : "21",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1490",
    "ayah_text" : "قُلۡ يَٰٓأَيُّهَا ٱلنَّاسُ قَدۡ جَآءَكُمُ ٱلۡحَقُّ مِن رَّبِّكُمۡۖ فَمَنِ ٱهۡتَدَىٰ فَإِنَّمَا يَهۡتَدِي لِنَفۡسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيۡهَاۖ وَمَآ أَنَا۠ عَلَيۡكُم بِوَكِيلٖ",
    "ayah_text_no_diacratic" : "قل يٰايها الناس قد جاءكم الحق من ربكم فمن اهتدىٰ فانما يهتدي لنفسه ومن ضل فانما يضل عليها وما انا عليكم بوكيل",
    "ayahnumber" : "108",
    "chapter" : "11",
    "hizb" : "22",
