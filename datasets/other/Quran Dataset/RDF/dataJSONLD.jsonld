    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5443",
    "ayah_text" : "إِنَّ لَكُمۡ فِيهِ لَمَا تَخَيَّرُونَ",
    "ayah_text_no_diacratic" : "ان لكم فيه لما تخيرون",
