    "surahnumber" : "47",
    "surrahname_no_diacratic" : "سورة محمد"
  }, {
    "@id" : "quran:4648",
    "ayah_text" : "ذَٰلِكَ بِأَنَّ ٱللَّهَ مَوۡلَى ٱلَّذِينَ ءَامَنُواْ وَأَنَّ ٱلۡكَٰفِرِينَ لَا مَوۡلَىٰ لَهُمۡ",
    "ayah_text_no_diacratic" : "ذٰلك بان الله مولى الذين ءامنوا وان الكٰفرين لا مولىٰ لهم",
