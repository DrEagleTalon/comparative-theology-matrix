    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3962",
    "ayah_text" : "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ",
    "ayah_text_no_diacratic" : "فلما بلغ معه السعي قال يٰبني اني ارىٰ في المنام اني اذبحك فانظر ماذا ترىٰ قال يٰابت افعل ما تؤمر ستجدني ان شاء الله من الصٰبرين",
    "ayahnumber" : "102",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "3962",
    "page" : "449",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3963",
    "ayah_text" : "فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ",
    "ayah_text_no_diacratic" : "فلما اسلما وتله للجبين",
    "ayahnumber" : "103",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "3963",
    "page" : "450",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3964",
    "ayah_text" : "وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ",
    "ayah_text_no_diacratic" : "ونٰدينٰه ان يٰابرٰهيم",
    "ayahnumber" : "104",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "3964",
    "page" : "450",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3965",
    "ayah_text" : "قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "قد صدقت الرءيا انا كذٰلك نجزي المحسنين",
    "ayahnumber" : "105",
    "chapter" : "23",
    "hizb" : "45",
    "index" : "3965",
