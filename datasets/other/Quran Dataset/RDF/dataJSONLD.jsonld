  }, {
    "@id" : "quran:3019",
    "ayah_text" : "يَأۡتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٖ",
    "ayah_text_no_diacratic" : "ياتوك بكل سحار عليم",
