    "hizb" : "13",
    "index" : "875",
    "page" : "137",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:876",
    "ayah_text" : "فَلَمَّا جَنَّ عَلَيۡهِ ٱلَّيۡلُ رَءَا كَوۡكَبٗاۖ قَالَ هَٰذَا رَبِّيۖ فَلَمَّآ أَفَلَ قَالَ لَآ أُحِبُّ ٱلۡأٓفِلِينَ",
    "ayah_text_no_diacratic" : "فلما جن عليه اليل رءا كوكبا قال هٰذا ربي فلما افل قال لا احب الافلين",
    "ayahnumber" : "76",
    "chapter" : "7",
    "hizb" : "13",
    "index" : "876",
    "page" : "137",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:877",
    "ayah_text" : "فَلَمَّا رَءَا ٱلۡقَمَرَ بَازِغٗا قَالَ هَٰذَا رَبِّيۖ فَلَمَّآ أَفَلَ قَالَ لَئِن لَّمۡ يَهۡدِنِي رَبِّي لَأَكُونَنَّ مِنَ ٱلۡقَوۡمِ ٱلضَّآلِّينَ",
    "ayah_text_no_diacratic" : "فلما رءا القمر بازغا قال هٰذا ربي فلما افل قال لئن لم يهدني ربي لاكونن من القوم الضالين",
    "ayahnumber" : "77",
    "chapter" : "7",
    "hizb" : "13",
