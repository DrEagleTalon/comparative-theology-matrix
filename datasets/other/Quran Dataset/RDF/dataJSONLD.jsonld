    "page" : "516",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4719",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا يَسۡخَرۡ قَوۡمٞ مِّن قَوۡمٍ عَسَىٰٓ أَن يَكُونُواْ خَيۡرٗا مِّنۡهُمۡ وَلَا نِسَآءٞ مِّن نِّسَآءٍ عَسَىٰٓ أَن يَكُنَّ خَيۡرٗا مِّنۡهُنَّۖ وَلَا تَلۡمِزُوٓاْ أَنفُسَكُمۡ وَلَا تَنَابَزُواْ بِٱلۡأَلۡقَٰبِۖ بِئۡسَ ٱلِٱسۡمُ ٱلۡفُسُوقُ بَعۡدَ ٱلۡإِيمَٰنِۚ وَمَن لَّمۡ يَتُبۡ فَأُوْلَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا يسخر قوم من قوم عسىٰ ان يكونوا خيرا منهم ولا نساء من نساء عسىٰ ان يكن خيرا منهن ولا تلمزوا انفسكم ولا تنابزوا بالالقٰب بئس الاسم الفسوق بعد الايمٰن ومن لم يتب فاولٰئك هم الظٰلمون",
    "ayahnumber" : "11",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4719",
    "page" : "516",
    "surahname" : "سُورَةُ الحُجُرَاتِ",
    "surahnumber" : "49",
    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:472",
    "ayah_text" : "فَٱنقَلَبُواْ بِنِعۡمَةٖ مِّنَ ٱللَّهِ وَفَضۡلٖ لَّمۡ يَمۡسَسۡهُمۡ سُوٓءٞ وَٱتَّبَعُواْ رِضۡوَٰنَ ٱللَّهِۗ وَٱللَّهُ ذُو فَضۡلٍ عَظِيمٍ",
    "ayah_text_no_diacratic" : "فانقلبوا بنعمة من الله وفضل لم يمسسهم سوء واتبعوا رضوٰن الله والله ذو فضل عظيم",
