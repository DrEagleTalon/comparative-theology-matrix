    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3928",
    "ayah_text" : "ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "ثم ان مرجعهم لالى الجحيم",
    "ayahnumber" : "68",
    "chapter" : "23",
    "hizb" : "44",
