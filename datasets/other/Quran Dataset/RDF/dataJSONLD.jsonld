    "surahname" : "سُورَةُ الدُّخَانِ",
    "surahnumber" : "44",
    "surrahname_no_diacratic" : "سورة الدخان"
  }, {
    "@id" : "quran:4507",
    "ayah_text" : "رَبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُم مُّوقِنِينَ",
    "ayah_text_no_diacratic" : "رب السمٰوٰت والارض وما بينهما ان كنتم موقنين",
