    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:200",
    "ayah_text" : "وَقَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ ٱلَّذِينَ يُقَٰتِلُونَكُمۡ وَلَا تَعۡتَدُوٓاْۚ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلۡمُعۡتَدِينَ",
    "ayah_text_no_diacratic" : "وقٰتلوا في سبيل الله الذين يقٰتلونكم ولا تعتدوا ان الله لا يحب المعتدين",
    "ayahnumber" : "190",
