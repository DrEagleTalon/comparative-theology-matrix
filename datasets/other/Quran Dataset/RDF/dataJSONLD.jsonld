    "page" : "184",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1235",
    "ayah_text" : "وَأَعِدُّواْ لَهُم مَّا ٱسۡتَطَعۡتُم مِّن قُوَّةٖ وَمِن رِّبَاطِ ٱلۡخَيۡلِ تُرۡهِبُونَ بِهِۦ عَدُوَّ ٱللَّهِ وَعَدُوَّكُمۡ وَءَاخَرِينَ مِن دُونِهِمۡ لَا تَعۡلَمُونَهُمُ ٱللَّهُ يَعۡلَمُهُمۡۚ وَمَا تُنفِقُواْ مِن شَيۡءٖ فِي سَبِيلِ ٱللَّهِ يُوَفَّ إِلَيۡكُمۡ وَأَنتُمۡ لَا تُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "واعدوا لهم ما استطعتم من قوة ومن رباط الخيل ترهبون به عدو الله وعدوكم وءاخرين من دونهم لا تعلمونهم الله يعلمهم وما تنفقوا من شيء في سبيل الله يوف اليكم وانتم لا تظلمون",
    "ayahnumber" : "60",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1235",
    "page" : "184",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1236",
    "ayah_text" : "۞وَإِن جَنَحُواْ لِلسَّلۡمِ فَٱجۡنَحۡ لَهَا وَتَوَكَّلۡ عَلَى ٱللَّهِۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "وان جنحوا للسلم فاجنح لها وتوكل على الله انه هو السميع العليم",
    "ayahnumber" : "61",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1236",
    "page" : "184",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1237",
    "ayah_text" : "وَإِن يُرِيدُوٓاْ أَن يَخۡدَعُوكَ فَإِنَّ حَسۡبَكَ ٱللَّهُۚ هُوَ ٱلَّذِيٓ أَيَّدَكَ بِنَصۡرِهِۦ وَبِٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وان يريدوا ان يخدعوك فان حسبك الله هو الذي ايدك بنصره وبالمؤمنين",
    "ayahnumber" : "62",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1237",
    "page" : "185",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1238",
    "ayah_text" : "وَأَلَّفَ بَيۡنَ قُلُوبِهِمۡۚ لَوۡ أَنفَقۡتَ مَا فِي ٱلۡأَرۡضِ جَمِيعٗا مَّآ أَلَّفۡتَ بَيۡنَ قُلُوبِهِمۡ وَلَٰكِنَّ ٱللَّهَ أَلَّفَ بَيۡنَهُمۡۚ إِنَّهُۥ عَزِيزٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "والف بين قلوبهم لو انفقت ما في الارض جميعا ما الفت بين قلوبهم ولٰكن الله الف بينهم انه عزيز حكيم",
    "ayahnumber" : "63",
    "chapter" : "10",
    "hizb" : "18",
    "index" : "1238",
    "page" : "185",
    "surahname" : "سُورَةُ الأَنفَالِ",
    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1239",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ حَسۡبُكَ ٱللَّهُ وَمَنِ ٱتَّبَعَكَ مِنَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "يٰايها النبي حسبك الله ومن اتبعك من المؤمنين",
    "ayahnumber" : "64",
