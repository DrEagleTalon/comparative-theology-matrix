    "hizb" : "36",
    "index" : "3029",
    "page" : "369",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:303",
    "ayah_text" : "إِنَّ ٱللَّهَ لَا يَخۡفَىٰ عَلَيۡهِ شَيۡءٞ فِي ٱلۡأَرۡضِ وَلَا فِي ٱلسَّمَآءِ",
    "ayah_text_no_diacratic" : "ان الله لا يخفىٰ عليه شيء في الارض ولا في السماء",
    "ayahnumber" : "5",
