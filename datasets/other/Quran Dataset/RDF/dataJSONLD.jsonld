    "index" : "2037",
    "page" : "279",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2038",
    "ayah_text" : "ذَٰلِكَ بِأَنَّهُمُ ٱسۡتَحَبُّواْ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا عَلَى ٱلۡأٓخِرَةِ وَأَنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ذٰلك بانهم استحبوا الحيوٰة الدنيا على الاخرة وان الله لا يهدي القوم الكٰفرين",
