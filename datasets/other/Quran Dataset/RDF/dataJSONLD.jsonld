  }, {
    "@id" : "quran:3954",
    "ayah_text" : "فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ",
    "ayah_text_no_diacratic" : "فاقبلوا اليه يزفون",
