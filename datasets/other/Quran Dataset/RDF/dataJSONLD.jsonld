  }, {
    "@id" : "quran:6084",
    "ayah_text" : "وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودٞ",
    "ayah_text_no_diacratic" : "وهم علىٰ ما يفعلون بالمؤمنين شهود",
