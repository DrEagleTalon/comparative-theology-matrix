    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4383",
    "ayah_text" : "وَمِنۡ ءَايَٰتِهِۦ خَلۡقُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَثَّ فِيهِمَا مِن دَآبَّةٖۚ وَهُوَ عَلَىٰ جَمۡعِهِمۡ إِذَا يَشَآءُ قَدِيرٞ",
    "ayah_text_no_diacratic" : "ومن ءايٰته خلق السمٰوٰت والارض وما بث فيهما من دابة وهو علىٰ جمعهم اذا يشاء قدير",
    "ayahnumber" : "29",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4383",
    "page" : "486",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4384",
    "ayah_text" : "وَمَآ أَصَٰبَكُم مِّن مُّصِيبَةٖ فَبِمَا كَسَبَتۡ أَيۡدِيكُمۡ وَيَعۡفُواْ عَن كَثِيرٖ",
    "ayah_text_no_diacratic" : "وما اصٰبكم من مصيبة فبما كسبت ايديكم ويعفوا عن كثير",
    "ayahnumber" : "30",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4384",
    "page" : "486",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4385",
    "ayah_text" : "وَمَآ أَنتُم بِمُعۡجِزِينَ فِي ٱلۡأَرۡضِۖ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِيّٖ وَلَا نَصِيرٖ",
    "ayah_text_no_diacratic" : "وما انتم بمعجزين في الارض وما لكم من دون الله من ولي ولا نصير",
    "ayahnumber" : "31",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4385",
