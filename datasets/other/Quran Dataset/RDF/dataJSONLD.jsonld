    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:52",
    "ayah_text" : "وَلَا تَلۡبِسُواْ ٱلۡحَقَّ بِٱلۡبَٰطِلِ وَتَكۡتُمُواْ ٱلۡحَقَّ وَأَنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولا تلبسوا الحق بالبٰطل وتكتموا الحق وانتم تعلمون",
