    "surahname" : "سُورَةُ الجُمُعَةِ",
    "surahnumber" : "62",
    "surrahname_no_diacratic" : "سورة الجمعة"
  }, {
    "@id" : "quran:531",
    "ayah_text" : "إِن تَجۡتَنِبُواْ كَبَآئِرَ مَا تُنۡهَوۡنَ عَنۡهُ نُكَفِّرۡ عَنكُمۡ سَيِّـَٔاتِكُمۡ وَنُدۡخِلۡكُم مُّدۡخَلٗا كَرِيمٗا",
    "ayah_text_no_diacratic" : "ان تجتنبوا كبائر ما تنهون عنه نكفر عنكم سياتكم وندخلكم مدخلا كريما",
    "ayahnumber" : "31",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "531",
    "page" : "83",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5310",
    "ayah_text" : "وَإِذَا رَأَوۡاْ تِجَٰرَةً أَوۡ لَهۡوًا ٱنفَضُّوٓاْ إِلَيۡهَا وَتَرَكُوكَ قَآئِمٗاۚ قُلۡ مَا عِندَ ٱللَّهِ خَيۡرٞ مِّنَ ٱللَّهۡوِ وَمِنَ ٱلتِّجَٰرَةِۚ وَٱللَّهُ خَيۡرُ ٱلرَّٰزِقِينَ",
    "ayah_text_no_diacratic" : "واذا راوا تجٰرة او لهوا انفضوا اليها وتركوك قائما قل ما عند الله خير من اللهو ومن التجٰرة والله خير الرٰزقين",
    "ayahnumber" : "11",
