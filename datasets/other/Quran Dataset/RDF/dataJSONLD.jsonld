    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2837",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2837",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2838",
    "ayah_text" : "سُورَةٌ أَنزَلۡنَٰهَا وَفَرَضۡنَٰهَا وَأَنزَلۡنَا فِيهَآ ءَايَٰتِۭ بَيِّنَٰتٖ لَّعَلَّكُمۡ تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "سورة انزلنٰها وفرضنٰها وانزلنا فيها ءايٰت بينٰت لعلكم تذكرون",
    "ayahnumber" : "1",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2838",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2839",
    "ayah_text" : "ٱلزَّانِيَةُ وَٱلزَّانِي فَٱجۡلِدُواْ كُلَّ وَٰحِدٖ مِّنۡهُمَا مِاْئَةَ جَلۡدَةٖۖ وَلَا تَأۡخُذۡكُم بِهِمَا رَأۡفَةٞ فِي دِينِ ٱللَّهِ إِن كُنتُمۡ تُؤۡمِنُونَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۖ وَلۡيَشۡهَدۡ عَذَابَهُمَا طَآئِفَةٞ مِّنَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "الزانية والزاني فاجلدوا كل وٰحد منهما مائة جلدة ولا تاخذكم بهما رافة في دين الله ان كنتم تؤمنون بالله واليوم الاخر وليشهد عذابهما طائفة من المؤمنين",
    "ayahnumber" : "2",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2839",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:284",
    "ayah_text" : "ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُم بِٱلَّيۡلِ وَٱلنَّهَارِ سِرّٗا وَعَلَانِيَةٗ فَلَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "الذين ينفقون اموٰلهم باليل والنهار سرا وعلانية فلهم اجرهم عند ربهم ولا خوف عليهم ولا هم يحزنون",
    "ayahnumber" : "274",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "284",
    "page" : "46",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2840",
    "ayah_text" : "ٱلزَّانِي لَا يَنكِحُ إِلَّا زَانِيَةً أَوۡ مُشۡرِكَةٗ وَٱلزَّانِيَةُ لَا يَنكِحُهَآ إِلَّا زَانٍ أَوۡ مُشۡرِكٞۚ وَحُرِّمَ ذَٰلِكَ عَلَى ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "الزاني لا ينكح الا زانية او مشركة والزانية لا ينكحها الا زان او مشرك وحرم ذٰلك على المؤمنين",
    "ayahnumber" : "3",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2840",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2841",
    "ayah_text" : "وَٱلَّذِينَ يَرۡمُونَ ٱلۡمُحۡصَنَٰتِ ثُمَّ لَمۡ يَأۡتُواْ بِأَرۡبَعَةِ شُهَدَآءَ فَٱجۡلِدُوهُمۡ ثَمَٰنِينَ جَلۡدَةٗ وَلَا تَقۡبَلُواْ لَهُمۡ شَهَٰدَةً أَبَدٗاۚ وَأُوْلَٰٓئِكَ هُمُ ٱلۡفَٰسِقُونَ",
    "ayah_text_no_diacratic" : "والذين يرمون المحصنٰت ثم لم ياتوا باربعة شهداء فاجلدوهم ثمٰنين جلدة ولا تقبلوا لهم شهٰدة ابدا واولٰئك هم الفٰسقون",
    "ayahnumber" : "4",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2841",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2842",
    "ayah_text" : "إِلَّا ٱلَّذِينَ تَابُواْ مِنۢ بَعۡدِ ذَٰلِكَ وَأَصۡلَحُواْ فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "الا الذين تابوا من بعد ذٰلك واصلحوا فان الله غفور رحيم",
    "ayahnumber" : "5",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2842",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2843",
    "ayah_text" : "وَٱلَّذِينَ يَرۡمُونَ أَزۡوَٰجَهُمۡ وَلَمۡ يَكُن لَّهُمۡ شُهَدَآءُ إِلَّآ أَنفُسُهُمۡ فَشَهَٰدَةُ أَحَدِهِمۡ أَرۡبَعُ شَهَٰدَٰتِۭ بِٱللَّهِ إِنَّهُۥ لَمِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "والذين يرمون ازوٰجهم ولم يكن لهم شهداء الا انفسهم فشهٰدة احدهم اربع شهٰدٰت بالله انه لمن الصٰدقين",
    "ayahnumber" : "6",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2843",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2844",
    "ayah_text" : "وَٱلۡخَٰمِسَةُ أَنَّ لَعۡنَتَ ٱللَّهِ عَلَيۡهِ إِن كَانَ مِنَ ٱلۡكَٰذِبِينَ",
    "ayah_text_no_diacratic" : "والخٰمسة ان لعنت الله عليه ان كان من الكٰذبين",
    "ayahnumber" : "7",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2844",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2845",
    "ayah_text" : "وَيَدۡرَؤُاْ عَنۡهَا ٱلۡعَذَابَ أَن تَشۡهَدَ أَرۡبَعَ شَهَٰدَٰتِۭ بِٱللَّهِ إِنَّهُۥ لَمِنَ ٱلۡكَٰذِبِينَ",
    "ayah_text_no_diacratic" : "ويدرؤا عنها العذاب ان تشهد اربع شهٰدٰت بالله انه لمن الكٰذبين",
    "ayahnumber" : "8",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2845",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2846",
    "ayah_text" : "وَٱلۡخَٰمِسَةَ أَنَّ غَضَبَ ٱللَّهِ عَلَيۡهَآ إِن كَانَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "والخٰمسة ان غضب الله عليها ان كان من الصٰدقين",
    "ayahnumber" : "9",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2846",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2847",
    "ayah_text" : "وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ وَأَنَّ ٱللَّهَ تَوَّابٌ حَكِيمٌ",
    "ayah_text_no_diacratic" : "ولولا فضل الله عليكم ورحمته وان الله تواب حكيم",
    "ayahnumber" : "10",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2847",
    "page" : "350",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2848",
    "ayah_text" : "إِنَّ ٱلَّذِينَ جَآءُو بِٱلۡإِفۡكِ عُصۡبَةٞ مِّنكُمۡۚ لَا تَحۡسَبُوهُ شَرّٗا لَّكُمۖ بَلۡ هُوَ خَيۡرٞ لَّكُمۡۚ لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُم مَّا ٱكۡتَسَبَ مِنَ ٱلۡإِثۡمِۚ وَٱلَّذِي تَوَلَّىٰ كِبۡرَهُۥ مِنۡهُمۡ لَهُۥ عَذَابٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "ان الذين جاءو بالافك عصبة منكم لا تحسبوه شرا لكم بل هو خير لكم لكل امري منهم ما اكتسب من الاثم والذي تولىٰ كبره منهم له عذاب عظيم",
    "ayahnumber" : "11",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2848",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2849",
    "ayah_text" : "لَّوۡلَآ إِذۡ سَمِعۡتُمُوهُ ظَنَّ ٱلۡمُؤۡمِنُونَ وَٱلۡمُؤۡمِنَٰتُ بِأَنفُسِهِمۡ خَيۡرٗا وَقَالُواْ هَٰذَآ إِفۡكٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "لولا اذ سمعتموه ظن المؤمنون والمؤمنٰت بانفسهم خيرا وقالوا هٰذا افك مبين",
    "ayahnumber" : "12",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2849",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:285",
    "ayah_text" : "ٱلَّذِينَ يَأۡكُلُونَ ٱلرِّبَوٰاْ لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ ٱلَّذِي يَتَخَبَّطُهُ ٱلشَّيۡطَٰنُ مِنَ ٱلۡمَسِّۚ ذَٰلِكَ بِأَنَّهُمۡ قَالُوٓاْ إِنَّمَا ٱلۡبَيۡعُ مِثۡلُ ٱلرِّبَوٰاْۗ وَأَحَلَّ ٱللَّهُ ٱلۡبَيۡعَ وَحَرَّمَ ٱلرِّبَوٰاْۚ فَمَن جَآءَهُۥ مَوۡعِظَةٞ مِّن رَّبِّهِۦ فَٱنتَهَىٰ فَلَهُۥ مَا سَلَفَ وَأَمۡرُهُۥٓ إِلَى ٱللَّهِۖ وَمَنۡ عَادَ فَأُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "الذين ياكلون الربوٰا لا يقومون الا كما يقوم الذي يتخبطه الشيطٰن من المس ذٰلك بانهم قالوا انما البيع مثل الربوٰا واحل الله البيع وحرم الربوٰا فمن جاءه موعظة من ربه فانتهىٰ فله ما سلف وامره الى الله ومن عاد فاولٰئك اصحٰب النار هم فيها خٰلدون",
    "ayahnumber" : "275",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "285",
    "page" : "47",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2850",
    "ayah_text" : "لَّوۡلَا جَآءُو عَلَيۡهِ بِأَرۡبَعَةِ شُهَدَآءَۚ فَإِذۡ لَمۡ يَأۡتُواْ بِٱلشُّهَدَآءِ فَأُوْلَٰٓئِكَ عِندَ ٱللَّهِ هُمُ ٱلۡكَٰذِبُونَ",
    "ayah_text_no_diacratic" : "لولا جاءو عليه باربعة شهداء فاذ لم ياتوا بالشهداء فاولٰئك عند الله هم الكٰذبون",
    "ayahnumber" : "13",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2850",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2851",
    "ayah_text" : "وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ لَمَسَّكُمۡ فِي مَآ أَفَضۡتُمۡ فِيهِ عَذَابٌ عَظِيمٌ",
    "ayah_text_no_diacratic" : "ولولا فضل الله عليكم ورحمته في الدنيا والاخرة لمسكم في ما افضتم فيه عذاب عظيم",
    "ayahnumber" : "14",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2851",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2852",
    "ayah_text" : "إِذۡ تَلَقَّوۡنَهُۥ بِأَلۡسِنَتِكُمۡ وَتَقُولُونَ بِأَفۡوَاهِكُم مَّا لَيۡسَ لَكُم بِهِۦ عِلۡمٞ وَتَحۡسَبُونَهُۥ هَيِّنٗا وَهُوَ عِندَ ٱللَّهِ عَظِيمٞ",
    "ayah_text_no_diacratic" : "اذ تلقونه بالسنتكم وتقولون بافواهكم ما ليس لكم به علم وتحسبونه هينا وهو عند الله عظيم",
    "ayahnumber" : "15",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2852",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2853",
    "ayah_text" : "وَلَوۡلَآ إِذۡ سَمِعۡتُمُوهُ قُلۡتُم مَّا يَكُونُ لَنَآ أَن نَّتَكَلَّمَ بِهَٰذَا سُبۡحَٰنَكَ هَٰذَا بُهۡتَٰنٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "ولولا اذ سمعتموه قلتم ما يكون لنا ان نتكلم بهٰذا سبحٰنك هٰذا بهتٰن عظيم",
    "ayahnumber" : "16",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2853",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2854",
    "ayah_text" : "يَعِظُكُمُ ٱللَّهُ أَن تَعُودُواْ لِمِثۡلِهِۦٓ أَبَدًا إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "يعظكم الله ان تعودوا لمثله ابدا ان كنتم مؤمنين",
    "ayahnumber" : "17",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2854",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2855",
    "ayah_text" : "وَيُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِۚ وَٱللَّهُ عَلِيمٌ حَكِيمٌ",
    "ayah_text_no_diacratic" : "ويبين الله لكم الايٰت والله عليم حكيم",
    "ayahnumber" : "18",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2855",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2856",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يُحِبُّونَ أَن تَشِيعَ ٱلۡفَٰحِشَةُ فِي ٱلَّذِينَ ءَامَنُواْ لَهُمۡ عَذَابٌ أَلِيمٞ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۚ وَٱللَّهُ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ان الذين يحبون ان تشيع الفٰحشة في الذين ءامنوا لهم عذاب اليم في الدنيا والاخرة والله يعلم وانتم لا تعلمون",
    "ayahnumber" : "19",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2856",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2857",
    "ayah_text" : "وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ وَأَنَّ ٱللَّهَ رَءُوفٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "ولولا فضل الله عليكم ورحمته وان الله رءوف رحيم",
    "ayahnumber" : "20",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2857",
    "page" : "351",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2858",
    "ayah_text" : "۞يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّبِعُواْ خُطُوَٰتِ ٱلشَّيۡطَٰنِۚ وَمَن يَتَّبِعۡ خُطُوَٰتِ ٱلشَّيۡطَٰنِ فَإِنَّهُۥ يَأۡمُرُ بِٱلۡفَحۡشَآءِ وَٱلۡمُنكَرِۚ وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ مَا زَكَىٰ مِنكُم مِّنۡ أَحَدٍ أَبَدٗا وَلَٰكِنَّ ٱللَّهَ يُزَكِّي مَن يَشَآءُۗ وَٱللَّهُ سَمِيعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تتبعوا خطوٰت الشيطٰن ومن يتبع خطوٰت الشيطٰن فانه يامر بالفحشاء والمنكر ولولا فضل الله عليكم ورحمته ما زكىٰ منكم من احد ابدا ولٰكن الله يزكي من يشاء والله سميع عليم",
    "ayahnumber" : "21",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2858",
    "page" : "352",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2859",
    "ayah_text" : "وَلَا يَأۡتَلِ أُوْلُواْ ٱلۡفَضۡلِ مِنكُمۡ وَٱلسَّعَةِ أَن يُؤۡتُوٓاْ أُوْلِي ٱلۡقُرۡبَىٰ وَٱلۡمَسَٰكِينَ وَٱلۡمُهَٰجِرِينَ فِي سَبِيلِ ٱللَّهِۖ وَلۡيَعۡفُواْ وَلۡيَصۡفَحُوٓاْۗ أَلَا تُحِبُّونَ أَن يَغۡفِرَ ٱللَّهُ لَكُمۡۚ وَٱللَّهُ غَفُورٞ رَّحِيمٌ",
    "ayah_text_no_diacratic" : "ولا ياتل اولوا الفضل منكم والسعة ان يؤتوا اولي القربىٰ والمسٰكين والمهٰجرين في سبيل الله وليعفوا وليصفحوا الا تحبون ان يغفر الله لكم والله غفور رحيم",
    "ayahnumber" : "22",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2859",
    "page" : "352",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:286",
    "ayah_text" : "يَمۡحَقُ ٱللَّهُ ٱلرِّبَوٰاْ وَيُرۡبِي ٱلصَّدَقَٰتِۗ وَٱللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ",
    "ayah_text_no_diacratic" : "يمحق الله الربوٰا ويربي الصدقٰت والله لا يحب كل كفار اثيم",
    "ayahnumber" : "276",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "286",
    "page" : "47",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2860",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَرۡمُونَ ٱلۡمُحۡصَنَٰتِ ٱلۡغَٰفِلَٰتِ ٱلۡمُؤۡمِنَٰتِ لُعِنُواْ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَلَهُمۡ عَذَابٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "ان الذين يرمون المحصنٰت الغٰفلٰت المؤمنٰت لعنوا في الدنيا والاخرة ولهم عذاب عظيم",
    "ayahnumber" : "23",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2860",
    "page" : "352",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2861",
    "ayah_text" : "يَوۡمَ تَشۡهَدُ عَلَيۡهِمۡ أَلۡسِنَتُهُمۡ وَأَيۡدِيهِمۡ وَأَرۡجُلُهُم بِمَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "يوم تشهد عليهم السنتهم وايديهم وارجلهم بما كانوا يعملون",
    "ayahnumber" : "24",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2861",
    "page" : "352",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2862",
    "ayah_text" : "يَوۡمَئِذٖ يُوَفِّيهِمُ ٱللَّهُ دِينَهُمُ ٱلۡحَقَّ وَيَعۡلَمُونَ أَنَّ ٱللَّهَ هُوَ ٱلۡحَقُّ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "يومئذ يوفيهم الله دينهم الحق ويعلمون ان الله هو الحق المبين",
    "ayahnumber" : "25",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2862",
    "page" : "352",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2863",
    "ayah_text" : "ٱلۡخَبِيثَٰتُ لِلۡخَبِيثِينَ وَٱلۡخَبِيثُونَ لِلۡخَبِيثَٰتِۖ وَٱلطَّيِّبَٰتُ لِلطَّيِّبِينَ وَٱلطَّيِّبُونَ لِلطَّيِّبَٰتِۚ أُوْلَٰٓئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَۖ لَهُم مَّغۡفِرَةٞ وَرِزۡقٞ كَرِيمٞ",
    "ayah_text_no_diacratic" : "الخبيثٰت للخبيثين والخبيثون للخبيثٰت والطيبٰت للطيبين والطيبون للطيبٰت اولٰئك مبرءون مما يقولون لهم مغفرة ورزق كريم",
    "ayahnumber" : "26",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2863",
    "page" : "352",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2864",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَدۡخُلُواْ بُيُوتًا غَيۡرَ بُيُوتِكُمۡ حَتَّىٰ تَسۡتَأۡنِسُواْ وَتُسَلِّمُواْ عَلَىٰٓ أَهۡلِهَاۚ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ لَعَلَّكُمۡ تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تدخلوا بيوتا غير بيوتكم حتىٰ تستانسوا وتسلموا علىٰ اهلها ذٰلكم خير لكم لعلكم تذكرون",
    "ayahnumber" : "27",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2864",
    "page" : "352",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2865",
    "ayah_text" : "فَإِن لَّمۡ تَجِدُواْ فِيهَآ أَحَدٗا فَلَا تَدۡخُلُوهَا حَتَّىٰ يُؤۡذَنَ لَكُمۡۖ وَإِن قِيلَ لَكُمُ ٱرۡجِعُواْ فَٱرۡجِعُواْۖ هُوَ أَزۡكَىٰ لَكُمۡۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ عَلِيمٞ",
    "ayah_text_no_diacratic" : "فان لم تجدوا فيها احدا فلا تدخلوها حتىٰ يؤذن لكم وان قيل لكم ارجعوا فارجعوا هو ازكىٰ لكم والله بما تعملون عليم",
    "ayahnumber" : "28",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2865",
    "page" : "353",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2866",
    "ayah_text" : "لَّيۡسَ عَلَيۡكُمۡ جُنَاحٌ أَن تَدۡخُلُواْ بُيُوتًا غَيۡرَ مَسۡكُونَةٖ فِيهَا مَتَٰعٞ لَّكُمۡۚ وَٱللَّهُ يَعۡلَمُ مَا تُبۡدُونَ وَمَا تَكۡتُمُونَ",
    "ayah_text_no_diacratic" : "ليس عليكم جناح ان تدخلوا بيوتا غير مسكونة فيها متٰع لكم والله يعلم ما تبدون وما تكتمون",
    "ayahnumber" : "29",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2866",
    "page" : "353",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2867",
    "ayah_text" : "قُل لِّلۡمُؤۡمِنِينَ يَغُضُّواْ مِنۡ أَبۡصَٰرِهِمۡ وَيَحۡفَظُواْ فُرُوجَهُمۡۚ ذَٰلِكَ أَزۡكَىٰ لَهُمۡۚ إِنَّ ٱللَّهَ خَبِيرُۢ بِمَا يَصۡنَعُونَ",
    "ayah_text_no_diacratic" : "قل للمؤمنين يغضوا من ابصٰرهم ويحفظوا فروجهم ذٰلك ازكىٰ لهم ان الله خبير بما يصنعون",
    "ayahnumber" : "30",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2867",
    "page" : "353",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2868",
    "ayah_text" : "وَقُل لِّلۡمُؤۡمِنَٰتِ يَغۡضُضۡنَ مِنۡ أَبۡصَٰرِهِنَّ وَيَحۡفَظۡنَ فُرُوجَهُنَّ وَلَا يُبۡدِينَ زِينَتَهُنَّ إِلَّا مَا ظَهَرَ مِنۡهَاۖ وَلۡيَضۡرِبۡنَ بِخُمُرِهِنَّ عَلَىٰ جُيُوبِهِنَّۖ وَلَا يُبۡدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوۡ ءَابَآئِهِنَّ أَوۡ ءَابَآءِ بُعُولَتِهِنَّ أَوۡ أَبۡنَآئِهِنَّ أَوۡ أَبۡنَآءِ بُعُولَتِهِنَّ أَوۡ إِخۡوَٰنِهِنَّ أَوۡ بَنِيٓ إِخۡوَٰنِهِنَّ أَوۡ بَنِيٓ أَخَوَٰتِهِنَّ أَوۡ نِسَآئِهِنَّ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُنَّ أَوِ ٱلتَّٰبِعِينَ غَيۡرِ أُوْلِي ٱلۡإِرۡبَةِ مِنَ ٱلرِّجَالِ أَوِ ٱلطِّفۡلِ ٱلَّذِينَ لَمۡ يَظۡهَرُواْ عَلَىٰ عَوۡرَٰتِ ٱلنِّسَآءِۖ وَلَا يَضۡرِبۡنَ بِأَرۡجُلِهِنَّ لِيُعۡلَمَ مَا يُخۡفِينَ مِن زِينَتِهِنَّۚ وَتُوبُوٓاْ إِلَى ٱللَّهِ جَمِيعًا أَيُّهَ ٱلۡمُؤۡمِنُونَ لَعَلَّكُمۡ تُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "وقل للمؤمنٰت يغضضن من ابصٰرهن ويحفظن فروجهن ولا يبدين زينتهن الا ما ظهر منها وليضربن بخمرهن علىٰ جيوبهن ولا يبدين زينتهن الا لبعولتهن او ءابائهن او ءاباء بعولتهن او ابنائهن او ابناء بعولتهن او اخوٰنهن او بني اخوٰنهن او بني اخوٰتهن او نسائهن او ما ملكت ايمٰنهن او التٰبعين غير اولي الاربة من الرجال او الطفل الذين لم يظهروا علىٰ عورٰت النساء ولا يضربن بارجلهن ليعلم ما يخفين من زينتهن وتوبوا الى الله جميعا ايه المؤمنون لعلكم تفلحون",
    "ayahnumber" : "31",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2868",
    "page" : "353",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2869",
    "ayah_text" : "وَأَنكِحُواْ ٱلۡأَيَٰمَىٰ مِنكُمۡ وَٱلصَّٰلِحِينَ مِنۡ عِبَادِكُمۡ وَإِمَآئِكُمۡۚ إِن يَكُونُواْ فُقَرَآءَ يُغۡنِهِمُ ٱللَّهُ مِن فَضۡلِهِۦۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "وانكحوا الايٰمىٰ منكم والصٰلحين من عبادكم وامائكم ان يكونوا فقراء يغنهم الله من فضله والله وٰسع عليم",
    "ayahnumber" : "32",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2869",
