    "page" : "528",
    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4945",
    "ayah_text" : "أَزِفَتِ ٱلۡأٓزِفَةُ",
    "ayah_text_no_diacratic" : "ازفت الازفة",
    "ayahnumber" : "57",
    "chapter" : "27",
