    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5621",
    "ayah_text" : "قُمِ ٱلَّيۡلَ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "قم اليل الا قليلا",
    "ayahnumber" : "2",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5621",
    "page" : "574",
