    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5635",
    "ayah_text" : "فَعَصَىٰ فِرۡعَوۡنُ ٱلرَّسُولَ فَأَخَذۡنَٰهُ أَخۡذٗا وَبِيلٗا",
    "ayah_text_no_diacratic" : "فعصىٰ فرعون الرسول فاخذنٰه اخذا وبيلا",
    "ayahnumber" : "16",
    "chapter" : "29",
    "hizb" : "57",
