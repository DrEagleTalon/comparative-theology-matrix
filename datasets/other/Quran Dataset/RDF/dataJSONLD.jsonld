    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3929",
    "ayah_text" : "إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ",
    "ayah_text_no_diacratic" : "انهم الفوا ءاباءهم ضالين",
    "ayahnumber" : "69",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3929",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:393",
    "ayah_text" : "قُلۡ صَدَقَ ٱللَّهُۗ فَٱتَّبِعُواْ مِلَّةَ إِبۡرَٰهِيمَ حَنِيفٗاۖ وَمَا كَانَ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "قل صدق الله فاتبعوا ملة ابرٰهيم حنيفا وما كان من المشركين",
    "ayahnumber" : "95",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "393",
    "page" : "62",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3930",
    "ayah_text" : "فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ",
    "ayah_text_no_diacratic" : "فهم علىٰ ءاثٰرهم يهرعون",
