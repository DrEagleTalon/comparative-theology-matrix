  }, {
    "@id" : "quran:5433",
    "ayah_text" : "قَالَ أَوۡسَطُهُمۡ أَلَمۡ أَقُل لَّكُمۡ لَوۡلَا تُسَبِّحُونَ",
    "ayah_text_no_diacratic" : "قال اوسطهم الم اقل لكم لولا تسبحون",
