  }, {
    "@id" : "quran:5477",
    "ayah_text" : "يَوۡمَئِذٖ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةٞ",
    "ayah_text_no_diacratic" : "يومئذ تعرضون لا تخفىٰ منكم خافية",
