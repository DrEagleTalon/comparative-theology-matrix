    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2879",
    "ayah_text" : "وَلِلَّهِ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَإِلَى ٱللَّهِ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "ولله ملك السمٰوٰت والارض والى الله المصير",
