    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:457",
    "ayah_text" : "فَبِمَا رَحۡمَةٖ مِّنَ ٱللَّهِ لِنتَ لَهُمۡۖ وَلَوۡ كُنتَ فَظًّا غَلِيظَ ٱلۡقَلۡبِ لَٱنفَضُّواْ مِنۡ حَوۡلِكَۖ فَٱعۡفُ عَنۡهُمۡ وَٱسۡتَغۡفِرۡ لَهُمۡ وَشَاوِرۡهُمۡ فِي ٱلۡأَمۡرِۖ فَإِذَا عَزَمۡتَ فَتَوَكَّلۡ عَلَى ٱللَّهِۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُتَوَكِّلِينَ",
    "ayah_text_no_diacratic" : "فبما رحمة من الله لنت لهم ولو كنت فظا غليظ القلب لانفضوا من حولك فاعف عنهم واستغفر لهم وشاورهم في الامر فاذا عزمت فتوكل على الله ان الله يحب المتوكلين",
    "ayahnumber" : "159",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "457",
    "page" : "71",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4570",
    "ayah_text" : "وَإِذَا عَلِمَ مِنۡ ءَايَٰتِنَا شَيۡـًٔا ٱتَّخَذَهَا هُزُوًاۚ أُوْلَٰٓئِكَ لَهُمۡ عَذَابٞ مُّهِينٞ",
    "ayah_text_no_diacratic" : "واذا علم من ءايٰتنا شيا اتخذها هزوا اولٰئك لهم عذاب مهين",
    "ayahnumber" : "9",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4570",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4571",
    "ayah_text" : "مِّن وَرَآئِهِمۡ جَهَنَّمُۖ وَلَا يُغۡنِي عَنۡهُم مَّا كَسَبُواْ شَيۡـٔٗا وَلَا مَا ٱتَّخَذُواْ مِن دُونِ ٱللَّهِ أَوۡلِيَآءَۖ وَلَهُمۡ عَذَابٌ عَظِيمٌ",
    "ayah_text_no_diacratic" : "من ورائهم جهنم ولا يغني عنهم ما كسبوا شيا ولا ما اتخذوا من دون الله اولياء ولهم عذاب عظيم",
    "ayahnumber" : "10",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4571",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4572",
    "ayah_text" : "هَٰذَا هُدٗىۖ وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِ رَبِّهِمۡ لَهُمۡ عَذَابٞ مِّن رِّجۡزٍ أَلِيمٌ",
    "ayah_text_no_diacratic" : "هٰذا هدى والذين كفروا بايٰت ربهم لهم عذاب من رجز اليم",
    "ayahnumber" : "11",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4572",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4573",
    "ayah_text" : "۞ٱللَّهُ ٱلَّذِي سَخَّرَ لَكُمُ ٱلۡبَحۡرَ لِتَجۡرِيَ ٱلۡفُلۡكُ فِيهِ بِأَمۡرِهِۦ وَلِتَبۡتَغُواْ مِن فَضۡلِهِۦ وَلَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "الله الذي سخر لكم البحر لتجري الفلك فيه بامره ولتبتغوا من فضله ولعلكم تشكرون",
    "ayahnumber" : "12",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4573",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4574",
    "ayah_text" : "وَسَخَّرَ لَكُم مَّا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ جَمِيعٗا مِّنۡهُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "وسخر لكم ما في السمٰوٰت وما في الارض جميعا منه ان في ذٰلك لايٰت لقوم يتفكرون",
    "ayahnumber" : "13",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4574",
    "page" : "499",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4575",
    "ayah_text" : "قُل لِّلَّذِينَ ءَامَنُواْ يَغۡفِرُواْ لِلَّذِينَ لَا يَرۡجُونَ أَيَّامَ ٱللَّهِ لِيَجۡزِيَ قَوۡمَۢا بِمَا كَانُواْ يَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "قل للذين ءامنوا يغفروا للذين لا يرجون ايام الله ليجزي قوما بما كانوا يكسبون",
    "ayahnumber" : "14",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4575",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4576",
    "ayah_text" : "مَنۡ عَمِلَ صَٰلِحٗا فَلِنَفۡسِهِۦۖ وَمَنۡ أَسَآءَ فَعَلَيۡهَاۖ ثُمَّ إِلَىٰ رَبِّكُمۡ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "من عمل صٰلحا فلنفسه ومن اساء فعليها ثم الىٰ ربكم ترجعون",
    "ayahnumber" : "15",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4576",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4577",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا بَنِيٓ إِسۡرَٰٓءِيلَ ٱلۡكِتَٰبَ وَٱلۡحُكۡمَ وَٱلنُّبُوَّةَ وَرَزَقۡنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ وَفَضَّلۡنَٰهُمۡ عَلَى ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا بني اسرٰءيل الكتٰب والحكم والنبوة ورزقنٰهم من الطيبٰت وفضلنٰهم على العٰلمين",
    "ayahnumber" : "16",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4577",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4578",
    "ayah_text" : "وَءَاتَيۡنَٰهُم بَيِّنَٰتٖ مِّنَ ٱلۡأَمۡرِۖ فَمَا ٱخۡتَلَفُوٓاْ إِلَّا مِنۢ بَعۡدِ مَا جَآءَهُمُ ٱلۡعِلۡمُ بَغۡيَۢا بَيۡنَهُمۡۚ إِنَّ رَبَّكَ يَقۡضِي بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخۡتَلِفُونَ",
    "ayah_text_no_diacratic" : "وءاتينٰهم بينٰت من الامر فما اختلفوا الا من بعد ما جاءهم العلم بغيا بينهم ان ربك يقضي بينهم يوم القيٰمة فيما كانوا فيه يختلفون",
    "ayahnumber" : "17",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4578",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4579",
    "ayah_text" : "ثُمَّ جَعَلۡنَٰكَ عَلَىٰ شَرِيعَةٖ مِّنَ ٱلۡأَمۡرِ فَٱتَّبِعۡهَا وَلَا تَتَّبِعۡ أَهۡوَآءَ ٱلَّذِينَ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ثم جعلنٰك علىٰ شريعة من الامر فاتبعها ولا تتبع اهواء الذين لا يعلمون",
    "ayahnumber" : "18",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4579",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:458",
    "ayah_text" : "إِن يَنصُرۡكُمُ ٱللَّهُ فَلَا غَالِبَ لَكُمۡۖ وَإِن يَخۡذُلۡكُمۡ فَمَن ذَا ٱلَّذِي يَنصُرُكُم مِّنۢ بَعۡدِهِۦۗ وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ ٱلۡمُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "ان ينصركم الله فلا غالب لكم وان يخذلكم فمن ذا الذي ينصركم من بعده وعلى الله فليتوكل المؤمنون",
    "ayahnumber" : "160",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "458",
    "page" : "71",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4580",
    "ayah_text" : "إِنَّهُمۡ لَن يُغۡنُواْ عَنكَ مِنَ ٱللَّهِ شَيۡـٔٗاۚ وَإِنَّ ٱلظَّٰلِمِينَ بَعۡضُهُمۡ أَوۡلِيَآءُ بَعۡضٖۖ وَٱللَّهُ وَلِيُّ ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "انهم لن يغنوا عنك من الله شيا وان الظٰلمين بعضهم اولياء بعض والله ولي المتقين",
    "ayahnumber" : "19",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4580",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4581",
    "ayah_text" : "هَٰذَا بَصَٰٓئِرُ لِلنَّاسِ وَهُدٗى وَرَحۡمَةٞ لِّقَوۡمٖ يُوقِنُونَ",
    "ayah_text_no_diacratic" : "هٰذا بصٰئر للناس وهدى ورحمة لقوم يوقنون",
    "ayahnumber" : "20",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4581",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4582",
    "ayah_text" : "أَمۡ حَسِبَ ٱلَّذِينَ ٱجۡتَرَحُواْ ٱلسَّيِّـَٔاتِ أَن نَّجۡعَلَهُمۡ كَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ سَوَآءٗ مَّحۡيَاهُمۡ وَمَمَاتُهُمۡۚ سَآءَ مَا يَحۡكُمُونَ",
    "ayah_text_no_diacratic" : "ام حسب الذين اجترحوا السيات ان نجعلهم كالذين ءامنوا وعملوا الصٰلحٰت سواء محياهم ومماتهم ساء ما يحكمون",
    "ayahnumber" : "21",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4582",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4583",
    "ayah_text" : "وَخَلَقَ ٱللَّهُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّ وَلِتُجۡزَىٰ كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "وخلق الله السمٰوٰت والارض بالحق ولتجزىٰ كل نفس بما كسبت وهم لا يظلمون",
    "ayahnumber" : "22",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4583",
    "page" : "500",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4584",
    "ayah_text" : "أَفَرَءَيۡتَ مَنِ ٱتَّخَذَ إِلَٰهَهُۥ هَوَىٰهُ وَأَضَلَّهُ ٱللَّهُ عَلَىٰ عِلۡمٖ وَخَتَمَ عَلَىٰ سَمۡعِهِۦ وَقَلۡبِهِۦ وَجَعَلَ عَلَىٰ بَصَرِهِۦ غِشَٰوَةٗ فَمَن يَهۡدِيهِ مِنۢ بَعۡدِ ٱللَّهِۚ أَفَلَا تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "افرءيت من اتخذ الٰهه هوىٰه واضله الله علىٰ علم وختم علىٰ سمعه وقلبه وجعل علىٰ بصره غشٰوة فمن يهديه من بعد الله افلا تذكرون",
    "ayahnumber" : "23",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4584",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4585",
    "ayah_text" : "وَقَالُواْ مَا هِيَ إِلَّا حَيَاتُنَا ٱلدُّنۡيَا نَمُوتُ وَنَحۡيَا وَمَا يُهۡلِكُنَآ إِلَّا ٱلدَّهۡرُۚ وَمَا لَهُم بِذَٰلِكَ مِنۡ عِلۡمٍۖ إِنۡ هُمۡ إِلَّا يَظُنُّونَ",
    "ayah_text_no_diacratic" : "وقالوا ما هي الا حياتنا الدنيا نموت ونحيا وما يهلكنا الا الدهر وما لهم بذٰلك من علم ان هم الا يظنون",
    "ayahnumber" : "24",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4585",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4586",
    "ayah_text" : "وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُنَا بَيِّنَٰتٖ مَّا كَانَ حُجَّتَهُمۡ إِلَّآ أَن قَالُواْ ٱئۡتُواْ بِـَٔابَآئِنَآ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "واذا تتلىٰ عليهم ءايٰتنا بينٰت ما كان حجتهم الا ان قالوا ائتوا بابائنا ان كنتم صٰدقين",
    "ayahnumber" : "25",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4586",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4587",
    "ayah_text" : "قُلِ ٱللَّهُ يُحۡيِيكُمۡ ثُمَّ يُمِيتُكُمۡ ثُمَّ يَجۡمَعُكُمۡ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ لَا رَيۡبَ فِيهِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قل الله يحييكم ثم يميتكم ثم يجمعكم الىٰ يوم القيٰمة لا ريب فيه ولٰكن اكثر الناس لا يعلمون",
    "ayahnumber" : "26",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4587",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4588",
    "ayah_text" : "وَلِلَّهِ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَيَوۡمَ تَقُومُ ٱلسَّاعَةُ يَوۡمَئِذٖ يَخۡسَرُ ٱلۡمُبۡطِلُونَ",
    "ayah_text_no_diacratic" : "ولله ملك السمٰوٰت والارض ويوم تقوم الساعة يومئذ يخسر المبطلون",
    "ayahnumber" : "27",
