    "surahname" : "سُورَةُ النَّمۡلِ",
    "surahnumber" : "27",
    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3262",
    "ayah_text" : "فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ مَكۡرِهِمۡ أَنَّا دَمَّرۡنَٰهُمۡ وَقَوۡمَهُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "فانظر كيف كان عٰقبة مكرهم انا دمرنٰهم وقومهم اجمعين",
    "ayahnumber" : "51",
    "chapter" : "19",
    "hizb" : "38",
    "index" : "3262",
