    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:556",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا سَوۡفَ نُصۡلِيهِمۡ نَارٗا كُلَّمَا نَضِجَتۡ جُلُودُهُم بَدَّلۡنَٰهُمۡ جُلُودًا غَيۡرَهَا لِيَذُوقُواْ ٱلۡعَذَابَۗ إِنَّ ٱللَّهَ كَانَ عَزِيزًا حَكِيمٗا",
    "ayah_text_no_diacratic" : "ان الذين كفروا بايٰتنا سوف نصليهم نارا كلما نضجت جلودهم بدلنٰهم جلودا غيرها ليذوقوا العذاب ان الله كان عزيزا حكيما",
    "ayahnumber" : "56",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "556",
    "page" : "87",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5560",
    "ayah_text" : "إِنَّآ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦٓ أَنۡ أَنذِرۡ قَوۡمَكَ مِن قَبۡلِ أَن يَأۡتِيَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "انا ارسلنا نوحا الىٰ قومه ان انذر قومك من قبل ان ياتيهم عذاب اليم",
    "ayahnumber" : "1",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5560",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5561",
    "ayah_text" : "قَالَ يَٰقَوۡمِ إِنِّي لَكُمۡ نَذِيرٞ مُّبِينٌ",
    "ayah_text_no_diacratic" : "قال يٰقوم اني لكم نذير مبين",
    "ayahnumber" : "2",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5561",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5562",
    "ayah_text" : "أَنِ ٱعۡبُدُواْ ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ",
    "ayah_text_no_diacratic" : "ان اعبدوا الله واتقوه واطيعون",
    "ayahnumber" : "3",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5562",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5563",
    "ayah_text" : "يَغۡفِرۡ لَكُم مِّن ذُنُوبِكُمۡ وَيُؤَخِّرۡكُمۡ إِلَىٰٓ أَجَلٖ مُّسَمًّىۚ إِنَّ أَجَلَ ٱللَّهِ إِذَا جَآءَ لَا يُؤَخَّرُۚ لَوۡ كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "يغفر لكم من ذنوبكم ويؤخركم الىٰ اجل مسمى ان اجل الله اذا جاء لا يؤخر لو كنتم تعلمون",
    "ayahnumber" : "4",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5563",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5564",
    "ayah_text" : "قَالَ رَبِّ إِنِّي دَعَوۡتُ قَوۡمِي لَيۡلٗا وَنَهَارٗا",
    "ayah_text_no_diacratic" : "قال رب اني دعوت قومي ليلا ونهارا",
    "ayahnumber" : "5",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5564",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5565",
    "ayah_text" : "فَلَمۡ يَزِدۡهُمۡ دُعَآءِيٓ إِلَّا فِرَارٗا",
    "ayah_text_no_diacratic" : "فلم يزدهم دعاءي الا فرارا",
    "ayahnumber" : "6",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5565",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5566",
    "ayah_text" : "وَإِنِّي كُلَّمَا دَعَوۡتُهُمۡ لِتَغۡفِرَ لَهُمۡ جَعَلُوٓاْ أَصَٰبِعَهُمۡ فِيٓ ءَاذَانِهِمۡ وَٱسۡتَغۡشَوۡاْ ثِيَابَهُمۡ وَأَصَرُّواْ وَٱسۡتَكۡبَرُواْ ٱسۡتِكۡبَارٗا",
    "ayah_text_no_diacratic" : "واني كلما دعوتهم لتغفر لهم جعلوا اصٰبعهم في ءاذانهم واستغشوا ثيابهم واصروا واستكبروا استكبارا",
    "ayahnumber" : "7",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5566",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5567",
    "ayah_text" : "ثُمَّ إِنِّي دَعَوۡتُهُمۡ جِهَارٗا",
    "ayah_text_no_diacratic" : "ثم اني دعوتهم جهارا",
    "ayahnumber" : "8",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5567",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5568",
    "ayah_text" : "ثُمَّ إِنِّيٓ أَعۡلَنتُ لَهُمۡ وَأَسۡرَرۡتُ لَهُمۡ إِسۡرَارٗا",
    "ayah_text_no_diacratic" : "ثم اني اعلنت لهم واسررت لهم اسرارا",
    "ayahnumber" : "9",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5568",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5569",
    "ayah_text" : "فَقُلۡتُ ٱسۡتَغۡفِرُواْ رَبَّكُمۡ إِنَّهُۥ كَانَ غَفَّارٗا",
    "ayah_text_no_diacratic" : "فقلت استغفروا ربكم انه كان غفارا",
    "ayahnumber" : "10",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5569",
    "page" : "570",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:557",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ سَنُدۡخِلُهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ لَّهُمۡ فِيهَآ أَزۡوَٰجٞ مُّطَهَّرَةٞۖ وَنُدۡخِلُهُمۡ ظِلّٗا ظَلِيلًا",
    "ayah_text_no_diacratic" : "والذين ءامنوا وعملوا الصٰلحٰت سندخلهم جنٰت تجري من تحتها الانهٰر خٰلدين فيها ابدا لهم فيها ازوٰج مطهرة وندخلهم ظلا ظليلا",
    "ayahnumber" : "57",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "557",
    "page" : "87",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5570",
    "ayah_text" : "يُرۡسِلِ ٱلسَّمَآءَ عَلَيۡكُم مِّدۡرَارٗا",
    "ayah_text_no_diacratic" : "يرسل السماء عليكم مدرارا",
    "ayahnumber" : "11",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5570",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5571",
    "ayah_text" : "وَيُمۡدِدۡكُم بِأَمۡوَٰلٖ وَبَنِينَ وَيَجۡعَل لَّكُمۡ جَنَّٰتٖ وَيَجۡعَل لَّكُمۡ أَنۡهَٰرٗا",
    "ayah_text_no_diacratic" : "ويمددكم باموٰل وبنين ويجعل لكم جنٰت ويجعل لكم انهٰرا",
    "ayahnumber" : "12",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5571",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5572",
    "ayah_text" : "مَّا لَكُمۡ لَا تَرۡجُونَ لِلَّهِ وَقَارٗا",
    "ayah_text_no_diacratic" : "ما لكم لا ترجون لله وقارا",
    "ayahnumber" : "13",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5572",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5573",
    "ayah_text" : "وَقَدۡ خَلَقَكُمۡ أَطۡوَارًا",
    "ayah_text_no_diacratic" : "وقد خلقكم اطوارا",
    "ayahnumber" : "14",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5573",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5574",
    "ayah_text" : "أَلَمۡ تَرَوۡاْ كَيۡفَ خَلَقَ ٱللَّهُ سَبۡعَ سَمَٰوَٰتٖ طِبَاقٗا",
    "ayah_text_no_diacratic" : "الم تروا كيف خلق الله سبع سمٰوٰت طباقا",
    "ayahnumber" : "15",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5574",
    "page" : "571",
    "surahname" : "سُورَةُ نُوحٍ",
    "surahnumber" : "71",
    "surrahname_no_diacratic" : "سورة نوح"
  }, {
    "@id" : "quran:5575",
    "ayah_text" : "وَجَعَلَ ٱلۡقَمَرَ فِيهِنَّ نُورٗا وَجَعَلَ ٱلشَّمۡسَ سِرَاجٗا",
    "ayah_text_no_diacratic" : "وجعل القمر فيهن نورا وجعل الشمس سراجا",
    "ayahnumber" : "16",
    "chapter" : "29",
    "hizb" : "57",
