    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2298",
    "ayah_text" : "يَٰيَحۡيَىٰ خُذِ ٱلۡكِتَٰبَ بِقُوَّةٖۖ وَءَاتَيۡنَٰهُ ٱلۡحُكۡمَ صَبِيّٗا",
    "ayah_text_no_diacratic" : "يٰيحيىٰ خذ الكتٰب بقوة وءاتينٰه الحكم صبيا",
