    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:396",
    "ayah_text" : "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لِمَ تَكۡفُرُونَ بِـَٔايَٰتِ ٱللَّهِ وَٱللَّهُ شَهِيدٌ عَلَىٰ مَا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "قل يٰاهل الكتٰب لم تكفرون بايٰت الله والله شهيد علىٰ ما تعملون",
    "ayahnumber" : "98",
    "chapter" : "4",
