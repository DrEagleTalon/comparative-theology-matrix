    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1920",
    "ayah_text" : "كَمَآ أَنزَلۡنَا عَلَى ٱلۡمُقۡتَسِمِينَ",
    "ayah_text_no_diacratic" : "كما انزلنا على المقتسمين",
