  }, {
    "@id" : "quran:2912",
    "ayah_text" : "ٱنظُرۡ كَيۡفَ ضَرَبُواْ لَكَ ٱلۡأَمۡثَٰلَ فَضَلُّواْ فَلَا يَسۡتَطِيعُونَ سَبِيلٗا",
    "ayah_text_no_diacratic" : "انظر كيف ضربوا لك الامثٰل فضلوا فلا يستطيعون سبيلا",
