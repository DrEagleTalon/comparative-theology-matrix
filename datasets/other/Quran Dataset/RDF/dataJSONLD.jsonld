    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:536",
    "ayah_text" : "۞وَٱعۡبُدُواْ ٱللَّهَ وَلَا تُشۡرِكُواْ بِهِۦ شَيۡـٔٗاۖ وَبِٱلۡوَٰلِدَيۡنِ إِحۡسَٰنٗا وَبِذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱلۡجَارِ ذِي ٱلۡقُرۡبَىٰ وَٱلۡجَارِ ٱلۡجُنُبِ وَٱلصَّاحِبِ بِٱلۡجَنۢبِ وَٱبۡنِ ٱلسَّبِيلِ وَمَا مَلَكَتۡ أَيۡمَٰنُكُمۡۗ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ مُخۡتَالٗا فَخُورًا",
    "ayah_text_no_diacratic" : "واعبدوا الله ولا تشركوا به شيا وبالوٰلدين احسٰنا وبذي القربىٰ واليتٰمىٰ والمسٰكين والجار ذي القربىٰ والجار الجنب والصاحب بالجنب وابن السبيل وما ملكت ايمٰنكم ان الله لا يحب من كان مختالا فخورا",
    "ayahnumber" : "36",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "536",
    "page" : "84",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5360",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ لِمَ تُحَرِّمُ مَآ أَحَلَّ ٱللَّهُ لَكَۖ تَبۡتَغِي مَرۡضَاتَ أَزۡوَٰجِكَۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها النبي لم تحرم ما احل الله لك تبتغي مرضات ازوٰجك والله غفور رحيم",
    "ayahnumber" : "1",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5360",
    "page" : "560",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5361",
    "ayah_text" : "قَدۡ فَرَضَ ٱللَّهُ لَكُمۡ تَحِلَّةَ أَيۡمَٰنِكُمۡۚ وَٱللَّهُ مَوۡلَىٰكُمۡۖ وَهُوَ ٱلۡعَلِيمُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "قد فرض الله لكم تحلة ايمٰنكم والله مولىٰكم وهو العليم الحكيم",
    "ayahnumber" : "2",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5361",
    "page" : "560",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5362",
    "ayah_text" : "وَإِذۡ أَسَرَّ ٱلنَّبِيُّ إِلَىٰ بَعۡضِ أَزۡوَٰجِهِۦ حَدِيثٗا فَلَمَّا نَبَّأَتۡ بِهِۦ وَأَظۡهَرَهُ ٱللَّهُ عَلَيۡهِ عَرَّفَ بَعۡضَهُۥ وَأَعۡرَضَ عَنۢ بَعۡضٖۖ فَلَمَّا نَبَّأَهَا بِهِۦ قَالَتۡ مَنۡ أَنۢبَأَكَ هَٰذَاۖ قَالَ نَبَّأَنِيَ ٱلۡعَلِيمُ ٱلۡخَبِيرُ",
    "ayah_text_no_diacratic" : "واذ اسر النبي الىٰ بعض ازوٰجه حديثا فلما نبات به واظهره الله عليه عرف بعضه واعرض عن بعض فلما نباها به قالت من انباك هٰذا قال نباني العليم الخبير",
    "ayahnumber" : "3",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5362",
    "page" : "560",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5363",
    "ayah_text" : "إِن تَتُوبَآ إِلَى ٱللَّهِ فَقَدۡ صَغَتۡ قُلُوبُكُمَاۖ وَإِن تَظَٰهَرَا عَلَيۡهِ فَإِنَّ ٱللَّهَ هُوَ مَوۡلَىٰهُ وَجِبۡرِيلُ وَصَٰلِحُ ٱلۡمُؤۡمِنِينَۖ وَٱلۡمَلَٰٓئِكَةُ بَعۡدَ ذَٰلِكَ ظَهِيرٌ",
    "ayah_text_no_diacratic" : "ان تتوبا الى الله فقد صغت قلوبكما وان تظٰهرا عليه فان الله هو مولىٰه وجبريل وصٰلح المؤمنين والملٰئكة بعد ذٰلك ظهير",
    "ayahnumber" : "4",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5363",
    "page" : "560",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5364",
    "ayah_text" : "عَسَىٰ رَبُّهُۥٓ إِن طَلَّقَكُنَّ أَن يُبۡدِلَهُۥٓ أَزۡوَٰجًا خَيۡرٗا مِّنكُنَّ مُسۡلِمَٰتٖ مُّؤۡمِنَٰتٖ قَٰنِتَٰتٖ تَٰٓئِبَٰتٍ عَٰبِدَٰتٖ سَٰٓئِحَٰتٖ ثَيِّبَٰتٖ وَأَبۡكَارٗا",
    "ayah_text_no_diacratic" : "عسىٰ ربه ان طلقكن ان يبدله ازوٰجا خيرا منكن مسلمٰت مؤمنٰت قٰنتٰت تٰئبٰت عٰبدٰت سٰئحٰت ثيبٰت وابكارا",
    "ayahnumber" : "5",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5364",
    "page" : "560",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5365",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ قُوٓاْ أَنفُسَكُمۡ وَأَهۡلِيكُمۡ نَارٗا وَقُودُهَا ٱلنَّاسُ وَٱلۡحِجَارَةُ عَلَيۡهَا مَلَٰٓئِكَةٌ غِلَاظٞ شِدَادٞ لَّا يَعۡصُونَ ٱللَّهَ مَآ أَمَرَهُمۡ وَيَفۡعَلُونَ مَا يُؤۡمَرُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا قوا انفسكم واهليكم نارا وقودها الناس والحجارة عليها ملٰئكة غلاظ شداد لا يعصون الله ما امرهم ويفعلون ما يؤمرون",
    "ayahnumber" : "6",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5365",
    "page" : "560",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5366",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ كَفَرُواْ لَا تَعۡتَذِرُواْ ٱلۡيَوۡمَۖ إِنَّمَا تُجۡزَوۡنَ مَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين كفروا لا تعتذروا اليوم انما تجزون ما كنتم تعملون",
    "ayahnumber" : "7",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5366",
    "page" : "560",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5367",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ تُوبُوٓاْ إِلَى ٱللَّهِ تَوۡبَةٗ نَّصُوحًا عَسَىٰ رَبُّكُمۡ أَن يُكَفِّرَ عَنكُمۡ سَيِّـَٔاتِكُمۡ وَيُدۡخِلَكُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ يَوۡمَ لَا يُخۡزِي ٱللَّهُ ٱلنَّبِيَّ وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥۖ نُورُهُمۡ يَسۡعَىٰ بَيۡنَ أَيۡدِيهِمۡ وَبِأَيۡمَٰنِهِمۡ يَقُولُونَ رَبَّنَآ أَتۡمِمۡ لَنَا نُورَنَا وَٱغۡفِرۡ لَنَآۖ إِنَّكَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا توبوا الى الله توبة نصوحا عسىٰ ربكم ان يكفر عنكم سياتكم ويدخلكم جنٰت تجري من تحتها الانهٰر يوم لا يخزي الله النبي والذين ءامنوا معه نورهم يسعىٰ بين ايديهم وبايمٰنهم يقولون ربنا اتمم لنا نورنا واغفر لنا انك علىٰ كل شيء قدير",
    "ayahnumber" : "8",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5367",
    "page" : "561",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5368",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّبِيُّ جَٰهِدِ ٱلۡكُفَّارَ وَٱلۡمُنَٰفِقِينَ وَٱغۡلُظۡ عَلَيۡهِمۡۚ وَمَأۡوَىٰهُمۡ جَهَنَّمُۖ وَبِئۡسَ ٱلۡمَصِيرُ",
    "ayah_text_no_diacratic" : "يٰايها النبي جٰهد الكفار والمنٰفقين واغلظ عليهم وماوىٰهم جهنم وبئس المصير",
    "ayahnumber" : "9",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5368",
    "page" : "561",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5369",
    "ayah_text" : "ضَرَبَ ٱللَّهُ مَثَلٗا لِّلَّذِينَ كَفَرُواْ ٱمۡرَأَتَ نُوحٖ وَٱمۡرَأَتَ لُوطٖۖ كَانَتَا تَحۡتَ عَبۡدَيۡنِ مِنۡ عِبَادِنَا صَٰلِحَيۡنِ فَخَانَتَاهُمَا فَلَمۡ يُغۡنِيَا عَنۡهُمَا مِنَ ٱللَّهِ شَيۡـٔٗا وَقِيلَ ٱدۡخُلَا ٱلنَّارَ مَعَ ٱلدَّٰخِلِينَ",
    "ayah_text_no_diacratic" : "ضرب الله مثلا للذين كفروا امرات نوح وامرات لوط كانتا تحت عبدين من عبادنا صٰلحين فخانتاهما فلم يغنيا عنهما من الله شيا وقيل ادخلا النار مع الدٰخلين",
    "ayahnumber" : "10",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5369",
    "page" : "561",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:537",
    "ayah_text" : "ٱلَّذِينَ يَبۡخَلُونَ وَيَأۡمُرُونَ ٱلنَّاسَ بِٱلۡبُخۡلِ وَيَكۡتُمُونَ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضۡلِهِۦۗ وَأَعۡتَدۡنَا لِلۡكَٰفِرِينَ عَذَابٗا مُّهِينٗا",
    "ayah_text_no_diacratic" : "الذين يبخلون ويامرون الناس بالبخل ويكتمون ما ءاتىٰهم الله من فضله واعتدنا للكٰفرين عذابا مهينا",
    "ayahnumber" : "37",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "537",
    "page" : "84",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5370",
    "ayah_text" : "وَضَرَبَ ٱللَّهُ مَثَلٗا لِّلَّذِينَ ءَامَنُواْ ٱمۡرَأَتَ فِرۡعَوۡنَ إِذۡ قَالَتۡ رَبِّ ٱبۡنِ لِي عِندَكَ بَيۡتٗا فِي ٱلۡجَنَّةِ وَنَجِّنِي مِن فِرۡعَوۡنَ وَعَمَلِهِۦ وَنَجِّنِي مِنَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "وضرب الله مثلا للذين ءامنوا امرات فرعون اذ قالت رب ابن لي عندك بيتا في الجنة ونجني من فرعون وعمله ونجني من القوم الظٰلمين",
    "ayahnumber" : "11",
    "chapter" : "28",
    "hizb" : "56",
    "index" : "5370",
    "page" : "561",
    "surahname" : "سُورَةُ التَّحۡرِيمِ",
    "surahnumber" : "66",
    "surrahname_no_diacratic" : "سورة التحريم"
  }, {
    "@id" : "quran:5371",
    "ayah_text" : "وَمَرۡيَمَ ٱبۡنَتَ عِمۡرَٰنَ ٱلَّتِيٓ أَحۡصَنَتۡ فَرۡجَهَا فَنَفَخۡنَا فِيهِ مِن رُّوحِنَا وَصَدَّقَتۡ بِكَلِمَٰتِ رَبِّهَا وَكُتُبِهِۦ وَكَانَتۡ مِنَ ٱلۡقَٰنِتِينَ",
    "ayah_text_no_diacratic" : "ومريم ابنت عمرٰن التي احصنت فرجها فنفخنا فيه من روحنا وصدقت بكلمٰت ربها وكتبه وكانت من القٰنتين",
    "ayahnumber" : "12",
    "chapter" : "28",
