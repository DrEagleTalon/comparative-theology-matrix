    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2916",
    "ayah_text" : "وَإِذَآ أُلۡقُواْ مِنۡهَا مَكَانٗا ضَيِّقٗا مُّقَرَّنِينَ دَعَوۡاْ هُنَالِكَ ثُبُورٗا",
    "ayah_text_no_diacratic" : "واذا القوا منها مكانا ضيقا مقرنين دعوا هنالك ثبورا",
    "ayahnumber" : "13",
    "chapter" : "18",
    "hizb" : "36",
