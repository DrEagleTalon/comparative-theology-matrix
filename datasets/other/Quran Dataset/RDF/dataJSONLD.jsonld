    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4449",
    "ayah_text" : "أَفَأَنتَ تُسۡمِعُ ٱلصُّمَّ أَوۡ تَهۡدِي ٱلۡعُمۡيَ وَمَن كَانَ فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "افانت تسمع الصم او تهدي العمي ومن كان في ضلٰل مبين",
    "ayahnumber" : "40",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4449",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:445",
    "ayah_text" : "وَمَا كَانَ قَوۡلَهُمۡ إِلَّآ أَن قَالُواْ رَبَّنَا ٱغۡفِرۡ لَنَا ذُنُوبَنَا وَإِسۡرَافَنَا فِيٓ أَمۡرِنَا وَثَبِّتۡ أَقۡدَامَنَا وَٱنصُرۡنَا عَلَى ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "وما كان قولهم الا ان قالوا ربنا اغفر لنا ذنوبنا واسرافنا في امرنا وثبت اقدامنا وانصرنا على القوم الكٰفرين",
    "ayahnumber" : "147",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "445",
    "page" : "68",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4450",
    "ayah_text" : "فَإِمَّا نَذۡهَبَنَّ بِكَ فَإِنَّا مِنۡهُم مُّنتَقِمُونَ",
    "ayah_text_no_diacratic" : "فاما نذهبن بك فانا منهم منتقمون",
    "ayahnumber" : "41",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4450",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4451",
    "ayah_text" : "أَوۡ نُرِيَنَّكَ ٱلَّذِي وَعَدۡنَٰهُمۡ فَإِنَّا عَلَيۡهِم مُّقۡتَدِرُونَ",
    "ayah_text_no_diacratic" : "او نرينك الذي وعدنٰهم فانا عليهم مقتدرون",
    "ayahnumber" : "42",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4451",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4452",
    "ayah_text" : "فَٱسۡتَمۡسِكۡ بِٱلَّذِيٓ أُوحِيَ إِلَيۡكَۖ إِنَّكَ عَلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "فاستمسك بالذي اوحي اليك انك علىٰ صرٰط مستقيم",
    "ayahnumber" : "43",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4452",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4453",
    "ayah_text" : "وَإِنَّهُۥ لَذِكۡرٞ لَّكَ وَلِقَوۡمِكَۖ وَسَوۡفَ تُسۡـَٔلُونَ",
    "ayah_text_no_diacratic" : "وانه لذكر لك ولقومك وسوف تسلون",
    "ayahnumber" : "44",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4453",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4454",
    "ayah_text" : "وَسۡـَٔلۡ مَنۡ أَرۡسَلۡنَا مِن قَبۡلِكَ مِن رُّسُلِنَآ أَجَعَلۡنَا مِن دُونِ ٱلرَّحۡمَٰنِ ءَالِهَةٗ يُعۡبَدُونَ",
    "ayah_text_no_diacratic" : "وسل من ارسلنا من قبلك من رسلنا اجعلنا من دون الرحمٰن ءالهة يعبدون",
    "ayahnumber" : "45",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4454",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4455",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا مُوسَىٰ بِـَٔايَٰتِنَآ إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦ فَقَالَ إِنِّي رَسُولُ رَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا موسىٰ بايٰتنا الىٰ فرعون وملايه فقال اني رسول رب العٰلمين",
    "ayahnumber" : "46",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4455",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4456",
    "ayah_text" : "فَلَمَّا جَآءَهُم بِـَٔايَٰتِنَآ إِذَا هُم مِّنۡهَا يَضۡحَكُونَ",
    "ayah_text_no_diacratic" : "فلما جاءهم بايٰتنا اذا هم منها يضحكون",
    "ayahnumber" : "47",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4456",
    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4457",
    "ayah_text" : "وَمَا نُرِيهِم مِّنۡ ءَايَةٍ إِلَّا هِيَ أَكۡبَرُ مِنۡ أُخۡتِهَاۖ وَأَخَذۡنَٰهُم بِٱلۡعَذَابِ لَعَلَّهُمۡ يَرۡجِعُونَ",
    "ayah_text_no_diacratic" : "وما نريهم من ءاية الا هي اكبر من اختها واخذنٰهم بالعذاب لعلهم يرجعون",
    "ayahnumber" : "48",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4457",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4458",
    "ayah_text" : "وَقَالُواْ يَٰٓأَيُّهَ ٱلسَّاحِرُ ٱدۡعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَ إِنَّنَا لَمُهۡتَدُونَ",
    "ayah_text_no_diacratic" : "وقالوا يٰايه الساحر ادع لنا ربك بما عهد عندك اننا لمهتدون",
    "ayahnumber" : "49",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4458",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4459",
    "ayah_text" : "فَلَمَّا كَشَفۡنَا عَنۡهُمُ ٱلۡعَذَابَ إِذَا هُمۡ يَنكُثُونَ",
    "ayah_text_no_diacratic" : "فلما كشفنا عنهم العذاب اذا هم ينكثون",
    "ayahnumber" : "50",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4459",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:446",
    "ayah_text" : "فَـَٔاتَىٰهُمُ ٱللَّهُ ثَوَابَ ٱلدُّنۡيَا وَحُسۡنَ ثَوَابِ ٱلۡأٓخِرَةِۗ وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "فاتىٰهم الله ثواب الدنيا وحسن ثواب الاخرة والله يحب المحسنين",
    "ayahnumber" : "148",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "446",
    "page" : "68",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4460",
    "ayah_text" : "وَنَادَىٰ فِرۡعَوۡنُ فِي قَوۡمِهِۦ قَالَ يَٰقَوۡمِ أَلَيۡسَ لِي مُلۡكُ مِصۡرَ وَهَٰذِهِ ٱلۡأَنۡهَٰرُ تَجۡرِي مِن تَحۡتِيٓۚ أَفَلَا تُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "ونادىٰ فرعون في قومه قال يٰقوم اليس لي ملك مصر وهٰذه الانهٰر تجري من تحتي افلا تبصرون",
    "ayahnumber" : "51",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4460",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4461",
    "ayah_text" : "أَمۡ أَنَا۠ خَيۡرٞ مِّنۡ هَٰذَا ٱلَّذِي هُوَ مَهِينٞ وَلَا يَكَادُ يُبِينُ",
    "ayah_text_no_diacratic" : "ام انا خير من هٰذا الذي هو مهين ولا يكاد يبين",
    "ayahnumber" : "52",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4461",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4462",
    "ayah_text" : "فَلَوۡلَآ أُلۡقِيَ عَلَيۡهِ أَسۡوِرَةٞ مِّن ذَهَبٍ أَوۡ جَآءَ مَعَهُ ٱلۡمَلَٰٓئِكَةُ مُقۡتَرِنِينَ",
    "ayah_text_no_diacratic" : "فلولا القي عليه اسورة من ذهب او جاء معه الملٰئكة مقترنين",
    "ayahnumber" : "53",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4462",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4463",
    "ayah_text" : "فَٱسۡتَخَفَّ قَوۡمَهُۥ فَأَطَاعُوهُۚ إِنَّهُمۡ كَانُواْ قَوۡمٗا فَٰسِقِينَ",
    "ayah_text_no_diacratic" : "فاستخف قومه فاطاعوه انهم كانوا قوما فٰسقين",
    "ayahnumber" : "54",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4463",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4464",
    "ayah_text" : "فَلَمَّآ ءَاسَفُونَا ٱنتَقَمۡنَا مِنۡهُمۡ فَأَغۡرَقۡنَٰهُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "فلما ءاسفونا انتقمنا منهم فاغرقنٰهم اجمعين",
    "ayahnumber" : "55",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4464",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4465",
    "ayah_text" : "فَجَعَلۡنَٰهُمۡ سَلَفٗا وَمَثَلٗا لِّلۡأٓخِرِينَ",
    "ayah_text_no_diacratic" : "فجعلنٰهم سلفا ومثلا للاخرين",
    "ayahnumber" : "56",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4465",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4466",
    "ayah_text" : "۞وَلَمَّا ضُرِبَ ٱبۡنُ مَرۡيَمَ مَثَلًا إِذَا قَوۡمُكَ مِنۡهُ يَصِدُّونَ",
    "ayah_text_no_diacratic" : "ولما ضرب ابن مريم مثلا اذا قومك منه يصدون",
    "ayahnumber" : "57",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4466",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4467",
    "ayah_text" : "وَقَالُوٓاْ ءَأَٰلِهَتُنَا خَيۡرٌ أَمۡ هُوَۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَلَۢاۚ بَلۡ هُمۡ قَوۡمٌ خَصِمُونَ",
    "ayah_text_no_diacratic" : "وقالوا ءاٰلهتنا خير ام هو ما ضربوه لك الا جدلا بل هم قوم خصمون",
    "ayahnumber" : "58",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4467",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4468",
    "ayah_text" : "إِنۡ هُوَ إِلَّا عَبۡدٌ أَنۡعَمۡنَا عَلَيۡهِ وَجَعَلۡنَٰهُ مَثَلٗا لِّبَنِيٓ إِسۡرَٰٓءِيلَ",
    "ayah_text_no_diacratic" : "ان هو الا عبد انعمنا عليه وجعلنٰه مثلا لبني اسرٰءيل",
    "ayahnumber" : "59",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4468",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4469",
    "ayah_text" : "وَلَوۡ نَشَآءُ لَجَعَلۡنَا مِنكُم مَّلَٰٓئِكَةٗ فِي ٱلۡأَرۡضِ يَخۡلُفُونَ",
    "ayah_text_no_diacratic" : "ولو نشاء لجعلنا منكم ملٰئكة في الارض يخلفون",
    "ayahnumber" : "60",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4469",
    "page" : "493",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:447",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِن تُطِيعُواْ ٱلَّذِينَ كَفَرُواْ يَرُدُّوكُمۡ عَلَىٰٓ أَعۡقَٰبِكُمۡ فَتَنقَلِبُواْ خَٰسِرِينَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ان تطيعوا الذين كفروا يردوكم علىٰ اعقٰبكم فتنقلبوا خٰسرين",
    "ayahnumber" : "149",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "447",
    "page" : "69",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4470",
    "ayah_text" : "وَإِنَّهُۥ لَعِلۡمٞ لِّلسَّاعَةِ فَلَا تَمۡتَرُنَّ بِهَا وَٱتَّبِعُونِۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ",
    "ayah_text_no_diacratic" : "وانه لعلم للساعة فلا تمترن بها واتبعون هٰذا صرٰط مستقيم",
    "ayahnumber" : "61",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4470",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4471",
    "ayah_text" : "وَلَا يَصُدَّنَّكُمُ ٱلشَّيۡطَٰنُۖ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "ولا يصدنكم الشيطٰن انه لكم عدو مبين",
    "ayahnumber" : "62",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4471",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4472",
    "ayah_text" : "وَلَمَّا جَآءَ عِيسَىٰ بِٱلۡبَيِّنَٰتِ قَالَ قَدۡ جِئۡتُكُم بِٱلۡحِكۡمَةِ وَلِأُبَيِّنَ لَكُم بَعۡضَ ٱلَّذِي تَخۡتَلِفُونَ فِيهِۖ فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",
    "ayah_text_no_diacratic" : "ولما جاء عيسىٰ بالبينٰت قال قد جئتكم بالحكمة ولابين لكم بعض الذي تختلفون فيه فاتقوا الله واطيعون",
    "ayahnumber" : "63",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4472",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4473",
    "ayah_text" : "إِنَّ ٱللَّهَ هُوَ رَبِّي وَرَبُّكُمۡ فَٱعۡبُدُوهُۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ",
    "ayah_text_no_diacratic" : "ان الله هو ربي وربكم فاعبدوه هٰذا صرٰط مستقيم",
    "ayahnumber" : "64",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4473",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4474",
    "ayah_text" : "فَٱخۡتَلَفَ ٱلۡأَحۡزَابُ مِنۢ بَيۡنِهِمۡۖ فَوَيۡلٞ لِّلَّذِينَ ظَلَمُواْ مِنۡ عَذَابِ يَوۡمٍ أَلِيمٍ",
    "ayah_text_no_diacratic" : "فاختلف الاحزاب من بينهم فويل للذين ظلموا من عذاب يوم اليم",
    "ayahnumber" : "65",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4474",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4475",
    "ayah_text" : "هَلۡ يَنظُرُونَ إِلَّا ٱلسَّاعَةَ أَن تَأۡتِيَهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "هل ينظرون الا الساعة ان تاتيهم بغتة وهم لا يشعرون",
    "ayahnumber" : "66",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4475",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4476",
    "ayah_text" : "ٱلۡأَخِلَّآءُ يَوۡمَئِذِۭ بَعۡضُهُمۡ لِبَعۡضٍ عَدُوٌّ إِلَّا ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "الاخلاء يومئذ بعضهم لبعض عدو الا المتقين",
    "ayahnumber" : "67",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4476",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4477",
    "ayah_text" : "يَٰعِبَادِ لَا خَوۡفٌ عَلَيۡكُمُ ٱلۡيَوۡمَ وَلَآ أَنتُمۡ تَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "يٰعباد لا خوف عليكم اليوم ولا انتم تحزنون",
    "ayahnumber" : "68",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4477",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4478",
    "ayah_text" : "ٱلَّذِينَ ءَامَنُواْ بِـَٔايَٰتِنَا وَكَانُواْ مُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "الذين ءامنوا بايٰتنا وكانوا مسلمين",
    "ayahnumber" : "69",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4478",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4479",
    "ayah_text" : "ٱدۡخُلُواْ ٱلۡجَنَّةَ أَنتُمۡ وَأَزۡوَٰجُكُمۡ تُحۡبَرُونَ",
    "ayah_text_no_diacratic" : "ادخلوا الجنة انتم وازوٰجكم تحبرون",
    "ayahnumber" : "70",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4479",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:448",
    "ayah_text" : "بَلِ ٱللَّهُ مَوۡلَىٰكُمۡۖ وَهُوَ خَيۡرُ ٱلنَّٰصِرِينَ",
    "ayah_text_no_diacratic" : "بل الله مولىٰكم وهو خير النٰصرين",
    "ayahnumber" : "150",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "448",
    "page" : "69",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4480",
    "ayah_text" : "يُطَافُ عَلَيۡهِم بِصِحَافٖ مِّن ذَهَبٖ وَأَكۡوَابٖۖ وَفِيهَا مَا تَشۡتَهِيهِ ٱلۡأَنفُسُ وَتَلَذُّ ٱلۡأَعۡيُنُۖ وَأَنتُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "يطاف عليهم بصحاف من ذهب واكواب وفيها ما تشتهيه الانفس وتلذ الاعين وانتم فيها خٰلدون",
    "ayahnumber" : "71",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4480",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4481",
    "ayah_text" : "وَتِلۡكَ ٱلۡجَنَّةُ ٱلَّتِيٓ أُورِثۡتُمُوهَا بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "وتلك الجنة التي اورثتموها بما كنتم تعملون",
    "ayahnumber" : "72",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4481",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4482",
    "ayah_text" : "لَكُمۡ فِيهَا فَٰكِهَةٞ كَثِيرَةٞ مِّنۡهَا تَأۡكُلُونَ",
    "ayah_text_no_diacratic" : "لكم فيها فٰكهة كثيرة منها تاكلون",
    "ayahnumber" : "73",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4482",
    "page" : "494",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4483",
    "ayah_text" : "إِنَّ ٱلۡمُجۡرِمِينَ فِي عَذَابِ جَهَنَّمَ خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "ان المجرمين في عذاب جهنم خٰلدون",
    "ayahnumber" : "74",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4483",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4484",
    "ayah_text" : "لَا يُفَتَّرُ عَنۡهُمۡ وَهُمۡ فِيهِ مُبۡلِسُونَ",
    "ayah_text_no_diacratic" : "لا يفتر عنهم وهم فيه مبلسون",
    "ayahnumber" : "75",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4484",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4485",
    "ayah_text" : "وَمَا ظَلَمۡنَٰهُمۡ وَلَٰكِن كَانُواْ هُمُ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "وما ظلمنٰهم ولٰكن كانوا هم الظٰلمين",
    "ayahnumber" : "76",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4485",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4486",
    "ayah_text" : "وَنَادَوۡاْ يَٰمَٰلِكُ لِيَقۡضِ عَلَيۡنَا رَبُّكَۖ قَالَ إِنَّكُم مَّٰكِثُونَ",
    "ayah_text_no_diacratic" : "ونادوا يٰمٰلك ليقض علينا ربك قال انكم مٰكثون",
    "ayahnumber" : "77",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4486",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4487",
    "ayah_text" : "لَقَدۡ جِئۡنَٰكُم بِٱلۡحَقِّ وَلَٰكِنَّ أَكۡثَرَكُمۡ لِلۡحَقِّ كَٰرِهُونَ",
    "ayah_text_no_diacratic" : "لقد جئنٰكم بالحق ولٰكن اكثركم للحق كٰرهون",
    "ayahnumber" : "78",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4487",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4488",
    "ayah_text" : "أَمۡ أَبۡرَمُوٓاْ أَمۡرٗا فَإِنَّا مُبۡرِمُونَ",
    "ayah_text_no_diacratic" : "ام ابرموا امرا فانا مبرمون",
    "ayahnumber" : "79",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4488",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4489",
    "ayah_text" : "أَمۡ يَحۡسَبُونَ أَنَّا لَا نَسۡمَعُ سِرَّهُمۡ وَنَجۡوَىٰهُمۚ بَلَىٰ وَرُسُلُنَا لَدَيۡهِمۡ يَكۡتُبُونَ",
    "ayah_text_no_diacratic" : "ام يحسبون انا لا نسمع سرهم ونجوىٰهم بلىٰ ورسلنا لديهم يكتبون",
    "ayahnumber" : "80",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4489",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:449",
    "ayah_text" : "سَنُلۡقِي فِي قُلُوبِ ٱلَّذِينَ كَفَرُواْ ٱلرُّعۡبَ بِمَآ أَشۡرَكُواْ بِٱللَّهِ مَا لَمۡ يُنَزِّلۡ بِهِۦ سُلۡطَٰنٗاۖ وَمَأۡوَىٰهُمُ ٱلنَّارُۖ وَبِئۡسَ مَثۡوَى ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "سنلقي في قلوب الذين كفروا الرعب بما اشركوا بالله ما لم ينزل به سلطٰنا وماوىٰهم النار وبئس مثوى الظٰلمين",
    "ayahnumber" : "151",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "449",
    "page" : "69",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4490",
    "ayah_text" : "قُلۡ إِن كَانَ لِلرَّحۡمَٰنِ وَلَدٞ فَأَنَا۠ أَوَّلُ ٱلۡعَٰبِدِينَ",
    "ayah_text_no_diacratic" : "قل ان كان للرحمٰن ولد فانا اول العٰبدين",
    "ayahnumber" : "81",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4490",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4491",
    "ayah_text" : "سُبۡحَٰنَ رَبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ رَبِّ ٱلۡعَرۡشِ عَمَّا يَصِفُونَ",
    "ayah_text_no_diacratic" : "سبحٰن رب السمٰوٰت والارض رب العرش عما يصفون",
    "ayahnumber" : "82",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4491",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4492",
    "ayah_text" : "فَذَرۡهُمۡ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ",
    "ayah_text_no_diacratic" : "فذرهم يخوضوا ويلعبوا حتىٰ يلٰقوا يومهم الذي يوعدون",
    "ayahnumber" : "83",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4492",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4493",
    "ayah_text" : "وَهُوَ ٱلَّذِي فِي ٱلسَّمَآءِ إِلَٰهٞ وَفِي ٱلۡأَرۡضِ إِلَٰهٞۚ وَهُوَ ٱلۡحَكِيمُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "وهو الذي في السماء الٰه وفي الارض الٰه وهو الحكيم العليم",
    "ayahnumber" : "84",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4493",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4494",
    "ayah_text" : "وَتَبَارَكَ ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَعِندَهُۥ عِلۡمُ ٱلسَّاعَةِ وَإِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "وتبارك الذي له ملك السمٰوٰت والارض وما بينهما وعنده علم الساعة واليه ترجعون",
    "ayahnumber" : "85",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4494",
    "page" : "495",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4495",
    "ayah_text" : "وَلَا يَمۡلِكُ ٱلَّذِينَ يَدۡعُونَ مِن دُونِهِ ٱلشَّفَٰعَةَ إِلَّا مَن شَهِدَ بِٱلۡحَقِّ وَهُمۡ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولا يملك الذين يدعون من دونه الشفٰعة الا من شهد بالحق وهم يعلمون",
