  }, {
    "@id" : "quran:5429",
    "ayah_text" : "أَن لَّا يَدۡخُلَنَّهَا ٱلۡيَوۡمَ عَلَيۡكُم مِّسۡكِينٞ",
    "ayah_text_no_diacratic" : "ان لا يدخلنها اليوم عليكم مسكين",
