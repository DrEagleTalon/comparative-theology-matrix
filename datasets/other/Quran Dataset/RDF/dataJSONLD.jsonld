    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2407",
    "ayah_text" : "قَالَ خُذۡهَا وَلَا تَخَفۡۖ سَنُعِيدُهَا سِيرَتَهَا ٱلۡأُولَىٰ",
    "ayah_text_no_diacratic" : "قال خذها ولا تخف سنعيدها سيرتها الاولىٰ",
    "ayahnumber" : "21",
