  }, {
    "@id" : "quran:901",
    "ayah_text" : "بَدِيعُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ أَنَّىٰ يَكُونُ لَهُۥ وَلَدٞ وَلَمۡ تَكُن لَّهُۥ صَٰحِبَةٞۖ وَخَلَقَ كُلَّ شَيۡءٖۖ وَهُوَ بِكُلِّ شَيۡءٍ عَلِيمٞ",
    "ayah_text_no_diacratic" : "بديع السمٰوٰت والارض انىٰ يكون له ولد ولم تكن له صٰحبة وخلق كل شيء وهو بكل شيء عليم",
    "ayahnumber" : "101",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "901",
    "page" : "140",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:902",
    "ayah_text" : "ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡۖ لَآ إِلَٰهَ إِلَّا هُوَۖ خَٰلِقُ كُلِّ شَيۡءٖ فَٱعۡبُدُوهُۚ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ وَكِيلٞ",
    "ayah_text_no_diacratic" : "ذٰلكم الله ربكم لا الٰه الا هو خٰلق كل شيء فاعبدوه وهو علىٰ كل شيء وكيل",
    "ayahnumber" : "102",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "902",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:903",
    "ayah_text" : "لَّا تُدۡرِكُهُ ٱلۡأَبۡصَٰرُ وَهُوَ يُدۡرِكُ ٱلۡأَبۡصَٰرَۖ وَهُوَ ٱللَّطِيفُ ٱلۡخَبِيرُ",
    "ayah_text_no_diacratic" : "لا تدركه الابصٰر وهو يدرك الابصٰر وهو اللطيف الخبير",
    "ayahnumber" : "103",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "903",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:904",
    "ayah_text" : "قَدۡ جَآءَكُم بَصَآئِرُ مِن رَّبِّكُمۡۖ فَمَنۡ أَبۡصَرَ فَلِنَفۡسِهِۦۖ وَمَنۡ عَمِيَ فَعَلَيۡهَاۚ وَمَآ أَنَا۠ عَلَيۡكُم بِحَفِيظٖ",
    "ayah_text_no_diacratic" : "قد جاءكم بصائر من ربكم فمن ابصر فلنفسه ومن عمي فعليها وما انا عليكم بحفيظ",
    "ayahnumber" : "104",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "904",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:905",
    "ayah_text" : "وَكَذَٰلِكَ نُصَرِّفُ ٱلۡأٓيَٰتِ وَلِيَقُولُواْ دَرَسۡتَ وَلِنُبَيِّنَهُۥ لِقَوۡمٖ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وكذٰلك نصرف الايٰت وليقولوا درست ولنبينه لقوم يعلمون",
    "ayahnumber" : "105",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "905",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:906",
    "ayah_text" : "ٱتَّبِعۡ مَآ أُوحِيَ إِلَيۡكَ مِن رَّبِّكَۖ لَآ إِلَٰهَ إِلَّا هُوَۖ وَأَعۡرِضۡ عَنِ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "اتبع ما اوحي اليك من ربك لا الٰه الا هو واعرض عن المشركين",
    "ayahnumber" : "106",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "906",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:907",
    "ayah_text" : "وَلَوۡ شَآءَ ٱللَّهُ مَآ أَشۡرَكُواْۗ وَمَا جَعَلۡنَٰكَ عَلَيۡهِمۡ حَفِيظٗاۖ وَمَآ أَنتَ عَلَيۡهِم بِوَكِيلٖ",
    "ayah_text_no_diacratic" : "ولو شاء الله ما اشركوا وما جعلنٰك عليهم حفيظا وما انت عليهم بوكيل",
    "ayahnumber" : "107",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "907",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:908",
    "ayah_text" : "وَلَا تَسُبُّواْ ٱلَّذِينَ يَدۡعُونَ مِن دُونِ ٱللَّهِ فَيَسُبُّواْ ٱللَّهَ عَدۡوَۢا بِغَيۡرِ عِلۡمٖۗ كَذَٰلِكَ زَيَّنَّا لِكُلِّ أُمَّةٍ عَمَلَهُمۡ ثُمَّ إِلَىٰ رَبِّهِم مَّرۡجِعُهُمۡ فَيُنَبِّئُهُم بِمَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ولا تسبوا الذين يدعون من دون الله فيسبوا الله عدوا بغير علم كذٰلك زينا لكل امة عملهم ثم الىٰ ربهم مرجعهم فينبئهم بما كانوا يعملون",
    "ayahnumber" : "108",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "908",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:909",
    "ayah_text" : "وَأَقۡسَمُواْ بِٱللَّهِ جَهۡدَ أَيۡمَٰنِهِمۡ لَئِن جَآءَتۡهُمۡ ءَايَةٞ لَّيُؤۡمِنُنَّ بِهَاۚ قُلۡ إِنَّمَا ٱلۡأٓيَٰتُ عِندَ ٱللَّهِۖ وَمَا يُشۡعِرُكُمۡ أَنَّهَآ إِذَا جَآءَتۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "واقسموا بالله جهد ايمٰنهم لئن جاءتهم ءاية ليؤمنن بها قل انما الايٰت عند الله وما يشعركم انها اذا جاءت لا يؤمنون",
    "ayahnumber" : "109",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "909",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:91",
    "ayah_text" : "بَلَىٰۚ مَن كَسَبَ سَيِّئَةٗ وَأَحَٰطَتۡ بِهِۦ خَطِيٓـَٔتُهُۥ فَأُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "بلىٰ من كسب سيئة واحٰطت به خطيته فاولٰئك اصحٰب النار هم فيها خٰلدون",
    "ayahnumber" : "81",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "91",
    "page" : "12",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:910",
    "ayah_text" : "وَنُقَلِّبُ أَفۡـِٔدَتَهُمۡ وَأَبۡصَٰرَهُمۡ كَمَا لَمۡ يُؤۡمِنُواْ بِهِۦٓ أَوَّلَ مَرَّةٖ وَنَذَرُهُمۡ فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ",
    "ayah_text_no_diacratic" : "ونقلب افدتهم وابصٰرهم كما لم يؤمنوا به اول مرة ونذرهم في طغيٰنهم يعمهون",
    "ayahnumber" : "110",
    "chapter" : "7",
    "hizb" : "14",
    "index" : "910",
    "page" : "141",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:911",
    "ayah_text" : "۞وَلَوۡ أَنَّنَا نَزَّلۡنَآ إِلَيۡهِمُ ٱلۡمَلَٰٓئِكَةَ وَكَلَّمَهُمُ ٱلۡمَوۡتَىٰ وَحَشَرۡنَا عَلَيۡهِمۡ كُلَّ شَيۡءٖ قُبُلٗا مَّا كَانُواْ لِيُؤۡمِنُوٓاْ إِلَّآ أَن يَشَآءَ ٱللَّهُ وَلَٰكِنَّ أَكۡثَرَهُمۡ يَجۡهَلُونَ",
    "ayah_text_no_diacratic" : "ولو اننا نزلنا اليهم الملٰئكة وكلمهم الموتىٰ وحشرنا عليهم كل شيء قبلا ما كانوا ليؤمنوا الا ان يشاء الله ولٰكن اكثرهم يجهلون",
    "ayahnumber" : "111",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "911",
    "page" : "142",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:912",
    "ayah_text" : "وَكَذَٰلِكَ جَعَلۡنَا لِكُلِّ نَبِيٍّ عَدُوّٗا شَيَٰطِينَ ٱلۡإِنسِ وَٱلۡجِنِّ يُوحِي بَعۡضُهُمۡ إِلَىٰ بَعۡضٖ زُخۡرُفَ ٱلۡقَوۡلِ غُرُورٗاۚ وَلَوۡ شَآءَ رَبُّكَ مَا فَعَلُوهُۖ فَذَرۡهُمۡ وَمَا يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "وكذٰلك جعلنا لكل نبي عدوا شيٰطين الانس والجن يوحي بعضهم الىٰ بعض زخرف القول غرورا ولو شاء ربك ما فعلوه فذرهم وما يفترون",
    "ayahnumber" : "112",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "912",
    "page" : "142",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:913",
    "ayah_text" : "وَلِتَصۡغَىٰٓ إِلَيۡهِ أَفۡـِٔدَةُ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ وَلِيَرۡضَوۡهُ وَلِيَقۡتَرِفُواْ مَا هُم مُّقۡتَرِفُونَ",
    "ayah_text_no_diacratic" : "ولتصغىٰ اليه افدة الذين لا يؤمنون بالاخرة وليرضوه وليقترفوا ما هم مقترفون",
    "ayahnumber" : "113",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "913",
    "page" : "142",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:914",
    "ayah_text" : "أَفَغَيۡرَ ٱللَّهِ أَبۡتَغِي حَكَمٗا وَهُوَ ٱلَّذِيٓ أَنزَلَ إِلَيۡكُمُ ٱلۡكِتَٰبَ مُفَصَّلٗاۚ وَٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَعۡلَمُونَ أَنَّهُۥ مُنَزَّلٞ مِّن رَّبِّكَ بِٱلۡحَقِّۖ فَلَا تَكُونَنَّ مِنَ ٱلۡمُمۡتَرِينَ",
    "ayah_text_no_diacratic" : "افغير الله ابتغي حكما وهو الذي انزل اليكم الكتٰب مفصلا والذين ءاتينٰهم الكتٰب يعلمون انه منزل من ربك بالحق فلا تكونن من الممترين",
    "ayahnumber" : "114",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "914",
    "page" : "142",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:915",
    "ayah_text" : "وَتَمَّتۡ كَلِمَتُ رَبِّكَ صِدۡقٗا وَعَدۡلٗاۚ لَّا مُبَدِّلَ لِكَلِمَٰتِهِۦۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "وتمت كلمت ربك صدقا وعدلا لا مبدل لكلمٰته وهو السميع العليم",
    "ayahnumber" : "115",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "915",
    "page" : "142",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:916",
    "ayah_text" : "وَإِن تُطِعۡ أَكۡثَرَ مَن فِي ٱلۡأَرۡضِ يُضِلُّوكَ عَن سَبِيلِ ٱللَّهِۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنۡ هُمۡ إِلَّا يَخۡرُصُونَ",
    "ayah_text_no_diacratic" : "وان تطع اكثر من في الارض يضلوك عن سبيل الله ان يتبعون الا الظن وان هم الا يخرصون",
    "ayahnumber" : "116",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "916",
    "page" : "142",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:917",
    "ayah_text" : "إِنَّ رَبَّكَ هُوَ أَعۡلَمُ مَن يَضِلُّ عَن سَبِيلِهِۦۖ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ",
    "ayah_text_no_diacratic" : "ان ربك هو اعلم من يضل عن سبيله وهو اعلم بالمهتدين",
    "ayahnumber" : "117",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "917",
    "page" : "142",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:918",
    "ayah_text" : "فَكُلُواْ مِمَّا ذُكِرَ ٱسۡمُ ٱللَّهِ عَلَيۡهِ إِن كُنتُم بِـَٔايَٰتِهِۦ مُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "فكلوا مما ذكر اسم الله عليه ان كنتم بايٰته مؤمنين",
    "ayahnumber" : "118",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "918",
    "page" : "142",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:919",
    "ayah_text" : "وَمَا لَكُمۡ أَلَّا تَأۡكُلُواْ مِمَّا ذُكِرَ ٱسۡمُ ٱللَّهِ عَلَيۡهِ وَقَدۡ فَصَّلَ لَكُم مَّا حَرَّمَ عَلَيۡكُمۡ إِلَّا مَا ٱضۡطُرِرۡتُمۡ إِلَيۡهِۗ وَإِنَّ كَثِيرٗا لَّيُضِلُّونَ بِأَهۡوَآئِهِم بِغَيۡرِ عِلۡمٍۚ إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِٱلۡمُعۡتَدِينَ",
    "ayah_text_no_diacratic" : "وما لكم الا تاكلوا مما ذكر اسم الله عليه وقد فصل لكم ما حرم عليكم الا ما اضطررتم اليه وان كثيرا ليضلون باهوائهم بغير علم ان ربك هو اعلم بالمعتدين",
    "ayahnumber" : "119",
    "chapter" : "8",
    "hizb" : "14",
    "index" : "919",
    "page" : "143",
    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:92",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡجَنَّةِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "والذين ءامنوا وعملوا الصٰلحٰت اولٰئك اصحٰب الجنة هم فيها خٰلدون",
    "ayahnumber" : "82",
