  }, {
    "@id" : "quran:5479",
    "ayah_text" : "إِنِّي ظَنَنتُ أَنِّي مُلَٰقٍ حِسَابِيَهۡ",
    "ayah_text_no_diacratic" : "اني ظننت اني ملٰق حسابيه",
