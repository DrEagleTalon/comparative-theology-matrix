    "surrahname_no_diacratic" : "سورة الدخان"
  }, {
    "@id" : "quran:4506",
    "ayah_text" : "رَحۡمَةٗ مِّن رَّبِّكَۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
