    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:5289",
    "ayah_text" : "وَإِذۡ قَالَ عِيسَى ٱبۡنُ مَرۡيَمَ يَٰبَنِيٓ إِسۡرَٰٓءِيلَ إِنِّي رَسُولُ ٱللَّهِ إِلَيۡكُم مُّصَدِّقٗا لِّمَا بَيۡنَ يَدَيَّ مِنَ ٱلتَّوۡرَىٰةِ وَمُبَشِّرَۢا بِرَسُولٖ يَأۡتِي مِنۢ بَعۡدِي ٱسۡمُهُۥٓ أَحۡمَدُۖ فَلَمَّا جَآءَهُم بِٱلۡبَيِّنَٰتِ قَالُواْ هَٰذَا سِحۡرٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "واذ قال عيسى ابن مريم يٰبني اسرٰءيل اني رسول الله اليكم مصدقا لما بين يدي من التورىٰة ومبشرا برسول ياتي من بعدي اسمه احمد فلما جاءهم بالبينٰت قالوا هٰذا سحر مبين",
    "ayahnumber" : "6",
    "chapter" : "28",
    "hizb" : "55",
    "index" : "5289",
    "page" : "552",
    "surahname" : "سُورَةُ الصَّفِّ",
    "surahnumber" : "61",
    "surrahname_no_diacratic" : "سورة الصف"
  }, {
    "@id" : "quran:529",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَأۡكُلُوٓاْ أَمۡوَٰلَكُم بَيۡنَكُم بِٱلۡبَٰطِلِ إِلَّآ أَن تَكُونَ تِجَٰرَةً عَن تَرَاضٖ مِّنكُمۡۚ وَلَا تَقۡتُلُوٓاْ أَنفُسَكُمۡۚ إِنَّ ٱللَّهَ كَانَ بِكُمۡ رَحِيمٗا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تاكلوا اموٰلكم بينكم بالبٰطل الا ان تكون تجٰرة عن تراض منكم ولا تقتلوا انفسكم ان الله كان بكم رحيما",
    "ayahnumber" : "29",
    "chapter" : "5",
    "hizb" : "8",
    "index" : "529",
    "page" : "83",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5290",
    "ayah_text" : "وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ ٱلۡكَذِبَ وَهُوَ يُدۡعَىٰٓ إِلَى ٱلۡإِسۡلَٰمِۚ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ومن اظلم ممن افترىٰ على الله الكذب وهو يدعىٰ الى الاسلٰم والله لا يهدي القوم الظٰلمين",
    "ayahnumber" : "7",
    "chapter" : "28",
    "hizb" : "55",
