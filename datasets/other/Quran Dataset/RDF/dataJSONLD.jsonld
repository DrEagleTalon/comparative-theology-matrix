    "hizb" : "26",
    "index" : "1866",
    "page" : "264",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1867",
    "ayah_text" : "قَالَ فَإِنَّكَ مِنَ ٱلۡمُنظَرِينَ",
    "ayah_text_no_diacratic" : "قال فانك من المنظرين",
    "ayahnumber" : "37",
