    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2378",
    "ayah_text" : "وَمَا يَنۢبَغِي لِلرَّحۡمَٰنِ أَن يَتَّخِذَ وَلَدًا",
    "ayah_text_no_diacratic" : "وما ينبغي للرحمٰن ان يتخذ ولدا",
    "ayahnumber" : "92",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2378",
