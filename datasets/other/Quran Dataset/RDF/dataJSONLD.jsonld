    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:493",
    "ayah_text" : "فَٱسۡتَجَابَ لَهُمۡ رَبُّهُمۡ أَنِّي لَآ أُضِيعُ عَمَلَ عَٰمِلٖ مِّنكُم مِّن ذَكَرٍ أَوۡ أُنثَىٰۖ بَعۡضُكُم مِّنۢ بَعۡضٖۖ فَٱلَّذِينَ هَاجَرُواْ وَأُخۡرِجُواْ مِن دِيَٰرِهِمۡ وَأُوذُواْ فِي سَبِيلِي وَقَٰتَلُواْ وَقُتِلُواْ لَأُكَفِّرَنَّ عَنۡهُمۡ سَيِّـَٔاتِهِمۡ وَلَأُدۡخِلَنَّهُمۡ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ ثَوَابٗا مِّنۡ عِندِ ٱللَّهِۚ وَٱللَّهُ عِندَهُۥ حُسۡنُ ٱلثَّوَابِ",
    "ayah_text_no_diacratic" : "فاستجاب لهم ربهم اني لا اضيع عمل عٰمل منكم من ذكر او انثىٰ بعضكم من بعض فالذين هاجروا واخرجوا من ديٰرهم واوذوا في سبيلي وقٰتلوا وقتلوا لاكفرن عنهم سياتهم ولادخلنهم جنٰت تجري من تحتها الانهٰر ثوابا من عند الله والله عنده حسن الثواب",
    "ayahnumber" : "195",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "493",
    "page" : "76",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4930",
    "ayah_text" : "وَأَنَّ إِلَىٰ رَبِّكَ ٱلۡمُنتَهَىٰ",
    "ayah_text_no_diacratic" : "وان الىٰ ربك المنتهىٰ",
