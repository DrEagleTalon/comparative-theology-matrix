    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3593",
    "ayah_text" : "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡفَتۡحُ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ويقولون متىٰ هٰذا الفتح ان كنتم صٰدقين",
    "ayahnumber" : "28",
    "chapter" : "21",
