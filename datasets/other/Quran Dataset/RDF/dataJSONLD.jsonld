  }, {
    "@id" : "quran:2609",
    "ayah_text" : "وَأَدۡخَلۡنَٰهُمۡ فِي رَحۡمَتِنَآۖ إِنَّهُم مِّنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "وادخلنٰهم في رحمتنا انهم من الصٰلحين",
