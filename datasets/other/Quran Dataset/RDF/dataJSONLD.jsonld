    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1203",
    "ayah_text" : "وَٱعۡلَمُوٓاْ أَنَّمَآ أَمۡوَٰلُكُمۡ وَأَوۡلَٰدُكُمۡ فِتۡنَةٞ وَأَنَّ ٱللَّهَ عِندَهُۥٓ أَجۡرٌ عَظِيمٞ",
    "ayah_text_no_diacratic" : "واعلموا انما اموٰلكم واولٰدكم فتنة وان الله عنده اجر عظيم",
