    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3955",
    "ayah_text" : "قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ",
    "ayah_text_no_diacratic" : "قال اتعبدون ما تنحتون",
    "ayahnumber" : "95",
    "chapter" : "23",
