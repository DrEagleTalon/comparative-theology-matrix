    "page" : "245",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1705",
    "ayah_text" : "يَٰبَنِيَّ ٱذۡهَبُواْ فَتَحَسَّسُواْ مِن يُوسُفَ وَأَخِيهِ وَلَا تَاْيۡـَٔسُواْ مِن رَّوۡحِ ٱللَّهِۖ إِنَّهُۥ لَا يَاْيۡـَٔسُ مِن رَّوۡحِ ٱللَّهِ إِلَّا ٱلۡقَوۡمُ ٱلۡكَٰفِرُونَ",
    "ayah_text_no_diacratic" : "يٰبني اذهبوا فتحسسوا من يوسف واخيه ولا تايسوا من روح الله انه لا يايس من روح الله الا القوم الكٰفرون",
    "ayahnumber" : "87",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1705",
    "page" : "246",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1706",
    "ayah_text" : "فَلَمَّا دَخَلُواْ عَلَيۡهِ قَالُواْ يَٰٓأَيُّهَا ٱلۡعَزِيزُ مَسَّنَا وَأَهۡلَنَا ٱلضُّرُّ وَجِئۡنَا بِبِضَٰعَةٖ مُّزۡجَىٰةٖ فَأَوۡفِ لَنَا ٱلۡكَيۡلَ وَتَصَدَّقۡ عَلَيۡنَآۖ إِنَّ ٱللَّهَ يَجۡزِي ٱلۡمُتَصَدِّقِينَ",
    "ayah_text_no_diacratic" : "فلما دخلوا عليه قالوا يٰايها العزيز مسنا واهلنا الضر وجئنا ببضٰعة مزجىٰة فاوف لنا الكيل وتصدق علينا ان الله يجزي المتصدقين",
    "ayahnumber" : "88",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1706",
    "page" : "246",
    "surahname" : "سُورَةُ يُوسُفَ",
    "surahnumber" : "12",
    "surrahname_no_diacratic" : "سورة يوسف"
  }, {
    "@id" : "quran:1707",
    "ayah_text" : "قَالَ هَلۡ عَلِمۡتُم مَّا فَعَلۡتُم بِيُوسُفَ وَأَخِيهِ إِذۡ أَنتُمۡ جَٰهِلُونَ",
    "ayah_text_no_diacratic" : "قال هل علمتم ما فعلتم بيوسف واخيه اذ انتم جٰهلون",
    "ayahnumber" : "89",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1707",
