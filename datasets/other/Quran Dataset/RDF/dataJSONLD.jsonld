    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1066",
    "ayah_text" : "أَفَأَمِنُواْ مَكۡرَ ٱللَّهِۚ فَلَا يَأۡمَنُ مَكۡرَ ٱللَّهِ إِلَّا ٱلۡقَوۡمُ ٱلۡخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "افامنوا مكر الله فلا يامن مكر الله الا القوم الخٰسرون",
    "ayahnumber" : "99",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1066",
