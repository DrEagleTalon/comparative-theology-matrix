  }, {
    "@id" : "quran:2593",
    "ayah_text" : "وَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَخۡسَرِينَ",
    "ayah_text_no_diacratic" : "وارادوا به كيدا فجعلنٰهم الاخسرين",
