  }, {
    "@id" : "quran:5462",
    "ayah_text" : "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ",
    "ayah_text_no_diacratic" : "وما ادرىٰك ما الحاقة",
