    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2635",
    "ayah_text" : "قَٰلَ رَبِّ ٱحۡكُم بِٱلۡحَقِّۗ وَرَبُّنَا ٱلرَّحۡمَٰنُ ٱلۡمُسۡتَعَانُ عَلَىٰ مَا تَصِفُونَ",
    "ayah_text_no_diacratic" : "قٰل رب احكم بالحق وربنا الرحمٰن المستعان علىٰ ما تصفون",
