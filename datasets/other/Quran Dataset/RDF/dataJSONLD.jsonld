    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1871",
    "ayah_text" : "قَالَ هَٰذَا صِرَٰطٌ عَلَيَّ مُسۡتَقِيمٌ",
    "ayah_text_no_diacratic" : "قال هٰذا صرٰط علي مستقيم",
    "ayahnumber" : "41",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1871",
