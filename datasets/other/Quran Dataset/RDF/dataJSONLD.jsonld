    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4914",
    "ayah_text" : "۞وَكَم مِّن مَّلَكٖ فِي ٱلسَّمَٰوَٰتِ لَا تُغۡنِي شَفَٰعَتُهُمۡ شَيۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن يَأۡذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرۡضَىٰٓ",
    "ayah_text_no_diacratic" : "وكم من ملك في السمٰوٰت لا تغني شفٰعتهم شيا الا من بعد ان ياذن الله لمن يشاء ويرضىٰ",
    "ayahnumber" : "26",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4914",
    "page" : "526",
    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4915",
    "ayah_text" : "إِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ لَيُسَمُّونَ ٱلۡمَلَٰٓئِكَةَ تَسۡمِيَةَ ٱلۡأُنثَىٰ",
    "ayah_text_no_diacratic" : "ان الذين لا يؤمنون بالاخرة ليسمون الملٰئكة تسمية الانثىٰ",
    "ayahnumber" : "27",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4915",
    "page" : "527",
    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4916",
    "ayah_text" : "وَمَا لَهُم بِهِۦ مِنۡ عِلۡمٍۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّۖ وَإِنَّ ٱلظَّنَّ لَا يُغۡنِي مِنَ ٱلۡحَقِّ شَيۡـٔٗا",
    "ayah_text_no_diacratic" : "وما لهم به من علم ان يتبعون الا الظن وان الظن لا يغني من الحق شيا",
    "ayahnumber" : "28",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4916",
    "page" : "527",
    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4917",
    "ayah_text" : "فَأَعۡرِضۡ عَن مَّن تَوَلَّىٰ عَن ذِكۡرِنَا وَلَمۡ يُرِدۡ إِلَّا ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
    "ayah_text_no_diacratic" : "فاعرض عن من تولىٰ عن ذكرنا ولم يرد الا الحيوٰة الدنيا",
    "ayahnumber" : "29",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4917",
    "page" : "527",
    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4918",
    "ayah_text" : "ذَٰلِكَ مَبۡلَغُهُم مِّنَ ٱلۡعِلۡمِۚ إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِمَنِ ٱهۡتَدَىٰ",
    "ayah_text_no_diacratic" : "ذٰلك مبلغهم من العلم ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بمن اهتدىٰ",
    "ayahnumber" : "30",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4918",
    "page" : "527",
    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4919",
    "ayah_text" : "وَلِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ لِيَجۡزِيَ ٱلَّذِينَ أَسَٰٓـُٔواْ بِمَا عَمِلُواْ وَيَجۡزِيَ ٱلَّذِينَ أَحۡسَنُواْ بِٱلۡحُسۡنَى",
    "ayah_text_no_diacratic" : "ولله ما في السمٰوٰت وما في الارض ليجزي الذين اسٰوا بما عملوا ويجزي الذين احسنوا بالحسنى",
    "ayahnumber" : "31",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4919",
    "page" : "527",
    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:492",
    "ayah_text" : "رَبَّنَا وَءَاتِنَا مَا وَعَدتَّنَا عَلَىٰ رُسُلِكَ وَلَا تُخۡزِنَا يَوۡمَ ٱلۡقِيَٰمَةِۖ إِنَّكَ لَا تُخۡلِفُ ٱلۡمِيعَادَ",
    "ayah_text_no_diacratic" : "ربنا وءاتنا ما وعدتنا علىٰ رسلك ولا تخزنا يوم القيٰمة انك لا تخلف الميعاد",
    "ayahnumber" : "194",
    "chapter" : "4",
    "hizb" : "7",
