    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4809",
    "ayah_text" : "مُّسَوَّمَةً عِندَ رَبِّكَ لِلۡمُسۡرِفِينَ",
    "ayah_text_no_diacratic" : "مسومة عند ربك للمسرفين",
    "ayahnumber" : "34",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4809",
    "page" : "522",
    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:481",
    "ayah_text" : "ٱلَّذِينَ قَالُوٓاْ إِنَّ ٱللَّهَ عَهِدَ إِلَيۡنَآ أَلَّا نُؤۡمِنَ لِرَسُولٍ حَتَّىٰ يَأۡتِيَنَا بِقُرۡبَانٖ تَأۡكُلُهُ ٱلنَّارُۗ قُلۡ قَدۡ جَآءَكُمۡ رُسُلٞ مِّن قَبۡلِي بِٱلۡبَيِّنَٰتِ وَبِٱلَّذِي قُلۡتُمۡ فَلِمَ قَتَلۡتُمُوهُمۡ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "الذين قالوا ان الله عهد الينا الا نؤمن لرسول حتىٰ ياتينا بقربان تاكله النار قل قد جاءكم رسل من قبلي بالبينٰت وبالذي قلتم فلم قتلتموهم ان كنتم صٰدقين",
    "ayahnumber" : "183",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "481",
    "page" : "74",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4810",
    "ayah_text" : "فَأَخۡرَجۡنَا مَن كَانَ فِيهَا مِنَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "فاخرجنا من كان فيها من المؤمنين",
    "ayahnumber" : "35",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4810",
    "page" : "522",
    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4811",
    "ayah_text" : "فَمَا وَجَدۡنَا فِيهَا غَيۡرَ بَيۡتٖ مِّنَ ٱلۡمُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "فما وجدنا فيها غير بيت من المسلمين",
    "ayahnumber" : "36",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4811",
    "page" : "522",
    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4812",
    "ayah_text" : "وَتَرَكۡنَا فِيهَآ ءَايَةٗ لِّلَّذِينَ يَخَافُونَ ٱلۡعَذَابَ ٱلۡأَلِيمَ",
    "ayah_text_no_diacratic" : "وتركنا فيها ءاية للذين يخافون العذاب الاليم",
    "ayahnumber" : "37",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4812",
    "page" : "522",
    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4813",
    "ayah_text" : "وَفِي مُوسَىٰٓ إِذۡ أَرۡسَلۡنَٰهُ إِلَىٰ فِرۡعَوۡنَ بِسُلۡطَٰنٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "وفي موسىٰ اذ ارسلنٰه الىٰ فرعون بسلطٰن مبين",
    "ayahnumber" : "38",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4813",
    "page" : "522",
    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4814",
    "ayah_text" : "فَتَوَلَّىٰ بِرُكۡنِهِۦ وَقَالَ سَٰحِرٌ أَوۡ مَجۡنُونٞ",
    "ayah_text_no_diacratic" : "فتولىٰ بركنه وقال سٰحر او مجنون",
    "ayahnumber" : "39",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4814",
