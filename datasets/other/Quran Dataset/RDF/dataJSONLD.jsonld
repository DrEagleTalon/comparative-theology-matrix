    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3591",
    "ayah_text" : "أَوَلَمۡ يَهۡدِ لَهُمۡ كَمۡ أَهۡلَكۡنَا مِن قَبۡلِهِم مِّنَ ٱلۡقُرُونِ يَمۡشُونَ فِي مَسَٰكِنِهِمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٍۚ أَفَلَا يَسۡمَعُونَ",
    "ayah_text_no_diacratic" : "اولم يهد لهم كم اهلكنا من قبلهم من القرون يمشون في مسٰكنهم ان في ذٰلك لايٰت افلا يسمعون",
    "ayahnumber" : "26",
    "chapter" : "21",
    "hizb" : "41",
    "index" : "3591",
    "page" : "417",
    "surahname" : "سُورَةُ السَّجۡدَةِ",
    "surahnumber" : "32",
    "surrahname_no_diacratic" : "سورة السجدة"
  }, {
    "@id" : "quran:3592",
    "ayah_text" : "أَوَلَمۡ يَرَوۡاْ أَنَّا نَسُوقُ ٱلۡمَآءَ إِلَى ٱلۡأَرۡضِ ٱلۡجُرُزِ فَنُخۡرِجُ بِهِۦ زَرۡعٗا تَأۡكُلُ مِنۡهُ أَنۡعَٰمُهُمۡ وَأَنفُسُهُمۡۚ أَفَلَا يُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "اولم يروا انا نسوق الماء الى الارض الجرز فنخرج به زرعا تاكل منه انعٰمهم وانفسهم افلا يبصرون",
    "ayahnumber" : "27",
