    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:2996",
    "ayah_text" : "وَلَهُمۡ عَلَيَّ ذَنۢبٞ فَأَخَافُ أَن يَقۡتُلُونِ",
    "ayah_text_no_diacratic" : "ولهم علي ذنب فاخاف ان يقتلون",
