  }, {
    "@id" : "quran:6251",
    "ayah_text" : "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
    "ayah_text_no_diacratic" : "وما يغني عنه ماله اذا تردىٰ",
