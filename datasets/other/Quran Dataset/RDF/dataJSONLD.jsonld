    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1921",
    "ayah_text" : "ٱلَّذِينَ جَعَلُواْ ٱلۡقُرۡءَانَ عِضِينَ",
    "ayah_text_no_diacratic" : "الذين جعلوا القرءان عضين",
