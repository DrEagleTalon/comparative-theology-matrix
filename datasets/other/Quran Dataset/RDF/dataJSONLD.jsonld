    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4944",
    "ayah_text" : "هَٰذَا نَذِيرٞ مِّنَ ٱلنُّذُرِ ٱلۡأُولَىٰٓ",
    "ayah_text_no_diacratic" : "هٰذا نذير من النذر الاولىٰ",
