    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1926",
    "ayah_text" : "ٱلَّذِينَ يَجۡعَلُونَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَۚ فَسَوۡفَ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "الذين يجعلون مع الله الٰها ءاخر فسوف يعلمون",
