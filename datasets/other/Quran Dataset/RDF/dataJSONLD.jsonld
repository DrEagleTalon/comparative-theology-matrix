    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:210",
    "ayah_text" : "فَإِذَا قَضَيۡتُم مَّنَٰسِكَكُمۡ فَٱذۡكُرُواْ ٱللَّهَ كَذِكۡرِكُمۡ ءَابَآءَكُمۡ أَوۡ أَشَدَّ ذِكۡرٗاۗ فَمِنَ ٱلنَّاسِ مَن يَقُولُ رَبَّنَآ ءَاتِنَا فِي ٱلدُّنۡيَا وَمَا لَهُۥ فِي ٱلۡأٓخِرَةِ مِنۡ خَلَٰقٖ",
    "ayah_text_no_diacratic" : "فاذا قضيتم منٰسككم فاذكروا الله كذكركم ءاباءكم او اشد ذكرا فمن الناس من يقول ربنا ءاتنا في الدنيا وما له في الاخرة من خلٰق",
    "ayahnumber" : "200",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "210",
    "page" : "31",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2100",
    "ayah_text" : "ذَٰلِكَ مِمَّآ أَوۡحَىٰٓ إِلَيۡكَ رَبُّكَ مِنَ ٱلۡحِكۡمَةِۗ وَلَا تَجۡعَلۡ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَتُلۡقَىٰ فِي جَهَنَّمَ مَلُومٗا مَّدۡحُورًا",
    "ayah_text_no_diacratic" : "ذٰلك مما اوحىٰ اليك ربك من الحكمة ولا تجعل مع الله الٰها ءاخر فتلقىٰ في جهنم ملوما مدحورا",
    "ayahnumber" : "39",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2100",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2101",
    "ayah_text" : "أَفَأَصۡفَىٰكُمۡ رَبُّكُم بِٱلۡبَنِينَ وَٱتَّخَذَ مِنَ ٱلۡمَلَٰٓئِكَةِ إِنَٰثًاۚ إِنَّكُمۡ لَتَقُولُونَ قَوۡلًا عَظِيمٗا",
    "ayah_text_no_diacratic" : "افاصفىٰكم ربكم بالبنين واتخذ من الملٰئكة انٰثا انكم لتقولون قولا عظيما",
    "ayahnumber" : "40",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2101",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2102",
    "ayah_text" : "وَلَقَدۡ صَرَّفۡنَا فِي هَٰذَا ٱلۡقُرۡءَانِ لِيَذَّكَّرُواْ وَمَا يَزِيدُهُمۡ إِلَّا نُفُورٗا",
    "ayah_text_no_diacratic" : "ولقد صرفنا في هٰذا القرءان ليذكروا وما يزيدهم الا نفورا",
    "ayahnumber" : "41",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2102",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2103",
    "ayah_text" : "قُل لَّوۡ كَانَ مَعَهُۥٓ ءَالِهَةٞ كَمَا يَقُولُونَ إِذٗا لَّٱبۡتَغَوۡاْ إِلَىٰ ذِي ٱلۡعَرۡشِ سَبِيلٗا",
    "ayah_text_no_diacratic" : "قل لو كان معه ءالهة كما يقولون اذا لابتغوا الىٰ ذي العرش سبيلا",
    "ayahnumber" : "42",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2103",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2104",
    "ayah_text" : "سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يَقُولُونَ عُلُوّٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "سبحٰنه وتعٰلىٰ عما يقولون علوا كبيرا",
    "ayahnumber" : "43",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2104",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2105",
    "ayah_text" : "تُسَبِّحُ لَهُ ٱلسَّمَٰوَٰتُ ٱلسَّبۡعُ وَٱلۡأَرۡضُ وَمَن فِيهِنَّۚ وَإِن مِّن شَيۡءٍ إِلَّا يُسَبِّحُ بِحَمۡدِهِۦ وَلَٰكِن لَّا تَفۡقَهُونَ تَسۡبِيحَهُمۡۚ إِنَّهُۥ كَانَ حَلِيمًا غَفُورٗا",
    "ayah_text_no_diacratic" : "تسبح له السمٰوٰت السبع والارض ومن فيهن وان من شيء الا يسبح بحمده ولٰكن لا تفقهون تسبيحهم انه كان حليما غفورا",
    "ayahnumber" : "44",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2105",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2106",
    "ayah_text" : "وَإِذَا قَرَأۡتَ ٱلۡقُرۡءَانَ جَعَلۡنَا بَيۡنَكَ وَبَيۡنَ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ حِجَابٗا مَّسۡتُورٗا",
    "ayah_text_no_diacratic" : "واذا قرات القرءان جعلنا بينك وبين الذين لا يؤمنون بالاخرة حجابا مستورا",
    "ayahnumber" : "45",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2106",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2107",
    "ayah_text" : "وَجَعَلۡنَا عَلَىٰ قُلُوبِهِمۡ أَكِنَّةً أَن يَفۡقَهُوهُ وَفِيٓ ءَاذَانِهِمۡ وَقۡرٗاۚ وَإِذَا ذَكَرۡتَ رَبَّكَ فِي ٱلۡقُرۡءَانِ وَحۡدَهُۥ وَلَّوۡاْ عَلَىٰٓ أَدۡبَٰرِهِمۡ نُفُورٗا",
    "ayah_text_no_diacratic" : "وجعلنا علىٰ قلوبهم اكنة ان يفقهوه وفي ءاذانهم وقرا واذا ذكرت ربك في القرءان وحده ولوا علىٰ ادبٰرهم نفورا",
    "ayahnumber" : "46",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2107",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2108",
    "ayah_text" : "نَّحۡنُ أَعۡلَمُ بِمَا يَسۡتَمِعُونَ بِهِۦٓ إِذۡ يَسۡتَمِعُونَ إِلَيۡكَ وَإِذۡ هُمۡ نَجۡوَىٰٓ إِذۡ يَقُولُ ٱلظَّٰلِمُونَ إِن تَتَّبِعُونَ إِلَّا رَجُلٗا مَّسۡحُورًا",
    "ayah_text_no_diacratic" : "نحن اعلم بما يستمعون به اذ يستمعون اليك واذ هم نجوىٰ اذ يقول الظٰلمون ان تتبعون الا رجلا مسحورا",
    "ayahnumber" : "47",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2108",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2109",
    "ayah_text" : "ٱنظُرۡ كَيۡفَ ضَرَبُواْ لَكَ ٱلۡأَمۡثَالَ فَضَلُّواْ فَلَا يَسۡتَطِيعُونَ سَبِيلٗا",
    "ayah_text_no_diacratic" : "انظر كيف ضربوا لك الامثال فضلوا فلا يستطيعون سبيلا",
    "ayahnumber" : "48",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2109",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:211",
    "ayah_text" : "وَمِنۡهُم مَّن يَقُولُ رَبَّنَآ ءَاتِنَا فِي ٱلدُّنۡيَا حَسَنَةٗ وَفِي ٱلۡأٓخِرَةِ حَسَنَةٗ وَقِنَا عَذَابَ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "ومنهم من يقول ربنا ءاتنا في الدنيا حسنة وفي الاخرة حسنة وقنا عذاب النار",
    "ayahnumber" : "201",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "211",
    "page" : "31",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2110",
    "ayah_text" : "وَقَالُوٓاْ أَءِذَا كُنَّا عِظَٰمٗا وَرُفَٰتًا أَءِنَّا لَمَبۡعُوثُونَ خَلۡقٗا جَدِيدٗا",
    "ayah_text_no_diacratic" : "وقالوا اءذا كنا عظٰما ورفٰتا اءنا لمبعوثون خلقا جديدا",
    "ayahnumber" : "49",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2110",
    "page" : "286",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2111",
    "ayah_text" : "۞قُلۡ كُونُواْ حِجَارَةً أَوۡ حَدِيدًا",
    "ayah_text_no_diacratic" : "قل كونوا حجارة او حديدا",
    "ayahnumber" : "50",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2111",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2112",
    "ayah_text" : "أَوۡ خَلۡقٗا مِّمَّا يَكۡبُرُ فِي صُدُورِكُمۡۚ فَسَيَقُولُونَ مَن يُعِيدُنَاۖ قُلِ ٱلَّذِي فَطَرَكُمۡ أَوَّلَ مَرَّةٖۚ فَسَيُنۡغِضُونَ إِلَيۡكَ رُءُوسَهُمۡ وَيَقُولُونَ مَتَىٰ هُوَۖ قُلۡ عَسَىٰٓ أَن يَكُونَ قَرِيبٗا",
    "ayah_text_no_diacratic" : "او خلقا مما يكبر في صدوركم فسيقولون من يعيدنا قل الذي فطركم اول مرة فسينغضون اليك رءوسهم ويقولون متىٰ هو قل عسىٰ ان يكون قريبا",
    "ayahnumber" : "51",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2112",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2113",
    "ayah_text" : "يَوۡمَ يَدۡعُوكُمۡ فَتَسۡتَجِيبُونَ بِحَمۡدِهِۦ وَتَظُنُّونَ إِن لَّبِثۡتُمۡ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "يوم يدعوكم فتستجيبون بحمده وتظنون ان لبثتم الا قليلا",
    "ayahnumber" : "52",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2113",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2114",
    "ayah_text" : "وَقُل لِّعِبَادِي يَقُولُواْ ٱلَّتِي هِيَ أَحۡسَنُۚ إِنَّ ٱلشَّيۡطَٰنَ يَنزَغُ بَيۡنَهُمۡۚ إِنَّ ٱلشَّيۡطَٰنَ كَانَ لِلۡإِنسَٰنِ عَدُوّٗا مُّبِينٗا",
    "ayah_text_no_diacratic" : "وقل لعبادي يقولوا التي هي احسن ان الشيطٰن ينزغ بينهم ان الشيطٰن كان للانسٰن عدوا مبينا",
    "ayahnumber" : "53",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2114",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2115",
    "ayah_text" : "رَّبُّكُمۡ أَعۡلَمُ بِكُمۡۖ إِن يَشَأۡ يَرۡحَمۡكُمۡ أَوۡ إِن يَشَأۡ يُعَذِّبۡكُمۡۚ وَمَآ أَرۡسَلۡنَٰكَ عَلَيۡهِمۡ وَكِيلٗا",
    "ayah_text_no_diacratic" : "ربكم اعلم بكم ان يشا يرحمكم او ان يشا يعذبكم وما ارسلنٰك عليهم وكيلا",
    "ayahnumber" : "54",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2115",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2116",
    "ayah_text" : "وَرَبُّكَ أَعۡلَمُ بِمَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ وَلَقَدۡ فَضَّلۡنَا بَعۡضَ ٱلنَّبِيِّـۧنَ عَلَىٰ بَعۡضٖۖ وَءَاتَيۡنَا دَاوُۥدَ زَبُورٗا",
    "ayah_text_no_diacratic" : "وربك اعلم بمن في السمٰوٰت والارض ولقد فضلنا بعض النبين علىٰ بعض وءاتينا داود زبورا",
    "ayahnumber" : "55",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2116",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2117",
    "ayah_text" : "قُلِ ٱدۡعُواْ ٱلَّذِينَ زَعَمۡتُم مِّن دُونِهِۦ فَلَا يَمۡلِكُونَ كَشۡفَ ٱلضُّرِّ عَنكُمۡ وَلَا تَحۡوِيلًا",
    "ayah_text_no_diacratic" : "قل ادعوا الذين زعمتم من دونه فلا يملكون كشف الضر عنكم ولا تحويلا",
    "ayahnumber" : "56",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2117",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2118",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ يَدۡعُونَ يَبۡتَغُونَ إِلَىٰ رَبِّهِمُ ٱلۡوَسِيلَةَ أَيُّهُمۡ أَقۡرَبُ وَيَرۡجُونَ رَحۡمَتَهُۥ وَيَخَافُونَ عَذَابَهُۥٓۚ إِنَّ عَذَابَ رَبِّكَ كَانَ مَحۡذُورٗا",
    "ayah_text_no_diacratic" : "اولٰئك الذين يدعون يبتغون الىٰ ربهم الوسيلة ايهم اقرب ويرجون رحمته ويخافون عذابه ان عذاب ربك كان محذورا",
    "ayahnumber" : "57",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2118",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2119",
    "ayah_text" : "وَإِن مِّن قَرۡيَةٍ إِلَّا نَحۡنُ مُهۡلِكُوهَا قَبۡلَ يَوۡمِ ٱلۡقِيَٰمَةِ أَوۡ مُعَذِّبُوهَا عَذَابٗا شَدِيدٗاۚ كَانَ ذَٰلِكَ فِي ٱلۡكِتَٰبِ مَسۡطُورٗا",
    "ayah_text_no_diacratic" : "وان من قرية الا نحن مهلكوها قبل يوم القيٰمة او معذبوها عذابا شديدا كان ذٰلك في الكتٰب مسطورا",
    "ayahnumber" : "58",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2119",
    "page" : "287",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:212",
    "ayah_text" : "أُوْلَٰٓئِكَ لَهُمۡ نَصِيبٞ مِّمَّا كَسَبُواْۚ وَٱللَّهُ سَرِيعُ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "اولٰئك لهم نصيب مما كسبوا والله سريع الحساب",
    "ayahnumber" : "202",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "212",
    "page" : "31",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2120",
    "ayah_text" : "وَمَا مَنَعَنَآ أَن نُّرۡسِلَ بِٱلۡأٓيَٰتِ إِلَّآ أَن كَذَّبَ بِهَا ٱلۡأَوَّلُونَۚ وَءَاتَيۡنَا ثَمُودَ ٱلنَّاقَةَ مُبۡصِرَةٗ فَظَلَمُواْ بِهَاۚ وَمَا نُرۡسِلُ بِٱلۡأٓيَٰتِ إِلَّا تَخۡوِيفٗا",
    "ayah_text_no_diacratic" : "وما منعنا ان نرسل بالايٰت الا ان كذب بها الاولون وءاتينا ثمود الناقة مبصرة فظلموا بها وما نرسل بالايٰت الا تخويفا",
    "ayahnumber" : "59",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2120",
    "page" : "288",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2121",
    "ayah_text" : "وَإِذۡ قُلۡنَا لَكَ إِنَّ رَبَّكَ أَحَاطَ بِٱلنَّاسِۚ وَمَا جَعَلۡنَا ٱلرُّءۡيَا ٱلَّتِيٓ أَرَيۡنَٰكَ إِلَّا فِتۡنَةٗ لِّلنَّاسِ وَٱلشَّجَرَةَ ٱلۡمَلۡعُونَةَ فِي ٱلۡقُرۡءَانِۚ وَنُخَوِّفُهُمۡ فَمَا يَزِيدُهُمۡ إِلَّا طُغۡيَٰنٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "واذ قلنا لك ان ربك احاط بالناس وما جعلنا الرءيا التي ارينٰك الا فتنة للناس والشجرة الملعونة في القرءان ونخوفهم فما يزيدهم الا طغيٰنا كبيرا",
    "ayahnumber" : "60",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2121",
    "page" : "288",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2122",
    "ayah_text" : "وَإِذۡ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ قَالَ ءَأَسۡجُدُ لِمَنۡ خَلَقۡتَ طِينٗا",
    "ayah_text_no_diacratic" : "واذ قلنا للملٰئكة اسجدوا لادم فسجدوا الا ابليس قال ءاسجد لمن خلقت طينا",
    "ayahnumber" : "61",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2122",
    "page" : "288",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2123",
    "ayah_text" : "قَالَ أَرَءَيۡتَكَ هَٰذَا ٱلَّذِي كَرَّمۡتَ عَلَيَّ لَئِنۡ أَخَّرۡتَنِ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ لَأَحۡتَنِكَنَّ ذُرِّيَّتَهُۥٓ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "قال ارءيتك هٰذا الذي كرمت علي لئن اخرتن الىٰ يوم القيٰمة لاحتنكن ذريته الا قليلا",
    "ayahnumber" : "62",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2123",
    "page" : "288",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2124",
    "ayah_text" : "قَالَ ٱذۡهَبۡ فَمَن تَبِعَكَ مِنۡهُمۡ فَإِنَّ جَهَنَّمَ جَزَآؤُكُمۡ جَزَآءٗ مَّوۡفُورٗا",
    "ayah_text_no_diacratic" : "قال اذهب فمن تبعك منهم فان جهنم جزاؤكم جزاء موفورا",
    "ayahnumber" : "63",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2124",
    "page" : "288",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2125",
    "ayah_text" : "وَٱسۡتَفۡزِزۡ مَنِ ٱسۡتَطَعۡتَ مِنۡهُم بِصَوۡتِكَ وَأَجۡلِبۡ عَلَيۡهِم بِخَيۡلِكَ وَرَجِلِكَ وَشَارِكۡهُمۡ فِي ٱلۡأَمۡوَٰلِ وَٱلۡأَوۡلَٰدِ وَعِدۡهُمۡۚ وَمَا يَعِدُهُمُ ٱلشَّيۡطَٰنُ إِلَّا غُرُورًا",
    "ayah_text_no_diacratic" : "واستفزز من استطعت منهم بصوتك واجلب عليهم بخيلك ورجلك وشاركهم في الاموٰل والاولٰد وعدهم وما يعدهم الشيطٰن الا غرورا",
    "ayahnumber" : "64",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2125",
    "page" : "288",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2126",
    "ayah_text" : "إِنَّ عِبَادِي لَيۡسَ لَكَ عَلَيۡهِمۡ سُلۡطَٰنٞۚ وَكَفَىٰ بِرَبِّكَ وَكِيلٗا",
    "ayah_text_no_diacratic" : "ان عبادي ليس لك عليهم سلطٰن وكفىٰ بربك وكيلا",
    "ayahnumber" : "65",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2126",
    "page" : "288",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2127",
    "ayah_text" : "رَّبُّكُمُ ٱلَّذِي يُزۡجِي لَكُمُ ٱلۡفُلۡكَ فِي ٱلۡبَحۡرِ لِتَبۡتَغُواْ مِن فَضۡلِهِۦٓۚ إِنَّهُۥ كَانَ بِكُمۡ رَحِيمٗا",
    "ayah_text_no_diacratic" : "ربكم الذي يزجي لكم الفلك في البحر لتبتغوا من فضله انه كان بكم رحيما",
    "ayahnumber" : "66",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2127",
    "page" : "288",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2128",
    "ayah_text" : "وَإِذَا مَسَّكُمُ ٱلضُّرُّ فِي ٱلۡبَحۡرِ ضَلَّ مَن تَدۡعُونَ إِلَّآ إِيَّاهُۖ فَلَمَّا نَجَّىٰكُمۡ إِلَى ٱلۡبَرِّ أَعۡرَضۡتُمۡۚ وَكَانَ ٱلۡإِنسَٰنُ كَفُورًا",
    "ayah_text_no_diacratic" : "واذا مسكم الضر في البحر ضل من تدعون الا اياه فلما نجىٰكم الى البر اعرضتم وكان الانسٰن كفورا",
    "ayahnumber" : "67",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2128",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2129",
    "ayah_text" : "أَفَأَمِنتُمۡ أَن يَخۡسِفَ بِكُمۡ جَانِبَ ٱلۡبَرِّ أَوۡ يُرۡسِلَ عَلَيۡكُمۡ حَاصِبٗا ثُمَّ لَا تَجِدُواْ لَكُمۡ وَكِيلًا",
    "ayah_text_no_diacratic" : "افامنتم ان يخسف بكم جانب البر او يرسل عليكم حاصبا ثم لا تجدوا لكم وكيلا",
    "ayahnumber" : "68",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2129",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:213",
    "ayah_text" : "۞وَٱذۡكُرُواْ ٱللَّهَ فِيٓ أَيَّامٖ مَّعۡدُودَٰتٖۚ فَمَن تَعَجَّلَ فِي يَوۡمَيۡنِ فَلَآ إِثۡمَ عَلَيۡهِ وَمَن تَأَخَّرَ فَلَآ إِثۡمَ عَلَيۡهِۖ لِمَنِ ٱتَّقَىٰۗ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّكُمۡ إِلَيۡهِ تُحۡشَرُونَ",
    "ayah_text_no_diacratic" : "واذكروا الله في ايام معدودٰت فمن تعجل في يومين فلا اثم عليه ومن تاخر فلا اثم عليه لمن اتقىٰ واتقوا الله واعلموا انكم اليه تحشرون",
    "ayahnumber" : "203",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "213",
    "page" : "32",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2130",
    "ayah_text" : "أَمۡ أَمِنتُمۡ أَن يُعِيدَكُمۡ فِيهِ تَارَةً أُخۡرَىٰ فَيُرۡسِلَ عَلَيۡكُمۡ قَاصِفٗا مِّنَ ٱلرِّيحِ فَيُغۡرِقَكُم بِمَا كَفَرۡتُمۡ ثُمَّ لَا تَجِدُواْ لَكُمۡ عَلَيۡنَا بِهِۦ تَبِيعٗا",
    "ayah_text_no_diacratic" : "ام امنتم ان يعيدكم فيه تارة اخرىٰ فيرسل عليكم قاصفا من الريح فيغرقكم بما كفرتم ثم لا تجدوا لكم علينا به تبيعا",
    "ayahnumber" : "69",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2130",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2131",
    "ayah_text" : "۞وَلَقَدۡ كَرَّمۡنَا بَنِيٓ ءَادَمَ وَحَمَلۡنَٰهُمۡ فِي ٱلۡبَرِّ وَٱلۡبَحۡرِ وَرَزَقۡنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ وَفَضَّلۡنَٰهُمۡ عَلَىٰ كَثِيرٖ مِّمَّنۡ خَلَقۡنَا تَفۡضِيلٗا",
    "ayah_text_no_diacratic" : "ولقد كرمنا بني ءادم وحملنٰهم في البر والبحر ورزقنٰهم من الطيبٰت وفضلنٰهم علىٰ كثير ممن خلقنا تفضيلا",
    "ayahnumber" : "70",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2131",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2132",
    "ayah_text" : "يَوۡمَ نَدۡعُواْ كُلَّ أُنَاسِۭ بِإِمَٰمِهِمۡۖ فَمَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَأُوْلَٰٓئِكَ يَقۡرَءُونَ كِتَٰبَهُمۡ وَلَا يُظۡلَمُونَ فَتِيلٗا",
    "ayah_text_no_diacratic" : "يوم ندعوا كل اناس بامٰمهم فمن اوتي كتٰبه بيمينه فاولٰئك يقرءون كتٰبهم ولا يظلمون فتيلا",
    "ayahnumber" : "71",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2132",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2133",
    "ayah_text" : "وَمَن كَانَ فِي هَٰذِهِۦٓ أَعۡمَىٰ فَهُوَ فِي ٱلۡأٓخِرَةِ أَعۡمَىٰ وَأَضَلُّ سَبِيلٗا",
    "ayah_text_no_diacratic" : "ومن كان في هٰذه اعمىٰ فهو في الاخرة اعمىٰ واضل سبيلا",
    "ayahnumber" : "72",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2133",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2134",
    "ayah_text" : "وَإِن كَادُواْ لَيَفۡتِنُونَكَ عَنِ ٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ لِتَفۡتَرِيَ عَلَيۡنَا غَيۡرَهُۥۖ وَإِذٗا لَّٱتَّخَذُوكَ خَلِيلٗا",
    "ayah_text_no_diacratic" : "وان كادوا ليفتنونك عن الذي اوحينا اليك لتفتري علينا غيره واذا لاتخذوك خليلا",
    "ayahnumber" : "73",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2134",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2135",
    "ayah_text" : "وَلَوۡلَآ أَن ثَبَّتۡنَٰكَ لَقَدۡ كِدتَّ تَرۡكَنُ إِلَيۡهِمۡ شَيۡـٔٗا قَلِيلًا",
    "ayah_text_no_diacratic" : "ولولا ان ثبتنٰك لقد كدت تركن اليهم شيا قليلا",
    "ayahnumber" : "74",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2135",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2136",
    "ayah_text" : "إِذٗا لَّأَذَقۡنَٰكَ ضِعۡفَ ٱلۡحَيَوٰةِ وَضِعۡفَ ٱلۡمَمَاتِ ثُمَّ لَا تَجِدُ لَكَ عَلَيۡنَا نَصِيرٗا",
    "ayah_text_no_diacratic" : "اذا لاذقنٰك ضعف الحيوٰة وضعف الممات ثم لا تجد لك علينا نصيرا",
    "ayahnumber" : "75",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2136",
    "page" : "289",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2137",
    "ayah_text" : "وَإِن كَادُواْ لَيَسۡتَفِزُّونَكَ مِنَ ٱلۡأَرۡضِ لِيُخۡرِجُوكَ مِنۡهَاۖ وَإِذٗا لَّا يَلۡبَثُونَ خِلَٰفَكَ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "وان كادوا ليستفزونك من الارض ليخرجوك منها واذا لا يلبثون خلٰفك الا قليلا",
    "ayahnumber" : "76",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2137",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2138",
    "ayah_text" : "سُنَّةَ مَن قَدۡ أَرۡسَلۡنَا قَبۡلَكَ مِن رُّسُلِنَاۖ وَلَا تَجِدُ لِسُنَّتِنَا تَحۡوِيلًا",
    "ayah_text_no_diacratic" : "سنة من قد ارسلنا قبلك من رسلنا ولا تجد لسنتنا تحويلا",
    "ayahnumber" : "77",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2138",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2139",
    "ayah_text" : "أَقِمِ ٱلصَّلَوٰةَ لِدُلُوكِ ٱلشَّمۡسِ إِلَىٰ غَسَقِ ٱلَّيۡلِ وَقُرۡءَانَ ٱلۡفَجۡرِۖ إِنَّ قُرۡءَانَ ٱلۡفَجۡرِ كَانَ مَشۡهُودٗا",
    "ayah_text_no_diacratic" : "اقم الصلوٰة لدلوك الشمس الىٰ غسق اليل وقرءان الفجر ان قرءان الفجر كان مشهودا",
    "ayahnumber" : "78",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2139",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:214",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يُعۡجِبُكَ قَوۡلُهُۥ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَيُشۡهِدُ ٱللَّهَ عَلَىٰ مَا فِي قَلۡبِهِۦ وَهُوَ أَلَدُّ ٱلۡخِصَامِ",
    "ayah_text_no_diacratic" : "ومن الناس من يعجبك قوله في الحيوٰة الدنيا ويشهد الله علىٰ ما في قلبه وهو الد الخصام",
    "ayahnumber" : "204",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "214",
    "page" : "32",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2140",
    "ayah_text" : "وَمِنَ ٱلَّيۡلِ فَتَهَجَّدۡ بِهِۦ نَافِلَةٗ لَّكَ عَسَىٰٓ أَن يَبۡعَثَكَ رَبُّكَ مَقَامٗا مَّحۡمُودٗا",
    "ayah_text_no_diacratic" : "ومن اليل فتهجد به نافلة لك عسىٰ ان يبعثك ربك مقاما محمودا",
    "ayahnumber" : "79",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2140",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2141",
    "ayah_text" : "وَقُل رَّبِّ أَدۡخِلۡنِي مُدۡخَلَ صِدۡقٖ وَأَخۡرِجۡنِي مُخۡرَجَ صِدۡقٖ وَٱجۡعَل لِّي مِن لَّدُنكَ سُلۡطَٰنٗا نَّصِيرٗا",
    "ayah_text_no_diacratic" : "وقل رب ادخلني مدخل صدق واخرجني مخرج صدق واجعل لي من لدنك سلطٰنا نصيرا",
    "ayahnumber" : "80",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2141",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2142",
    "ayah_text" : "وَقُلۡ جَآءَ ٱلۡحَقُّ وَزَهَقَ ٱلۡبَٰطِلُۚ إِنَّ ٱلۡبَٰطِلَ كَانَ زَهُوقٗا",
    "ayah_text_no_diacratic" : "وقل جاء الحق وزهق البٰطل ان البٰطل كان زهوقا",
    "ayahnumber" : "81",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2142",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2143",
    "ayah_text" : "وَنُنَزِّلُ مِنَ ٱلۡقُرۡءَانِ مَا هُوَ شِفَآءٞ وَرَحۡمَةٞ لِّلۡمُؤۡمِنِينَ وَلَا يَزِيدُ ٱلظَّٰلِمِينَ إِلَّا خَسَارٗا",
    "ayah_text_no_diacratic" : "وننزل من القرءان ما هو شفاء ورحمة للمؤمنين ولا يزيد الظٰلمين الا خسارا",
    "ayahnumber" : "82",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2143",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2144",
    "ayah_text" : "وَإِذَآ أَنۡعَمۡنَا عَلَى ٱلۡإِنسَٰنِ أَعۡرَضَ وَنَـَٔا بِجَانِبِهِۦ وَإِذَا مَسَّهُ ٱلشَّرُّ كَانَ يَـُٔوسٗا",
    "ayah_text_no_diacratic" : "واذا انعمنا على الانسٰن اعرض ونا بجانبه واذا مسه الشر كان يوسا",
    "ayahnumber" : "83",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2144",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2145",
    "ayah_text" : "قُلۡ كُلّٞ يَعۡمَلُ عَلَىٰ شَاكِلَتِهِۦ فَرَبُّكُمۡ أَعۡلَمُ بِمَنۡ هُوَ أَهۡدَىٰ سَبِيلٗا",
    "ayah_text_no_diacratic" : "قل كل يعمل علىٰ شاكلته فربكم اعلم بمن هو اهدىٰ سبيلا",
    "ayahnumber" : "84",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2145",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2146",
    "ayah_text" : "وَيَسۡـَٔلُونَكَ عَنِ ٱلرُّوحِۖ قُلِ ٱلرُّوحُ مِنۡ أَمۡرِ رَبِّي وَمَآ أُوتِيتُم مِّنَ ٱلۡعِلۡمِ إِلَّا قَلِيلٗا",
    "ayah_text_no_diacratic" : "ويسلونك عن الروح قل الروح من امر ربي وما اوتيتم من العلم الا قليلا",
    "ayahnumber" : "85",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2146",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2147",
    "ayah_text" : "وَلَئِن شِئۡنَا لَنَذۡهَبَنَّ بِٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ ثُمَّ لَا تَجِدُ لَكَ بِهِۦ عَلَيۡنَا وَكِيلًا",
    "ayah_text_no_diacratic" : "ولئن شئنا لنذهبن بالذي اوحينا اليك ثم لا تجد لك به علينا وكيلا",
    "ayahnumber" : "86",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2147",
    "page" : "290",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2148",
    "ayah_text" : "إِلَّا رَحۡمَةٗ مِّن رَّبِّكَۚ إِنَّ فَضۡلَهُۥ كَانَ عَلَيۡكَ كَبِيرٗا",
    "ayah_text_no_diacratic" : "الا رحمة من ربك ان فضله كان عليك كبيرا",
    "ayahnumber" : "87",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2148",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2149",
    "ayah_text" : "قُل لَّئِنِ ٱجۡتَمَعَتِ ٱلۡإِنسُ وَٱلۡجِنُّ عَلَىٰٓ أَن يَأۡتُواْ بِمِثۡلِ هَٰذَا ٱلۡقُرۡءَانِ لَا يَأۡتُونَ بِمِثۡلِهِۦ وَلَوۡ كَانَ بَعۡضُهُمۡ لِبَعۡضٖ ظَهِيرٗا",
    "ayah_text_no_diacratic" : "قل لئن اجتمعت الانس والجن علىٰ ان ياتوا بمثل هٰذا القرءان لا ياتون بمثله ولو كان بعضهم لبعض ظهيرا",
    "ayahnumber" : "88",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2149",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:215",
    "ayah_text" : "وَإِذَا تَوَلَّىٰ سَعَىٰ فِي ٱلۡأَرۡضِ لِيُفۡسِدَ فِيهَا وَيُهۡلِكَ ٱلۡحَرۡثَ وَٱلنَّسۡلَۚ وَٱللَّهُ لَا يُحِبُّ ٱلۡفَسَادَ",
    "ayah_text_no_diacratic" : "واذا تولىٰ سعىٰ في الارض ليفسد فيها ويهلك الحرث والنسل والله لا يحب الفساد",
    "ayahnumber" : "205",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "215",
    "page" : "32",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2150",
    "ayah_text" : "وَلَقَدۡ صَرَّفۡنَا لِلنَّاسِ فِي هَٰذَا ٱلۡقُرۡءَانِ مِن كُلِّ مَثَلٖ فَأَبَىٰٓ أَكۡثَرُ ٱلنَّاسِ إِلَّا كُفُورٗا",
    "ayah_text_no_diacratic" : "ولقد صرفنا للناس في هٰذا القرءان من كل مثل فابىٰ اكثر الناس الا كفورا",
    "ayahnumber" : "89",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2150",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2151",
    "ayah_text" : "وَقَالُواْ لَن نُّؤۡمِنَ لَكَ حَتَّىٰ تَفۡجُرَ لَنَا مِنَ ٱلۡأَرۡضِ يَنۢبُوعًا",
    "ayah_text_no_diacratic" : "وقالوا لن نؤمن لك حتىٰ تفجر لنا من الارض ينبوعا",
    "ayahnumber" : "90",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2151",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2152",
    "ayah_text" : "أَوۡ تَكُونَ لَكَ جَنَّةٞ مِّن نَّخِيلٖ وَعِنَبٖ فَتُفَجِّرَ ٱلۡأَنۡهَٰرَ خِلَٰلَهَا تَفۡجِيرًا",
    "ayah_text_no_diacratic" : "او تكون لك جنة من نخيل وعنب فتفجر الانهٰر خلٰلها تفجيرا",
    "ayahnumber" : "91",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2152",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2153",
    "ayah_text" : "أَوۡ تُسۡقِطَ ٱلسَّمَآءَ كَمَا زَعَمۡتَ عَلَيۡنَا كِسَفًا أَوۡ تَأۡتِيَ بِٱللَّهِ وَٱلۡمَلَٰٓئِكَةِ قَبِيلًا",
    "ayah_text_no_diacratic" : "او تسقط السماء كما زعمت علينا كسفا او تاتي بالله والملٰئكة قبيلا",
    "ayahnumber" : "92",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2153",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2154",
    "ayah_text" : "أَوۡ يَكُونَ لَكَ بَيۡتٞ مِّن زُخۡرُفٍ أَوۡ تَرۡقَىٰ فِي ٱلسَّمَآءِ وَلَن نُّؤۡمِنَ لِرُقِيِّكَ حَتَّىٰ تُنَزِّلَ عَلَيۡنَا كِتَٰبٗا نَّقۡرَؤُهُۥۗ قُلۡ سُبۡحَانَ رَبِّي هَلۡ كُنتُ إِلَّا بَشَرٗا رَّسُولٗا",
    "ayah_text_no_diacratic" : "او يكون لك بيت من زخرف او ترقىٰ في السماء ولن نؤمن لرقيك حتىٰ تنزل علينا كتٰبا نقرؤه قل سبحان ربي هل كنت الا بشرا رسولا",
    "ayahnumber" : "93",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2154",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2155",
    "ayah_text" : "وَمَا مَنَعَ ٱلنَّاسَ أَن يُؤۡمِنُوٓاْ إِذۡ جَآءَهُمُ ٱلۡهُدَىٰٓ إِلَّآ أَن قَالُوٓاْ أَبَعَثَ ٱللَّهُ بَشَرٗا رَّسُولٗا",
    "ayah_text_no_diacratic" : "وما منع الناس ان يؤمنوا اذ جاءهم الهدىٰ الا ان قالوا ابعث الله بشرا رسولا",
    "ayahnumber" : "94",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2155",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2156",
    "ayah_text" : "قُل لَّوۡ كَانَ فِي ٱلۡأَرۡضِ مَلَٰٓئِكَةٞ يَمۡشُونَ مُطۡمَئِنِّينَ لَنَزَّلۡنَا عَلَيۡهِم مِّنَ ٱلسَّمَآءِ مَلَكٗا رَّسُولٗا",
    "ayah_text_no_diacratic" : "قل لو كان في الارض ملٰئكة يمشون مطمئنين لنزلنا عليهم من السماء ملكا رسولا",
    "ayahnumber" : "95",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2156",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2157",
    "ayah_text" : "قُلۡ كَفَىٰ بِٱللَّهِ شَهِيدَۢا بَيۡنِي وَبَيۡنَكُمۡۚ إِنَّهُۥ كَانَ بِعِبَادِهِۦ خَبِيرَۢا بَصِيرٗا",
    "ayah_text_no_diacratic" : "قل كفىٰ بالله شهيدا بيني وبينكم انه كان بعباده خبيرا بصيرا",
    "ayahnumber" : "96",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2157",
    "page" : "291",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2158",
    "ayah_text" : "وَمَن يَهۡدِ ٱللَّهُ فَهُوَ ٱلۡمُهۡتَدِۖ وَمَن يُضۡلِلۡ فَلَن تَجِدَ لَهُمۡ أَوۡلِيَآءَ مِن دُونِهِۦۖ وَنَحۡشُرُهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ عَلَىٰ وُجُوهِهِمۡ عُمۡيٗا وَبُكۡمٗا وَصُمّٗاۖ مَّأۡوَىٰهُمۡ جَهَنَّمُۖ كُلَّمَا خَبَتۡ زِدۡنَٰهُمۡ سَعِيرٗا",
    "ayah_text_no_diacratic" : "ومن يهد الله فهو المهتد ومن يضلل فلن تجد لهم اولياء من دونه ونحشرهم يوم القيٰمة علىٰ وجوههم عميا وبكما وصما ماوىٰهم جهنم كلما خبت زدنٰهم سعيرا",
    "ayahnumber" : "97",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2158",
    "page" : "292",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2159",
    "ayah_text" : "ذَٰلِكَ جَزَآؤُهُم بِأَنَّهُمۡ كَفَرُواْ بِـَٔايَٰتِنَا وَقَالُوٓاْ أَءِذَا كُنَّا عِظَٰمٗا وَرُفَٰتًا أَءِنَّا لَمَبۡعُوثُونَ خَلۡقٗا جَدِيدًا",
    "ayah_text_no_diacratic" : "ذٰلك جزاؤهم بانهم كفروا بايٰتنا وقالوا اءذا كنا عظٰما ورفٰتا اءنا لمبعوثون خلقا جديدا",
    "ayahnumber" : "98",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2159",
    "page" : "292",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:216",
    "ayah_text" : "وَإِذَا قِيلَ لَهُ ٱتَّقِ ٱللَّهَ أَخَذَتۡهُ ٱلۡعِزَّةُ بِٱلۡإِثۡمِۚ فَحَسۡبُهُۥ جَهَنَّمُۖ وَلَبِئۡسَ ٱلۡمِهَادُ",
    "ayah_text_no_diacratic" : "واذا قيل له اتق الله اخذته العزة بالاثم فحسبه جهنم ولبئس المهاد",
    "ayahnumber" : "206",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "216",
    "page" : "32",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2160",
    "ayah_text" : "۞أَوَلَمۡ يَرَوۡاْ أَنَّ ٱللَّهَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ قَادِرٌ عَلَىٰٓ أَن يَخۡلُقَ مِثۡلَهُمۡ وَجَعَلَ لَهُمۡ أَجَلٗا لَّا رَيۡبَ فِيهِ فَأَبَى ٱلظَّٰلِمُونَ إِلَّا كُفُورٗا",
    "ayah_text_no_diacratic" : "اولم يروا ان الله الذي خلق السمٰوٰت والارض قادر علىٰ ان يخلق مثلهم وجعل لهم اجلا لا ريب فيه فابى الظٰلمون الا كفورا",
    "ayahnumber" : "99",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2160",
    "page" : "292",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2161",
    "ayah_text" : "قُل لَّوۡ أَنتُمۡ تَمۡلِكُونَ خَزَآئِنَ رَحۡمَةِ رَبِّيٓ إِذٗا لَّأَمۡسَكۡتُمۡ خَشۡيَةَ ٱلۡإِنفَاقِۚ وَكَانَ ٱلۡإِنسَٰنُ قَتُورٗا",
    "ayah_text_no_diacratic" : "قل لو انتم تملكون خزائن رحمة ربي اذا لامسكتم خشية الانفاق وكان الانسٰن قتورا",
    "ayahnumber" : "100",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2161",
    "page" : "292",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2162",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَىٰ تِسۡعَ ءَايَٰتِۭ بَيِّنَٰتٖۖ فَسۡـَٔلۡ بَنِيٓ إِسۡرَٰٓءِيلَ إِذۡ جَآءَهُمۡ فَقَالَ لَهُۥ فِرۡعَوۡنُ إِنِّي لَأَظُنُّكَ يَٰمُوسَىٰ مَسۡحُورٗا",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسىٰ تسع ءايٰت بينٰت فسل بني اسرٰءيل اذ جاءهم فقال له فرعون اني لاظنك يٰموسىٰ مسحورا",
    "ayahnumber" : "101",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2162",
    "page" : "292",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2163",
    "ayah_text" : "قَالَ لَقَدۡ عَلِمۡتَ مَآ أَنزَلَ هَٰٓؤُلَآءِ إِلَّا رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ بَصَآئِرَ وَإِنِّي لَأَظُنُّكَ يَٰفِرۡعَوۡنُ مَثۡبُورٗا",
    "ayah_text_no_diacratic" : "قال لقد علمت ما انزل هٰؤلاء الا رب السمٰوٰت والارض بصائر واني لاظنك يٰفرعون مثبورا",
    "ayahnumber" : "102",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2163",
    "page" : "292",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2164",
    "ayah_text" : "فَأَرَادَ أَن يَسۡتَفِزَّهُم مِّنَ ٱلۡأَرۡضِ فَأَغۡرَقۡنَٰهُ وَمَن مَّعَهُۥ جَمِيعٗا",
    "ayah_text_no_diacratic" : "فاراد ان يستفزهم من الارض فاغرقنٰه ومن معه جميعا",
    "ayahnumber" : "103",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2164",
    "page" : "292",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2165",
    "ayah_text" : "وَقُلۡنَا مِنۢ بَعۡدِهِۦ لِبَنِيٓ إِسۡرَٰٓءِيلَ ٱسۡكُنُواْ ٱلۡأَرۡضَ فَإِذَا جَآءَ وَعۡدُ ٱلۡأٓخِرَةِ جِئۡنَا بِكُمۡ لَفِيفٗا",
    "ayah_text_no_diacratic" : "وقلنا من بعده لبني اسرٰءيل اسكنوا الارض فاذا جاء وعد الاخرة جئنا بكم لفيفا",
    "ayahnumber" : "104",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2165",
    "page" : "292",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2166",
    "ayah_text" : "وَبِٱلۡحَقِّ أَنزَلۡنَٰهُ وَبِٱلۡحَقِّ نَزَلَۗ وَمَآ أَرۡسَلۡنَٰكَ إِلَّا مُبَشِّرٗا وَنَذِيرٗا",
    "ayah_text_no_diacratic" : "وبالحق انزلنٰه وبالحق نزل وما ارسلنٰك الا مبشرا ونذيرا",
    "ayahnumber" : "105",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2166",
    "page" : "293",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2167",
    "ayah_text" : "وَقُرۡءَانٗا فَرَقۡنَٰهُ لِتَقۡرَأَهُۥ عَلَى ٱلنَّاسِ عَلَىٰ مُكۡثٖ وَنَزَّلۡنَٰهُ تَنزِيلٗا",
    "ayah_text_no_diacratic" : "وقرءانا فرقنٰه لتقراه على الناس علىٰ مكث ونزلنٰه تنزيلا",
    "ayahnumber" : "106",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2167",
    "page" : "293",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2168",
    "ayah_text" : "قُلۡ ءَامِنُواْ بِهِۦٓ أَوۡ لَا تُؤۡمِنُوٓاْۚ إِنَّ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ مِن قَبۡلِهِۦٓ إِذَا يُتۡلَىٰ عَلَيۡهِمۡ يَخِرُّونَۤ لِلۡأَذۡقَانِۤ سُجَّدٗاۤ",
    "ayah_text_no_diacratic" : "قل ءامنوا به او لا تؤمنوا ان الذين اوتوا العلم من قبله اذا يتلىٰ عليهم يخرون للاذقان سجدا",
    "ayahnumber" : "107",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2168",
    "page" : "293",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2169",
    "ayah_text" : "وَيَقُولُونَ سُبۡحَٰنَ رَبِّنَآ إِن كَانَ وَعۡدُ رَبِّنَا لَمَفۡعُولٗا",
    "ayah_text_no_diacratic" : "ويقولون سبحٰن ربنا ان كان وعد ربنا لمفعولا",
    "ayahnumber" : "108",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2169",
    "page" : "293",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:217",
    "ayah_text" : "وَمِنَ ٱلنَّاسِ مَن يَشۡرِي نَفۡسَهُ ٱبۡتِغَآءَ مَرۡضَاتِ ٱللَّهِۚ وَٱللَّهُ رَءُوفُۢ بِٱلۡعِبَادِ",
    "ayah_text_no_diacratic" : "ومن الناس من يشري نفسه ابتغاء مرضات الله والله رءوف بالعباد",
    "ayahnumber" : "207",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "217",
    "page" : "32",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2170",
    "ayah_text" : "وَيَخِرُّونَ لِلۡأَذۡقَانِ يَبۡكُونَ وَيَزِيدُهُمۡ خُشُوعٗا۩",
    "ayah_text_no_diacratic" : "ويخرون للاذقان يبكون ويزيدهم خشوعا",
    "ayahnumber" : "109",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2170",
    "page" : "293",
    "sajdah" : "1",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2171",
    "ayah_text" : "قُلِ ٱدۡعُواْ ٱللَّهَ أَوِ ٱدۡعُواْ ٱلرَّحۡمَٰنَۖ أَيّٗا مَّا تَدۡعُواْ فَلَهُ ٱلۡأَسۡمَآءُ ٱلۡحُسۡنَىٰۚ وَلَا تَجۡهَرۡ بِصَلَاتِكَ وَلَا تُخَافِتۡ بِهَا وَٱبۡتَغِ بَيۡنَ ذَٰلِكَ سَبِيلٗا",
    "ayah_text_no_diacratic" : "قل ادعوا الله او ادعوا الرحمٰن ايا ما تدعوا فله الاسماء الحسنىٰ ولا تجهر بصلاتك ولا تخافت بها وابتغ بين ذٰلك سبيلا",
    "ayahnumber" : "110",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2171",
    "page" : "293",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2172",
    "ayah_text" : "وَقُلِ ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي لَمۡ يَتَّخِذۡ وَلَدٗا وَلَمۡ يَكُن لَّهُۥ شَرِيكٞ فِي ٱلۡمُلۡكِ وَلَمۡ يَكُن لَّهُۥ وَلِيّٞ مِّنَ ٱلذُّلِّۖ وَكَبِّرۡهُ تَكۡبِيرَۢا",
    "ayah_text_no_diacratic" : "وقل الحمد لله الذي لم يتخذ ولدا ولم يكن له شريك في الملك ولم يكن له ولي من الذل وكبره تكبيرا",
    "ayahnumber" : "111",
    "chapter" : "15",
    "hizb" : "29",
    "index" : "2172",
    "page" : "293",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
