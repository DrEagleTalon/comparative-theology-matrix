    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1876",
    "ayah_text" : "ٱدۡخُلُوهَا بِسَلَٰمٍ ءَامِنِينَ",
    "ayah_text_no_diacratic" : "ادخلوها بسلٰم ءامنين",
    "ayahnumber" : "46",
