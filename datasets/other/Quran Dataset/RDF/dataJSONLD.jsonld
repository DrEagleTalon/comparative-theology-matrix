    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:5769",
    "ayah_text" : "نَّحۡنُ خَلَقۡنَٰهُمۡ وَشَدَدۡنَآ أَسۡرَهُمۡۖ وَإِذَا شِئۡنَا بَدَّلۡنَآ أَمۡثَٰلَهُمۡ تَبۡدِيلًا",
    "ayah_text_no_diacratic" : "نحن خلقنٰهم وشددنا اسرهم واذا شئنا بدلنا امثٰلهم تبديلا",
    "ayahnumber" : "28",
    "chapter" : "29",
    "hizb" : "58",
    "index" : "5769",
    "page" : "580",
    "surahname" : "سُورَةُ الإِنسَانِ",
    "surahnumber" : "76",
    "surrahname_no_diacratic" : "سورة الانسان"
  }, {
    "@id" : "quran:577",
    "ayah_text" : "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ قِيلَ لَهُمۡ كُفُّوٓاْ أَيۡدِيَكُمۡ وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ فَلَمَّا كُتِبَ عَلَيۡهِمُ ٱلۡقِتَالُ إِذَا فَرِيقٞ مِّنۡهُمۡ يَخۡشَوۡنَ ٱلنَّاسَ كَخَشۡيَةِ ٱللَّهِ أَوۡ أَشَدَّ خَشۡيَةٗۚ وَقَالُواْ رَبَّنَا لِمَ كَتَبۡتَ عَلَيۡنَا ٱلۡقِتَالَ لَوۡلَآ أَخَّرۡتَنَآ إِلَىٰٓ أَجَلٖ قَرِيبٖۗ قُلۡ مَتَٰعُ ٱلدُّنۡيَا قَلِيلٞ وَٱلۡأٓخِرَةُ خَيۡرٞ لِّمَنِ ٱتَّقَىٰ وَلَا تُظۡلَمُونَ فَتِيلًا",
    "ayah_text_no_diacratic" : "الم تر الى الذين قيل لهم كفوا ايديكم واقيموا الصلوٰة وءاتوا الزكوٰة فلما كتب عليهم القتال اذا فريق منهم يخشون الناس كخشية الله او اشد خشية وقالوا ربنا لم كتبت علينا القتال لولا اخرتنا الىٰ اجل قريب قل متٰع الدنيا قليل والاخرة خير لمن اتقىٰ ولا تظلمون فتيلا",
    "ayahnumber" : "77",
    "chapter" : "5",
    "hizb" : "9",
    "index" : "577",
    "page" : "90",
    "surahname" : "سُورَةُ النِّسَاءِ",
    "surahnumber" : "4",
    "surrahname_no_diacratic" : "سورة النساء"
  }, {
    "@id" : "quran:5770",
    "ayah_text" : "إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا",
    "ayah_text_no_diacratic" : "ان هٰذه تذكرة فمن شاء اتخذ الىٰ ربه سبيلا",
    "ayahnumber" : "29",
    "chapter" : "29",
    "hizb" : "58",
