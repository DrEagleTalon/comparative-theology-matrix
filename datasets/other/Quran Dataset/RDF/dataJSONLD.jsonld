    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4680",
    "ayah_text" : "وَيَنصُرَكَ ٱللَّهُ نَصۡرًا عَزِيزًا",
    "ayah_text_no_diacratic" : "وينصرك الله نصرا عزيزا",
