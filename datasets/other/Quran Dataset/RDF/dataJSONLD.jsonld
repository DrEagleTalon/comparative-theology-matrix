  }, {
    "@id" : "quran:4147",
    "ayah_text" : "قُلۡ إِنِّيٓ أَخَافُ إِنۡ عَصَيۡتُ رَبِّي عَذَابَ يَوۡمٍ عَظِيمٖ",
    "ayah_text_no_diacratic" : "قل اني اخاف ان عصيت ربي عذاب يوم عظيم",
