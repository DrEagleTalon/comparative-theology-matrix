    "surrahname_no_diacratic" : "سورة الحجرات"
  }, {
    "@id" : "quran:4726",
    "ayah_text" : "إِنَّ ٱللَّهَ يَعۡلَمُ غَيۡبَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ بَصِيرُۢ بِمَا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ان الله يعلم غيب السمٰوٰت والارض والله بصير بما تعملون",
    "ayahnumber" : "18",
    "chapter" : "26",
    "hizb" : "51",
