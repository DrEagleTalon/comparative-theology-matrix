    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4251",
    "ayah_text" : "مَنۡ عَمِلَ سَيِّئَةٗ فَلَا يُجۡزَىٰٓ إِلَّا مِثۡلَهَاۖ وَمَنۡ عَمِلَ صَٰلِحٗا مِّن ذَكَرٍ أَوۡ أُنثَىٰ وَهُوَ مُؤۡمِنٞ فَأُوْلَٰٓئِكَ يَدۡخُلُونَ ٱلۡجَنَّةَ يُرۡزَقُونَ فِيهَا بِغَيۡرِ حِسَابٖ",
    "ayah_text_no_diacratic" : "من عمل سيئة فلا يجزىٰ الا مثلها ومن عمل صٰلحا من ذكر او انثىٰ وهو مؤمن فاولٰئك يدخلون الجنة يرزقون فيها بغير حساب",
    "ayahnumber" : "40",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4251",
    "page" : "471",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4252",
    "ayah_text" : "۞وَيَٰقَوۡمِ مَا لِيٓ أَدۡعُوكُمۡ إِلَى ٱلنَّجَوٰةِ وَتَدۡعُونَنِيٓ إِلَى ٱلنَّارِ",
    "ayah_text_no_diacratic" : "ويٰقوم ما لي ادعوكم الى النجوٰة وتدعونني الى النار",
    "ayahnumber" : "41",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4252",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4253",
    "ayah_text" : "تَدۡعُونَنِي لِأَكۡفُرَ بِٱللَّهِ وَأُشۡرِكَ بِهِۦ مَا لَيۡسَ لِي بِهِۦ عِلۡمٞ وَأَنَا۠ أَدۡعُوكُمۡ إِلَى ٱلۡعَزِيزِ ٱلۡغَفَّٰرِ",
    "ayah_text_no_diacratic" : "تدعونني لاكفر بالله واشرك به ما ليس لي به علم وانا ادعوكم الى العزيز الغفٰر",
    "ayahnumber" : "42",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4253",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4254",
    "ayah_text" : "لَا جَرَمَ أَنَّمَا تَدۡعُونَنِيٓ إِلَيۡهِ لَيۡسَ لَهُۥ دَعۡوَةٞ فِي ٱلدُّنۡيَا وَلَا فِي ٱلۡأٓخِرَةِ وَأَنَّ مَرَدَّنَآ إِلَى ٱللَّهِ وَأَنَّ ٱلۡمُسۡرِفِينَ هُمۡ أَصۡحَٰبُ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "لا جرم انما تدعونني اليه ليس له دعوة في الدنيا ولا في الاخرة وان مردنا الى الله وان المسرفين هم اصحٰب النار",
    "ayahnumber" : "43",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4254",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4255",
    "ayah_text" : "فَسَتَذۡكُرُونَ مَآ أَقُولُ لَكُمۡۚ وَأُفَوِّضُ أَمۡرِيٓ إِلَى ٱللَّهِۚ إِنَّ ٱللَّهَ بَصِيرُۢ بِٱلۡعِبَادِ",
    "ayah_text_no_diacratic" : "فستذكرون ما اقول لكم وافوض امري الى الله ان الله بصير بالعباد",
    "ayahnumber" : "44",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4255",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4256",
    "ayah_text" : "فَوَقَىٰهُ ٱللَّهُ سَيِّـَٔاتِ مَا مَكَرُواْۖ وَحَاقَ بِـَٔالِ فِرۡعَوۡنَ سُوٓءُ ٱلۡعَذَابِ",
    "ayah_text_no_diacratic" : "فوقىٰه الله سيات ما مكروا وحاق بال فرعون سوء العذاب",
    "ayahnumber" : "45",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4256",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4257",
    "ayah_text" : "ٱلنَّارُ يُعۡرَضُونَ عَلَيۡهَا غُدُوّٗا وَعَشِيّٗاۚ وَيَوۡمَ تَقُومُ ٱلسَّاعَةُ أَدۡخِلُوٓاْ ءَالَ فِرۡعَوۡنَ أَشَدَّ ٱلۡعَذَابِ",
    "ayah_text_no_diacratic" : "النار يعرضون عليها غدوا وعشيا ويوم تقوم الساعة ادخلوا ءال فرعون اشد العذاب",
    "ayahnumber" : "46",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4257",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4258",
    "ayah_text" : "وَإِذۡ يَتَحَآجُّونَ فِي ٱلنَّارِ فَيَقُولُ ٱلضُّعَفَٰٓؤُاْ لِلَّذِينَ ٱسۡتَكۡبَرُوٓاْ إِنَّا كُنَّا لَكُمۡ تَبَعٗا فَهَلۡ أَنتُم مُّغۡنُونَ عَنَّا نَصِيبٗا مِّنَ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "واذ يتحاجون في النار فيقول الضعفٰؤا للذين استكبروا انا كنا لكم تبعا فهل انتم مغنون عنا نصيبا من النار",
    "ayahnumber" : "47",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4258",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4259",
    "ayah_text" : "قَالَ ٱلَّذِينَ ٱسۡتَكۡبَرُوٓاْ إِنَّا كُلّٞ فِيهَآ إِنَّ ٱللَّهَ قَدۡ حَكَمَ بَيۡنَ ٱلۡعِبَادِ",
    "ayah_text_no_diacratic" : "قال الذين استكبروا انا كل فيها ان الله قد حكم بين العباد",
    "ayahnumber" : "48",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4259",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:426",
    "ayah_text" : "لَيۡسَ لَكَ مِنَ ٱلۡأَمۡرِ شَيۡءٌ أَوۡ يَتُوبَ عَلَيۡهِمۡ أَوۡ يُعَذِّبَهُمۡ فَإِنَّهُمۡ ظَٰلِمُونَ",
    "ayah_text_no_diacratic" : "ليس لك من الامر شيء او يتوب عليهم او يعذبهم فانهم ظٰلمون",
    "ayahnumber" : "128",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "426",
    "page" : "66",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4260",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ فِي ٱلنَّارِ لِخَزَنَةِ جَهَنَّمَ ٱدۡعُواْ رَبَّكُمۡ يُخَفِّفۡ عَنَّا يَوۡمٗا مِّنَ ٱلۡعَذَابِ",
    "ayah_text_no_diacratic" : "وقال الذين في النار لخزنة جهنم ادعوا ربكم يخفف عنا يوما من العذاب",
    "ayahnumber" : "49",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4260",
    "page" : "472",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4261",
    "ayah_text" : "قَالُوٓاْ أَوَلَمۡ تَكُ تَأۡتِيكُمۡ رُسُلُكُم بِٱلۡبَيِّنَٰتِۖ قَالُواْ بَلَىٰۚ قَالُواْ فَٱدۡعُواْۗ وَمَا دُعَٰٓؤُاْ ٱلۡكَٰفِرِينَ إِلَّا فِي ضَلَٰلٍ",
    "ayah_text_no_diacratic" : "قالوا اولم تك تاتيكم رسلكم بالبينٰت قالوا بلىٰ قالوا فادعوا وما دعٰؤا الكٰفرين الا في ضلٰل",
    "ayahnumber" : "50",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4261",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4262",
    "ayah_text" : "إِنَّا لَنَنصُرُ رُسُلَنَا وَٱلَّذِينَ ءَامَنُواْ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَيَوۡمَ يَقُومُ ٱلۡأَشۡهَٰدُ",
    "ayah_text_no_diacratic" : "انا لننصر رسلنا والذين ءامنوا في الحيوٰة الدنيا ويوم يقوم الاشهٰد",
    "ayahnumber" : "51",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4262",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4263",
    "ayah_text" : "يَوۡمَ لَا يَنفَعُ ٱلظَّٰلِمِينَ مَعۡذِرَتُهُمۡۖ وَلَهُمُ ٱللَّعۡنَةُ وَلَهُمۡ سُوٓءُ ٱلدَّارِ",
    "ayah_text_no_diacratic" : "يوم لا ينفع الظٰلمين معذرتهم ولهم اللعنة ولهم سوء الدار",
    "ayahnumber" : "52",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4263",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4264",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡهُدَىٰ وَأَوۡرَثۡنَا بَنِيٓ إِسۡرَٰٓءِيلَ ٱلۡكِتَٰبَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسى الهدىٰ واورثنا بني اسرٰءيل الكتٰب",
    "ayahnumber" : "53",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4264",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4265",
    "ayah_text" : "هُدٗى وَذِكۡرَىٰ لِأُوْلِي ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "هدى وذكرىٰ لاولي الالبٰب",
    "ayahnumber" : "54",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4265",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4266",
    "ayah_text" : "فَٱصۡبِرۡ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَٱسۡتَغۡفِرۡ لِذَنۢبِكَ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ بِٱلۡعَشِيِّ وَٱلۡإِبۡكَٰرِ",
    "ayah_text_no_diacratic" : "فاصبر ان وعد الله حق واستغفر لذنبك وسبح بحمد ربك بالعشي والابكٰر",
    "ayahnumber" : "55",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4266",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4267",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِ ٱللَّهِ بِغَيۡرِ سُلۡطَٰنٍ أَتَىٰهُمۡ إِن فِي صُدُورِهِمۡ إِلَّا كِبۡرٞ مَّا هُم بِبَٰلِغِيهِۚ فَٱسۡتَعِذۡ بِٱللَّهِۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ",
    "ayah_text_no_diacratic" : "ان الذين يجٰدلون في ءايٰت الله بغير سلطٰن اتىٰهم ان في صدورهم الا كبر ما هم ببٰلغيه فاستعذ بالله انه هو السميع البصير",
    "ayahnumber" : "56",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4267",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4268",
    "ayah_text" : "لَخَلۡقُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ أَكۡبَرُ مِنۡ خَلۡقِ ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "لخلق السمٰوٰت والارض اكبر من خلق الناس ولٰكن اكثر الناس لا يعلمون",
    "ayahnumber" : "57",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4268",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4269",
    "ayah_text" : "وَمَا يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَلَا ٱلۡمُسِيٓءُۚ قَلِيلٗا مَّا تَتَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "وما يستوي الاعمىٰ والبصير والذين ءامنوا وعملوا الصٰلحٰت ولا المسيء قليلا ما تتذكرون",
    "ayahnumber" : "58",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4269",
    "page" : "473",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:427",
    "ayah_text" : "وَلِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۚ يَغۡفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "ولله ما في السمٰوٰت وما في الارض يغفر لمن يشاء ويعذب من يشاء والله غفور رحيم",
    "ayahnumber" : "129",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "427",
    "page" : "66",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4270",
    "ayah_text" : "إِنَّ ٱلسَّاعَةَ لَأٓتِيَةٞ لَّا رَيۡبَ فِيهَا وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "ان الساعة لاتية لا ريب فيها ولٰكن اكثر الناس لا يؤمنون",
    "ayahnumber" : "59",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4270",
    "page" : "474",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4271",
    "ayah_text" : "وَقَالَ رَبُّكُمُ ٱدۡعُونِيٓ أَسۡتَجِبۡ لَكُمۡۚ إِنَّ ٱلَّذِينَ يَسۡتَكۡبِرُونَ عَنۡ عِبَادَتِي سَيَدۡخُلُونَ جَهَنَّمَ دَاخِرِينَ",
    "ayah_text_no_diacratic" : "وقال ربكم ادعوني استجب لكم ان الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين",
    "ayahnumber" : "60",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4271",
    "page" : "474",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4272",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي جَعَلَ لَكُمُ ٱلَّيۡلَ لِتَسۡكُنُواْ فِيهِ وَٱلنَّهَارَ مُبۡصِرًاۚ إِنَّ ٱللَّهَ لَذُو فَضۡلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "الله الذي جعل لكم اليل لتسكنوا فيه والنهار مبصرا ان الله لذو فضل على الناس ولٰكن اكثر الناس لا يشكرون",
    "ayahnumber" : "61",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4272",
    "page" : "474",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4273",
    "ayah_text" : "ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ خَٰلِقُ كُلِّ شَيۡءٖ لَّآ إِلَٰهَ إِلَّا هُوَۖ فَأَنَّىٰ تُؤۡفَكُونَ",
    "ayah_text_no_diacratic" : "ذٰلكم الله ربكم خٰلق كل شيء لا الٰه الا هو فانىٰ تؤفكون",
    "ayahnumber" : "62",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4273",
    "page" : "474",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4274",
    "ayah_text" : "كَذَٰلِكَ يُؤۡفَكُ ٱلَّذِينَ كَانُواْ بِـَٔايَٰتِ ٱللَّهِ يَجۡحَدُونَ",
    "ayah_text_no_diacratic" : "كذٰلك يؤفك الذين كانوا بايٰت الله يجحدون",
    "ayahnumber" : "63",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4274",
    "page" : "474",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4275",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ قَرَارٗا وَٱلسَّمَآءَ بِنَآءٗ وَصَوَّرَكُمۡ فَأَحۡسَنَ صُوَرَكُمۡ وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡۖ فَتَبَارَكَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "الله الذي جعل لكم الارض قرارا والسماء بناء وصوركم فاحسن صوركم ورزقكم من الطيبٰت ذٰلكم الله ربكم فتبارك الله رب العٰلمين",
    "ayahnumber" : "64",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4275",
    "page" : "474",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4276",
    "ayah_text" : "هُوَ ٱلۡحَيُّ لَآ إِلَٰهَ إِلَّا هُوَ فَٱدۡعُوهُ مُخۡلِصِينَ لَهُ ٱلدِّينَۗ ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "هو الحي لا الٰه الا هو فادعوه مخلصين له الدين الحمد لله رب العٰلمين",
    "ayahnumber" : "65",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4276",
    "page" : "474",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4277",
    "ayah_text" : "۞قُلۡ إِنِّي نُهِيتُ أَنۡ أَعۡبُدَ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِ لَمَّا جَآءَنِيَ ٱلۡبَيِّنَٰتُ مِن رَّبِّي وَأُمِرۡتُ أَنۡ أُسۡلِمَ لِرَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "قل اني نهيت ان اعبد الذين تدعون من دون الله لما جاءني البينٰت من ربي وامرت ان اسلم لرب العٰلمين",
    "ayahnumber" : "66",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4277",
    "page" : "474",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4278",
    "ayah_text" : "هُوَ ٱلَّذِي خَلَقَكُم مِّن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ مِنۡ عَلَقَةٖ ثُمَّ يُخۡرِجُكُمۡ طِفۡلٗا ثُمَّ لِتَبۡلُغُوٓاْ أَشُدَّكُمۡ ثُمَّ لِتَكُونُواْ شُيُوخٗاۚ وَمِنكُم مَّن يُتَوَفَّىٰ مِن قَبۡلُۖ وَلِتَبۡلُغُوٓاْ أَجَلٗا مُّسَمّٗى وَلَعَلَّكُمۡ تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "هو الذي خلقكم من تراب ثم من نطفة ثم من علقة ثم يخرجكم طفلا ثم لتبلغوا اشدكم ثم لتكونوا شيوخا ومنكم من يتوفىٰ من قبل ولتبلغوا اجلا مسمى ولعلكم تعقلون",
    "ayahnumber" : "67",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4278",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4279",
    "ayah_text" : "هُوَ ٱلَّذِي يُحۡيِۦ وَيُمِيتُۖ فَإِذَا قَضَىٰٓ أَمۡرٗا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ",
    "ayah_text_no_diacratic" : "هو الذي يحي ويميت فاذا قضىٰ امرا فانما يقول له كن فيكون",
    "ayahnumber" : "68",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4279",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:428",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَأۡكُلُواْ ٱلرِّبَوٰٓاْ أَضۡعَٰفٗا مُّضَٰعَفَةٗۖ وَٱتَّقُواْ ٱللَّهَ لَعَلَّكُمۡ تُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا لا تاكلوا الربوٰا اضعٰفا مضٰعفة واتقوا الله لعلكم تفلحون",
    "ayahnumber" : "130",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "428",
    "page" : "66",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4280",
    "ayah_text" : "أَلَمۡ تَرَ إِلَى ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِ ٱللَّهِ أَنَّىٰ يُصۡرَفُونَ",
    "ayah_text_no_diacratic" : "الم تر الى الذين يجٰدلون في ءايٰت الله انىٰ يصرفون",
    "ayahnumber" : "69",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4280",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4281",
    "ayah_text" : "ٱلَّذِينَ كَذَّبُواْ بِٱلۡكِتَٰبِ وَبِمَآ أَرۡسَلۡنَا بِهِۦ رُسُلَنَاۖ فَسَوۡفَ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "الذين كذبوا بالكتٰب وبما ارسلنا به رسلنا فسوف يعلمون",
    "ayahnumber" : "70",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4281",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4282",
    "ayah_text" : "إِذِ ٱلۡأَغۡلَٰلُ فِيٓ أَعۡنَٰقِهِمۡ وَٱلسَّلَٰسِلُ يُسۡحَبُونَ",
    "ayah_text_no_diacratic" : "اذ الاغلٰل في اعنٰقهم والسلٰسل يسحبون",
    "ayahnumber" : "71",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4282",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4283",
    "ayah_text" : "فِي ٱلۡحَمِيمِ ثُمَّ فِي ٱلنَّارِ يُسۡجَرُونَ",
    "ayah_text_no_diacratic" : "في الحميم ثم في النار يسجرون",
    "ayahnumber" : "72",
    "chapter" : "24",
    "hizb" : "47",
    "index" : "4283",
    "page" : "475",
    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4284",
    "ayah_text" : "ثُمَّ قِيلَ لَهُمۡ أَيۡنَ مَا كُنتُمۡ تُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "ثم قيل لهم اين ما كنتم تشركون",
    "ayahnumber" : "73",
    "chapter" : "24",
    "hizb" : "47",
