    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2967",
    "ayah_text" : "وَٱلَّذِينَ يَبِيتُونَ لِرَبِّهِمۡ سُجَّدٗا وَقِيَٰمٗا",
    "ayah_text_no_diacratic" : "والذين يبيتون لربهم سجدا وقيٰما",
