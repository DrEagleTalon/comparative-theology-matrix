  }, {
    "@id" : "quran:4976",
    "ayah_text" : "فَقَالُوٓاْ أَبَشَرٗا مِّنَّا وَٰحِدٗا نَّتَّبِعُهُۥٓ إِنَّآ إِذٗا لَّفِي ضَلَٰلٖ وَسُعُرٍ",
    "ayah_text_no_diacratic" : "فقالوا ابشرا منا وٰحدا نتبعه انا اذا لفي ضلٰل وسعر",
