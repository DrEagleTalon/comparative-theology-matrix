  }, {
    "@id" : "quran:1732",
    "ayah_text" : "الٓمٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِۗ وَٱلَّذِيٓ أُنزِلَ إِلَيۡكَ مِن رَّبِّكَ ٱلۡحَقُّ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "المر تلك ءايٰت الكتٰب والذي انزل اليك من ربك الحق ولٰكن اكثر الناس لا يؤمنون",
    "ayahnumber" : "1",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1732",
    "page" : "249",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1733",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي رَفَعَ ٱلسَّمَٰوَٰتِ بِغَيۡرِ عَمَدٖ تَرَوۡنَهَاۖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ وَسَخَّرَ ٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ يَجۡرِي لِأَجَلٖ مُّسَمّٗىۚ يُدَبِّرُ ٱلۡأَمۡرَ يُفَصِّلُ ٱلۡأٓيَٰتِ لَعَلَّكُم بِلِقَآءِ رَبِّكُمۡ تُوقِنُونَ",
    "ayah_text_no_diacratic" : "الله الذي رفع السمٰوٰت بغير عمد ترونها ثم استوىٰ على العرش وسخر الشمس والقمر كل يجري لاجل مسمى يدبر الامر يفصل الايٰت لعلكم بلقاء ربكم توقنون",
    "ayahnumber" : "2",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1733",
    "page" : "249",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1734",
    "ayah_text" : "وَهُوَ ٱلَّذِي مَدَّ ٱلۡأَرۡضَ وَجَعَلَ فِيهَا رَوَٰسِيَ وَأَنۡهَٰرٗاۖ وَمِن كُلِّ ٱلثَّمَرَٰتِ جَعَلَ فِيهَا زَوۡجَيۡنِ ٱثۡنَيۡنِۖ يُغۡشِي ٱلَّيۡلَ ٱلنَّهَارَۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "وهو الذي مد الارض وجعل فيها روٰسي وانهٰرا ومن كل الثمرٰت جعل فيها زوجين اثنين يغشي اليل النهار ان في ذٰلك لايٰت لقوم يتفكرون",
    "ayahnumber" : "3",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1734",
    "page" : "249",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1735",
    "ayah_text" : "وَفِي ٱلۡأَرۡضِ قِطَعٞ مُّتَجَٰوِرَٰتٞ وَجَنَّٰتٞ مِّنۡ أَعۡنَٰبٖ وَزَرۡعٞ وَنَخِيلٞ صِنۡوَانٞ وَغَيۡرُ صِنۡوَانٖ يُسۡقَىٰ بِمَآءٖ وَٰحِدٖ وَنُفَضِّلُ بَعۡضَهَا عَلَىٰ بَعۡضٖ فِي ٱلۡأُكُلِۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "وفي الارض قطع متجٰورٰت وجنٰت من اعنٰب وزرع ونخيل صنوان وغير صنوان يسقىٰ بماء وٰحد ونفضل بعضها علىٰ بعض في الاكل ان في ذٰلك لايٰت لقوم يعقلون",
    "ayahnumber" : "4",
    "chapter" : "13",
    "hizb" : "24",
    "index" : "1735",
    "page" : "249",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1736",
    "ayah_text" : "۞وَإِن تَعۡجَبۡ فَعَجَبٞ قَوۡلُهُمۡ أَءِذَا كُنَّا تُرَٰبًا أَءِنَّا لَفِي خَلۡقٖ جَدِيدٍۗ أُوْلَٰٓئِكَ ٱلَّذِينَ كَفَرُواْ بِرَبِّهِمۡۖ وَأُوْلَٰٓئِكَ ٱلۡأَغۡلَٰلُ فِيٓ أَعۡنَاقِهِمۡۖ وَأُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "وان تعجب فعجب قولهم اءذا كنا ترٰبا اءنا لفي خلق جديد اولٰئك الذين كفروا بربهم واولٰئك الاغلٰل في اعناقهم واولٰئك اصحٰب النار هم فيها خٰلدون",
    "ayahnumber" : "5",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1736",
    "page" : "249",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1737",
    "ayah_text" : "وَيَسۡتَعۡجِلُونَكَ بِٱلسَّيِّئَةِ قَبۡلَ ٱلۡحَسَنَةِ وَقَدۡ خَلَتۡ مِن قَبۡلِهِمُ ٱلۡمَثُلَٰتُۗ وَإِنَّ رَبَّكَ لَذُو مَغۡفِرَةٖ لِّلنَّاسِ عَلَىٰ ظُلۡمِهِمۡۖ وَإِنَّ رَبَّكَ لَشَدِيدُ ٱلۡعِقَابِ",
    "ayah_text_no_diacratic" : "ويستعجلونك بالسيئة قبل الحسنة وقد خلت من قبلهم المثلٰت وان ربك لذو مغفرة للناس علىٰ ظلمهم وان ربك لشديد العقاب",
    "ayahnumber" : "6",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1737",
    "page" : "250",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1738",
    "ayah_text" : "وَيَقُولُ ٱلَّذِينَ كَفَرُواْ لَوۡلَآ أُنزِلَ عَلَيۡهِ ءَايَةٞ مِّن رَّبِّهِۦٓۗ إِنَّمَآ أَنتَ مُنذِرٞۖ وَلِكُلِّ قَوۡمٍ هَادٍ",
    "ayah_text_no_diacratic" : "ويقول الذين كفروا لولا انزل عليه ءاية من ربه انما انت منذر ولكل قوم هاد",
    "ayahnumber" : "7",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1738",
    "page" : "250",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1739",
    "ayah_text" : "ٱللَّهُ يَعۡلَمُ مَا تَحۡمِلُ كُلُّ أُنثَىٰ وَمَا تَغِيضُ ٱلۡأَرۡحَامُ وَمَا تَزۡدَادُۚ وَكُلُّ شَيۡءٍ عِندَهُۥ بِمِقۡدَارٍ",
    "ayah_text_no_diacratic" : "الله يعلم ما تحمل كل انثىٰ وما تغيض الارحام وما تزداد وكل شيء عنده بمقدار",
    "ayahnumber" : "8",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1739",
    "page" : "250",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:174",
    "ayah_text" : "إِنَّ فِي خَلۡقِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ وَٱلۡفُلۡكِ ٱلَّتِي تَجۡرِي فِي ٱلۡبَحۡرِ بِمَا يَنفَعُ ٱلنَّاسَ وَمَآ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَآءِ مِن مَّآءٖ فَأَحۡيَا بِهِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٖ وَتَصۡرِيفِ ٱلرِّيَٰحِ وَٱلسَّحَابِ ٱلۡمُسَخَّرِ بَيۡنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِ لَأٓيَٰتٖ لِّقَوۡمٖ يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "ان في خلق السمٰوٰت والارض واختلٰف اليل والنهار والفلك التي تجري في البحر بما ينفع الناس وما انزل الله من السماء من ماء فاحيا به الارض بعد موتها وبث فيها من كل دابة وتصريف الريٰح والسحاب المسخر بين السماء والارض لايٰت لقوم يعقلون",
    "ayahnumber" : "164",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "174",
    "page" : "25",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1740",
    "ayah_text" : "عَٰلِمُ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ ٱلۡكَبِيرُ ٱلۡمُتَعَالِ",
    "ayah_text_no_diacratic" : "عٰلم الغيب والشهٰدة الكبير المتعال",
    "ayahnumber" : "9",
