    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:183",
    "ayah_text" : "إِنَّمَا حَرَّمَ عَلَيۡكُمُ ٱلۡمَيۡتَةَ وَٱلدَّمَ وَلَحۡمَ ٱلۡخِنزِيرِ وَمَآ أُهِلَّ بِهِۦ لِغَيۡرِ ٱللَّهِۖ فَمَنِ ٱضۡطُرَّ غَيۡرَ بَاغٖ وَلَا عَادٖ فَلَآ إِثۡمَ عَلَيۡهِۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ",
    "ayah_text_no_diacratic" : "انما حرم عليكم الميتة والدم ولحم الخنزير وما اهل به لغير الله فمن اضطر غير باغ ولا عاد فلا اثم عليه ان الله غفور رحيم",
    "ayahnumber" : "173",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "183",
    "page" : "26",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1830",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1830",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1831",
    "ayah_text" : "الٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ وَقُرۡءَانٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "الر تلك ءايٰت الكتٰب وقرءان مبين",
    "ayahnumber" : "1",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1831",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1832",
    "ayah_text" : "رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُواْ لَوۡ كَانُواْ مُسۡلِمِينَ",
    "ayah_text_no_diacratic" : "ربما يود الذين كفروا لو كانوا مسلمين",
    "ayahnumber" : "2",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1832",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1833",
    "ayah_text" : "ذَرۡهُمۡ يَأۡكُلُواْ وَيَتَمَتَّعُواْ وَيُلۡهِهِمُ ٱلۡأَمَلُۖ فَسَوۡفَ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ذرهم ياكلوا ويتمتعوا ويلههم الامل فسوف يعلمون",
    "ayahnumber" : "3",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1833",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1834",
    "ayah_text" : "وَمَآ أَهۡلَكۡنَا مِن قَرۡيَةٍ إِلَّا وَلَهَا كِتَابٞ مَّعۡلُومٞ",
    "ayah_text_no_diacratic" : "وما اهلكنا من قرية الا ولها كتاب معلوم",
    "ayahnumber" : "4",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1834",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1835",
    "ayah_text" : "مَّا تَسۡبِقُ مِنۡ أُمَّةٍ أَجَلَهَا وَمَا يَسۡتَـٔۡخِرُونَ",
    "ayah_text_no_diacratic" : "ما تسبق من امة اجلها وما يستخرون",
    "ayahnumber" : "5",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1835",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1836",
    "ayah_text" : "وَقَالُواْ يَٰٓأَيُّهَا ٱلَّذِي نُزِّلَ عَلَيۡهِ ٱلذِّكۡرُ إِنَّكَ لَمَجۡنُونٞ",
    "ayah_text_no_diacratic" : "وقالوا يٰايها الذي نزل عليه الذكر انك لمجنون",
    "ayahnumber" : "6",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1836",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1837",
    "ayah_text" : "لَّوۡمَا تَأۡتِينَا بِٱلۡمَلَٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "لوما تاتينا بالملٰئكة ان كنت من الصٰدقين",
    "ayahnumber" : "7",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1837",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1838",
    "ayah_text" : "مَا نُنَزِّلُ ٱلۡمَلَٰٓئِكَةَ إِلَّا بِٱلۡحَقِّ وَمَا كَانُوٓاْ إِذٗا مُّنظَرِينَ",
    "ayah_text_no_diacratic" : "ما ننزل الملٰئكة الا بالحق وما كانوا اذا منظرين",
    "ayahnumber" : "8",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1838",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1839",
    "ayah_text" : "إِنَّا نَحۡنُ نَزَّلۡنَا ٱلذِّكۡرَ وَإِنَّا لَهُۥ لَحَٰفِظُونَ",
    "ayah_text_no_diacratic" : "انا نحن نزلنا الذكر وانا له لحٰفظون",
    "ayahnumber" : "9",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1839",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:184",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَكۡتُمُونَ مَآ أَنزَلَ ٱللَّهُ مِنَ ٱلۡكِتَٰبِ وَيَشۡتَرُونَ بِهِۦ ثَمَنٗا قَلِيلًا أُوْلَٰٓئِكَ مَا يَأۡكُلُونَ فِي بُطُونِهِمۡ إِلَّا ٱلنَّارَ وَلَا يُكَلِّمُهُمُ ٱللَّهُ يَوۡمَ ٱلۡقِيَٰمَةِ وَلَا يُزَكِّيهِمۡ وَلَهُمۡ عَذَابٌ أَلِيمٌ",
    "ayah_text_no_diacratic" : "ان الذين يكتمون ما انزل الله من الكتٰب ويشترون به ثمنا قليلا اولٰئك ما ياكلون في بطونهم الا النار ولا يكلمهم الله يوم القيٰمة ولا يزكيهم ولهم عذاب اليم",
    "ayahnumber" : "174",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "184",
    "page" : "26",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1840",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا مِن قَبۡلِكَ فِي شِيَعِ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا من قبلك في شيع الاولين",
    "ayahnumber" : "10",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1840",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1841",
    "ayah_text" : "وَمَا يَأۡتِيهِم مِّن رَّسُولٍ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "وما ياتيهم من رسول الا كانوا به يستهزءون",
    "ayahnumber" : "11",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1841",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1842",
    "ayah_text" : "كَذَٰلِكَ نَسۡلُكُهُۥ فِي قُلُوبِ ٱلۡمُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "كذٰلك نسلكه في قلوب المجرمين",
    "ayahnumber" : "12",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1842",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1843",
    "ayah_text" : "لَا يُؤۡمِنُونَ بِهِۦ وَقَدۡ خَلَتۡ سُنَّةُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "لا يؤمنون به وقد خلت سنة الاولين",
    "ayahnumber" : "13",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1843",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1844",
    "ayah_text" : "وَلَوۡ فَتَحۡنَا عَلَيۡهِم بَابٗا مِّنَ ٱلسَّمَآءِ فَظَلُّواْ فِيهِ يَعۡرُجُونَ",
    "ayah_text_no_diacratic" : "ولو فتحنا عليهم بابا من السماء فظلوا فيه يعرجون",
    "ayahnumber" : "14",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1844",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1845",
    "ayah_text" : "لَقَالُوٓاْ إِنَّمَا سُكِّرَتۡ أَبۡصَٰرُنَا بَلۡ نَحۡنُ قَوۡمٞ مَّسۡحُورُونَ",
    "ayah_text_no_diacratic" : "لقالوا انما سكرت ابصٰرنا بل نحن قوم مسحورون",
    "ayahnumber" : "15",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1845",
    "page" : "262",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1846",
    "ayah_text" : "وَلَقَدۡ جَعَلۡنَا فِي ٱلسَّمَآءِ بُرُوجٗا وَزَيَّنَّٰهَا لِلنَّٰظِرِينَ",
    "ayah_text_no_diacratic" : "ولقد جعلنا في السماء بروجا وزينٰها للنٰظرين",
    "ayahnumber" : "16",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1846",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1847",
    "ayah_text" : "وَحَفِظۡنَٰهَا مِن كُلِّ شَيۡطَٰنٖ رَّجِيمٍ",
    "ayah_text_no_diacratic" : "وحفظنٰها من كل شيطٰن رجيم",
    "ayahnumber" : "17",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1847",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1848",
    "ayah_text" : "إِلَّا مَنِ ٱسۡتَرَقَ ٱلسَّمۡعَ فَأَتۡبَعَهُۥ شِهَابٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "الا من استرق السمع فاتبعه شهاب مبين",
    "ayahnumber" : "18",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1848",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1849",
    "ayah_text" : "وَٱلۡأَرۡضَ مَدَدۡنَٰهَا وَأَلۡقَيۡنَا فِيهَا رَوَٰسِيَ وَأَنۢبَتۡنَا فِيهَا مِن كُلِّ شَيۡءٖ مَّوۡزُونٖ",
    "ayah_text_no_diacratic" : "والارض مددنٰها والقينا فيها روٰسي وانبتنا فيها من كل شيء موزون",
    "ayahnumber" : "19",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1849",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:185",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ ٱشۡتَرَوُاْ ٱلضَّلَٰلَةَ بِٱلۡهُدَىٰ وَٱلۡعَذَابَ بِٱلۡمَغۡفِرَةِۚ فَمَآ أَصۡبَرَهُمۡ عَلَى ٱلنَّارِ",
    "ayah_text_no_diacratic" : "اولٰئك الذين اشتروا الضلٰلة بالهدىٰ والعذاب بالمغفرة فما اصبرهم على النار",
    "ayahnumber" : "175",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "185",
    "page" : "26",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1850",
    "ayah_text" : "وَجَعَلۡنَا لَكُمۡ فِيهَا مَعَٰيِشَ وَمَن لَّسۡتُمۡ لَهُۥ بِرَٰزِقِينَ",
    "ayah_text_no_diacratic" : "وجعلنا لكم فيها معٰيش ومن لستم له برٰزقين",
    "ayahnumber" : "20",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1850",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1851",
    "ayah_text" : "وَإِن مِّن شَيۡءٍ إِلَّا عِندَنَا خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ إِلَّا بِقَدَرٖ مَّعۡلُومٖ",
    "ayah_text_no_diacratic" : "وان من شيء الا عندنا خزائنه وما ننزله الا بقدر معلوم",
    "ayahnumber" : "21",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1851",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1852",
    "ayah_text" : "وَأَرۡسَلۡنَا ٱلرِّيَٰحَ لَوَٰقِحَ فَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ فَأَسۡقَيۡنَٰكُمُوهُ وَمَآ أَنتُمۡ لَهُۥ بِخَٰزِنِينَ",
    "ayah_text_no_diacratic" : "وارسلنا الريٰح لوٰقح فانزلنا من السماء ماء فاسقينٰكموه وما انتم له بخٰزنين",
    "ayahnumber" : "22",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1852",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1853",
    "ayah_text" : "وَإِنَّا لَنَحۡنُ نُحۡيِۦ وَنُمِيتُ وَنَحۡنُ ٱلۡوَٰرِثُونَ",
    "ayah_text_no_diacratic" : "وانا لنحن نحي ونميت ونحن الوٰرثون",
    "ayahnumber" : "23",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1853",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1854",
    "ayah_text" : "وَلَقَدۡ عَلِمۡنَا ٱلۡمُسۡتَقۡدِمِينَ مِنكُمۡ وَلَقَدۡ عَلِمۡنَا ٱلۡمُسۡتَـٔۡخِرِينَ",
    "ayah_text_no_diacratic" : "ولقد علمنا المستقدمين منكم ولقد علمنا المستخرين",
    "ayahnumber" : "24",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1854",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1855",
    "ayah_text" : "وَإِنَّ رَبَّكَ هُوَ يَحۡشُرُهُمۡۚ إِنَّهُۥ حَكِيمٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "وان ربك هو يحشرهم انه حكيم عليم",
    "ayahnumber" : "25",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1855",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1856",
    "ayah_text" : "وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ",
    "ayah_text_no_diacratic" : "ولقد خلقنا الانسٰن من صلصٰل من حما مسنون",
    "ayahnumber" : "26",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1856",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1857",
    "ayah_text" : "وَٱلۡجَآنَّ خَلَقۡنَٰهُ مِن قَبۡلُ مِن نَّارِ ٱلسَّمُومِ",
    "ayah_text_no_diacratic" : "والجان خلقنٰه من قبل من نار السموم",
    "ayahnumber" : "27",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1857",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1858",
    "ayah_text" : "وَإِذۡ قَالَ رَبُّكَ لِلۡمَلَٰٓئِكَةِ إِنِّي خَٰلِقُۢ بَشَرٗا مِّن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ",
    "ayah_text_no_diacratic" : "واذ قال ربك للملٰئكة اني خٰلق بشرا من صلصٰل من حما مسنون",
    "ayahnumber" : "28",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1858",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1859",
    "ayah_text" : "فَإِذَا سَوَّيۡتُهُۥ وَنَفَخۡتُ فِيهِ مِن رُّوحِي فَقَعُواْ لَهُۥ سَٰجِدِينَ",
    "ayah_text_no_diacratic" : "فاذا سويته ونفخت فيه من روحي فقعوا له سٰجدين",
    "ayahnumber" : "29",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1859",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:186",
    "ayah_text" : "ذَٰلِكَ بِأَنَّ ٱللَّهَ نَزَّلَ ٱلۡكِتَٰبَ بِٱلۡحَقِّۗ وَإِنَّ ٱلَّذِينَ ٱخۡتَلَفُواْ فِي ٱلۡكِتَٰبِ لَفِي شِقَاقِۭ بَعِيدٖ",
    "ayah_text_no_diacratic" : "ذٰلك بان الله نزل الكتٰب بالحق وان الذين اختلفوا في الكتٰب لفي شقاق بعيد",
    "ayahnumber" : "176",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "186",
    "page" : "26",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1860",
    "ayah_text" : "فَسَجَدَ ٱلۡمَلَٰٓئِكَةُ كُلُّهُمۡ أَجۡمَعُونَ",
    "ayah_text_no_diacratic" : "فسجد الملٰئكة كلهم اجمعون",
    "ayahnumber" : "30",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1860",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1861",
    "ayah_text" : "إِلَّآ إِبۡلِيسَ أَبَىٰٓ أَن يَكُونَ مَعَ ٱلسَّٰجِدِينَ",
    "ayah_text_no_diacratic" : "الا ابليس ابىٰ ان يكون مع السٰجدين",
    "ayahnumber" : "31",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1861",
    "page" : "263",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1862",
    "ayah_text" : "قَالَ يَٰٓإِبۡلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ ٱلسَّٰجِدِينَ",
    "ayah_text_no_diacratic" : "قال يٰابليس ما لك الا تكون مع السٰجدين",
    "ayahnumber" : "32",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1862",
