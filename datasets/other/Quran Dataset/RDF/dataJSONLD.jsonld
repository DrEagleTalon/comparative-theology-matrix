    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3694",
    "ayah_text" : "قُلِ ٱدۡعُواْ ٱلَّذِينَ زَعَمۡتُم مِّن دُونِ ٱللَّهِ لَا يَمۡلِكُونَ مِثۡقَالَ ذَرَّةٖ فِي ٱلسَّمَٰوَٰتِ وَلَا فِي ٱلۡأَرۡضِ وَمَا لَهُمۡ فِيهِمَا مِن شِرۡكٖ وَمَا لَهُۥ مِنۡهُم مِّن ظَهِيرٖ",
    "ayah_text_no_diacratic" : "قل ادعوا الذين زعمتم من دون الله لا يملكون مثقال ذرة في السمٰوٰت ولا في الارض وما لهم فيهما من شرك وما له منهم من ظهير",
    "ayahnumber" : "22",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3694",
    "page" : "430",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3695",
    "ayah_text" : "وَلَا تَنفَعُ ٱلشَّفَٰعَةُ عِندَهُۥٓ إِلَّا لِمَنۡ أَذِنَ لَهُۥۚ حَتَّىٰٓ إِذَا فُزِّعَ عَن قُلُوبِهِمۡ قَالُواْ مَاذَا قَالَ رَبُّكُمۡۖ قَالُواْ ٱلۡحَقَّۖ وَهُوَ ٱلۡعَلِيُّ ٱلۡكَبِيرُ",
    "ayah_text_no_diacratic" : "ولا تنفع الشفٰعة عنده الا لمن اذن له حتىٰ اذا فزع عن قلوبهم قالوا ماذا قال ربكم قالوا الحق وهو العلي الكبير",
