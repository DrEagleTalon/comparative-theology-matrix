    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5447",
    "ayah_text" : "يَوۡمَ يُكۡشَفُ عَن سَاقٖ وَيُدۡعَوۡنَ إِلَى ٱلسُّجُودِ فَلَا يَسۡتَطِيعُونَ",
    "ayah_text_no_diacratic" : "يوم يكشف عن ساق ويدعون الى السجود فلا يستطيعون",
    "ayahnumber" : "42",
    "chapter" : "29",
    "hizb" : "56",
    "index" : "5447",
    "page" : "565",
    "surahname" : "سُورَةُ القَلَمِ",
    "surahnumber" : "68",
    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5448",
    "ayah_text" : "خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۖ وَقَدۡ كَانُواْ يُدۡعَوۡنَ إِلَى ٱلسُّجُودِ وَهُمۡ سَٰلِمُونَ",
    "ayah_text_no_diacratic" : "خٰشعة ابصٰرهم ترهقهم ذلة وقد كانوا يدعون الى السجود وهم سٰلمون",
