  }, {
    "@id" : "quran:2729",
    "ayah_text" : "وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ مِن سُلَٰلَةٖ مِّن طِينٖ",
    "ayah_text_no_diacratic" : "ولقد خلقنا الانسٰن من سلٰلة من طين",
