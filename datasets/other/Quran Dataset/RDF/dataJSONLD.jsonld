  }, {
    "@id" : "quran:4929",
    "ayah_text" : "ثُمَّ يُجۡزَىٰهُ ٱلۡجَزَآءَ ٱلۡأَوۡفَىٰ",
    "ayah_text_no_diacratic" : "ثم يجزىٰه الجزاء الاوفىٰ",
