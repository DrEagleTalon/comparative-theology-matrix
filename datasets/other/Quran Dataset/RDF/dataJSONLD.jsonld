  }, {
    "@id" : "quran:1494",
    "ayah_text" : "الٓرۚ كِتَٰبٌ أُحۡكِمَتۡ ءَايَٰتُهُۥ ثُمَّ فُصِّلَتۡ مِن لَّدُنۡ حَكِيمٍ خَبِيرٍ",
    "ayah_text_no_diacratic" : "الر كتٰب احكمت ءايٰته ثم فصلت من لدن حكيم خبير",
    "ayahnumber" : "1",
