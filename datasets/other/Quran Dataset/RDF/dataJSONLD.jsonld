  }, {
    "@id" : "quran:3041",
    "ayah_text" : "كَذَٰلِكَۖ وَأَوۡرَثۡنَٰهَا بَنِيٓ إِسۡرَٰٓءِيلَ",
    "ayah_text_no_diacratic" : "كذٰلك واورثنٰها بني اسرٰءيل",
