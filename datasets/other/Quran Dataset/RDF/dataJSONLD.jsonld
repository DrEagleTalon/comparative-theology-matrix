    "page" : "371",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3083",
    "ayah_text" : "وَلَا صَدِيقٍ حَمِيمٖ",
    "ayah_text_no_diacratic" : "ولا صديق حميم",
