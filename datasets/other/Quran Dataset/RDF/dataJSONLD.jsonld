    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2603",
    "ayah_text" : "وَعَلَّمۡنَٰهُ صَنۡعَةَ لَبُوسٖ لَّكُمۡ لِتُحۡصِنَكُم مِّنۢ بَأۡسِكُمۡۖ فَهَلۡ أَنتُمۡ شَٰكِرُونَ",
    "ayah_text_no_diacratic" : "وعلمنٰه صنعة لبوس لكم لتحصنكم من باسكم فهل انتم شٰكرون",
    "ayahnumber" : "80",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2603",
    "page" : "328",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2604",
    "ayah_text" : "وَلِسُلَيۡمَٰنَ ٱلرِّيحَ عَاصِفَةٗ تَجۡرِي بِأَمۡرِهِۦٓ إِلَى ٱلۡأَرۡضِ ٱلَّتِي بَٰرَكۡنَا فِيهَاۚ وَكُنَّا بِكُلِّ شَيۡءٍ عَٰلِمِينَ",
    "ayah_text_no_diacratic" : "ولسليمٰن الريح عاصفة تجري بامره الى الارض التي بٰركنا فيها وكنا بكل شيء عٰلمين",
    "ayahnumber" : "81",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2604",
    "page" : "328",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2605",
    "ayah_text" : "وَمِنَ ٱلشَّيَٰطِينِ مَن يَغُوصُونَ لَهُۥ وَيَعۡمَلُونَ عَمَلٗا دُونَ ذَٰلِكَۖ وَكُنَّا لَهُمۡ حَٰفِظِينَ",
    "ayah_text_no_diacratic" : "ومن الشيٰطين من يغوصون له ويعملون عملا دون ذٰلك وكنا لهم حٰفظين",
    "ayahnumber" : "82",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2605",
    "page" : "329",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2606",
    "ayah_text" : "۞وَأَيُّوبَ إِذۡ نَادَىٰ رَبَّهُۥٓ أَنِّي مَسَّنِيَ ٱلضُّرُّ وَأَنتَ أَرۡحَمُ ٱلرَّٰحِمِينَ",
    "ayah_text_no_diacratic" : "وايوب اذ نادىٰ ربه اني مسني الضر وانت ارحم الرٰحمين",
    "ayahnumber" : "83",
    "chapter" : "17",
    "hizb" : "33",
    "index" : "2606",
    "page" : "329",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2607",
    "ayah_text" : "فَٱسۡتَجَبۡنَا لَهُۥ فَكَشَفۡنَا مَا بِهِۦ مِن ضُرّٖۖ وَءَاتَيۡنَٰهُ أَهۡلَهُۥ وَمِثۡلَهُم مَّعَهُمۡ رَحۡمَةٗ مِّنۡ عِندِنَا وَذِكۡرَىٰ لِلۡعَٰبِدِينَ",
    "ayah_text_no_diacratic" : "فاستجبنا له فكشفنا ما به من ضر وءاتينٰه اهله ومثلهم معهم رحمة من عندنا وذكرىٰ للعٰبدين",
    "ayahnumber" : "84",
