    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:16",
    "ayah_text" : "إِنَّ ٱلَّذِينَ كَفَرُواْ سَوَآءٌ عَلَيۡهِمۡ ءَأَنذَرۡتَهُمۡ أَمۡ لَمۡ تُنذِرۡهُمۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "ان الذين كفروا سواء عليهم ءانذرتهم ام لم تنذرهم لا يؤمنون",
    "ayahnumber" : "6",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "16",
    "page" : "3",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:160",
    "ayah_text" : "وَمِنۡ حَيۡثُ خَرَجۡتَ فَوَلِّ وَجۡهَكَ شَطۡرَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِۚ وَحَيۡثُ مَا كُنتُمۡ فَوَلُّواْ وُجُوهَكُمۡ شَطۡرَهُۥ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيۡكُمۡ حُجَّةٌ إِلَّا ٱلَّذِينَ ظَلَمُواْ مِنۡهُمۡ فَلَا تَخۡشَوۡهُمۡ وَٱخۡشَوۡنِي وَلِأُتِمَّ نِعۡمَتِي عَلَيۡكُمۡ وَلَعَلَّكُمۡ تَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "ومن حيث خرجت فول وجهك شطر المسجد الحرام وحيث ما كنتم فولوا وجوهكم شطره لئلا يكون للناس عليكم حجة الا الذين ظلموا منهم فلا تخشوهم واخشوني ولاتم نعمتي عليكم ولعلكم تهتدون",
    "ayahnumber" : "150",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "160",
    "page" : "23",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1600",
    "ayah_text" : "خَٰلِدِينَ فِيهَا مَا دَامَتِ ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ إِلَّا مَا شَآءَ رَبُّكَۚ إِنَّ رَبَّكَ فَعَّالٞ لِّمَا يُرِيدُ",
    "ayah_text_no_diacratic" : "خٰلدين فيها ما دامت السمٰوٰت والارض الا ما شاء ربك ان ربك فعال لما يريد",
    "ayahnumber" : "107",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1600",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1601",
    "ayah_text" : "۞وَأَمَّا ٱلَّذِينَ سُعِدُواْ فَفِي ٱلۡجَنَّةِ خَٰلِدِينَ فِيهَا مَا دَامَتِ ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ إِلَّا مَا شَآءَ رَبُّكَۖ عَطَآءً غَيۡرَ مَجۡذُوذٖ",
    "ayah_text_no_diacratic" : "واما الذين سعدوا ففي الجنة خٰلدين فيها ما دامت السمٰوٰت والارض الا ما شاء ربك عطاء غير مجذوذ",
    "ayahnumber" : "108",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1601",
    "page" : "233",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1602",
    "ayah_text" : "فَلَا تَكُ فِي مِرۡيَةٖ مِّمَّا يَعۡبُدُ هَٰٓؤُلَآءِۚ مَا يَعۡبُدُونَ إِلَّا كَمَا يَعۡبُدُ ءَابَآؤُهُم مِّن قَبۡلُۚ وَإِنَّا لَمُوَفُّوهُمۡ نَصِيبَهُمۡ غَيۡرَ مَنقُوصٖ",
    "ayah_text_no_diacratic" : "فلا تك في مرية مما يعبد هٰؤلاء ما يعبدون الا كما يعبد ءاباؤهم من قبل وانا لموفوهم نصيبهم غير منقوص",
    "ayahnumber" : "109",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1602",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1603",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ فَٱخۡتُلِفَ فِيهِۚ وَلَوۡلَا كَلِمَةٞ سَبَقَتۡ مِن رَّبِّكَ لَقُضِيَ بَيۡنَهُمۡۚ وَإِنَّهُمۡ لَفِي شَكّٖ مِّنۡهُ مُرِيبٖ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسى الكتٰب فاختلف فيه ولولا كلمة سبقت من ربك لقضي بينهم وانهم لفي شك منه مريب",
    "ayahnumber" : "110",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1603",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1604",
    "ayah_text" : "وَإِنَّ كُلّٗا لَّمَّا لَيُوَفِّيَنَّهُمۡ رَبُّكَ أَعۡمَٰلَهُمۡۚ إِنَّهُۥ بِمَا يَعۡمَلُونَ خَبِيرٞ",
    "ayah_text_no_diacratic" : "وان كلا لما ليوفينهم ربك اعمٰلهم انه بما يعملون خبير",
    "ayahnumber" : "111",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1604",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1605",
    "ayah_text" : "فَٱسۡتَقِمۡ كَمَآ أُمِرۡتَ وَمَن تَابَ مَعَكَ وَلَا تَطۡغَوۡاْۚ إِنَّهُۥ بِمَا تَعۡمَلُونَ بَصِيرٞ",
    "ayah_text_no_diacratic" : "فاستقم كما امرت ومن تاب معك ولا تطغوا انه بما تعملون بصير",
    "ayahnumber" : "112",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1605",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1606",
    "ayah_text" : "وَلَا تَرۡكَنُوٓاْ إِلَى ٱلَّذِينَ ظَلَمُواْ فَتَمَسَّكُمُ ٱلنَّارُ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِنۡ أَوۡلِيَآءَ ثُمَّ لَا تُنصَرُونَ",
    "ayah_text_no_diacratic" : "ولا تركنوا الى الذين ظلموا فتمسكم النار وما لكم من دون الله من اولياء ثم لا تنصرون",
    "ayahnumber" : "113",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1606",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1607",
    "ayah_text" : "وَأَقِمِ ٱلصَّلَوٰةَ طَرَفَيِ ٱلنَّهَارِ وَزُلَفٗا مِّنَ ٱلَّيۡلِۚ إِنَّ ٱلۡحَسَنَٰتِ يُذۡهِبۡنَ ٱلسَّيِّـَٔاتِۚ ذَٰلِكَ ذِكۡرَىٰ لِلذَّٰكِرِينَ",
    "ayah_text_no_diacratic" : "واقم الصلوٰة طرفي النهار وزلفا من اليل ان الحسنٰت يذهبن السيات ذٰلك ذكرىٰ للذٰكرين",
    "ayahnumber" : "114",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1607",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1608",
    "ayah_text" : "وَٱصۡبِرۡ فَإِنَّ ٱللَّهَ لَا يُضِيعُ أَجۡرَ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "واصبر فان الله لا يضيع اجر المحسنين",
    "ayahnumber" : "115",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1608",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1609",
    "ayah_text" : "فَلَوۡلَا كَانَ مِنَ ٱلۡقُرُونِ مِن قَبۡلِكُمۡ أُوْلُواْ بَقِيَّةٖ يَنۡهَوۡنَ عَنِ ٱلۡفَسَادِ فِي ٱلۡأَرۡضِ إِلَّا قَلِيلٗا مِّمَّنۡ أَنجَيۡنَا مِنۡهُمۡۗ وَٱتَّبَعَ ٱلَّذِينَ ظَلَمُواْ مَآ أُتۡرِفُواْ فِيهِ وَكَانُواْ مُجۡرِمِينَ",
    "ayah_text_no_diacratic" : "فلولا كان من القرون من قبلكم اولوا بقية ينهون عن الفساد في الارض الا قليلا ممن انجينا منهم واتبع الذين ظلموا ما اترفوا فيه وكانوا مجرمين",
    "ayahnumber" : "116",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1609",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:161",
    "ayah_text" : "كَمَآ أَرۡسَلۡنَا فِيكُمۡ رَسُولٗا مِّنكُمۡ يَتۡلُواْ عَلَيۡكُمۡ ءَايَٰتِنَا وَيُزَكِّيكُمۡ وَيُعَلِّمُكُمُ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَيُعَلِّمُكُم مَّا لَمۡ تَكُونُواْ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "كما ارسلنا فيكم رسولا منكم يتلوا عليكم ءايٰتنا ويزكيكم ويعلمكم الكتٰب والحكمة ويعلمكم ما لم تكونوا تعلمون",
    "ayahnumber" : "151",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "161",
    "page" : "23",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1610",
    "ayah_text" : "وَمَا كَانَ رَبُّكَ لِيُهۡلِكَ ٱلۡقُرَىٰ بِظُلۡمٖ وَأَهۡلُهَا مُصۡلِحُونَ",
    "ayah_text_no_diacratic" : "وما كان ربك ليهلك القرىٰ بظلم واهلها مصلحون",
    "ayahnumber" : "117",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1610",
    "page" : "234",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1611",
    "ayah_text" : "وَلَوۡ شَآءَ رَبُّكَ لَجَعَلَ ٱلنَّاسَ أُمَّةٗ وَٰحِدَةٗۖ وَلَا يَزَالُونَ مُخۡتَلِفِينَ",
    "ayah_text_no_diacratic" : "ولو شاء ربك لجعل الناس امة وٰحدة ولا يزالون مختلفين",
    "ayahnumber" : "118",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1611",
    "page" : "235",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1612",
    "ayah_text" : "إِلَّا مَن رَّحِمَ رَبُّكَۚ وَلِذَٰلِكَ خَلَقَهُمۡۗ وَتَمَّتۡ كَلِمَةُ رَبِّكَ لَأَمۡلَأَنَّ جَهَنَّمَ مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "الا من رحم ربك ولذٰلك خلقهم وتمت كلمة ربك لاملان جهنم من الجنة والناس اجمعين",
    "ayahnumber" : "119",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1612",
    "page" : "235",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1613",
    "ayah_text" : "وَكُلّٗا نَّقُصُّ عَلَيۡكَ مِنۡ أَنۢبَآءِ ٱلرُّسُلِ مَا نُثَبِّتُ بِهِۦ فُؤَادَكَۚ وَجَآءَكَ فِي هَٰذِهِ ٱلۡحَقُّ وَمَوۡعِظَةٞ وَذِكۡرَىٰ لِلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وكلا نقص عليك من انباء الرسل ما نثبت به فؤادك وجاءك في هٰذه الحق وموعظة وذكرىٰ للمؤمنين",
    "ayahnumber" : "120",
    "chapter" : "12",
    "hizb" : "23",
    "index" : "1613",
    "page" : "235",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1614",
    "ayah_text" : "وَقُل لِّلَّذِينَ لَا يُؤۡمِنُونَ ٱعۡمَلُواْ عَلَىٰ مَكَانَتِكُمۡ إِنَّا عَٰمِلُونَ",
    "ayah_text_no_diacratic" : "وقل للذين لا يؤمنون اعملوا علىٰ مكانتكم انا عٰملون",
    "ayahnumber" : "121",
    "chapter" : "12",
    "hizb" : "23",
