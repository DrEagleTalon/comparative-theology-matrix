    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:226",
    "ayah_text" : "كُتِبَ عَلَيۡكُمُ ٱلۡقِتَالُ وَهُوَ كُرۡهٞ لَّكُمۡۖ وَعَسَىٰٓ أَن تَكۡرَهُواْ شَيۡـٔٗا وَهُوَ خَيۡرٞ لَّكُمۡۖ وَعَسَىٰٓ أَن تُحِبُّواْ شَيۡـٔٗا وَهُوَ شَرّٞ لَّكُمۡۚ وَٱللَّهُ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "كتب عليكم القتال وهو كره لكم وعسىٰ ان تكرهوا شيا وهو خير لكم وعسىٰ ان تحبوا شيا وهو شر لكم والله يعلم وانتم لا تعلمون",
    "ayahnumber" : "216",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "226",
    "page" : "34",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2260",
    "ayah_text" : "حَتَّىٰٓ إِذَا بَلَغَ مَغۡرِبَ ٱلشَّمۡسِ وَجَدَهَا تَغۡرُبُ فِي عَيۡنٍ حَمِئَةٖ وَوَجَدَ عِندَهَا قَوۡمٗاۖ قُلۡنَا يَٰذَا ٱلۡقَرۡنَيۡنِ إِمَّآ أَن تُعَذِّبَ وَإِمَّآ أَن تَتَّخِذَ فِيهِمۡ حُسۡنٗا",
    "ayah_text_no_diacratic" : "حتىٰ اذا بلغ مغرب الشمس وجدها تغرب في عين حمئة ووجد عندها قوما قلنا يٰذا القرنين اما ان تعذب واما ان تتخذ فيهم حسنا",
    "ayahnumber" : "86",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2260",
    "page" : "303",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2261",
    "ayah_text" : "قَالَ أَمَّا مَن ظَلَمَ فَسَوۡفَ نُعَذِّبُهُۥ ثُمَّ يُرَدُّ إِلَىٰ رَبِّهِۦ فَيُعَذِّبُهُۥ عَذَابٗا نُّكۡرٗا",
    "ayah_text_no_diacratic" : "قال اما من ظلم فسوف نعذبه ثم يرد الىٰ ربه فيعذبه عذابا نكرا",
    "ayahnumber" : "87",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2261",
    "page" : "303",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2262",
    "ayah_text" : "وَأَمَّا مَنۡ ءَامَنَ وَعَمِلَ صَٰلِحٗا فَلَهُۥ جَزَآءً ٱلۡحُسۡنَىٰۖ وَسَنَقُولُ لَهُۥ مِنۡ أَمۡرِنَا يُسۡرٗا",
    "ayah_text_no_diacratic" : "واما من ءامن وعمل صٰلحا فله جزاء الحسنىٰ وسنقول له من امرنا يسرا",
    "ayahnumber" : "88",
