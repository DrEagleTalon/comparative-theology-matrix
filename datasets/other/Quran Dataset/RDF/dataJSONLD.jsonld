  }, {
    "@id" : "quran:1370",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ وَكُونُواْ مَعَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اتقوا الله وكونوا مع الصٰدقين",
