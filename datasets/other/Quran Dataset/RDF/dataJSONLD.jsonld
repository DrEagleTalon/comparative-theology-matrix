    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:728",
    "ayah_text" : "أَفَحُكۡمَ ٱلۡجَٰهِلِيَّةِ يَبۡغُونَۚ وَمَنۡ أَحۡسَنُ مِنَ ٱللَّهِ حُكۡمٗا لِّقَوۡمٖ يُوقِنُونَ",
    "ayah_text_no_diacratic" : "افحكم الجٰهلية يبغون ومن احسن من الله حكما لقوم يوقنون",
