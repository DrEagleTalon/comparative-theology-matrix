  }, {
    "@id" : "quran:4290",
    "ayah_text" : "ٱللَّهُ ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَنۡعَٰمَ لِتَرۡكَبُواْ مِنۡهَا وَمِنۡهَا تَأۡكُلُونَ",
    "ayah_text_no_diacratic" : "الله الذي جعل لكم الانعٰم لتركبوا منها ومنها تاكلون",
    "ayahnumber" : "79",
    "chapter" : "24",
