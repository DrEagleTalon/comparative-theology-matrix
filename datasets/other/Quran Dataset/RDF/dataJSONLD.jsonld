  }, {
    "@id" : "quran:2815",
    "ayah_text" : "وَأَعُوذُ بِكَ رَبِّ أَن يَحۡضُرُونِ",
    "ayah_text_no_diacratic" : "واعوذ بك رب ان يحضرون",
