  }, {
    "@id" : "quran:777",
    "ayah_text" : "مَّا عَلَى ٱلرَّسُولِ إِلَّا ٱلۡبَلَٰغُۗ وَٱللَّهُ يَعۡلَمُ مَا تُبۡدُونَ وَمَا تَكۡتُمُونَ",
    "ayah_text_no_diacratic" : "ما على الرسول الا البلٰغ والله يعلم ما تبدون وما تكتمون",
