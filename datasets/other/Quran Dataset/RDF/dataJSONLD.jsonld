  }, {
    "@id" : "quran:2763",
    "ayah_text" : "إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦ فَٱسۡتَكۡبَرُواْ وَكَانُواْ قَوۡمًا عَالِينَ",
    "ayah_text_no_diacratic" : "الىٰ فرعون وملايه فاستكبروا وكانوا قوما عالين",
    "ayahnumber" : "46",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2763",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2764",
    "ayah_text" : "فَقَالُوٓاْ أَنُؤۡمِنُ لِبَشَرَيۡنِ مِثۡلِنَا وَقَوۡمُهُمَا لَنَا عَٰبِدُونَ",
    "ayah_text_no_diacratic" : "فقالوا انؤمن لبشرين مثلنا وقومهما لنا عٰبدون",
    "ayahnumber" : "47",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2764",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2765",
    "ayah_text" : "فَكَذَّبُوهُمَا فَكَانُواْ مِنَ ٱلۡمُهۡلَكِينَ",
    "ayah_text_no_diacratic" : "فكذبوهما فكانوا من المهلكين",
    "ayahnumber" : "48",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2765",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2766",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ لَعَلَّهُمۡ يَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسى الكتٰب لعلهم يهتدون",
    "ayahnumber" : "49",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2766",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2767",
    "ayah_text" : "وَجَعَلۡنَا ٱبۡنَ مَرۡيَمَ وَأُمَّهُۥٓ ءَايَةٗ وَءَاوَيۡنَٰهُمَآ إِلَىٰ رَبۡوَةٖ ذَاتِ قَرَارٖ وَمَعِينٖ",
    "ayah_text_no_diacratic" : "وجعلنا ابن مريم وامه ءاية وءاوينٰهما الىٰ ربوة ذات قرار ومعين",
    "ayahnumber" : "50",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2767",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2768",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلرُّسُلُ كُلُواْ مِنَ ٱلطَّيِّبَٰتِ وَٱعۡمَلُواْ صَٰلِحًاۖ إِنِّي بِمَا تَعۡمَلُونَ عَلِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الرسل كلوا من الطيبٰت واعملوا صٰلحا اني بما تعملون عليم",
    "ayahnumber" : "51",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2768",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2769",
    "ayah_text" : "وَإِنَّ هَٰذِهِۦٓ أُمَّتُكُمۡ أُمَّةٗ وَٰحِدَةٗ وَأَنَا۠ رَبُّكُمۡ فَٱتَّقُونِ",
    "ayah_text_no_diacratic" : "وان هٰذه امتكم امة وٰحدة وانا ربكم فاتقون",
    "ayahnumber" : "52",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2769",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:277",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَنفِقُواْ مِن طَيِّبَٰتِ مَا كَسَبۡتُمۡ وَمِمَّآ أَخۡرَجۡنَا لَكُم مِّنَ ٱلۡأَرۡضِۖ وَلَا تَيَمَّمُواْ ٱلۡخَبِيثَ مِنۡهُ تُنفِقُونَ وَلَسۡتُم بِـَٔاخِذِيهِ إِلَّآ أَن تُغۡمِضُواْ فِيهِۚ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ غَنِيٌّ حَمِيدٌ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا انفقوا من طيبٰت ما كسبتم ومما اخرجنا لكم من الارض ولا تيمموا الخبيث منه تنفقون ولستم باخذيه الا ان تغمضوا فيه واعلموا ان الله غني حميد",
    "ayahnumber" : "267",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "277",
    "page" : "45",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2770",
    "ayah_text" : "فَتَقَطَّعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡ زُبُرٗاۖ كُلُّ حِزۡبِۭ بِمَا لَدَيۡهِمۡ فَرِحُونَ",
    "ayah_text_no_diacratic" : "فتقطعوا امرهم بينهم زبرا كل حزب بما لديهم فرحون",
    "ayahnumber" : "53",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2770",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2771",
    "ayah_text" : "فَذَرۡهُمۡ فِي غَمۡرَتِهِمۡ حَتَّىٰ حِينٍ",
    "ayah_text_no_diacratic" : "فذرهم في غمرتهم حتىٰ حين",
    "ayahnumber" : "54",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2771",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2772",
    "ayah_text" : "أَيَحۡسَبُونَ أَنَّمَا نُمِدُّهُم بِهِۦ مِن مَّالٖ وَبَنِينَ",
    "ayah_text_no_diacratic" : "ايحسبون انما نمدهم به من مال وبنين",
    "ayahnumber" : "55",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2772",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2773",
    "ayah_text" : "نُسَارِعُ لَهُمۡ فِي ٱلۡخَيۡرَٰتِۚ بَل لَّا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "نسارع لهم في الخيرٰت بل لا يشعرون",
    "ayahnumber" : "56",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2773",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2774",
    "ayah_text" : "إِنَّ ٱلَّذِينَ هُم مِّنۡ خَشۡيَةِ رَبِّهِم مُّشۡفِقُونَ",
    "ayah_text_no_diacratic" : "ان الذين هم من خشية ربهم مشفقون",
    "ayahnumber" : "57",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2774",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2775",
    "ayah_text" : "وَٱلَّذِينَ هُم بِـَٔايَٰتِ رَبِّهِمۡ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "والذين هم بايٰت ربهم يؤمنون",
    "ayahnumber" : "58",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2775",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2776",
    "ayah_text" : "وَٱلَّذِينَ هُم بِرَبِّهِمۡ لَا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "والذين هم بربهم لا يشركون",
    "ayahnumber" : "59",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2776",
    "page" : "345",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2777",
    "ayah_text" : "وَٱلَّذِينَ يُؤۡتُونَ مَآ ءَاتَواْ وَّقُلُوبُهُمۡ وَجِلَةٌ أَنَّهُمۡ إِلَىٰ رَبِّهِمۡ رَٰجِعُونَ",
    "ayah_text_no_diacratic" : "والذين يؤتون ما ءاتوا وقلوبهم وجلة انهم الىٰ ربهم رٰجعون",
    "ayahnumber" : "60",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2777",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2778",
    "ayah_text" : "أُوْلَٰٓئِكَ يُسَٰرِعُونَ فِي ٱلۡخَيۡرَٰتِ وَهُمۡ لَهَا سَٰبِقُونَ",
    "ayah_text_no_diacratic" : "اولٰئك يسٰرعون في الخيرٰت وهم لها سٰبقون",
    "ayahnumber" : "61",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2778",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2779",
    "ayah_text" : "وَلَا نُكَلِّفُ نَفۡسًا إِلَّا وُسۡعَهَاۚ وَلَدَيۡنَا كِتَٰبٞ يَنطِقُ بِٱلۡحَقِّ وَهُمۡ لَا يُظۡلَمُونَ",
    "ayah_text_no_diacratic" : "ولا نكلف نفسا الا وسعها ولدينا كتٰب ينطق بالحق وهم لا يظلمون",
    "ayahnumber" : "62",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2779",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:278",
    "ayah_text" : "ٱلشَّيۡطَٰنُ يَعِدُكُمُ ٱلۡفَقۡرَ وَيَأۡمُرُكُم بِٱلۡفَحۡشَآءِۖ وَٱللَّهُ يَعِدُكُم مَّغۡفِرَةٗ مِّنۡهُ وَفَضۡلٗاۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "الشيطٰن يعدكم الفقر ويامركم بالفحشاء والله يعدكم مغفرة منه وفضلا والله وٰسع عليم",
    "ayahnumber" : "268",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "278",
    "page" : "45",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2780",
    "ayah_text" : "بَلۡ قُلُوبُهُمۡ فِي غَمۡرَةٖ مِّنۡ هَٰذَا وَلَهُمۡ أَعۡمَٰلٞ مِّن دُونِ ذَٰلِكَ هُمۡ لَهَا عَٰمِلُونَ",
    "ayah_text_no_diacratic" : "بل قلوبهم في غمرة من هٰذا ولهم اعمٰل من دون ذٰلك هم لها عٰملون",
    "ayahnumber" : "63",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2780",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2781",
    "ayah_text" : "حَتَّىٰٓ إِذَآ أَخَذۡنَا مُتۡرَفِيهِم بِٱلۡعَذَابِ إِذَا هُمۡ يَجۡـَٔرُونَ",
    "ayah_text_no_diacratic" : "حتىٰ اذا اخذنا مترفيهم بالعذاب اذا هم يجرون",
    "ayahnumber" : "64",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2781",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2782",
    "ayah_text" : "لَا تَجۡـَٔرُواْ ٱلۡيَوۡمَۖ إِنَّكُم مِّنَّا لَا تُنصَرُونَ",
    "ayah_text_no_diacratic" : "لا تجروا اليوم انكم منا لا تنصرون",
    "ayahnumber" : "65",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2782",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2783",
    "ayah_text" : "قَدۡ كَانَتۡ ءَايَٰتِي تُتۡلَىٰ عَلَيۡكُمۡ فَكُنتُمۡ عَلَىٰٓ أَعۡقَٰبِكُمۡ تَنكِصُونَ",
    "ayah_text_no_diacratic" : "قد كانت ءايٰتي تتلىٰ عليكم فكنتم علىٰ اعقٰبكم تنكصون",
    "ayahnumber" : "66",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2783",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2784",
    "ayah_text" : "مُسۡتَكۡبِرِينَ بِهِۦ سَٰمِرٗا تَهۡجُرُونَ",
    "ayah_text_no_diacratic" : "مستكبرين به سٰمرا تهجرون",
    "ayahnumber" : "67",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2784",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2785",
    "ayah_text" : "أَفَلَمۡ يَدَّبَّرُواْ ٱلۡقَوۡلَ أَمۡ جَآءَهُم مَّا لَمۡ يَأۡتِ ءَابَآءَهُمُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "افلم يدبروا القول ام جاءهم ما لم يات ءاباءهم الاولين",
    "ayahnumber" : "68",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2785",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2786",
    "ayah_text" : "أَمۡ لَمۡ يَعۡرِفُواْ رَسُولَهُمۡ فَهُمۡ لَهُۥ مُنكِرُونَ",
    "ayah_text_no_diacratic" : "ام لم يعرفوا رسولهم فهم له منكرون",
    "ayahnumber" : "69",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2786",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2787",
    "ayah_text" : "أَمۡ يَقُولُونَ بِهِۦ جِنَّةُۢۚ بَلۡ جَآءَهُم بِٱلۡحَقِّ وَأَكۡثَرُهُمۡ لِلۡحَقِّ كَٰرِهُونَ",
    "ayah_text_no_diacratic" : "ام يقولون به جنة بل جاءهم بالحق واكثرهم للحق كٰرهون",
    "ayahnumber" : "70",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2787",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2788",
    "ayah_text" : "وَلَوِ ٱتَّبَعَ ٱلۡحَقُّ أَهۡوَآءَهُمۡ لَفَسَدَتِ ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ وَمَن فِيهِنَّۚ بَلۡ أَتَيۡنَٰهُم بِذِكۡرِهِمۡ فَهُمۡ عَن ذِكۡرِهِم مُّعۡرِضُونَ",
    "ayah_text_no_diacratic" : "ولو اتبع الحق اهواءهم لفسدت السمٰوٰت والارض ومن فيهن بل اتينٰهم بذكرهم فهم عن ذكرهم معرضون",
    "ayahnumber" : "71",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2788",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2789",
    "ayah_text" : "أَمۡ تَسۡـَٔلُهُمۡ خَرۡجٗا فَخَرَاجُ رَبِّكَ خَيۡرٞۖ وَهُوَ خَيۡرُ ٱلرَّٰزِقِينَ",
    "ayah_text_no_diacratic" : "ام تسلهم خرجا فخراج ربك خير وهو خير الرٰزقين",
    "ayahnumber" : "72",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2789",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:279",
    "ayah_text" : "يُؤۡتِي ٱلۡحِكۡمَةَ مَن يَشَآءُۚ وَمَن يُؤۡتَ ٱلۡحِكۡمَةَ فَقَدۡ أُوتِيَ خَيۡرٗا كَثِيرٗاۗ وَمَا يَذَّكَّرُ إِلَّآ أُوْلُواْ ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "يؤتي الحكمة من يشاء ومن يؤت الحكمة فقد اوتي خيرا كثيرا وما يذكر الا اولوا الالبٰب",
    "ayahnumber" : "269",
    "chapter" : "3",
    "hizb" : "4",
    "index" : "279",
    "page" : "45",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2790",
    "ayah_text" : "وَإِنَّكَ لَتَدۡعُوهُمۡ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ",
    "ayah_text_no_diacratic" : "وانك لتدعوهم الىٰ صرٰط مستقيم",
    "ayahnumber" : "73",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2790",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2791",
    "ayah_text" : "وَإِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ عَنِ ٱلصِّرَٰطِ لَنَٰكِبُونَ",
    "ayah_text_no_diacratic" : "وان الذين لا يؤمنون بالاخرة عن الصرٰط لنٰكبون",
    "ayahnumber" : "74",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2791",
    "page" : "346",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2792",
    "ayah_text" : "۞وَلَوۡ رَحِمۡنَٰهُمۡ وَكَشَفۡنَا مَا بِهِم مِّن ضُرّٖ لَّلَجُّواْ فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ",
    "ayah_text_no_diacratic" : "ولو رحمنٰهم وكشفنا ما بهم من ضر للجوا في طغيٰنهم يعمهون",
    "ayahnumber" : "75",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2792",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2793",
    "ayah_text" : "وَلَقَدۡ أَخَذۡنَٰهُم بِٱلۡعَذَابِ فَمَا ٱسۡتَكَانُواْ لِرَبِّهِمۡ وَمَا يَتَضَرَّعُونَ",
    "ayah_text_no_diacratic" : "ولقد اخذنٰهم بالعذاب فما استكانوا لربهم وما يتضرعون",
    "ayahnumber" : "76",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2793",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2794",
    "ayah_text" : "حَتَّىٰٓ إِذَا فَتَحۡنَا عَلَيۡهِم بَابٗا ذَا عَذَابٖ شَدِيدٍ إِذَا هُمۡ فِيهِ مُبۡلِسُونَ",
    "ayah_text_no_diacratic" : "حتىٰ اذا فتحنا عليهم بابا ذا عذاب شديد اذا هم فيه مبلسون",
    "ayahnumber" : "77",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2794",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2795",
    "ayah_text" : "وَهُوَ ٱلَّذِيٓ أَنشَأَ لَكُمُ ٱلسَّمۡعَ وَٱلۡأَبۡصَٰرَ وَٱلۡأَفۡـِٔدَةَۚ قَلِيلٗا مَّا تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "وهو الذي انشا لكم السمع والابصٰر والافدة قليلا ما تشكرون",
    "ayahnumber" : "78",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2795",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2796",
    "ayah_text" : "وَهُوَ ٱلَّذِي ذَرَأَكُمۡ فِي ٱلۡأَرۡضِ وَإِلَيۡهِ تُحۡشَرُونَ",
    "ayah_text_no_diacratic" : "وهو الذي ذراكم في الارض واليه تحشرون",
    "ayahnumber" : "79",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2796",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2797",
    "ayah_text" : "وَهُوَ ٱلَّذِي يُحۡيِۦ وَيُمِيتُ وَلَهُ ٱخۡتِلَٰفُ ٱلَّيۡلِ وَٱلنَّهَارِۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "وهو الذي يحي ويميت وله اختلٰف اليل والنهار افلا تعقلون",
    "ayahnumber" : "80",
    "chapter" : "18",
    "hizb" : "34",
    "index" : "2797",
    "page" : "347",
    "surahname" : "سُورَةُ المُؤۡمِنُونَ",
    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2798",
    "ayah_text" : "بَلۡ قَالُواْ مِثۡلَ مَا قَالَ ٱلۡأَوَّلُونَ",
    "ayah_text_no_diacratic" : "بل قالوا مثل ما قال الاولون",
    "ayahnumber" : "81",
    "chapter" : "18",
    "hizb" : "34",
