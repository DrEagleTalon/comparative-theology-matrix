  }, {
    "@id" : "quran:1931",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1931",
    "page" : "267",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1932",
    "ayah_text" : "أَتَىٰٓ أَمۡرُ ٱللَّهِ فَلَا تَسۡتَعۡجِلُوهُۚ سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "اتىٰ امر الله فلا تستعجلوه سبحٰنه وتعٰلىٰ عما يشركون",
    "ayahnumber" : "1",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1932",
    "page" : "267",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1933",
    "ayah_text" : "يُنَزِّلُ ٱلۡمَلَٰٓئِكَةَ بِٱلرُّوحِ مِنۡ أَمۡرِهِۦ عَلَىٰ مَن يَشَآءُ مِنۡ عِبَادِهِۦٓ أَنۡ أَنذِرُوٓاْ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱتَّقُونِ",
    "ayah_text_no_diacratic" : "ينزل الملٰئكة بالروح من امره علىٰ من يشاء من عباده ان انذروا انه لا الٰه الا انا فاتقون",
    "ayahnumber" : "2",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1933",
    "page" : "267",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1934",
    "ayah_text" : "خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۚ تَعَٰلَىٰ عَمَّا يُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "خلق السمٰوٰت والارض بالحق تعٰلىٰ عما يشركون",
    "ayahnumber" : "3",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1934",
    "page" : "267",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1935",
    "ayah_text" : "خَلَقَ ٱلۡإِنسَٰنَ مِن نُّطۡفَةٖ فَإِذَا هُوَ خَصِيمٞ مُّبِينٞ",
    "ayah_text_no_diacratic" : "خلق الانسٰن من نطفة فاذا هو خصيم مبين",
    "ayahnumber" : "4",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1935",
    "page" : "267",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1936",
    "ayah_text" : "وَٱلۡأَنۡعَٰمَ خَلَقَهَاۖ لَكُمۡ فِيهَا دِفۡءٞ وَمَنَٰفِعُ وَمِنۡهَا تَأۡكُلُونَ",
    "ayah_text_no_diacratic" : "والانعٰم خلقها لكم فيها دفء ومنٰفع ومنها تاكلون",
    "ayahnumber" : "5",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1936",
    "page" : "267",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1937",
    "ayah_text" : "وَلَكُمۡ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسۡرَحُونَ",
    "ayah_text_no_diacratic" : "ولكم فيها جمال حين تريحون وحين تسرحون",
    "ayahnumber" : "6",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1937",
    "page" : "267",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1938",
    "ayah_text" : "وَتَحۡمِلُ أَثۡقَالَكُمۡ إِلَىٰ بَلَدٖ لَّمۡ تَكُونُواْ بَٰلِغِيهِ إِلَّا بِشِقِّ ٱلۡأَنفُسِۚ إِنَّ رَبَّكُمۡ لَرَءُوفٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "وتحمل اثقالكم الىٰ بلد لم تكونوا بٰلغيه الا بشق الانفس ان ربكم لرءوف رحيم",
    "ayahnumber" : "7",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1938",
    "page" : "268",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1939",
    "ayah_text" : "وَٱلۡخَيۡلَ وَٱلۡبِغَالَ وَٱلۡحَمِيرَ لِتَرۡكَبُوهَا وَزِينَةٗۚ وَيَخۡلُقُ مَا لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "والخيل والبغال والحمير لتركبوها وزينة ويخلق ما لا تعلمون",
    "ayahnumber" : "8",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1939",
    "page" : "268",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:194",
    "ayah_text" : "أَيَّامٗا مَّعۡدُودَٰتٖۚ فَمَن كَانَ مِنكُم مَّرِيضًا أَوۡ عَلَىٰ سَفَرٖ فَعِدَّةٞ مِّنۡ أَيَّامٍ أُخَرَۚ وَعَلَى ٱلَّذِينَ يُطِيقُونَهُۥ فِدۡيَةٞ طَعَامُ مِسۡكِينٖۖ فَمَن تَطَوَّعَ خَيۡرٗا فَهُوَ خَيۡرٞ لَّهُۥۚ وَأَن تَصُومُواْ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "اياما معدودٰت فمن كان منكم مريضا او علىٰ سفر فعدة من ايام اخر وعلى الذين يطيقونه فدية طعام مسكين فمن تطوع خيرا فهو خير له وان تصوموا خير لكم ان كنتم تعلمون",
    "ayahnumber" : "184",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "194",
    "page" : "28",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1940",
    "ayah_text" : "وَعَلَى ٱللَّهِ قَصۡدُ ٱلسَّبِيلِ وَمِنۡهَا جَآئِرٞۚ وَلَوۡ شَآءَ لَهَدَىٰكُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "وعلى الله قصد السبيل ومنها جائر ولو شاء لهدىٰكم اجمعين",
    "ayahnumber" : "9",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1940",
    "page" : "268",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1941",
    "ayah_text" : "هُوَ ٱلَّذِيٓ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗۖ لَّكُم مِّنۡهُ شَرَابٞ وَمِنۡهُ شَجَرٞ فِيهِ تُسِيمُونَ",
    "ayah_text_no_diacratic" : "هو الذي انزل من السماء ماء لكم منه شراب ومنه شجر فيه تسيمون",
    "ayahnumber" : "10",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1941",
    "page" : "268",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1942",
    "ayah_text" : "يُنۢبِتُ لَكُم بِهِ ٱلزَّرۡعَ وَٱلزَّيۡتُونَ وَٱلنَّخِيلَ وَٱلۡأَعۡنَٰبَ وَمِن كُلِّ ٱلثَّمَرَٰتِۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "ينبت لكم به الزرع والزيتون والنخيل والاعنٰب ومن كل الثمرٰت ان في ذٰلك لاية لقوم يتفكرون",
    "ayahnumber" : "11",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1942",
    "page" : "268",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1943",
    "ayah_text" : "وَسَخَّرَ لَكُمُ ٱلَّيۡلَ وَٱلنَّهَارَ وَٱلشَّمۡسَ وَٱلۡقَمَرَۖ وَٱلنُّجُومُ مُسَخَّرَٰتُۢ بِأَمۡرِهِۦٓۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "وسخر لكم اليل والنهار والشمس والقمر والنجوم مسخرٰت بامره ان في ذٰلك لايٰت لقوم يعقلون",
    "ayahnumber" : "12",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1943",
    "page" : "268",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1944",
    "ayah_text" : "وَمَا ذَرَأَ لَكُمۡ فِي ٱلۡأَرۡضِ مُخۡتَلِفًا أَلۡوَٰنُهُۥٓۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّقَوۡمٖ يَذَّكَّرُونَ",
    "ayah_text_no_diacratic" : "وما ذرا لكم في الارض مختلفا الوٰنه ان في ذٰلك لاية لقوم يذكرون",
    "ayahnumber" : "13",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1944",
    "page" : "268",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1945",
    "ayah_text" : "وَهُوَ ٱلَّذِي سَخَّرَ ٱلۡبَحۡرَ لِتَأۡكُلُواْ مِنۡهُ لَحۡمٗا طَرِيّٗا وَتَسۡتَخۡرِجُواْ مِنۡهُ حِلۡيَةٗ تَلۡبَسُونَهَاۖ وَتَرَى ٱلۡفُلۡكَ مَوَاخِرَ فِيهِ وَلِتَبۡتَغُواْ مِن فَضۡلِهِۦ وَلَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "وهو الذي سخر البحر لتاكلوا منه لحما طريا وتستخرجوا منه حلية تلبسونها وترى الفلك مواخر فيه ولتبتغوا من فضله ولعلكم تشكرون",
    "ayahnumber" : "14",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1945",
    "page" : "268",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1946",
    "ayah_text" : "وَأَلۡقَىٰ فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِكُمۡ وَأَنۡهَٰرٗا وَسُبُلٗا لَّعَلَّكُمۡ تَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "والقىٰ في الارض روٰسي ان تميد بكم وانهٰرا وسبلا لعلكم تهتدون",
    "ayahnumber" : "15",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1946",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1947",
    "ayah_text" : "وَعَلَٰمَٰتٖۚ وَبِٱلنَّجۡمِ هُمۡ يَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "وعلٰمٰت وبالنجم هم يهتدون",
    "ayahnumber" : "16",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1947",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1948",
    "ayah_text" : "أَفَمَن يَخۡلُقُ كَمَن لَّا يَخۡلُقُۚ أَفَلَا تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "افمن يخلق كمن لا يخلق افلا تذكرون",
    "ayahnumber" : "17",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1948",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1949",
    "ayah_text" : "وَإِن تَعُدُّواْ نِعۡمَةَ ٱللَّهِ لَا تُحۡصُوهَآۗ إِنَّ ٱللَّهَ لَغَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "وان تعدوا نعمة الله لا تحصوها ان الله لغفور رحيم",
    "ayahnumber" : "18",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1949",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:195",
    "ayah_text" : "شَهۡرُ رَمَضَانَ ٱلَّذِيٓ أُنزِلَ فِيهِ ٱلۡقُرۡءَانُ هُدٗى لِّلنَّاسِ وَبَيِّنَٰتٖ مِّنَ ٱلۡهُدَىٰ وَٱلۡفُرۡقَانِۚ فَمَن شَهِدَ مِنكُمُ ٱلشَّهۡرَ فَلۡيَصُمۡهُۖ وَمَن كَانَ مَرِيضًا أَوۡ عَلَىٰ سَفَرٖ فَعِدَّةٞ مِّنۡ أَيَّامٍ أُخَرَۗ يُرِيدُ ٱللَّهُ بِكُمُ ٱلۡيُسۡرَ وَلَا يُرِيدُ بِكُمُ ٱلۡعُسۡرَ وَلِتُكۡمِلُواْ ٱلۡعِدَّةَ وَلِتُكَبِّرُواْ ٱللَّهَ عَلَىٰ مَا هَدَىٰكُمۡ وَلَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "شهر رمضان الذي انزل فيه القرءان هدى للناس وبينٰت من الهدىٰ والفرقان فمن شهد منكم الشهر فليصمه ومن كان مريضا او علىٰ سفر فعدة من ايام اخر يريد الله بكم اليسر ولا يريد بكم العسر ولتكملوا العدة ولتكبروا الله علىٰ ما هدىٰكم ولعلكم تشكرون",
    "ayahnumber" : "185",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "195",
    "page" : "28",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1950",
    "ayah_text" : "وَٱللَّهُ يَعۡلَمُ مَا تُسِرُّونَ وَمَا تُعۡلِنُونَ",
    "ayah_text_no_diacratic" : "والله يعلم ما تسرون وما تعلنون",
    "ayahnumber" : "19",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1950",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1951",
    "ayah_text" : "وَٱلَّذِينَ يَدۡعُونَ مِن دُونِ ٱللَّهِ لَا يَخۡلُقُونَ شَيۡـٔٗا وَهُمۡ يُخۡلَقُونَ",
    "ayah_text_no_diacratic" : "والذين يدعون من دون الله لا يخلقون شيا وهم يخلقون",
    "ayahnumber" : "20",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1951",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1952",
    "ayah_text" : "أَمۡوَٰتٌ غَيۡرُ أَحۡيَآءٖۖ وَمَا يَشۡعُرُونَ أَيَّانَ يُبۡعَثُونَ",
    "ayah_text_no_diacratic" : "اموٰت غير احياء وما يشعرون ايان يبعثون",
    "ayahnumber" : "21",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1952",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1953",
    "ayah_text" : "إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۚ فَٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ قُلُوبُهُم مُّنكِرَةٞ وَهُم مُّسۡتَكۡبِرُونَ",
    "ayah_text_no_diacratic" : "الٰهكم الٰه وٰحد فالذين لا يؤمنون بالاخرة قلوبهم منكرة وهم مستكبرون",
    "ayahnumber" : "22",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1953",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1954",
    "ayah_text" : "لَا جَرَمَ أَنَّ ٱللَّهَ يَعۡلَمُ مَا يُسِرُّونَ وَمَا يُعۡلِنُونَۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡمُسۡتَكۡبِرِينَ",
    "ayah_text_no_diacratic" : "لا جرم ان الله يعلم ما يسرون وما يعلنون انه لا يحب المستكبرين",
    "ayahnumber" : "23",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1954",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1955",
    "ayah_text" : "وَإِذَا قِيلَ لَهُم مَّاذَآ أَنزَلَ رَبُّكُمۡ قَالُوٓاْ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "واذا قيل لهم ماذا انزل ربكم قالوا اسٰطير الاولين",
    "ayahnumber" : "24",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1955",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1956",
    "ayah_text" : "لِيَحۡمِلُوٓاْ أَوۡزَارَهُمۡ كَامِلَةٗ يَوۡمَ ٱلۡقِيَٰمَةِ وَمِنۡ أَوۡزَارِ ٱلَّذِينَ يُضِلُّونَهُم بِغَيۡرِ عِلۡمٍۗ أَلَا سَآءَ مَا يَزِرُونَ",
    "ayah_text_no_diacratic" : "ليحملوا اوزارهم كاملة يوم القيٰمة ومن اوزار الذين يضلونهم بغير علم الا ساء ما يزرون",
    "ayahnumber" : "25",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1956",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1957",
    "ayah_text" : "قَدۡ مَكَرَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَأَتَى ٱللَّهُ بُنۡيَٰنَهُم مِّنَ ٱلۡقَوَاعِدِ فَخَرَّ عَلَيۡهِمُ ٱلسَّقۡفُ مِن فَوۡقِهِمۡ وَأَتَىٰهُمُ ٱلۡعَذَابُ مِنۡ حَيۡثُ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "قد مكر الذين من قبلهم فاتى الله بنيٰنهم من القواعد فخر عليهم السقف من فوقهم واتىٰهم العذاب من حيث لا يشعرون",
    "ayahnumber" : "26",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1957",
    "page" : "269",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1958",
    "ayah_text" : "ثُمَّ يَوۡمَ ٱلۡقِيَٰمَةِ يُخۡزِيهِمۡ وَيَقُولُ أَيۡنَ شُرَكَآءِيَ ٱلَّذِينَ كُنتُمۡ تُشَٰٓقُّونَ فِيهِمۡۚ قَالَ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ إِنَّ ٱلۡخِزۡيَ ٱلۡيَوۡمَ وَٱلسُّوٓءَ عَلَى ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ثم يوم القيٰمة يخزيهم ويقول اين شركاءي الذين كنتم تشٰقون فيهم قال الذين اوتوا العلم ان الخزي اليوم والسوء على الكٰفرين",
    "ayahnumber" : "27",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1958",
    "page" : "270",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1959",
    "ayah_text" : "ٱلَّذِينَ تَتَوَفَّىٰهُمُ ٱلۡمَلَٰٓئِكَةُ ظَالِمِيٓ أَنفُسِهِمۡۖ فَأَلۡقَوُاْ ٱلسَّلَمَ مَا كُنَّا نَعۡمَلُ مِن سُوٓءِۭۚ بَلَىٰٓۚ إِنَّ ٱللَّهَ عَلِيمُۢ بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "الذين تتوفىٰهم الملٰئكة ظالمي انفسهم فالقوا السلم ما كنا نعمل من سوء بلىٰ ان الله عليم بما كنتم تعملون",
    "ayahnumber" : "28",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1959",
    "page" : "270",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:196",
    "ayah_text" : "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌۖ أُجِيبُ دَعۡوَةَ ٱلدَّاعِ إِذَا دَعَانِۖ فَلۡيَسۡتَجِيبُواْ لِي وَلۡيُؤۡمِنُواْ بِي لَعَلَّهُمۡ يَرۡشُدُونَ",
    "ayah_text_no_diacratic" : "واذا سالك عبادي عني فاني قريب اجيب دعوة الداع اذا دعان فليستجيبوا لي وليؤمنوا بي لعلهم يرشدون",
    "ayahnumber" : "186",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "196",
    "page" : "28",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1960",
    "ayah_text" : "فَٱدۡخُلُوٓاْ أَبۡوَٰبَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۖ فَلَبِئۡسَ مَثۡوَى ٱلۡمُتَكَبِّرِينَ",
    "ayah_text_no_diacratic" : "فادخلوا ابوٰب جهنم خٰلدين فيها فلبئس مثوى المتكبرين",
    "ayahnumber" : "29",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1960",
    "page" : "270",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1961",
    "ayah_text" : "۞وَقِيلَ لِلَّذِينَ ٱتَّقَوۡاْ مَاذَآ أَنزَلَ رَبُّكُمۡۚ قَالُواْ خَيۡرٗاۗ لِّلَّذِينَ أَحۡسَنُواْ فِي هَٰذِهِ ٱلدُّنۡيَا حَسَنَةٞۚ وَلَدَارُ ٱلۡأٓخِرَةِ خَيۡرٞۚ وَلَنِعۡمَ دَارُ ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "وقيل للذين اتقوا ماذا انزل ربكم قالوا خيرا للذين احسنوا في هٰذه الدنيا حسنة ولدار الاخرة خير ولنعم دار المتقين",
    "ayahnumber" : "30",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1961",
    "page" : "270",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1962",
    "ayah_text" : "جَنَّٰتُ عَدۡنٖ يَدۡخُلُونَهَا تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ لَهُمۡ فِيهَا مَا يَشَآءُونَۚ كَذَٰلِكَ يَجۡزِي ٱللَّهُ ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "جنٰت عدن يدخلونها تجري من تحتها الانهٰر لهم فيها ما يشاءون كذٰلك يجزي الله المتقين",
    "ayahnumber" : "31",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1962",
    "page" : "270",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1963",
    "ayah_text" : "ٱلَّذِينَ تَتَوَفَّىٰهُمُ ٱلۡمَلَٰٓئِكَةُ طَيِّبِينَ يَقُولُونَ سَلَٰمٌ عَلَيۡكُمُ ٱدۡخُلُواْ ٱلۡجَنَّةَ بِمَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "الذين تتوفىٰهم الملٰئكة طيبين يقولون سلٰم عليكم ادخلوا الجنة بما كنتم تعملون",
    "ayahnumber" : "32",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1963",
    "page" : "270",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1964",
    "ayah_text" : "هَلۡ يَنظُرُونَ إِلَّآ أَن تَأۡتِيَهُمُ ٱلۡمَلَٰٓئِكَةُ أَوۡ يَأۡتِيَ أَمۡرُ رَبِّكَۚ كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبۡلِهِمۡۚ وَمَا ظَلَمَهُمُ ٱللَّهُ وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ",
    "ayah_text_no_diacratic" : "هل ينظرون الا ان تاتيهم الملٰئكة او ياتي امر ربك كذٰلك فعل الذين من قبلهم وما ظلمهم الله ولٰكن كانوا انفسهم يظلمون",
    "ayahnumber" : "33",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1964",
    "page" : "270",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1965",
    "ayah_text" : "فَأَصَابَهُمۡ سَيِّـَٔاتُ مَا عَمِلُواْ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "فاصابهم سيات ما عملوا وحاق بهم ما كانوا به يستهزءون",
    "ayahnumber" : "34",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1965",
    "page" : "270",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1966",
    "ayah_text" : "وَقَالَ ٱلَّذِينَ أَشۡرَكُواْ لَوۡ شَآءَ ٱللَّهُ مَا عَبَدۡنَا مِن دُونِهِۦ مِن شَيۡءٖ نَّحۡنُ وَلَآ ءَابَآؤُنَا وَلَا حَرَّمۡنَا مِن دُونِهِۦ مِن شَيۡءٖۚ كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبۡلِهِمۡۚ فَهَلۡ عَلَى ٱلرُّسُلِ إِلَّا ٱلۡبَلَٰغُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "وقال الذين اشركوا لو شاء الله ما عبدنا من دونه من شيء نحن ولا ءاباؤنا ولا حرمنا من دونه من شيء كذٰلك فعل الذين من قبلهم فهل على الرسل الا البلٰغ المبين",
    "ayahnumber" : "35",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1966",
    "page" : "271",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1967",
    "ayah_text" : "وَلَقَدۡ بَعَثۡنَا فِي كُلِّ أُمَّةٖ رَّسُولًا أَنِ ٱعۡبُدُواْ ٱللَّهَ وَٱجۡتَنِبُواْ ٱلطَّٰغُوتَۖ فَمِنۡهُم مَّنۡ هَدَى ٱللَّهُ وَمِنۡهُم مَّنۡ حَقَّتۡ عَلَيۡهِ ٱلضَّلَٰلَةُۚ فَسِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُكَذِّبِينَ",
    "ayah_text_no_diacratic" : "ولقد بعثنا في كل امة رسولا ان اعبدوا الله واجتنبوا الطٰغوت فمنهم من هدى الله ومنهم من حقت عليه الضلٰلة فسيروا في الارض فانظروا كيف كان عٰقبة المكذبين",
    "ayahnumber" : "36",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1967",
    "page" : "271",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1968",
    "ayah_text" : "إِن تَحۡرِصۡ عَلَىٰ هُدَىٰهُمۡ فَإِنَّ ٱللَّهَ لَا يَهۡدِي مَن يُضِلُّۖ وَمَا لَهُم مِّن نَّٰصِرِينَ",
    "ayah_text_no_diacratic" : "ان تحرص علىٰ هدىٰهم فان الله لا يهدي من يضل وما لهم من نٰصرين",
    "ayahnumber" : "37",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1968",
    "page" : "271",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1969",
    "ayah_text" : "وَأَقۡسَمُواْ بِٱللَّهِ جَهۡدَ أَيۡمَٰنِهِمۡ لَا يَبۡعَثُ ٱللَّهُ مَن يَمُوتُۚ بَلَىٰ وَعۡدًا عَلَيۡهِ حَقّٗا وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "واقسموا بالله جهد ايمٰنهم لا يبعث الله من يموت بلىٰ وعدا عليه حقا ولٰكن اكثر الناس لا يعلمون",
    "ayahnumber" : "38",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1969",
    "page" : "271",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:197",
    "ayah_text" : "أُحِلَّ لَكُمۡ لَيۡلَةَ ٱلصِّيَامِ ٱلرَّفَثُ إِلَىٰ نِسَآئِكُمۡۚ هُنَّ لِبَاسٞ لَّكُمۡ وَأَنتُمۡ لِبَاسٞ لَّهُنَّۗ عَلِمَ ٱللَّهُ أَنَّكُمۡ كُنتُمۡ تَخۡتَانُونَ أَنفُسَكُمۡ فَتَابَ عَلَيۡكُمۡ وَعَفَا عَنكُمۡۖ فَٱلۡـَٰٔنَ بَٰشِرُوهُنَّ وَٱبۡتَغُواْ مَا كَتَبَ ٱللَّهُ لَكُمۡۚ وَكُلُواْ وَٱشۡرَبُواْ حَتَّىٰ يَتَبَيَّنَ لَكُمُ ٱلۡخَيۡطُ ٱلۡأَبۡيَضُ مِنَ ٱلۡخَيۡطِ ٱلۡأَسۡوَدِ مِنَ ٱلۡفَجۡرِۖ ثُمَّ أَتِمُّواْ ٱلصِّيَامَ إِلَى ٱلَّيۡلِۚ وَلَا تُبَٰشِرُوهُنَّ وَأَنتُمۡ عَٰكِفُونَ فِي ٱلۡمَسَٰجِدِۗ تِلۡكَ حُدُودُ ٱللَّهِ فَلَا تَقۡرَبُوهَاۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ ءَايَٰتِهِۦ لِلنَّاسِ لَعَلَّهُمۡ يَتَّقُونَ",
    "ayah_text_no_diacratic" : "احل لكم ليلة الصيام الرفث الىٰ نسائكم هن لباس لكم وانتم لباس لهن علم الله انكم كنتم تختانون انفسكم فتاب عليكم وعفا عنكم فالٰن بٰشروهن وابتغوا ما كتب الله لكم وكلوا واشربوا حتىٰ يتبين لكم الخيط الابيض من الخيط الاسود من الفجر ثم اتموا الصيام الى اليل ولا تبٰشروهن وانتم عٰكفون في المسٰجد تلك حدود الله فلا تقربوها كذٰلك يبين الله ءايٰته للناس لعلهم يتقون",
    "ayahnumber" : "187",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "197",
    "page" : "29",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1970",
    "ayah_text" : "لِيُبَيِّنَ لَهُمُ ٱلَّذِي يَخۡتَلِفُونَ فِيهِ وَلِيَعۡلَمَ ٱلَّذِينَ كَفَرُوٓاْ أَنَّهُمۡ كَانُواْ كَٰذِبِينَ",
    "ayah_text_no_diacratic" : "ليبين لهم الذي يختلفون فيه وليعلم الذين كفروا انهم كانوا كٰذبين",
    "ayahnumber" : "39",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1970",
    "page" : "271",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1971",
    "ayah_text" : "إِنَّمَا قَوۡلُنَا لِشَيۡءٍ إِذَآ أَرَدۡنَٰهُ أَن نَّقُولَ لَهُۥ كُن فَيَكُونُ",
    "ayah_text_no_diacratic" : "انما قولنا لشيء اذا اردنٰه ان نقول له كن فيكون",
    "ayahnumber" : "40",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1971",
    "page" : "271",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1972",
    "ayah_text" : "وَٱلَّذِينَ هَاجَرُواْ فِي ٱللَّهِ مِنۢ بَعۡدِ مَا ظُلِمُواْ لَنُبَوِّئَنَّهُمۡ فِي ٱلدُّنۡيَا حَسَنَةٗۖ وَلَأَجۡرُ ٱلۡأٓخِرَةِ أَكۡبَرُۚ لَوۡ كَانُواْ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "والذين هاجروا في الله من بعد ما ظلموا لنبوئنهم في الدنيا حسنة ولاجر الاخرة اكبر لو كانوا يعلمون",
    "ayahnumber" : "41",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1972",
    "page" : "271",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1973",
    "ayah_text" : "ٱلَّذِينَ صَبَرُواْ وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ",
    "ayah_text_no_diacratic" : "الذين صبروا وعلىٰ ربهم يتوكلون",
    "ayahnumber" : "42",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1973",
    "page" : "271",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1974",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَا مِن قَبۡلِكَ إِلَّا رِجَالٗا نُّوحِيٓ إِلَيۡهِمۡۖ فَسۡـَٔلُوٓاْ أَهۡلَ ٱلذِّكۡرِ إِن كُنتُمۡ لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وما ارسلنا من قبلك الا رجالا نوحي اليهم فسلوا اهل الذكر ان كنتم لا تعلمون",
    "ayahnumber" : "43",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1974",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1975",
    "ayah_text" : "بِٱلۡبَيِّنَٰتِ وَٱلزُّبُرِۗ وَأَنزَلۡنَآ إِلَيۡكَ ٱلذِّكۡرَ لِتُبَيِّنَ لِلنَّاسِ مَا نُزِّلَ إِلَيۡهِمۡ وَلَعَلَّهُمۡ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "بالبينٰت والزبر وانزلنا اليك الذكر لتبين للناس ما نزل اليهم ولعلهم يتفكرون",
    "ayahnumber" : "44",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1975",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1976",
    "ayah_text" : "أَفَأَمِنَ ٱلَّذِينَ مَكَرُواْ ٱلسَّيِّـَٔاتِ أَن يَخۡسِفَ ٱللَّهُ بِهِمُ ٱلۡأَرۡضَ أَوۡ يَأۡتِيَهُمُ ٱلۡعَذَابُ مِنۡ حَيۡثُ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "افامن الذين مكروا السيات ان يخسف الله بهم الارض او ياتيهم العذاب من حيث لا يشعرون",
    "ayahnumber" : "45",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1976",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1977",
    "ayah_text" : "أَوۡ يَأۡخُذَهُمۡ فِي تَقَلُّبِهِمۡ فَمَا هُم بِمُعۡجِزِينَ",
    "ayah_text_no_diacratic" : "او ياخذهم في تقلبهم فما هم بمعجزين",
    "ayahnumber" : "46",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "1977",
    "page" : "272",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:1978",
    "ayah_text" : "أَوۡ يَأۡخُذَهُمۡ عَلَىٰ تَخَوُّفٖ فَإِنَّ رَبَّكُمۡ لَرَءُوفٞ رَّحِيمٌ",
    "ayah_text_no_diacratic" : "او ياخذهم علىٰ تخوف فان ربكم لرءوف رحيم",
    "ayahnumber" : "47",
