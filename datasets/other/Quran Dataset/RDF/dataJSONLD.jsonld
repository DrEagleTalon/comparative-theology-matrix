    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4881",
    "ayah_text" : "وَإِن يَرَوۡاْ كِسۡفٗا مِّنَ ٱلسَّمَآءِ سَاقِطٗا يَقُولُواْ سَحَابٞ مَّرۡكُومٞ",
    "ayah_text_no_diacratic" : "وان يروا كسفا من السماء ساقطا يقولوا سحاب مركوم",
    "ayahnumber" : "44",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4881",
    "page" : "525",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4882",
    "ayah_text" : "فَذَرۡهُمۡ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي فِيهِ يُصۡعَقُونَ",
    "ayah_text_no_diacratic" : "فذرهم حتىٰ يلٰقوا يومهم الذي فيه يصعقون",
    "ayahnumber" : "45",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4882",
    "page" : "525",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4883",
    "ayah_text" : "يَوۡمَ لَا يُغۡنِي عَنۡهُمۡ كَيۡدُهُمۡ شَيۡـٔٗا وَلَا هُمۡ يُنصَرُونَ",
    "ayah_text_no_diacratic" : "يوم لا يغني عنهم كيدهم شيا ولا هم ينصرون",
    "ayahnumber" : "46",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4883",
    "page" : "525",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4884",
    "ayah_text" : "وَإِنَّ لِلَّذِينَ ظَلَمُواْ عَذَابٗا دُونَ ذَٰلِكَ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وان للذين ظلموا عذابا دون ذٰلك ولٰكن اكثرهم لا يعلمون",
    "ayahnumber" : "47",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4884",
    "page" : "525",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4885",
    "ayah_text" : "وَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ فَإِنَّكَ بِأَعۡيُنِنَاۖ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ حِينَ تَقُومُ",
    "ayah_text_no_diacratic" : "واصبر لحكم ربك فانك باعيننا وسبح بحمد ربك حين تقوم",
