  }, {
    "@id" : "quran:2759",
    "ayah_text" : "ثُمَّ أَنشَأۡنَا مِنۢ بَعۡدِهِمۡ قُرُونًا ءَاخَرِينَ",
    "ayah_text_no_diacratic" : "ثم انشانا من بعدهم قرونا ءاخرين",
