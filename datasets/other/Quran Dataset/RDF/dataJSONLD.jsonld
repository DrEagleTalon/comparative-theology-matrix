    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1375",
    "ayah_text" : "وَإِذَا مَآ أُنزِلَتۡ سُورَةٞ فَمِنۡهُم مَّن يَقُولُ أَيُّكُمۡ زَادَتۡهُ هَٰذِهِۦٓ إِيمَٰنٗاۚ فَأَمَّا ٱلَّذِينَ ءَامَنُواْ فَزَادَتۡهُمۡ إِيمَٰنٗا وَهُمۡ يَسۡتَبۡشِرُونَ",
    "ayah_text_no_diacratic" : "واذا ما انزلت سورة فمنهم من يقول ايكم زادته هٰذه ايمٰنا فاما الذين ءامنوا فزادتهم ايمٰنا وهم يستبشرون",
    "ayahnumber" : "124",
    "chapter" : "11",
    "hizb" : "20",
    "index" : "1375",
    "page" : "207",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1376",
    "ayah_text" : "وَأَمَّا ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ فَزَادَتۡهُمۡ رِجۡسًا إِلَىٰ رِجۡسِهِمۡ وَمَاتُواْ وَهُمۡ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "واما الذين في قلوبهم مرض فزادتهم رجسا الىٰ رجسهم وماتوا وهم كٰفرون",
    "ayahnumber" : "125",
    "chapter" : "11",
    "hizb" : "20",
