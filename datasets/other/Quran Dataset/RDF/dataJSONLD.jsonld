    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3187",
    "ayah_text" : "أَفَرَءَيۡتَ إِن مَّتَّعۡنَٰهُمۡ سِنِينَ",
    "ayah_text_no_diacratic" : "افرءيت ان متعنٰهم سنين",
