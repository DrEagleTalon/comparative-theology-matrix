    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3047",
    "ayah_text" : "وَأَنجَيۡنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "وانجينا موسىٰ ومن معه اجمعين",
    "ayahnumber" : "65",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3047",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3048",
    "ayah_text" : "ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ",
    "ayah_text_no_diacratic" : "ثم اغرقنا الاخرين",
    "ayahnumber" : "66",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3048",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3049",
    "ayah_text" : "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ان في ذٰلك لاية وما كان اكثرهم مؤمنين",
    "ayahnumber" : "67",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3049",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:305",
    "ayah_text" : "هُوَ ٱلَّذِيٓ أَنزَلَ عَلَيۡكَ ٱلۡكِتَٰبَ مِنۡهُ ءَايَٰتٞ مُّحۡكَمَٰتٌ هُنَّ أُمُّ ٱلۡكِتَٰبِ وَأُخَرُ مُتَشَٰبِهَٰتٞۖ فَأَمَّا ٱلَّذِينَ فِي قُلُوبِهِمۡ زَيۡغٞ فَيَتَّبِعُونَ مَا تَشَٰبَهَ مِنۡهُ ٱبۡتِغَآءَ ٱلۡفِتۡنَةِ وَٱبۡتِغَآءَ تَأۡوِيلِهِۦۖ وَمَا يَعۡلَمُ تَأۡوِيلَهُۥٓ إِلَّا ٱللَّهُۗ وَٱلرَّٰسِخُونَ فِي ٱلۡعِلۡمِ يَقُولُونَ ءَامَنَّا بِهِۦ كُلّٞ مِّنۡ عِندِ رَبِّنَاۗ وَمَا يَذَّكَّرُ إِلَّآ أُوْلُواْ ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "هو الذي انزل عليك الكتٰب منه ءايٰت محكمٰت هن ام الكتٰب واخر متشٰبهٰت فاما الذين في قلوبهم زيغ فيتبعون ما تشٰبه منه ابتغاء الفتنة وابتغاء تاويله وما يعلم تاويله الا الله والرٰسخون في العلم يقولون ءامنا به كل من عند ربنا وما يذكر الا اولوا الالبٰب",
    "ayahnumber" : "7",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "305",
    "page" : "50",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3050",
    "ayah_text" : "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "ayah_text_no_diacratic" : "وان ربك لهو العزيز الرحيم",
    "ayahnumber" : "68",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3050",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3051",
    "ayah_text" : "وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ إِبۡرَٰهِيمَ",
    "ayah_text_no_diacratic" : "واتل عليهم نبا ابرٰهيم",
    "ayahnumber" : "69",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3051",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3052",
    "ayah_text" : "إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَا تَعۡبُدُونَ",
    "ayah_text_no_diacratic" : "اذ قال لابيه وقومه ما تعبدون",
    "ayahnumber" : "70",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3052",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3053",
    "ayah_text" : "قَالُواْ نَعۡبُدُ أَصۡنَامٗا فَنَظَلُّ لَهَا عَٰكِفِينَ",
    "ayah_text_no_diacratic" : "قالوا نعبد اصناما فنظل لها عٰكفين",
    "ayahnumber" : "71",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3053",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3054",
    "ayah_text" : "قَالَ هَلۡ يَسۡمَعُونَكُمۡ إِذۡ تَدۡعُونَ",
    "ayah_text_no_diacratic" : "قال هل يسمعونكم اذ تدعون",
    "ayahnumber" : "72",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3054",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3055",
    "ayah_text" : "أَوۡ يَنفَعُونَكُمۡ أَوۡ يَضُرُّونَ",
    "ayah_text_no_diacratic" : "او ينفعونكم او يضرون",
    "ayahnumber" : "73",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3055",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3056",
    "ayah_text" : "قَالُواْ بَلۡ وَجَدۡنَآ ءَابَآءَنَا كَذَٰلِكَ يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "قالوا بل وجدنا ءاباءنا كذٰلك يفعلون",
    "ayahnumber" : "74",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3056",
