    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4591",
    "ayah_text" : "فَأَمَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَيُدۡخِلُهُمۡ رَبُّهُمۡ فِي رَحۡمَتِهِۦۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "فاما الذين ءامنوا وعملوا الصٰلحٰت فيدخلهم ربهم في رحمته ذٰلك هو الفوز المبين",
    "ayahnumber" : "30",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4591",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4592",
    "ayah_text" : "وَأَمَّا ٱلَّذِينَ كَفَرُوٓاْ أَفَلَمۡ تَكُنۡ ءَايَٰتِي تُتۡلَىٰ عَلَيۡكُمۡ فَٱسۡتَكۡبَرۡتُمۡ وَكُنتُمۡ قَوۡمٗا مُّجۡرِمِينَ",
    "ayah_text_no_diacratic" : "واما الذين كفروا افلم تكن ءايٰتي تتلىٰ عليكم فاستكبرتم وكنتم قوما مجرمين",
    "ayahnumber" : "31",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4592",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4593",
    "ayah_text" : "وَإِذَا قِيلَ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَٱلسَّاعَةُ لَا رَيۡبَ فِيهَا قُلۡتُم مَّا نَدۡرِي مَا ٱلسَّاعَةُ إِن نَّظُنُّ إِلَّا ظَنّٗا وَمَا نَحۡنُ بِمُسۡتَيۡقِنِينَ",
    "ayah_text_no_diacratic" : "واذا قيل ان وعد الله حق والساعة لا ريب فيها قلتم ما ندري ما الساعة ان نظن الا ظنا وما نحن بمستيقنين",
    "ayahnumber" : "32",
    "chapter" : "25",
    "hizb" : "50",
    "index" : "4593",
    "page" : "501",
    "surahname" : "سُورَةُ الجَاثِيَةِ",
    "surahnumber" : "45",
    "surrahname_no_diacratic" : "سورة الجاثية"
  }, {
    "@id" : "quran:4594",
    "ayah_text" : "وَبَدَا لَهُمۡ سَيِّـَٔاتُ مَا عَمِلُواْ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "وبدا لهم سيات ما عملوا وحاق بهم ما كانوا به يستهزءون",
    "ayahnumber" : "33",
    "chapter" : "26",
