    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1160",
    "ayah_text" : "وَإِن تَدۡعُوهُمۡ إِلَى ٱلۡهُدَىٰ لَا يَتَّبِعُوكُمۡۚ سَوَآءٌ عَلَيۡكُمۡ أَدَعَوۡتُمُوهُمۡ أَمۡ أَنتُمۡ صَٰمِتُونَ",
    "ayah_text_no_diacratic" : "وان تدعوهم الى الهدىٰ لا يتبعوكم سواء عليكم ادعوتموهم ام انتم صٰمتون",
    "ayahnumber" : "193",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1160",
    "page" : "175",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1161",
    "ayah_text" : "إِنَّ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِ عِبَادٌ أَمۡثَالُكُمۡۖ فَٱدۡعُوهُمۡ فَلۡيَسۡتَجِيبُواْ لَكُمۡ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ان الذين تدعون من دون الله عباد امثالكم فادعوهم فليستجيبوا لكم ان كنتم صٰدقين",
    "ayahnumber" : "194",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1161",
    "page" : "175",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1162",
    "ayah_text" : "أَلَهُمۡ أَرۡجُلٞ يَمۡشُونَ بِهَآۖ أَمۡ لَهُمۡ أَيۡدٖ يَبۡطِشُونَ بِهَآۖ أَمۡ لَهُمۡ أَعۡيُنٞ يُبۡصِرُونَ بِهَآۖ أَمۡ لَهُمۡ ءَاذَانٞ يَسۡمَعُونَ بِهَاۗ قُلِ ٱدۡعُواْ شُرَكَآءَكُمۡ ثُمَّ كِيدُونِ فَلَا تُنظِرُونِ",
    "ayah_text_no_diacratic" : "الهم ارجل يمشون بها ام لهم ايد يبطشون بها ام لهم اعين يبصرون بها ام لهم ءاذان يسمعون بها قل ادعوا شركاءكم ثم كيدون فلا تنظرون",
    "ayahnumber" : "195",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1162",
    "page" : "175",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1163",
    "ayah_text" : "إِنَّ وَلِـِّۧيَ ٱللَّهُ ٱلَّذِي نَزَّلَ ٱلۡكِتَٰبَۖ وَهُوَ يَتَوَلَّى ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "ان ولي الله الذي نزل الكتٰب وهو يتولى الصٰلحين",
    "ayahnumber" : "196",
    "chapter" : "9",
    "hizb" : "17",
