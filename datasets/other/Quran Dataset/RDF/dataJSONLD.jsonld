    "surrahname_no_diacratic" : "سورة الانشقاق"
  }, {
    "@id" : "quran:6051",
    "ayah_text" : "إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ",
    "ayah_text_no_diacratic" : "اذا السماء انشقت",
