    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2909",
    "ayah_text" : "قُلۡ أَنزَلَهُ ٱلَّذِي يَعۡلَمُ ٱلسِّرَّ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ إِنَّهُۥ كَانَ غَفُورٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "قل انزله الذي يعلم السر في السمٰوٰت والارض انه كان غفورا رحيما",
