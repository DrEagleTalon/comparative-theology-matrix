    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4939",
    "ayah_text" : "وَثَمُودَاْ فَمَآ أَبۡقَىٰ",
    "ayah_text_no_diacratic" : "وثمودا فما ابقىٰ",
    "ayahnumber" : "51",
