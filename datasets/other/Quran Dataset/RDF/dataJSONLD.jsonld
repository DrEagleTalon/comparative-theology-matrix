    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1142",
    "ayah_text" : "وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ ٱلَّذِيٓ ءَاتَيۡنَٰهُ ءَايَٰتِنَا فَٱنسَلَخَ مِنۡهَا فَأَتۡبَعَهُ ٱلشَّيۡطَٰنُ فَكَانَ مِنَ ٱلۡغَاوِينَ",
    "ayah_text_no_diacratic" : "واتل عليهم نبا الذي ءاتينٰه ءايٰتنا فانسلخ منها فاتبعه الشيطٰن فكان من الغاوين",
    "ayahnumber" : "175",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1142",
    "page" : "173",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1143",
    "ayah_text" : "وَلَوۡ شِئۡنَا لَرَفَعۡنَٰهُ بِهَا وَلَٰكِنَّهُۥٓ أَخۡلَدَ إِلَى ٱلۡأَرۡضِ وَٱتَّبَعَ هَوَىٰهُۚ فَمَثَلُهُۥ كَمَثَلِ ٱلۡكَلۡبِ إِن تَحۡمِلۡ عَلَيۡهِ يَلۡهَثۡ أَوۡ تَتۡرُكۡهُ يَلۡهَثۚ ذَّٰلِكَ مَثَلُ ٱلۡقَوۡمِ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَاۚ فَٱقۡصُصِ ٱلۡقَصَصَ لَعَلَّهُمۡ يَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "ولو شئنا لرفعنٰه بها ولٰكنه اخلد الى الارض واتبع هوىٰه فمثله كمثل الكلب ان تحمل عليه يلهث او تتركه يلهث ذٰلك مثل القوم الذين كذبوا بايٰتنا فاقصص القصص لعلهم يتفكرون",
    "ayahnumber" : "176",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1143",
    "page" : "173",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1144",
    "ayah_text" : "سَآءَ مَثَلًا ٱلۡقَوۡمُ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا وَأَنفُسَهُمۡ كَانُواْ يَظۡلِمُونَ",
    "ayah_text_no_diacratic" : "ساء مثلا القوم الذين كذبوا بايٰتنا وانفسهم كانوا يظلمون",
    "ayahnumber" : "177",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1144",
    "page" : "173",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1145",
    "ayah_text" : "مَن يَهۡدِ ٱللَّهُ فَهُوَ ٱلۡمُهۡتَدِيۖ وَمَن يُضۡلِلۡ فَأُوْلَٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ",
    "ayah_text_no_diacratic" : "من يهد الله فهو المهتدي ومن يضلل فاولٰئك هم الخٰسرون",
    "ayahnumber" : "178",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1145",
    "page" : "173",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1146",
    "ayah_text" : "وَلَقَدۡ ذَرَأۡنَا لِجَهَنَّمَ كَثِيرٗا مِّنَ ٱلۡجِنِّ وَٱلۡإِنسِۖ لَهُمۡ قُلُوبٞ لَّا يَفۡقَهُونَ بِهَا وَلَهُمۡ أَعۡيُنٞ لَّا يُبۡصِرُونَ بِهَا وَلَهُمۡ ءَاذَانٞ لَّا يَسۡمَعُونَ بِهَآۚ أُوْلَٰٓئِكَ كَٱلۡأَنۡعَٰمِ بَلۡ هُمۡ أَضَلُّۚ أُوْلَٰٓئِكَ هُمُ ٱلۡغَٰفِلُونَ",
    "ayah_text_no_diacratic" : "ولقد ذرانا لجهنم كثيرا من الجن والانس لهم قلوب لا يفقهون بها ولهم اعين لا يبصرون بها ولهم ءاذان لا يسمعون بها اولٰئك كالانعٰم بل هم اضل اولٰئك هم الغٰفلون",
    "ayahnumber" : "179",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1146",
    "page" : "174",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1147",
    "ayah_text" : "وَلِلَّهِ ٱلۡأَسۡمَآءُ ٱلۡحُسۡنَىٰ فَٱدۡعُوهُ بِهَاۖ وَذَرُواْ ٱلَّذِينَ يُلۡحِدُونَ فِيٓ أَسۡمَٰٓئِهِۦۚ سَيُجۡزَوۡنَ مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ولله الاسماء الحسنىٰ فادعوه بها وذروا الذين يلحدون في اسمٰئه سيجزون ما كانوا يعملون",
    "ayahnumber" : "180",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1147",
    "page" : "174",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1148",
    "ayah_text" : "وَمِمَّنۡ خَلَقۡنَآ أُمَّةٞ يَهۡدُونَ بِٱلۡحَقِّ وَبِهِۦ يَعۡدِلُونَ",
    "ayah_text_no_diacratic" : "وممن خلقنا امة يهدون بالحق وبه يعدلون",
    "ayahnumber" : "181",
    "chapter" : "9",
    "hizb" : "17",
    "index" : "1148",
