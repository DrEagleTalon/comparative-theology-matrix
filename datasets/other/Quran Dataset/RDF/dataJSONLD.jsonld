  }, {
    "@id" : "quran:1928",
    "ayah_text" : "فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَكُن مِّنَ ٱلسَّٰجِدِينَ",
    "ayah_text_no_diacratic" : "فسبح بحمد ربك وكن من السٰجدين",
