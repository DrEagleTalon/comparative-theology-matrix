    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3000",
    "ayah_text" : "قَالَ أَلَمۡ نُرَبِّكَ فِينَا وَلِيدٗا وَلَبِثۡتَ فِينَا مِنۡ عُمُرِكَ سِنِينَ",
    "ayah_text_no_diacratic" : "قال الم نربك فينا وليدا ولبثت فينا من عمرك سنين",
    "ayahnumber" : "18",
    "chapter" : "19",
