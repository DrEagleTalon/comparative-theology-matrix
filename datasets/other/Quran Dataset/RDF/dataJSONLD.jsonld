    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1166",
    "ayah_text" : "خُذِ ٱلۡعَفۡوَ وَأۡمُرۡ بِٱلۡعُرۡفِ وَأَعۡرِضۡ عَنِ ٱلۡجَٰهِلِينَ",
    "ayah_text_no_diacratic" : "خذ العفو وامر بالعرف واعرض عن الجٰهلين",
