    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:300",
    "ayah_text" : "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ٱلۡحَيُّ ٱلۡقَيُّومُ",
    "ayah_text_no_diacratic" : "الله لا الٰه الا هو الحي القيوم",
