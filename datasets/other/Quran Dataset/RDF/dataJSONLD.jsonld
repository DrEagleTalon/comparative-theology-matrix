    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:2970",
    "ayah_text" : "وَٱلَّذِينَ إِذَآ أَنفَقُواْ لَمۡ يُسۡرِفُواْ وَلَمۡ يَقۡتُرُواْ وَكَانَ بَيۡنَ ذَٰلِكَ قَوَامٗا",
    "ayah_text_no_diacratic" : "والذين اذا انفقوا لم يسرفوا ولم يقتروا وكان بين ذٰلك قواما",
    "ayahnumber" : "67",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2970",
    "page" : "365",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2971",
    "ayah_text" : "وَٱلَّذِينَ لَا يَدۡعُونَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ وَلَا يَقۡتُلُونَ ٱلنَّفۡسَ ٱلَّتِي حَرَّمَ ٱللَّهُ إِلَّا بِٱلۡحَقِّ وَلَا يَزۡنُونَۚ وَمَن يَفۡعَلۡ ذَٰلِكَ يَلۡقَ أَثَامٗا",
    "ayah_text_no_diacratic" : "والذين لا يدعون مع الله الٰها ءاخر ولا يقتلون النفس التي حرم الله الا بالحق ولا يزنون ومن يفعل ذٰلك يلق اثاما",
    "ayahnumber" : "68",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2971",
    "page" : "366",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2972",
    "ayah_text" : "يُضَٰعَفۡ لَهُ ٱلۡعَذَابُ يَوۡمَ ٱلۡقِيَٰمَةِ وَيَخۡلُدۡ فِيهِۦ مُهَانًا",
    "ayah_text_no_diacratic" : "يضٰعف له العذاب يوم القيٰمة ويخلد فيه مهانا",
    "ayahnumber" : "69",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2972",
    "page" : "366",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2973",
    "ayah_text" : "إِلَّا مَن تَابَ وَءَامَنَ وَعَمِلَ عَمَلٗا صَٰلِحٗا فَأُوْلَٰٓئِكَ يُبَدِّلُ ٱللَّهُ سَيِّـَٔاتِهِمۡ حَسَنَٰتٖۗ وَكَانَ ٱللَّهُ غَفُورٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "الا من تاب وءامن وعمل عملا صٰلحا فاولٰئك يبدل الله سياتهم حسنٰت وكان الله غفورا رحيما",
    "ayahnumber" : "70",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2973",
    "page" : "366",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2974",
    "ayah_text" : "وَمَن تَابَ وَعَمِلَ صَٰلِحٗا فَإِنَّهُۥ يَتُوبُ إِلَى ٱللَّهِ مَتَابٗا",
    "ayah_text_no_diacratic" : "ومن تاب وعمل صٰلحا فانه يتوب الى الله متابا",
    "ayahnumber" : "71",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2974",
    "page" : "366",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2975",
    "ayah_text" : "وَٱلَّذِينَ لَا يَشۡهَدُونَ ٱلزُّورَ وَإِذَا مَرُّواْ بِٱللَّغۡوِ مَرُّواْ كِرَامٗا",
    "ayah_text_no_diacratic" : "والذين لا يشهدون الزور واذا مروا باللغو مروا كراما",
    "ayahnumber" : "72",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2975",
    "page" : "366",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2976",
    "ayah_text" : "وَٱلَّذِينَ إِذَا ذُكِّرُواْ بِـَٔايَٰتِ رَبِّهِمۡ لَمۡ يَخِرُّواْ عَلَيۡهَا صُمّٗا وَعُمۡيَانٗا",
    "ayah_text_no_diacratic" : "والذين اذا ذكروا بايٰت ربهم لم يخروا عليها صما وعميانا",
    "ayahnumber" : "73",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2976",
    "page" : "366",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2977",
    "ayah_text" : "وَٱلَّذِينَ يَقُولُونَ رَبَّنَا هَبۡ لَنَا مِنۡ أَزۡوَٰجِنَا وَذُرِّيَّٰتِنَا قُرَّةَ أَعۡيُنٖ وَٱجۡعَلۡنَا لِلۡمُتَّقِينَ إِمَامًا",
    "ayah_text_no_diacratic" : "والذين يقولون ربنا هب لنا من ازوٰجنا وذريٰتنا قرة اعين واجعلنا للمتقين اماما",
    "ayahnumber" : "74",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2977",
    "page" : "366",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2978",
    "ayah_text" : "أُوْلَٰٓئِكَ يُجۡزَوۡنَ ٱلۡغُرۡفَةَ بِمَا صَبَرُواْ وَيُلَقَّوۡنَ فِيهَا تَحِيَّةٗ وَسَلَٰمًا",
    "ayah_text_no_diacratic" : "اولٰئك يجزون الغرفة بما صبروا ويلقون فيها تحية وسلٰما",
    "ayahnumber" : "75",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "2978",
    "page" : "366",
    "surahname" : "سُورَةُ الفُرۡقَانِ",
    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2979",
    "ayah_text" : "خَٰلِدِينَ فِيهَاۚ حَسُنَتۡ مُسۡتَقَرّٗا وَمُقَامٗا",
    "ayah_text_no_diacratic" : "خٰلدين فيها حسنت مستقرا ومقاما",
    "ayahnumber" : "76",
    "chapter" : "19",
