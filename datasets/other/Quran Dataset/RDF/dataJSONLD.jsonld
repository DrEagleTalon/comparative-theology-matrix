    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3702",
    "ayah_text" : "قُل لَّكُم مِّيعَادُ يَوۡمٖ لَّا تَسۡتَـٔۡخِرُونَ عَنۡهُ سَاعَةٗ وَلَا تَسۡتَقۡدِمُونَ",
    "ayah_text_no_diacratic" : "قل لكم ميعاد يوم لا تستخرون عنه ساعة ولا تستقدمون",
