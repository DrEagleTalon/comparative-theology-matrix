    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:229",
    "ayah_text" : "۞يَسۡـَٔلُونَكَ عَنِ ٱلۡخَمۡرِ وَٱلۡمَيۡسِرِۖ قُلۡ فِيهِمَآ إِثۡمٞ كَبِيرٞ وَمَنَٰفِعُ لِلنَّاسِ وَإِثۡمُهُمَآ أَكۡبَرُ مِن نَّفۡعِهِمَاۗ وَيَسۡـَٔلُونَكَ مَاذَا يُنفِقُونَۖ قُلِ ٱلۡعَفۡوَۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِ لَعَلَّكُمۡ تَتَفَكَّرُونَ",
    "ayah_text_no_diacratic" : "يسلونك عن الخمر والميسر قل فيهما اثم كبير ومنٰفع للناس واثمهما اكبر من نفعهما ويسلونك ماذا ينفقون قل العفو كذٰلك يبين الله لكم الايٰت لعلكم تتفكرون",
    "ayahnumber" : "219",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "229",
    "page" : "34",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2290",
    "ayah_text" : "قَالَ رَبِّ إِنِّي وَهَنَ ٱلۡعَظۡمُ مِنِّي وَٱشۡتَعَلَ ٱلرَّأۡسُ شَيۡبٗا وَلَمۡ أَكُنۢ بِدُعَآئِكَ رَبِّ شَقِيّٗا",
    "ayah_text_no_diacratic" : "قال رب اني وهن العظم مني واشتعل الراس شيبا ولم اكن بدعائك رب شقيا",
    "ayahnumber" : "4",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2290",
    "page" : "305",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2291",
    "ayah_text" : "وَإِنِّي خِفۡتُ ٱلۡمَوَٰلِيَ مِن وَرَآءِي وَكَانَتِ ٱمۡرَأَتِي عَاقِرٗا فَهَبۡ لِي مِن لَّدُنكَ وَلِيّٗا",
    "ayah_text_no_diacratic" : "واني خفت الموٰلي من وراءي وكانت امراتي عاقرا فهب لي من لدنك وليا",
    "ayahnumber" : "5",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2291",
    "page" : "305",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2292",
    "ayah_text" : "يَرِثُنِي وَيَرِثُ مِنۡ ءَالِ يَعۡقُوبَۖ وَٱجۡعَلۡهُ رَبِّ رَضِيّٗا",
    "ayah_text_no_diacratic" : "يرثني ويرث من ءال يعقوب واجعله رب رضيا",
    "ayahnumber" : "6",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2292",
    "page" : "305",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2293",
    "ayah_text" : "يَٰزَكَرِيَّآ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ ٱسۡمُهُۥ يَحۡيَىٰ لَمۡ نَجۡعَل لَّهُۥ مِن قَبۡلُ سَمِيّٗا",
    "ayah_text_no_diacratic" : "يٰزكريا انا نبشرك بغلٰم اسمه يحيىٰ لم نجعل له من قبل سميا",
    "ayahnumber" : "7",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2293",
    "page" : "305",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2294",
    "ayah_text" : "قَالَ رَبِّ أَنَّىٰ يَكُونُ لِي غُلَٰمٞ وَكَانَتِ ٱمۡرَأَتِي عَاقِرٗا وَقَدۡ بَلَغۡتُ مِنَ ٱلۡكِبَرِ عِتِيّٗا",
    "ayah_text_no_diacratic" : "قال رب انىٰ يكون لي غلٰم وكانت امراتي عاقرا وقد بلغت من الكبر عتيا",
    "ayahnumber" : "8",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2294",
    "page" : "305",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2295",
    "ayah_text" : "قَالَ كَذَٰلِكَ قَالَ رَبُّكَ هُوَ عَلَيَّ هَيِّنٞ وَقَدۡ خَلَقۡتُكَ مِن قَبۡلُ وَلَمۡ تَكُ شَيۡـٔٗا",
    "ayah_text_no_diacratic" : "قال كذٰلك قال ربك هو علي هين وقد خلقتك من قبل ولم تك شيا",
    "ayahnumber" : "9",
    "chapter" : "16",
    "hizb" : "30",
