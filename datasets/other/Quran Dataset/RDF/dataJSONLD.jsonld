    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3195",
    "ayah_text" : "فَلَا تَدۡعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلۡمُعَذَّبِينَ",
    "ayah_text_no_diacratic" : "فلا تدع مع الله الٰها ءاخر فتكون من المعذبين",
