    "surrahname_no_diacratic" : "سورة القارعة"
  }, {
    "@id" : "quran:636",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ ءَامِنُواْ بِٱللَّهِ وَرَسُولِهِۦ وَٱلۡكِتَٰبِ ٱلَّذِي نَزَّلَ عَلَىٰ رَسُولِهِۦ وَٱلۡكِتَٰبِ ٱلَّذِيٓ أَنزَلَ مِن قَبۡلُۚ وَمَن يَكۡفُرۡ بِٱللَّهِ وَمَلَٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ فَقَدۡ ضَلَّ ضَلَٰلَۢا بَعِيدًا",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ءامنوا بالله ورسوله والكتٰب الذي نزل علىٰ رسوله والكتٰب الذي انزل من قبل ومن يكفر بالله وملٰئكته وكتبه ورسله واليوم الاخر فقد ضل ضلٰلا بعيدا",
    "ayahnumber" : "136",
    "chapter" : "5",
    "hizb" : "10",
    "index" : "636",
    "page" : "100",
