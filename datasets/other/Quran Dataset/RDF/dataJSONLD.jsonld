    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2579",
    "ayah_text" : "قَالَ بَل رَّبُّكُمۡ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ ٱلَّذِي فَطَرَهُنَّ وَأَنَا۠ عَلَىٰ ذَٰلِكُم مِّنَ ٱلشَّٰهِدِينَ",
    "ayah_text_no_diacratic" : "قال بل ربكم رب السمٰوٰت والارض الذي فطرهن وانا علىٰ ذٰلكم من الشٰهدين",
    "ayahnumber" : "56",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2579",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:258",
    "ayah_text" : "وَقَالَ لَهُمۡ نَبِيُّهُمۡ إِنَّ ءَايَةَ مُلۡكِهِۦٓ أَن يَأۡتِيَكُمُ ٱلتَّابُوتُ فِيهِ سَكِينَةٞ مِّن رَّبِّكُمۡ وَبَقِيَّةٞ مِّمَّا تَرَكَ ءَالُ مُوسَىٰ وَءَالُ هَٰرُونَ تَحۡمِلُهُ ٱلۡمَلَٰٓئِكَةُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "وقال لهم نبيهم ان ءاية ملكه ان ياتيكم التابوت فيه سكينة من ربكم وبقية مما ترك ءال موسىٰ وءال هٰرون تحمله الملٰئكة ان في ذٰلك لاية لكم ان كنتم مؤمنين",
    "ayahnumber" : "248",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "258",
    "page" : "40",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2580",
    "ayah_text" : "وَتَٱللَّهِ لَأَكِيدَنَّ أَصۡنَٰمَكُم بَعۡدَ أَن تُوَلُّواْ مُدۡبِرِينَ",
    "ayah_text_no_diacratic" : "وتالله لاكيدن اصنٰمكم بعد ان تولوا مدبرين",
    "ayahnumber" : "57",
