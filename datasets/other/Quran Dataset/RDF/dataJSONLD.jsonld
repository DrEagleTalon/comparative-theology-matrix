    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3160",
    "ayah_text" : "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ",
    "ayah_text_no_diacratic" : "اني لكم رسول امين",
