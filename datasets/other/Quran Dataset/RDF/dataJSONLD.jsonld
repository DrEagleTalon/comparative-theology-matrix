  }, {
    "@id" : "quran:4518",
    "ayah_text" : "أَنۡ أَدُّوٓاْ إِلَيَّ عِبَادَ ٱللَّهِۖ إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ",
    "ayah_text_no_diacratic" : "ان ادوا الي عباد الله اني لكم رسول امين",
