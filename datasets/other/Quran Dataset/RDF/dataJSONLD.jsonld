  }, {
    "@id" : "quran:1904",
    "ayah_text" : "فَجَعَلۡنَا عَٰلِيَهَا سَافِلَهَا وَأَمۡطَرۡنَا عَلَيۡهِمۡ حِجَارَةٗ مِّن سِجِّيلٍ",
    "ayah_text_no_diacratic" : "فجعلنا عٰليها سافلها وامطرنا عليهم حجارة من سجيل",
    "ayahnumber" : "74",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1904",
