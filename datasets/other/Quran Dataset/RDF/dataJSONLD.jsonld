    "surahname" : "سُورَةُ المَعَارِجِ",
    "surahnumber" : "70",
    "surrahname_no_diacratic" : "سورة المعارج"
  }, {
    "@id" : "quran:552",
    "ayah_text" : "أُوْلَٰٓئِكَ ٱلَّذِينَ لَعَنَهُمُ ٱللَّهُۖ وَمَن يَلۡعَنِ ٱللَّهُ فَلَن تَجِدَ لَهُۥ نَصِيرًا",
    "ayah_text_no_diacratic" : "اولٰئك الذين لعنهم الله ومن يلعن الله فلن تجد له نصيرا",
