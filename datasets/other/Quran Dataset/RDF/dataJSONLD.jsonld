    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:225",
    "ayah_text" : "يَسۡـَٔلُونَكَ مَاذَا يُنفِقُونَۖ قُلۡ مَآ أَنفَقۡتُم مِّنۡ خَيۡرٖ فَلِلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِۗ وَمَا تَفۡعَلُواْ مِنۡ خَيۡرٖ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٞ",
    "ayah_text_no_diacratic" : "يسلونك ماذا ينفقون قل ما انفقتم من خير فللوٰلدين والاقربين واليتٰمىٰ والمسٰكين وابن السبيل وما تفعلوا من خير فان الله به عليم",
    "ayahnumber" : "215",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "225",
    "page" : "33",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2250",
    "ayah_text" : "قَالَ إِن سَأَلۡتُكَ عَن شَيۡءِۭ بَعۡدَهَا فَلَا تُصَٰحِبۡنِيۖ قَدۡ بَلَغۡتَ مِن لَّدُنِّي عُذۡرٗا",
    "ayah_text_no_diacratic" : "قال ان سالتك عن شيء بعدها فلا تصٰحبني قد بلغت من لدني عذرا",
    "ayahnumber" : "76",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2250",
    "page" : "302",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2251",
    "ayah_text" : "فَٱنطَلَقَا حَتَّىٰٓ إِذَآ أَتَيَآ أَهۡلَ قَرۡيَةٍ ٱسۡتَطۡعَمَآ أَهۡلَهَا فَأَبَوۡاْ أَن يُضَيِّفُوهُمَا فَوَجَدَا فِيهَا جِدَارٗا يُرِيدُ أَن يَنقَضَّ فَأَقَامَهُۥۖ قَالَ لَوۡ شِئۡتَ لَتَّخَذۡتَ عَلَيۡهِ أَجۡرٗا",
    "ayah_text_no_diacratic" : "فانطلقا حتىٰ اذا اتيا اهل قرية استطعما اهلها فابوا ان يضيفوهما فوجدا فيها جدارا يريد ان ينقض فاقامه قال لو شئت لتخذت عليه اجرا",
    "ayahnumber" : "77",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2251",
    "page" : "302",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2252",
    "ayah_text" : "قَالَ هَٰذَا فِرَاقُ بَيۡنِي وَبَيۡنِكَۚ سَأُنَبِّئُكَ بِتَأۡوِيلِ مَا لَمۡ تَسۡتَطِع عَّلَيۡهِ صَبۡرًا",
    "ayah_text_no_diacratic" : "قال هٰذا فراق بيني وبينك سانبئك بتاويل ما لم تستطع عليه صبرا",
    "ayahnumber" : "78",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2252",
    "page" : "302",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2253",
    "ayah_text" : "أَمَّا ٱلسَّفِينَةُ فَكَانَتۡ لِمَسَٰكِينَ يَعۡمَلُونَ فِي ٱلۡبَحۡرِ فَأَرَدتُّ أَنۡ أَعِيبَهَا وَكَانَ وَرَآءَهُم مَّلِكٞ يَأۡخُذُ كُلَّ سَفِينَةٍ غَصۡبٗا",
    "ayah_text_no_diacratic" : "اما السفينة فكانت لمسٰكين يعملون في البحر فاردت ان اعيبها وكان وراءهم ملك ياخذ كل سفينة غصبا",
    "ayahnumber" : "79",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2253",
    "page" : "302",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2254",
    "ayah_text" : "وَأَمَّا ٱلۡغُلَٰمُ فَكَانَ أَبَوَاهُ مُؤۡمِنَيۡنِ فَخَشِينَآ أَن يُرۡهِقَهُمَا طُغۡيَٰنٗا وَكُفۡرٗا",
    "ayah_text_no_diacratic" : "واما الغلٰم فكان ابواه مؤمنين فخشينا ان يرهقهما طغيٰنا وكفرا",
    "ayahnumber" : "80",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2254",
    "page" : "302",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2255",
    "ayah_text" : "فَأَرَدۡنَآ أَن يُبۡدِلَهُمَا رَبُّهُمَا خَيۡرٗا مِّنۡهُ زَكَوٰةٗ وَأَقۡرَبَ رُحۡمٗا",
    "ayah_text_no_diacratic" : "فاردنا ان يبدلهما ربهما خيرا منه زكوٰة واقرب رحما",
    "ayahnumber" : "81",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2255",
    "page" : "302",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2256",
    "ayah_text" : "وَأَمَّا ٱلۡجِدَارُ فَكَانَ لِغُلَٰمَيۡنِ يَتِيمَيۡنِ فِي ٱلۡمَدِينَةِ وَكَانَ تَحۡتَهُۥ كَنزٞ لَّهُمَا وَكَانَ أَبُوهُمَا صَٰلِحٗا فَأَرَادَ رَبُّكَ أَن يَبۡلُغَآ أَشُدَّهُمَا وَيَسۡتَخۡرِجَا كَنزَهُمَا رَحۡمَةٗ مِّن رَّبِّكَۚ وَمَا فَعَلۡتُهُۥ عَنۡ أَمۡرِيۚ ذَٰلِكَ تَأۡوِيلُ مَا لَمۡ تَسۡطِع عَّلَيۡهِ صَبۡرٗا",
    "ayah_text_no_diacratic" : "واما الجدار فكان لغلٰمين يتيمين في المدينة وكان تحته كنز لهما وكان ابوهما صٰلحا فاراد ربك ان يبلغا اشدهما ويستخرجا كنزهما رحمة من ربك وما فعلته عن امري ذٰلك تاويل ما لم تسطع عليه صبرا",
    "ayahnumber" : "82",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2256",
    "page" : "302",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2257",
    "ayah_text" : "وَيَسۡـَٔلُونَكَ عَن ذِي ٱلۡقَرۡنَيۡنِۖ قُلۡ سَأَتۡلُواْ عَلَيۡكُم مِّنۡهُ ذِكۡرًا",
    "ayah_text_no_diacratic" : "ويسلونك عن ذي القرنين قل ساتلوا عليكم منه ذكرا",
    "ayahnumber" : "83",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2257",
    "page" : "302",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2258",
    "ayah_text" : "إِنَّا مَكَّنَّا لَهُۥ فِي ٱلۡأَرۡضِ وَءَاتَيۡنَٰهُ مِن كُلِّ شَيۡءٖ سَبَبٗا",
    "ayah_text_no_diacratic" : "انا مكنا له في الارض وءاتينٰه من كل شيء سببا",
    "ayahnumber" : "84",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2258",
    "page" : "303",
    "surahname" : "سُورَةُ الكَهۡفِ",
    "surahnumber" : "18",
    "surrahname_no_diacratic" : "سورة الكهف"
  }, {
    "@id" : "quran:2259",
    "ayah_text" : "فَأَتۡبَعَ سَبَبًا",
    "ayah_text_no_diacratic" : "فاتبع سببا",
    "ayahnumber" : "85",
    "chapter" : "16",
    "hizb" : "30",
    "index" : "2259",
