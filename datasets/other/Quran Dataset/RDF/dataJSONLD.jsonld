    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:858",
    "ayah_text" : "قُل لَّوۡ أَنَّ عِندِي مَا تَسۡتَعۡجِلُونَ بِهِۦ لَقُضِيَ ٱلۡأَمۡرُ بَيۡنِي وَبَيۡنَكُمۡۗ وَٱللَّهُ أَعۡلَمُ بِٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "قل لو ان عندي ما تستعجلون به لقضي الامر بيني وبينكم والله اعلم بالظٰلمين",
