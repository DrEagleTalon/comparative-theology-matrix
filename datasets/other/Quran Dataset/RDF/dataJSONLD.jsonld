    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3188",
    "ayah_text" : "ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ",
    "ayah_text_no_diacratic" : "ثم جاءهم ما كانوا يوعدون",
