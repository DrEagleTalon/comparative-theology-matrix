    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3009",
    "ayah_text" : "قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِيٓ أُرۡسِلَ إِلَيۡكُمۡ لَمَجۡنُونٞ",
