    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:755",
    "ayah_text" : "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ لَا تَغۡلُواْ فِي دِينِكُمۡ غَيۡرَ ٱلۡحَقِّ وَلَا تَتَّبِعُوٓاْ أَهۡوَآءَ قَوۡمٖ قَدۡ ضَلُّواْ مِن قَبۡلُ وَأَضَلُّواْ كَثِيرٗا وَضَلُّواْ عَن سَوَآءِ ٱلسَّبِيلِ",
    "ayah_text_no_diacratic" : "قل يٰاهل الكتٰب لا تغلوا في دينكم غير الحق ولا تتبعوا اهواء قوم قد ضلوا من قبل واضلوا كثيرا وضلوا عن سواء السبيل",
    "ayahnumber" : "77",
    "chapter" : "6",
    "hizb" : "12",
    "index" : "755",
    "page" : "120",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:756",
    "ayah_text" : "لُعِنَ ٱلَّذِينَ كَفَرُواْ مِنۢ بَنِيٓ إِسۡرَٰٓءِيلَ عَلَىٰ لِسَانِ دَاوُۥدَ وَعِيسَى ٱبۡنِ مَرۡيَمَۚ ذَٰلِكَ بِمَا عَصَواْ وَّكَانُواْ يَعۡتَدُونَ",
    "ayah_text_no_diacratic" : "لعن الذين كفروا من بني اسرٰءيل علىٰ لسان داود وعيسى ابن مريم ذٰلك بما عصوا وكانوا يعتدون",
    "ayahnumber" : "78",
    "chapter" : "6",
    "hizb" : "12",
    "index" : "756",
    "page" : "121",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:757",
    "ayah_text" : "كَانُواْ لَا يَتَنَاهَوۡنَ عَن مُّنكَرٖ فَعَلُوهُۚ لَبِئۡسَ مَا كَانُواْ يَفۡعَلُونَ",
    "ayah_text_no_diacratic" : "كانوا لا يتناهون عن منكر فعلوه لبئس ما كانوا يفعلون",
    "ayahnumber" : "79",
    "chapter" : "6",
    "hizb" : "12",
    "index" : "757",
    "page" : "121",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:758",
    "ayah_text" : "تَرَىٰ كَثِيرٗا مِّنۡهُمۡ يَتَوَلَّوۡنَ ٱلَّذِينَ كَفَرُواْۚ لَبِئۡسَ مَا قَدَّمَتۡ لَهُمۡ أَنفُسُهُمۡ أَن سَخِطَ ٱللَّهُ عَلَيۡهِمۡ وَفِي ٱلۡعَذَابِ هُمۡ خَٰلِدُونَ",
    "ayah_text_no_diacratic" : "ترىٰ كثيرا منهم يتولون الذين كفروا لبئس ما قدمت لهم انفسهم ان سخط الله عليهم وفي العذاب هم خٰلدون",
    "ayahnumber" : "80",
    "chapter" : "6",
    "hizb" : "12",
    "index" : "758",
    "page" : "121",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:759",
    "ayah_text" : "وَلَوۡ كَانُواْ يُؤۡمِنُونَ بِٱللَّهِ وَٱلنَّبِيِّ وَمَآ أُنزِلَ إِلَيۡهِ مَا ٱتَّخَذُوهُمۡ أَوۡلِيَآءَ وَلَٰكِنَّ كَثِيرٗا مِّنۡهُمۡ فَٰسِقُونَ",
    "ayah_text_no_diacratic" : "ولو كانوا يؤمنون بالله والنبي وما انزل اليه ما اتخذوهم اولياء ولٰكن كثيرا منهم فٰسقون",
    "ayahnumber" : "81",
    "chapter" : "6",
    "hizb" : "12",
    "index" : "759",
    "page" : "121",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:76",
    "ayah_text" : "فَجَعَلۡنَٰهَا نَكَٰلٗا لِّمَا بَيۡنَ يَدَيۡهَا وَمَا خَلۡفَهَا وَمَوۡعِظَةٗ لِّلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "فجعلنٰها نكٰلا لما بين يديها وما خلفها وموعظة للمتقين",
    "ayahnumber" : "66",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "76",
    "page" : "10",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:760",
    "ayah_text" : "۞لَتَجِدَنَّ أَشَدَّ ٱلنَّاسِ عَدَٰوَةٗ لِّلَّذِينَ ءَامَنُواْ ٱلۡيَهُودَ وَٱلَّذِينَ أَشۡرَكُواْۖ وَلَتَجِدَنَّ أَقۡرَبَهُم مَّوَدَّةٗ لِّلَّذِينَ ءَامَنُواْ ٱلَّذِينَ قَالُوٓاْ إِنَّا نَصَٰرَىٰۚ ذَٰلِكَ بِأَنَّ مِنۡهُمۡ قِسِّيسِينَ وَرُهۡبَانٗا وَأَنَّهُمۡ لَا يَسۡتَكۡبِرُونَ",
    "ayah_text_no_diacratic" : "لتجدن اشد الناس عدٰوة للذين ءامنوا اليهود والذين اشركوا ولتجدن اقربهم مودة للذين ءامنوا الذين قالوا انا نصٰرىٰ ذٰلك بان منهم قسيسين ورهبانا وانهم لا يستكبرون",
    "ayahnumber" : "82",
    "chapter" : "6",
    "hizb" : "12",
    "index" : "760",
    "page" : "121",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:761",
    "ayah_text" : "وَإِذَا سَمِعُواْ مَآ أُنزِلَ إِلَى ٱلرَّسُولِ تَرَىٰٓ أَعۡيُنَهُمۡ تَفِيضُ مِنَ ٱلدَّمۡعِ مِمَّا عَرَفُواْ مِنَ ٱلۡحَقِّۖ يَقُولُونَ رَبَّنَآ ءَامَنَّا فَٱكۡتُبۡنَا مَعَ ٱلشَّٰهِدِينَ",
    "ayah_text_no_diacratic" : "واذا سمعوا ما انزل الى الرسول ترىٰ اعينهم تفيض من الدمع مما عرفوا من الحق يقولون ربنا ءامنا فاكتبنا مع الشٰهدين",
    "ayahnumber" : "83",
    "chapter" : "6",
    "hizb" : "12",
    "index" : "761",
    "page" : "121",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:762",
    "ayah_text" : "وَمَا لَنَا لَا نُؤۡمِنُ بِٱللَّهِ وَمَا جَآءَنَا مِنَ ٱلۡحَقِّ وَنَطۡمَعُ أَن يُدۡخِلَنَا رَبُّنَا مَعَ ٱلۡقَوۡمِ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "وما لنا لا نؤمن بالله وما جاءنا من الحق ونطمع ان يدخلنا ربنا مع القوم الصٰلحين",
    "ayahnumber" : "84",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "762",
    "page" : "122",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:763",
    "ayah_text" : "فَأَثَٰبَهُمُ ٱللَّهُ بِمَا قَالُواْ جَنَّٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "فاثٰبهم الله بما قالوا جنٰت تجري من تحتها الانهٰر خٰلدين فيها وذٰلك جزاء المحسنين",
    "ayahnumber" : "85",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "763",
    "page" : "122",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:764",
    "ayah_text" : "وَٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِـَٔايَٰتِنَآ أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "والذين كفروا وكذبوا بايٰتنا اولٰئك اصحٰب الجحيم",
    "ayahnumber" : "86",
    "chapter" : "7",
    "hizb" : "12",
    "index" : "764",
