    "page" : "108",
    "surahname" : "سُورَةُ المَائـِدَةِ",
    "surahnumber" : "5",
    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:685",
    "ayah_text" : "وَٱذۡكُرُواْ نِعۡمَةَ ٱللَّهِ عَلَيۡكُمۡ وَمِيثَٰقَهُ ٱلَّذِي وَاثَقَكُم بِهِۦٓ إِذۡ قُلۡتُمۡ سَمِعۡنَا وَأَطَعۡنَاۖ وَٱتَّقُواْ ٱللَّهَۚ إِنَّ ٱللَّهَ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ",
    "ayah_text_no_diacratic" : "واذكروا نعمة الله عليكم وميثٰقه الذي واثقكم به اذ قلتم سمعنا واطعنا واتقوا الله ان الله عليم بذات الصدور",
