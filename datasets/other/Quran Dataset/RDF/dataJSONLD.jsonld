    "surrahname_no_diacratic" : "سورة النمل"
  }, {
    "@id" : "quran:3265",
    "ayah_text" : "وَلُوطًا إِذۡ قَالَ لِقَوۡمِهِۦٓ أَتَأۡتُونَ ٱلۡفَٰحِشَةَ وَأَنتُمۡ تُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "ولوطا اذ قال لقومه اتاتون الفٰحشة وانتم تبصرون",
