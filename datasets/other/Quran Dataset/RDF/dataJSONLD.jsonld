    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4145",
    "ayah_text" : "قُلۡ إِنِّيٓ أُمِرۡتُ أَنۡ أَعۡبُدَ ٱللَّهَ مُخۡلِصٗا لَّهُ ٱلدِّينَ",
    "ayah_text_no_diacratic" : "قل اني امرت ان اعبد الله مخلصا له الدين",
