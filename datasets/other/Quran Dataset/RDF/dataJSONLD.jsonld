  }, {
    "@id" : "quran:2594",
    "ayah_text" : "وَنَجَّيۡنَٰهُ وَلُوطًا إِلَى ٱلۡأَرۡضِ ٱلَّتِي بَٰرَكۡنَا فِيهَا لِلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ونجينٰه ولوطا الى الارض التي بٰركنا فيها للعٰلمين",
