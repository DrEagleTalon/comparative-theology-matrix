    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1030",
    "ayah_text" : "أَوَعَجِبۡتُمۡ أَن جَآءَكُمۡ ذِكۡرٞ مِّن رَّبِّكُمۡ عَلَىٰ رَجُلٖ مِّنكُمۡ لِيُنذِرَكُمۡ وَلِتَتَّقُواْ وَلَعَلَّكُمۡ تُرۡحَمُونَ",
    "ayah_text_no_diacratic" : "اوعجبتم ان جاءكم ذكر من ربكم علىٰ رجل منكم لينذركم ولتتقوا ولعلكم ترحمون",
