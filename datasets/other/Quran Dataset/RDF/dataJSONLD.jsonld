  }, {
    "@id" : "quran:2693",
    "ayah_text" : "ٱلۡمُلۡكُ يَوۡمَئِذٖ لِّلَّهِ يَحۡكُمُ بَيۡنَهُمۡۚ فَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فِي جَنَّٰتِ ٱلنَّعِيمِ",
    "ayah_text_no_diacratic" : "الملك يومئذ لله يحكم بينهم فالذين ءامنوا وعملوا الصٰلحٰت في جنٰت النعيم",
    "ayahnumber" : "56",
    "chapter" : "17",
    "hizb" : "33",
