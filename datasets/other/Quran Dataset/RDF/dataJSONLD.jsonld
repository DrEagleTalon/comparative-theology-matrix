    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:110",
    "ayah_text" : "أَوَكُلَّمَا عَٰهَدُواْ عَهۡدٗا نَّبَذَهُۥ فَرِيقٞ مِّنۡهُمۚ بَلۡ أَكۡثَرُهُمۡ لَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "اوكلما عٰهدوا عهدا نبذه فريق منهم بل اكثرهم لا يؤمنون",
    "ayahnumber" : "100",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "110",
    "page" : "15",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1100",
    "ayah_text" : "فَأَرۡسَلۡنَا عَلَيۡهِمُ ٱلطُّوفَانَ وَٱلۡجَرَادَ وَٱلۡقُمَّلَ وَٱلضَّفَادِعَ وَٱلدَّمَ ءَايَٰتٖ مُّفَصَّلَٰتٖ فَٱسۡتَكۡبَرُواْ وَكَانُواْ قَوۡمٗا مُّجۡرِمِينَ",
    "ayah_text_no_diacratic" : "فارسلنا عليهم الطوفان والجراد والقمل والضفادع والدم ءايٰت مفصلٰت فاستكبروا وكانوا قوما مجرمين",
    "ayahnumber" : "133",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1100",
    "page" : "166",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1101",
    "ayah_text" : "وَلَمَّا وَقَعَ عَلَيۡهِمُ ٱلرِّجۡزُ قَالُواْ يَٰمُوسَى ٱدۡعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَۖ لَئِن كَشَفۡتَ عَنَّا ٱلرِّجۡزَ لَنُؤۡمِنَنَّ لَكَ وَلَنُرۡسِلَنَّ مَعَكَ بَنِيٓ إِسۡرَٰٓءِيلَ",
    "ayah_text_no_diacratic" : "ولما وقع عليهم الرجز قالوا يٰموسى ادع لنا ربك بما عهد عندك لئن كشفت عنا الرجز لنؤمنن لك ولنرسلن معك بني اسرٰءيل",
    "ayahnumber" : "134",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1101",
    "page" : "166",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1102",
    "ayah_text" : "فَلَمَّا كَشَفۡنَا عَنۡهُمُ ٱلرِّجۡزَ إِلَىٰٓ أَجَلٍ هُم بَٰلِغُوهُ إِذَا هُمۡ يَنكُثُونَ",
    "ayah_text_no_diacratic" : "فلما كشفنا عنهم الرجز الىٰ اجل هم بٰلغوه اذا هم ينكثون",
    "ayahnumber" : "135",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1102",
    "page" : "166",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1103",
    "ayah_text" : "فَٱنتَقَمۡنَا مِنۡهُمۡ فَأَغۡرَقۡنَٰهُمۡ فِي ٱلۡيَمِّ بِأَنَّهُمۡ كَذَّبُواْ بِـَٔايَٰتِنَا وَكَانُواْ عَنۡهَا غَٰفِلِينَ",
    "ayah_text_no_diacratic" : "فانتقمنا منهم فاغرقنٰهم في اليم بانهم كذبوا بايٰتنا وكانوا عنها غٰفلين",
    "ayahnumber" : "136",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1103",
    "page" : "166",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1104",
    "ayah_text" : "وَأَوۡرَثۡنَا ٱلۡقَوۡمَ ٱلَّذِينَ كَانُواْ يُسۡتَضۡعَفُونَ مَشَٰرِقَ ٱلۡأَرۡضِ وَمَغَٰرِبَهَا ٱلَّتِي بَٰرَكۡنَا فِيهَاۖ وَتَمَّتۡ كَلِمَتُ رَبِّكَ ٱلۡحُسۡنَىٰ عَلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ بِمَا صَبَرُواْۖ وَدَمَّرۡنَا مَا كَانَ يَصۡنَعُ فِرۡعَوۡنُ وَقَوۡمُهُۥ وَمَا كَانُواْ يَعۡرِشُونَ",
    "ayah_text_no_diacratic" : "واورثنا القوم الذين كانوا يستضعفون مشٰرق الارض ومغٰربها التي بٰركنا فيها وتمت كلمت ربك الحسنىٰ علىٰ بني اسرٰءيل بما صبروا ودمرنا ما كان يصنع فرعون وقومه وما كانوا يعرشون",
    "ayahnumber" : "137",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1104",
    "page" : "166",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1105",
    "ayah_text" : "وَجَٰوَزۡنَا بِبَنِيٓ إِسۡرَٰٓءِيلَ ٱلۡبَحۡرَ فَأَتَوۡاْ عَلَىٰ قَوۡمٖ يَعۡكُفُونَ عَلَىٰٓ أَصۡنَامٖ لَّهُمۡۚ قَالُواْ يَٰمُوسَى ٱجۡعَل لَّنَآ إِلَٰهٗا كَمَا لَهُمۡ ءَالِهَةٞۚ قَالَ إِنَّكُمۡ قَوۡمٞ تَجۡهَلُونَ",
    "ayah_text_no_diacratic" : "وجٰوزنا ببني اسرٰءيل البحر فاتوا علىٰ قوم يعكفون علىٰ اصنام لهم قالوا يٰموسى اجعل لنا الٰها كما لهم ءالهة قال انكم قوم تجهلون",
    "ayahnumber" : "138",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1105",
    "page" : "167",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1106",
    "ayah_text" : "إِنَّ هَٰٓؤُلَآءِ مُتَبَّرٞ مَّا هُمۡ فِيهِ وَبَٰطِلٞ مَّا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ان هٰؤلاء متبر ما هم فيه وبٰطل ما كانوا يعملون",
