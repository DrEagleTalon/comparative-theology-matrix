    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4590",
    "ayah_text" : "هَٰذَا كِتَٰبُنَا يَنطِقُ عَلَيۡكُم بِٱلۡحَقِّۚ إِنَّا كُنَّا نَسۡتَنسِخُ مَا كُنتُمۡ تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "هٰذا كتٰبنا ينطق عليكم بالحق انا كنا نستنسخ ما كنتم تعملون",
