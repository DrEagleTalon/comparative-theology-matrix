    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1758",
    "ayah_text" : "وَيَقُولُ ٱلَّذِينَ كَفَرُواْ لَوۡلَآ أُنزِلَ عَلَيۡهِ ءَايَةٞ مِّن رَّبِّهِۦۚ قُلۡ إِنَّ ٱللَّهَ يُضِلُّ مَن يَشَآءُ وَيَهۡدِيٓ إِلَيۡهِ مَنۡ أَنَابَ",
    "ayah_text_no_diacratic" : "ويقول الذين كفروا لولا انزل عليه ءاية من ربه قل ان الله يضل من يشاء ويهدي اليه من اناب",
    "ayahnumber" : "27",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1758",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:1759",
    "ayah_text" : "ٱلَّذِينَ ءَامَنُواْ وَتَطۡمَئِنُّ قُلُوبُهُم بِذِكۡرِ ٱللَّهِۗ أَلَا بِذِكۡرِ ٱللَّهِ تَطۡمَئِنُّ ٱلۡقُلُوبُ",
    "ayah_text_no_diacratic" : "الذين ءامنوا وتطمئن قلوبهم بذكر الله الا بذكر الله تطمئن القلوب",
    "ayahnumber" : "28",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1759",
    "page" : "252",
    "surahname" : "سُورَةُ الرَّعۡدِ",
    "surahnumber" : "13",
    "surrahname_no_diacratic" : "سورة الرعد"
  }, {
    "@id" : "quran:176",
    "ayah_text" : "إِذۡ تَبَرَّأَ ٱلَّذِينَ ٱتُّبِعُواْ مِنَ ٱلَّذِينَ ٱتَّبَعُواْ وَرَأَوُاْ ٱلۡعَذَابَ وَتَقَطَّعَتۡ بِهِمُ ٱلۡأَسۡبَابُ",
    "ayah_text_no_diacratic" : "اذ تبرا الذين اتبعوا من الذين اتبعوا وراوا العذاب وتقطعت بهم الاسباب",
    "ayahnumber" : "166",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "176",
    "page" : "25",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1760",
    "ayah_text" : "ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ طُوبَىٰ لَهُمۡ وَحُسۡنُ مَـَٔابٖ",
    "ayah_text_no_diacratic" : "الذين ءامنوا وعملوا الصٰلحٰت طوبىٰ لهم وحسن ماب",
    "ayahnumber" : "29",
    "chapter" : "13",
    "hizb" : "25",
