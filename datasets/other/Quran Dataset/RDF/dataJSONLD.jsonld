    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2807",
    "ayah_text" : "بَلۡ أَتَيۡنَٰهُم بِٱلۡحَقِّ وَإِنَّهُمۡ لَكَٰذِبُونَ",
    "ayah_text_no_diacratic" : "بل اتينٰهم بالحق وانهم لكٰذبون",
    "ayahnumber" : "90",
    "chapter" : "18",
