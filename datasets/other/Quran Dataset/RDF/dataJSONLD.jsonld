    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3690",
    "ayah_text" : "وَجَعَلۡنَا بَيۡنَهُمۡ وَبَيۡنَ ٱلۡقُرَى ٱلَّتِي بَٰرَكۡنَا فِيهَا قُرٗى ظَٰهِرَةٗ وَقَدَّرۡنَا فِيهَا ٱلسَّيۡرَۖ سِيرُواْ فِيهَا لَيَالِيَ وَأَيَّامًا ءَامِنِينَ",
    "ayah_text_no_diacratic" : "وجعلنا بينهم وبين القرى التي بٰركنا فيها قرى ظٰهرة وقدرنا فيها السير سيروا فيها ليالي واياما ءامنين",
    "ayahnumber" : "18",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3690",
    "page" : "430",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3691",
    "ayah_text" : "فَقَالُواْ رَبَّنَا بَٰعِدۡ بَيۡنَ أَسۡفَارِنَا وَظَلَمُوٓاْ أَنفُسَهُمۡ فَجَعَلۡنَٰهُمۡ أَحَادِيثَ وَمَزَّقۡنَٰهُمۡ كُلَّ مُمَزَّقٍۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّكُلِّ صَبَّارٖ شَكُورٖ",
    "ayah_text_no_diacratic" : "فقالوا ربنا بٰعد بين اسفارنا وظلموا انفسهم فجعلنٰهم احاديث ومزقنٰهم كل ممزق ان في ذٰلك لايٰت لكل صبار شكور",
    "ayahnumber" : "19",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3691",
    "page" : "430",
    "surahname" : "سُورَةُ سَبَإٍ",
    "surahnumber" : "34",
    "surrahname_no_diacratic" : "سورة سبا"
  }, {
    "@id" : "quran:3692",
    "ayah_text" : "وَلَقَدۡ صَدَّقَ عَلَيۡهِمۡ إِبۡلِيسُ ظَنَّهُۥ فَٱتَّبَعُوهُ إِلَّا فَرِيقٗا مِّنَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ولقد صدق عليهم ابليس ظنه فاتبعوه الا فريقا من المؤمنين",
    "ayahnumber" : "20",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3692",
