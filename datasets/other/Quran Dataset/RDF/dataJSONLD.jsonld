  }, {
    "@id" : "quran:5420",
    "ayah_text" : "إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",
    "ayah_text_no_diacratic" : "اذا تتلىٰ عليه ءايٰتنا قال اسٰطير الاولين",
