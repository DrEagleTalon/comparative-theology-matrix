    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3728",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3728",
    "page" : "434",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3729",
    "ayah_text" : "ٱلۡحَمۡدُ لِلَّهِ فَاطِرِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ جَاعِلِ ٱلۡمَلَٰٓئِكَةِ رُسُلًا أُوْلِيٓ أَجۡنِحَةٖ مَّثۡنَىٰ وَثُلَٰثَ وَرُبَٰعَۚ يَزِيدُ فِي ٱلۡخَلۡقِ مَا يَشَآءُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ",
    "ayah_text_no_diacratic" : "الحمد لله فاطر السمٰوٰت والارض جاعل الملٰئكة رسلا اولي اجنحة مثنىٰ وثلٰث وربٰع يزيد في الخلق ما يشاء ان الله علىٰ كل شيء قدير",
    "ayahnumber" : "1",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3729",
    "page" : "434",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:373",
    "ayah_text" : "۞وَمِنۡ أَهۡلِ ٱلۡكِتَٰبِ مَنۡ إِن تَأۡمَنۡهُ بِقِنطَارٖ يُؤَدِّهِۦٓ إِلَيۡكَ وَمِنۡهُم مَّنۡ إِن تَأۡمَنۡهُ بِدِينَارٖ لَّا يُؤَدِّهِۦٓ إِلَيۡكَ إِلَّا مَا دُمۡتَ عَلَيۡهِ قَآئِمٗاۗ ذَٰلِكَ بِأَنَّهُمۡ قَالُواْ لَيۡسَ عَلَيۡنَا فِي ٱلۡأُمِّيِّـۧنَ سَبِيلٞ وَيَقُولُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ وَهُمۡ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ومن اهل الكتٰب من ان تامنه بقنطار يؤده اليك ومنهم من ان تامنه بدينار لا يؤده اليك الا ما دمت عليه قائما ذٰلك بانهم قالوا ليس علينا في الامين سبيل ويقولون على الله الكذب وهم يعلمون",
    "ayahnumber" : "75",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "373",
    "page" : "59",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3730",
    "ayah_text" : "مَّا يَفۡتَحِ ٱللَّهُ لِلنَّاسِ مِن رَّحۡمَةٖ فَلَا مُمۡسِكَ لَهَاۖ وَمَا يُمۡسِكۡ فَلَا مُرۡسِلَ لَهُۥ مِنۢ بَعۡدِهِۦۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "ما يفتح الله للناس من رحمة فلا ممسك لها وما يمسك فلا مرسل له من بعده وهو العزيز الحكيم",
    "ayahnumber" : "2",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3730",
    "page" : "434",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3731",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ ٱذۡكُرُواْ نِعۡمَتَ ٱللَّهِ عَلَيۡكُمۡۚ هَلۡ مِنۡ خَٰلِقٍ غَيۡرُ ٱللَّهِ يَرۡزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِۚ لَآ إِلَٰهَ إِلَّا هُوَۖ فَأَنَّىٰ تُؤۡفَكُونَ",
    "ayah_text_no_diacratic" : "يٰايها الناس اذكروا نعمت الله عليكم هل من خٰلق غير الله يرزقكم من السماء والارض لا الٰه الا هو فانىٰ تؤفكون",
    "ayahnumber" : "3",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3731",
    "page" : "434",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3732",
    "ayah_text" : "وَإِن يُكَذِّبُوكَ فَقَدۡ كُذِّبَتۡ رُسُلٞ مِّن قَبۡلِكَۚ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ",
    "ayah_text_no_diacratic" : "وان يكذبوك فقد كذبت رسل من قبلك والى الله ترجع الامور",
    "ayahnumber" : "4",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3732",
    "page" : "435",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3733",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلنَّاسُ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞۖ فَلَا تَغُرَّنَّكُمُ ٱلۡحَيَوٰةُ ٱلدُّنۡيَا وَلَا يَغُرَّنَّكُم بِٱللَّهِ ٱلۡغَرُورُ",
    "ayah_text_no_diacratic" : "يٰايها الناس ان وعد الله حق فلا تغرنكم الحيوٰة الدنيا ولا يغرنكم بالله الغرور",
    "ayahnumber" : "5",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3733",
    "page" : "435",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3734",
    "ayah_text" : "إِنَّ ٱلشَّيۡطَٰنَ لَكُمۡ عَدُوّٞ فَٱتَّخِذُوهُ عَدُوًّاۚ إِنَّمَا يَدۡعُواْ حِزۡبَهُۥ لِيَكُونُواْ مِنۡ أَصۡحَٰبِ ٱلسَّعِيرِ",
    "ayah_text_no_diacratic" : "ان الشيطٰن لكم عدو فاتخذوه عدوا انما يدعوا حزبه ليكونوا من اصحٰب السعير",
    "ayahnumber" : "6",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3734",
    "page" : "435",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3735",
    "ayah_text" : "ٱلَّذِينَ كَفَرُواْ لَهُمۡ عَذَابٞ شَدِيدٞۖ وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُم مَّغۡفِرَةٞ وَأَجۡرٞ كَبِيرٌ",
    "ayah_text_no_diacratic" : "الذين كفروا لهم عذاب شديد والذين ءامنوا وعملوا الصٰلحٰت لهم مغفرة واجر كبير",
    "ayahnumber" : "7",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3735",
    "page" : "435",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3736",
    "ayah_text" : "أَفَمَن زُيِّنَ لَهُۥ سُوٓءُ عَمَلِهِۦ فَرَءَاهُ حَسَنٗاۖ فَإِنَّ ٱللَّهَ يُضِلُّ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۖ فَلَا تَذۡهَبۡ نَفۡسُكَ عَلَيۡهِمۡ حَسَرَٰتٍۚ إِنَّ ٱللَّهَ عَلِيمُۢ بِمَا يَصۡنَعُونَ",
    "ayah_text_no_diacratic" : "افمن زين له سوء عمله فرءاه حسنا فان الله يضل من يشاء ويهدي من يشاء فلا تذهب نفسك عليهم حسرٰت ان الله عليم بما يصنعون",
    "ayahnumber" : "8",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3736",
    "page" : "435",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3737",
    "ayah_text" : "وَٱللَّهُ ٱلَّذِيٓ أَرۡسَلَ ٱلرِّيَٰحَ فَتُثِيرُ سَحَابٗا فَسُقۡنَٰهُ إِلَىٰ بَلَدٖ مَّيِّتٖ فَأَحۡيَيۡنَا بِهِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَاۚ كَذَٰلِكَ ٱلنُّشُورُ",
    "ayah_text_no_diacratic" : "والله الذي ارسل الريٰح فتثير سحابا فسقنٰه الىٰ بلد ميت فاحيينا به الارض بعد موتها كذٰلك النشور",
    "ayahnumber" : "9",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3737",
    "page" : "435",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3738",
    "ayah_text" : "مَن كَانَ يُرِيدُ ٱلۡعِزَّةَ فَلِلَّهِ ٱلۡعِزَّةُ جَمِيعًاۚ إِلَيۡهِ يَصۡعَدُ ٱلۡكَلِمُ ٱلطَّيِّبُ وَٱلۡعَمَلُ ٱلصَّٰلِحُ يَرۡفَعُهُۥۚ وَٱلَّذِينَ يَمۡكُرُونَ ٱلسَّيِّـَٔاتِ لَهُمۡ عَذَابٞ شَدِيدٞۖ وَمَكۡرُ أُوْلَٰٓئِكَ هُوَ يَبُورُ",
    "ayah_text_no_diacratic" : "من كان يريد العزة فلله العزة جميعا اليه يصعد الكلم الطيب والعمل الصٰلح يرفعه والذين يمكرون السيات لهم عذاب شديد ومكر اولٰئك هو يبور",
    "ayahnumber" : "10",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3738",
    "page" : "435",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3739",
    "ayah_text" : "وَٱللَّهُ خَلَقَكُم مِّن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ جَعَلَكُمۡ أَزۡوَٰجٗاۚ وَمَا تَحۡمِلُ مِنۡ أُنثَىٰ وَلَا تَضَعُ إِلَّا بِعِلۡمِهِۦۚ وَمَا يُعَمَّرُ مِن مُّعَمَّرٖ وَلَا يُنقَصُ مِنۡ عُمُرِهِۦٓ إِلَّا فِي كِتَٰبٍۚ إِنَّ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٞ",
    "ayah_text_no_diacratic" : "والله خلقكم من تراب ثم من نطفة ثم جعلكم ازوٰجا وما تحمل من انثىٰ ولا تضع الا بعلمه وما يعمر من معمر ولا ينقص من عمره الا في كتٰب ان ذٰلك على الله يسير",
    "ayahnumber" : "11",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3739",
    "page" : "435",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:374",
    "ayah_text" : "بَلَىٰۚ مَنۡ أَوۡفَىٰ بِعَهۡدِهِۦ وَٱتَّقَىٰ فَإِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "بلىٰ من اوفىٰ بعهده واتقىٰ فان الله يحب المتقين",
    "ayahnumber" : "76",
    "chapter" : "3",
    "hizb" : "6",
    "index" : "374",
    "page" : "59",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3740",
    "ayah_text" : "وَمَا يَسۡتَوِي ٱلۡبَحۡرَانِ هَٰذَا عَذۡبٞ فُرَاتٞ سَآئِغٞ شَرَابُهُۥ وَهَٰذَا مِلۡحٌ أُجَاجٞۖ وَمِن كُلّٖ تَأۡكُلُونَ لَحۡمٗا طَرِيّٗا وَتَسۡتَخۡرِجُونَ حِلۡيَةٗ تَلۡبَسُونَهَاۖ وَتَرَى ٱلۡفُلۡكَ فِيهِ مَوَاخِرَ لِتَبۡتَغُواْ مِن فَضۡلِهِۦ وَلَعَلَّكُمۡ تَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "وما يستوي البحران هٰذا عذب فرات سائغ شرابه وهٰذا ملح اجاج ومن كل تاكلون لحما طريا وتستخرجون حلية تلبسونها وترى الفلك فيه مواخر لتبتغوا من فضله ولعلكم تشكرون",
    "ayahnumber" : "12",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3740",
    "page" : "436",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3741",
    "ayah_text" : "يُولِجُ ٱلَّيۡلَ فِي ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِي ٱلَّيۡلِ وَسَخَّرَ ٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ يَجۡرِي لِأَجَلٖ مُّسَمّٗىۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ لَهُ ٱلۡمُلۡكُۚ وَٱلَّذِينَ تَدۡعُونَ مِن دُونِهِۦ مَا يَمۡلِكُونَ مِن قِطۡمِيرٍ",
    "ayah_text_no_diacratic" : "يولج اليل في النهار ويولج النهار في اليل وسخر الشمس والقمر كل يجري لاجل مسمى ذٰلكم الله ربكم له الملك والذين تدعون من دونه ما يملكون من قطمير",
    "ayahnumber" : "13",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3741",
    "page" : "436",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3742",
    "ayah_text" : "إِن تَدۡعُوهُمۡ لَا يَسۡمَعُواْ دُعَآءَكُمۡ وَلَوۡ سَمِعُواْ مَا ٱسۡتَجَابُواْ لَكُمۡۖ وَيَوۡمَ ٱلۡقِيَٰمَةِ يَكۡفُرُونَ بِشِرۡكِكُمۡۚ وَلَا يُنَبِّئُكَ مِثۡلُ خَبِيرٖ",
    "ayah_text_no_diacratic" : "ان تدعوهم لا يسمعوا دعاءكم ولو سمعوا ما استجابوا لكم ويوم القيٰمة يكفرون بشرككم ولا ينبئك مثل خبير",
    "ayahnumber" : "14",
    "chapter" : "22",
    "hizb" : "43",
    "index" : "3742",
    "page" : "436",
    "surahname" : "سُورَةُ فَاطِرٍ",
    "surahnumber" : "35",
    "surrahname_no_diacratic" : "سورة فاطر"
  }, {
    "@id" : "quran:3743",
    "ayah_text" : "۞يَٰٓأَيُّهَا ٱلنَّاسُ أَنتُمُ ٱلۡفُقَرَآءُ إِلَى ٱللَّهِۖ وَٱللَّهُ هُوَ ٱلۡغَنِيُّ ٱلۡحَمِيدُ",
    "ayah_text_no_diacratic" : "يٰايها الناس انتم الفقراء الى الله والله هو الغني الحميد",
    "ayahnumber" : "15",
    "chapter" : "22",
    "hizb" : "43",
