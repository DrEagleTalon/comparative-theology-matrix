    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:297",
    "ayah_text" : "سُورَةُ آلِ عِمۡرَانَ",
    "ayah_text_no_diacratic" : "سورة ال عمران",
    "ayahnumber" : "0",
