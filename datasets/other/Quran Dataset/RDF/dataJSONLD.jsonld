    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2399",
    "ayah_text" : "وَأَنَا ٱخۡتَرۡتُكَ فَٱسۡتَمِعۡ لِمَا يُوحَىٰٓ",
