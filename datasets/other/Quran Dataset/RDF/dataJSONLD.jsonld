    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:302",
    "ayah_text" : "مِن قَبۡلُ هُدٗى لِّلنَّاسِ وَأَنزَلَ ٱلۡفُرۡقَانَۗ إِنَّ ٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِ ٱللَّهِ لَهُمۡ عَذَابٞ شَدِيدٞۗ وَٱللَّهُ عَزِيزٞ ذُو ٱنتِقَامٍ",
    "ayah_text_no_diacratic" : "من قبل هدى للناس وانزل الفرقان ان الذين كفروا بايٰت الله لهم عذاب شديد والله عزيز ذو انتقام",
    "ayahnumber" : "4",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "302",
    "page" : "50",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3020",
    "ayah_text" : "فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ",
    "ayah_text_no_diacratic" : "فجمع السحرة لميقٰت يوم معلوم",
    "ayahnumber" : "38",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3020",
    "page" : "368",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3021",
    "ayah_text" : "وَقِيلَ لِلنَّاسِ هَلۡ أَنتُم مُّجۡتَمِعُونَ",
    "ayah_text_no_diacratic" : "وقيل للناس هل انتم مجتمعون",
    "ayahnumber" : "39",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3021",
    "page" : "368",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3022",
    "ayah_text" : "لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُواْ هُمُ ٱلۡغَٰلِبِينَ",
    "ayah_text_no_diacratic" : "لعلنا نتبع السحرة ان كانوا هم الغٰلبين",
    "ayahnumber" : "40",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3022",
    "page" : "369",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3023",
    "ayah_text" : "فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُواْ لِفِرۡعَوۡنَ أَئِنَّ لَنَا لَأَجۡرًا إِن كُنَّا نَحۡنُ ٱلۡغَٰلِبِينَ",
    "ayah_text_no_diacratic" : "فلما جاء السحرة قالوا لفرعون ائن لنا لاجرا ان كنا نحن الغٰلبين",
    "ayahnumber" : "41",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3023",
    "page" : "369",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3024",
    "ayah_text" : "قَالَ نَعَمۡ وَإِنَّكُمۡ إِذٗا لَّمِنَ ٱلۡمُقَرَّبِينَ",
    "ayah_text_no_diacratic" : "قال نعم وانكم اذا لمن المقربين",
    "ayahnumber" : "42",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3024",
    "page" : "369",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3025",
    "ayah_text" : "قَالَ لَهُم مُّوسَىٰٓ أَلۡقُواْ مَآ أَنتُم مُّلۡقُونَ",
    "ayah_text_no_diacratic" : "قال لهم موسىٰ القوا ما انتم ملقون",
    "ayahnumber" : "43",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3025",
    "page" : "369",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3026",
    "ayah_text" : "فَأَلۡقَوۡاْ حِبَالَهُمۡ وَعِصِيَّهُمۡ وَقَالُواْ بِعِزَّةِ فِرۡعَوۡنَ إِنَّا لَنَحۡنُ ٱلۡغَٰلِبُونَ",
    "ayah_text_no_diacratic" : "فالقوا حبالهم وعصيهم وقالوا بعزة فرعون انا لنحن الغٰلبون",
    "ayahnumber" : "44",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3026",
    "page" : "369",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3027",
    "ayah_text" : "فَأَلۡقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِيَ تَلۡقَفُ مَا يَأۡفِكُونَ",
    "ayah_text_no_diacratic" : "فالقىٰ موسىٰ عصاه فاذا هي تلقف ما يافكون",
