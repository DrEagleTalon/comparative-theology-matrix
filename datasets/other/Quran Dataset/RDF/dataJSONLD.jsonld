  }, {
    "@id" : "quran:4198",
    "ayah_text" : "قُلۡ أَفَغَيۡرَ ٱللَّهِ تَأۡمُرُوٓنِّيٓ أَعۡبُدُ أَيُّهَا ٱلۡجَٰهِلُونَ",
    "ayah_text_no_diacratic" : "قل افغير الله تامروني اعبد ايها الجٰهلون",
    "ayahnumber" : "64",
    "chapter" : "24",
    "hizb" : "46",
