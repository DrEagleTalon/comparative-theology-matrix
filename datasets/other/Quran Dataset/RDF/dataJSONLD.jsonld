    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5211",
    "ayah_text" : "ٱلَّذِينَ يَبۡخَلُونَ وَيَأۡمُرُونَ ٱلنَّاسَ بِٱلۡبُخۡلِۗ وَمَن يَتَوَلَّ فَإِنَّ ٱللَّهَ هُوَ ٱلۡغَنِيُّ ٱلۡحَمِيدُ",
    "ayah_text_no_diacratic" : "الذين يبخلون ويامرون الناس بالبخل ومن يتول فان الله هو الغني الحميد",
    "ayahnumber" : "24",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5211",
    "page" : "540",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5212",
    "ayah_text" : "لَقَدۡ أَرۡسَلۡنَا رُسُلَنَا بِٱلۡبَيِّنَٰتِ وَأَنزَلۡنَا مَعَهُمُ ٱلۡكِتَٰبَ وَٱلۡمِيزَانَ لِيَقُومَ ٱلنَّاسُ بِٱلۡقِسۡطِۖ وَأَنزَلۡنَا ٱلۡحَدِيدَ فِيهِ بَأۡسٞ شَدِيدٞ وَمَنَٰفِعُ لِلنَّاسِ وَلِيَعۡلَمَ ٱللَّهُ مَن يَنصُرُهُۥ وَرُسُلَهُۥ بِٱلۡغَيۡبِۚ إِنَّ ٱللَّهَ قَوِيٌّ عَزِيزٞ",
    "ayah_text_no_diacratic" : "لقد ارسلنا رسلنا بالبينٰت وانزلنا معهم الكتٰب والميزان ليقوم الناس بالقسط وانزلنا الحديد فيه باس شديد ومنٰفع للناس وليعلم الله من ينصره ورسله بالغيب ان الله قوي عزيز",
    "ayahnumber" : "25",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5212",
    "page" : "541",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5213",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا نُوحٗا وَإِبۡرَٰهِيمَ وَجَعَلۡنَا فِي ذُرِّيَّتِهِمَا ٱلنُّبُوَّةَ وَٱلۡكِتَٰبَۖ فَمِنۡهُم مُّهۡتَدٖۖ وَكَثِيرٞ مِّنۡهُمۡ فَٰسِقُونَ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا نوحا وابرٰهيم وجعلنا في ذريتهما النبوة والكتٰب فمنهم مهتد وكثير منهم فٰسقون",
    "ayahnumber" : "26",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5213",
    "page" : "541",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5214",
    "ayah_text" : "ثُمَّ قَفَّيۡنَا عَلَىٰٓ ءَاثَٰرِهِم بِرُسُلِنَا وَقَفَّيۡنَا بِعِيسَى ٱبۡنِ مَرۡيَمَ وَءَاتَيۡنَٰهُ ٱلۡإِنجِيلَۖ وَجَعَلۡنَا فِي قُلُوبِ ٱلَّذِينَ ٱتَّبَعُوهُ رَأۡفَةٗ وَرَحۡمَةٗۚ وَرَهۡبَانِيَّةً ٱبۡتَدَعُوهَا مَا كَتَبۡنَٰهَا عَلَيۡهِمۡ إِلَّا ٱبۡتِغَآءَ رِضۡوَٰنِ ٱللَّهِ فَمَا رَعَوۡهَا حَقَّ رِعَايَتِهَاۖ فَـَٔاتَيۡنَا ٱلَّذِينَ ءَامَنُواْ مِنۡهُمۡ أَجۡرَهُمۡۖ وَكَثِيرٞ مِّنۡهُمۡ فَٰسِقُونَ",
    "ayah_text_no_diacratic" : "ثم قفينا علىٰ ءاثٰرهم برسلنا وقفينا بعيسى ابن مريم وءاتينٰه الانجيل وجعلنا في قلوب الذين اتبعوه رافة ورحمة ورهبانية ابتدعوها ما كتبنٰها عليهم الا ابتغاء رضوٰن الله فما رعوها حق رعايتها فاتينا الذين ءامنوا منهم اجرهم وكثير منهم فٰسقون",
    "ayahnumber" : "27",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5214",
    "page" : "541",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5215",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ وَءَامِنُواْ بِرَسُولِهِۦ يُؤۡتِكُمۡ كِفۡلَيۡنِ مِن رَّحۡمَتِهِۦ وَيَجۡعَل لَّكُمۡ نُورٗا تَمۡشُونَ بِهِۦ وَيَغۡفِرۡ لَكُمۡۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اتقوا الله وءامنوا برسوله يؤتكم كفلين من رحمته ويجعل لكم نورا تمشون به ويغفر لكم والله غفور رحيم",
    "ayahnumber" : "28",
    "chapter" : "27",
    "hizb" : "54",
    "index" : "5215",
    "page" : "541",
    "surahname" : "سُورَةُ الحَدِيدِ",
    "surahnumber" : "57",
    "surrahname_no_diacratic" : "سورة الحديد"
  }, {
    "@id" : "quran:5216",
    "ayah_text" : "لِّئَلَّا يَعۡلَمَ أَهۡلُ ٱلۡكِتَٰبِ أَلَّا يَقۡدِرُونَ عَلَىٰ شَيۡءٖ مِّن فَضۡلِ ٱللَّهِ وَأَنَّ ٱلۡفَضۡلَ بِيَدِ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۚ وَٱللَّهُ ذُو ٱلۡفَضۡلِ ٱلۡعَظِيمِ",
    "ayah_text_no_diacratic" : "لئلا يعلم اهل الكتٰب الا يقدرون علىٰ شيء من فضل الله وان الفضل بيد الله يؤتيه من يشاء والله ذو الفضل العظيم",
    "ayahnumber" : "29",
