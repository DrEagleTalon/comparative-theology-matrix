    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4941",
    "ayah_text" : "وَٱلۡمُؤۡتَفِكَةَ أَهۡوَىٰ",
    "ayah_text_no_diacratic" : "والمؤتفكة اهوىٰ",
    "ayahnumber" : "53",
    "chapter" : "27",
