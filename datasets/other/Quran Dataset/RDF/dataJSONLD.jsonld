    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1780",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَا مِن رَّسُولٍ إِلَّا بِلِسَانِ قَوۡمِهِۦ لِيُبَيِّنَ لَهُمۡۖ فَيُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "وما ارسلنا من رسول الا بلسان قومه ليبين لهم فيضل الله من يشاء ويهدي من يشاء وهو العزيز الحكيم",
    "ayahnumber" : "4",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1780",
    "page" : "255",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1781",
    "ayah_text" : "وَلَقَدۡ أَرۡسَلۡنَا مُوسَىٰ بِـَٔايَٰتِنَآ أَنۡ أَخۡرِجۡ قَوۡمَكَ مِنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِ وَذَكِّرۡهُم بِأَيَّىٰمِ ٱللَّهِۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّكُلِّ صَبَّارٖ شَكُورٖ",
    "ayah_text_no_diacratic" : "ولقد ارسلنا موسىٰ بايٰتنا ان اخرج قومك من الظلمٰت الى النور وذكرهم بايىٰم الله ان في ذٰلك لايٰت لكل صبار شكور",
    "ayahnumber" : "5",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1781",
    "page" : "255",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1782",
    "ayah_text" : "وَإِذۡ قَالَ مُوسَىٰ لِقَوۡمِهِ ٱذۡكُرُواْ نِعۡمَةَ ٱللَّهِ عَلَيۡكُمۡ إِذۡ أَنجَىٰكُم مِّنۡ ءَالِ فِرۡعَوۡنَ يَسُومُونَكُمۡ سُوٓءَ ٱلۡعَذَابِ وَيُذَبِّحُونَ أَبۡنَآءَكُمۡ وَيَسۡتَحۡيُونَ نِسَآءَكُمۡۚ وَفِي ذَٰلِكُم بَلَآءٞ مِّن رَّبِّكُمۡ عَظِيمٞ",
    "ayah_text_no_diacratic" : "واذ قال موسىٰ لقومه اذكروا نعمة الله عليكم اذ انجىٰكم من ءال فرعون يسومونكم سوء العذاب ويذبحون ابناءكم ويستحيون نساءكم وفي ذٰلكم بلاء من ربكم عظيم",
    "ayahnumber" : "6",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1782",
    "page" : "256",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1783",
    "ayah_text" : "وَإِذۡ تَأَذَّنَ رَبُّكُمۡ لَئِن شَكَرۡتُمۡ لَأَزِيدَنَّكُمۡۖ وَلَئِن كَفَرۡتُمۡ إِنَّ عَذَابِي لَشَدِيدٞ",
    "ayah_text_no_diacratic" : "واذ تاذن ربكم لئن شكرتم لازيدنكم ولئن كفرتم ان عذابي لشديد",
    "ayahnumber" : "7",
    "chapter" : "13",
    "hizb" : "25",
    "index" : "1783",
    "page" : "256",
    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1784",
    "ayah_text" : "وَقَالَ مُوسَىٰٓ إِن تَكۡفُرُوٓاْ أَنتُمۡ وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا فَإِنَّ ٱللَّهَ لَغَنِيٌّ حَمِيدٌ",
    "ayah_text_no_diacratic" : "وقال موسىٰ ان تكفروا انتم ومن في الارض جميعا فان الله لغني حميد",
