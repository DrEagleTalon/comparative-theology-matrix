    "page" : "235",
    "surahname" : "سُورَةُ هُودٍ",
    "surahnumber" : "11",
    "surrahname_no_diacratic" : "سورة هود"
  }, {
    "@id" : "quran:1615",
    "ayah_text" : "وَٱنتَظِرُوٓاْ إِنَّا مُنتَظِرُونَ",
    "ayah_text_no_diacratic" : "وانتظروا انا منتظرون",
