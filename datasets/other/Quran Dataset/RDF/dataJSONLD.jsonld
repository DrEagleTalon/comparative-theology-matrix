    "surrahname_no_diacratic" : "سورة المعارج"
  }, {
    "@id" : "quran:555",
    "ayah_text" : "فَمِنۡهُم مَّنۡ ءَامَنَ بِهِۦ وَمِنۡهُم مَّن صَدَّ عَنۡهُۚ وَكَفَىٰ بِجَهَنَّمَ سَعِيرًا",
    "ayah_text_no_diacratic" : "فمنهم من ءامن به ومنهم من صد عنه وكفىٰ بجهنم سعيرا",
