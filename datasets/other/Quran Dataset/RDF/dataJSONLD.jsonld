  }, {
    "@id" : "quran:3868",
    "ayah_text" : "لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ",
    "ayah_text_no_diacratic" : "لا يسمعون الى الملا الاعلىٰ ويقذفون من كل جانب",
