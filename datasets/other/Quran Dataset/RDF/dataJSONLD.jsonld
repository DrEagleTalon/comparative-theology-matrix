    "surrahname_no_diacratic" : "سورة المائدة"
  }, {
    "@id" : "quran:772",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَيَبۡلُوَنَّكُمُ ٱللَّهُ بِشَيۡءٖ مِّنَ ٱلصَّيۡدِ تَنَالُهُۥٓ أَيۡدِيكُمۡ وَرِمَاحُكُمۡ لِيَعۡلَمَ ٱللَّهُ مَن يَخَافُهُۥ بِٱلۡغَيۡبِۚ فَمَنِ ٱعۡتَدَىٰ بَعۡدَ ذَٰلِكَ فَلَهُۥ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ليبلونكم الله بشيء من الصيد تناله ايديكم ورماحكم ليعلم الله من يخافه بالغيب فمن اعتدىٰ بعد ذٰلك فله عذاب اليم",
    "ayahnumber" : "94",
    "chapter" : "7",
    "hizb" : "12",
