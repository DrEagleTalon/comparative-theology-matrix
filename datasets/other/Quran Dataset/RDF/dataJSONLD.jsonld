    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1090",
    "ayah_text" : "قَالَ فِرۡعَوۡنُ ءَامَنتُم بِهِۦ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّ هَٰذَا لَمَكۡرٞ مَّكَرۡتُمُوهُ فِي ٱلۡمَدِينَةِ لِتُخۡرِجُواْ مِنۡهَآ أَهۡلَهَاۖ فَسَوۡفَ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "قال فرعون ءامنتم به قبل ان ءاذن لكم ان هٰذا لمكر مكرتموه في المدينة لتخرجوا منها اهلها فسوف تعلمون",
    "ayahnumber" : "123",
    "chapter" : "9",
    "hizb" : "16",
    "index" : "1090",
    "page" : "165",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1091",
    "ayah_text" : "لَأُقَطِّعَنَّ أَيۡدِيَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَٰفٖ ثُمَّ لَأُصَلِّبَنَّكُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "لاقطعن ايديكم وارجلكم من خلٰف ثم لاصلبنكم اجمعين",
    "ayahnumber" : "124",
    "chapter" : "9",
    "hizb" : "16",
