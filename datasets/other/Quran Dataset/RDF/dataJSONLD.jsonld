    "page" : "567",
    "surahname" : "سُورَةُ الحَاقَّةِ",
    "surahnumber" : "69",
    "surrahname_no_diacratic" : "سورة الحاقة"
  }, {
    "@id" : "quran:5473",
    "ayah_text" : "وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ",
    "ayah_text_no_diacratic" : "وحملت الارض والجبال فدكتا دكة وٰحدة",
