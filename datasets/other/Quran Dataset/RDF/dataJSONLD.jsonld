    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3871",
    "ayah_text" : "فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ",
    "ayah_text_no_diacratic" : "فاستفتهم اهم اشد خلقا ام من خلقنا انا خلقنٰهم من طين لازب",
