    "surahname" : "سُورَةُ المُجَادلَةِ",
    "surahnumber" : "58",
    "surrahname_no_diacratic" : "سورة المجادلة"
  }, {
    "@id" : "quran:5238",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يُحَآدُّونَ ٱللَّهَ وَرَسُولَهُۥٓ أُوْلَٰٓئِكَ فِي ٱلۡأَذَلِّينَ",
    "ayah_text_no_diacratic" : "ان الذين يحادون الله ورسوله اولٰئك في الاذلين",
