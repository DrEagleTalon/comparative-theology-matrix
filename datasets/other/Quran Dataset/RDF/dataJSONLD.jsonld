  }, {
    "@id" : "quran:5767",
    "ayah_text" : "وَمِنَ ٱلَّيۡلِ فَٱسۡجُدۡ لَهُۥ وَسَبِّحۡهُ لَيۡلٗا طَوِيلًا",
    "ayah_text_no_diacratic" : "ومن اليل فاسجد له وسبحه ليلا طويلا",
    "ayahnumber" : "26",
    "chapter" : "29",
    "hizb" : "58",
