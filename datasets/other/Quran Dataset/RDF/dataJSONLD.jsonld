    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:495",
    "ayah_text" : "مَتَٰعٞ قَلِيلٞ ثُمَّ مَأۡوَىٰهُمۡ جَهَنَّمُۖ وَبِئۡسَ ٱلۡمِهَادُ",
    "ayah_text_no_diacratic" : "متٰع قليل ثم ماوىٰهم جهنم وبئس المهاد",
    "ayahnumber" : "197",
    "chapter" : "4",
