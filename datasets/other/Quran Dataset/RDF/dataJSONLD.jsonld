    "surahname" : "سُورَةُ الزُّمَرِ",
    "surahnumber" : "39",
    "surrahname_no_diacratic" : "سورة الزمر"
  }, {
    "@id" : "quran:4152",
    "ayah_text" : "ٱلَّذِينَ يَسۡتَمِعُونَ ٱلۡقَوۡلَ فَيَتَّبِعُونَ أَحۡسَنَهُۥٓۚ أُوْلَٰٓئِكَ ٱلَّذِينَ هَدَىٰهُمُ ٱللَّهُۖ وَأُوْلَٰٓئِكَ هُمۡ أُوْلُواْ ٱلۡأَلۡبَٰبِ",
    "ayah_text_no_diacratic" : "الذين يستمعون القول فيتبعون احسنه اولٰئك الذين هدىٰهم الله واولٰئك هم اولوا الالبٰب",
    "ayahnumber" : "18",
    "chapter" : "23",
    "hizb" : "46",
