    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3310",
    "ayah_text" : "إِنَّ فِرۡعَوۡنَ عَلَا فِي ٱلۡأَرۡضِ وَجَعَلَ أَهۡلَهَا شِيَعٗا يَسۡتَضۡعِفُ طَآئِفَةٗ مِّنۡهُمۡ يُذَبِّحُ أَبۡنَآءَهُمۡ وَيَسۡتَحۡيِۦ نِسَآءَهُمۡۚ إِنَّهُۥ كَانَ مِنَ ٱلۡمُفۡسِدِينَ",
    "ayah_text_no_diacratic" : "ان فرعون علا في الارض وجعل اهلها شيعا يستضعف طائفة منهم يذبح ابناءهم ويستحي نساءهم انه كان من المفسدين",
    "ayahnumber" : "4",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3310",
    "page" : "385",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3311",
    "ayah_text" : "وَنُرِيدُ أَن نَّمُنَّ عَلَى ٱلَّذِينَ ٱسۡتُضۡعِفُواْ فِي ٱلۡأَرۡضِ وَنَجۡعَلَهُمۡ أَئِمَّةٗ وَنَجۡعَلَهُمُ ٱلۡوَٰرِثِينَ",
    "ayah_text_no_diacratic" : "ونريد ان نمن على الذين استضعفوا في الارض ونجعلهم ائمة ونجعلهم الوٰرثين",
    "ayahnumber" : "5",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3311",
    "page" : "385",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3312",
    "ayah_text" : "وَنُمَكِّنَ لَهُمۡ فِي ٱلۡأَرۡضِ وَنُرِيَ فِرۡعَوۡنَ وَهَٰمَٰنَ وَجُنُودَهُمَا مِنۡهُم مَّا كَانُواْ يَحۡذَرُونَ",
    "ayah_text_no_diacratic" : "ونمكن لهم في الارض ونري فرعون وهٰمٰن وجنودهما منهم ما كانوا يحذرون",
    "ayahnumber" : "6",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3312",
    "page" : "386",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3313",
    "ayah_text" : "وَأَوۡحَيۡنَآ إِلَىٰٓ أُمِّ مُوسَىٰٓ أَنۡ أَرۡضِعِيهِۖ فَإِذَا خِفۡتِ عَلَيۡهِ فَأَلۡقِيهِ فِي ٱلۡيَمِّ وَلَا تَخَافِي وَلَا تَحۡزَنِيٓۖ إِنَّا رَآدُّوهُ إِلَيۡكِ وَجَاعِلُوهُ مِنَ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "واوحينا الىٰ ام موسىٰ ان ارضعيه فاذا خفت عليه فالقيه في اليم ولا تخافي ولا تحزني انا رادوه اليك وجاعلوه من المرسلين",
    "ayahnumber" : "7",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3313",
    "page" : "386",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3314",
    "ayah_text" : "فَٱلۡتَقَطَهُۥٓ ءَالُ فِرۡعَوۡنَ لِيَكُونَ لَهُمۡ عَدُوّٗا وَحَزَنًاۗ إِنَّ فِرۡعَوۡنَ وَهَٰمَٰنَ وَجُنُودَهُمَا كَانُواْ خَٰطِـِٔينَ",
    "ayah_text_no_diacratic" : "فالتقطه ءال فرعون ليكون لهم عدوا وحزنا ان فرعون وهٰمٰن وجنودهما كانوا خٰطين",
    "ayahnumber" : "8",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3314",
    "page" : "386",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3315",
    "ayah_text" : "وَقَالَتِ ٱمۡرَأَتُ فِرۡعَوۡنَ قُرَّتُ عَيۡنٖ لِّي وَلَكَۖ لَا تَقۡتُلُوهُ عَسَىٰٓ أَن يَنفَعَنَآ أَوۡ نَتَّخِذَهُۥ وَلَدٗا وَهُمۡ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "وقالت امرات فرعون قرت عين لي ولك لا تقتلوه عسىٰ ان ينفعنا او نتخذه ولدا وهم لا يشعرون",
    "ayahnumber" : "9",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3315",
    "page" : "386",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3316",
    "ayah_text" : "وَأَصۡبَحَ فُؤَادُ أُمِّ مُوسَىٰ فَٰرِغًاۖ إِن كَادَتۡ لَتُبۡدِي بِهِۦ لَوۡلَآ أَن رَّبَطۡنَا عَلَىٰ قَلۡبِهَا لِتَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "واصبح فؤاد ام موسىٰ فٰرغا ان كادت لتبدي به لولا ان ربطنا علىٰ قلبها لتكون من المؤمنين",
    "ayahnumber" : "10",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3316",
    "page" : "386",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3317",
    "ayah_text" : "وَقَالَتۡ لِأُخۡتِهِۦ قُصِّيهِۖ فَبَصُرَتۡ بِهِۦ عَن جُنُبٖ وَهُمۡ لَا يَشۡعُرُونَ",
    "ayah_text_no_diacratic" : "وقالت لاخته قصيه فبصرت به عن جنب وهم لا يشعرون",
    "ayahnumber" : "11",
    "chapter" : "20",
    "hizb" : "38",
    "index" : "3317",
    "page" : "386",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3318",
    "ayah_text" : "۞وَحَرَّمۡنَا عَلَيۡهِ ٱلۡمَرَاضِعَ مِن قَبۡلُ فَقَالَتۡ هَلۡ أَدُلُّكُمۡ عَلَىٰٓ أَهۡلِ بَيۡتٖ يَكۡفُلُونَهُۥ لَكُمۡ وَهُمۡ لَهُۥ نَٰصِحُونَ",
    "ayah_text_no_diacratic" : "وحرمنا عليه المراضع من قبل فقالت هل ادلكم علىٰ اهل بيت يكفلونه لكم وهم له نٰصحون",
    "ayahnumber" : "12",
    "chapter" : "20",
    "hizb" : "38",
