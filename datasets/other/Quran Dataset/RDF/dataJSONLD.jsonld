    "index" : "1075",
    "page" : "164",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1076",
    "ayah_text" : "قَالَ ٱلۡمَلَأُ مِن قَوۡمِ فِرۡعَوۡنَ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "قال الملا من قوم فرعون ان هٰذا لسٰحر عليم",
    "ayahnumber" : "109",
    "chapter" : "9",
