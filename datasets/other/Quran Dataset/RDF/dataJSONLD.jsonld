    "surrahname_no_diacratic" : "سورة القلم"
  }, {
    "@id" : "quran:5446",
    "ayah_text" : "أَمۡ لَهُمۡ شُرَكَآءُ فَلۡيَأۡتُواْ بِشُرَكَآئِهِمۡ إِن كَانُواْ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ام لهم شركاء فلياتوا بشركائهم ان كانوا صٰدقين",
    "ayahnumber" : "41",
