    "page" : "355",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2876",
    "ayah_text" : "وَٱلَّذِينَ كَفَرُوٓاْ أَعۡمَٰلُهُمۡ كَسَرَابِۭ بِقِيعَةٖ يَحۡسَبُهُ ٱلظَّمۡـَٔانُ مَآءً حَتَّىٰٓ إِذَا جَآءَهُۥ لَمۡ يَجِدۡهُ شَيۡـٔٗا وَوَجَدَ ٱللَّهَ عِندَهُۥ فَوَفَّىٰهُ حِسَابَهُۥۗ وَٱللَّهُ سَرِيعُ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "والذين كفروا اعمٰلهم كسراب بقيعة يحسبه الظمان ماء حتىٰ اذا جاءه لم يجده شيا ووجد الله عنده فوفىٰه حسابه والله سريع الحساب",
    "ayahnumber" : "39",
    "chapter" : "18",
    "hizb" : "35",
    "index" : "2876",
    "page" : "355",
    "surahname" : "سُورَةُ النُّورِ",
    "surahnumber" : "24",
    "surrahname_no_diacratic" : "سورة النور"
  }, {
    "@id" : "quran:2877",
    "ayah_text" : "أَوۡ كَظُلُمَٰتٖ فِي بَحۡرٖ لُّجِّيّٖ يَغۡشَىٰهُ مَوۡجٞ مِّن فَوۡقِهِۦ مَوۡجٞ مِّن فَوۡقِهِۦ سَحَابٞۚ ظُلُمَٰتُۢ بَعۡضُهَا فَوۡقَ بَعۡضٍ إِذَآ أَخۡرَجَ يَدَهُۥ لَمۡ يَكَدۡ يَرَىٰهَاۗ وَمَن لَّمۡ يَجۡعَلِ ٱللَّهُ لَهُۥ نُورٗا فَمَا لَهُۥ مِن نُّورٍ",
    "ayah_text_no_diacratic" : "او كظلمٰت في بحر لجي يغشىٰه موج من فوقه موج من فوقه سحاب ظلمٰت بعضها فوق بعض اذا اخرج يده لم يكد يرىٰها ومن لم يجعل الله له نورا فما له من نور",
    "ayahnumber" : "40",
