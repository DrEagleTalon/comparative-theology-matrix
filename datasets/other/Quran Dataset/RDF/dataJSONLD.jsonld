    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4858",
    "ayah_text" : "وَٱلَّذِينَ ءَامَنُواْ وَٱتَّبَعَتۡهُمۡ ذُرِّيَّتُهُم بِإِيمَٰنٍ أَلۡحَقۡنَا بِهِمۡ ذُرِّيَّتَهُمۡ وَمَآ أَلَتۡنَٰهُم مِّنۡ عَمَلِهِم مِّن شَيۡءٖۚ كُلُّ ٱمۡرِيِٕۭ بِمَا كَسَبَ رَهِينٞ",
    "ayah_text_no_diacratic" : "والذين ءامنوا واتبعتهم ذريتهم بايمٰن الحقنا بهم ذريتهم وما التنٰهم من عملهم من شيء كل امري بما كسب رهين",
    "ayahnumber" : "21",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4858",
    "page" : "524",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4859",
    "ayah_text" : "وَأَمۡدَدۡنَٰهُم بِفَٰكِهَةٖ وَلَحۡمٖ مِّمَّا يَشۡتَهُونَ",
    "ayah_text_no_diacratic" : "وامددنٰهم بفٰكهة ولحم مما يشتهون",
    "ayahnumber" : "22",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4859",
    "page" : "524",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:486",
    "ayah_text" : "لَا تَحۡسَبَنَّ ٱلَّذِينَ يَفۡرَحُونَ بِمَآ أَتَواْ وَّيُحِبُّونَ أَن يُحۡمَدُواْ بِمَا لَمۡ يَفۡعَلُواْ فَلَا تَحۡسَبَنَّهُم بِمَفَازَةٖ مِّنَ ٱلۡعَذَابِۖ وَلَهُمۡ عَذَابٌ أَلِيمٞ",
    "ayah_text_no_diacratic" : "لا تحسبن الذين يفرحون بما اتوا ويحبون ان يحمدوا بما لم يفعلوا فلا تحسبنهم بمفازة من العذاب ولهم عذاب اليم",
    "ayahnumber" : "188",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "486",
    "page" : "75",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:4860",
    "ayah_text" : "يَتَنَٰزَعُونَ فِيهَا كَأۡسٗا لَّا لَغۡوٞ فِيهَا وَلَا تَأۡثِيمٞ",
    "ayah_text_no_diacratic" : "يتنٰزعون فيها كاسا لا لغو فيها ولا تاثيم",
    "ayahnumber" : "23",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4860",
    "page" : "524",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4861",
    "ayah_text" : "۞وَيَطُوفُ عَلَيۡهِمۡ غِلۡمَانٞ لَّهُمۡ كَأَنَّهُمۡ لُؤۡلُؤٞ مَّكۡنُونٞ",
    "ayah_text_no_diacratic" : "ويطوف عليهم غلمان لهم كانهم لؤلؤ مكنون",
    "ayahnumber" : "24",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4861",
    "page" : "524",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4862",
    "ayah_text" : "وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ",
    "ayah_text_no_diacratic" : "واقبل بعضهم علىٰ بعض يتساءلون",
    "ayahnumber" : "25",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4862",
    "page" : "524",
    "surahname" : "سُورَةُ الطُّورِ",
    "surahnumber" : "52",
    "surrahname_no_diacratic" : "سورة الطور"
  }, {
    "@id" : "quran:4863",
    "ayah_text" : "قَالُوٓاْ إِنَّا كُنَّا قَبۡلُ فِيٓ أَهۡلِنَا مُشۡفِقِينَ",
    "ayah_text_no_diacratic" : "قالوا انا كنا قبل في اهلنا مشفقين",
    "ayahnumber" : "26",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4863",
