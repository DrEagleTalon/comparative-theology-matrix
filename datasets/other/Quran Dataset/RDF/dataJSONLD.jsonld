    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4697",
    "ayah_text" : "وَعَدَكُمُ ٱللَّهُ مَغَانِمَ كَثِيرَةٗ تَأۡخُذُونَهَا فَعَجَّلَ لَكُمۡ هَٰذِهِۦ وَكَفَّ أَيۡدِيَ ٱلنَّاسِ عَنكُمۡ وَلِتَكُونَ ءَايَةٗ لِّلۡمُؤۡمِنِينَ وَيَهۡدِيَكُمۡ صِرَٰطٗا مُّسۡتَقِيمٗا",
    "ayah_text_no_diacratic" : "وعدكم الله مغانم كثيرة تاخذونها فعجل لكم هٰذه وكف ايدي الناس عنكم ولتكون ءاية للمؤمنين ويهديكم صرٰطا مستقيما",
    "ayahnumber" : "20",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4697",
    "page" : "513",
    "surahname" : "سُورَةُ الفَتۡحِ",
    "surahnumber" : "48",
    "surrahname_no_diacratic" : "سورة الفتح"
  }, {
    "@id" : "quran:4698",
    "ayah_text" : "وَأُخۡرَىٰ لَمۡ تَقۡدِرُواْ عَلَيۡهَا قَدۡ أَحَاطَ ٱللَّهُ بِهَاۚ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٗا",
    "ayah_text_no_diacratic" : "واخرىٰ لم تقدروا عليها قد احاط الله بها وكان الله علىٰ كل شيء قديرا",
    "ayahnumber" : "21",
    "chapter" : "26",
    "hizb" : "51",
    "index" : "4698",
