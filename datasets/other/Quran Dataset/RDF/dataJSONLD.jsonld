    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2379",
    "ayah_text" : "إِن كُلُّ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ إِلَّآ ءَاتِي ٱلرَّحۡمَٰنِ عَبۡدٗا",
    "ayah_text_no_diacratic" : "ان كل من في السمٰوٰت والارض الا ءاتي الرحمٰن عبدا",
    "ayahnumber" : "93",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2379",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:238",
    "ayah_text" : "وَٱلۡمُطَلَّقَٰتُ يَتَرَبَّصۡنَ بِأَنفُسِهِنَّ ثَلَٰثَةَ قُرُوٓءٖۚ وَلَا يَحِلُّ لَهُنَّ أَن يَكۡتُمۡنَ مَا خَلَقَ ٱللَّهُ فِيٓ أَرۡحَامِهِنَّ إِن كُنَّ يُؤۡمِنَّ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۚ وَبُعُولَتُهُنَّ أَحَقُّ بِرَدِّهِنَّ فِي ذَٰلِكَ إِنۡ أَرَادُوٓاْ إِصۡلَٰحٗاۚ وَلَهُنَّ مِثۡلُ ٱلَّذِي عَلَيۡهِنَّ بِٱلۡمَعۡرُوفِۚ وَلِلرِّجَالِ عَلَيۡهِنَّ دَرَجَةٞۗ وَٱللَّهُ عَزِيزٌ حَكِيمٌ",
    "ayah_text_no_diacratic" : "والمطلقٰت يتربصن بانفسهن ثلٰثة قروء ولا يحل لهن ان يكتمن ما خلق الله في ارحامهن ان كن يؤمن بالله واليوم الاخر وبعولتهن احق بردهن في ذٰلك ان ارادوا اصلٰحا ولهن مثل الذي عليهن بالمعروف وللرجال عليهن درجة والله عزيز حكيم",
    "ayahnumber" : "228",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "238",
    "page" : "36",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2380",
    "ayah_text" : "لَّقَدۡ أَحۡصَىٰهُمۡ وَعَدَّهُمۡ عَدّٗا",
    "ayah_text_no_diacratic" : "لقد احصىٰهم وعدهم عدا",
    "ayahnumber" : "94",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2380",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2381",
    "ayah_text" : "وَكُلُّهُمۡ ءَاتِيهِ يَوۡمَ ٱلۡقِيَٰمَةِ فَرۡدًا",
    "ayah_text_no_diacratic" : "وكلهم ءاتيه يوم القيٰمة فردا",
    "ayahnumber" : "95",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2381",
    "page" : "311",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2382",
    "ayah_text" : "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ سَيَجۡعَلُ لَهُمُ ٱلرَّحۡمَٰنُ وُدّٗا",
    "ayah_text_no_diacratic" : "ان الذين ءامنوا وعملوا الصٰلحٰت سيجعل لهم الرحمٰن ودا",
    "ayahnumber" : "96",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2382",
    "page" : "312",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2383",
    "ayah_text" : "فَإِنَّمَا يَسَّرۡنَٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلۡمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوۡمٗا لُّدّٗا",
    "ayah_text_no_diacratic" : "فانما يسرنٰه بلسانك لتبشر به المتقين وتنذر به قوما لدا",
    "ayahnumber" : "97",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2383",
    "page" : "312",
    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2384",
    "ayah_text" : "وَكَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّن قَرۡنٍ هَلۡ تُحِسُّ مِنۡهُم مِّنۡ أَحَدٍ أَوۡ تَسۡمَعُ لَهُمۡ رِكۡزَۢا",
    "ayah_text_no_diacratic" : "وكم اهلكنا قبلهم من قرن هل تحس منهم من احد او تسمع لهم ركزا",
