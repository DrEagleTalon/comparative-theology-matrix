    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1889",
    "ayah_text" : "إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمۡ أَجۡمَعِينَ",
