    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1325",
    "ayah_text" : "يَحۡلِفُونَ بِٱللَّهِ مَا قَالُواْ وَلَقَدۡ قَالُواْ كَلِمَةَ ٱلۡكُفۡرِ وَكَفَرُواْ بَعۡدَ إِسۡلَٰمِهِمۡ وَهَمُّواْ بِمَا لَمۡ يَنَالُواْۚ وَمَا نَقَمُوٓاْ إِلَّآ أَنۡ أَغۡنَىٰهُمُ ٱللَّهُ وَرَسُولُهُۥ مِن فَضۡلِهِۦۚ فَإِن يَتُوبُواْ يَكُ خَيۡرٗا لَّهُمۡۖ وَإِن يَتَوَلَّوۡاْ يُعَذِّبۡهُمُ ٱللَّهُ عَذَابًا أَلِيمٗا فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۚ وَمَا لَهُمۡ فِي ٱلۡأَرۡضِ مِن وَلِيّٖ وَلَا نَصِيرٖ",
    "ayah_text_no_diacratic" : "يحلفون بالله ما قالوا ولقد قالوا كلمة الكفر وكفروا بعد اسلٰمهم وهموا بما لم ينالوا وما نقموا الا ان اغنىٰهم الله ورسوله من فضله فان يتوبوا يك خيرا لهم وان يتولوا يعذبهم الله عذابا اليما في الدنيا والاخرة وما لهم في الارض من ولي ولا نصير",
    "ayahnumber" : "74",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1325",
    "page" : "199",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1326",
    "ayah_text" : "۞وَمِنۡهُم مَّنۡ عَٰهَدَ ٱللَّهَ لَئِنۡ ءَاتَىٰنَا مِن فَضۡلِهِۦ لَنَصَّدَّقَنَّ وَلَنَكُونَنَّ مِنَ ٱلصَّٰلِحِينَ",
    "ayah_text_no_diacratic" : "ومنهم من عٰهد الله لئن ءاتىٰنا من فضله لنصدقن ولنكونن من الصٰلحين",
    "ayahnumber" : "75",
    "chapter" : "10",
    "hizb" : "20",
    "index" : "1326",
    "page" : "199",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1327",
    "ayah_text" : "فَلَمَّآ ءَاتَىٰهُم مِّن فَضۡلِهِۦ بَخِلُواْ بِهِۦ وَتَوَلَّواْ وَّهُم مُّعۡرِضُونَ",
    "ayah_text_no_diacratic" : "فلما ءاتىٰهم من فضله بخلوا به وتولوا وهم معرضون",
    "ayahnumber" : "76",
    "chapter" : "10",
