  }, {
    "@id" : "quran:4301",
    "ayah_text" : "كِتَٰبٞ فُصِّلَتۡ ءَايَٰتُهُۥ قُرۡءَانًا عَرَبِيّٗا لِّقَوۡمٖ يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "كتٰب فصلت ءايٰته قرءانا عربيا لقوم يعلمون",
    "ayahnumber" : "3",
