    "surahnumber" : "41",
    "surrahname_no_diacratic" : "سورة فصلت"
  }, {
    "@id" : "quran:4352",
    "ayah_text" : "أَلَآ إِنَّهُمۡ فِي مِرۡيَةٖ مِّن لِّقَآءِ رَبِّهِمۡۗ أَلَآ إِنَّهُۥ بِكُلِّ شَيۡءٖ مُّحِيطُۢ",
    "ayah_text_no_diacratic" : "الا انهم في مرية من لقاء ربهم الا انه بكل شيء محيط",
