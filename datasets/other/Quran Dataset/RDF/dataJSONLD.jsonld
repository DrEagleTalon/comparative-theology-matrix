    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1284",
    "ayah_text" : "هُوَ ٱلَّذِيٓ أَرۡسَلَ رَسُولَهُۥ بِٱلۡهُدَىٰ وَدِينِ ٱلۡحَقِّ لِيُظۡهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦ وَلَوۡ كَرِهَ ٱلۡمُشۡرِكُونَ",
    "ayah_text_no_diacratic" : "هو الذي ارسل رسوله بالهدىٰ ودين الحق ليظهره على الدين كله ولو كره المشركون",
    "ayahnumber" : "33",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1284",
    "page" : "192",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1285",
    "ayah_text" : "۞يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِنَّ كَثِيرٗا مِّنَ ٱلۡأَحۡبَارِ وَٱلرُّهۡبَانِ لَيَأۡكُلُونَ أَمۡوَٰلَ ٱلنَّاسِ بِٱلۡبَٰطِلِ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِۗ وَٱلَّذِينَ يَكۡنِزُونَ ٱلذَّهَبَ وَٱلۡفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ ٱللَّهِ فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٖ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا ان كثيرا من الاحبار والرهبان لياكلون اموٰل الناس بالبٰطل ويصدون عن سبيل الله والذين يكنزون الذهب والفضة ولا ينفقونها في سبيل الله فبشرهم بعذاب اليم",
    "ayahnumber" : "34",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1285",
    "page" : "192",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1286",
    "ayah_text" : "يَوۡمَ يُحۡمَىٰ عَلَيۡهَا فِي نَارِ جَهَنَّمَ فَتُكۡوَىٰ بِهَا جِبَاهُهُمۡ وَجُنُوبُهُمۡ وَظُهُورُهُمۡۖ هَٰذَا مَا كَنَزۡتُمۡ لِأَنفُسِكُمۡ فَذُوقُواْ مَا كُنتُمۡ تَكۡنِزُونَ",
    "ayah_text_no_diacratic" : "يوم يحمىٰ عليها في نار جهنم فتكوىٰ بها جباههم وجنوبهم وظهورهم هٰذا ما كنزتم لانفسكم فذوقوا ما كنتم تكنزون",
    "ayahnumber" : "35",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1286",
    "page" : "192",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1287",
    "ayah_text" : "إِنَّ عِدَّةَ ٱلشُّهُورِ عِندَ ٱللَّهِ ٱثۡنَا عَشَرَ شَهۡرٗا فِي كِتَٰبِ ٱللَّهِ يَوۡمَ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ مِنۡهَآ أَرۡبَعَةٌ حُرُمٞۚ ذَٰلِكَ ٱلدِّينُ ٱلۡقَيِّمُۚ فَلَا تَظۡلِمُواْ فِيهِنَّ أَنفُسَكُمۡۚ وَقَٰتِلُواْ ٱلۡمُشۡرِكِينَ كَآفَّةٗ كَمَا يُقَٰتِلُونَكُمۡ كَآفَّةٗۚ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَعَ ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "ان عدة الشهور عند الله اثنا عشر شهرا في كتٰب الله يوم خلق السمٰوٰت والارض منها اربعة حرم ذٰلك الدين القيم فلا تظلموا فيهن انفسكم وقٰتلوا المشركين كافة كما يقٰتلونكم كافة واعلموا ان الله مع المتقين",
    "ayahnumber" : "36",
    "chapter" : "10",
    "hizb" : "19",
    "index" : "1287",
    "page" : "192",
    "surahname" : "سُورَةُ التَّوۡبَةِ",
    "surahnumber" : "9",
    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1288",
    "ayah_text" : "إِنَّمَا ٱلنَّسِيٓءُ زِيَادَةٞ فِي ٱلۡكُفۡرِۖ يُضَلُّ بِهِ ٱلَّذِينَ كَفَرُواْ يُحِلُّونَهُۥ عَامٗا وَيُحَرِّمُونَهُۥ عَامٗا لِّيُوَاطِـُٔواْ عِدَّةَ مَا حَرَّمَ ٱللَّهُ فَيُحِلُّواْ مَا حَرَّمَ ٱللَّهُۚ زُيِّنَ لَهُمۡ سُوٓءُ أَعۡمَٰلِهِمۡۗ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "انما النسيء زيادة في الكفر يضل به الذين كفروا يحلونه عاما ويحرمونه عاما ليواطوا عدة ما حرم الله فيحلوا ما حرم الله زين لهم سوء اعمٰلهم والله لا يهدي القوم الكٰفرين",
    "ayahnumber" : "37",
    "chapter" : "10",
