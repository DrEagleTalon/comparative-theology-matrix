    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3044",
    "ayah_text" : "قَالَ كَلَّآۖ إِنَّ مَعِيَ رَبِّي سَيَهۡدِينِ",
    "ayah_text_no_diacratic" : "قال كلا ان معي ربي سيهدين",
    "ayahnumber" : "62",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3044",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3045",
    "ayah_text" : "فَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضۡرِب بِّعَصَاكَ ٱلۡبَحۡرَۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرۡقٖ كَٱلطَّوۡدِ ٱلۡعَظِيمِ",
    "ayah_text_no_diacratic" : "فاوحينا الىٰ موسىٰ ان اضرب بعصاك البحر فانفلق فكان كل فرق كالطود العظيم",
    "ayahnumber" : "63",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3045",
    "page" : "370",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3046",
    "ayah_text" : "وَأَزۡلَفۡنَا ثَمَّ ٱلۡأٓخَرِينَ",
    "ayah_text_no_diacratic" : "وازلفنا ثم الاخرين",
    "ayahnumber" : "64",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3046",
