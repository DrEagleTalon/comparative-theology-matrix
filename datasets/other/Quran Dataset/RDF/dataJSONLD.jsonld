    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3133",
    "ayah_text" : "وَلَا تُطِيعُوٓاْ أَمۡرَ ٱلۡمُسۡرِفِينَ",
    "ayah_text_no_diacratic" : "ولا تطيعوا امر المسرفين",
    "ayahnumber" : "151",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3133",
    "page" : "373",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3134",
    "ayah_text" : "ٱلَّذِينَ يُفۡسِدُونَ فِي ٱلۡأَرۡضِ وَلَا يُصۡلِحُونَ",
    "ayah_text_no_diacratic" : "الذين يفسدون في الارض ولا يصلحون",
    "ayahnumber" : "152",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3134",
