    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3912",
    "ayah_text" : "يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ",
    "ayah_text_no_diacratic" : "يقول اءنك لمن المصدقين",
    "ayahnumber" : "52",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3912",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3913",
    "ayah_text" : "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ",
    "ayah_text_no_diacratic" : "اءذا متنا وكنا ترابا وعظٰما اءنا لمدينون",
    "ayahnumber" : "53",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3913",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3914",
    "ayah_text" : "قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ",
    "ayah_text_no_diacratic" : "قال هل انتم مطلعون",
    "ayahnumber" : "54",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3914",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3915",
    "ayah_text" : "فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ",
    "ayah_text_no_diacratic" : "فاطلع فرءاه في سواء الجحيم",
    "ayahnumber" : "55",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3915",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3916",
    "ayah_text" : "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ",
    "ayah_text_no_diacratic" : "قال تالله ان كدت لتردين",
    "ayahnumber" : "56",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3916",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3917",
    "ayah_text" : "وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ",
    "ayah_text_no_diacratic" : "ولولا نعمة ربي لكنت من المحضرين",
    "ayahnumber" : "57",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3917",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3918",
    "ayah_text" : "أَفَمَا نَحۡنُ بِمَيِّتِينَ",
    "ayah_text_no_diacratic" : "افما نحن بميتين",
    "ayahnumber" : "58",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3918",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:3919",
    "ayah_text" : "إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ",
    "ayah_text_no_diacratic" : "الا موتتنا الاولىٰ وما نحن بمعذبين",
    "ayahnumber" : "59",
    "chapter" : "23",
    "hizb" : "44",
    "index" : "3919",
    "page" : "448",
    "surahname" : "سُورَةُ الصَّافَّاتِ",
    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:392",
    "ayah_text" : "فَمَنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ ٱلۡكَذِبَ مِنۢ بَعۡدِ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ",
    "ayah_text_no_diacratic" : "فمن افترىٰ على الله الكذب من بعد ذٰلك فاولٰئك هم الظٰلمون",
    "ayahnumber" : "94",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "392",
    "page" : "62",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3920",
    "ayah_text" : "إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "ان هٰذا لهو الفوز العظيم",
    "ayahnumber" : "60",
    "chapter" : "23",
    "hizb" : "44",
