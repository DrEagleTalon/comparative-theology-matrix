    "chapter" : "26",
    "hizb" : "52",
    "index" : "4805",
    "page" : "521",
    "surahname" : "سُورَةُ الذَّارِيَاتِ",
    "surahnumber" : "51",
    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4806",
    "ayah_text" : "۞قَالَ فَمَا خَطۡبُكُمۡ أَيُّهَا ٱلۡمُرۡسَلُونَ",
    "ayah_text_no_diacratic" : "قال فما خطبكم ايها المرسلون",
    "ayahnumber" : "31",
    "chapter" : "27",
    "hizb" : "52",
    "index" : "4806",
