    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2424",
    "ayah_text" : "إِذۡ أَوۡحَيۡنَآ إِلَىٰٓ أُمِّكَ مَا يُوحَىٰٓ",
    "ayah_text_no_diacratic" : "اذ اوحينا الىٰ امك ما يوحىٰ",
    "ayahnumber" : "38",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2424",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2425",
    "ayah_text" : "أَنِ ٱقۡذِفِيهِ فِي ٱلتَّابُوتِ فَٱقۡذِفِيهِ فِي ٱلۡيَمِّ فَلۡيُلۡقِهِ ٱلۡيَمُّ بِٱلسَّاحِلِ يَأۡخُذۡهُ عَدُوّٞ لِّي وَعَدُوّٞ لَّهُۥۚ وَأَلۡقَيۡتُ عَلَيۡكَ مَحَبَّةٗ مِّنِّي وَلِتُصۡنَعَ عَلَىٰ عَيۡنِيٓ",
    "ayah_text_no_diacratic" : "ان اقذفيه في التابوت فاقذفيه في اليم فليلقه اليم بالساحل ياخذه عدو لي وعدو له والقيت عليك محبة مني ولتصنع علىٰ عيني",
    "ayahnumber" : "39",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2425",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2426",
    "ayah_text" : "إِذۡ تَمۡشِيٓ أُخۡتُكَ فَتَقُولُ هَلۡ أَدُلُّكُمۡ عَلَىٰ مَن يَكۡفُلُهُۥۖ فَرَجَعۡنَٰكَ إِلَىٰٓ أُمِّكَ كَيۡ تَقَرَّ عَيۡنُهَا وَلَا تَحۡزَنَۚ وَقَتَلۡتَ نَفۡسٗا فَنَجَّيۡنَٰكَ مِنَ ٱلۡغَمِّ وَفَتَنَّٰكَ فُتُونٗاۚ فَلَبِثۡتَ سِنِينَ فِيٓ أَهۡلِ مَدۡيَنَ ثُمَّ جِئۡتَ عَلَىٰ قَدَرٖ يَٰمُوسَىٰ",
    "ayah_text_no_diacratic" : "اذ تمشي اختك فتقول هل ادلكم علىٰ من يكفله فرجعنٰك الىٰ امك كي تقر عينها ولا تحزن وقتلت نفسا فنجينٰك من الغم وفتنٰك فتونا فلبثت سنين في اهل مدين ثم جئت علىٰ قدر يٰموسىٰ",
    "ayahnumber" : "40",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2426",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2427",
    "ayah_text" : "وَٱصۡطَنَعۡتُكَ لِنَفۡسِي",
    "ayah_text_no_diacratic" : "واصطنعتك لنفسي",
    "ayahnumber" : "41",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2427",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2428",
    "ayah_text" : "ٱذۡهَبۡ أَنتَ وَأَخُوكَ بِـَٔايَٰتِي وَلَا تَنِيَا فِي ذِكۡرِي",
    "ayah_text_no_diacratic" : "اذهب انت واخوك بايٰتي ولا تنيا في ذكري",
    "ayahnumber" : "42",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2428",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2429",
    "ayah_text" : "ٱذۡهَبَآ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ",
    "ayah_text_no_diacratic" : "اذهبا الىٰ فرعون انه طغىٰ",
    "ayahnumber" : "43",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2429",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:243",
    "ayah_text" : "۞وَٱلۡوَٰلِدَٰتُ يُرۡضِعۡنَ أَوۡلَٰدَهُنَّ حَوۡلَيۡنِ كَامِلَيۡنِۖ لِمَنۡ أَرَادَ أَن يُتِمَّ ٱلرَّضَاعَةَۚ وَعَلَى ٱلۡمَوۡلُودِ لَهُۥ رِزۡقُهُنَّ وَكِسۡوَتُهُنَّ بِٱلۡمَعۡرُوفِۚ لَا تُكَلَّفُ نَفۡسٌ إِلَّا وُسۡعَهَاۚ لَا تُضَآرَّ وَٰلِدَةُۢ بِوَلَدِهَا وَلَا مَوۡلُودٞ لَّهُۥ بِوَلَدِهِۦۚ وَعَلَى ٱلۡوَارِثِ مِثۡلُ ذَٰلِكَۗ فَإِنۡ أَرَادَا فِصَالًا عَن تَرَاضٖ مِّنۡهُمَا وَتَشَاوُرٖ فَلَا جُنَاحَ عَلَيۡهِمَاۗ وَإِنۡ أَرَدتُّمۡ أَن تَسۡتَرۡضِعُوٓاْ أَوۡلَٰدَكُمۡ فَلَا جُنَاحَ عَلَيۡكُمۡ إِذَا سَلَّمۡتُم مَّآ ءَاتَيۡتُم بِٱلۡمَعۡرُوفِۗ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ بِمَا تَعۡمَلُونَ بَصِيرٞ",
    "ayah_text_no_diacratic" : "والوٰلدٰت يرضعن اولٰدهن حولين كاملين لمن اراد ان يتم الرضاعة وعلى المولود له رزقهن وكسوتهن بالمعروف لا تكلف نفس الا وسعها لا تضار وٰلدة بولدها ولا مولود له بولده وعلى الوارث مثل ذٰلك فان ارادا فصالا عن تراض منهما وتشاور فلا جناح عليهما وان اردتم ان تسترضعوا اولٰدكم فلا جناح عليكم اذا سلمتم ما ءاتيتم بالمعروف واتقوا الله واعلموا ان الله بما تعملون بصير",
    "ayahnumber" : "233",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "243",
    "page" : "37",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2430",
    "ayah_text" : "فَقُولَا لَهُۥ قَوۡلٗا لَّيِّنٗا لَّعَلَّهُۥ يَتَذَكَّرُ أَوۡ يَخۡشَىٰ",
    "ayah_text_no_diacratic" : "فقولا له قولا لينا لعله يتذكر او يخشىٰ",
    "ayahnumber" : "44",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2430",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2431",
    "ayah_text" : "قَالَا رَبَّنَآ إِنَّنَا نَخَافُ أَن يَفۡرُطَ عَلَيۡنَآ أَوۡ أَن يَطۡغَىٰ",
    "ayah_text_no_diacratic" : "قالا ربنا اننا نخاف ان يفرط علينا او ان يطغىٰ",
    "ayahnumber" : "45",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2431",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2432",
    "ayah_text" : "قَالَ لَا تَخَافَآۖ إِنَّنِي مَعَكُمَآ أَسۡمَعُ وَأَرَىٰ",
    "ayah_text_no_diacratic" : "قال لا تخافا انني معكما اسمع وارىٰ",
    "ayahnumber" : "46",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2432",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2433",
    "ayah_text" : "فَأۡتِيَاهُ فَقُولَآ إِنَّا رَسُولَا رَبِّكَ فَأَرۡسِلۡ مَعَنَا بَنِيٓ إِسۡرَٰٓءِيلَ وَلَا تُعَذِّبۡهُمۡۖ قَدۡ جِئۡنَٰكَ بِـَٔايَةٖ مِّن رَّبِّكَۖ وَٱلسَّلَٰمُ عَلَىٰ مَنِ ٱتَّبَعَ ٱلۡهُدَىٰٓ",
    "ayah_text_no_diacratic" : "فاتياه فقولا انا رسولا ربك فارسل معنا بني اسرٰءيل ولا تعذبهم قد جئنٰك باية من ربك والسلٰم علىٰ من اتبع الهدىٰ",
    "ayahnumber" : "47",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2433",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2434",
    "ayah_text" : "إِنَّا قَدۡ أُوحِيَ إِلَيۡنَآ أَنَّ ٱلۡعَذَابَ عَلَىٰ مَن كَذَّبَ وَتَوَلَّىٰ",
    "ayah_text_no_diacratic" : "انا قد اوحي الينا ان العذاب علىٰ من كذب وتولىٰ",
    "ayahnumber" : "48",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2434",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2435",
    "ayah_text" : "قَالَ فَمَن رَّبُّكُمَا يَٰمُوسَىٰ",
    "ayah_text_no_diacratic" : "قال فمن ربكما يٰموسىٰ",
    "ayahnumber" : "49",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2435",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2436",
    "ayah_text" : "قَالَ رَبُّنَا ٱلَّذِيٓ أَعۡطَىٰ كُلَّ شَيۡءٍ خَلۡقَهُۥ ثُمَّ هَدَىٰ",
    "ayah_text_no_diacratic" : "قال ربنا الذي اعطىٰ كل شيء خلقه ثم هدىٰ",
    "ayahnumber" : "50",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2436",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2437",
    "ayah_text" : "قَالَ فَمَا بَالُ ٱلۡقُرُونِ ٱلۡأُولَىٰ",
    "ayah_text_no_diacratic" : "قال فما بال القرون الاولىٰ",
    "ayahnumber" : "51",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2437",
    "page" : "314",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2438",
    "ayah_text" : "قَالَ عِلۡمُهَا عِندَ رَبِّي فِي كِتَٰبٖۖ لَّا يَضِلُّ رَبِّي وَلَا يَنسَى",
    "ayah_text_no_diacratic" : "قال علمها عند ربي في كتٰب لا يضل ربي ولا ينسى",
    "ayahnumber" : "52",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2438",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2439",
    "ayah_text" : "ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ مَهۡدٗا وَسَلَكَ لَكُمۡ فِيهَا سُبُلٗا وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجۡنَا بِهِۦٓ أَزۡوَٰجٗا مِّن نَّبَاتٖ شَتَّىٰ",
    "ayah_text_no_diacratic" : "الذي جعل لكم الارض مهدا وسلك لكم فيها سبلا وانزل من السماء ماء فاخرجنا به ازوٰجا من نبات شتىٰ",
    "ayahnumber" : "53",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2439",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:244",
    "ayah_text" : "وَٱلَّذِينَ يُتَوَفَّوۡنَ مِنكُمۡ وَيَذَرُونَ أَزۡوَٰجٗا يَتَرَبَّصۡنَ بِأَنفُسِهِنَّ أَرۡبَعَةَ أَشۡهُرٖ وَعَشۡرٗاۖ فَإِذَا بَلَغۡنَ أَجَلَهُنَّ فَلَا جُنَاحَ عَلَيۡكُمۡ فِيمَا فَعَلۡنَ فِيٓ أَنفُسِهِنَّ بِٱلۡمَعۡرُوفِۗ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ",
    "ayah_text_no_diacratic" : "والذين يتوفون منكم ويذرون ازوٰجا يتربصن بانفسهن اربعة اشهر وعشرا فاذا بلغن اجلهن فلا جناح عليكم فيما فعلن في انفسهن بالمعروف والله بما تعملون خبير",
    "ayahnumber" : "234",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "244",
    "page" : "38",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2440",
    "ayah_text" : "كُلُواْ وَٱرۡعَوۡاْ أَنۡعَٰمَكُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّأُوْلِي ٱلنُّهَىٰ",
    "ayah_text_no_diacratic" : "كلوا وارعوا انعٰمكم ان في ذٰلك لايٰت لاولي النهىٰ",
    "ayahnumber" : "54",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2440",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2441",
    "ayah_text" : "۞مِنۡهَا خَلَقۡنَٰكُمۡ وَفِيهَا نُعِيدُكُمۡ وَمِنۡهَا نُخۡرِجُكُمۡ تَارَةً أُخۡرَىٰ",
    "ayah_text_no_diacratic" : "منها خلقنٰكم وفيها نعيدكم ومنها نخرجكم تارة اخرىٰ",
    "ayahnumber" : "55",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2441",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2442",
    "ayah_text" : "وَلَقَدۡ أَرَيۡنَٰهُ ءَايَٰتِنَا كُلَّهَا فَكَذَّبَ وَأَبَىٰ",
    "ayah_text_no_diacratic" : "ولقد ارينٰه ءايٰتنا كلها فكذب وابىٰ",
    "ayahnumber" : "56",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2442",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2443",
    "ayah_text" : "قَالَ أَجِئۡتَنَا لِتُخۡرِجَنَا مِنۡ أَرۡضِنَا بِسِحۡرِكَ يَٰمُوسَىٰ",
    "ayah_text_no_diacratic" : "قال اجئتنا لتخرجنا من ارضنا بسحرك يٰموسىٰ",
    "ayahnumber" : "57",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2443",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2444",
    "ayah_text" : "فَلَنَأۡتِيَنَّكَ بِسِحۡرٖ مِّثۡلِهِۦ فَٱجۡعَلۡ بَيۡنَنَا وَبَيۡنَكَ مَوۡعِدٗا لَّا نُخۡلِفُهُۥ نَحۡنُ وَلَآ أَنتَ مَكَانٗا سُوٗى",
    "ayah_text_no_diacratic" : "فلناتينك بسحر مثله فاجعل بيننا وبينك موعدا لا نخلفه نحن ولا انت مكانا سوى",
    "ayahnumber" : "58",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2444",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2445",
    "ayah_text" : "قَالَ مَوۡعِدُكُمۡ يَوۡمُ ٱلزِّينَةِ وَأَن يُحۡشَرَ ٱلنَّاسُ ضُحٗى",
    "ayah_text_no_diacratic" : "قال موعدكم يوم الزينة وان يحشر الناس ضحى",
    "ayahnumber" : "59",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2445",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2446",
    "ayah_text" : "فَتَوَلَّىٰ فِرۡعَوۡنُ فَجَمَعَ كَيۡدَهُۥ ثُمَّ أَتَىٰ",
    "ayah_text_no_diacratic" : "فتولىٰ فرعون فجمع كيده ثم اتىٰ",
    "ayahnumber" : "60",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2446",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2447",
    "ayah_text" : "قَالَ لَهُم مُّوسَىٰ وَيۡلَكُمۡ لَا تَفۡتَرُواْ عَلَى ٱللَّهِ كَذِبٗا فَيُسۡحِتَكُم بِعَذَابٖۖ وَقَدۡ خَابَ مَنِ ٱفۡتَرَىٰ",
    "ayah_text_no_diacratic" : "قال لهم موسىٰ ويلكم لا تفتروا على الله كذبا فيسحتكم بعذاب وقد خاب من افترىٰ",
    "ayahnumber" : "61",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2447",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2448",
    "ayah_text" : "فَتَنَٰزَعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡ وَأَسَرُّواْ ٱلنَّجۡوَىٰ",
    "ayah_text_no_diacratic" : "فتنٰزعوا امرهم بينهم واسروا النجوىٰ",
    "ayahnumber" : "62",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2448",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2449",
    "ayah_text" : "قَالُوٓاْ إِنۡ هَٰذَٰنِ لَسَٰحِرَٰنِ يُرِيدَانِ أَن يُخۡرِجَاكُم مِّنۡ أَرۡضِكُم بِسِحۡرِهِمَا وَيَذۡهَبَا بِطَرِيقَتِكُمُ ٱلۡمُثۡلَىٰ",
    "ayah_text_no_diacratic" : "قالوا ان هٰذٰن لسٰحرٰن يريدان ان يخرجاكم من ارضكم بسحرهما ويذهبا بطريقتكم المثلىٰ",
    "ayahnumber" : "63",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2449",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:245",
    "ayah_text" : "وَلَا جُنَاحَ عَلَيۡكُمۡ فِيمَا عَرَّضۡتُم بِهِۦ مِنۡ خِطۡبَةِ ٱلنِّسَآءِ أَوۡ أَكۡنَنتُمۡ فِيٓ أَنفُسِكُمۡۚ عَلِمَ ٱللَّهُ أَنَّكُمۡ سَتَذۡكُرُونَهُنَّ وَلَٰكِن لَّا تُوَاعِدُوهُنَّ سِرًّا إِلَّآ أَن تَقُولُواْ قَوۡلٗا مَّعۡرُوفٗاۚ وَلَا تَعۡزِمُواْ عُقۡدَةَ ٱلنِّكَاحِ حَتَّىٰ يَبۡلُغَ ٱلۡكِتَٰبُ أَجَلَهُۥۚ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ يَعۡلَمُ مَا فِيٓ أَنفُسِكُمۡ فَٱحۡذَرُوهُۚ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ غَفُورٌ حَلِيمٞ",
    "ayah_text_no_diacratic" : "ولا جناح عليكم فيما عرضتم به من خطبة النساء او اكننتم في انفسكم علم الله انكم ستذكرونهن ولٰكن لا تواعدوهن سرا الا ان تقولوا قولا معروفا ولا تعزموا عقدة النكاح حتىٰ يبلغ الكتٰب اجله واعلموا ان الله يعلم ما في انفسكم فاحذروه واعلموا ان الله غفور حليم",
    "ayahnumber" : "235",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "245",
    "page" : "38",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2450",
    "ayah_text" : "فَأَجۡمِعُواْ كَيۡدَكُمۡ ثُمَّ ٱئۡتُواْ صَفّٗاۚ وَقَدۡ أَفۡلَحَ ٱلۡيَوۡمَ مَنِ ٱسۡتَعۡلَىٰ",
    "ayah_text_no_diacratic" : "فاجمعوا كيدكم ثم ائتوا صفا وقد افلح اليوم من استعلىٰ",
    "ayahnumber" : "64",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2450",
    "page" : "315",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2451",
    "ayah_text" : "قَالُواْ يَٰمُوسَىٰٓ إِمَّآ أَن تُلۡقِيَ وَإِمَّآ أَن نَّكُونَ أَوَّلَ مَنۡ أَلۡقَىٰ",
    "ayah_text_no_diacratic" : "قالوا يٰموسىٰ اما ان تلقي واما ان نكون اول من القىٰ",
    "ayahnumber" : "65",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2451",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2452",
    "ayah_text" : "قَالَ بَلۡ أَلۡقُواْۖ فَإِذَا حِبَالُهُمۡ وَعِصِيُّهُمۡ يُخَيَّلُ إِلَيۡهِ مِن سِحۡرِهِمۡ أَنَّهَا تَسۡعَىٰ",
    "ayah_text_no_diacratic" : "قال بل القوا فاذا حبالهم وعصيهم يخيل اليه من سحرهم انها تسعىٰ",
    "ayahnumber" : "66",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2452",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2453",
    "ayah_text" : "فَأَوۡجَسَ فِي نَفۡسِهِۦ خِيفَةٗ مُّوسَىٰ",
    "ayah_text_no_diacratic" : "فاوجس في نفسه خيفة موسىٰ",
    "ayahnumber" : "67",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2453",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2454",
    "ayah_text" : "قُلۡنَا لَا تَخَفۡ إِنَّكَ أَنتَ ٱلۡأَعۡلَىٰ",
    "ayah_text_no_diacratic" : "قلنا لا تخف انك انت الاعلىٰ",
    "ayahnumber" : "68",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2454",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2455",
    "ayah_text" : "وَأَلۡقِ مَا فِي يَمِينِكَ تَلۡقَفۡ مَا صَنَعُوٓاْۖ إِنَّمَا صَنَعُواْ كَيۡدُ سَٰحِرٖۖ وَلَا يُفۡلِحُ ٱلسَّاحِرُ حَيۡثُ أَتَىٰ",
    "ayah_text_no_diacratic" : "والق ما في يمينك تلقف ما صنعوا انما صنعوا كيد سٰحر ولا يفلح الساحر حيث اتىٰ",
    "ayahnumber" : "69",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2455",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2456",
    "ayah_text" : "فَأُلۡقِيَ ٱلسَّحَرَةُ سُجَّدٗا قَالُوٓاْ ءَامَنَّا بِرَبِّ هَٰرُونَ وَمُوسَىٰ",
    "ayah_text_no_diacratic" : "فالقي السحرة سجدا قالوا ءامنا برب هٰرون وموسىٰ",
    "ayahnumber" : "70",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2456",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2457",
    "ayah_text" : "قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِي عَلَّمَكُمُ ٱلسِّحۡرَۖ فَلَأُقَطِّعَنَّ أَيۡدِيَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمۡ فِي جُذُوعِ ٱلنَّخۡلِ وَلَتَعۡلَمُنَّ أَيُّنَآ أَشَدُّ عَذَابٗا وَأَبۡقَىٰ",
    "ayah_text_no_diacratic" : "قال ءامنتم له قبل ان ءاذن لكم انه لكبيركم الذي علمكم السحر فلاقطعن ايديكم وارجلكم من خلٰف ولاصلبنكم في جذوع النخل ولتعلمن اينا اشد عذابا وابقىٰ",
    "ayahnumber" : "71",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2457",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2458",
    "ayah_text" : "قَالُواْ لَن نُّؤۡثِرَكَ عَلَىٰ مَا جَآءَنَا مِنَ ٱلۡبَيِّنَٰتِ وَٱلَّذِي فَطَرَنَاۖ فَٱقۡضِ مَآ أَنتَ قَاضٍۖ إِنَّمَا تَقۡضِي هَٰذِهِ ٱلۡحَيَوٰةَ ٱلدُّنۡيَآ",
    "ayah_text_no_diacratic" : "قالوا لن نؤثرك علىٰ ما جاءنا من البينٰت والذي فطرنا فاقض ما انت قاض انما تقضي هٰذه الحيوٰة الدنيا",
    "ayahnumber" : "72",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2458",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2459",
    "ayah_text" : "إِنَّآ ءَامَنَّا بِرَبِّنَا لِيَغۡفِرَ لَنَا خَطَٰيَٰنَا وَمَآ أَكۡرَهۡتَنَا عَلَيۡهِ مِنَ ٱلسِّحۡرِۗ وَٱللَّهُ خَيۡرٞ وَأَبۡقَىٰٓ",
    "ayah_text_no_diacratic" : "انا ءامنا بربنا ليغفر لنا خطٰيٰنا وما اكرهتنا عليه من السحر والله خير وابقىٰ",
    "ayahnumber" : "73",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2459",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:246",
    "ayah_text" : "لَّا جُنَاحَ عَلَيۡكُمۡ إِن طَلَّقۡتُمُ ٱلنِّسَآءَ مَا لَمۡ تَمَسُّوهُنَّ أَوۡ تَفۡرِضُواْ لَهُنَّ فَرِيضَةٗۚ وَمَتِّعُوهُنَّ عَلَى ٱلۡمُوسِعِ قَدَرُهُۥ وَعَلَى ٱلۡمُقۡتِرِ قَدَرُهُۥ مَتَٰعَۢا بِٱلۡمَعۡرُوفِۖ حَقًّا عَلَى ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "لا جناح عليكم ان طلقتم النساء ما لم تمسوهن او تفرضوا لهن فريضة ومتعوهن على الموسع قدره وعلى المقتر قدره متٰعا بالمعروف حقا على المحسنين",
    "ayahnumber" : "236",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "246",
    "page" : "38",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2460",
    "ayah_text" : "إِنَّهُۥ مَن يَأۡتِ رَبَّهُۥ مُجۡرِمٗا فَإِنَّ لَهُۥ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ",
    "ayah_text_no_diacratic" : "انه من يات ربه مجرما فان له جهنم لا يموت فيها ولا يحيىٰ",
    "ayahnumber" : "74",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2460",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2461",
    "ayah_text" : "وَمَن يَأۡتِهِۦ مُؤۡمِنٗا قَدۡ عَمِلَ ٱلصَّٰلِحَٰتِ فَأُوْلَٰٓئِكَ لَهُمُ ٱلدَّرَجَٰتُ ٱلۡعُلَىٰ",
    "ayah_text_no_diacratic" : "ومن ياته مؤمنا قد عمل الصٰلحٰت فاولٰئك لهم الدرجٰت العلىٰ",
    "ayahnumber" : "75",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2461",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2462",
    "ayah_text" : "جَنَّٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ مَن تَزَكَّىٰ",
    "ayah_text_no_diacratic" : "جنٰت عدن تجري من تحتها الانهٰر خٰلدين فيها وذٰلك جزاء من تزكىٰ",
    "ayahnumber" : "76",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2462",
    "page" : "316",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2463",
    "ayah_text" : "وَلَقَدۡ أَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنۡ أَسۡرِ بِعِبَادِي فَٱضۡرِبۡ لَهُمۡ طَرِيقٗا فِي ٱلۡبَحۡرِ يَبَسٗا لَّا تَخَٰفُ دَرَكٗا وَلَا تَخۡشَىٰ",
    "ayah_text_no_diacratic" : "ولقد اوحينا الىٰ موسىٰ ان اسر بعبادي فاضرب لهم طريقا في البحر يبسا لا تخٰف دركا ولا تخشىٰ",
    "ayahnumber" : "77",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2463",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2464",
    "ayah_text" : "فَأَتۡبَعَهُمۡ فِرۡعَوۡنُ بِجُنُودِهِۦ فَغَشِيَهُم مِّنَ ٱلۡيَمِّ مَا غَشِيَهُمۡ",
    "ayah_text_no_diacratic" : "فاتبعهم فرعون بجنوده فغشيهم من اليم ما غشيهم",
    "ayahnumber" : "78",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2464",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2465",
    "ayah_text" : "وَأَضَلَّ فِرۡعَوۡنُ قَوۡمَهُۥ وَمَا هَدَىٰ",
    "ayah_text_no_diacratic" : "واضل فرعون قومه وما هدىٰ",
    "ayahnumber" : "79",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2465",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2466",
    "ayah_text" : "يَٰبَنِيٓ إِسۡرَٰٓءِيلَ قَدۡ أَنجَيۡنَٰكُم مِّنۡ عَدُوِّكُمۡ وَوَٰعَدۡنَٰكُمۡ جَانِبَ ٱلطُّورِ ٱلۡأَيۡمَنَ وَنَزَّلۡنَا عَلَيۡكُمُ ٱلۡمَنَّ وَٱلسَّلۡوَىٰ",
    "ayah_text_no_diacratic" : "يٰبني اسرٰءيل قد انجينٰكم من عدوكم ووٰعدنٰكم جانب الطور الايمن ونزلنا عليكم المن والسلوىٰ",
    "ayahnumber" : "80",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2466",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2467",
    "ayah_text" : "كُلُواْ مِن طَيِّبَٰتِ مَا رَزَقۡنَٰكُمۡ وَلَا تَطۡغَوۡاْ فِيهِ فَيَحِلَّ عَلَيۡكُمۡ غَضَبِيۖ وَمَن يَحۡلِلۡ عَلَيۡهِ غَضَبِي فَقَدۡ هَوَىٰ",
    "ayah_text_no_diacratic" : "كلوا من طيبٰت ما رزقنٰكم ولا تطغوا فيه فيحل عليكم غضبي ومن يحلل عليه غضبي فقد هوىٰ",
    "ayahnumber" : "81",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2467",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2468",
    "ayah_text" : "وَإِنِّي لَغَفَّارٞ لِّمَن تَابَ وَءَامَنَ وَعَمِلَ صَٰلِحٗا ثُمَّ ٱهۡتَدَىٰ",
    "ayah_text_no_diacratic" : "واني لغفار لمن تاب وءامن وعمل صٰلحا ثم اهتدىٰ",
    "ayahnumber" : "82",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2468",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2469",
    "ayah_text" : "۞وَمَآ أَعۡجَلَكَ عَن قَوۡمِكَ يَٰمُوسَىٰ",
    "ayah_text_no_diacratic" : "وما اعجلك عن قومك يٰموسىٰ",
    "ayahnumber" : "83",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2469",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:247",
    "ayah_text" : "وَإِن طَلَّقۡتُمُوهُنَّ مِن قَبۡلِ أَن تَمَسُّوهُنَّ وَقَدۡ فَرَضۡتُمۡ لَهُنَّ فَرِيضَةٗ فَنِصۡفُ مَا فَرَضۡتُمۡ إِلَّآ أَن يَعۡفُونَ أَوۡ يَعۡفُوَاْ ٱلَّذِي بِيَدِهِۦ عُقۡدَةُ ٱلنِّكَاحِۚ وَأَن تَعۡفُوٓاْ أَقۡرَبُ لِلتَّقۡوَىٰۚ وَلَا تَنسَوُاْ ٱلۡفَضۡلَ بَيۡنَكُمۡۚ إِنَّ ٱللَّهَ بِمَا تَعۡمَلُونَ بَصِيرٌ",
    "ayah_text_no_diacratic" : "وان طلقتموهن من قبل ان تمسوهن وقد فرضتم لهن فريضة فنصف ما فرضتم الا ان يعفون او يعفوا الذي بيده عقدة النكاح وان تعفوا اقرب للتقوىٰ ولا تنسوا الفضل بينكم ان الله بما تعملون بصير",
    "ayahnumber" : "237",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "247",
    "page" : "38",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2470",
    "ayah_text" : "قَالَ هُمۡ أُوْلَآءِ عَلَىٰٓ أَثَرِي وَعَجِلۡتُ إِلَيۡكَ رَبِّ لِتَرۡضَىٰ",
    "ayah_text_no_diacratic" : "قال هم اولاء علىٰ اثري وعجلت اليك رب لترضىٰ",
    "ayahnumber" : "84",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2470",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2471",
    "ayah_text" : "قَالَ فَإِنَّا قَدۡ فَتَنَّا قَوۡمَكَ مِنۢ بَعۡدِكَ وَأَضَلَّهُمُ ٱلسَّامِرِيُّ",
    "ayah_text_no_diacratic" : "قال فانا قد فتنا قومك من بعدك واضلهم السامري",
    "ayahnumber" : "85",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2471",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2472",
    "ayah_text" : "فَرَجَعَ مُوسَىٰٓ إِلَىٰ قَوۡمِهِۦ غَضۡبَٰنَ أَسِفٗاۚ قَالَ يَٰقَوۡمِ أَلَمۡ يَعِدۡكُمۡ رَبُّكُمۡ وَعۡدًا حَسَنًاۚ أَفَطَالَ عَلَيۡكُمُ ٱلۡعَهۡدُ أَمۡ أَرَدتُّمۡ أَن يَحِلَّ عَلَيۡكُمۡ غَضَبٞ مِّن رَّبِّكُمۡ فَأَخۡلَفۡتُم مَّوۡعِدِي",
    "ayah_text_no_diacratic" : "فرجع موسىٰ الىٰ قومه غضبٰن اسفا قال يٰقوم الم يعدكم ربكم وعدا حسنا افطال عليكم العهد ام اردتم ان يحل عليكم غضب من ربكم فاخلفتم موعدي",
    "ayahnumber" : "86",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2472",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2473",
    "ayah_text" : "قَالُواْ مَآ أَخۡلَفۡنَا مَوۡعِدَكَ بِمَلۡكِنَا وَلَٰكِنَّا حُمِّلۡنَآ أَوۡزَارٗا مِّن زِينَةِ ٱلۡقَوۡمِ فَقَذَفۡنَٰهَا فَكَذَٰلِكَ أَلۡقَى ٱلسَّامِرِيُّ",
    "ayah_text_no_diacratic" : "قالوا ما اخلفنا موعدك بملكنا ولٰكنا حملنا اوزارا من زينة القوم فقذفنٰها فكذٰلك القى السامري",
    "ayahnumber" : "87",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2473",
    "page" : "317",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2474",
    "ayah_text" : "فَأَخۡرَجَ لَهُمۡ عِجۡلٗا جَسَدٗا لَّهُۥ خُوَارٞ فَقَالُواْ هَٰذَآ إِلَٰهُكُمۡ وَإِلَٰهُ مُوسَىٰ فَنَسِيَ",
    "ayah_text_no_diacratic" : "فاخرج لهم عجلا جسدا له خوار فقالوا هٰذا الٰهكم والٰه موسىٰ فنسي",
    "ayahnumber" : "88",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2474",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2475",
    "ayah_text" : "أَفَلَا يَرَوۡنَ أَلَّا يَرۡجِعُ إِلَيۡهِمۡ قَوۡلٗا وَلَا يَمۡلِكُ لَهُمۡ ضَرّٗا وَلَا نَفۡعٗا",
    "ayah_text_no_diacratic" : "افلا يرون الا يرجع اليهم قولا ولا يملك لهم ضرا ولا نفعا",
    "ayahnumber" : "89",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2475",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2476",
    "ayah_text" : "وَلَقَدۡ قَالَ لَهُمۡ هَٰرُونُ مِن قَبۡلُ يَٰقَوۡمِ إِنَّمَا فُتِنتُم بِهِۦۖ وَإِنَّ رَبَّكُمُ ٱلرَّحۡمَٰنُ فَٱتَّبِعُونِي وَأَطِيعُوٓاْ أَمۡرِي",
    "ayah_text_no_diacratic" : "ولقد قال لهم هٰرون من قبل يٰقوم انما فتنتم به وان ربكم الرحمٰن فاتبعوني واطيعوا امري",
    "ayahnumber" : "90",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2476",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2477",
    "ayah_text" : "قَالُواْ لَن نَّبۡرَحَ عَلَيۡهِ عَٰكِفِينَ حَتَّىٰ يَرۡجِعَ إِلَيۡنَا مُوسَىٰ",
    "ayah_text_no_diacratic" : "قالوا لن نبرح عليه عٰكفين حتىٰ يرجع الينا موسىٰ",
    "ayahnumber" : "91",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2477",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2478",
    "ayah_text" : "قَالَ يَٰهَٰرُونُ مَا مَنَعَكَ إِذۡ رَأَيۡتَهُمۡ ضَلُّوٓاْ",
    "ayah_text_no_diacratic" : "قال يٰهٰرون ما منعك اذ رايتهم ضلوا",
    "ayahnumber" : "92",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2478",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2479",
    "ayah_text" : "أَلَّا تَتَّبِعَنِۖ أَفَعَصَيۡتَ أَمۡرِي",
    "ayah_text_no_diacratic" : "الا تتبعن افعصيت امري",
    "ayahnumber" : "93",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2479",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:248",
    "ayah_text" : "حَٰفِظُواْ عَلَى ٱلصَّلَوَٰتِ وَٱلصَّلَوٰةِ ٱلۡوُسۡطَىٰ وَقُومُواْ لِلَّهِ قَٰنِتِينَ",
    "ayah_text_no_diacratic" : "حٰفظوا على الصلوٰت والصلوٰة الوسطىٰ وقوموا لله قٰنتين",
    "ayahnumber" : "238",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "248",
    "page" : "39",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2480",
    "ayah_text" : "قَالَ يَبۡنَؤُمَّ لَا تَأۡخُذۡ بِلِحۡيَتِي وَلَا بِرَأۡسِيٓۖ إِنِّي خَشِيتُ أَن تَقُولَ فَرَّقۡتَ بَيۡنَ بَنِيٓ إِسۡرَٰٓءِيلَ وَلَمۡ تَرۡقُبۡ قَوۡلِي",
    "ayah_text_no_diacratic" : "قال يبنؤم لا تاخذ بلحيتي ولا براسي اني خشيت ان تقول فرقت بين بني اسرٰءيل ولم ترقب قولي",
    "ayahnumber" : "94",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2480",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2481",
    "ayah_text" : "قَالَ فَمَا خَطۡبُكَ يَٰسَٰمِرِيُّ",
    "ayah_text_no_diacratic" : "قال فما خطبك يٰسٰمري",
    "ayahnumber" : "95",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2481",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2482",
    "ayah_text" : "قَالَ بَصُرۡتُ بِمَا لَمۡ يَبۡصُرُواْ بِهِۦ فَقَبَضۡتُ قَبۡضَةٗ مِّنۡ أَثَرِ ٱلرَّسُولِ فَنَبَذۡتُهَا وَكَذَٰلِكَ سَوَّلَتۡ لِي نَفۡسِي",
    "ayah_text_no_diacratic" : "قال بصرت بما لم يبصروا به فقبضت قبضة من اثر الرسول فنبذتها وكذٰلك سولت لي نفسي",
    "ayahnumber" : "96",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2482",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2483",
    "ayah_text" : "قَالَ فَٱذۡهَبۡ فَإِنَّ لَكَ فِي ٱلۡحَيَوٰةِ أَن تَقُولَ لَا مِسَاسَۖ وَإِنَّ لَكَ مَوۡعِدٗا لَّن تُخۡلَفَهُۥۖ وَٱنظُرۡ إِلَىٰٓ إِلَٰهِكَ ٱلَّذِي ظَلۡتَ عَلَيۡهِ عَاكِفٗاۖ لَّنُحَرِّقَنَّهُۥ ثُمَّ لَنَنسِفَنَّهُۥ فِي ٱلۡيَمِّ نَسۡفًا",
    "ayah_text_no_diacratic" : "قال فاذهب فان لك في الحيوٰة ان تقول لا مساس وان لك موعدا لن تخلفه وانظر الىٰ الٰهك الذي ظلت عليه عاكفا لنحرقنه ثم لننسفنه في اليم نسفا",
    "ayahnumber" : "97",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2483",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2484",
    "ayah_text" : "إِنَّمَآ إِلَٰهُكُمُ ٱللَّهُ ٱلَّذِي لَآ إِلَٰهَ إِلَّا هُوَۚ وَسِعَ كُلَّ شَيۡءٍ عِلۡمٗا",
    "ayah_text_no_diacratic" : "انما الٰهكم الله الذي لا الٰه الا هو وسع كل شيء علما",
    "ayahnumber" : "98",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2484",
    "page" : "318",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2485",
    "ayah_text" : "كَذَٰلِكَ نَقُصُّ عَلَيۡكَ مِنۡ أَنۢبَآءِ مَا قَدۡ سَبَقَۚ وَقَدۡ ءَاتَيۡنَٰكَ مِن لَّدُنَّا ذِكۡرٗا",
    "ayah_text_no_diacratic" : "كذٰلك نقص عليك من انباء ما قد سبق وقد ءاتينٰك من لدنا ذكرا",
    "ayahnumber" : "99",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2485",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2486",
    "ayah_text" : "مَّنۡ أَعۡرَضَ عَنۡهُ فَإِنَّهُۥ يَحۡمِلُ يَوۡمَ ٱلۡقِيَٰمَةِ وِزۡرًا",
    "ayah_text_no_diacratic" : "من اعرض عنه فانه يحمل يوم القيٰمة وزرا",
    "ayahnumber" : "100",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2486",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2487",
    "ayah_text" : "خَٰلِدِينَ فِيهِۖ وَسَآءَ لَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ حِمۡلٗا",
    "ayah_text_no_diacratic" : "خٰلدين فيه وساء لهم يوم القيٰمة حملا",
    "ayahnumber" : "101",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2487",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2488",
    "ayah_text" : "يَوۡمَ يُنفَخُ فِي ٱلصُّورِۚ وَنَحۡشُرُ ٱلۡمُجۡرِمِينَ يَوۡمَئِذٖ زُرۡقٗا",
    "ayah_text_no_diacratic" : "يوم ينفخ في الصور ونحشر المجرمين يومئذ زرقا",
    "ayahnumber" : "102",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2488",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2489",
    "ayah_text" : "يَتَخَٰفَتُونَ بَيۡنَهُمۡ إِن لَّبِثۡتُمۡ إِلَّا عَشۡرٗا",
    "ayah_text_no_diacratic" : "يتخٰفتون بينهم ان لبثتم الا عشرا",
    "ayahnumber" : "103",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2489",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:249",
    "ayah_text" : "فَإِنۡ خِفۡتُمۡ فَرِجَالًا أَوۡ رُكۡبَانٗاۖ فَإِذَآ أَمِنتُمۡ فَٱذۡكُرُواْ ٱللَّهَ كَمَا عَلَّمَكُم مَّا لَمۡ تَكُونُواْ تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فان خفتم فرجالا او ركبانا فاذا امنتم فاذكروا الله كما علمكم ما لم تكونوا تعلمون",
    "ayahnumber" : "239",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "249",
    "page" : "39",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2490",
    "ayah_text" : "نَّحۡنُ أَعۡلَمُ بِمَا يَقُولُونَ إِذۡ يَقُولُ أَمۡثَلُهُمۡ طَرِيقَةً إِن لَّبِثۡتُمۡ إِلَّا يَوۡمٗا",
    "ayah_text_no_diacratic" : "نحن اعلم بما يقولون اذ يقول امثلهم طريقة ان لبثتم الا يوما",
    "ayahnumber" : "104",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2490",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2491",
    "ayah_text" : "وَيَسۡـَٔلُونَكَ عَنِ ٱلۡجِبَالِ فَقُلۡ يَنسِفُهَا رَبِّي نَسۡفٗا",
    "ayah_text_no_diacratic" : "ويسلونك عن الجبال فقل ينسفها ربي نسفا",
    "ayahnumber" : "105",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2491",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2492",
    "ayah_text" : "فَيَذَرُهَا قَاعٗا صَفۡصَفٗا",
    "ayah_text_no_diacratic" : "فيذرها قاعا صفصفا",
    "ayahnumber" : "106",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2492",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2493",
    "ayah_text" : "لَّا تَرَىٰ فِيهَا عِوَجٗا وَلَآ أَمۡتٗا",
    "ayah_text_no_diacratic" : "لا ترىٰ فيها عوجا ولا امتا",
    "ayahnumber" : "107",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2493",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2494",
    "ayah_text" : "يَوۡمَئِذٖ يَتَّبِعُونَ ٱلدَّاعِيَ لَا عِوَجَ لَهُۥۖ وَخَشَعَتِ ٱلۡأَصۡوَاتُ لِلرَّحۡمَٰنِ فَلَا تَسۡمَعُ إِلَّا هَمۡسٗا",
    "ayah_text_no_diacratic" : "يومئذ يتبعون الداعي لا عوج له وخشعت الاصوات للرحمٰن فلا تسمع الا همسا",
    "ayahnumber" : "108",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2494",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2495",
    "ayah_text" : "يَوۡمَئِذٖ لَّا تَنفَعُ ٱلشَّفَٰعَةُ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَرَضِيَ لَهُۥ قَوۡلٗا",
    "ayah_text_no_diacratic" : "يومئذ لا تنفع الشفٰعة الا من اذن له الرحمٰن ورضي له قولا",
    "ayahnumber" : "109",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2495",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2496",
    "ayah_text" : "يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡ وَلَا يُحِيطُونَ بِهِۦ عِلۡمٗا",
    "ayah_text_no_diacratic" : "يعلم ما بين ايديهم وما خلفهم ولا يحيطون به علما",
    "ayahnumber" : "110",
    "chapter" : "16",
    "hizb" : "31",
    "index" : "2496",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2497",
    "ayah_text" : "۞وَعَنَتِ ٱلۡوُجُوهُ لِلۡحَيِّ ٱلۡقَيُّومِۖ وَقَدۡ خَابَ مَنۡ حَمَلَ ظُلۡمٗا",
    "ayah_text_no_diacratic" : "وعنت الوجوه للحي القيوم وقد خاب من حمل ظلما",
    "ayahnumber" : "111",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2497",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2498",
    "ayah_text" : "وَمَن يَعۡمَلۡ مِنَ ٱلصَّٰلِحَٰتِ وَهُوَ مُؤۡمِنٞ فَلَا يَخَافُ ظُلۡمٗا وَلَا هَضۡمٗا",
    "ayah_text_no_diacratic" : "ومن يعمل من الصٰلحٰت وهو مؤمن فلا يخاف ظلما ولا هضما",
    "ayahnumber" : "112",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2498",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2499",
    "ayah_text" : "وَكَذَٰلِكَ أَنزَلۡنَٰهُ قُرۡءَانًا عَرَبِيّٗا وَصَرَّفۡنَا فِيهِ مِنَ ٱلۡوَعِيدِ لَعَلَّهُمۡ يَتَّقُونَ أَوۡ يُحۡدِثُ لَهُمۡ ذِكۡرٗا",
    "ayah_text_no_diacratic" : "وكذٰلك انزلنٰه قرءانا عربيا وصرفنا فيه من الوعيد لعلهم يتقون او يحدث لهم ذكرا",
    "ayahnumber" : "113",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2499",
    "page" : "319",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:25",
    "ayah_text" : "ٱللَّهُ يَسۡتَهۡزِئُ بِهِمۡ وَيَمُدُّهُمۡ فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ",
    "ayah_text_no_diacratic" : "الله يستهزئ بهم ويمدهم في طغيٰنهم يعمهون",
    "ayahnumber" : "15",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "25",
    "page" : "3",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:250",
    "ayah_text" : "وَٱلَّذِينَ يُتَوَفَّوۡنَ مِنكُمۡ وَيَذَرُونَ أَزۡوَٰجٗا وَصِيَّةٗ لِّأَزۡوَٰجِهِم مَّتَٰعًا إِلَى ٱلۡحَوۡلِ غَيۡرَ إِخۡرَاجٖۚ فَإِنۡ خَرَجۡنَ فَلَا جُنَاحَ عَلَيۡكُمۡ فِي مَا فَعَلۡنَ فِيٓ أَنفُسِهِنَّ مِن مَّعۡرُوفٖۗ وَٱللَّهُ عَزِيزٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "والذين يتوفون منكم ويذرون ازوٰجا وصية لازوٰجهم متٰعا الى الحول غير اخراج فان خرجن فلا جناح عليكم في ما فعلن في انفسهن من معروف والله عزيز حكيم",
    "ayahnumber" : "240",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "250",
    "page" : "39",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2500",
    "ayah_text" : "فَتَعَٰلَى ٱللَّهُ ٱلۡمَلِكُ ٱلۡحَقُّۗ وَلَا تَعۡجَلۡ بِٱلۡقُرۡءَانِ مِن قَبۡلِ أَن يُقۡضَىٰٓ إِلَيۡكَ وَحۡيُهُۥۖ وَقُل رَّبِّ زِدۡنِي عِلۡمٗا",
    "ayah_text_no_diacratic" : "فتعٰلى الله الملك الحق ولا تعجل بالقرءان من قبل ان يقضىٰ اليك وحيه وقل رب زدني علما",
    "ayahnumber" : "114",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2500",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2501",
    "ayah_text" : "وَلَقَدۡ عَهِدۡنَآ إِلَىٰٓ ءَادَمَ مِن قَبۡلُ فَنَسِيَ وَلَمۡ نَجِدۡ لَهُۥ عَزۡمٗا",
    "ayah_text_no_diacratic" : "ولقد عهدنا الىٰ ءادم من قبل فنسي ولم نجد له عزما",
    "ayahnumber" : "115",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2501",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2502",
    "ayah_text" : "وَإِذۡ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ أَبَىٰ",
    "ayah_text_no_diacratic" : "واذ قلنا للملٰئكة اسجدوا لادم فسجدوا الا ابليس ابىٰ",
    "ayahnumber" : "116",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2502",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2503",
    "ayah_text" : "فَقُلۡنَا يَٰٓـَٔادَمُ إِنَّ هَٰذَا عَدُوّٞ لَّكَ وَلِزَوۡجِكَ فَلَا يُخۡرِجَنَّكُمَا مِنَ ٱلۡجَنَّةِ فَتَشۡقَىٰٓ",
    "ayah_text_no_diacratic" : "فقلنا يٰادم ان هٰذا عدو لك ولزوجك فلا يخرجنكما من الجنة فتشقىٰ",
    "ayahnumber" : "117",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2503",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2504",
    "ayah_text" : "إِنَّ لَكَ أَلَّا تَجُوعَ فِيهَا وَلَا تَعۡرَىٰ",
    "ayah_text_no_diacratic" : "ان لك الا تجوع فيها ولا تعرىٰ",
    "ayahnumber" : "118",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2504",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2505",
    "ayah_text" : "وَأَنَّكَ لَا تَظۡمَؤُاْ فِيهَا وَلَا تَضۡحَىٰ",
    "ayah_text_no_diacratic" : "وانك لا تظمؤا فيها ولا تضحىٰ",
    "ayahnumber" : "119",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2505",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2506",
    "ayah_text" : "فَوَسۡوَسَ إِلَيۡهِ ٱلشَّيۡطَٰنُ قَالَ يَٰٓـَٔادَمُ هَلۡ أَدُلُّكَ عَلَىٰ شَجَرَةِ ٱلۡخُلۡدِ وَمُلۡكٖ لَّا يَبۡلَىٰ",
    "ayah_text_no_diacratic" : "فوسوس اليه الشيطٰن قال يٰادم هل ادلك علىٰ شجرة الخلد وملك لا يبلىٰ",
    "ayahnumber" : "120",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2506",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2507",
    "ayah_text" : "فَأَكَلَا مِنۡهَا فَبَدَتۡ لَهُمَا سَوۡءَٰتُهُمَا وَطَفِقَا يَخۡصِفَانِ عَلَيۡهِمَا مِن وَرَقِ ٱلۡجَنَّةِۚ وَعَصَىٰٓ ءَادَمُ رَبَّهُۥ فَغَوَىٰ",
    "ayah_text_no_diacratic" : "فاكلا منها فبدت لهما سوءٰتهما وطفقا يخصفان عليهما من ورق الجنة وعصىٰ ءادم ربه فغوىٰ",
    "ayahnumber" : "121",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2507",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2508",
    "ayah_text" : "ثُمَّ ٱجۡتَبَٰهُ رَبُّهُۥ فَتَابَ عَلَيۡهِ وَهَدَىٰ",
    "ayah_text_no_diacratic" : "ثم اجتبٰه ربه فتاب عليه وهدىٰ",
    "ayahnumber" : "122",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2508",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2509",
    "ayah_text" : "قَالَ ٱهۡبِطَا مِنۡهَا جَمِيعَۢاۖ بَعۡضُكُمۡ لِبَعۡضٍ عَدُوّٞۖ فَإِمَّا يَأۡتِيَنَّكُم مِّنِّي هُدٗى فَمَنِ ٱتَّبَعَ هُدَايَ فَلَا يَضِلُّ وَلَا يَشۡقَىٰ",
    "ayah_text_no_diacratic" : "قال اهبطا منها جميعا بعضكم لبعض عدو فاما ياتينكم مني هدى فمن اتبع هداي فلا يضل ولا يشقىٰ",
    "ayahnumber" : "123",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2509",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:251",
    "ayah_text" : "وَلِلۡمُطَلَّقَٰتِ مَتَٰعُۢ بِٱلۡمَعۡرُوفِۖ حَقًّا عَلَى ٱلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "وللمطلقٰت متٰع بالمعروف حقا على المتقين",
    "ayahnumber" : "241",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "251",
    "page" : "39",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2510",
    "ayah_text" : "وَمَنۡ أَعۡرَضَ عَن ذِكۡرِي فَإِنَّ لَهُۥ مَعِيشَةٗ ضَنكٗا وَنَحۡشُرُهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ أَعۡمَىٰ",
    "ayah_text_no_diacratic" : "ومن اعرض عن ذكري فان له معيشة ضنكا ونحشره يوم القيٰمة اعمىٰ",
    "ayahnumber" : "124",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2510",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2511",
    "ayah_text" : "قَالَ رَبِّ لِمَ حَشَرۡتَنِيٓ أَعۡمَىٰ وَقَدۡ كُنتُ بَصِيرٗا",
    "ayah_text_no_diacratic" : "قال رب لم حشرتني اعمىٰ وقد كنت بصيرا",
    "ayahnumber" : "125",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2511",
    "page" : "320",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2512",
    "ayah_text" : "قَالَ كَذَٰلِكَ أَتَتۡكَ ءَايَٰتُنَا فَنَسِيتَهَاۖ وَكَذَٰلِكَ ٱلۡيَوۡمَ تُنسَىٰ",
    "ayah_text_no_diacratic" : "قال كذٰلك اتتك ءايٰتنا فنسيتها وكذٰلك اليوم تنسىٰ",
    "ayahnumber" : "126",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2512",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2513",
    "ayah_text" : "وَكَذَٰلِكَ نَجۡزِي مَنۡ أَسۡرَفَ وَلَمۡ يُؤۡمِنۢ بِـَٔايَٰتِ رَبِّهِۦۚ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَشَدُّ وَأَبۡقَىٰٓ",
    "ayah_text_no_diacratic" : "وكذٰلك نجزي من اسرف ولم يؤمن بايٰت ربه ولعذاب الاخرة اشد وابقىٰ",
    "ayahnumber" : "127",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2513",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2514",
    "ayah_text" : "أَفَلَمۡ يَهۡدِ لَهُمۡ كَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّنَ ٱلۡقُرُونِ يَمۡشُونَ فِي مَسَٰكِنِهِمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّأُوْلِي ٱلنُّهَىٰ",
    "ayah_text_no_diacratic" : "افلم يهد لهم كم اهلكنا قبلهم من القرون يمشون في مسٰكنهم ان في ذٰلك لايٰت لاولي النهىٰ",
    "ayahnumber" : "128",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2514",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2515",
    "ayah_text" : "وَلَوۡلَا كَلِمَةٞ سَبَقَتۡ مِن رَّبِّكَ لَكَانَ لِزَامٗا وَأَجَلٞ مُّسَمّٗى",
    "ayah_text_no_diacratic" : "ولولا كلمة سبقت من ربك لكان لزاما واجل مسمى",
    "ayahnumber" : "129",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2515",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2516",
    "ayah_text" : "فَٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ قَبۡلَ طُلُوعِ ٱلشَّمۡسِ وَقَبۡلَ غُرُوبِهَاۖ وَمِنۡ ءَانَآيِٕ ٱلَّيۡلِ فَسَبِّحۡ وَأَطۡرَافَ ٱلنَّهَارِ لَعَلَّكَ تَرۡضَىٰ",
    "ayah_text_no_diacratic" : "فاصبر علىٰ ما يقولون وسبح بحمد ربك قبل طلوع الشمس وقبل غروبها ومن ءاناي اليل فسبح واطراف النهار لعلك ترضىٰ",
    "ayahnumber" : "130",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2516",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2517",
    "ayah_text" : "وَلَا تَمُدَّنَّ عَيۡنَيۡكَ إِلَىٰ مَا مَتَّعۡنَا بِهِۦٓ أَزۡوَٰجٗا مِّنۡهُمۡ زَهۡرَةَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا لِنَفۡتِنَهُمۡ فِيهِۚ وَرِزۡقُ رَبِّكَ خَيۡرٞ وَأَبۡقَىٰ",
    "ayah_text_no_diacratic" : "ولا تمدن عينيك الىٰ ما متعنا به ازوٰجا منهم زهرة الحيوٰة الدنيا لنفتنهم فيه ورزق ربك خير وابقىٰ",
    "ayahnumber" : "131",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2517",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2518",
    "ayah_text" : "وَأۡمُرۡ أَهۡلَكَ بِٱلصَّلَوٰةِ وَٱصۡطَبِرۡ عَلَيۡهَاۖ لَا نَسۡـَٔلُكَ رِزۡقٗاۖ نَّحۡنُ نَرۡزُقُكَۗ وَٱلۡعَٰقِبَةُ لِلتَّقۡوَىٰ",
    "ayah_text_no_diacratic" : "وامر اهلك بالصلوٰة واصطبر عليها لا نسلك رزقا نحن نرزقك والعٰقبة للتقوىٰ",
    "ayahnumber" : "132",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2518",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2519",
    "ayah_text" : "وَقَالُواْ لَوۡلَا يَأۡتِينَا بِـَٔايَةٖ مِّن رَّبِّهِۦٓۚ أَوَلَمۡ تَأۡتِهِم بَيِّنَةُ مَا فِي ٱلصُّحُفِ ٱلۡأُولَىٰ",
    "ayah_text_no_diacratic" : "وقالوا لولا ياتينا باية من ربه اولم تاتهم بينة ما في الصحف الاولىٰ",
    "ayahnumber" : "133",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2519",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:252",
    "ayah_text" : "كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمۡ ءَايَٰتِهِۦ لَعَلَّكُمۡ تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "كذٰلك يبين الله لكم ءايٰته لعلكم تعقلون",
    "ayahnumber" : "242",
    "chapter" : "2",
    "hizb" : "3",
    "index" : "252",
    "page" : "39",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2520",
    "ayah_text" : "وَلَوۡ أَنَّآ أَهۡلَكۡنَٰهُم بِعَذَابٖ مِّن قَبۡلِهِۦ لَقَالُواْ رَبَّنَا لَوۡلَآ أَرۡسَلۡتَ إِلَيۡنَا رَسُولٗا فَنَتَّبِعَ ءَايَٰتِكَ مِن قَبۡلِ أَن نَّذِلَّ وَنَخۡزَىٰ",
    "ayah_text_no_diacratic" : "ولو انا اهلكنٰهم بعذاب من قبله لقالوا ربنا لولا ارسلت الينا رسولا فنتبع ءايٰتك من قبل ان نذل ونخزىٰ",
    "ayahnumber" : "134",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2520",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2521",
    "ayah_text" : "قُلۡ كُلّٞ مُّتَرَبِّصٞ فَتَرَبَّصُواْۖ فَسَتَعۡلَمُونَ مَنۡ أَصۡحَٰبُ ٱلصِّرَٰطِ ٱلسَّوِيِّ وَمَنِ ٱهۡتَدَىٰ",
    "ayah_text_no_diacratic" : "قل كل متربص فتربصوا فستعلمون من اصحٰب الصرٰط السوي ومن اهتدىٰ",
    "ayahnumber" : "135",
    "chapter" : "16",
    "hizb" : "32",
    "index" : "2521",
    "page" : "321",
    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2522",
    "ayah_text" : "سُورَةُ الأَنبِيَاءِ",
    "ayah_text_no_diacratic" : "سورة الانبياء",
    "ayahnumber" : "0",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2522",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2523",
    "ayah_text" : "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
    "ayah_text_no_diacratic" : "بسم الله الرحمٰن الرحيم",
    "ayahnumber" : "0",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2523",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2524",
    "ayah_text" : "ٱقۡتَرَبَ لِلنَّاسِ حِسَابُهُمۡ وَهُمۡ فِي غَفۡلَةٖ مُّعۡرِضُونَ",
    "ayah_text_no_diacratic" : "اقترب للناس حسابهم وهم في غفلة معرضون",
    "ayahnumber" : "1",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2524",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2525",
    "ayah_text" : "مَا يَأۡتِيهِم مِّن ذِكۡرٖ مِّن رَّبِّهِم مُّحۡدَثٍ إِلَّا ٱسۡتَمَعُوهُ وَهُمۡ يَلۡعَبُونَ",
    "ayah_text_no_diacratic" : "ما ياتيهم من ذكر من ربهم محدث الا استمعوه وهم يلعبون",
    "ayahnumber" : "2",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2525",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2526",
    "ayah_text" : "لَاهِيَةٗ قُلُوبُهُمۡۗ وَأَسَرُّواْ ٱلنَّجۡوَى ٱلَّذِينَ ظَلَمُواْ هَلۡ هَٰذَآ إِلَّا بَشَرٞ مِّثۡلُكُمۡۖ أَفَتَأۡتُونَ ٱلسِّحۡرَ وَأَنتُمۡ تُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "لاهية قلوبهم واسروا النجوى الذين ظلموا هل هٰذا الا بشر مثلكم افتاتون السحر وانتم تبصرون",
    "ayahnumber" : "3",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2526",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2527",
    "ayah_text" : "قَالَ رَبِّي يَعۡلَمُ ٱلۡقَوۡلَ فِي ٱلسَّمَآءِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "قال ربي يعلم القول في السماء والارض وهو السميع العليم",
    "ayahnumber" : "4",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2527",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2528",
    "ayah_text" : "بَلۡ قَالُوٓاْ أَضۡغَٰثُ أَحۡلَٰمِۭ بَلِ ٱفۡتَرَىٰهُ بَلۡ هُوَ شَاعِرٞ فَلۡيَأۡتِنَا بِـَٔايَةٖ كَمَآ أُرۡسِلَ ٱلۡأَوَّلُونَ",
    "ayah_text_no_diacratic" : "بل قالوا اضغٰث احلٰم بل افترىٰه بل هو شاعر فلياتنا باية كما ارسل الاولون",
    "ayahnumber" : "5",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2528",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2529",
    "ayah_text" : "مَآ ءَامَنَتۡ قَبۡلَهُم مِّن قَرۡيَةٍ أَهۡلَكۡنَٰهَآۖ أَفَهُمۡ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "ما ءامنت قبلهم من قرية اهلكنٰها افهم يؤمنون",
    "ayahnumber" : "6",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2529",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:253",
    "ayah_text" : "۞أَلَمۡ تَرَ إِلَى ٱلَّذِينَ خَرَجُواْ مِن دِيَٰرِهِمۡ وَهُمۡ أُلُوفٌ حَذَرَ ٱلۡمَوۡتِ فَقَالَ لَهُمُ ٱللَّهُ مُوتُواْ ثُمَّ أَحۡيَٰهُمۡۚ إِنَّ ٱللَّهَ لَذُو فَضۡلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "الم تر الى الذين خرجوا من ديٰرهم وهم الوف حذر الموت فقال لهم الله موتوا ثم احيٰهم ان الله لذو فضل على الناس ولٰكن اكثر الناس لا يشكرون",
    "ayahnumber" : "243",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "253",
    "page" : "39",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2530",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَا قَبۡلَكَ إِلَّا رِجَالٗا نُّوحِيٓ إِلَيۡهِمۡۖ فَسۡـَٔلُوٓاْ أَهۡلَ ٱلذِّكۡرِ إِن كُنتُمۡ لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "وما ارسلنا قبلك الا رجالا نوحي اليهم فسلوا اهل الذكر ان كنتم لا تعلمون",
    "ayahnumber" : "7",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2530",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2531",
    "ayah_text" : "وَمَا جَعَلۡنَٰهُمۡ جَسَدٗا لَّا يَأۡكُلُونَ ٱلطَّعَامَ وَمَا كَانُواْ خَٰلِدِينَ",
    "ayah_text_no_diacratic" : "وما جعلنٰهم جسدا لا ياكلون الطعام وما كانوا خٰلدين",
    "ayahnumber" : "8",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2531",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2532",
    "ayah_text" : "ثُمَّ صَدَقۡنَٰهُمُ ٱلۡوَعۡدَ فَأَنجَيۡنَٰهُمۡ وَمَن نَّشَآءُ وَأَهۡلَكۡنَا ٱلۡمُسۡرِفِينَ",
    "ayah_text_no_diacratic" : "ثم صدقنٰهم الوعد فانجينٰهم ومن نشاء واهلكنا المسرفين",
    "ayahnumber" : "9",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2532",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2533",
    "ayah_text" : "لَقَدۡ أَنزَلۡنَآ إِلَيۡكُمۡ كِتَٰبٗا فِيهِ ذِكۡرُكُمۡۚ أَفَلَا تَعۡقِلُونَ",
    "ayah_text_no_diacratic" : "لقد انزلنا اليكم كتٰبا فيه ذكركم افلا تعقلون",
    "ayahnumber" : "10",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2533",
    "page" : "322",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2534",
    "ayah_text" : "وَكَمۡ قَصَمۡنَا مِن قَرۡيَةٖ كَانَتۡ ظَالِمَةٗ وَأَنشَأۡنَا بَعۡدَهَا قَوۡمًا ءَاخَرِينَ",
    "ayah_text_no_diacratic" : "وكم قصمنا من قرية كانت ظالمة وانشانا بعدها قوما ءاخرين",
    "ayahnumber" : "11",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2534",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2535",
    "ayah_text" : "فَلَمَّآ أَحَسُّواْ بَأۡسَنَآ إِذَا هُم مِّنۡهَا يَرۡكُضُونَ",
    "ayah_text_no_diacratic" : "فلما احسوا باسنا اذا هم منها يركضون",
    "ayahnumber" : "12",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2535",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2536",
    "ayah_text" : "لَا تَرۡكُضُواْ وَٱرۡجِعُوٓاْ إِلَىٰ مَآ أُتۡرِفۡتُمۡ فِيهِ وَمَسَٰكِنِكُمۡ لَعَلَّكُمۡ تُسۡـَٔلُونَ",
    "ayah_text_no_diacratic" : "لا تركضوا وارجعوا الىٰ ما اترفتم فيه ومسٰكنكم لعلكم تسلون",
    "ayahnumber" : "13",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2536",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2537",
    "ayah_text" : "قَالُواْ يَٰوَيۡلَنَآ إِنَّا كُنَّا ظَٰلِمِينَ",
    "ayah_text_no_diacratic" : "قالوا يٰويلنا انا كنا ظٰلمين",
    "ayahnumber" : "14",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2537",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2538",
    "ayah_text" : "فَمَا زَالَت تِّلۡكَ دَعۡوَىٰهُمۡ حَتَّىٰ جَعَلۡنَٰهُمۡ حَصِيدًا خَٰمِدِينَ",
    "ayah_text_no_diacratic" : "فما زالت تلك دعوىٰهم حتىٰ جعلنٰهم حصيدا خٰمدين",
    "ayahnumber" : "15",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2538",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2539",
    "ayah_text" : "وَمَا خَلَقۡنَا ٱلسَّمَآءَ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا لَٰعِبِينَ",
    "ayah_text_no_diacratic" : "وما خلقنا السماء والارض وما بينهما لٰعبين",
    "ayahnumber" : "16",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2539",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:254",
    "ayah_text" : "وَقَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "وقٰتلوا في سبيل الله واعلموا ان الله سميع عليم",
    "ayahnumber" : "244",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "254",
    "page" : "39",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2540",
    "ayah_text" : "لَوۡ أَرَدۡنَآ أَن نَّتَّخِذَ لَهۡوٗا لَّٱتَّخَذۡنَٰهُ مِن لَّدُنَّآ إِن كُنَّا فَٰعِلِينَ",
    "ayah_text_no_diacratic" : "لو اردنا ان نتخذ لهوا لاتخذنٰه من لدنا ان كنا فٰعلين",
    "ayahnumber" : "17",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2540",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2541",
    "ayah_text" : "بَلۡ نَقۡذِفُ بِٱلۡحَقِّ عَلَى ٱلۡبَٰطِلِ فَيَدۡمَغُهُۥ فَإِذَا هُوَ زَاهِقٞۚ وَلَكُمُ ٱلۡوَيۡلُ مِمَّا تَصِفُونَ",
    "ayah_text_no_diacratic" : "بل نقذف بالحق على البٰطل فيدمغه فاذا هو زاهق ولكم الويل مما تصفون",
    "ayahnumber" : "18",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2541",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2542",
    "ayah_text" : "وَلَهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَمَنۡ عِندَهُۥ لَا يَسۡتَكۡبِرُونَ عَنۡ عِبَادَتِهِۦ وَلَا يَسۡتَحۡسِرُونَ",
    "ayah_text_no_diacratic" : "وله من في السمٰوٰت والارض ومن عنده لا يستكبرون عن عبادته ولا يستحسرون",
    "ayahnumber" : "19",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2542",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2543",
    "ayah_text" : "يُسَبِّحُونَ ٱلَّيۡلَ وَٱلنَّهَارَ لَا يَفۡتُرُونَ",
    "ayah_text_no_diacratic" : "يسبحون اليل والنهار لا يفترون",
    "ayahnumber" : "20",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2543",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2544",
    "ayah_text" : "أَمِ ٱتَّخَذُوٓاْ ءَالِهَةٗ مِّنَ ٱلۡأَرۡضِ هُمۡ يُنشِرُونَ",
    "ayah_text_no_diacratic" : "ام اتخذوا ءالهة من الارض هم ينشرون",
    "ayahnumber" : "21",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2544",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2545",
    "ayah_text" : "لَوۡ كَانَ فِيهِمَآ ءَالِهَةٌ إِلَّا ٱللَّهُ لَفَسَدَتَاۚ فَسُبۡحَٰنَ ٱللَّهِ رَبِّ ٱلۡعَرۡشِ عَمَّا يَصِفُونَ",
    "ayah_text_no_diacratic" : "لو كان فيهما ءالهة الا الله لفسدتا فسبحٰن الله رب العرش عما يصفون",
    "ayahnumber" : "22",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2545",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2546",
    "ayah_text" : "لَا يُسۡـَٔلُ عَمَّا يَفۡعَلُ وَهُمۡ يُسۡـَٔلُونَ",
    "ayah_text_no_diacratic" : "لا يسل عما يفعل وهم يسلون",
    "ayahnumber" : "23",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2546",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2547",
    "ayah_text" : "أَمِ ٱتَّخَذُواْ مِن دُونِهِۦٓ ءَالِهَةٗۖ قُلۡ هَاتُواْ بُرۡهَٰنَكُمۡۖ هَٰذَا ذِكۡرُ مَن مَّعِيَ وَذِكۡرُ مَن قَبۡلِيۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ ٱلۡحَقَّۖ فَهُم مُّعۡرِضُونَ",
    "ayah_text_no_diacratic" : "ام اتخذوا من دونه ءالهة قل هاتوا برهٰنكم هٰذا ذكر من معي وذكر من قبلي بل اكثرهم لا يعلمون الحق فهم معرضون",
    "ayahnumber" : "24",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2547",
    "page" : "323",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2548",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَا مِن قَبۡلِكَ مِن رَّسُولٍ إِلَّا نُوحِيٓ إِلَيۡهِ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعۡبُدُونِ",
    "ayah_text_no_diacratic" : "وما ارسلنا من قبلك من رسول الا نوحي اليه انه لا الٰه الا انا فاعبدون",
    "ayahnumber" : "25",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2548",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2549",
    "ayah_text" : "وَقَالُواْ ٱتَّخَذَ ٱلرَّحۡمَٰنُ وَلَدٗاۗ سُبۡحَٰنَهُۥۚ بَلۡ عِبَادٞ مُّكۡرَمُونَ",
    "ayah_text_no_diacratic" : "وقالوا اتخذ الرحمٰن ولدا سبحٰنه بل عباد مكرمون",
    "ayahnumber" : "26",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2549",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:255",
    "ayah_text" : "مَّن ذَا ٱلَّذِي يُقۡرِضُ ٱللَّهَ قَرۡضًا حَسَنٗا فَيُضَٰعِفَهُۥ لَهُۥٓ أَضۡعَافٗا كَثِيرَةٗۚ وَٱللَّهُ يَقۡبِضُ وَيَبۡصُۜطُ وَإِلَيۡهِ تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "من ذا الذي يقرض الله قرضا حسنا فيضٰعفه له اضعافا كثيرة والله يقبض ويبصط واليه ترجعون",
    "ayahnumber" : "245",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "255",
    "page" : "39",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2550",
    "ayah_text" : "لَا يَسۡبِقُونَهُۥ بِٱلۡقَوۡلِ وَهُم بِأَمۡرِهِۦ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "لا يسبقونه بالقول وهم بامره يعملون",
    "ayahnumber" : "27",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2550",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2551",
    "ayah_text" : "يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡ وَلَا يَشۡفَعُونَ إِلَّا لِمَنِ ٱرۡتَضَىٰ وَهُم مِّنۡ خَشۡيَتِهِۦ مُشۡفِقُونَ",
    "ayah_text_no_diacratic" : "يعلم ما بين ايديهم وما خلفهم ولا يشفعون الا لمن ارتضىٰ وهم من خشيته مشفقون",
    "ayahnumber" : "28",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2551",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2552",
    "ayah_text" : "۞وَمَن يَقُلۡ مِنۡهُمۡ إِنِّيٓ إِلَٰهٞ مِّن دُونِهِۦ فَذَٰلِكَ نَجۡزِيهِ جَهَنَّمَۚ كَذَٰلِكَ نَجۡزِي ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "ومن يقل منهم اني الٰه من دونه فذٰلك نجزيه جهنم كذٰلك نجزي الظٰلمين",
    "ayahnumber" : "29",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2552",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2553",
    "ayah_text" : "أَوَلَمۡ يَرَ ٱلَّذِينَ كَفَرُوٓاْ أَنَّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ كَانَتَا رَتۡقٗا فَفَتَقۡنَٰهُمَاۖ وَجَعَلۡنَا مِنَ ٱلۡمَآءِ كُلَّ شَيۡءٍ حَيٍّۚ أَفَلَا يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "اولم ير الذين كفروا ان السمٰوٰت والارض كانتا رتقا ففتقنٰهما وجعلنا من الماء كل شيء حي افلا يؤمنون",
    "ayahnumber" : "30",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2553",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2554",
    "ayah_text" : "وَجَعَلۡنَا فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِهِمۡ وَجَعَلۡنَا فِيهَا فِجَاجٗا سُبُلٗا لَّعَلَّهُمۡ يَهۡتَدُونَ",
    "ayah_text_no_diacratic" : "وجعلنا في الارض روٰسي ان تميد بهم وجعلنا فيها فجاجا سبلا لعلهم يهتدون",
    "ayahnumber" : "31",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2554",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2555",
    "ayah_text" : "وَجَعَلۡنَا ٱلسَّمَآءَ سَقۡفٗا مَّحۡفُوظٗاۖ وَهُمۡ عَنۡ ءَايَٰتِهَا مُعۡرِضُونَ",
    "ayah_text_no_diacratic" : "وجعلنا السماء سقفا محفوظا وهم عن ءايٰتها معرضون",
    "ayahnumber" : "32",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2555",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2556",
    "ayah_text" : "وَهُوَ ٱلَّذِي خَلَقَ ٱلَّيۡلَ وَٱلنَّهَارَ وَٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ فِي فَلَكٖ يَسۡبَحُونَ",
    "ayah_text_no_diacratic" : "وهو الذي خلق اليل والنهار والشمس والقمر كل في فلك يسبحون",
    "ayahnumber" : "33",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2556",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2557",
    "ayah_text" : "وَمَا جَعَلۡنَا لِبَشَرٖ مِّن قَبۡلِكَ ٱلۡخُلۡدَۖ أَفَإِيْن مِّتَّ فَهُمُ ٱلۡخَٰلِدُونَ",
    "ayah_text_no_diacratic" : "وما جعلنا لبشر من قبلك الخلد افاين مت فهم الخٰلدون",
    "ayahnumber" : "34",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2557",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2558",
    "ayah_text" : "كُلُّ نَفۡسٖ ذَآئِقَةُ ٱلۡمَوۡتِۗ وَنَبۡلُوكُم بِٱلشَّرِّ وَٱلۡخَيۡرِ فِتۡنَةٗۖ وَإِلَيۡنَا تُرۡجَعُونَ",
    "ayah_text_no_diacratic" : "كل نفس ذائقة الموت ونبلوكم بالشر والخير فتنة والينا ترجعون",
    "ayahnumber" : "35",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2558",
    "page" : "324",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2559",
    "ayah_text" : "وَإِذَا رَءَاكَ ٱلَّذِينَ كَفَرُوٓاْ إِن يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا ٱلَّذِي يَذۡكُرُ ءَالِهَتَكُمۡ وَهُم بِذِكۡرِ ٱلرَّحۡمَٰنِ هُمۡ كَٰفِرُونَ",
    "ayah_text_no_diacratic" : "واذا رءاك الذين كفروا ان يتخذونك الا هزوا اهٰذا الذي يذكر ءالهتكم وهم بذكر الرحمٰن هم كٰفرون",
    "ayahnumber" : "36",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2559",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:256",
    "ayah_text" : "أَلَمۡ تَرَ إِلَى ٱلۡمَلَإِ مِنۢ بَنِيٓ إِسۡرَٰٓءِيلَ مِنۢ بَعۡدِ مُوسَىٰٓ إِذۡ قَالُواْ لِنَبِيّٖ لَّهُمُ ٱبۡعَثۡ لَنَا مَلِكٗا نُّقَٰتِلۡ فِي سَبِيلِ ٱللَّهِۖ قَالَ هَلۡ عَسَيۡتُمۡ إِن كُتِبَ عَلَيۡكُمُ ٱلۡقِتَالُ أَلَّا تُقَٰتِلُواْۖ قَالُواْ وَمَا لَنَآ أَلَّا نُقَٰتِلَ فِي سَبِيلِ ٱللَّهِ وَقَدۡ أُخۡرِجۡنَا مِن دِيَٰرِنَا وَأَبۡنَآئِنَاۖ فَلَمَّا كُتِبَ عَلَيۡهِمُ ٱلۡقِتَالُ تَوَلَّوۡاْ إِلَّا قَلِيلٗا مِّنۡهُمۡۚ وَٱللَّهُ عَلِيمُۢ بِٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "الم تر الى الملا من بني اسرٰءيل من بعد موسىٰ اذ قالوا لنبي لهم ابعث لنا ملكا نقٰتل في سبيل الله قال هل عسيتم ان كتب عليكم القتال الا تقٰتلوا قالوا وما لنا الا نقٰتل في سبيل الله وقد اخرجنا من ديٰرنا وابنائنا فلما كتب عليهم القتال تولوا الا قليلا منهم والله عليم بالظٰلمين",
    "ayahnumber" : "246",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "256",
    "page" : "40",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2560",
    "ayah_text" : "خُلِقَ ٱلۡإِنسَٰنُ مِنۡ عَجَلٖۚ سَأُوْرِيكُمۡ ءَايَٰتِي فَلَا تَسۡتَعۡجِلُونِ",
    "ayah_text_no_diacratic" : "خلق الانسٰن من عجل ساوريكم ءايٰتي فلا تستعجلون",
    "ayahnumber" : "37",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2560",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2561",
    "ayah_text" : "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ",
    "ayah_text_no_diacratic" : "ويقولون متىٰ هٰذا الوعد ان كنتم صٰدقين",
    "ayahnumber" : "38",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2561",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2562",
    "ayah_text" : "لَوۡ يَعۡلَمُ ٱلَّذِينَ كَفَرُواْ حِينَ لَا يَكُفُّونَ عَن وُجُوهِهِمُ ٱلنَّارَ وَلَا عَن ظُهُورِهِمۡ وَلَا هُمۡ يُنصَرُونَ",
    "ayah_text_no_diacratic" : "لو يعلم الذين كفروا حين لا يكفون عن وجوههم النار ولا عن ظهورهم ولا هم ينصرون",
    "ayahnumber" : "39",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2562",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2563",
    "ayah_text" : "بَلۡ تَأۡتِيهِم بَغۡتَةٗ فَتَبۡهَتُهُمۡ فَلَا يَسۡتَطِيعُونَ رَدَّهَا وَلَا هُمۡ يُنظَرُونَ",
    "ayah_text_no_diacratic" : "بل تاتيهم بغتة فتبهتهم فلا يستطيعون ردها ولا هم ينظرون",
    "ayahnumber" : "40",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2563",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2564",
    "ayah_text" : "وَلَقَدِ ٱسۡتُهۡزِئَ بِرُسُلٖ مِّن قَبۡلِكَ فَحَاقَ بِٱلَّذِينَ سَخِرُواْ مِنۡهُم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ",
    "ayah_text_no_diacratic" : "ولقد استهزئ برسل من قبلك فحاق بالذين سخروا منهم ما كانوا به يستهزءون",
    "ayahnumber" : "41",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2564",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2565",
    "ayah_text" : "قُلۡ مَن يَكۡلَؤُكُم بِٱلَّيۡلِ وَٱلنَّهَارِ مِنَ ٱلرَّحۡمَٰنِۚ بَلۡ هُمۡ عَن ذِكۡرِ رَبِّهِم مُّعۡرِضُونَ",
    "ayah_text_no_diacratic" : "قل من يكلؤكم باليل والنهار من الرحمٰن بل هم عن ذكر ربهم معرضون",
    "ayahnumber" : "42",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2565",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2566",
    "ayah_text" : "أَمۡ لَهُمۡ ءَالِهَةٞ تَمۡنَعُهُم مِّن دُونِنَاۚ لَا يَسۡتَطِيعُونَ نَصۡرَ أَنفُسِهِمۡ وَلَا هُم مِّنَّا يُصۡحَبُونَ",
    "ayah_text_no_diacratic" : "ام لهم ءالهة تمنعهم من دوننا لا يستطيعون نصر انفسهم ولا هم منا يصحبون",
    "ayahnumber" : "43",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2566",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2567",
    "ayah_text" : "بَلۡ مَتَّعۡنَا هَٰٓؤُلَآءِ وَءَابَآءَهُمۡ حَتَّىٰ طَالَ عَلَيۡهِمُ ٱلۡعُمُرُۗ أَفَلَا يَرَوۡنَ أَنَّا نَأۡتِي ٱلۡأَرۡضَ نَنقُصُهَا مِنۡ أَطۡرَافِهَآۚ أَفَهُمُ ٱلۡغَٰلِبُونَ",
    "ayah_text_no_diacratic" : "بل متعنا هٰؤلاء وءاباءهم حتىٰ طال عليهم العمر افلا يرون انا ناتي الارض ننقصها من اطرافها افهم الغٰلبون",
    "ayahnumber" : "44",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2567",
    "page" : "325",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2568",
    "ayah_text" : "قُلۡ إِنَّمَآ أُنذِرُكُم بِٱلۡوَحۡيِۚ وَلَا يَسۡمَعُ ٱلصُّمُّ ٱلدُّعَآءَ إِذَا مَا يُنذَرُونَ",
    "ayah_text_no_diacratic" : "قل انما انذركم بالوحي ولا يسمع الصم الدعاء اذا ما ينذرون",
    "ayahnumber" : "45",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2568",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2569",
    "ayah_text" : "وَلَئِن مَّسَّتۡهُمۡ نَفۡحَةٞ مِّنۡ عَذَابِ رَبِّكَ لَيَقُولُنَّ يَٰوَيۡلَنَآ إِنَّا كُنَّا ظَٰلِمِينَ",
    "ayah_text_no_diacratic" : "ولئن مستهم نفحة من عذاب ربك ليقولن يٰويلنا انا كنا ظٰلمين",
    "ayahnumber" : "46",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2569",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:257",
    "ayah_text" : "وَقَالَ لَهُمۡ نَبِيُّهُمۡ إِنَّ ٱللَّهَ قَدۡ بَعَثَ لَكُمۡ طَالُوتَ مَلِكٗاۚ قَالُوٓاْ أَنَّىٰ يَكُونُ لَهُ ٱلۡمُلۡكُ عَلَيۡنَا وَنَحۡنُ أَحَقُّ بِٱلۡمُلۡكِ مِنۡهُ وَلَمۡ يُؤۡتَ سَعَةٗ مِّنَ ٱلۡمَالِۚ قَالَ إِنَّ ٱللَّهَ ٱصۡطَفَىٰهُ عَلَيۡكُمۡ وَزَادَهُۥ بَسۡطَةٗ فِي ٱلۡعِلۡمِ وَٱلۡجِسۡمِۖ وَٱللَّهُ يُؤۡتِي مُلۡكَهُۥ مَن يَشَآءُۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "وقال لهم نبيهم ان الله قد بعث لكم طالوت ملكا قالوا انىٰ يكون له الملك علينا ونحن احق بالملك منه ولم يؤت سعة من المال قال ان الله اصطفىٰه عليكم وزاده بسطة في العلم والجسم والله يؤتي ملكه من يشاء والله وٰسع عليم",
    "ayahnumber" : "247",
    "chapter" : "2",
    "hizb" : "4",
    "index" : "257",
    "page" : "40",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:2570",
    "ayah_text" : "وَنَضَعُ ٱلۡمَوَٰزِينَ ٱلۡقِسۡطَ لِيَوۡمِ ٱلۡقِيَٰمَةِ فَلَا تُظۡلَمُ نَفۡسٞ شَيۡـٔٗاۖ وَإِن كَانَ مِثۡقَالَ حَبَّةٖ مِّنۡ خَرۡدَلٍ أَتَيۡنَا بِهَاۗ وَكَفَىٰ بِنَا حَٰسِبِينَ",
    "ayah_text_no_diacratic" : "ونضع الموٰزين القسط ليوم القيٰمة فلا تظلم نفس شيا وان كان مثقال حبة من خردل اتينا بها وكفىٰ بنا حٰسبين",
    "ayahnumber" : "47",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2570",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2571",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَا مُوسَىٰ وَهَٰرُونَ ٱلۡفُرۡقَانَ وَضِيَآءٗ وَذِكۡرٗا لِّلۡمُتَّقِينَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا موسىٰ وهٰرون الفرقان وضياء وذكرا للمتقين",
    "ayahnumber" : "48",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2571",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2572",
    "ayah_text" : "ٱلَّذِينَ يَخۡشَوۡنَ رَبَّهُم بِٱلۡغَيۡبِ وَهُم مِّنَ ٱلسَّاعَةِ مُشۡفِقُونَ",
    "ayah_text_no_diacratic" : "الذين يخشون ربهم بالغيب وهم من الساعة مشفقون",
    "ayahnumber" : "49",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2572",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2573",
    "ayah_text" : "وَهَٰذَا ذِكۡرٞ مُّبَارَكٌ أَنزَلۡنَٰهُۚ أَفَأَنتُمۡ لَهُۥ مُنكِرُونَ",
    "ayah_text_no_diacratic" : "وهٰذا ذكر مبارك انزلنٰه افانتم له منكرون",
    "ayahnumber" : "50",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2573",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2574",
    "ayah_text" : "۞وَلَقَدۡ ءَاتَيۡنَآ إِبۡرَٰهِيمَ رُشۡدَهُۥ مِن قَبۡلُ وَكُنَّا بِهِۦ عَٰلِمِينَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينا ابرٰهيم رشده من قبل وكنا به عٰلمين",
    "ayahnumber" : "51",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2574",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2575",
    "ayah_text" : "إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَا هَٰذِهِ ٱلتَّمَاثِيلُ ٱلَّتِيٓ أَنتُمۡ لَهَا عَٰكِفُونَ",
    "ayah_text_no_diacratic" : "اذ قال لابيه وقومه ما هٰذه التماثيل التي انتم لها عٰكفون",
    "ayahnumber" : "52",
    "chapter" : "17",
    "hizb" : "32",
    "index" : "2575",
    "page" : "326",
    "surahname" : "سُورَةُ الأَنبِيَاءِ",
    "surahnumber" : "21",
    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2576",
    "ayah_text" : "قَالُواْ وَجَدۡنَآ ءَابَآءَنَا لَهَا عَٰبِدِينَ",
    "ayah_text_no_diacratic" : "قالوا وجدنا ءاباءنا لها عٰبدين",
    "ayahnumber" : "53",
    "chapter" : "17",
    "hizb" : "32",
