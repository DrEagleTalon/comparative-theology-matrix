    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3169",
    "ayah_text" : "فَأَسۡقِطۡ عَلَيۡنَا كِسَفٗا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ",
    "ayah_text_no_diacratic" : "فاسقط علينا كسفا من السماء ان كنت من الصٰدقين",
    "ayahnumber" : "187",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3169",
    "page" : "375",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:317",
    "ayah_text" : "إِنَّ ٱلدِّينَ عِندَ ٱللَّهِ ٱلۡإِسۡلَٰمُۗ وَمَا ٱخۡتَلَفَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ إِلَّا مِنۢ بَعۡدِ مَا جَآءَهُمُ ٱلۡعِلۡمُ بَغۡيَۢا بَيۡنَهُمۡۗ وَمَن يَكۡفُرۡ بِـَٔايَٰتِ ٱللَّهِ فَإِنَّ ٱللَّهَ سَرِيعُ ٱلۡحِسَابِ",
    "ayah_text_no_diacratic" : "ان الدين عند الله الاسلٰم وما اختلف الذين اوتوا الكتٰب الا من بعد ما جاءهم العلم بغيا بينهم ومن يكفر بايٰت الله فان الله سريع الحساب",
    "ayahnumber" : "19",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "317",
    "page" : "52",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
