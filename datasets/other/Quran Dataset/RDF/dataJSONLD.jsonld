    "surahname" : "سُورَةُ طه",
    "surahnumber" : "20",
    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2393",
    "ayah_text" : "وَإِن تَجۡهَرۡ بِٱلۡقَوۡلِ فَإِنَّهُۥ يَعۡلَمُ ٱلسِّرَّ وَأَخۡفَى",
    "ayah_text_no_diacratic" : "وان تجهر بالقول فانه يعلم السر واخفى",
    "ayahnumber" : "7",
