    "page" : "492",
    "surahname" : "سُورَةُ الزُّخۡرُفِ",
    "surahnumber" : "43",
    "surrahname_no_diacratic" : "سورة الزخرف"
  }, {
    "@id" : "quran:4446",
    "ayah_text" : "وَإِنَّهُمۡ لَيَصُدُّونَهُمۡ عَنِ ٱلسَّبِيلِ وَيَحۡسَبُونَ أَنَّهُم مُّهۡتَدُونَ",
    "ayah_text_no_diacratic" : "وانهم ليصدونهم عن السبيل ويحسبون انهم مهتدون",
    "ayahnumber" : "37",
    "chapter" : "25",
    "hizb" : "49",
    "index" : "4446",
