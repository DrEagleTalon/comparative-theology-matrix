    "surahname" : "سُورَةُ مَرۡيَمَ",
    "surahnumber" : "19",
    "surrahname_no_diacratic" : "سورة مريم"
  }, {
    "@id" : "quran:2297",
    "ayah_text" : "فَخَرَجَ عَلَىٰ قَوۡمِهِۦ مِنَ ٱلۡمِحۡرَابِ فَأَوۡحَىٰٓ إِلَيۡهِمۡ أَن سَبِّحُواْ بُكۡرَةٗ وَعَشِيّٗا",
    "ayah_text_no_diacratic" : "فخرج علىٰ قومه من المحراب فاوحىٰ اليهم ان سبحوا بكرة وعشيا",
    "ayahnumber" : "11",
