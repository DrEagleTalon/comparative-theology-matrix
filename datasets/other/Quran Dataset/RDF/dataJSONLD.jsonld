    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:498",
    "ayah_text" : "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱصۡبِرُواْ وَصَابِرُواْ وَرَابِطُواْ وَٱتَّقُواْ ٱللَّهَ لَعَلَّكُمۡ تُفۡلِحُونَ",
    "ayah_text_no_diacratic" : "يٰايها الذين ءامنوا اصبروا وصابروا ورابطوا واتقوا الله لعلكم تفلحون",
    "ayahnumber" : "200",
    "chapter" : "4",
    "hizb" : "7",
