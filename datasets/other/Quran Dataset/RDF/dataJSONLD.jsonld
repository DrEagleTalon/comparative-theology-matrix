    "surrahname_no_diacratic" : "سورة المعارج"
  }, {
    "@id" : "quran:5524",
    "ayah_text" : "يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ",
    "ayah_text_no_diacratic" : "يبصرونهم يود المجرم لو يفتدي من عذاب يومئذ ببنيه",
