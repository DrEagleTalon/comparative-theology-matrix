  }, {
    "@id" : "quran:1013",
    "ayah_text" : "وَبَيۡنَهُمَا حِجَابٞۚ وَعَلَى ٱلۡأَعۡرَافِ رِجَالٞ يَعۡرِفُونَ كُلَّۢا بِسِيمَىٰهُمۡۚ وَنَادَوۡاْ أَصۡحَٰبَ ٱلۡجَنَّةِ أَن سَلَٰمٌ عَلَيۡكُمۡۚ لَمۡ يَدۡخُلُوهَا وَهُمۡ يَطۡمَعُونَ",
    "ayah_text_no_diacratic" : "وبينهما حجاب وعلى الاعراف رجال يعرفون كلا بسيمىٰهم ونادوا اصحٰب الجنة ان سلٰم عليكم لم يدخلوها وهم يطمعون",
    "ayahnumber" : "46",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1013",
    "page" : "156",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1014",
    "ayah_text" : "۞وَإِذَا صُرِفَتۡ أَبۡصَٰرُهُمۡ تِلۡقَآءَ أَصۡحَٰبِ ٱلنَّارِ قَالُواْ رَبَّنَا لَا تَجۡعَلۡنَا مَعَ ٱلۡقَوۡمِ ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "واذا صرفت ابصٰرهم تلقاء اصحٰب النار قالوا ربنا لا تجعلنا مع القوم الظٰلمين",
    "ayahnumber" : "47",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1014",
    "page" : "156",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1015",
    "ayah_text" : "وَنَادَىٰٓ أَصۡحَٰبُ ٱلۡأَعۡرَافِ رِجَالٗا يَعۡرِفُونَهُم بِسِيمَىٰهُمۡ قَالُواْ مَآ أَغۡنَىٰ عَنكُمۡ جَمۡعُكُمۡ وَمَا كُنتُمۡ تَسۡتَكۡبِرُونَ",
    "ayah_text_no_diacratic" : "ونادىٰ اصحٰب الاعراف رجالا يعرفونهم بسيمىٰهم قالوا ما اغنىٰ عنكم جمعكم وما كنتم تستكبرون",
    "ayahnumber" : "48",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1015",
    "page" : "156",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1016",
    "ayah_text" : "أَهَٰٓؤُلَآءِ ٱلَّذِينَ أَقۡسَمۡتُمۡ لَا يَنَالُهُمُ ٱللَّهُ بِرَحۡمَةٍۚ ٱدۡخُلُواْ ٱلۡجَنَّةَ لَا خَوۡفٌ عَلَيۡكُمۡ وَلَآ أَنتُمۡ تَحۡزَنُونَ",
    "ayah_text_no_diacratic" : "اهٰؤلاء الذين اقسمتم لا ينالهم الله برحمة ادخلوا الجنة لا خوف عليكم ولا انتم تحزنون",
    "ayahnumber" : "49",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1016",
    "page" : "156",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1017",
    "ayah_text" : "وَنَادَىٰٓ أَصۡحَٰبُ ٱلنَّارِ أَصۡحَٰبَ ٱلۡجَنَّةِ أَنۡ أَفِيضُواْ عَلَيۡنَا مِنَ ٱلۡمَآءِ أَوۡ مِمَّا رَزَقَكُمُ ٱللَّهُۚ قَالُوٓاْ إِنَّ ٱللَّهَ حَرَّمَهُمَا عَلَى ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "ونادىٰ اصحٰب النار اصحٰب الجنة ان افيضوا علينا من الماء او مما رزقكم الله قالوا ان الله حرمهما على الكٰفرين",
    "ayahnumber" : "50",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1017",
    "page" : "156",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1018",
    "ayah_text" : "ٱلَّذِينَ ٱتَّخَذُواْ دِينَهُمۡ لَهۡوٗا وَلَعِبٗا وَغَرَّتۡهُمُ ٱلۡحَيَوٰةُ ٱلدُّنۡيَاۚ فَٱلۡيَوۡمَ نَنسَىٰهُمۡ كَمَا نَسُواْ لِقَآءَ يَوۡمِهِمۡ هَٰذَا وَمَا كَانُواْ بِـَٔايَٰتِنَا يَجۡحَدُونَ",
    "ayah_text_no_diacratic" : "الذين اتخذوا دينهم لهوا ولعبا وغرتهم الحيوٰة الدنيا فاليوم ننسىٰهم كما نسوا لقاء يومهم هٰذا وما كانوا بايٰتنا يجحدون",
    "ayahnumber" : "51",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1018",
    "page" : "156",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1019",
    "ayah_text" : "وَلَقَدۡ جِئۡنَٰهُم بِكِتَٰبٖ فَصَّلۡنَٰهُ عَلَىٰ عِلۡمٍ هُدٗى وَرَحۡمَةٗ لِّقَوۡمٖ يُؤۡمِنُونَ",
    "ayah_text_no_diacratic" : "ولقد جئنٰهم بكتٰب فصلنٰه علىٰ علم هدى ورحمة لقوم يؤمنون",
    "ayahnumber" : "52",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1019",
    "page" : "157",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:102",
    "ayah_text" : "۞وَلَقَدۡ جَآءَكُم مُّوسَىٰ بِٱلۡبَيِّنَٰتِ ثُمَّ ٱتَّخَذۡتُمُ ٱلۡعِجۡلَ مِنۢ بَعۡدِهِۦ وَأَنتُمۡ ظَٰلِمُونَ",
    "ayah_text_no_diacratic" : "ولقد جاءكم موسىٰ بالبينٰت ثم اتخذتم العجل من بعده وانتم ظٰلمون",
    "ayahnumber" : "92",
    "chapter" : "1",
    "hizb" : "1",
    "index" : "102",
    "page" : "14",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1020",
    "ayah_text" : "هَلۡ يَنظُرُونَ إِلَّا تَأۡوِيلَهُۥۚ يَوۡمَ يَأۡتِي تَأۡوِيلُهُۥ يَقُولُ ٱلَّذِينَ نَسُوهُ مِن قَبۡلُ قَدۡ جَآءَتۡ رُسُلُ رَبِّنَا بِٱلۡحَقِّ فَهَل لَّنَا مِن شُفَعَآءَ فَيَشۡفَعُواْ لَنَآ أَوۡ نُرَدُّ فَنَعۡمَلَ غَيۡرَ ٱلَّذِي كُنَّا نَعۡمَلُۚ قَدۡ خَسِرُوٓاْ أَنفُسَهُمۡ وَضَلَّ عَنۡهُم مَّا كَانُواْ يَفۡتَرُونَ",
    "ayah_text_no_diacratic" : "هل ينظرون الا تاويله يوم ياتي تاويله يقول الذين نسوه من قبل قد جاءت رسل ربنا بالحق فهل لنا من شفعاء فيشفعوا لنا او نرد فنعمل غير الذي كنا نعمل قد خسروا انفسهم وضل عنهم ما كانوا يفترون",
    "ayahnumber" : "53",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1020",
    "page" : "157",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1021",
    "ayah_text" : "إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ يُغۡشِي ٱلَّيۡلَ ٱلنَّهَارَ يَطۡلُبُهُۥ حَثِيثٗا وَٱلشَّمۡسَ وَٱلۡقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتِۭ بِأَمۡرِهِۦٓۗ أَلَا لَهُ ٱلۡخَلۡقُ وَٱلۡأَمۡرُۗ تَبَارَكَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "ان ربكم الله الذي خلق السمٰوٰت والارض في ستة ايام ثم استوىٰ على العرش يغشي اليل النهار يطلبه حثيثا والشمس والقمر والنجوم مسخرٰت بامره الا له الخلق والامر تبارك الله رب العٰلمين",
    "ayahnumber" : "54",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1021",
    "page" : "157",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1022",
    "ayah_text" : "ٱدۡعُواْ رَبَّكُمۡ تَضَرُّعٗا وَخُفۡيَةًۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡمُعۡتَدِينَ",
    "ayah_text_no_diacratic" : "ادعوا ربكم تضرعا وخفية انه لا يحب المعتدين",
    "ayahnumber" : "55",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1022",
    "page" : "157",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1023",
    "ayah_text" : "وَلَا تُفۡسِدُواْ فِي ٱلۡأَرۡضِ بَعۡدَ إِصۡلَٰحِهَا وَٱدۡعُوهُ خَوۡفٗا وَطَمَعًاۚ إِنَّ رَحۡمَتَ ٱللَّهِ قَرِيبٞ مِّنَ ٱلۡمُحۡسِنِينَ",
    "ayah_text_no_diacratic" : "ولا تفسدوا في الارض بعد اصلٰحها وادعوه خوفا وطمعا ان رحمت الله قريب من المحسنين",
    "ayahnumber" : "56",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1023",
    "page" : "157",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1024",
    "ayah_text" : "وَهُوَ ٱلَّذِي يُرۡسِلُ ٱلرِّيَٰحَ بُشۡرَۢا بَيۡنَ يَدَيۡ رَحۡمَتِهِۦۖ حَتَّىٰٓ إِذَآ أَقَلَّتۡ سَحَابٗا ثِقَالٗا سُقۡنَٰهُ لِبَلَدٖ مَّيِّتٖ فَأَنزَلۡنَا بِهِ ٱلۡمَآءَ فَأَخۡرَجۡنَا بِهِۦ مِن كُلِّ ٱلثَّمَرَٰتِۚ كَذَٰلِكَ نُخۡرِجُ ٱلۡمَوۡتَىٰ لَعَلَّكُمۡ تَذَكَّرُونَ",
    "ayah_text_no_diacratic" : "وهو الذي يرسل الريٰح بشرا بين يدي رحمته حتىٰ اذا اقلت سحابا ثقالا سقنٰه لبلد ميت فانزلنا به الماء فاخرجنا به من كل الثمرٰت كذٰلك نخرج الموتىٰ لعلكم تذكرون",
    "ayahnumber" : "57",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1024",
    "page" : "157",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1025",
    "ayah_text" : "وَٱلۡبَلَدُ ٱلطَّيِّبُ يَخۡرُجُ نَبَاتُهُۥ بِإِذۡنِ رَبِّهِۦۖ وَٱلَّذِي خَبُثَ لَا يَخۡرُجُ إِلَّا نَكِدٗاۚ كَذَٰلِكَ نُصَرِّفُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَشۡكُرُونَ",
    "ayah_text_no_diacratic" : "والبلد الطيب يخرج نباته باذن ربه والذي خبث لا يخرج الا نكدا كذٰلك نصرف الايٰت لقوم يشكرون",
    "ayahnumber" : "58",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1025",
    "page" : "158",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1026",
    "ayah_text" : "لَقَدۡ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦ فَقَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓ إِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ عَظِيمٖ",
    "ayah_text_no_diacratic" : "لقد ارسلنا نوحا الىٰ قومه فقال يٰقوم اعبدوا الله ما لكم من الٰه غيره اني اخاف عليكم عذاب يوم عظيم",
    "ayahnumber" : "59",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1026",
    "page" : "158",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1027",
    "ayah_text" : "قَالَ ٱلۡمَلَأُ مِن قَوۡمِهِۦٓ إِنَّا لَنَرَىٰكَ فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "قال الملا من قومه انا لنرىٰك في ضلٰل مبين",
    "ayahnumber" : "60",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1027",
    "page" : "158",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1028",
    "ayah_text" : "قَالَ يَٰقَوۡمِ لَيۡسَ بِي ضَلَٰلَةٞ وَلَٰكِنِّي رَسُولٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "قال يٰقوم ليس بي ضلٰلة ولٰكني رسول من رب العٰلمين",
    "ayahnumber" : "61",
    "chapter" : "8",
    "hizb" : "15",
    "index" : "1028",
    "page" : "158",
    "surahname" : "سُورَةُ الأَعۡرَافِ",
    "surahnumber" : "7",
    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1029",
    "ayah_text" : "أُبَلِّغُكُمۡ رِسَٰلَٰتِ رَبِّي وَأَنصَحُ لَكُمۡ وَأَعۡلَمُ مِنَ ٱللَّهِ مَا لَا تَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "ابلغكم رسٰلٰت ربي وانصح لكم واعلم من الله ما لا تعلمون",
    "ayahnumber" : "62",
