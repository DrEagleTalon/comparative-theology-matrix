    "surrahname_no_diacratic" : "سورة طه"
  }, {
    "@id" : "quran:2391",
    "ayah_text" : "ٱلرَّحۡمَٰنُ عَلَى ٱلۡعَرۡشِ ٱسۡتَوَىٰ",
    "ayah_text_no_diacratic" : "الرحمٰن على العرش استوىٰ",
    "ayahnumber" : "5",
    "chapter" : "16",
