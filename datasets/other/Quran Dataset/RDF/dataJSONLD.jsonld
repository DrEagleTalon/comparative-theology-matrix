    "surahnumber" : "23",
    "surrahname_no_diacratic" : "سورة المؤمنون"
  }, {
    "@id" : "quran:2812",
    "ayah_text" : "وَإِنَّا عَلَىٰٓ أَن نُّرِيَكَ مَا نَعِدُهُمۡ لَقَٰدِرُونَ",
    "ayah_text_no_diacratic" : "وانا علىٰ ان نريك ما نعدهم لقٰدرون",
    "ayahnumber" : "95",
    "chapter" : "18",
    "hizb" : "34",
