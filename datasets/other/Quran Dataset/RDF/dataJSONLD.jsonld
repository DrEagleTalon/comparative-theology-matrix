    "surahnumber" : "25",
    "surrahname_no_diacratic" : "سورة الفرقان"
  }, {
    "@id" : "quran:2966",
    "ayah_text" : "وَعِبَادُ ٱلرَّحۡمَٰنِ ٱلَّذِينَ يَمۡشُونَ عَلَى ٱلۡأَرۡضِ هَوۡنٗا وَإِذَا خَاطَبَهُمُ ٱلۡجَٰهِلُونَ قَالُواْ سَلَٰمٗا",
    "ayah_text_no_diacratic" : "وعباد الرحمٰن الذين يمشون على الارض هونا واذا خاطبهم الجٰهلون قالوا سلٰما",
