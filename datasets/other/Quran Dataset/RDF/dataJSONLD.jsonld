  }, {
    "@id" : "quran:4980",
    "ayah_text" : "وَنَبِّئۡهُمۡ أَنَّ ٱلۡمَآءَ قِسۡمَةُۢ بَيۡنَهُمۡۖ كُلُّ شِرۡبٖ مُّحۡتَضَرٞ",
    "ayah_text_no_diacratic" : "ونبئهم ان الماء قسمة بينهم كل شرب محتضر",
