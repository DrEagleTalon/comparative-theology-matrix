    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:489",
    "ayah_text" : "ٱلَّذِينَ يَذۡكُرُونَ ٱللَّهَ قِيَٰمٗا وَقُعُودٗا وَعَلَىٰ جُنُوبِهِمۡ وَيَتَفَكَّرُونَ فِي خَلۡقِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ رَبَّنَا مَا خَلَقۡتَ هَٰذَا بَٰطِلٗا سُبۡحَٰنَكَ فَقِنَا عَذَابَ ٱلنَّارِ",
    "ayah_text_no_diacratic" : "الذين يذكرون الله قيٰما وقعودا وعلىٰ جنوبهم ويتفكرون في خلق السمٰوٰت والارض ربنا ما خلقت هٰذا بٰطلا سبحٰنك فقنا عذاب النار",
    "ayahnumber" : "191",
    "chapter" : "4",
    "hizb" : "7",
    "index" : "489",
    "page" : "75",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
