    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5636",
    "ayah_text" : "فَكَيۡفَ تَتَّقُونَ إِن كَفَرۡتُمۡ يَوۡمٗا يَجۡعَلُ ٱلۡوِلۡدَٰنَ شِيبًا",
    "ayah_text_no_diacratic" : "فكيف تتقون ان كفرتم يوما يجعل الولدٰن شيبا",
    "ayahnumber" : "17",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5636",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5637",
    "ayah_text" : "ٱلسَّمَآءُ مُنفَطِرُۢ بِهِۦۚ كَانَ وَعۡدُهُۥ مَفۡعُولًا",
    "ayah_text_no_diacratic" : "السماء منفطر به كان وعده مفعولا",
    "ayahnumber" : "18",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5637",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5638",
    "ayah_text" : "إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا",
    "ayah_text_no_diacratic" : "ان هٰذه تذكرة فمن شاء اتخذ الىٰ ربه سبيلا",
    "ayahnumber" : "19",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5638",
    "page" : "574",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:5639",
    "ayah_text" : "۞إِنَّ رَبَّكَ يَعۡلَمُ أَنَّكَ تَقُومُ أَدۡنَىٰ مِن ثُلُثَيِ ٱلَّيۡلِ وَنِصۡفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٞ مِّنَ ٱلَّذِينَ مَعَكَۚ وَٱللَّهُ يُقَدِّرُ ٱلَّيۡلَ وَٱلنَّهَارَۚ عَلِمَ أَن لَّن تُحۡصُوهُ فَتَابَ عَلَيۡكُمۡۖ فَٱقۡرَءُواْ مَا تَيَسَّرَ مِنَ ٱلۡقُرۡءَانِۚ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرۡضَىٰ وَءَاخَرُونَ يَضۡرِبُونَ فِي ٱلۡأَرۡضِ يَبۡتَغُونَ مِن فَضۡلِ ٱللَّهِ وَءَاخَرُونَ يُقَٰتِلُونَ فِي سَبِيلِ ٱللَّهِۖ فَٱقۡرَءُواْ مَا تَيَسَّرَ مِنۡهُۚ وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ وَأَقۡرِضُواْ ٱللَّهَ قَرۡضًا حَسَنٗاۚ وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنۡ خَيۡرٖ تَجِدُوهُ عِندَ ٱللَّهِ هُوَ خَيۡرٗا وَأَعۡظَمَ أَجۡرٗاۚ وَٱسۡتَغۡفِرُواْ ٱللَّهَۖ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمُۢ",
    "ayah_text_no_diacratic" : "ان ربك يعلم انك تقوم ادنىٰ من ثلثي اليل ونصفه وثلثه وطائفة من الذين معك والله يقدر اليل والنهار علم ان لن تحصوه فتاب عليكم فاقرءوا ما تيسر من القرءان علم ان سيكون منكم مرضىٰ وءاخرون يضربون في الارض يبتغون من فضل الله وءاخرون يقٰتلون في سبيل الله فاقرءوا ما تيسر منه واقيموا الصلوٰة وءاتوا الزكوٰة واقرضوا الله قرضا حسنا وما تقدموا لانفسكم من خير تجدوه عند الله هو خيرا واعظم اجرا واستغفروا الله ان الله غفور رحيم",
    "ayahnumber" : "20",
    "chapter" : "29",
    "hizb" : "57",
    "index" : "5639",
    "page" : "575",
    "surahname" : "سُورَةُ المُزَّمِّلِ",
    "surahnumber" : "73",
    "surrahname_no_diacratic" : "سورة المزمل"
  }, {
    "@id" : "quran:564",
    "ayah_text" : "وَمَآ أَرۡسَلۡنَا مِن رَّسُولٍ إِلَّا لِيُطَاعَ بِإِذۡنِ ٱللَّهِۚ وَلَوۡ أَنَّهُمۡ إِذ ظَّلَمُوٓاْ أَنفُسَهُمۡ جَآءُوكَ فَٱسۡتَغۡفَرُواْ ٱللَّهَ وَٱسۡتَغۡفَرَ لَهُمُ ٱلرَّسُولُ لَوَجَدُواْ ٱللَّهَ تَوَّابٗا رَّحِيمٗا",
    "ayah_text_no_diacratic" : "وما ارسلنا من رسول الا ليطاع باذن الله ولو انهم اذ ظلموا انفسهم جاءوك فاستغفروا الله واستغفر لهم الرسول لوجدوا الله توابا رحيما",
    "ayahnumber" : "64",
