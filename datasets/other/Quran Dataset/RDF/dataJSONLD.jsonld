  }, {
    "@id" : "quran:87",
    "ayah_text" : "أَوَلَا يَعۡلَمُونَ أَنَّ ٱللَّهَ يَعۡلَمُ مَا يُسِرُّونَ وَمَا يُعۡلِنُونَ",
    "ayah_text_no_diacratic" : "اولا يعلمون ان الله يعلم ما يسرون وما يعلنون",
