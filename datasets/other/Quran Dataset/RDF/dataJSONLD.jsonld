    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:932",
    "ayah_text" : "وَلِكُلّٖ دَرَجَٰتٞ مِّمَّا عَمِلُواْۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "ولكل درجٰت مما عملوا وما ربك بغٰفل عما يعملون",
    "ayahnumber" : "132",
    "chapter" : "8",
    "hizb" : "14",
