    "surrahname_no_diacratic" : "سورة المعارج"
  }, {
    "@id" : "quran:5556",
    "ayah_text" : "يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعٗا كَأَنَّهُمۡ إِلَىٰ نُصُبٖ يُوفِضُونَ",
    "ayah_text_no_diacratic" : "يوم يخرجون من الاجداث سراعا كانهم الىٰ نصب يوفضون",
