    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3001",
    "ayah_text" : "وَفَعَلۡتَ فَعۡلَتَكَ ٱلَّتِي فَعَلۡتَ وَأَنتَ مِنَ ٱلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "وفعلت فعلتك التي فعلت وانت من الكٰفرين",
    "ayahnumber" : "19",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3001",
    "page" : "367",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3002",
    "ayah_text" : "قَالَ فَعَلۡتُهَآ إِذٗا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ",
    "ayah_text_no_diacratic" : "قال فعلتها اذا وانا من الضالين",
    "ayahnumber" : "20",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3002",
    "page" : "368",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3003",
    "ayah_text" : "فَفَرَرۡتُ مِنكُمۡ لَمَّا خِفۡتُكُمۡ فَوَهَبَ لِي رَبِّي حُكۡمٗا وَجَعَلَنِي مِنَ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "ففررت منكم لما خفتكم فوهب لي ربي حكما وجعلني من المرسلين",
    "ayahnumber" : "21",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3003",
