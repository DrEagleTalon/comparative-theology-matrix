    "surahname" : "سُورَةُ إِبۡرَاهِيمَ",
    "surahnumber" : "14",
    "surrahname_no_diacratic" : "سورة ابراهيم"
  }, {
    "@id" : "quran:1804",
    "ayah_text" : "۞أَلَمۡ تَرَ إِلَى ٱلَّذِينَ بَدَّلُواْ نِعۡمَتَ ٱللَّهِ كُفۡرٗا وَأَحَلُّواْ قَوۡمَهُمۡ دَارَ ٱلۡبَوَارِ",
    "ayah_text_no_diacratic" : "الم تر الى الذين بدلوا نعمت الله كفرا واحلوا قومهم دار البوار",
