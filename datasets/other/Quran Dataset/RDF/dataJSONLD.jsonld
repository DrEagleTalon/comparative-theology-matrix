    "page" : "386",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3319",
    "ayah_text" : "فَرَدَدۡنَٰهُ إِلَىٰٓ أُمِّهِۦ كَيۡ تَقَرَّ عَيۡنُهَا وَلَا تَحۡزَنَ وَلِتَعۡلَمَ أَنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ",
    "ayah_text_no_diacratic" : "فرددنٰه الىٰ امه كي تقر عينها ولا تحزن ولتعلم ان وعد الله حق ولٰكن اكثرهم لا يعلمون",
    "ayahnumber" : "13",
    "chapter" : "20",
    "hizb" : "38",
