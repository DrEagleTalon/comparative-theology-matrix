    "surrahname_no_diacratic" : "سورة الاعراف"
  }, {
    "@id" : "quran:1167",
    "ayah_text" : "وَإِمَّا يَنزَغَنَّكَ مِنَ ٱلشَّيۡطَٰنِ نَزۡغٞ فَٱسۡتَعِذۡ بِٱللَّهِۚ إِنَّهُۥ سَمِيعٌ عَلِيمٌ",
    "ayah_text_no_diacratic" : "واما ينزغنك من الشيطٰن نزغ فاستعذ بالله انه سميع عليم",
