    "surahname" : "سُورَةُ القَمَرِ",
    "surahnumber" : "54",
    "surrahname_no_diacratic" : "سورة القمر"
  }, {
    "@id" : "quran:4972",
    "ayah_text" : "تَنزِعُ ٱلنَّاسَ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٖ مُّنقَعِرٖ",
    "ayah_text_no_diacratic" : "تنزع الناس كانهم اعجاز نخل منقعر",
