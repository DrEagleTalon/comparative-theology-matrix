  }, {
    "@id" : "quran:3644",
    "ayah_text" : "وَبَشِّرِ ٱلۡمُؤۡمِنِينَ بِأَنَّ لَهُم مِّنَ ٱللَّهِ فَضۡلٗا كَبِيرٗا",
    "ayah_text_no_diacratic" : "وبشر المؤمنين بان لهم من الله فضلا كبيرا",
