    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3170",
    "ayah_text" : "قَالَ رَبِّيٓ أَعۡلَمُ بِمَا تَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "قال ربي اعلم بما تعملون",
    "ayahnumber" : "188",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3170",
    "page" : "375",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3171",
    "ayah_text" : "فَكَذَّبُوهُ فَأَخَذَهُمۡ عَذَابُ يَوۡمِ ٱلظُّلَّةِۚ إِنَّهُۥ كَانَ عَذَابَ يَوۡمٍ عَظِيمٍ",
    "ayah_text_no_diacratic" : "فكذبوه فاخذهم عذاب يوم الظلة انه كان عذاب يوم عظيم",
