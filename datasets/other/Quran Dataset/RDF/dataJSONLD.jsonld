    "surrahname_no_diacratic" : "سورة الذاريات"
  }, {
    "@id" : "quran:4823",
    "ayah_text" : "وَٱلۡأَرۡضَ فَرَشۡنَٰهَا فَنِعۡمَ ٱلۡمَٰهِدُونَ",
