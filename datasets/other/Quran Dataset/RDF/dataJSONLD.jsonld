  }, {
    "@id" : "quran:7",
    "ayah_text" : "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
    "ayah_text_no_diacratic" : "اهدنا الصرٰط المستقيم",
