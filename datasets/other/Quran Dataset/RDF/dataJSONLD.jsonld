    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:864",
    "ayah_text" : "قُلِ ٱللَّهُ يُنَجِّيكُم مِّنۡهَا وَمِن كُلِّ كَرۡبٖ ثُمَّ أَنتُمۡ تُشۡرِكُونَ",
