    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3031",
    "ayah_text" : "قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِي عَلَّمَكُمُ ٱلسِّحۡرَ فَلَسَوۡفَ تَعۡلَمُونَۚ لَأُقَطِّعَنَّ أَيۡدِيَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمۡ أَجۡمَعِينَ",
    "ayah_text_no_diacratic" : "قال ءامنتم له قبل ان ءاذن لكم انه لكبيركم الذي علمكم السحر فلسوف تعلمون لاقطعن ايديكم وارجلكم من خلٰف ولاصلبنكم اجمعين",
    "ayahnumber" : "49",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3031",
    "page" : "369",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3032",
    "ayah_text" : "قَالُواْ لَا ضَيۡرَۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ",
    "ayah_text_no_diacratic" : "قالوا لا ضير انا الىٰ ربنا منقلبون",
    "ayahnumber" : "50",
    "chapter" : "19",
    "hizb" : "36",
    "index" : "3032",
    "page" : "369",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3033",
    "ayah_text" : "إِنَّا نَطۡمَعُ أَن يَغۡفِرَ لَنَا رَبُّنَا خَطَٰيَٰنَآ أَن كُنَّآ أَوَّلَ ٱلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "انا نطمع ان يغفر لنا ربنا خطٰيٰنا ان كنا اول المؤمنين",
