    "surrahname_no_diacratic" : "سورة الانبياء"
  }, {
    "@id" : "quran:2634",
    "ayah_text" : "وَإِنۡ أَدۡرِي لَعَلَّهُۥ فِتۡنَةٞ لَّكُمۡ وَمَتَٰعٌ إِلَىٰ حِينٖ",
    "ayah_text_no_diacratic" : "وان ادري لعله فتنة لكم ومتٰع الىٰ حين",
