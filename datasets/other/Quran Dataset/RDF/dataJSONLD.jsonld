    "surahname" : "سُورَةُ غَافِرٍ",
    "surahnumber" : "40",
    "surrahname_no_diacratic" : "سورة غافر"
  }, {
    "@id" : "quran:4296",
    "ayah_text" : "فَلَمۡ يَكُ يَنفَعُهُمۡ إِيمَٰنُهُمۡ لَمَّا رَأَوۡاْ بَأۡسَنَاۖ سُنَّتَ ٱللَّهِ ٱلَّتِي قَدۡ خَلَتۡ فِي عِبَادِهِۦۖ وَخَسِرَ هُنَالِكَ ٱلۡكَٰفِرُونَ",
    "ayah_text_no_diacratic" : "فلم يك ينفعهم ايمٰنهم لما راوا باسنا سنت الله التي قد خلت في عباده وخسر هنالك الكٰفرون",
    "ayahnumber" : "85",
