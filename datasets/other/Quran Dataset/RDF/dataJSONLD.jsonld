    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1906",
    "ayah_text" : "وَإِنَّهَا لَبِسَبِيلٖ مُّقِيمٍ",
    "ayah_text_no_diacratic" : "وانها لبسبيل مقيم",
    "ayahnumber" : "76",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1906",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1907",
    "ayah_text" : "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "ان في ذٰلك لاية للمؤمنين",
    "ayahnumber" : "77",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1907",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1908",
    "ayah_text" : "وَإِن كَانَ أَصۡحَٰبُ ٱلۡأَيۡكَةِ لَظَٰلِمِينَ",
    "ayah_text_no_diacratic" : "وان كان اصحٰب الايكة لظٰلمين",
    "ayahnumber" : "78",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1908",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1909",
    "ayah_text" : "فَٱنتَقَمۡنَا مِنۡهُمۡ وَإِنَّهُمَا لَبِإِمَامٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "فانتقمنا منهم وانهما لبامام مبين",
    "ayahnumber" : "79",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1909",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:191",
    "ayah_text" : "فَمَنۢ بَدَّلَهُۥ بَعۡدَ مَا سَمِعَهُۥ فَإِنَّمَآ إِثۡمُهُۥ عَلَى ٱلَّذِينَ يُبَدِّلُونَهُۥٓۚ إِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ",
    "ayah_text_no_diacratic" : "فمن بدله بعد ما سمعه فانما اثمه على الذين يبدلونه ان الله سميع عليم",
    "ayahnumber" : "181",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "191",
    "page" : "27",
    "surahname" : "سُورَةُ البَقَرَةِ",
    "surahnumber" : "2",
    "surrahname_no_diacratic" : "سورة البقرة"
  }, {
    "@id" : "quran:1910",
    "ayah_text" : "وَلَقَدۡ كَذَّبَ أَصۡحَٰبُ ٱلۡحِجۡرِ ٱلۡمُرۡسَلِينَ",
    "ayah_text_no_diacratic" : "ولقد كذب اصحٰب الحجر المرسلين",
    "ayahnumber" : "80",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1910",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1911",
    "ayah_text" : "وَءَاتَيۡنَٰهُمۡ ءَايَٰتِنَا فَكَانُواْ عَنۡهَا مُعۡرِضِينَ",
    "ayah_text_no_diacratic" : "وءاتينٰهم ءايٰتنا فكانوا عنها معرضين",
    "ayahnumber" : "81",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1911",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1912",
    "ayah_text" : "وَكَانُواْ يَنۡحِتُونَ مِنَ ٱلۡجِبَالِ بُيُوتًا ءَامِنِينَ",
    "ayah_text_no_diacratic" : "وكانوا ينحتون من الجبال بيوتا ءامنين",
    "ayahnumber" : "82",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1912",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1913",
    "ayah_text" : "فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ مُصۡبِحِينَ",
    "ayah_text_no_diacratic" : "فاخذتهم الصيحة مصبحين",
    "ayahnumber" : "83",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1913",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1914",
    "ayah_text" : "فَمَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يَكۡسِبُونَ",
    "ayah_text_no_diacratic" : "فما اغنىٰ عنهم ما كانوا يكسبون",
    "ayahnumber" : "84",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1914",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1915",
    "ayah_text" : "وَمَا خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَآ إِلَّا بِٱلۡحَقِّۗ وَإِنَّ ٱلسَّاعَةَ لَأٓتِيَةٞۖ فَٱصۡفَحِ ٱلصَّفۡحَ ٱلۡجَمِيلَ",
    "ayah_text_no_diacratic" : "وما خلقنا السمٰوٰت والارض وما بينهما الا بالحق وان الساعة لاتية فاصفح الصفح الجميل",
    "ayahnumber" : "85",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1915",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1916",
    "ayah_text" : "إِنَّ رَبَّكَ هُوَ ٱلۡخَلَّٰقُ ٱلۡعَلِيمُ",
    "ayah_text_no_diacratic" : "ان ربك هو الخلٰق العليم",
    "ayahnumber" : "86",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1916",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1917",
    "ayah_text" : "وَلَقَدۡ ءَاتَيۡنَٰكَ سَبۡعٗا مِّنَ ٱلۡمَثَانِي وَٱلۡقُرۡءَانَ ٱلۡعَظِيمَ",
    "ayah_text_no_diacratic" : "ولقد ءاتينٰك سبعا من المثاني والقرءان العظيم",
    "ayahnumber" : "87",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1917",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1918",
    "ayah_text" : "لَا تَمُدَّنَّ عَيۡنَيۡكَ إِلَىٰ مَا مَتَّعۡنَا بِهِۦٓ أَزۡوَٰجٗا مِّنۡهُمۡ وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَٱخۡفِضۡ جَنَاحَكَ لِلۡمُؤۡمِنِينَ",
    "ayah_text_no_diacratic" : "لا تمدن عينيك الىٰ ما متعنا به ازوٰجا منهم ولا تحزن عليهم واخفض جناحك للمؤمنين",
    "ayahnumber" : "88",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1918",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:1919",
    "ayah_text" : "وَقُلۡ إِنِّيٓ أَنَا ٱلنَّذِيرُ ٱلۡمُبِينُ",
    "ayah_text_no_diacratic" : "وقل اني انا النذير المبين",
    "ayahnumber" : "89",
    "chapter" : "14",
    "hizb" : "26",
    "index" : "1919",
    "page" : "266",
    "surahname" : "سُورَةُ الحِجۡرِ",
    "surahnumber" : "15",
    "surrahname_no_diacratic" : "سورة الحجر"
  }, {
    "@id" : "quran:192",
    "ayah_text" : "فَمَنۡ خَافَ مِن مُّوصٖ جَنَفًا أَوۡ إِثۡمٗا فَأَصۡلَحَ بَيۡنَهُمۡ فَلَآ إِثۡمَ عَلَيۡهِۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "فمن خاف من موص جنفا او اثما فاصلح بينهم فلا اثم عليه ان الله غفور رحيم",
    "ayahnumber" : "182",
    "chapter" : "2",
    "hizb" : "2",
    "index" : "192",
    "page" : "28",
    "surahname" : "سُورَةُ البَقَرَةِ",
