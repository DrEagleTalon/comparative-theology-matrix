    "surahnumber" : "8",
    "surrahname_no_diacratic" : "سورة الانفال"
  }, {
    "@id" : "quran:1244",
    "ayah_text" : "فَكُلُواْ مِمَّا غَنِمۡتُمۡ حَلَٰلٗا طَيِّبٗاۚ وَٱتَّقُواْ ٱللَّهَۚ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ",
    "ayah_text_no_diacratic" : "فكلوا مما غنمتم حلٰلا طيبا واتقوا الله ان الله غفور رحيم",
