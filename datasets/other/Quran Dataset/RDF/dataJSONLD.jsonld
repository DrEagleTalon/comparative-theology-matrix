    "surahnumber" : "37",
    "surrahname_no_diacratic" : "سورة الصافات"
  }, {
    "@id" : "quran:395",
    "ayah_text" : "فِيهِ ءَايَٰتُۢ بَيِّنَٰتٞ مَّقَامُ إِبۡرَٰهِيمَۖ وَمَن دَخَلَهُۥ كَانَ ءَامِنٗاۗ وَلِلَّهِ عَلَى ٱلنَّاسِ حِجُّ ٱلۡبَيۡتِ مَنِ ٱسۡتَطَاعَ إِلَيۡهِ سَبِيلٗاۚ وَمَن كَفَرَ فَإِنَّ ٱللَّهَ غَنِيٌّ عَنِ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "فيه ءايٰت بينٰت مقام ابرٰهيم ومن دخله كان ءامنا ولله على الناس حج البيت من استطاع اليه سبيلا ومن كفر فان الله غني عن العٰلمين",
    "ayahnumber" : "97",
    "chapter" : "4",
    "hizb" : "6",
    "index" : "395",
    "page" : "62",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3950",
    "ayah_text" : "فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ",
    "ayah_text_no_diacratic" : "فتولوا عنه مدبرين",
    "ayahnumber" : "90",
