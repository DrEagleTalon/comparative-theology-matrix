    "surahname" : "سُورَةُ النَّجۡمِ",
    "surahnumber" : "53",
    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4936",
    "ayah_text" : "وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنَىٰ",
