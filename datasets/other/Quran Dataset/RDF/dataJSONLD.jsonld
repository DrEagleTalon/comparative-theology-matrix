    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4357",
    "ayah_text" : "كَذَٰلِكَ يُوحِيٓ إِلَيۡكَ وَإِلَى ٱلَّذِينَ مِن قَبۡلِكَ ٱللَّهُ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "ayah_text_no_diacratic" : "كذٰلك يوحي اليك والى الذين من قبلك الله العزيز الحكيم",
    "ayahnumber" : "3",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4357",
    "page" : "483",
    "surahname" : "سُورَةُ الشُّورَىٰ",
    "surahnumber" : "42",
    "surrahname_no_diacratic" : "سورة الشورىٰ"
  }, {
    "@id" : "quran:4358",
    "ayah_text" : "لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَلِيُّ ٱلۡعَظِيمُ",
    "ayah_text_no_diacratic" : "له ما في السمٰوٰت وما في الارض وهو العلي العظيم",
    "ayahnumber" : "4",
    "chapter" : "25",
    "hizb" : "48",
    "index" : "4358",
