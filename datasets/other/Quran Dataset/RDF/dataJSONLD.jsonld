    "page" : "395",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:339",
    "ayah_text" : "قَالَ رَبِّ ٱجۡعَل لِّيٓ ءَايَةٗۖ قَالَ ءَايَتُكَ أَلَّا تُكَلِّمَ ٱلنَّاسَ ثَلَٰثَةَ أَيَّامٍ إِلَّا رَمۡزٗاۗ وَٱذۡكُر رَّبَّكَ كَثِيرٗا وَسَبِّحۡ بِٱلۡعَشِيِّ وَٱلۡإِبۡكَٰرِ",
    "ayah_text_no_diacratic" : "قال رب اجعل لي ءاية قال ءايتك الا تكلم الناس ثلٰثة ايام الا رمزا واذكر ربك كثيرا وسبح بالعشي والابكٰر",
    "ayahnumber" : "41",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "339",
    "page" : "55",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3390",
    "ayah_text" : "مَن جَآءَ بِٱلۡحَسَنَةِ فَلَهُۥ خَيۡرٞ مِّنۡهَاۖ وَمَن جَآءَ بِٱلسَّيِّئَةِ فَلَا يُجۡزَى ٱلَّذِينَ عَمِلُواْ ٱلسَّيِّـَٔاتِ إِلَّا مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "من جاء بالحسنة فله خير منها ومن جاء بالسيئة فلا يجزى الذين عملوا السيات الا ما كانوا يعملون",
    "ayahnumber" : "84",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3390",
    "page" : "395",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3391",
    "ayah_text" : "إِنَّ ٱلَّذِي فَرَضَ عَلَيۡكَ ٱلۡقُرۡءَانَ لَرَآدُّكَ إِلَىٰ مَعَادٖۚ قُل رَّبِّيٓ أَعۡلَمُ مَن جَآءَ بِٱلۡهُدَىٰ وَمَنۡ هُوَ فِي ضَلَٰلٖ مُّبِينٖ",
    "ayah_text_no_diacratic" : "ان الذي فرض عليك القرءان لرادك الىٰ معاد قل ربي اعلم من جاء بالهدىٰ ومن هو في ضلٰل مبين",
    "ayahnumber" : "85",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3391",
    "page" : "396",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3392",
    "ayah_text" : "وَمَا كُنتَ تَرۡجُوٓاْ أَن يُلۡقَىٰٓ إِلَيۡكَ ٱلۡكِتَٰبُ إِلَّا رَحۡمَةٗ مِّن رَّبِّكَۖ فَلَا تَكُونَنَّ ظَهِيرٗا لِّلۡكَٰفِرِينَ",
    "ayah_text_no_diacratic" : "وما كنت ترجوا ان يلقىٰ اليك الكتٰب الا رحمة من ربك فلا تكونن ظهيرا للكٰفرين",
    "ayahnumber" : "86",
    "chapter" : "20",
    "hizb" : "39",
    "index" : "3392",
    "page" : "396",
    "surahname" : "سُورَةُ القَصَصِ",
    "surahnumber" : "28",
    "surrahname_no_diacratic" : "سورة القصص"
  }, {
    "@id" : "quran:3393",
    "ayah_text" : "وَلَا يَصُدُّنَّكَ عَنۡ ءَايَٰتِ ٱللَّهِ بَعۡدَ إِذۡ أُنزِلَتۡ إِلَيۡكَۖ وَٱدۡعُ إِلَىٰ رَبِّكَۖ وَلَا تَكُونَنَّ مِنَ ٱلۡمُشۡرِكِينَ",
    "ayah_text_no_diacratic" : "ولا يصدنك عن ءايٰت الله بعد اذ انزلت اليك وادع الىٰ ربك ولا تكونن من المشركين",
    "ayahnumber" : "87",
