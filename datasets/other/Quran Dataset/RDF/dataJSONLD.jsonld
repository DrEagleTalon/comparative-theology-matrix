    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:955",
    "ayah_text" : "وَهَٰذَا كِتَٰبٌ أَنزَلۡنَٰهُ مُبَارَكٞ فَٱتَّبِعُوهُ وَٱتَّقُواْ لَعَلَّكُمۡ تُرۡحَمُونَ",
    "ayah_text_no_diacratic" : "وهٰذا كتٰب انزلنٰه مبارك فاتبعوه واتقوا لعلكم ترحمون",
