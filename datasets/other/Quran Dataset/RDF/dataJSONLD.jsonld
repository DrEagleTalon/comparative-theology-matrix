  }, {
    "@id" : "quran:3888",
    "ayah_text" : "قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ",
    "ayah_text_no_diacratic" : "قالوا انكم كنتم تاتوننا عن اليمين",
