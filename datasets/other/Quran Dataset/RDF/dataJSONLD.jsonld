    "page" : "440",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3783",
    "ayah_text" : "إِنَّا جَعَلۡنَا فِيٓ أَعۡنَٰقِهِمۡ أَغۡلَٰلٗا فَهِيَ إِلَى ٱلۡأَذۡقَانِ فَهُم مُّقۡمَحُونَ",
    "ayah_text_no_diacratic" : "انا جعلنا في اعنٰقهم اغلٰلا فهي الى الاذقان فهم مقمحون",
    "ayahnumber" : "8",
    "chapter" : "22",
    "hizb" : "44",
    "index" : "3783",
    "page" : "440",
    "surahname" : "سُورَةُ يسٓ",
    "surahnumber" : "36",
    "surrahname_no_diacratic" : "سورة يس"
  }, {
    "@id" : "quran:3784",
    "ayah_text" : "وَجَعَلۡنَا مِنۢ بَيۡنِ أَيۡدِيهِمۡ سَدّٗا وَمِنۡ خَلۡفِهِمۡ سَدّٗا فَأَغۡشَيۡنَٰهُمۡ فَهُمۡ لَا يُبۡصِرُونَ",
    "ayah_text_no_diacratic" : "وجعلنا من بين ايديهم سدا ومن خلفهم سدا فاغشينٰهم فهم لا يبصرون",
