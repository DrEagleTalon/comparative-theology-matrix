    "surrahname_no_diacratic" : "سورة النجم"
  }, {
    "@id" : "quran:4942",
    "ayah_text" : "فَغَشَّىٰهَا مَا غَشَّىٰ",
    "ayah_text_no_diacratic" : "فغشىٰها ما غشىٰ",
    "ayahnumber" : "54",
