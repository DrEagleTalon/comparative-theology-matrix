    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2097",
    "ayah_text" : "وَلَا تَقۡفُ مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٌۚ إِنَّ ٱلسَّمۡعَ وَٱلۡبَصَرَ وَٱلۡفُؤَادَ كُلُّ أُوْلَٰٓئِكَ كَانَ عَنۡهُ مَسۡـُٔولٗا",
    "ayah_text_no_diacratic" : "ولا تقف ما ليس لك به علم ان السمع والبصر والفؤاد كل اولٰئك كان عنه مسولا",
    "ayahnumber" : "36",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2097",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2098",
    "ayah_text" : "وَلَا تَمۡشِ فِي ٱلۡأَرۡضِ مَرَحًاۖ إِنَّكَ لَن تَخۡرِقَ ٱلۡأَرۡضَ وَلَن تَبۡلُغَ ٱلۡجِبَالَ طُولٗا",
    "ayah_text_no_diacratic" : "ولا تمش في الارض مرحا انك لن تخرق الارض ولن تبلغ الجبال طولا",
    "ayahnumber" : "37",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2098",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:2099",
    "ayah_text" : "كُلُّ ذَٰلِكَ كَانَ سَيِّئُهُۥ عِندَ رَبِّكَ مَكۡرُوهٗا",
    "ayah_text_no_diacratic" : "كل ذٰلك كان سيئه عند ربك مكروها",
    "ayahnumber" : "38",
    "chapter" : "15",
    "hizb" : "28",
    "index" : "2099",
    "page" : "285",
    "surahname" : "سُورَةُ الإِسۡرَاءِ",
    "surahnumber" : "17",
    "surrahname_no_diacratic" : "سورة الاسراء"
  }, {
    "@id" : "quran:21",
    "ayah_text" : "وَإِذَا قِيلَ لَهُمۡ لَا تُفۡسِدُواْ فِي ٱلۡأَرۡضِ قَالُوٓاْ إِنَّمَا نَحۡنُ مُصۡلِحُونَ",
    "ayah_text_no_diacratic" : "واذا قيل لهم لا تفسدوا في الارض قالوا انما نحن مصلحون",
    "ayahnumber" : "11",
    "chapter" : "1",
    "hizb" : "0",
    "index" : "21",
