  }, {
    "@id" : "quran:1790",
    "ayah_text" : "وَلَنُسۡكِنَنَّكُمُ ٱلۡأَرۡضَ مِنۢ بَعۡدِهِمۡۚ ذَٰلِكَ لِمَنۡ خَافَ مَقَامِي وَخَافَ وَعِيدِ",
    "ayah_text_no_diacratic" : "ولنسكننكم الارض من بعدهم ذٰلك لمن خاف مقامي وخاف وعيد",
