    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3007",
    "ayah_text" : "قَالَ لِمَنۡ حَوۡلَهُۥٓ أَلَا تَسۡتَمِعُونَ",
    "ayah_text_no_diacratic" : "قال لمن حوله الا تستمعون",
