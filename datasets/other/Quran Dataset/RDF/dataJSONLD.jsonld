  }, {
    "@id" : "quran:4889",
    "ayah_text" : "وَٱلنَّجۡمِ إِذَا هَوَىٰ",
    "ayah_text_no_diacratic" : "والنجم اذا هوىٰ",
    "ayahnumber" : "1",
