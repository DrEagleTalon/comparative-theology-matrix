    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3029",
    "ayah_text" : "قَالُوٓاْ ءَامَنَّا بِرَبِّ ٱلۡعَٰلَمِينَ",
    "ayah_text_no_diacratic" : "قالوا ءامنا برب العٰلمين",
