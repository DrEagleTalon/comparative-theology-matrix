  }, {
    "@id" : "quran:3531",
    "ayah_text" : "تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡحَكِيمِ",
    "ayah_text_no_diacratic" : "تلك ءايٰت الكتٰب الحكيم",
    "ayahnumber" : "2",
