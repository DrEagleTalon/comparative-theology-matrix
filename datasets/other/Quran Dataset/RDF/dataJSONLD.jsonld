    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:319",
    "ayah_text" : "إِنَّ ٱلَّذِينَ يَكۡفُرُونَ بِـَٔايَٰتِ ٱللَّهِ وَيَقۡتُلُونَ ٱلنَّبِيِّـۧنَ بِغَيۡرِ حَقّٖ وَيَقۡتُلُونَ ٱلَّذِينَ يَأۡمُرُونَ بِٱلۡقِسۡطِ مِنَ ٱلنَّاسِ فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ",
    "ayah_text_no_diacratic" : "ان الذين يكفرون بايٰت الله ويقتلون النبين بغير حق ويقتلون الذين يامرون بالقسط من الناس فبشرهم بعذاب اليم",
    "ayahnumber" : "21",
    "chapter" : "3",
    "hizb" : "5",
    "index" : "319",
    "page" : "52",
    "surahname" : "سُورَةُ آلِ عِمۡرَانَ",
    "surahnumber" : "3",
    "surrahname_no_diacratic" : "سورة ال عمران"
  }, {
    "@id" : "quran:3190",
    "ayah_text" : "وَمَآ أَهۡلَكۡنَا مِن قَرۡيَةٍ إِلَّا لَهَا مُنذِرُونَ",
    "ayah_text_no_diacratic" : "وما اهلكنا من قرية الا لها منذرون",
    "ayahnumber" : "208",
    "chapter" : "19",
    "hizb" : "37",
    "index" : "3190",
    "page" : "376",
    "surahname" : "سُورَةُ الشُّعَرَاءِ",
    "surahnumber" : "26",
    "surrahname_no_diacratic" : "سورة الشعراء"
  }, {
    "@id" : "quran:3191",
    "ayah_text" : "ذِكۡرَىٰ وَمَا كُنَّا ظَٰلِمِينَ",
