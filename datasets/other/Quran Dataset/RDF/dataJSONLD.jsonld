    "surahname" : "سُورَةُ الأَنۡعَامِ",
    "surahnumber" : "6",
    "surrahname_no_diacratic" : "سورة الانعام"
  }, {
    "@id" : "quran:927",
    "ayah_text" : "۞لَهُمۡ دَارُ ٱلسَّلَٰمِ عِندَ رَبِّهِمۡۖ وَهُوَ وَلِيُّهُم بِمَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "لهم دار السلٰم عند ربهم وهو وليهم بما كانوا يعملون",
    "ayahnumber" : "127",
    "chapter" : "8",
    "hizb" : "14",
