    "surrahname_no_diacratic" : "سورة التوبة"
  }, {
    "@id" : "quran:1357",
    "ayah_text" : "وَءَاخَرُونَ مُرۡجَوۡنَ لِأَمۡرِ ٱللَّهِ إِمَّا يُعَذِّبُهُمۡ وَإِمَّا يَتُوبُ عَلَيۡهِمۡۗ وَٱللَّهُ عَلِيمٌ حَكِيمٞ",
    "ayah_text_no_diacratic" : "وءاخرون مرجون لامر الله اما يعذبهم واما يتوب عليهم والله عليم حكيم",
    "ayahnumber" : "106",
    "chapter" : "11",
    "hizb" : "20",
