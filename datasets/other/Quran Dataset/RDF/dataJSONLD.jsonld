    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2028",
    "ayah_text" : "مَنۡ عَمِلَ صَٰلِحٗا مِّن ذَكَرٍ أَوۡ أُنثَىٰ وَهُوَ مُؤۡمِنٞ فَلَنُحۡيِيَنَّهُۥ حَيَوٰةٗ طَيِّبَةٗۖ وَلَنَجۡزِيَنَّهُمۡ أَجۡرَهُم بِأَحۡسَنِ مَا كَانُواْ يَعۡمَلُونَ",
    "ayah_text_no_diacratic" : "من عمل صٰلحا من ذكر او انثىٰ وهو مؤمن فلنحيينه حيوٰة طيبة ولنجزينهم اجرهم باحسن ما كانوا يعملون",
    "ayahnumber" : "97",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2028",
    "page" : "278",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:2029",
    "ayah_text" : "فَإِذَا قَرَأۡتَ ٱلۡقُرۡءَانَ فَٱسۡتَعِذۡ بِٱللَّهِ مِنَ ٱلشَّيۡطَٰنِ ٱلرَّجِيمِ",
    "ayah_text_no_diacratic" : "فاذا قرات القرءان فاستعذ بالله من الشيطٰن الرجيم",
    "ayahnumber" : "98",
    "chapter" : "14",
    "hizb" : "27",
    "index" : "2029",
    "page" : "278",
    "surahname" : "سُورَةُ النَّحۡلِ",
    "surahnumber" : "16",
    "surrahname_no_diacratic" : "سورة النحل"
  }, {
    "@id" : "quran:203",
    "ayah_text" : "وَقَٰتِلُوهُمۡ حَتَّىٰ لَا تَكُونَ فِتۡنَةٞ وَيَكُونَ ٱلدِّينُ لِلَّهِۖ فَإِنِ ٱنتَهَوۡاْ فَلَا عُدۡوَٰنَ إِلَّا عَلَى ٱلظَّٰلِمِينَ",
    "ayah_text_no_diacratic" : "وقٰتلوهم حتىٰ لا تكون فتنة ويكون الدين لله فان انتهوا فلا عدوٰن الا على الظٰلمين",
    "ayahnumber" : "193",
