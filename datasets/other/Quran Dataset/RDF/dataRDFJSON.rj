    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وجاءو علىٰ قميصه بدم كذب قال بل سولت لكم انفسكم امرا فصبر جميل والله المستعان علىٰ ما تصفون"
    }
