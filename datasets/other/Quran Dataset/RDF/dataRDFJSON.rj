    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولولا اذ سمعتموه قلتم ما يكون لنا ان نتكلم بهٰذا سبحٰنك هٰذا بهتٰن عظيم"
    }
