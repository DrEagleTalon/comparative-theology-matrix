    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ومن يسلم وجهه الى الله وهو محسن فقد استمسك بالعروة الوثقىٰ والى الله عٰقبة الامور"
    }
