    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وجعلنا منهم ائمة يهدون بامرنا لما صبروا وكانوا بايٰتنا يوقنون"
