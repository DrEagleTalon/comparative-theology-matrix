    "http://khalidaloufi.sa/quran#page" : [ { 
      "type" : "literal" ,
      "value" : "302"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واما الجدار فكان لغلٰمين يتيمين في المدينة وكان تحته كنز لهما وكان ابوهما صٰلحا فاراد ربك ان يبلغا اشدهما ويستخرجا كنزهما رحمة من ربك وما فعلته عن امري ذٰلك تاويل ما لم تسطع عليه صبرا"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "82"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "وَأَمَّا ٱلۡجِدَارُ فَكَانَ لِغُلَٰمَيۡنِ يَتِيمَيۡنِ فِي ٱلۡمَدِينَةِ وَكَانَ تَحۡتَهُۥ كَنزٞ لَّهُمَا وَكَانَ أَبُوهُمَا صَٰلِحٗا فَأَرَادَ رَبُّكَ أَن يَبۡلُغَآ أَشُدَّهُمَا وَيَسۡتَخۡرِجَا كَنزَهُمَا رَحۡمَةٗ مِّن رَّبِّكَۚ وَمَا فَعَلۡتُهُۥ عَنۡ أَمۡرِيۚ ذَٰلِكَ تَأۡوِيلُ مَا لَمۡ تَسۡطِع عَّلَيۡهِ صَبۡرٗا"
    }
     ] ,
    "http://khalidaloufi.sa/quran#chapter" : [ { 
