    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "والذي اوحينا اليك من الكتٰب هو الحق مصدقا لما بين يديه ان الله بعباده لخبير بصير"
    }
     ] ,
