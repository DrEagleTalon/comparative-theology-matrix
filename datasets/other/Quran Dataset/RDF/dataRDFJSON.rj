    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "اشتروا بايٰت الله ثمنا قليلا فصدوا عن سبيله انهم ساء ما كانوا يعملون"
    }
