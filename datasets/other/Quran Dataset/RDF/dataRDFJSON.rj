    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ذٰلك بانهم شاقوا الله ورسوله ومن يشاق الله فان الله شديد العقاب"
    }
