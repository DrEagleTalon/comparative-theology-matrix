  "http://khalidaloufi.sa/quran#1967" : { 
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "وَلَقَدۡ بَعَثۡنَا فِي كُلِّ أُمَّةٖ رَّسُولًا أَنِ ٱعۡبُدُواْ ٱللَّهَ وَٱجۡتَنِبُواْ ٱلطَّٰغُوتَۖ فَمِنۡهُم مَّنۡ هَدَى ٱللَّهُ وَمِنۡهُم مَّنۡ حَقَّتۡ عَلَيۡهِ ٱلضَّلَٰلَةُۚ فَسِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُكَذِّبِينَ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#chapter" : [ { 
      "type" : "literal" ,
      "value" : "14"
    }
     ] ,
    "http://khalidaloufi.sa/quran#index" : [ { 
      "type" : "literal" ,
      "value" : "1967"
