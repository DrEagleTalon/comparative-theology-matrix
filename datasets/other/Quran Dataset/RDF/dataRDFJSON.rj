    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "والذين يجتنبون كبٰئر الاثم والفوٰحش واذا ما غضبوا هم يغفرون"
    }
