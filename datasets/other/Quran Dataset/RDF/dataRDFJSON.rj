    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولا تكونوا كالذين خرجوا من ديٰرهم بطرا ورئاء الناس ويصدون عن سبيل الله والله بما يعملون محيط"
    }
