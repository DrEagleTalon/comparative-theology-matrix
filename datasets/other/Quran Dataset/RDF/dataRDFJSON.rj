    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واذ يرفع ابرٰهم القواعد من البيت واسمٰعيل ربنا تقبل منا انك انت السميع العليم"
    }
