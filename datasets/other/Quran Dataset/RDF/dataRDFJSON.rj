    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "عفا الله عنك لم اذنت لهم حتىٰ يتبين لك الذين صدقوا وتعلم الكٰذبين"
