     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "اني توكلت على الله ربي وربكم ما من دابة الا هو ءاخذ بناصيتها ان ربي علىٰ صرٰط مستقيم"
    }
