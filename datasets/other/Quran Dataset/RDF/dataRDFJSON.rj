    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ويزيد الله الذين اهتدوا هدى والبٰقيٰت الصٰلحٰت خير عند ربك ثوابا وخير مردا"
    }
