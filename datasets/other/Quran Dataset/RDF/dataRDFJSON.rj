    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وتوكل على الحي الذي لا يموت وسبح بحمده وكفىٰ به بذنوب عباده خبيرا"
