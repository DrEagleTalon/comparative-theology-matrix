    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وان اتلوا القرءان فمن اهتدىٰ فانما يهتدي لنفسه ومن ضل فقل انما انا من المنذرين"
    }
