    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وقال الذين في النار لخزنة جهنم ادعوا ربكم يخفف عنا يوما من العذاب"
    }
