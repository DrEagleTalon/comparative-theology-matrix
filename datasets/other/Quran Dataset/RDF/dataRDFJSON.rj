    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وتركنا بعضهم يومئذ يموج في بعض ونفخ في الصور فجمعنٰهم جمعا"
    }
