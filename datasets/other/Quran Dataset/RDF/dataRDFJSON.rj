    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "انه كان فريق من عبادي يقولون ربنا ءامنا فاغفر لنا وارحمنا وانت خير الرٰحمين"
