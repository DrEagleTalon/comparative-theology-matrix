    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وليحملن اثقالهم واثقالا مع اثقالهم وليسلن يوم القيٰمة عما كانوا يفترون"
    }
