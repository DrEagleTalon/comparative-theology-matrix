     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وجاء رجل من اقصا المدينة يسعىٰ قال يٰموسىٰ ان الملا ياتمرون بك ليقتلوك فاخرج اني لك من النٰصحين"
    }
