    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ربنا وءاتنا ما وعدتنا علىٰ رسلك ولا تخزنا يوم القيٰمة انك لا تخلف الميعاد"
    }
