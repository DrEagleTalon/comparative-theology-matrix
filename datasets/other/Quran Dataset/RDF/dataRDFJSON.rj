    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "من المؤمنين رجال صدقوا ما عٰهدوا الله عليه فمنهم من قضىٰ نحبه ومنهم من ينتظر وما بدلوا تبديلا"
    }
