      "type" : "literal" ,
      "value" : "16"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قل للمخلفين من الاعراب ستدعون الىٰ قوم اولي باس شديد تقٰتلونهم او يسلمون فان تطيعوا يؤتكم الله اجرا حسنا وان تتولوا كما توليتم من قبل يعذبكم عذابا اليما"
    }
     ]
  }
