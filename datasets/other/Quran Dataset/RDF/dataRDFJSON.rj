    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "للرجال نصيب مما ترك الوٰلدان والاقربون وللنساء نصيب مما ترك الوٰلدان والاقربون مما قل منه او كثر نصيبا مفروضا"
    }
