    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "فلم يك ينفعهم ايمٰنهم لما راوا باسنا سنت الله التي قد خلت في عباده وخسر هنالك الكٰفرون"
    }
