    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "اليوم تجزىٰ كل نفس بما كسبت لا ظلم اليوم ان الله سريع الحساب"
    }
