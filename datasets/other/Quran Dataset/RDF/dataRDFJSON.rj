      "value" : "6"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "151"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قل تعالوا اتل ما حرم ربكم عليكم الا تشركوا به شيا وبالوٰلدين احسٰنا ولا تقتلوا اولٰدكم من املٰق نحن نرزقكم واياهم ولا تقربوا الفوٰحش ما ظهر منها وما بطن ولا تقتلوا النفس التي حرم الله الا بالحق ذٰلكم وصىٰكم به لعلكم تعقلون"
    }
     ]
  }
   ,
