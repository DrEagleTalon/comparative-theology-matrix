    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "يٰقوم انما هٰذه الحيوٰة الدنيا متٰع وان الاخرة هي دار القرار"
