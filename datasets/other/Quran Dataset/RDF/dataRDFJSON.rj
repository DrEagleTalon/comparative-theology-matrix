    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ونقلب افدتهم وابصٰرهم كما لم يؤمنوا به اول مرة ونذرهم في طغيٰنهم يعمهون"
    }
