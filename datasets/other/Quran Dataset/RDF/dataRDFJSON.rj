    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "الله يعلم ما تحمل كل انثىٰ وما تغيض الارحام وما تزداد وكل شيء عنده بمقدار"
    }
