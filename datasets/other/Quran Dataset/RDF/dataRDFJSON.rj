    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "فاصابهم سيات ما كسبوا والذين ظلموا من هٰؤلاء سيصيبهم سيات ما كسبوا وما هم بمعجزين"
    }
