    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واصنع الفلك باعيننا ووحينا ولا تخٰطبني في الذين ظلموا انهم مغرقون"
