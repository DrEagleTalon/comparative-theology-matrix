     ] ,
    "http://khalidaloufi.sa/quran#surahname" : [ { 
      "type" : "literal" ,
      "value" : "سُورَةُ صٓ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#hizb" : [ { 
      "type" : "literal" ,
      "value" : "45"
    }
     ] ,
    "http://khalidaloufi.sa/quran#page" : [ { 
      "type" : "literal" ,
      "value" : "454"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "اذ دخلوا علىٰ داود ففزع منهم قالوا لا تخف خصمان بغىٰ بعضنا علىٰ بعض فاحكم بيننا بالحق ولا تشطط واهدنا الىٰ سواء الصرٰط"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "22"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "إِذۡ دَخَلُواْ عَلَىٰ دَاوُۥدَ فَفَزِعَ مِنۡهُمۡۖ قَالُواْ لَا تَخَفۡۖ خَصۡمَانِ بَغَىٰ بَعۡضُنَا عَلَىٰ بَعۡضٖ فَٱحۡكُم بَيۡنَنَا بِٱلۡحَقِّ وَلَا تُشۡطِطۡ وَٱهۡدِنَآ إِلَىٰ سَوَآءِ ٱلصِّرَٰطِ"
    }
