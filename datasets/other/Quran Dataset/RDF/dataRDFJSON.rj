    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وما نتنزل الا بامر ربك له ما بين ايدينا وما خلفنا وما بين ذٰلك وما كان ربك نسيا"
    }
