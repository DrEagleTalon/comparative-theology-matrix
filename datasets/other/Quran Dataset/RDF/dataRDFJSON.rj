    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "لم يكن الذين كفروا من اهل الكتٰب والمشركين منفكين حتىٰ تاتيهم البينة"
    }
