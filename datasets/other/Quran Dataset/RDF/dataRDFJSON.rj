    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ويرى الذين اوتوا العلم الذي انزل اليك من ربك هو الحق ويهدي الىٰ صرٰط العزيز الحميد"
    }
