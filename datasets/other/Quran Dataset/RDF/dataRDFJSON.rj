    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "لهم من فوقهم ظلل من النار ومن تحتهم ظلل ذٰلك يخوف الله به عباده يٰعباد فاتقون"
    }
