    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ويوم تقوم الساعة يقسم المجرمون ما لبثوا غير ساعة كذٰلك كانوا يؤفكون"
    }
