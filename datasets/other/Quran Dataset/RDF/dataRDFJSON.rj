    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "فلا تعلم نفس ما اخفي لهم من قرة اعين جزاء بما كانوا يعملون"
    }
