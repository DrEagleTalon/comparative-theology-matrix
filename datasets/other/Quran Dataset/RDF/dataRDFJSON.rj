     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ضرب الله مثلا عبدا مملوكا لا يقدر علىٰ شيء ومن رزقنٰه منا رزقا حسنا فهو ينفق منه سرا وجهرا هل يستون الحمد لله بل اكثرهم لا يعلمون"
    }
