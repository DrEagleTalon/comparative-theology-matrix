    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ومن ءابائهم وذريٰتهم واخوٰنهم واجتبينٰهم وهدينٰهم الىٰ صرٰط مستقيم"
    }
