    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واما تخافن من قوم خيانة فانبذ اليهم علىٰ سواء ان الله لا يحب الخائنين"
    }
