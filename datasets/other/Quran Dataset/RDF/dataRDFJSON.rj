    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ان في اختلٰف اليل والنهار وما خلق الله في السمٰوٰت والارض لايٰت لقوم يتقون"
    }
