    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "فاستجبنا له فكشفنا ما به من ضر وءاتينٰه اهله ومثلهم معهم رحمة من عندنا وذكرىٰ للعٰبدين"
    }
     ] ,
