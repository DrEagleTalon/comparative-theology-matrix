      "type" : "literal" ,
      "value" : "سُورَةُ النَّحۡلِ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#hizb" : [ { 
      "type" : "literal" ,
      "value" : "27"
    }
     ] ,
    "http://khalidaloufi.sa/quran#page" : [ { 
      "type" : "literal" ,
      "value" : "271"
    }
     ] ,
    "http://khalidaloufi.sa/quran#surahnumber" : [ { 
      "type" : "literal" ,
      "value" : "16"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "36"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولقد بعثنا في كل امة رسولا ان اعبدوا الله واجتنبوا الطٰغوت فمنهم من هدى الله ومنهم من حقت عليه الضلٰلة فسيروا في الارض فانظروا كيف كان عٰقبة المكذبين"
    }
     ]
