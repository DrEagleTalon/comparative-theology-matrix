    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "الملك يومئذ لله يحكم بينهم فالذين ءامنوا وعملوا الصٰلحٰت في جنٰت النعيم"
    }
