    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وان يمسسك الله بضر فلا كاشف له الا هو وان يمسسك بخير فهو علىٰ كل شيء قدير"
    }
