      "type" : "literal" ,
      "value" : "سُورَةُ الصَّفِّ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#hizb" : [ { 
      "type" : "literal" ,
      "value" : "55"
    }
     ] ,
    "http://khalidaloufi.sa/quran#page" : [ { 
      "type" : "literal" ,
      "value" : "552"
    }
     ] ,
    "http://khalidaloufi.sa/quran#surahnumber" : [ { 
      "type" : "literal" ,
      "value" : "61"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واذ قال عيسى ابن مريم يٰبني اسرٰءيل اني رسول الله اليكم مصدقا لما بين يدي من التورىٰة ومبشرا برسول ياتي من بعدي اسمه احمد فلما جاءهم بالبينٰت قالوا هٰذا سحر مبين"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "6"
    }
     ]
  }
