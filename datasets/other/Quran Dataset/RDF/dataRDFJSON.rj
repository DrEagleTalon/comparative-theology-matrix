    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولقد زينا السماء الدنيا بمصٰبيح وجعلنٰها رجوما للشيٰطين واعتدنا لهم عذاب السعير"
