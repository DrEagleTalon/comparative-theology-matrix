    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "فان تولوا فقل ءاذنتكم علىٰ سواء وان ادري اقريب ام بعيد ما توعدون"
