    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "انما السبيل على الذين يظلمون الناس ويبغون في الارض بغير الحق اولٰئك لهم عذاب اليم"
    }
