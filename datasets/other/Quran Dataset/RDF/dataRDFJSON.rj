    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولا يامركم ان تتخذوا الملٰئكة والنبين اربابا ايامركم بالكفر بعد اذ انتم مسلمون"
