    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "فالتقطه ءال فرعون ليكون لهم عدوا وحزنا ان فرعون وهٰمٰن وجنودهما كانوا خٰطين"
    }
