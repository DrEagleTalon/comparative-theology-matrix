    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وابرٰهيم اذ قال لقومه اعبدوا الله واتقوه ذٰلكم خير لكم ان كنتم تعلمون"
    }
     ] ,
