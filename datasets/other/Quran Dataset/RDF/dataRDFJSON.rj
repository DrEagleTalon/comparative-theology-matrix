    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ومن ياته مؤمنا قد عمل الصٰلحٰت فاولٰئك لهم الدرجٰت العلىٰ"
