    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ويقول الذين كفروا لولا انزل عليه ءاية من ربه قل ان الله يضل من يشاء ويهدي اليه من اناب"
    }
