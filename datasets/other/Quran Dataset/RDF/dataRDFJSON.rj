    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وما كان لبشر ان يكلمه الله الا وحيا او من وراي حجاب او يرسل رسولا فيوحي باذنه ما يشاء انه علي حكيم"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "51"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "۞وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ ٱللَّهُ إِلَّا وَحۡيًا أَوۡ مِن وَرَآيِٕ حِجَابٍ أَوۡ يُرۡسِلَ رَسُولٗا فَيُوحِيَ بِإِذۡنِهِۦ مَا يَشَآءُۚ إِنَّهُۥ عَلِيٌّ حَكِيمٞ"
    }
     ] ,
