    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ثم ياتي من بعد ذٰلك سبع شداد ياكلن ما قدمتم لهن الا قليلا مما تحصنون"
    }
