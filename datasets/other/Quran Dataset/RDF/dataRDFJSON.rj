    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "41"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واعلموا انما غنمتم من شيء فان لله خمسه وللرسول ولذي القربىٰ واليتٰمىٰ والمسٰكين وابن السبيل ان كنتم ءامنتم بالله وما انزلنا علىٰ عبدنا يوم الفرقان يوم التقى الجمعان والله علىٰ كل شيء قدير"
    }
     ]
  }
