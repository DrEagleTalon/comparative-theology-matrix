    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ام يحسبون انا لا نسمع سرهم ونجوىٰهم بلىٰ ورسلنا لديهم يكتبون"
