    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وهو الذي يقبل التوبة عن عباده ويعفوا عن السيات ويعلم ما تفعلون"
    }
     ] ,
