    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "من دون الله قالوا ضلوا عنا بل لم نكن ندعوا من قبل شيا كذٰلك يضل الله الكٰفرين"
    }
