    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قال اني ليحزنني ان تذهبوا به واخاف ان ياكله الذئب وانتم عنه غٰفلون"
    }
