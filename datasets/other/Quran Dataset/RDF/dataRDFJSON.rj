    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "يٰايها النبي حرض المؤمنين على القتال ان يكن منكم عشرون صٰبرون يغلبوا مائتين وان يكن منكم مائة يغلبوا الفا من الذين كفروا بانهم قوم لا يفقهون"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "65"
