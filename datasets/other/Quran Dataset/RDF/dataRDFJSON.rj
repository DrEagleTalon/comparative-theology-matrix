    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولكل امة جعلنا منسكا ليذكروا اسم الله علىٰ ما رزقهم من بهيمة الانعٰم فالٰهكم الٰه وٰحد فله اسلموا وبشر المخبتين"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
