    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واني كلما دعوتهم لتغفر لهم جعلوا اصٰبعهم في ءاذانهم واستغشوا ثيابهم واصروا واستكبروا استكبارا"
