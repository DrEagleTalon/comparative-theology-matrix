    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ليعلم ان قد ابلغوا رسٰلٰت ربهم واحاط بما لديهم واحصىٰ كل شيء عددا"
    }
