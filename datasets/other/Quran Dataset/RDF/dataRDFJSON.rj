      "value" : "فيه ءايٰت بينٰت مقام ابرٰهيم ومن دخله كان ءامنا ولله على الناس حج البيت من استطاع اليه سبيلا ومن كفر فان الله غني عن العٰلمين"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "97"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "فِيهِ ءَايَٰتُۢ بَيِّنَٰتٞ مَّقَامُ إِبۡرَٰهِيمَۖ وَمَن دَخَلَهُۥ كَانَ ءَامِنٗاۗ وَلِلَّهِ عَلَى ٱلنَّاسِ حِجُّ ٱلۡبَيۡتِ مَنِ ٱسۡتَطَاعَ إِلَيۡهِ سَبِيلٗاۚ وَمَن كَفَرَ فَإِنَّ ٱللَّهَ غَنِيٌّ عَنِ ٱلۡعَٰلَمِينَ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#chapter" : [ { 
      "type" : "literal" ,
      "value" : "4"
    }
     ] ,
    "http://khalidaloufi.sa/quran#surahnumber" : [ { 
      "type" : "literal" ,
      "value" : "3"
    }
     ]
  }
