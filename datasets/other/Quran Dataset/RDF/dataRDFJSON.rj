    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولقد صرفنا في هٰذا القرءان للناس من كل مثل وكان الانسٰن اكثر شيء جدلا"
