    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وانذر الناس يوم ياتيهم العذاب فيقول الذين ظلموا ربنا اخرنا الىٰ اجل قريب نجب دعوتك ونتبع الرسل اولم تكونوا اقسمتم من قبل ما لكم من زوال"
    }
     ]
