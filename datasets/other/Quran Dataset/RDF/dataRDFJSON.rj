    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "فذرني ومن يكذب بهٰذا الحديث سنستدرجهم من حيث لا يعلمون"
    }
