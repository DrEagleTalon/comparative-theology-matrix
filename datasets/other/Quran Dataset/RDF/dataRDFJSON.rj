    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ان تبدوا خيرا او تخفوه او تعفوا عن سوء فان الله كان عفوا قديرا"
    }
