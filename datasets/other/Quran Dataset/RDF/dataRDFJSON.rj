    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واذ قال ابرٰهيم لابيه ءازر اتتخذ اصناما ءالهة اني ارىٰك وقومك في ضلٰل مبين"
    }
