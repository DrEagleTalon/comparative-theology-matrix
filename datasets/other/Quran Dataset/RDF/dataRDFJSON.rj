    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ذٰلكم الله ربكم لا الٰه الا هو خٰلق كل شيء فاعبدوه وهو علىٰ كل شيء وكيل"
    }
