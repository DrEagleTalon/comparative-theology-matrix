    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ان الذين ءامنوا والذين هاجروا وجٰهدوا في سبيل الله اولٰئك يرجون رحمت الله والله غفور رحيم"
    }
