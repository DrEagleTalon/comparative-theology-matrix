    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "يٰايها الذين ءامنوا اتقوا الله وذروا ما بقي من الربوٰا ان كنتم مؤمنين"
