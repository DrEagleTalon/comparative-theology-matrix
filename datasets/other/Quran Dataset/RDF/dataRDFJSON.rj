    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "اولم يروا الى الطير فوقهم صٰفٰت ويقبضن ما يمسكهن الا الرحمٰن انه بكل شيء بصير"
    }
