      "type" : "literal" ,
      "value" : "3"
    }
     ] ,
    "http://khalidaloufi.sa/quran#page" : [ { 
      "type" : "literal" ,
      "value" : "31"
    }
     ] ,
    "http://khalidaloufi.sa/quran#surahnumber" : [ { 
      "type" : "literal" ,
      "value" : "2"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ليس عليكم جناح ان تبتغوا فضلا من ربكم فاذا افضتم من عرفٰت فاذكروا الله عند المشعر الحرام واذكروه كما هدىٰكم وان كنتم من قبله لمن الضالين"
    }
     ] ,
