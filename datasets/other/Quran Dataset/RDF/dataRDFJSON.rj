    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "كداب ءال فرعون والذين من قبلهم كذبوا بايٰتنا فاخذهم الله بذنوبهم والله شديد العقاب"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "كَدَأۡبِ ءَالِ فِرۡعَوۡنَ وَٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَذَّبُواْ بِـَٔايَٰتِنَا فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمۡۗ وَٱللَّهُ شَدِيدُ ٱلۡعِقَابِ"
    }
     ] ,
