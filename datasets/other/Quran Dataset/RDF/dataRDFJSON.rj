    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "اسمع بهم وابصر يوم ياتوننا لٰكن الظٰلمون اليوم في ضلٰل مبين"
