    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واتقوا يوما ترجعون فيه الى الله ثم توفىٰ كل نفس ما كسبت وهم لا يظلمون"
