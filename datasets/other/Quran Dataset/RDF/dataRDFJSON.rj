    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وان يكاد الذين كفروا ليزلقونك بابصٰرهم لما سمعوا الذكر ويقولون انه لمجنون"
