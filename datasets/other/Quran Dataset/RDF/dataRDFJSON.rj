    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قل من يرزقكم من السمٰوٰت والارض قل الله وانا او اياكم لعلىٰ هدى او في ضلٰل مبين"
    }
