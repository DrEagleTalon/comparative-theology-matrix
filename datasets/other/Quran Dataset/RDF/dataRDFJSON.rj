    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وهو الذي انشاكم من نفس وٰحدة فمستقر ومستودع قد فصلنا الايٰت لقوم يفقهون"
