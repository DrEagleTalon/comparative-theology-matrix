     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولو اتبع الحق اهواءهم لفسدت السمٰوٰت والارض ومن فيهن بل اتينٰهم بذكرهم فهم عن ذكرهم معرضون"
