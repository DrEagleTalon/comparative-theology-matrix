    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "انما كان قول المؤمنين اذا دعوا الى الله ورسوله ليحكم بينهم ان يقولوا سمعنا واطعنا واولٰئك هم المفلحون"
    }
