    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولا تكونوا كالذين نسوا الله فانسىٰهم انفسهم اولٰئك هم الفٰسقون"
