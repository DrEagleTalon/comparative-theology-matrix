    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولله يسجد ما في السمٰوٰت وما في الارض من دابة والملٰئكة وهم لا يستكبرون"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
