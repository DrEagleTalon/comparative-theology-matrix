    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وما انفقتم من نفقة او نذرتم من نذر فان الله يعلمه وما للظٰلمين من انصار"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "270"
