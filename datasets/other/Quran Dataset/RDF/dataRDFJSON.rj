    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "فاذا ركبوا في الفلك دعوا الله مخلصين له الدين فلما نجىٰهم الى البر اذا هم يشركون"
    }
