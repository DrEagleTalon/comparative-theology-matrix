      "value" : "الذين ءامنوا وتطمئن قلوبهم بذكر الله الا بذكر الله تطمئن القلوب"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "ٱلَّذِينَ ءَامَنُواْ وَتَطۡمَئِنُّ قُلُوبُهُم بِذِكۡرِ ٱللَّهِۗ أَلَا بِذِكۡرِ ٱللَّهِ تَطۡمَئِنُّ ٱلۡقُلُوبُ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#chapter" : [ { 
