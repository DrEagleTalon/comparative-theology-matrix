    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "مما خطيٰتهم اغرقوا فادخلوا نارا فلم يجدوا لهم من دون الله انصارا"
    }
     ] ,
