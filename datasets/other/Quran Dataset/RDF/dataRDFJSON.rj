      "type" : "literal" ,
      "value" : "3"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "الذين قال لهم الناس ان الناس قد جمعوا لكم فاخشوهم فزادهم ايمٰنا وقالوا حسبنا الله ونعم الوكيل"
