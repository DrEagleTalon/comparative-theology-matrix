     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ومن اظلم ممن ذكر بايٰت ربه فاعرض عنها ونسي ما قدمت يداه انا جعلنا علىٰ قلوبهم اكنة ان يفقهوه وفي ءاذانهم وقرا وان تدعهم الى الهدىٰ فلن يهتدوا اذا ابدا"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "57"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "وَمَنۡ أَظۡلَمُ مِمَّن ذُكِّرَ بِـَٔايَٰتِ رَبِّهِۦ فَأَعۡرَضَ عَنۡهَا وَنَسِيَ مَا قَدَّمَتۡ يَدَاهُۚ إِنَّا جَعَلۡنَا عَلَىٰ قُلُوبِهِمۡ أَكِنَّةً أَن يَفۡقَهُوهُ وَفِيٓ ءَاذَانِهِمۡ وَقۡرٗاۖ وَإِن تَدۡعُهُمۡ إِلَى ٱلۡهُدَىٰ فَلَن يَهۡتَدُوٓاْ إِذًا أَبَدٗا"
    }
     ] ,
    "http://khalidaloufi.sa/quran#chapter" : [ { 
      "type" : "literal" ,
      "value" : "15"
    }
     ] ,
    "http://khalidaloufi.sa/quran#surahnumber" : [ { 
      "type" : "literal" ,
      "value" : "18"
    }
     ]
  }
