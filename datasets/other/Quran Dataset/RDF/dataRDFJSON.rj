    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قل اللهم فاطر السمٰوٰت والارض عٰلم الغيب والشهٰدة انت تحكم بين عبادك في ما كانوا فيه يختلفون"
    }
