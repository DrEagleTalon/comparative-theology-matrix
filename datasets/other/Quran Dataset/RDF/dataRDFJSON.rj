    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولوطا اذ قال لقومه انكم لتاتون الفٰحشة ما سبقكم بها من احد من العٰلمين"
    }
