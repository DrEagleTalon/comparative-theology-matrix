    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واذ يقول المنٰفقون والذين في قلوبهم مرض ما وعدنا الله ورسوله الا غرورا"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
