    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "افامن الذين مكروا السيات ان يخسف الله بهم الارض او ياتيهم العذاب من حيث لا يشعرون"
    }
