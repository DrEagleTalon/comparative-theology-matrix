    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "يسمع ءايٰت الله تتلىٰ عليه ثم يصر مستكبرا كان لم يسمعها فبشره بعذاب اليم"
    }
