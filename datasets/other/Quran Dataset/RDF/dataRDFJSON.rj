    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قيما لينذر باسا شديدا من لدنه ويبشر المؤمنين الذين يعملون الصٰلحٰت ان لهم اجرا حسنا"
    }
