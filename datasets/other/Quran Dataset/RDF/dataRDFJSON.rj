    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قل ارءيتكم ان اتىٰكم عذاب الله بغتة او جهرة هل يهلك الا القوم الظٰلمون"
