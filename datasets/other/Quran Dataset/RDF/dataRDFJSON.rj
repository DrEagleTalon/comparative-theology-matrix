    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "والله يريد ان يتوب عليكم ويريد الذين يتبعون الشهوٰت ان تميلوا ميلا عظيما"
    }
     ] ,
