    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "بل هو ءايٰت بينٰت في صدور الذين اوتوا العلم وما يجحد بايٰتنا الا الظٰلمون"
    }
     ] ,
