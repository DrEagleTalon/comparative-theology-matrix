    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "هٰذا خلق الله فاروني ماذا خلق الذين من دونه بل الظٰلمون في ضلٰل مبين"
