      "value" : "34"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "لَّهُمۡ عَذَابٞ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَشَقُّۖ وَمَا لَهُم مِّنَ ٱللَّهِ مِن وَاقٖ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#chapter" : [ { 
      "type" : "literal" ,
      "value" : "13"
    }
     ] ,
    "http://khalidaloufi.sa/quran#surahnumber" : [ { 
      "type" : "literal" ,
      "value" : "13"
    }
     ]
  }
