      "value" : "5"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "24"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قالوا يٰموسىٰ انا لن ندخلها ابدا ما داموا فيها فاذهب انت وربك فقٰتلا انا هٰهنا قٰعدون"
