    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وهو الذي ينزل الغيث من بعد ما قنطوا وينشر رحمته وهو الولي الحميد"
    }
