    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واما الذين في قلوبهم مرض فزادتهم رجسا الىٰ رجسهم وماتوا وهم كٰفرون"
    }
