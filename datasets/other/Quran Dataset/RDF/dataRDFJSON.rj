    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قالوا يٰابانا ما لك لا تامنا علىٰ يوسف وانا له لنٰصحون"
    }
