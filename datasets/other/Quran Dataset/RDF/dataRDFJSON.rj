    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولو شاء الله ما اشركوا وما جعلنٰك عليهم حفيظا وما انت عليهم بوكيل"
    }
