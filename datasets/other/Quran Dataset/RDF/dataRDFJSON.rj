     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "يٰايها النبي قل لازوٰجك ان كنتن تردن الحيوٰة الدنيا وزينتها فتعالين امتعكن واسرحكن سراحا جميلا"
    }
     ] ,
