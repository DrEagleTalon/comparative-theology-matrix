    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولله المشرق والمغرب فاينما تولوا فثم وجه الله ان الله وٰسع عليم"
    }
