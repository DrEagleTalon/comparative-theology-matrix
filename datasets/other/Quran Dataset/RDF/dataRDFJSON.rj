    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "يٰايها الناس انا خلقنٰكم من ذكر وانثىٰ وجعلنٰكم شعوبا وقبائل لتعارفوا ان اكرمكم عند الله اتقىٰكم ان الله عليم خبير"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "13"
