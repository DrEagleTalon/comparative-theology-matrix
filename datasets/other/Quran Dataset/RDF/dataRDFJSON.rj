    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واذا صرفت ابصٰرهم تلقاء اصحٰب النار قالوا ربنا لا تجعلنا مع القوم الظٰلمين"
    }
