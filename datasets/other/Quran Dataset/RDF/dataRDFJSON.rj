    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وتلك القرىٰ اهلكنٰهم لما ظلموا وجعلنا لمهلكهم موعدا"
