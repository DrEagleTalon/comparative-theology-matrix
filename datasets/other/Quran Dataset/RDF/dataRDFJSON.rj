    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وانزلنا من السماء ماء بقدر فاسكنٰه في الارض وانا علىٰ ذهاب به لقٰدرون"
