    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ومن يعص الله ورسوله ويتعد حدوده يدخله نارا خٰلدا فيها وله عذاب مهين"
