    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وما كان الله ليضل قوما بعد اذ هدىٰهم حتىٰ يبين لهم ما يتقون ان الله بكل شيء عليم"
    }
