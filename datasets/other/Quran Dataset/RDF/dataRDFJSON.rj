      "value" : "18"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "17"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وترى الشمس اذا طلعت تزٰور عن كهفهم ذات اليمين واذا غربت تقرضهم ذات الشمال وهم في فجوة منه ذٰلك من ءايٰت الله من يهد الله فهو المهتد ومن يضلل فلن تجد له وليا مرشدا"
    }
     ]
  }
