    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وما اختلفتم فيه من شيء فحكمه الى الله ذٰلكم الله ربي عليه توكلت واليه انيب"
    }
