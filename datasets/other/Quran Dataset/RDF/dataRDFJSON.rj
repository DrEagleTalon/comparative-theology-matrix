    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وربك اعلم بمن في السمٰوٰت والارض ولقد فضلنا بعض النبين علىٰ بعض وءاتينا داود زبورا"
    }
