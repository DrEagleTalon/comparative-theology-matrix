      "type" : "literal" ,
      "value" : "سورة فصلت"
    }
     ] ,
    "http://khalidaloufi.sa/quran#surahname" : [ { 
      "type" : "literal" ,
      "value" : "سُورَةُ فُصِّلَتۡ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#hizb" : [ { 
      "type" : "literal" ,
      "value" : "48"
    }
     ] ,
    "http://khalidaloufi.sa/quran#page" : [ { 
      "type" : "literal" ,
      "value" : "482"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولئن اذقنٰه رحمة منا من بعد ضراء مسته ليقولن هٰذا لي وما اظن الساعة قائمة ولئن رجعت الىٰ ربي ان لي عنده للحسنىٰ فلننبئن الذين كفروا بما عملوا ولنذيقنهم من عذاب غليظ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "50"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text" : [ { 
      "type" : "literal" ,
      "value" : "وَلَئِنۡ أَذَقۡنَٰهُ رَحۡمَةٗ مِّنَّا مِنۢ بَعۡدِ ضَرَّآءَ مَسَّتۡهُ لَيَقُولَنَّ هَٰذَا لِي وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةٗ وَلَئِن رُّجِعۡتُ إِلَىٰ رَبِّيٓ إِنَّ لِي عِندَهُۥ لَلۡحُسۡنَىٰۚ فَلَنُنَبِّئَنَّ ٱلَّذِينَ كَفَرُواْ بِمَا عَمِلُواْ وَلَنُذِيقَنَّهُم مِّنۡ عَذَابٍ غَلِيظٖ"
    }
     ] ,
    "http://khalidaloufi.sa/quran#chapter" : [ { 
      "type" : "literal" ,
      "value" : "25"
    }
     ] ,
    "http://khalidaloufi.sa/quran#surahnumber" : [ { 
      "type" : "literal" ,
      "value" : "41"
    }
     ]
  }
