    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "للفقراء المهٰجرين الذين اخرجوا من ديٰرهم واموٰلهم يبتغون فضلا من الله ورضوٰنا وينصرون الله ورسوله اولٰئك هم الصٰدقون"
    }
