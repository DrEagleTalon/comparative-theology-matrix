    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ربنا انك تعلم ما نخفي وما نعلن وما يخفىٰ على الله من شيء في الارض ولا في السماء"
    }
