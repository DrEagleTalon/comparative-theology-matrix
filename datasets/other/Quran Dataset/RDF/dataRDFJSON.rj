    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ليس عليكم جناح ان تدخلوا بيوتا غير مسكونة فيها متٰع لكم والله يعلم ما تبدون وما تكتمون"
    }
