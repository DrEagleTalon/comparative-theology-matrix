    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ان يشا يسكن الريح فيظللن رواكد علىٰ ظهره ان في ذٰلك لايٰت لكل صبار شكور"
    }
     ] ,
