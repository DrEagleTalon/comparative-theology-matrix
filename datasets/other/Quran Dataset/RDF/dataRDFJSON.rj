    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولقد اوحينا الىٰ موسىٰ ان اسر بعبادي فاضرب لهم طريقا في البحر يبسا لا تخٰف دركا ولا تخشىٰ"
    }
