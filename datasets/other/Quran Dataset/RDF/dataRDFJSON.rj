    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "لولا ينهىٰهم الربٰنيون والاحبار عن قولهم الاثم واكلهم السحت لبئس ما كانوا يصنعون"
    }
