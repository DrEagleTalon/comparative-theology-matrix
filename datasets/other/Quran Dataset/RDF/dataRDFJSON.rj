    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وانا كنا نقعد منها مقٰعد للسمع فمن يستمع الان يجد له شهابا رصدا"
