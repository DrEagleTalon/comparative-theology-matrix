    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولقد ارسلنا الىٰ امم من قبلك فاخذنٰهم بالباساء والضراء لعلهم يتضرعون"
    }
