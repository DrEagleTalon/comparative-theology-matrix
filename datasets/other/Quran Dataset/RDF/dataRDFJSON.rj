    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ووهبنا له اسحٰق ويعقوب كلا هدينا ونوحا هدينا من قبل ومن ذريته داود وسليمٰن وايوب ويوسف وموسىٰ وهٰرون وكذٰلك نجزي المحسنين"
    }
