    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "اءنزل عليه الذكر من بيننا بل هم في شك من ذكري بل لما يذوقوا عذاب"
