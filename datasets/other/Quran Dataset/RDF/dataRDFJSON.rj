    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قالوا ما انتم الا بشر مثلنا وما انزل الرحمٰن من شيء ان انتم الا تكذبون"
    }
