    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ان نشا ننزل عليهم من السماء ءاية فظلت اعنٰقهم لها خٰضعين"
    }
