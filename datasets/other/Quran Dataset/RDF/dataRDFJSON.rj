    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "هو الذي يحي ويميت فاذا قضىٰ امرا فانما يقول له كن فيكون"
    }
     ] ,
