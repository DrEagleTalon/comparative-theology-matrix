    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "واخرىٰ لم تقدروا عليها قد احاط الله بها وكان الله علىٰ كل شيء قديرا"
