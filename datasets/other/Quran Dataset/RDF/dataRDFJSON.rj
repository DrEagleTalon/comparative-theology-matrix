    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ان المصدقين والمصدقٰت واقرضوا الله قرضا حسنا يضٰعف لهم ولهم اجر كريم"
