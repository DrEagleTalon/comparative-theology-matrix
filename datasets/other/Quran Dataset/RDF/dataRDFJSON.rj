    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "قل من بيده ملكوت كل شيء وهو يجير ولا يجار عليه ان كنتم تعلمون"
    }
