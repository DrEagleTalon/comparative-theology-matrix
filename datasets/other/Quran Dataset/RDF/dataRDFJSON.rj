    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "نحن نقص عليك احسن القصص بما اوحينا اليك هٰذا القرءان وان كنت من قبله لمن الغٰفلين"
    }
