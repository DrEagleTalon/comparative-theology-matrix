     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "انما المؤمنون الذين ءامنوا بالله ورسوله ثم لم يرتابوا وجٰهدوا باموٰلهم وانفسهم في سبيل الله اولٰئك هم الصٰدقون"
    }
