    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولقد ارسلنا نوحا وابرٰهيم وجعلنا في ذريتهما النبوة والكتٰب فمنهم مهتد وكثير منهم فٰسقون"
    }
