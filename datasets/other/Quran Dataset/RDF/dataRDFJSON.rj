    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولقد اهلكنا القرون من قبلكم لما ظلموا وجاءتهم رسلهم بالبينٰت وما كانوا ليؤمنوا كذٰلك نجزي القوم المجرمين"
    }
