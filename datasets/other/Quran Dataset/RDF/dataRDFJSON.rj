    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولله الاسماء الحسنىٰ فادعوه بها وذروا الذين يلحدون في اسمٰئه سيجزون ما كانوا يعملون"
    }
