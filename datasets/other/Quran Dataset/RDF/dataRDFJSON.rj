    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولقد اهلكنا ما حولكم من القرىٰ وصرفنا الايٰت لعلهم يرجعون"
