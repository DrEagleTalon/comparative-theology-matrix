    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولكم فيها منٰفع ولتبلغوا عليها حاجة في صدوركم وعليها وعلى الفلك تحملون"
    }
