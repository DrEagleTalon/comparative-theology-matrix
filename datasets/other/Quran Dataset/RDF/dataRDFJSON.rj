    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ولا تجعل يدك مغلولة الىٰ عنقك ولا تبسطها كل البسط فتقعد ملوما محسورا"
