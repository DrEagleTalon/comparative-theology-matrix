    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وارسلنا الريٰح لوٰقح فانزلنا من السماء ماء فاسقينٰكموه وما انتم له بخٰزنين"
