    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وحرمنا عليه المراضع من قبل فقالت هل ادلكم علىٰ اهل بيت يكفلونه لكم وهم له نٰصحون"
    }
