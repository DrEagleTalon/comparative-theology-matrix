    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وان منكم لمن ليبطئن فان اصٰبتكم مصيبة قال قد انعم الله علي اذ لم اكن معهم شهيدا"
    }
