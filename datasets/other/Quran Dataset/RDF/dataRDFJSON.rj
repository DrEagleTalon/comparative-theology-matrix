    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "ما كان لله ان يتخذ من ولد سبحٰنه اذا قضىٰ امرا فانما يقول له كن فيكون"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
