      "type" : "literal" ,
      "value" : "6"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "او تقولوا لو انا انزل علينا الكتٰب لكنا اهدىٰ منهم فقد جاءكم بينة من ربكم وهدى ورحمة فمن اظلم ممن كذب بايٰت الله وصدف عنها سنجزي الذين يصدفون عن ءايٰتنا سوء العذاب بما كانوا يصدفون"
    }
     ] ,
    "http://khalidaloufi.sa/quran#ayahnumber" : [ { 
      "type" : "literal" ,
      "value" : "157"
    }
     ]
  }
