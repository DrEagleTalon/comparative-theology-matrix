    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "رب اغفر لي ولوٰلدي ولمن دخل بيتي مؤمنا وللمؤمنين والمؤمنٰت ولا تزد الظٰلمين الا تبارا"
    }
