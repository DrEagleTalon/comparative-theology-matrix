    "http://khalidaloufi.sa/quran#ayah_text_no_diacratic" : [ { 
      "type" : "literal" ,
      "value" : "وقال فرعون ذروني اقتل موسىٰ وليدع ربه اني اخاف ان يبدل دينكم او ان يظهر في الارض الفساد"
    }
